# 服务商版本地 / Vercel 环境变量模板（复制为 .env.partner.local 或填入 Vercel）
# 切勿提交含真实 anon key 的文件到 Git。

VITE_APP_EDITION=partner
VITE_PEER_EDITION_LOGIN_URL=https://cs.mofangdianai.com/login

# 与商家站 cs 项目相同（生产 ECS Supabase 反代）
VITE_SUPABASE_URL=https://mofangdianai.com
VITE_SUPABASE_ANON_KEY=<从商家版 Vercel 复制 SUPABASE_ANON_KEY 或 VITE_SUPABASE_ANON_KEY>

VITE_ERP_AUTH_API_BASE=https://mofangdianai.com/erp-api
