# 复制为 .env.production（仅 ECS/本机构建用，勿提交 Git）
# 服务端密钥从 Vercel 导出后写入 ~/stack/auth-api.env，见 docs/MIGRATE-VERCEL-TO-ECS-mofangdianai.com.md

# cs 子域：用 https://cs.mofangdianai.com（Nginx 反代轻量 /auth、/rest）；根域部署仍用 mofangdianai.com
VITE_SUPABASE_URL=https://cs.mofangdianai.com
VITE_ERP_AUTH_API_BASE=https://mofangdianai.com/erp-api
# 与 ~/stack/auth-api.env 中 SUPABASE_ANON_KEY 一致（构建前必填）
VITE_SUPABASE_ANON_KEY=

# 留空：生产走当前站点同源 /api/*（cs 上 Nginx 反代轻量）
# VITE_MERCHANT_API_BASE_URL=

# 服务商版登录跳转（fws 未迁 ECS 时用 Vercel 域名）
# VITE_PEER_EDITION_LOGIN_URL=https://fws.mofangdianai.com/login
