# —— 生产（ECS 根域 API + Vercel 商户前端 cs.mofangdianai.com）——
# VITE_SUPABASE_URL=https://mofangdianai.com
# 智能体 / 注册等优先走 ECS（必配生产，否则 Vercel 易 tenant_not_found）：
# VITE_ERP_AUTH_API_BASE=https://mofangdianai.com/erp-api
# 勿用 api.mofangdianai.com（无 DNS，会导致注册请求变成 api.mofangdianai.com.meoo-auth-register）。
# 留空时优先走当前站点 /api/*（cs.mofangdianai.com）；再回退 mofangdianai.com/erp-api 与 https://mofangdianai.com/api/*
# SUPABASE_URL=https://mofangdianai.com
# SUPABASE_URL（或 VITE_SUPABASE_URL）、SUPABASE_ANON_KEY（或与 VITE_SUPABASE_ANON_KEY 相同；AI 网关读租户须配置）
# SUPABASE_SERVICE_ROLE_KEY=<ECS JWT_SECRET 生成的 service_role>
# SUPABASE_ANON_KEY=<与 VITE_SUPABASE_ANON_KEY 相同；AI 网关等服务端接口用>
# SUPABASE_JWT_SECRET=<ECS ~/stack/db-credentials.txt 里的 JWT_SECRET；/api/meoo-ai-chat 本地验登录 JWT，避免 Vercel 出站访问 /auth/v1/user 失败>

# —— Vercel / 服务端（抖音来客绑定与会话加密，生产必填）——
# 在 Vercel → Settings → Environment Variables 添加；勿提交真实密钥。
# 与运营台共用 Supabase 时，以下两项用于服务端读取 `ops_registry_snapshot`（与抖音绑定/运营同步相关；商品 AI 密钥仅使用下方 MERCHANT_AI_* 环境变量，不再从注册表或浏览器注入）。
# SUPABASE_URL（或 VITE_SUPABASE_URL）、SUPABASE_SERVICE_ROLE_KEY
# 若绑定时报 FUNCTION_INVOCATION_FAILED / 超时：多是边缘访问 open.douyin.com 不畅，可在 Vercel → Project → Functions → Region 换东京(hnd1)或首尔(icn1)等更近区域（视套餐）。
MERCHANT_DOUYIN_SESSION_SECRET=

# —— 可选：抖音开放平台 HTTP 基址（勿以 / 结尾）。不设则直连 https://open.douyin.com。抖音「服务器 IP 白名单」为请求来源 IP：Vercel 等云平台出口常为动态，与报备 EIP 不一致会报 IP 不在白名单；请将 DOUYIN_OPENAPI_BASE_URL 设为 EIP 上 Nginx 反代 open.douyin.com 的根（参见仓库注释与 vite-plugins/douyinMerchantGateway.ts 说明）。
# DOUYIN_OPENAPI_BASE_URL=
# 排障时恢复「goodlife 经中继失败则直连官方」：1/true（生产勿开，会导致出口 IP 偏离白名单）
# DOUYIN_OPENAPI_GOODLIFE_OFFICIAL_FALLBACK=

# —— 可选：中继为自签 / IP 证书时，Vercel Node 默认 TLS 校验会失败（绑定弹窗报 fetch failed）。设为 1 则仅对「自建中继 URL」跳过校验；直连 open.douyin.com 仍校验。生产推荐域名 + 受信任证书后删除本项。
# DOUYIN_OPENAPI_RELAY_TLS_INSECURE=1

# —— 可选：OAuth（/oauth/*，含 client_token）单独基址。不设：与 goodlife 同走中继；服务端会在中继返回 HTML 时自动再请求官方 OAuth（goodlife 仍只走中继）。也可显式设为 https://open.douyin.com 跳过中继上的 OAuth。
# 商品保存：template/组装 与 product/save 分阶段超时（秒级预算见网关日志 [meoo douyin goods/save] start）
# DOUYIN_GOODS_BUILD_TIMEOUT_MS=38000
# DOUYIN_GOODS_SAVE_POST_TIMEOUT_MS=75000
# goods/save 强制覆盖 `product.open_biz_type`（0–99，一般勿设；代金券误用 1 易触发抖音泛化错误）
# DOUYIN_GOODS_SAVE_OPEN_BIZ_TYPE=
# 团购「几选几」仅配 1 个商品组时，网关是否自动拆成 2 组（组名加 -A/-B，内容相同；满足部分类目至少 2 组要求）。设为 0 / false / off 关闭。
# DOUYIN_GOODS_COMBO_SINGLE_GROUP_AUTO_DUP=
# SKU 必填「券码来源」code_source_type 未在 merge 中识别时：默认 "1"（平台发码）；三方等见 trade_rules.code_source_type 或：
# DOUYIN_GOODS_SKU_CODE_SOURCE_TYPE_DEFAULT=
# 零售类目 5003003：单商品组内多个单品时拆成「每组 1 个单品」再保存（避免 A/B 克隆）。关闭设空：
# DOUYIN_GOODS_RETAIL_SPLIT_ITEMS_TO_GROUPS_CATEGORY_IDS=5003003
# attr/sku 套餐 JSON 使用 {"groups":[...]} 包裹（默认关闭；仍报错时可试 DOUYIN_GOODS_COMBO_ATTR_WRAPPED_GROUPS_CATEGORY_IDS=5003003）
# DOUYIN_GOODS_COMBO_ATTR_WRAPPED_GROUPS_CATEGORY_IDS=
# 写入套餐 JSON 前规范化 item：数值 count/price、quantity 同 count、unit=份。默认 5003003：
# DOUYIN_GOODS_COMBO_ATTR_RETAIL_NORMALIZE_CATEGORY_IDS=5003003
# 排障：item 的 count/price 改字符串（需显式列类目 ID，未默认开启）：
# DOUYIN_GOODS_COMBO_ATTR_ITEM_NUMBERS_AS_STRING_CATEGORY_IDS=
# sku `commodity` 排障扁平单品：DOUYIN_GOODS_COMBO_COMMODITY_JSON_SHAPE=flattened（一般勿开）。
# 极少数排障：`DOUYIN_GOODS_COMBO_ATTR_JSON_SHAPE=wrapped` 给 opaque 槽用 `{"groups":[]}`（一般勿开）。
# DOUYIN_GOODS_COMBO_ATTR_JSON_SHAPE=
# 兼容旧名：仅作为 save POST 超时（与 SAVE_POST 二选一，优先 SAVE_POST）
# DOUYIN_GOODS_HTTP_TIMEOUT_MS=75000
# MERCHANT_DOUYIN_TEMPLATE_CACHE_MS=600000
# DOUYIN_OPENAPI_OAUTH_BASE_URL=

# —— 商品图上传：POST /api/merchant/douyin|kuaishou/goods/image/upload → 阿里云 OSS（推荐，可与云剪共用 Bucket modianningbo）——
# MERCHANT_PRODUCT_IMAGE_OSS_BUCKET=modianningbo
# MERCHANT_PRODUCT_IMAGE_OSS_REGION=oss-cn-shanghai
# MERCHANT_PRODUCT_IMAGE_OSS_ACCESS_KEY_ID=（可与 ALIYUN_ICE_ACCESS_KEY_ID 相同）
# MERCHANT_PRODUCT_IMAGE_OSS_ACCESS_KEY_SECRET=（可与 ALIYUN_ICE_ACCESS_KEY_SECRET 相同）
# MERCHANT_PRODUCT_IMAGE_OSS_PREFIX=douyin-goods
# 若云剪 RAM 只授权 meoo-out/*，勿写死 douyin-goods；留空并在运营台填写 ICE 成片 OSS 前缀，将自动使用 {前缀}/douyin-goods。
# 可选：自定义 Endpoint；默认启用 OSS V4 签名（MERCHANT_PRODUCT_IMAGE_OSS_AUTH_V4=0 可关闭）
# MERCHANT_PRODUCT_IMAGE_OSS_ENDPOINT=
# 上传成功后优先用公共 URL；私有桶会自动回退 7 天签名 URL（access_mode=signed）
# MERCHANT_PRODUCT_IMAGE_OSS_PUBLIC_URL=1
# 未单独配置 MERCHANT_PRODUCT_IMAGE_OSS_BUCKET 时，会尝试从 ALIYUN_ICE_OUTPUT_OSS_URL_PREFIX 解析 Bucket
# 备选 Supabase Storage（自建 ECS 无 Storage 时可不填）：
# MERCHANT_PRODUCT_IMAGE_SUPABASE_BUCKET=dmf-merchant-product-images
# 可选：对象键前缀（默认 douyin-goods），路径形如 {prefix}/{merchantId}/{uuid}.jpg
# MERCHANT_PRODUCT_IMAGE_SUPABASE_PREFIX=douyin-goods
# 须与 api/meoo-tenant-subaccount-mutate 等一致：VITE_SUPABASE_URL 或 SUPABASE_URL + SUPABASE_SERVICE_ROLE_KEY
# 本地/排障无 Storage 时：1/true 则失败回退 data URL / 占位图（生产勿开）
# MERCHANT_PRODUCT_IMAGE_UPLOAD_DEMO_FALLBACK=
# 兼容旧名：
# MERCHANT_DOUYIN_IMAGE_UPLOAD_DEMO_FALLBACK=

# —— 可选：美团技术服务合作中心 OpenAPI（门店/商品/评价/装修/活动/对账，见 vite-plugins/meituanMerchantGateway.ts）——
# 文档：https://developer.meituan.com/docs/api
# 未配置 MEITUAN_OPENAPI_BASE_URL 时绑定后走演示数据，便于 UI 联调；生产需申请业务包并配置基址与各 PATH。
# MEITUAN_OPENAPI_BASE_URL=
# MEITUAN_APP_KEY=
# MEITUAN_APP_SECRET=
# MEITUAN_DEFAULT_MERCHANT_ID=
# MEITUAN_OAUTH_TOKEN_PATH=/oauth/token
# MEITUAN_STORE_LIST_PATH=/poi/list
# MEITUAN_STORE_DETAIL_PATH=/poi/detail
# MEITUAN_STORE_DECORATION_PATH=/shop/decoration/list
# MEITUAN_GOODS_LIST_PATH=/deal/query
# MEITUAN_GOODS_SAVE_PATH=/deal/save
# MEITUAN_REVIEW_LIST_PATH=/ugc/comment/query
# MEITUAN_REVIEW_REPLY_PATH=/ugc/comment/reply
# MEITUAN_FINANCE_PATH=/bill/daily/summary
# MEITUAN_MARKETING_ACTIVITY_QUERY_PATH=/marketing/activity/query

# —— 可选：小红书商家开放平台（商品/门店，见 school.xiaohongshu.com）——
# XHS_OPENAPI_BASE_URL=
# XHS_APP_KEY=
# XHS_APP_SECRET=
# XHS_STORE_LIST_PATH=/ark/open_api/v1/shop/list
# XHS_GOODS_LIST_PATH=/ark/open_api/v1/items
# XHS_GOODS_SAVE_PATH=/ark/open_api/v1/items
# XHS_REVIEW_LIST_PATH=/ugc/comment/query
# XHS_FINANCE_PATH=/bill/daily/summary
# XHS_MARKETING_ACTIVITY_QUERY_PATH=/marketing/activity/query

# —— 可选：小红书商业化（聚光投流 + 种小草线索，同一授权，见 ad-market.xiaohongshu.com）——
# XHS_COMMERCIAL_API_BASE_URL=
# XHS_COMMERCIAL_ACCESS_TOKEN=
# XHS_COMMERCIAL_ADVERTISER_ID=
# XHS_JUGUANG_PROJECT_LIST_PATH=/api/open/jg/campaign/list
# XHS_JUGUANG_PROMOTION_LIST_PATH=/api/open/jg/unit/list
# XHS_JUGUANG_REPORT_PATH=/api/open/jg/report/summary
# XHS_ZHONGXIAOCAO_CLUE_LIST_PATH=/api/open/leads/list
# XHS_ZHONGXIAOCAO_CLUE_CALLBACK_PATH=/api/open/leads/callback

# —— 可选：巨量引擎本地推（投流/线索 Open API，服务端兜底；商户端也可在「系统设置」绑定）——
# OCEANENGINE_API_BASE=https://api.oceanengine.com
# OCEANENGINE_ACCESS_TOKEN=
# OCEANENGINE_LOCAL_ACCOUNT_ID=

# —— 可选：网关不在商户域名上时配置（不以 / 结尾）；留空则同源 /api/merchant/* ——
# VITE_MERCHANT_API_BASE_URL=

# —— 线上商户 ERP 拉取注册表：设为运营台 HTTPS 根地址（与 admin.mofangshop.com 一致），否则静态 ERP 无 /api/ops-sync ——
# VITE_MERCHANT_ADMIN_ORIGIN=https://admin.example.com
#
# 若留空：ERP 会请求同源 `/api/meoo-ops-sync-registry`（需在商户 ERP 的 Vercel 配置与运营台相同的 SUPABASE_URL + SUPABASE_SERVICE_ROLE_KEY，以读取 ops_registry_snapshot）。

# —— AI 智能体网关（POST /api/meoo-ai-chat；密钥仅服务端，勿加 VITE_）——
# OpenAI / Claude / Gemini / Grok 经 TokenMix OpenAI 兼容中继：<https://tokenmix.ai/docs>
# TOKENMIX_API_KEY=
# TOKENMIX_BASE_URL=https://api.tokenmix.ai/v1
# DEFAULT_AI_MODEL=
# TOKENMIX_DEFAULT_FAMILY=openai
# DeepSeek / Kimi / MiniMax 仍直连各厂商（与 TokenMix 并行可选）
# DEEPSEEK_API_KEY=
# DEEPSEEK_MODEL=deepseek-chat
# MOONSHOT_API_KEY=
# KIMI_MODEL=moonshot-v1-8k
# KIMI_BASE_URL=https://api.moonshot.ai/v1
# MINIMAX_API_KEY=
# MINIMAX_MODEL=MiniMax-M2
# 国际站默认 https://api.minimax.io/v1；若控制台为国内「海螺」且报 401 invalid api key，可改为：
# MINIMAX_BASE_URL=https://api.minimaxi.com/v1
# 数字人口播试听（MiniMax T2A，/api/meoo-digital-human-tts；与 MINIMAX_API_KEY 共用）
# MERCHANT_AI_MINIMAX_T2A_MODEL=speech-02-hd
# DEFAULT_AI_PROVIDER=tokenmix
#
# 抖音商品创建手选「Gemini」文案时经同一 TokenMix 中继；可选覆盖默认 Flash 模型 id
# MERCHANT_AI_GOODS_GEMINI_MODEL=gemini-2.5-flash
#
# —— Vercel 上通义 / 豆包（商品 AI、抖音辅助、智能体选「通义千问」「豆包」时走 /api/meoo-ai-chat 服务端；勿加 VITE_）——
# MERCHANT_AI_QWEN_KEY=<DashScope API Key，与 DASHSCOPE_API_KEY 二选一>
# DASHSCOPE_API_KEY=
# MERCHANT_AI_QWEN_CHAT_MODEL=qwen-turbo
# MERCHANT_AI_DOUBAO_KEY=<火山方舟 API Key，与 ARK_API_KEY 二选一>
# ARK_API_KEY=
# MERCHANT_AI_DOUBAO_CHAT_MODEL=doubao-pro-32k
# MERCHANT_AI_DOUBAO_CHAT_FALLBACK_MODEL=doubao-seed-1-6-251015
# MERCHANT_AI_DOUBAO_ARK_BASE=https://ark.cn-beijing.volces.com
# 店铺菜单/价目表识图（必须视觉模型，纯文本 Key 无法读图）：任选其一
# TOKENMIX_API_KEY=  （推荐；可选 MERCHANT_AI_MENU_VISION_MODEL=gpt-4o）
# MERCHANT_AI_QWEN_VL_MODEL=qwen-vl-plus
# MERCHANT_AI_DOUBAO_VL_MODEL=doubao-1-5-vision-pro-32k-250115
# 抖音商品 AI assist：文案/生图在未选手动直连厂商时的尝试顺序（逗号分隔 minimax,qwen,doubao）；不设则分别为 minimax,qwen,doubao 与 qwen,doubao,minimax
# MERCHANT_AI_GOODS_TEXT_FAILOVER=minimax,qwen,doubao
# MERCHANT_AI_GOODS_IMAGE_FAILOVER=qwen,doubao,minimax
# 抖音商品图生图（通义万相）：参考图强度 0～1，默认 0.38，底图与商品不符时可再调低以增强「名称+说明」文字锚
# MERCHANT_AI_QWEN_I2I_REF_STRENGTH=0.38
# 可选：本地未登录调试智能体网关 /api/meoo-ai-chat（仅开发）；复制见 .env.development.agent.example
# MEOO_AI_CHAT_ALLOW_UNAUTHENTICATED=1
# 运营台审计接入：HTTPS 根 + 路径由运营台提供；与下方密钥成对配置后 ERP 会在每次 AI 调用后 POST 审计负载
# MERCHANT_ADMIN_AI_AUDIT_URL=https://admin.example.com
# MEOO_AI_AGENT_AUDIT_SECRET=<与商家管理后台 MEOO_AI_AGENT_AUDIT_SECRET 一致>

# —— 火山 Seedance 视频：推荐直接填模型 ID（勿把 Doubao-Seed 对话 ep 配进视频列表）——
# MERCHANT_AI_SEEDANCE_VIDEO_MODEL=doubao-seedance-1-5-pro-251215
# MERCHANT_AI_ARK_VIDEO_ENDPOINTS=Seedance 1.5 Pro|doubao-seedance-1-5-pro-251215
# MERCHANT_AI_ARK_VIDEO_FALLBACK_ENDPOINT=ep-xxxx

# —— 飞书群机器人通知（服务端 API；Webhook 勿加 VITE_ 前缀）——
# 商户 ERP 与运营后台可共用同一 Webhook，或按场景拆分。
# MEOO_FEISHU_WEBHOOK_URL=https://open.feishu.cn/open-apis/bot/v2/hook/xxxx
# MEOO_FEISHU_WEBHOOK_RECRUITMENT=
# MEOO_FEISHU_WEBHOOK_SUPPORT=
# MEOO_FEISHU_WEBHOOK_ORDER=
# MEOO_FEISHU_WEBHOOK_CUSTOMER=
# MEOO_FEISHU_NOTIFY_ENABLED=1
# 飞书机器人开启「签名校验」时填写（与飞书后台显示的密钥一致）：
# MEOO_FEISHU_WEBHOOK_SECRET=
