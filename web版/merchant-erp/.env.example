# 复制为 .env.local 并填入密钥（勿提交 .env.local；已在 .gitignore 的 *.local 规则下）

# 在线客服 dev：ERP 将浏览器 ws 转发至商家管理后台同源路径；仅开发服务器使用，不在商户端 UI 暴露跳转
# VITE_MERCHANT_ADMIN_ORIGIN=http://localhost:5174
# 仅自建网关时覆盖完整 ws：
# VITE_SUPPORT_RELAY_WS=ws://127.0.0.1:5173/__meoo_support_online
# 抖音来客 AI：由 Vite 开发服务器（vite-plugins/merchantAiUpstream）转发，仅服务端可见。

MERCHANT_AI_QWEN_KEY=
MERCHANT_AI_DOUBAO_KEY=
# 商品管理「AI 检测分析」走豆包质检（action=analyze_product_quality），需配置有效 Key
# 与火山方舟控制台一致时可二选一
# ARK_API_KEY=
MERCHANT_AI_MINIMAX_KEY=
# MINIMAX_API_KEY=

# 通义千问对话（compatible-mode），默认 qwen-turbo；控制台可用名见 DashScope
# MERCHANT_AI_QWEN_CHAT_MODEL=qwen-turbo

# MiniMax 文案（OpenAI 兼容 POST …/v1/chat/completions；见 platform.minimax.io 文档枚举 M2.7/M2.5/M2.1）
# 未配置 MERCHANT_AI_MINIMAX_CHAT_MODEL 时：依次尝试 minimax.io 上 M2.7→M2.5→M2.1，再 minimaxi.com + abab6.5s-chat
# MERCHANT_AI_MINIMAX_CHAT_MODEL=MiniMax-M2.7
# 可选：自定义 MiniMax 对话根（须能拼出 …/v1/chat/completions）
# MERCHANT_AI_MINIMAX_CHAT_BASE=https://api.minimax.io

# 可选：与阿里云示例一致时使用
# DASHSCOPE_API_KEY=

# 豆包：方舟 OpenAPI 根（默认 https://ark.cn-beijing.volces.com/api/v3；也可只填 https://ark.cn-beijing.volces.com 自动补全）
# MERCHANT_AI_DOUBAO_ARK_BASE=https://ark.cn-beijing.volces.com
# 对话模型：建议填火山方舟「推理接入点」ID（以 ep- 开头）；默认 doubao-pro-32k；失败时自动再试下方 fallback
# MERCHANT_AI_DOUBAO_CHAT_MODEL=doubao-pro-32k
# MERCHANT_AI_DOUBAO_CHAT_FALLBACK_MODEL=doubao-seed-1-6-251015
# 生图模型（Seedream 系列，以控制台可用名为准）
# MERCHANT_AI_DOUBAO_IMAGE_MODEL=doubao-seedream-4-0-250828

# 通义万相生图模型（默认 wanx-v1，与 image-synthesis 接口匹配）
# MERCHANT_AI_QWEN_IMAGE_MODEL=wanx-v1

# MiniMax 生图模型（默认 image-01，文档见 platform.minimax.io）
# MERCHANT_AI_MINIMAX_IMAGE_MODEL=image-01

# —— AI 短视频（仅存服务端）：优先读下方环境变量；未配置时可由「运营管控台 → AI模型 → 短视频 API」写入项目根 .meoo-dev-sync 注册表并从 ERP dev 网关自动合并——
# KLING_ACCESS_KEY=
# KLING_SECRET_KEY=
# # 中国区默认 https://api.klingai.com；海外控制台常见 https://api-singapore.klingai.com 等（以官方控制台为准）
# KLING_API_BASE=https://api.klingai.com

# Seedance / 方舟：视频推理接入点列表（comma，每项「显示名|ep-id」）；可由运营管控台「短视频 API」下发，也可用本变量：
# MERCHANT_AI_ARK_VIDEO_ENDPOINTS=Seedance2.0-Pro|ep-xxxxxxxxxxxxxxxx,Seedance2.0-Lite|ep-yyyyyyyy

# —— Supabase（配置后 ERP 需登录，运营台创建的账号使用「账户名 + 密码」登录）——
# 云端：https://xxxx.supabase.co + 控制台 API Keys
# 本地（项目根先执行 npm run supabase:start，再起本前端；密钥见 npm run supabase:status）
# VITE_SUPABASE_URL=http://127.0.0.1:54321
# VITE_SUPABASE_ANON_KEY=<粘贴 supabase status 中的 anon key>
# VITE_SUPABASE_TENANT_EMAIL_DOMAIN=users.meoo.test
# 小程序真机与局域网招募互通时，与小程序 utils/config.local.js 中 MERCHANT_API_BASE_URL 一致（例 http://192.168.1.8:5173）
# VITE_MERCHANT_API_BASE_URL=http://192.168.1.8:5173
