{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/merchant/[...slug].ts": {
      "includeFiles": "{vite-plugins,src/lib}/**",
      "maxDuration": 60
    },
    "api/meoo-douyin-bind.ts": {
      "includeFiles": "api/merchant/douyin/**",
      "maxDuration": 60
    },
    "api/douyin-bind.ts": {
      "includeFiles": "api/merchant/douyin/**",
      "maxDuration": 60
    },
    "api/merchant/douyin/bind.ts": {
      "includeFiles": "api/merchant/douyin/**",
      "maxDuration": 60
    },
    "api/**/*.ts": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/",
      "destination": "/index.html"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
