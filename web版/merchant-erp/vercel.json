{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/merchant/[...slug].ts": {
      "includeFiles": "{vite-plugins,src/lib}/**",
      "maxDuration": 60
    },
    "api/meoo-douyin-stores.ts": {
      "includeFiles": "{vite-plugins,src/lib}/**",
      "maxDuration": 60
    },
    "api/meoo-douyin-goods-category-get.ts": {
      "includeFiles": "{vite-plugins,src/lib}/**",
      "maxDuration": 60
    },
    "api/meoo-douyin-goods-product-types.ts": {
      "includeFiles": "{vite-plugins,src/lib}/**",
      "maxDuration": 60
    },
    "api/meoo-store-gross-margin-advisor.ts": {
      "includeFiles": "{vite-plugins,src/lib}/**",
      "maxDuration": 60
    },
    "api/meoo-douyin-brands.ts": {
      "includeFiles": "{vite-plugins,src/lib}/**",
      "maxDuration": 60
    },
    "api/meoo-douyin-store-detail.ts": {
      "includeFiles": "{vite-plugins,src/lib}/**",
      "maxDuration": 60
    },
    "api/meoo-douyin-poi-claim.ts": {
      "includeFiles": "{vite-plugins,src/lib}/**",
      "maxDuration": 60
    },
    "api/meoo-douyin-store-decoration.ts": {
      "includeFiles": "{vite-plugins,src/lib}/**",
      "maxDuration": 60
    },
    "api/**/*.ts": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/((?!api/)(?!assets/).*)",
      "destination": "/index.html"
    }
  ]
}
