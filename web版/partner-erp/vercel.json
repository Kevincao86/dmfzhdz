{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "cd ../merchant-erp && npm ci",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": null,
  "rewrites": [
    {
      "source": "/api/meoo-help-manual-public",
      "destination": "https://mofangdianai.com/erp-api/meoo-help-manual-public"
    },
    {
      "source": "/api/meoo-team-intro-public",
      "destination": "https://mofangdianai.com/erp-api/meoo-team-intro-public"
    },
    {
      "source": "/((?!api/)(?!assets/).*)",
      "destination": "/index.html"
    }
  ]
}
