# 无凭证时默认 dry-run（读 data/demo，消息只打印）
DRY_RUN=1

# 自建应用（读智能表格）
WECOM_CORPID=
WECOM_CORPSECRET=

# 三张智能表格 docid / sheet_id（管理后台或创建接口拿到后填入）
WECOM_DOC_FOLLOWUP=
WECOM_SHEET_FOLLOWUP=
WECOM_DOC_RANK=
WECOM_SHEET_RANK=
WECOM_DOC_FILES=
WECOM_SHEET_FILES=

# 群机器人 Webhook（发提醒/报表；可只填 key 或完整 URL）
WECOM_WEBHOOK_URL=
# 或：WECOM_WEBHOOK_KEY=

# 时区（定时任务）
TZ=Asia/Shanghai
