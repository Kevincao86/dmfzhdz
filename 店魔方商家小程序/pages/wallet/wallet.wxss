.page {
  min-height: 100vh;
  padding: 32rpx 28rpx 80rpx;
  box-sizing: border-box;
  background: linear-gradient(180deg, #eef4ff 0%, #f3f6fb 35%);
}

.hero-label {
  font-size: 22rpx;
  color: #64748b;
  letter-spacing: 0.08em;
}

.hero-amt {
  display: block;
  margin-top: 12rpx;
  font-size: 56rpx;
  font-weight: 800;
  color: #0f172a;
}

.hero-sub {
  display: block;
  margin-top: 16rpx;
  font-size: 24rpx;
  color: #64748b;
  line-height: 1.45;
}

.recharge-btn {
  margin-top: 32rpx;
}

.refund-outline-btn {
  margin-top: 16rpx;
  background: transparent !important;
  color: #0d9488 !important;
  border: 2rpx solid rgba(13, 148, 136, 0.85) !important;
}

.refund-outline-btn[disabled] {
  opacity: 0.45;
}

.refund-mask-center {
  align-items: center;
  justify-content: center;
  padding: 40rpx 28rpx;
}

.refund-sheet {
  width: 100%;
  max-width: 640rpx;
  border-radius: 28rpx;
  padding: 36rpx 32rpx calc(32rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.ghost-btn {
  margin-top: 16rpx;
  background: transparent !important;
  color: #475569 !important;
  border: 1px solid rgba(148, 163, 184, 0.55) !important;
}

.err {
  display: block;
  margin: 16rpx 0;
  font-size: 24rpx;
  color: #dc2626;
}

.panel-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #0f172a;
}

.empty {
  display: block;
  padding: 48rpx 0;
  text-align: center;
  font-size: 26rpx;
  color: #64748b;
}

.ledger-scroll {
  max-height: 560rpx;
  margin-top: 16rpx;
}

.ledger-row {
  display: flex;
  justify-content: space-between;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #e2e8f0;
}

.ledger-reason {
  font-size: 26rpx;
  color: #0f172a;
}

.ledger-time {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #94a3b8;
}

.ledger-right {
  text-align: right;
}

.ledger-delta {
  font-size: 28rpx;
  font-weight: 600;
}

.ledger-delta.pos {
  color: #059669;
}

.ledger-delta.neg {
  color: #e11d48;
}

.ledger-bal {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #64748b;
}

.pay-mask {
  position: fixed;
  inset: 0;
  z-index: 100;
  background: rgba(15, 23, 42, 0.45);
  display: flex;
  align-items: flex-end;
  justify-content: center;
}

.pay-sheet {
  width: 100%;
  max-height: 85vh;
  overflow-y: auto;
  border-radius: 32rpx 32rpx 0 0;
  padding: 36rpx 32rpx calc(32rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.pay-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #0f172a;
}

.pay-hint {
  display: block;
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #64748b;
  line-height: 1.45;
}

.tier-row {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-top: 28rpx;
}

.tier-chip {
  padding: 16rpx 24rpx;
  border-radius: 16rpx;
  font-size: 24rpx;
  background: #f8fafc;
  color: #475569;
  border: 1rpx solid #e2e8f0;
}

.tier-chip.on {
  border-color: rgba(14, 165, 233, 0.65);
  color: #0369a1;
  background: rgba(14, 165, 233, 0.1);
}

.custom-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 28rpx;
}

.custom-label {
  font-size: 26rpx;
  color: #475569;
}

.pay-actions {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin-top: 32rpx;
}

.pay-wx {
  background: #059669 !important;
  color: #fff !important;
}

.pay-alipay {
  background: #0284c7 !important;
  color: #fff !important;
}

.pay-channel-tip {
  display: block;
  margin-top: 24rpx;
  font-size: 24rpx;
  color: #64748b;
}

.qr-placeholder {
  margin-top: 24rpx;
  height: 280rpx;
  border-radius: 16rpx;
  border: 2rpx dashed rgba(148, 163, 184, 0.55);
  display: flex;
  align-items: center;
  justify-content: center;
  color: #64748b;
  font-size: 28rpx;
  background: #f8fafc;
}

.pay-err {
  margin-top: 16rpx;
}

.close-pay {
  margin-top: 24rpx;
  background: transparent !important;
  color: #64748b !important;
}
