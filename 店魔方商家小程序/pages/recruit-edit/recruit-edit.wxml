<scroll-view scroll-y class="edit-scroll">
  <view class="edit-head meoo-card">
    <text class="edit-head-title">达人招募草稿</text>
    <text class="edit-head-desc">提交后与电脑端「达人招募」写入同一份数据；若提示未连接后台，请联系技术人员配置小程序访问电脑端商家后台的地址。</text>
  </view>

  <text class="edit-section-title">岗位与预算</text>
  <view class="field">
    <text class="meoo-label">角色 / 标题</text>
    <input class="meoo-input" value="{{roleTitle}}" data-k="roleTitle" bindinput="onField" />
  </view>
  <view class="field">
    <text class="meoo-label">预算</text>
    <input class="meoo-input" value="{{budget}}" data-k="budget" bindinput="onField" />
  </view>

  <text class="edit-section-title">交付与周期</text>
  <view class="field">
    <text class="meoo-label">交付物</text>
    <textarea class="meoo-input area" value="{{deliverables}}" data-k="deliverables" bindinput="onField" />
  </view>
  <view class="field">
    <text class="meoo-label">周期</text>
    <input class="meoo-input" value="{{deadline}}" data-k="deadline" bindinput="onField" />
  </view>
  <view class="field">
    <text class="meoo-label">备注</text>
    <textarea class="meoo-input area" value="{{notes}}" data-k="notes" bindinput="onField" />
  </view>

  <text class="edit-section-title">原始识别</text>
  <view class="field">
    <textarea class="meoo-input area small" value="{{rawText}}" data-k="rawText" bindinput="onField" />
  </view>

  <button class="meoo-btn-primary btn" bindtap="onSubmit">提交招募需求</button>
  <view class="edit-tail-space"></view>
</scroll-view>
