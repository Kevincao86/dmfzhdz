/* 紧凑商单卡：一屏约 5 条 */
.job-card-compact {
  position: relative;
  margin: 0 24rpx 12rpx;
  padding: 14rpx 16rpx 14rpx 14rpx;
  background: var(--lq-card);
  border-radius: 16rpx;
  border: 1rpx solid var(--lq-border);
  box-shadow: 0 4rpx 16rpx rgba(30, 27, 46, 0.05);
  overflow: hidden;
}

.job-card-compact--hover {
  opacity: 0.96;
}

.job-card-compact__ribbon {
  position: absolute;
  top: 0;
  right: 0;
  padding: 4rpx 14rpx;
  font-size: 18rpx;
  font-weight: 700;
  color: #fff;
  border-radius: 0 0 0 12rpx;
  background: linear-gradient(135deg, #fbbf24, #f59e0b);
}

.job-card-compact__ribbon--demo {
  background: linear-gradient(135deg, #6366f1, #4f46e5);
}

.job-card-compact__ai-tag {
  position: absolute;
  top: 0;
  right: 0;
  padding: 4rpx 14rpx;
  font-size: 18rpx;
  font-weight: 700;
  color: #fff;
  border-radius: 0 0 0 12rpx;
  background: linear-gradient(135deg, #6366f1, #4f46e5);
  z-index: 2;
  max-width: 40%;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.job-card-compact__ai-tag--hot {
  background: linear-gradient(135deg, #f97316, #ea580c);
}

.job-card-compact__ai-tag--urgent {
  background: linear-gradient(135deg, #ef4444, #dc2626);
}

.job-card-compact__ai-tag--ice {
  background: linear-gradient(135deg, #0ea5e9, #0284c7);
}

.job-card-compact__ai-tag--match {
  background: linear-gradient(135deg, #10b981, #059669);
}

.job-card-compact__ai-tag--budget {
  background: linear-gradient(135deg, #8b5cf6, #7c3aed);
}

.job-card-compact__ai-tag--niche {
  background: linear-gradient(135deg, #14b8a6, #0d9488);
}

.job-card-compact__tag--match {
  color: #047857;
  background: #ecfdf5;
}

.job-card-compact__row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.job-card-compact__icon {
  width: 52rpx;
  height: 52rpx;
  border-radius: 10rpx;
  flex-shrink: 0;
  background: #f3f4f6;
}

.job-card-compact__main {
  flex: 1;
  min-width: 0;
}

.job-card-compact__title {
  display: block;
  font-size: 26rpx;
  font-weight: 700;
  color: var(--lq-text);
  line-height: 1.3;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.job-card-compact__line2 {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 6rpx;
  margin-top: 6rpx;
}

.job-card-compact__tag {
  font-size: 18rpx;
  padding: 2rpx 8rpx;
  border-radius: 6rpx;
  color: #4338ca;
  background: #eef2ff;
  font-weight: 600;
}

.job-card-compact__tag--urgent {
  color: #b45309;
  background: #fffbeb;
}

.job-card-compact__tag--ice {
  color: #0369a1;
  background: #e0f2fe;
}

.job-card-compact__tag--gray {
  color: #6b7280;
  background: #f3f4f6;
}

.job-card-compact__price {
  font-size: 24rpx;
  font-weight: 800;
  color: var(--lq-primary-dark);
  margin-left: auto;
  flex-shrink: 0;
}

.job-card-compact__line3 {
  display: block;
  margin-top: 4rpx;
  font-size: 20rpx;
  color: var(--lq-text-secondary);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
