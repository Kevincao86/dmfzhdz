<view class="page-shell page-with-bar">
  <view class="page-hero page-hero--compact">
    <text class="page-hero-title">{{editMode ? '完善会员资料' : '注册达人会员'}}</text>
    <text class="page-hero-sub">填写一次，报名时可一键同步</text>
  </view>

  <view class="card">
    <view class="section-head">
      <view class="section-head-dot" />
      <text class="section-title">微信信息</text>
    </view>
    <view class="wx-profile">
      <image class="wx-avatar" src="{{wxAvatarUrl}}" mode="aspectFill" wx:if="{{wxAvatarUrl}}" />
      <view class="wx-avatar wx-avatar--ph" wx:else>
        <text class="wx-avatar-txt">微信</text>
      </view>
      <view class="wx-meta">
        <text class="wx-name">{{wxNickName || '未授权'}}</text>
        <text class="hint">用于身份展示</text>
      </view>
    </view>
    <button class="btn-wx" bindtap="onGetWxProfile">获取微信昵称与头像</button>
  </view>

  <view class="card apply-form">
    <view class="section-head">
      <view class="section-head-dot" />
      <text class="section-title">达人类型</text>
    </view>
    <view class="type-grid">
      <view
        wx:for="{{memberTypeOptions}}"
        wx:key="id"
        class="type-chip {{memberType === item.id ? 'active' : ''}}"
        data-id="{{item.id}}"
        bindtap="onPickMemberType"
      >
        <text class="type-chip-label">{{item.label}}</text>
      </view>
    </view>
  </view>

  <view class="card apply-form">
    <view class="section-head">
      <view class="section-head-dot" />
      <text class="section-title">联系信息</text>
    </view>
    <view class="form-row">
      <text class="form-label">手机号 / 联系方式</text>
      <input class="input" type="number" placeholder="便于商家联系" value="{{contact}}" data-k="contact" bindinput="onCommonField" />
    </view>
    <view class="form-row">
      <text class="form-label">微信号</text>
      <input class="input" placeholder="与商家沟通" value="{{wechatId}}" data-k="wechatId" bindinput="onCommonField" />
    </view>
    <view class="form-row form-row-inline">
      <view class="form-col">
        <text class="form-label">省份</text>
        <picker mode="selector" range="{{provinces}}" value="{{provinceIndex}}" bindchange="onProvinceChange">
          <view class="picker-val">{{province || '请选择'}}</view>
        </picker>
      </view>
      <view class="form-col">
        <text class="form-label">城市</text>
        <picker mode="selector" range="{{cities}}" value="{{cityIndex}}" bindchange="onCityChange">
          <view class="picker-val">{{city || '请选择'}}</view>
        </picker>
      </view>
    </view>
  </view>

  <view class="card apply-form" wx:if="{{memberType === 'douyin' || memberType === 'both'}}">
    <view class="platform-head platform-head--dy">抖音达人资料</view>
    <view class="form-row">
      <text class="form-label">{{douyinLabels.accountId}}</text>
      <input class="input" placeholder="抖音号" value="{{douyin.platformAccount}}" data-platform="douyin" data-k="platformAccount" bindinput="onPlatformField" />
    </view>
    <view class="form-row">
      <text class="form-label">{{douyinLabels.nickname}}</text>
      <input class="input" placeholder="昵称" value="{{douyin.platformNickname}}" data-platform="douyin" data-k="platformNickname" bindinput="onPlatformField" />
    </view>
    <view class="form-row">
      <text class="form-label">{{douyinLabels.profileLink}}</text>
      <input class="input" placeholder="主页链接" value="{{douyin.profileLink}}" data-platform="douyin" data-k="profileLink" bindinput="onPlatformField" />
    </view>
    <view class="form-row">
      <text class="form-label">粉丝数</text>
      <input class="input" type="number" value="{{douyin.followers}}" data-platform="douyin" data-k="followers" bindinput="onPlatformField" />
    </view>
    <view class="form-row">
      <text class="form-label">带货等级</text>
      <picker mode="selector" range="{{douyinLevels}}" value="{{douyinLevelIndex}}" bindchange="onDouyinLevelChange">
        <view class="picker-val">{{douyin.douyinSalesLevel || '请选择'}}</view>
      </picker>
    </view>
    <view class="form-row">
      <text class="form-label">默认报价（元）</text>
      <input class="input" type="digit" value="{{douyin.quotePrice}}" data-platform="douyin" data-k="quotePrice" bindinput="onPlatformField" />
    </view>
    <view class="form-row">
      <text class="form-label">支付宝账号</text>
      <input class="input" value="{{douyin.alipayAccount}}" data-platform="douyin" data-k="alipayAccount" bindinput="onPlatformField" />
    </view>
  </view>

  <view class="card apply-form" wx:if="{{memberType === 'xiaohongshu' || memberType === 'both'}}">
    <view class="platform-head platform-head--xhs">小红书达人资料</view>
    <view class="form-row">
      <text class="form-label">{{xhsLabels.accountId}}</text>
      <input class="input" placeholder="小红书号" value="{{xiaohongshu.platformAccount}}" data-platform="xiaohongshu" data-k="platformAccount" bindinput="onPlatformField" />
    </view>
    <view class="form-row">
      <text class="form-label">{{xhsLabels.nickname}}</text>
      <input class="input" placeholder="昵称" value="{{xiaohongshu.platformNickname}}" data-platform="xiaohongshu" data-k="platformNickname" bindinput="onPlatformField" />
    </view>
    <view class="form-row">
      <text class="form-label">{{xhsLabels.profileLink}}</text>
      <input class="input" placeholder="主页链接" value="{{xiaohongshu.profileLink}}" data-platform="xiaohongshu" data-k="profileLink" bindinput="onPlatformField" />
    </view>
    <view class="form-row">
      <text class="form-label">粉丝数</text>
      <input class="input" type="number" value="{{xiaohongshu.followers}}" data-platform="xiaohongshu" data-k="followers" bindinput="onPlatformField" />
    </view>
    <view class="form-row">
      <text class="form-label">默认报价（元）</text>
      <input class="input" type="digit" value="{{xiaohongshu.quotePrice}}" data-platform="xiaohongshu" data-k="quotePrice" bindinput="onPlatformField" />
    </view>
    <view class="form-row">
      <text class="form-label">支付宝账号</text>
      <input class="input" value="{{xiaohongshu.alipayAccount}}" data-platform="xiaohongshu" data-k="alipayAccount" bindinput="onPlatformField" />
    </view>
  </view>

  <view class="card submit-wrap">
    <button class="btn-primary submit-btn" loading="{{submitting}}" disabled="{{submitting}}" bindtap="onSubmit">
      {{editMode ? '保存资料' : '完成注册'}}
    </button>
  </view>
</view>
