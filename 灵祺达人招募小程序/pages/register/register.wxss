@import "../apply/apply.wxss";

.wx-profile {
  display: flex;
  align-items: center;
  gap: 24rpx;
  margin-bottom: 8rpx;
}

.wx-avatar {
  width: 104rpx;
  height: 104rpx;
  border-radius: 50%;
  flex-shrink: 0;
  border: 4rpx solid #fff;
  box-shadow: 0 8rpx 24rpx rgba(15, 23, 42, 0.1);
}

.wx-avatar--ph {
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #bbf7d0, #86efac);
}

.wx-avatar-txt {
  font-size: 26rpx;
  font-weight: 600;
  color: #fff;
}

.wx-meta {
  flex: 1;
}

.wx-name {
  display: block;
  font-size: 32rpx;
  font-weight: 700;
  color: #0f172a;
}

.type-grid {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.type-chip {
  padding: 24rpx 28rpx;
  border-radius: 20rpx;
  border: 2rpx solid #e2e8f0;
  background: #f8fafc;
  text-align: center;
}

.type-chip.active {
  border-color: #6366f1;
  background: linear-gradient(135deg, #eef2ff, #ffffff);
  box-shadow: 0 8rpx 24rpx rgba(99, 102, 241, 0.15);
}

.type-chip-label {
  font-size: 28rpx;
  font-weight: 600;
  color: #334155;
}

.type-chip.active .type-chip-label {
  color: #4338ca;
}

.platform-head {
  display: flex;
  align-items: center;
  gap: 12rpx;
  font-size: 28rpx;
  font-weight: 700;
  color: #0f172a;
  margin-bottom: 16rpx;
  padding-bottom: 16rpx;
  border-bottom: 2rpx solid #f1f5f9;
}

.platform-head::before {
  content: '';
  width: 6rpx;
  height: 28rpx;
  border-radius: 3rpx;
  background: #8b5cf6;
}

.platform-head--dy::before {
  background: #1e293b;
}

.platform-head--xhs::before {
  background: #ec4899;
}

.submit-wrap {
  margin-bottom: 48rpx;
}

.submit-btn {
  width: 100%;
}
