.pr-app-page {
  padding-bottom: calc(32rpx + env(safe-area-inset-bottom));
}

.pr-app-hero {
  margin-top: 20rpx;
}

.pr-app-hero .hint {
  display: block;
  margin-top: 8rpx;
}

.applicant-card {
  position: relative;
}

.applicant-head {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 8rpx;
}

.applicant-index {
  font-size: 24rpx;
  font-weight: 700;
  color: var(--lq-primary-dark, #4f46e5);
  background: #eef2ff;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
}

.applicant-name {
  flex: 1;
  font-size: 32rpx;
}

.applicant-card .hint {
  display: block;
  margin-top: 6rpx;
}

.applicant-actions {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-top: 16rpx;
}

.applicant-chat-btn {
  background: var(--lq-gradient);
  color: #fff;
  border-radius: 999rpx;
  font-size: 24rpx;
  border: none;
}

.applicant-chat-btn::after {
  border: none;
}

.applicant-tap-hint {
  font-size: 22rpx;
  color: #a5b4fc;
}

.pr-app-footer {
  margin: 32rpx 28rpx 0;
  padding-bottom: 24rpx;
}

.pr-app-footer .btn-primary {
  width: 100%;
}

.pr-app-footer-hint {
  display: block;
  text-align: center;
  margin-top: 16rpx;
}
