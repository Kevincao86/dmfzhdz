@import '../../styles/theme.wxss';
@import '../../styles/job-card-compact.wxss';

/* 发招募等页复用 */
.sub-header {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin: calc(env(safe-area-inset-top) + 16rpx) 28rpx 16rpx;
  padding: 28rpx;
  background: var(--lq-gradient-deep);
  border-radius: 28rpx;
  box-shadow: var(--lq-shadow-header);
}

.sub-header-logo {
  width: 64rpx;
  height: 64rpx;
  border-radius: 16rpx;
  background: #fff;
  padding: 8rpx;
}

.sub-header-title {
  display: block;
  font-size: 34rpx;
  font-weight: 700;
  color: #fff;
}

.sub-header-sub {
  display: block;
  margin-top: 6rpx;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.88);
}

/* —— 推荐页 —— */
.rec-page {
  background: var(--lq-bg);
}

.rec-top {
  flex-shrink: 0;
  box-sizing: border-box;
}

/* 通栏顶区：紫色贴顶，Logo 与标题同一行 */
.rec-head-band {
  position: relative;
  padding-bottom: 20rpx;
  background: var(--lq-gradient-deep);
  overflow: hidden;
  box-shadow: var(--lq-shadow-header);
}

.rec-head-inner {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding-left: 28rpx;
  box-sizing: border-box;
}

.rec-head-logo {
  width: 88rpx;
  height: 88rpx;
  flex-shrink: 0;
  display: block;
}

.rec-head-main {
  flex: 1;
  min-width: 0;
}

.rec-head-title-row {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 6rpx;
}

.rec-head-meta {
  display: block;
  margin-top: 6rpx;
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.78);
  letter-spacing: 1rpx;
}

.rec-search-bar {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin: 16rpx 28rpx 0;
  padding: 0 24rpx;
  height: 68rpx;
  background: #fff;
  border-radius: 999rpx;
  border: 1rpx solid var(--lq-border);
  box-shadow: var(--lq-shadow);
}

.rec-search-icon {
  font-size: 32rpx;
  color: #9ca3af;
  flex-shrink: 0;
}

.rec-search-input {
  flex: 1;
  min-width: 0;
  font-size: 26rpx;
  color: var(--lq-text);
}

.rec-search-ph {
  color: #9ca3af;
  font-size: 24rpx;
}

.rec-search-clear {
  width: 40rpx;
  height: 40rpx;
  line-height: 40rpx;
  text-align: center;
  font-size: 36rpx;
  color: #9ca3af;
  flex-shrink: 0;
}

.rec-test-bar {
  margin: 0 24rpx 12rpx;
  padding: 16rpx 20rpx;
  background: linear-gradient(135deg, #eef2ff 0%, #faf5ff 100%);
  border-radius: 14rpx;
  border: 1rpx solid #c7d2fe;
}

.rec-test-bar__text {
  display: block;
  font-size: 22rpx;
  color: #4338ca;
  line-height: 1.45;
}

.rec-test-bar__link {
  display: inline-block;
  margin-top: 8rpx;
  font-size: 24rpx;
  font-weight: 700;
  color: var(--lq-primary-dark);
}

.rec-seg-bar {
  display: flex;
  gap: 12rpx;
  margin: 0 24rpx 12rpx;
  padding: 6rpx;
  background: var(--lq-surface);
  border-radius: 14rpx;
  border: 1rpx solid var(--lq-border);
}

.rec-seg-item {
  flex: 1;
  text-align: center;
  padding: 14rpx 8rpx;
  font-size: 24rpx;
  font-weight: 600;
  color: var(--lq-text-secondary);
  border-radius: 10rpx;
}

.rec-seg-item--on {
  color: var(--lq-primary-dark);
  background: #eef2ff;
  font-weight: 700;
}

.rec-hero-deco {
  position: absolute;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.1);
  pointer-events: none;
}

.rec-hero-deco--1 {
  width: 140rpx;
  height: 140rpx;
  top: -50rpx;
  right: -30rpx;
}

.rec-hero-title {
  position: relative;
  z-index: 1;
  display: block;
  font-size: 30rpx;
  font-weight: 800;
  color: #fff;
  line-height: 1.3;
}

.rec-hero-sub {
  display: block;
  position: relative;
  z-index: 1;
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.88);
  line-height: 1.35;
}

.rec-hero-badge {
  flex-shrink: 0;
  padding: 6rpx 12rpx;
  border-radius: 999rpx;
  font-size: 18rpx;
  font-weight: 800;
  color: #fff;
  background: linear-gradient(135deg, #f59e0b, #ea580c);
}

.rec-filter-bar {
  display: flex;
  margin: 12rpx 28rpx;
  padding: 10rpx 0;
  background: var(--lq-surface);
  border-radius: 16rpx;
  border: 1rpx solid var(--lq-border);
  box-shadow: var(--lq-shadow);
  position: relative;
  z-index: 2;
}

.rec-filter-cell {
  flex: 1;
  min-width: 0;
  border-right: 1rpx solid #f3f4f6;
}

.rec-filter-cell:last-child {
  border-right: none;
}

.rec-filter-cell picker {
  width: 100%;
}

.rec-filter-item {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 2rpx;
  padding: 10rpx 4rpx;
  min-height: 56rpx;
  box-sizing: border-box;
}

.rec-filter-item--on .rec-filter-label {
  color: var(--lq-primary-dark);
  font-weight: 700;
}

.rec-filter-label {
  font-size: 22rpx;
  color: #374151;
  font-weight: 500;
  line-height: 1.3;
}

.rec-filter-arrow {
  font-size: 16rpx;
  color: #d1d5db;
  flex-shrink: 0;
}

.rec-scroll {
  padding: 0 28rpx 12rpx;
}

.rec-state {
  margin: 0 28rpx;
  flex-shrink: 0;
}

.list-hint {
  margin-top: 16rpx;
}

/* 紧凑达人卡片：一屏约 5–8 条 */
.talent-card-compact {
  position: relative;
  margin-bottom: 12rpx;
  padding: 16rpx 16rpx 16rpx 12rpx;
  background: #fff;
  border-radius: 16rpx;
  border: 1rpx solid var(--lq-border);
  box-shadow: 0 4rpx 16rpx rgba(79, 70, 229, 0.06);
}

.talent-card-compact--preview {
  border-color: #ddd6fe;
  background: linear-gradient(90deg, #fff 0%, #faf5ff 100%);
}

.talent-card-compact--self {
  border-color: #a5b4fc;
  background: linear-gradient(90deg, #fff 0%, #eef2ff 100%);
  box-shadow: 0 6rpx 20rpx rgba(79, 70, 229, 0.12);
}

.talent-preview-tag {
  position: absolute;
  top: 0;
  right: 0;
  padding: 2rpx 12rpx;
  font-size: 18rpx;
  font-weight: 700;
  color: #fff;
  background: #8b5cf6;
  border-radius: 0 16rpx 0 10rpx;
  z-index: 1;
}

.talent-ai-tag {
  position: absolute;
  top: 0;
  left: 0;
  max-width: 44%;
  padding: 4rpx 12rpx;
  font-size: 18rpx;
  font-weight: 700;
  color: #fff;
  border-radius: 16rpx 0 12rpx 0;
  z-index: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  background: linear-gradient(135deg, #6366f1, #4f46e5);
}

.talent-ai-tag--match {
  background: linear-gradient(135deg, #34d399, #059669);
}

.talent-ai-tag--hot {
  background: linear-gradient(135deg, #fb923c, #ea580c);
}

.talent-match-ribbon {
  position: absolute;
  top: 0;
  right: 0;
  padding: 4rpx 12rpx;
  font-size: 18rpx;
  font-weight: 800;
  color: #fff;
  background: linear-gradient(135deg, #10b981, #059669);
  border-radius: 0 16rpx 0 12rpx;
  z-index: 2;
}

.talent-meta--match {
  color: #059669;
  font-weight: 700;
}

.talent-status-tag {
  display: inline-block;
  flex-shrink: 0;
  padding: 2rpx 12rpx;
  font-size: 20rpx;
  font-weight: 700;
  border-radius: 8rpx;
}

.talent-status-tag--chat {
  color: #1d4ed8;
  background: #eff6ff;
  border: 1rpx solid #93c5fd;
}

.talent-status-tag--fav {
  color: #b45309;
  background: #fffbeb;
  border: 1rpx solid #fcd34d;
}

.talent-card-actions {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  flex-shrink: 0;
}

.talent-fav-star {
  width: 52rpx;
  height: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.talent-fav-star-glyph {
  font-size: 38rpx;
  line-height: 1;
  color: transparent;
  -webkit-text-stroke: 2rpx #9ca3af;
  text-shadow: 0 1rpx 4rpx rgba(107, 114, 128, 0.25);
}

.talent-fav-star--on .talent-fav-star-glyph {
  color: #f59e0b;
  -webkit-text-stroke: 0;
  text-shadow: 0 2rpx 10rpx rgba(245, 158, 11, 0.55);
}

.talent-card-compact__row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.talent-avatar-wrap {
  position: relative;
  flex-shrink: 0;
}

.talent-avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 16rpx;
  border: 2rpx solid #eef2ff;
  background: #f3f4f6;
  display: block;
}

.talent-online-dot {
  position: absolute;
  right: -2rpx;
  bottom: -2rpx;
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: #22c55e;
  border: 3rpx solid #fff;
}

.talent-card-compact__main {
  flex: 1;
  min-width: 0;
  padding-right: 4rpx;
}

.talent-line1 {
  display: flex;
  align-items: center;
  flex-wrap: nowrap;
  gap: 8rpx;
  margin-bottom: 4rpx;
}

.talent-nick {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--lq-text);
  max-width: 42%;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  flex-shrink: 1;
}

.talent-platform-pill {
  display: inline-flex;
  align-items: center;
  gap: 4rpx;
  padding: 2rpx 10rpx;
  border-radius: 999rpx;
  background: #1e1b2e;
  font-size: 18rpx;
  color: #fff;
  font-weight: 600;
  flex-shrink: 0;
}

.talent-platform-icon {
  width: 22rpx;
  height: 22rpx;
  border-radius: 4rpx;
}

.talent-line2 {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 6rpx;
  margin-bottom: 6rpx;
}

.talent-meta {
  font-size: 22rpx;
  color: var(--lq-primary-dark);
  font-weight: 600;
  line-height: 1.3;
}

.talent-meta--grade {
  color: #6b7280;
  font-weight: 500;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  max-width: 280rpx;
}

.talent-meta-sep {
  font-size: 20rpx;
  color: #d1d5db;
}

.talent-line3 {
  display: flex;
  flex-wrap: nowrap;
  gap: 6rpx;
  overflow: hidden;
}

.talent-tag {
  flex-shrink: 0;
  padding: 2rpx 10rpx;
  border-radius: 6rpx;
  font-size: 18rpx;
  font-weight: 500;
  color: #5b21b6;
  background: #ede9fe;
  max-width: 140rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.talent-tag--muted {
  color: #6b7280;
  background: #f3f4f6;
}

.talent-chat-mini {
  flex-shrink: 0;
  width: 88rpx;
  height: 56rpx;
  line-height: 56rpx;
  padding: 0;
  margin: 0;
  border-radius: 12rpx;
  background: var(--lq-gradient);
  color: #fff;
  font-size: 22rpx;
  font-weight: 700;
  border: none;
  box-shadow: 0 4rpx 12rpx rgba(99, 102, 241, 0.25);
}

.talent-chat-mini::after {
  border: none;
}

.talent-chat-mini--hover {
  opacity: 0.88;
}

.rec-foot-hint {
  padding: 16rpx 0 24rpx;
  text-align: center;
}
