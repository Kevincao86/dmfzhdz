@import '../../styles/theme.wxss';
@import '../../styles/hero-deco.wxss';
@import '../../styles/job-card-compact.wxss';

/* 发招募等页复用 */
.sub-header {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin: calc(env(safe-area-inset-top) + 16rpx) 28rpx 16rpx;
  padding: 28rpx;
  background: var(--lq-gradient-header);
  border-radius: var(--lq-radius-lg);
  box-shadow: var(--lq-shadow-header);
}

.sub-header-logo {
  width: 64rpx;
  height: 64rpx;
  border-radius: 16rpx;
  background: #fff;
  padding: 8rpx;
}

.sub-header-title {
  display: block;
  font-size: 34rpx;
  font-weight: 700;
  color: #fff;
}

.sub-header-sub {
  display: block;
  margin-top: 6rpx;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.88);
}

/* —— 推荐页 —— */
.rec-page {
  background: var(--lq-bg);
}

.rec-top {
  flex-shrink: 0;
  box-sizing: border-box;
}

/* 通栏顶区：紫色贴顶，Logo 与标题同一行 */
.rec-head-band {
  position: relative;
  padding-bottom: 24rpx;
  border-radius: 0 0 40rpx 40rpx;
  overflow: hidden;
  box-shadow: var(--lq-shadow-header);
}

.rec-head-inner {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding-left: 28rpx;
  box-sizing: border-box;
}

.rec-head-logo {
  width: 88rpx;
  height: 88rpx;
  flex-shrink: 0;
  display: block;
}

.rec-head-main {
  position: relative;
  z-index: 2;
  flex: 1;
  min-width: 0;
}

.rec-head-title-row {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 6rpx;
}

.rec-head-meta {
  display: inline-block;
  margin-top: 10rpx;
  padding: 8rpx 16rpx;
  max-width: 100%;
  box-sizing: border-box;
  font-size: 22rpx;
  font-weight: 500;
  line-height: 1.45;
  color: #fff;
  letter-spacing: 0;
  background: rgba(30, 27, 75, 0.42);
  border: 1rpx solid rgba(255, 255, 255, 0.22);
  border-radius: 12rpx;
  backdrop-filter: blur(6px);
}

.rec-head-band .lq-hero-bg--rec .lq-hero-bg__pattern {
  opacity: 0.32;
  left: -15%;
  width: 70%;
}

.rec-search-bar {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin: 16rpx 28rpx 0;
  padding: 0 24rpx;
  height: 68rpx;
  background: #fff;
  border-radius: 999rpx;
  border: 1rpx solid var(--lq-border);
  box-shadow: var(--lq-shadow);
}

.rec-search-icon {
  font-size: 32rpx;
  color: #9ca3af;
  flex-shrink: 0;
}

.rec-search-input {
  flex: 1;
  min-width: 0;
  font-size: 26rpx;
  color: var(--lq-text);
}

.rec-search-ph {
  color: #9ca3af;
  font-size: 24rpx;
}

.rec-search-clear {
  width: 40rpx;
  height: 40rpx;
  line-height: 40rpx;
  text-align: center;
  font-size: 36rpx;
  color: #9ca3af;
  flex-shrink: 0;
}

.rec-test-bar {
  margin: 0 24rpx 12rpx;
  padding: 16rpx 20rpx;
  background: linear-gradient(135deg, var(--lq-primary-50) 0%, #faf9fd 100%);
  border-radius: var(--lq-radius-sm);
  border: 1rpx solid var(--lq-primary-100);
}

.rec-test-bar__text {
  display: block;
  font-size: 22rpx;
  color: var(--lq-primary-dark);
  line-height: 1.45;
}

.rec-test-bar__link {
  display: inline-block;
  margin-top: 8rpx;
  font-size: 24rpx;
  font-weight: 700;
  color: var(--lq-primary-dark);
}

.rec-seg-bar {
  margin: 0 24rpx 12rpx;
}

.rec-seg-item--on::after {
  display: none;
}

.rec-hero-title {
  position: relative;
  z-index: 1;
  display: block;
  font-size: 30rpx;
  font-weight: 800;
  color: #fff;
  line-height: 1.3;
}

.rec-hero-sub {
  display: block;
  position: relative;
  z-index: 1;
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.96);
  line-height: 1.35;
  text-shadow: 0 2rpx 8rpx rgba(49, 46, 129, 0.35);
}

.rec-hero-badge {
  flex-shrink: 0;
  padding: 6rpx 14rpx;
  border-radius: 999rpx;
  font-size: 18rpx;
  font-weight: 800;
  color: #fff;
  background: linear-gradient(135deg, #fbbf24, #f59e0b, #ea580c);
  box-shadow: 0 4rpx 12rpx rgba(245, 158, 11, 0.35);
}

.rec-filter-bar {
  display: flex;
  margin: 12rpx 28rpx;
  padding: 10rpx 0;
  background: var(--lq-surface);
  border-radius: 16rpx;
  border: 1rpx solid var(--lq-border);
  box-shadow: var(--lq-shadow);
  position: relative;
  z-index: 2;
}

.rec-filter-cell {
  flex: 1;
  min-width: 0;
  border-right: 1rpx solid #f3f4f6;
}

.rec-filter-cell:last-child {
  border-right: none;
}

.rec-filter-cell picker {
  width: 100%;
}

.rec-filter-item {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 2rpx;
  padding: 10rpx 4rpx;
  min-height: 56rpx;
  box-sizing: border-box;
}

.rec-filter-item--on .rec-filter-label {
  color: var(--lq-primary-dark);
  font-weight: 700;
}

.rec-filter-label {
  font-size: 22rpx;
  color: #374151;
  font-weight: 500;
  line-height: 1.3;
}

.rec-filter-arrow {
  font-size: 16rpx;
  color: #d1d5db;
  flex-shrink: 0;
}

.rec-scroll {
  padding: 0 28rpx 12rpx;
}

.rec-state {
  margin: 0 28rpx;
  flex-shrink: 0;
}

.list-hint {
  margin-top: 16rpx;
}

/* 紧凑达人卡片：一屏约 5–8 条 */
.talent-card-compact {
  position: relative;
  margin-bottom: 16rpx;
  padding: 18rpx 18rpx 18rpx 14rpx;
  background: var(--lq-card);
  border-radius: var(--lq-radius-sm);
  border: 1rpx solid var(--lq-border);
  box-shadow: var(--lq-shadow-card);
}

.talent-card-compact--preview {
  border-color: var(--lq-primary-100);
  background: linear-gradient(90deg, #fff 0%, var(--lq-primary-50) 100%);
}

.talent-card-compact--self {
  border-color: var(--lq-primary-soft);
  background: linear-gradient(90deg, #fff 0%, var(--lq-primary-50) 100%);
  box-shadow: var(--lq-shadow);
}

.talent-preview-tag {
  position: absolute;
  top: 0;
  right: 0;
  padding: 2rpx 12rpx;
  font-size: 18rpx;
  font-weight: 700;
  color: #fff;
  background: var(--lq-primary);
  border-radius: 0 16rpx 0 10rpx;
  z-index: 1;
}

.talent-ai-tag {
  position: absolute;
  top: 0;
  left: 0;
  max-width: 44%;
  padding: 4rpx 12rpx;
  font-size: 18rpx;
  font-weight: 700;
  color: #fff;
  border-radius: 16rpx 0 12rpx 0;
  z-index: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  background: var(--lq-gradient);
}

.talent-ai-tag--match {
  background: linear-gradient(135deg, #8ed4b8, #6bc4a0);
}

.talent-ai-tag--hot {
  background: linear-gradient(135deg, #f5a88a, #e8926e);
}

.talent-match-ribbon {
  position: absolute;
  top: 0;
  right: 0;
  padding: 4rpx 12rpx;
  font-size: 18rpx;
  font-weight: 700;
  color: #fff;
  background: linear-gradient(135deg, #8ed4b8, #6bc4a0);
  border-radius: 0 16rpx 0 12rpx;
  z-index: 2;
}

.talent-meta--match {
  color: #4a9a78;
  font-weight: 600;
}

.talent-status-tag {
  display: inline-block;
  flex-shrink: 0;
  padding: 2rpx 12rpx;
  font-size: 20rpx;
  font-weight: 700;
  border-radius: 8rpx;
}

.talent-status-tag--chat {
  color: #1d4ed8;
  background: #eff6ff;
  border: 1rpx solid #93c5fd;
}

.talent-status-tag--fav {
  color: #b45309;
  background: #fffbeb;
  border: 1rpx solid #fcd34d;
}

.talent-card-actions {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  flex-shrink: 0;
}

.talent-fav-star {
  width: 52rpx;
  height: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.talent-fav-star-glyph {
  font-size: 38rpx;
  line-height: 1;
  color: transparent;
  -webkit-text-stroke: 2rpx #9ca3af;
  text-shadow: 0 1rpx 4rpx rgba(107, 114, 128, 0.25);
}

.talent-fav-star--on .talent-fav-star-glyph {
  color: #f59e0b;
  -webkit-text-stroke: 0;
  text-shadow: 0 2rpx 10rpx rgba(245, 158, 11, 0.55);
}

.talent-card-compact__row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.talent-avatar-wrap {
  position: relative;
  flex-shrink: 0;
}

.talent-avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 16rpx;
  border: 2rpx solid var(--lq-primary-100);
  background: #f3f4f6;
  display: block;
}

.talent-online-dot {
  position: absolute;
  right: -2rpx;
  bottom: -2rpx;
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: #22c55e;
  border: 3rpx solid #fff;
}

.talent-card-compact__main {
  flex: 1;
  min-width: 0;
  padding-right: 4rpx;
}

.talent-line1 {
  display: flex;
  align-items: center;
  flex-wrap: nowrap;
  gap: 8rpx;
  margin-bottom: 4rpx;
}

.talent-nick {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--lq-text);
  max-width: 42%;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  flex-shrink: 1;
}

.talent-platform-pill {
  display: inline-flex;
  align-items: center;
  gap: 4rpx;
  padding: 2rpx 10rpx;
  border-radius: 999rpx;
  background: #1e1b2e;
  font-size: 18rpx;
  color: #fff;
  font-weight: 600;
  flex-shrink: 0;
}

.talent-platform-icon {
  width: 22rpx;
  height: 22rpx;
  border-radius: 4rpx;
}

.talent-line2 {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 6rpx;
  margin-bottom: 6rpx;
}

.talent-meta {
  font-size: 22rpx;
  color: var(--lq-primary-dark);
  font-weight: 600;
  line-height: 1.3;
}

.talent-meta--grade {
  color: #6b7280;
  font-weight: 500;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  max-width: 280rpx;
}

.talent-meta-sep {
  font-size: 20rpx;
  color: #d1d5db;
}

.talent-line3 {
  display: flex;
  flex-wrap: nowrap;
  gap: 6rpx;
  overflow: hidden;
}

.talent-tag {
  flex-shrink: 0;
  padding: 2rpx 10rpx;
  border-radius: 6rpx;
  font-size: 18rpx;
  font-weight: 500;
  color: #5b21b6;
  background: #ede9fe;
  max-width: 140rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.talent-tag--muted {
  color: #6b7280;
  background: #f3f4f6;
}

.talent-chat-mini {
  flex-shrink: 0;
  width: 88rpx;
  height: 56rpx;
  line-height: 56rpx;
  padding: 0;
  margin: 0;
  border-radius: 12rpx;
  background: var(--lq-gradient);
  color: #fff;
  font-size: 22rpx;
  font-weight: 700;
  border: none;
  box-shadow: 0 4rpx 12rpx rgba(99, 102, 241, 0.25);
}

.talent-chat-mini::after {
  border: none;
}

.talent-chat-mini--hover {
  opacity: 0.88;
}

.rec-foot-hint {
  padding: 16rpx 0 24rpx;
  text-align: center;
}
