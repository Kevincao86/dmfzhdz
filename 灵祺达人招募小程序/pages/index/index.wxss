@import '../../styles/theme.wxss';
@import '../../styles/hero-deco.wxss';
@import '../../styles/job-card-compact.wxss';

.home-page {
  background: var(--lq-bg);
}

.home-header,
.home-toolbar,
.home-filters {
  flex-shrink: 0;
}

/* 顶部渐变区 + AI/本地生活装饰层 */
.home-header {
  padding-bottom: var(--lq-header-pad-bottom);
  border-radius: 0 0 40rpx 40rpx;
  box-shadow: var(--lq-shadow-header);
}

.home-header-inner {
  padding-left: 28rpx;
  box-sizing: border-box;
}

.brand-row {
  display: flex;
  align-items: center;
  gap: 24rpx;
  margin-bottom: 28rpx;
}

.brand-logo {
  flex-shrink: 0;
  display: block;
}

.brand-text {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  justify-content: center;
  gap: 6rpx;
}

.brand-title {
  display: block;
  font-size: 34rpx;
  font-weight: 700;
  color: #fff;
  letter-spacing: 1rpx;
  line-height: 1.25;
}

.brand-slogan {
  display: block;
  font-size: 24rpx;
  font-weight: 600;
  color: rgba(255, 255, 255, 0.95);
  line-height: 1.35;
}

.brand-desc {
  display: block;
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.78);
  line-height: 1.4;
}

.search-bar {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 0 28rpx;
  height: 76rpx;
  background: rgba(255, 255, 255, 0.96);
  border-radius: 999rpx;
  box-shadow: 0 6rpx 24rpx rgba(70, 74, 130, 0.1);
}

.search-icon {
  font-size: 36rpx;
  color: #9ca3af;
}

.search-input {
  flex: 1;
  font-size: 28rpx;
  color: var(--lq-text);
}

.search-ph {
  color: #9ca3af;
}

.notice-pill {
  display: inline-flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 20rpx;
  padding: 10rpx 20rpx;
  background: rgba(255, 255, 255, 0.2);
  border-radius: 999rpx;
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.96);
  backdrop-filter: blur(8px);
}

.notice-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: var(--lq-accent);
}

/* 大厅 Tab：渐变轨道 + 选中渐变块 */
.home-toolbar {
  position: relative;
  z-index: 2;
  margin: -20rpx 24rpx 0;
  padding: 0;
  background: transparent;
  border: none;
  box-shadow: none;
}

.hall-tabs-pro {
  width: 100%;
}

.hall-tab-pro.active::after {
  display: none;
}

.home-filters {
  padding-top: 8rpx;
}

.home-filters-warn {
  margin: 0 28rpx 8rpx;
}

.home-scroll {
  padding: 12rpx 0 20rpx;
}

.home-scroll .card {
  margin-left: 28rpx;
  margin-right: 28rpx;
}

.list-hint {
  margin-top: 20rpx;
}

.filter-bar {
  display: flex;
  align-items: stretch;
  margin: 0 24rpx 14rpx;
  padding: 10rpx 0;
  background: var(--lq-gradient-filter);
  border-radius: var(--lq-radius-md);
  border: 1rpx solid rgba(99, 102, 241, 0.15);
  box-shadow: var(--lq-shadow-card);
}

.filter-cell {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  border-right: 1rpx solid var(--lq-border);
}

.filter-cell:last-child {
  border-right: none;
}

.filter-cell picker {
  width: 100%;
}

.filter-item {
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 4rpx;
  padding: 8rpx 4rpx;
  box-sizing: border-box;
}

.filter-item--active .filter-label {
  color: var(--lq-primary-dark);
  font-weight: 700;
}

.filter-item--active .filter-arrow {
  color: var(--lq-primary);
}

.filter-label {
  font-size: 24rpx;
  color: var(--lq-text);
  font-weight: 500;
  max-width: 100%;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.filter-item--muted .filter-label {
  color: #9ca3af;
}

.filter-arrow {
  font-size: 20rpx;
  color: #d1d5db;
}

.state-warn {
  margin-bottom: 12rpx;
  background: #fef8ee;
  border-color: #f5e6c8;
}

.empty-title {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  margin: 12rpx 0 8rpx;
}

.empty-block {
  margin-bottom: 32rpx;
}
