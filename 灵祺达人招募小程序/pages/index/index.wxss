@import '../../styles/theme.wxss';
@import '../../styles/job-card-compact.wxss';

.home-page {
  background: var(--lq-bg);
}

.home-header,
.home-toolbar,
.home-filters {
  flex-shrink: 0;
}

/* 顶部渐变区：仅品牌与搜索（顶距由 JS 按胶囊对齐） */
.home-header {
  background: var(--lq-gradient-deep);
  padding-bottom: var(--lq-header-pad-bottom);
  box-shadow: var(--lq-shadow-header);
}

.home-header-inner {
  padding-left: 28rpx;
  box-sizing: border-box;
}

.brand-row {
  display: flex;
  align-items: center;
  gap: 24rpx;
  margin-bottom: 28rpx;
}

.brand-logo {
  flex-shrink: 0;
  display: block;
}

.brand-text {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  justify-content: center;
  gap: 6rpx;
}

.brand-title {
  display: block;
  font-size: 34rpx;
  font-weight: 800;
  color: #fff;
  letter-spacing: 2rpx;
  line-height: 1.25;
}

.brand-slogan {
  display: block;
  font-size: 24rpx;
  font-weight: 600;
  color: rgba(255, 255, 255, 0.95);
  line-height: 1.35;
}

.brand-desc {
  display: block;
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.78);
  line-height: 1.4;
}

.search-bar {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 0 28rpx;
  height: 76rpx;
  background: rgba(255, 255, 255, 0.98);
  border-radius: 999rpx;
  box-shadow: 0 8rpx 28rpx rgba(30, 27, 46, 0.12);
}

.search-icon {
  font-size: 36rpx;
  color: #9ca3af;
}

.search-input {
  flex: 1;
  font-size: 28rpx;
  color: var(--lq-text);
}

.search-ph {
  color: #9ca3af;
}

.notice-pill {
  display: inline-flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 20rpx;
  padding: 10rpx 20rpx;
  background: rgba(255, 255, 255, 0.16);
  border-radius: 999rpx;
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.95);
}

.notice-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: var(--lq-accent);
}

/* 大厅 Tab：独立白卡片 */
.home-toolbar {
  margin: 20rpx 28rpx 0;
  padding: 8rpx;
  background: var(--lq-surface);
  border-radius: var(--lq-radius-md);
  border: 1rpx solid var(--lq-border);
  box-shadow: var(--lq-shadow);
}

.hall-tabs-pro {
  display: flex;
  gap: 8rpx;
}

.hall-tab-pro {
  position: relative;
  flex: 1;
  text-align: center;
  padding: 22rpx 8rpx 18rpx;
  font-size: 28rpx;
  font-weight: 600;
  color: var(--lq-text-secondary);
  border-radius: 14rpx;
}

.hall-tab-pro.active {
  color: var(--lq-primary-dark);
  background: #eef2ff;
}

.hall-tab-pro.active::after {
  content: '';
  position: absolute;
  left: 50%;
  bottom: 10rpx;
  width: 40rpx;
  height: 6rpx;
  margin-left: -20rpx;
  border-radius: 3rpx;
  background: var(--lq-primary);
}

.tab-count {
  margin-left: 6rpx;
  font-size: 22rpx;
  color: var(--lq-primary);
}

.home-filters {
  padding-top: 8rpx;
}

.home-filters-warn {
  margin: 0 28rpx 8rpx;
}

.home-scroll {
  padding: 8rpx 0 16rpx;
}

.home-scroll .card {
  margin-left: 28rpx;
  margin-right: 28rpx;
}

.list-hint {
  margin-top: 20rpx;
}

.filter-bar {
  display: flex;
  align-items: stretch;
  margin: 0 28rpx 12rpx;
  padding: 12rpx 0;
  background: var(--lq-surface);
  border-radius: var(--lq-radius-md);
  border: 1rpx solid var(--lq-border);
  box-shadow: var(--lq-shadow);
}

.filter-cell {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  border-right: 1rpx solid #f3f4f6;
}

.filter-cell:last-child {
  border-right: none;
}

.filter-cell picker {
  width: 100%;
}

.filter-item {
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 4rpx;
  padding: 8rpx 4rpx;
  box-sizing: border-box;
}

.filter-item--active .filter-label {
  color: var(--lq-primary-dark);
  font-weight: 700;
}

.filter-item--active .filter-arrow {
  color: var(--lq-primary);
}

.filter-label {
  font-size: 24rpx;
  color: #374151;
  font-weight: 500;
  max-width: 100%;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.filter-item--muted .filter-label {
  color: #9ca3af;
}

.filter-arrow {
  font-size: 20rpx;
  color: #d1d5db;
}

.state-warn {
  margin-bottom: 12rpx;
  background: #fffbeb;
  border-color: #fde68a;
}

.empty-title {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  margin: 12rpx 0 8rpx;
}

.empty-block {
  margin-bottom: 32rpx;
}
