@import '../../styles/theme.wxss';

.mine-page {
  background: var(--lq-bg);
}

.mine-header,
.wx-login-banner {
  flex-shrink: 0;
}

.mine-scroll {
  padding-bottom: 8rpx;
}

.mine-header {
  background: var(--lq-gradient-deep);
  padding-bottom: 28rpx;
  border-radius: 0 0 40rpx 40rpx;
  box-shadow: var(--lq-shadow-header);
}

.mine-header-inner {
  padding-left: 28rpx;
  padding-bottom: 8rpx;
}

.profile-row {
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding-right: 28rpx;
}

.profile-avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  border: 4rpx solid rgba(255, 255, 255, 0.9);
  flex-shrink: 0;
}

.profile-avatar--ph {
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(255, 255, 255, 0.95);
}

.profile-avatar-logo {
  width: 72rpx;
  height: 72rpx;
}

.profile-meta {
  flex: 1;
  min-width: 0;
}

.profile-name-row {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 12rpx;
}

.profile-name {
  font-size: 36rpx;
  font-weight: 700;
  color: #fff;
  max-width: 100%;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.identity-switch-btn {
  display: inline-flex;
  align-items: center;
  gap: 4rpx;
  padding: 6rpx 18rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.28);
  border: 1rpx solid rgba(255, 255, 255, 0.5);
  flex-shrink: 0;
}

.identity-switch-label {
  font-size: 22rpx;
  font-weight: 600;
  color: #fff;
}

.identity-switch-arrow {
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.9);
  line-height: 1;
  margin-top: 2rpx;
}

.profile-sub {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.88);
  line-height: 1.4;
}

.profile-identity-id {
  display: block;
  margin-top: 6rpx;
  font-size: 22rpx;
  font-weight: 700;
  color: #fef3c7;
  letter-spacing: 0.5rpx;
}

.profile-badges {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 12rpx;
}

.profile-badge {
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  background: rgba(255, 255, 255, 0.28);
  color: #fff;
}

.profile-badge--muted {
  background: rgba(15, 23, 42, 0.15);
}

.profile-edit {
  font-size: 44rpx;
  color: rgba(255, 255, 255, 0.8);
  font-weight: 300;
  flex-shrink: 0;
}

.wx-login-banner,
.vip-banner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin: 20rpx 28rpx 0 !important;
}

.wx-login-sheet .wx-login-profile {
  display: flex;
  align-items: center;
  gap: 24rpx;
  margin: 24rpx 0;
}

.wx-avatar-btn {
  padding: 0;
  margin: 0;
  background: transparent;
  border: none;
  line-height: 1;
}

.wx-avatar-btn::after {
  border: none;
}

.wx-login-avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  border: 2rpx solid #e2e8f0;
}

.wx-login-avatar--ph {
  display: flex;
  align-items: center;
  justify-content: center;
  background: #f1f5f9;
  font-size: 24rpx;
  color: #94a3b8;
}

.wx-login-nick-input {
  flex: 1;
  height: 80rpx;
  padding: 0 24rpx;
  background: #f8fafc;
  border-radius: 16rpx;
  font-size: 28rpx;
}

.wx-login-submit {
  margin-top: 8rpx;
}

.vip-text {
  flex: 1;
  font-size: 26rpx;
  color: #6d28d9;
  font-weight: 500;
}

.vip-btn {
  padding: 0 28rpx;
  height: 64rpx;
  line-height: 64rpx;
  font-size: 24rpx;
  background: linear-gradient(135deg, #fbbf24, #f59e0b);
  color: #fff;
  border-radius: 999rpx;
  border: none;
}

.vip-btn::after {
  border: none;
}

.menu-section {
  padding: 8rpx 0 12rpx;
}

.menu-card {
  display: flex;
  align-items: center;
  gap: 22rpx;
  margin: 14rpx 28rpx 0;
  padding: 24rpx 28rpx;
  background: #fff;
  border-radius: 28rpx;
  box-shadow: 0 6rpx 28rpx rgba(79, 70, 229, 0.06);
}

/* 液态图标容器 */
.menu-icon-wrap {
  width: 80rpx;
  height: 80rpx;
  flex-shrink: 0;
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
}

.menu-blob {
  position: absolute;
  inset: 0;
  border-radius: 58% 42% 52% 48% / 48% 56% 44% 52%;
  overflow: hidden;
}

.menu-icon-wrap--info .menu-blob {
  background: linear-gradient(145deg, #60a5fa 0%, #3b82f6 42%, #6366f1 100%);
  box-shadow:
    inset 10rpx 10rpx 24rpx rgba(255, 255, 255, 0.42),
    inset -6rpx -10rpx 20rpx rgba(37, 99, 235, 0.35),
    0 10rpx 24rpx rgba(59, 130, 246, 0.32);
}

.menu-icon-wrap--list .menu-blob {
  border-radius: 52% 48% 46% 54% / 54% 44% 56% 46%;
  background: linear-gradient(155deg, #c4b5fd 0%, #8b5cf6 45%, #7c3aed 100%);
  box-shadow:
    inset 10rpx 8rpx 22rpx rgba(255, 255, 255, 0.38),
    inset -8rpx -8rpx 18rpx rgba(91, 33, 182, 0.3),
    0 10rpx 22rpx rgba(139, 92, 246, 0.28);
}

.menu-icon-wrap--tpl .menu-blob {
  border-radius: 46% 54% 50% 50% / 50% 50% 54% 46%;
  background: linear-gradient(150deg, #fde68a 0%, #fbbf24 40%, #f59e0b 100%);
  box-shadow:
    inset 10rpx 10rpx 22rpx rgba(255, 255, 255, 0.45),
    inset -6rpx -8rpx 16rpx rgba(180, 83, 9, 0.25),
    0 10rpx 22rpx rgba(245, 158, 11, 0.28);
}

.menu-icon-wrap--bell .menu-blob {
  border-radius: 54% 46% 48% 52% / 46% 54% 52% 48%;
  background: linear-gradient(145deg, #fbcfe8 0%, #f472b6 42%, #ec4899 100%);
  box-shadow:
    inset 10rpx 8rpx 22rpx rgba(255, 255, 255, 0.42),
    inset -8rpx -10rpx 18rpx rgba(190, 24, 93, 0.28),
    0 10rpx 22rpx rgba(236, 72, 153, 0.26);
}

.menu-icon-wrap--chart .menu-blob {
  border-radius: 50% 50% 44% 56% / 56% 44% 56% 44%;
  background: linear-gradient(145deg, #a5b4fc 0%, #818cf8 40%, #6366f1 100%);
  box-shadow:
    inset 10rpx 10rpx 24rpx rgba(255, 255, 255, 0.4),
    inset -6rpx -10rpx 20rpx rgba(67, 56, 202, 0.32),
    0 10rpx 24rpx rgba(99, 102, 241, 0.28);
}

.menu-icon-wrap--support .menu-blob {
  border-radius: 48% 52% 54% 46% / 52% 46% 54% 48%;
  background: linear-gradient(145deg, #6ee7b7 0%, #34d399 42%, #10b981 100%);
  box-shadow:
    inset 10rpx 10rpx 22rpx rgba(255, 255, 255, 0.42),
    inset -6rpx -10rpx 18rpx rgba(4, 120, 87, 0.28),
    0 10rpx 22rpx rgba(16, 185, 129, 0.26);
}

.menu-blob-shine {
  position: absolute;
  top: 10rpx;
  left: 14rpx;
  width: 32rpx;
  height: 20rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.62);
  transform: rotate(-22deg);
  filter: blur(1rpx);
}

.menu-blob-glow {
  position: absolute;
  right: 6rpx;
  bottom: 8rpx;
  width: 24rpx;
  height: 24rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.18);
}

.menu-glyph {
  position: relative;
  z-index: 1;
  width: 44rpx;
  height: 44rpx;
}

/* 资料 · 用户 */
.glyph-user {
  position: relative;
  width: 100%;
  height: 100%;
}

.glyph-user-head {
  position: absolute;
  top: 4rpx;
  left: 50%;
  width: 18rpx;
  height: 18rpx;
  margin-left: -9rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.95);
  box-shadow: 0 2rpx 6rpx rgba(30, 64, 175, 0.2);
}

.glyph-user-body {
  position: absolute;
  bottom: 2rpx;
  left: 50%;
  width: 32rpx;
  height: 18rpx;
  margin-left: -16rpx;
  border-radius: 18rpx 18rpx 8rpx 8rpx;
  background: rgba(255, 255, 255, 0.92);
}

/* 列表 */
.glyph-list {
  position: relative;
  width: 100%;
  height: 100%;
}

.glyph-list-bar {
  position: absolute;
  left: 6rpx;
  height: 7rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.95);
  box-shadow: 0 2rpx 4rpx rgba(91, 33, 182, 0.15);
}

.glyph-list-bar {
  top: 10rpx;
  width: 32rpx;
}

.glyph-list-bar--2 {
  top: 20rpx;
  width: 26rpx;
  opacity: 0.92;
}

.glyph-list-bar--3 {
  top: 30rpx;
  width: 20rpx;
  opacity: 0.85;
}

/* 模版 */
.glyph-tpl {
  position: relative;
  width: 100%;
  height: 100%;
}

.glyph-tpl-back {
  position: absolute;
  top: 6rpx;
  left: 8rpx;
  width: 26rpx;
  height: 32rpx;
  border-radius: 8rpx;
  background: rgba(255, 255, 255, 0.45);
  transform: rotate(-6deg);
}

.glyph-tpl-front {
  position: absolute;
  top: 12rpx;
  left: 14rpx;
  width: 26rpx;
  height: 32rpx;
  border-radius: 8rpx;
  border: 3rpx solid rgba(255, 255, 255, 0.95);
  background: rgba(255, 255, 255, 0.12);
  box-sizing: border-box;
}

/* 通知 */
.glyph-bell {
  position: relative;
  width: 100%;
  height: 100%;
}

.glyph-bell-knob {
  position: absolute;
  top: 2rpx;
  left: 50%;
  width: 8rpx;
  height: 6rpx;
  margin-left: -4rpx;
  border-radius: 4rpx 4rpx 0 0;
  background: rgba(255, 255, 255, 0.9);
}

.glyph-bell-top {
  position: absolute;
  top: 8rpx;
  left: 50%;
  width: 26rpx;
  height: 24rpx;
  margin-left: -13rpx;
  border-radius: 14rpx 14rpx 10rpx 10rpx;
  background: rgba(255, 255, 255, 0.95);
}

.glyph-bell-clapper {
  position: absolute;
  bottom: 6rpx;
  left: 50%;
  width: 10rpx;
  height: 10rpx;
  margin-left: -5rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.88);
}

/* 数据 */
.glyph-chart {
  position: absolute;
  left: 4rpx;
  right: 4rpx;
  bottom: 6rpx;
  height: 32rpx;
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 6rpx;
}

.glyph-chart-bar {
  flex: 1;
  border-radius: 6rpx 6rpx 4rpx 4rpx;
  background: rgba(255, 255, 255, 0.95);
  box-shadow: 0 2rpx 6rpx rgba(67, 56, 202, 0.15);
}

.glyph-chart-bar--1 {
  height: 14rpx;
  opacity: 0.82;
}

.glyph-chart-bar--2 {
  height: 22rpx;
  opacity: 0.9;
}

.glyph-chart-bar--3 {
  height: 30rpx;
}

/* 客服 */
.glyph-support {
  position: relative;
  width: 100%;
  height: 100%;
}

.glyph-support-bubble {
  position: absolute;
  top: 4rpx;
  left: 4rpx;
  width: 36rpx;
  height: 30rpx;
  border-radius: 16rpx;
  background: rgba(255, 255, 255, 0.95);
  box-shadow: 0 2rpx 8rpx rgba(4, 120, 87, 0.15);
  display: flex;
  align-items: center;
  justify-content: center;
}

.glyph-support-tail {
  position: absolute;
  left: 10rpx;
  bottom: -5rpx;
  width: 10rpx;
  height: 10rpx;
  border-radius: 0 0 0 8rpx;
  background: rgba(255, 255, 255, 0.95);
  transform: rotate(-24deg);
}

.glyph-support-q {
  font-size: 22rpx;
  font-weight: 800;
  color: #059669;
  line-height: 1;
}

.menu-body {
  flex: 1;
  min-width: 0;
}

.menu-label {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  color: #0f172a;
}

.menu-sub {
  display: block;
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #94a3b8;
}

.menu-right {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.menu-arrow {
  font-size: 36rpx;
  color: #cbd5e1;
}

.menu-badge {
  min-width: 36rpx;
  padding: 0 10rpx;
  line-height: 36rpx;
  border-radius: 18rpx;
  background: #ef4444;
  color: #fff;
  font-size: 22rpx;
  text-align: center;
}

/* 身份切换弹层 */
.id-sheet-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 10000;
  background: rgba(15, 23, 42, 0.45);
  display: flex;
  align-items: flex-end;
}

.id-sheet {
  width: 100%;
  padding: 28rpx 28rpx calc(28rpx + env(safe-area-inset-bottom));
  background: #fff;
  border-radius: 32rpx 32rpx 0 0;
  box-shadow: 0 -12rpx 48rpx rgba(15, 23, 42, 0.12);
}

.id-sheet-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 8rpx;
}

.id-sheet-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #0f172a;
}

.id-sheet-close {
  font-size: 44rpx;
  color: #94a3b8;
  line-height: 1;
  padding: 0 8rpx;
}

.id-sheet-hint {
  display: block;
  font-size: 24rpx;
  color: #94a3b8;
  margin-bottom: 24rpx;
}

.id-sheet-opt {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 24rpx;
  margin-top: 16rpx;
  border-radius: 20rpx;
  border: 2rpx solid #e2e8f0;
  background: #f8fafc;
}

.id-sheet-opt.active {
  border-color: var(--lq-primary, #6366f1);
  background: #eef2ff;
}

.id-sheet-opt-icon {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  flex-shrink: 0;
  position: relative;
}

.id-sheet-opt-icon--talent {
  background: linear-gradient(145deg, #c7d2fe, #818cf8);
}

.id-sheet-opt-icon--talent::before {
  content: '';
  position: absolute;
  top: 14rpx;
  left: 50%;
  width: 18rpx;
  height: 18rpx;
  margin-left: -9rpx;
  border-radius: 50%;
  background: #fff;
}

.id-sheet-opt-icon--talent::after {
  content: '';
  position: absolute;
  bottom: 12rpx;
  left: 50%;
  width: 32rpx;
  height: 16rpx;
  margin-left: -16rpx;
  border-radius: 16rpx 16rpx 4rpx 4rpx;
  background: #fff;
}

.id-sheet-opt-icon--pr {
  background: linear-gradient(145deg, #ddd6fe, #a78bfa);
}

.id-sheet-opt-icon--pr::before {
  content: 'PR';
  position: absolute;
  inset: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  font-weight: 800;
  color: #fff;
  letter-spacing: 1rpx;
}

.id-sheet-opt-body {
  flex: 1;
  min-width: 0;
}

.id-sheet-opt-title {
  display: block;
  font-size: 30rpx;
  font-weight: 700;
  color: #0f172a;
}

.id-sheet-opt-sub {
  display: block;
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #64748b;
  line-height: 1.4;
}

.id-sheet-check {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--lq-primary-dark, #4f46e5);
  flex-shrink: 0;
}
