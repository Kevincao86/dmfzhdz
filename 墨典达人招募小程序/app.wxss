page {
  background: #f3f4f6;
  color: #111827;
  font-size: 28rpx;
  line-height: 1.5;
  padding-bottom: env(safe-area-inset-bottom);
}

.card {
  margin: 20rpx 24rpx 0;
  padding: 28rpx;
  background: #fff;
  border-radius: 16rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #111827;
  margin-bottom: 20rpx;
}

.hint {
  color: #6b7280;
  font-size: 24rpx;
}

.title-lg {
  font-size: 36rpx;
  font-weight: 700;
  line-height: 1.35;
  color: #111827;
}

.tag {
  display: inline-block;
  margin-right: 12rpx;
  margin-top: 12rpx;
  padding: 6rpx 16rpx;
  border-radius: 8rpx;
  font-size: 22rpx;
}

.tag-pink {
  background: #fce7f3;
  color: #db2777;
}

.tag-blue {
  background: #dbeafe;
  color: #2563eb;
}

.tag-gray {
  background: #f3f4f6;
  color: #4b5563;
}

.metrics {
  display: flex;
  border: 1rpx solid #e5e7eb;
  border-radius: 12rpx;
  overflow: hidden;
}

.metric-cell {
  flex: 1;
  padding: 20rpx 12rpx;
  text-align: center;
  border-right: 1rpx solid #e5e7eb;
}

.metric-cell:last-child {
  border-right: none;
}

.metric-label {
  font-size: 22rpx;
  color: #9ca3af;
}

.metric-value {
  margin-top: 8rpx;
  font-size: 28rpx;
  font-weight: 600;
  color: #111827;
}

.metric-value.accent {
  color: #2563eb;
}

.line-item {
  padding: 12rpx 0;
  font-size: 26rpx;
  color: #374151;
  border-bottom: 1rpx solid #f3f4f6;
}

.line-item:last-child {
  border-bottom: none;
}

.btn-copy {
  float: right;
  font-size: 24rpx;
  color: #2563eb;
  font-weight: normal;
}

.btn-primary {
  background: linear-gradient(135deg, #3b82f6, #6366f1);
  color: #fff;
  border-radius: 44rpx;
  font-size: 30rpx;
  font-weight: 600;
  border: none;
}

.btn-ghost {
  background: #fff;
  color: #2563eb;
  border: 2rpx solid #3b82f6;
  border-radius: 44rpx;
  font-size: 28rpx;
}

.bottom-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 16rpx 24rpx calc(16rpx + env(safe-area-inset-bottom));
  background: #fff;
  border-top: 1rpx solid #e5e7eb;
  box-shadow: 0 -4rpx 20rpx rgba(0, 0, 0, 0.06);
}

.bottom-icon {
  width: 88rpx;
  text-align: center;
  font-size: 20rpx;
  color: #6b7280;
  background: transparent;
  border: none;
  padding: 0;
  line-height: 1.3;
}

.bottom-icon::after {
  border: none;
}

.page-with-bar {
  padding-bottom: 160rpx;
}

.order-no {
  font-size: 22rpx;
  color: #9ca3af;
  font-family: monospace;
}

.merchant-name {
  font-size: 26rpx;
  color: #6b7280;
  margin-top: 8rpx;
}

.input {
  margin-top: 8rpx;
  padding: 16rpx 20rpx;
  background: #f9fafb;
  border: 1rpx solid #e5e7eb;
  border-radius: 12rpx;
  font-size: 28rpx;
}
