.section-title {
  overflow: hidden;
}

.apply-form .form-row {
  margin-top: 20rpx;
}

.apply-form .form-label {
  display: block;
  font-size: 24rpx;
  color: #6b7280;
  margin-bottom: 8rpx;
}

.apply-form .picker-val {
  padding: 16rpx 20rpx;
  background: #f9fafb;
  border: 1rpx solid #e5e7eb;
  border-radius: 12rpx;
  font-size: 28rpx;
  color: #111827;
}

.form-row-inline {
  display: flex;
  gap: 16rpx;
}

.form-col {
  flex: 1;
}
