<view class="page-with-bar">
  <view wx:if="{{loading}}" class="card hint">加载中…</view>
  <view wx:elif="{{err}}" class="card hint" style="color:#dc2626;">{{err}}</view>

  <block wx:elif="{{view}}">
    <view class="card" style="margin-top:24rpx;">
      <view class="order-no" bindtap="copyOrderNo">
        商家订单号 {{view.merchantOrderNo}}
        <text style="color:#2563eb;margin-left:8rpx;">复制</text>
      </view>
      <text class="merchant-name">商家：{{view.merchantName}} · {{view.storeName}}</text>
      <text class="title-lg" style="margin-top:20rpx;display:block;">{{view.title}}</text>
      <view>
        <text wx:for="{{view.tags}}" wx:key="text" class="tag tag-{{item.tone}}">{{item.text}}</text>
      </view>
    </view>

    <view class="card">
      <view class="section-title">达人地域要求 (1)</view>
      <text style="font-size:28rpx;color:#374151;">{{view.region}}</text>
    </view>

    <view class="card">
      <view class="section-title">招募信息</view>
      <view wx:for="{{view.recruitmentInfoLines}}" wx:key="*this" class="line-item">{{item}}</view>
    </view>

    <view class="card">
      <view class="section-title">
        任务详情
        <text class="btn-copy" bindtap="copyTask">复制</text>
      </view>
      <view wx:for="{{view.taskDetailLines}}" wx:key="*this" class="line-item">{{item}}</view>
    </view>

    <view class="card">
      <view class="section-title">任务流程</view>
      <text class="hint" style="display:block;line-height:1.7;">
        1. 点击「我要报名」填写信息并提交；&#10;2. 商家/运营反选通过后，将联系您确认探店排期；&#10;3. 完成内容发布后按商家要求结算。
      </text>
    </view>

    <view class="card" wx:if="{{applied}}">
      <text class="title-lg" style="font-size:32rpx;color:#059669;">已提交报名</text>
      <text class="hint" style="display:block;margin-top:12rpx;">订单 {{view.merchantOrderNo}}，请等待反选结果。</text>
    </view>
  </block>
</view>

<view wx:if="{{view && !loading}}" class="bottom-bar">
  <button class="bottom-icon" open-type="share">分享</button>
  <button class="bottom-icon" bindtap="goHome">首页</button>
  <button wx:if="{{!applied}}" class="btn-primary" style="flex:1;margin:0;" bindtap="goApply">我要报名</button>
  <button wx:else class="btn-primary" style="flex:1;margin:0;" open-type="share">分享给好友</button>
</view>
