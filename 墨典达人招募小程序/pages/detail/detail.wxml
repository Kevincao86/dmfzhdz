<view class="page-shell page-with-bar">
  <view wx:if="{{loading}}" class="card state-loading">
    <view class="loading-dot-wrap">
      <view class="loading-dot" />
      <view class="loading-dot" />
      <view class="loading-dot" />
    </view>
    <text class="hint" style="margin-top:20rpx;">加载任务详情…</text>
  </view>
  <view wx:elif="{{err}}" class="card state-error state-empty">
    <text class="state-empty-icon">!</text>
    <text>{{err}}</text>
  </view>

  <block wx:elif="{{view}}">
    <view class="card detail-hero">
      <view class="detail-hero-top">
        <view class="order-no" bindtap="copyOrderNo">
          订单 {{view.merchantOrderNo}}
          <text class="order-copy">复制</text>
        </view>
        <text class="merchant-name">{{view.merchantName}} · {{view.storeName}}</text>
        <text class="title-lg">{{view.title}}</text>
        <view>
          <text wx:for="{{view.tags}}" wx:key="text" class="tag tag-{{item.tone}}">{{item.text}}</text>
        </view>
      </view>
      <view class="detail-body">
        <view class="metrics">
          <view class="metric-cell">
            <view class="metric-label">地域</view>
            <view class="metric-value accent">{{view.region}}</view>
          </view>
          <view class="metric-cell">
            <view class="metric-label">预算</view>
            <view class="metric-value">{{view.budgetText}}</view>
          </view>
          <view class="metric-cell">
            <view class="metric-label">需求</view>
            <view class="metric-value">{{view.recruitCount}}人</view>
          </view>
        </view>
      </view>
    </view>

    <view class="card">
      <view class="section-head">
        <view class="section-head-dot" />
        <text class="section-title">招募信息</text>
      </view>
      <view wx:for="{{view.recruitmentInfoLines}}" wx:key="*this" class="line-item">{{item}}</view>
    </view>

    <view class="card">
      <view class="section-head">
        <view class="section-head-dot" />
        <text class="section-title">任务详情</text>
        <text class="btn-copy" bindtap="copyTask">复制全文</text>
      </view>
      <view wx:for="{{view.taskDetailLines}}" wx:key="*this" class="line-item">{{item}}</view>
    </view>

    <view class="card card--flat">
      <view class="section-head">
        <view class="section-head-dot" />
        <text class="section-title">参与流程</text>
      </view>
      <view class="steps" wx:if="{{isIce}}">
        <view class="step-item">
          <text class="step-num">1</text>
          <text class="step-body">认领任务并填写达人资料</text>
        </view>
        <view class="step-item">
          <text class="step-num">2</text>
          <text class="step-body">下载系统分配的云剪成片</text>
        </view>
        <view class="step-item">
          <text class="step-num">3</text>
          <text class="step-body">发布抖音后回传作品链接，AI 自动核查</text>
        </view>
      </view>
      <view class="steps" wx:else>
        <view class="step-item">
          <text class="step-num">1</text>
          <text class="step-body">点击「我要报名」填写信息（无需注册会员）</text>
        </view>
        <view class="step-item">
          <text class="step-num">2</text>
          <text class="step-body">会员可选择是否同步已保存资料</text>
        </view>
        <view class="step-item">
          <text class="step-num">3</text>
          <text class="step-body">商家反选通过后确认探店排期</text>
        </view>
        <view class="step-item">
          <text class="step-num">4</text>
          <text class="step-body">完成内容发布，按约定结算</text>
        </view>
      </view>
    </view>

    <view class="card card--success" wx:if="{{applied && isIce && assignedVideoUrl}}">
      <text class="success-title">✓ 已分配成片</text>
      <text class="hint" style="display:block;margin-top:12rpx;">{{assignedVideoLabel || '云剪成片'}}</text>
      <button class="btn-primary" style="margin-top:20rpx;" bindtap="openDownload">复制下载链接</button>
      <view wx:if="{{!iceVerified}}" style="margin-top:24rpx;">
        <text class="hint">发布抖音后粘贴作品链接：</text>
        <input class="ice-input" placeholder="https://www.douyin.com/..." value="{{douyinUrl}}" bindinput="onDouyinField" />
        <button class="btn-primary" style="margin-top:16rpx;" loading="{{iceSubmitting}}" bindtap="submitIceDouyin">提交链接 · AI 核查</button>
      </view>
      <text wx:else class="success-title" style="display:block;margin-top:16rpx;">✓ AI 核查已通过</text>
    </view>

    <view class="card card--success" wx:elif="{{applied && !isIce}}">
      <text class="success-title">✓ 报名已提交</text>
      <text class="hint" style="display:block;margin-top:12rpx;">订单 {{view.merchantOrderNo}}，请耐心等待反选结果。</text>
    </view>
  </block>
</view>

<view wx:if="{{view && !loading}}" class="bottom-bar">
  <button class="bottom-icon" open-type="share">分享</button>
  <button class="bottom-icon" bindtap="goHome">首页</button>
  <button wx:if="{{!applied}}" class="btn-primary bottom-cta" bindtap="goApply">{{isIce ? '认领云剪任务' : '我要报名'}}</button>
  <button wx:else class="btn-primary bottom-cta" open-type="share">邀请好友</button>
</view>
