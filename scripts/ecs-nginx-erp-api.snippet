# 追加到 /etc/nginx/sites-available/meoo-api 的 server { } 内（api.mofangdianai.com HTTPS 块）
#
# 1) 先 ECS 上运行: bash scripts/ecs-setup-internal-api-proxy.sh
#    bash scripts/ecs-run-auth-api.sh  （或 systemd，见下）
# 2) 把下面 location 粘贴进 meoo-api 的 server 块，然后 sudo nginx -t && sudo systemctl reload nginx
# 3) Vercel 环境变量增加:
#    VITE_ERP_AUTH_API_BASE=https://api.mofangdianai.com/erp-api
#    Redeploy 前端

    location /erp-api/ {
        if ($request_method = OPTIONS) {
            add_header Access-Control-Allow-Origin *;
            add_header Access-Control-Allow-Methods "GET, POST, OPTIONS";
            add_header Access-Control-Allow-Headers "Content-Type";
            return 204;
        }
        # CORS 由 Auth API (3001) 响应头提供；此处不要再 add_header，否则会与 upstream 重复成 "*, *"

        proxy_pass http://127.0.0.1:3001/api/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
