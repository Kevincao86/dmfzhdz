# 已废弃：轻量 8000 多为 Supabase（/erp-api 会 401）。请用 ecs-nginx-erp-api-18780.snippet
# 备案期：云函数若 443/80 均 ECONNRESET，曾在 8000 明文反代（勿与 Supabase 抢 8000）
# 用法（在 ECS/轻量）：
#   sudo tee /etc/nginx/snippets/erp-api-8000.conf < ~/app/scripts/ecs-nginx-erp-api-8000.snippet
#   echo 'include snippets/erp-api-8000.conf;' | sudo tee /etc/nginx/sites-available/erp-api-8000.conf
#   sudo ln -sf /etc/nginx/sites-available/erp-api-8000.conf /etc/nginx/sites-enabled/
#   sudo nginx -t && sudo systemctl reload nginx
#   curl -sS -H "Host: mofangdianai.com" http://127.0.0.1:8000/erp-api/mp-cronet-ping

server {
    listen 8000;
    server_name mofangdianai.com;

    location = /erp-api/mp-cronet-ping {
        default_type application/json;
        add_header Access-Control-Allow-Origin * always;
        return 200 '{"ok":true,"via":"nginx-cronet-ping-8000"}';
    }

    location /erp-api/ {
        client_max_body_size 52m;
        gzip off;
        proxy_pass http://127.0.0.1:3001/api/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto http;
    }
}
