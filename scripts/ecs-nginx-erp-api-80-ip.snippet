# 方案 B：Vercel supabaseAdminFetch 经 HTTP:80 + IP Host 访问 GoTrue/PostgREST（非 erp-api 注册 relay）
# 安装: sudo bash scripts/ecs-install-beian-http-80.sh
# 自测: curl -sS -H "Host: 139.196.42.5" http://127.0.0.1/erp-api/meoo-erp-api-health

server {
    listen 80;
    server_name 139.196.42.5;

    location = /erp-api/mp-cronet-ping {
        default_type application/json;
        add_header Access-Control-Allow-Origin * always;
        return 200 '{"ok":true,"via":"nginx-cronet-ping-80-ip"}';
    }

    location /erp-api/ {
        client_max_body_size 52m;
        gzip off;
        proxy_pass http://127.0.0.1:3001/api/;
        proxy_http_version 1.1;
        proxy_set_header Host mofangdianai.com;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto http;
    }

    location /auth/v1/ {
        proxy_pass http://127.0.0.1:9999/;
        proxy_http_version 1.1;
        proxy_set_header Host mofangdianai.com;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto http;
    }

    location /rest/v1/ {
        proxy_pass http://127.0.0.1:3000/;
        proxy_http_version 1.1;
        proxy_set_header Host mofangdianai.com;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto http;
    }
}
