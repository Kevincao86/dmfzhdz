# 备案期：腾讯云 443 易 ECONNRESET，80+域名 Host 易备案页；用「80 + IP Host」明文反代
# sudo tee /etc/nginx/snippets/erp-api-80-ip.conf < ~/app/scripts/ecs-nginx-erp-api-80-ip.snippet
# printf '%s\n' 'include snippets/erp-api-80-ip.conf;' | sudo tee /etc/nginx/sites-enabled/erp-api-80-ip.conf
# sudo nginx -t && sudo systemctl reload nginx
# curl -sS -H "Host: 139.196.42.5" http://127.0.0.1/erp-api/mp-cronet-ping

server {
    listen 80;
    server_name 139.196.42.5;

    location = /erp-api/mp-cronet-ping {
        default_type application/json;
        add_header Access-Control-Allow-Origin * always;
        return 200 '{"ok":true,"via":"nginx-cronet-ping-80-ip"}';
    }

    location /erp-api/ {
        client_max_body_size 4m;
        gzip off;
        proxy_pass http://127.0.0.1:3001/api/;
        proxy_http_version 1.1;
        proxy_set_header Host mofangdianai.com;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto http;
    }
}
