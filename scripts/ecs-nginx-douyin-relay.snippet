# 抖音 OpenAPI 中继 location（须在 server { } 内 include）
# DOUYIN_OPENAPI_BASE_URL=http://139.196.42.5/douyin → POST /douyin/oauth/client_token/
location /douyin/ {
    proxy_pass https://open.douyin.com/;
    proxy_ssl_server_name on;
    proxy_set_header Host open.douyin.com;
    proxy_http_version 1.1;
    proxy_set_header Connection "";
    client_max_body_size 20m;
    proxy_connect_timeout 30s;
    proxy_read_timeout 120s;
}
