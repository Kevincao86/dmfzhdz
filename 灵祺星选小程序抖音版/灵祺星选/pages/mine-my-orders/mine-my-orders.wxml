<view class="orders-page {{lqThemeClass}}">
  <scroll-view class="orders-scroll" scroll-y enhanced show-scrollbar="{{false}}">
    <view wx:if="{{loading && !usage.pointsSummary}}" class="orders-state">加载中…</view>
    <view wx:elif="{{err}}" class="orders-state orders-state--err">{{err}}</view>

    <block wx:else>
      <view class="usage-note">{{usage.deductOrderNote}}</view>

      <view class="usage-card">
        <view class="usage-card__title">积分概览</view>
        <view class="usage-grid" wx:if="{{usage.pointsSummary}}">
          <view class="usage-cell">
            <text class="usage-dt">当前总积分</text>
            <text class="usage-dd usage-dd--primary">{{usage.pointsSummary.balance}}</text>
          </view>
          <view class="usage-cell">
            <text class="usage-dt">套餐赠送剩余</text>
            <text class="usage-dd">{{usage.pointsSummary.packageRemaining}}</text>
          </view>
          <view class="usage-cell">
            <text class="usage-dt">充值积分剩余</text>
            <text class="usage-dd">{{usage.pointsSummary.rechargeBalance}}</text>
          </view>
          <view class="usage-cell">
            <text class="usage-dt">本月已消耗</text>
            <text class="usage-dd">{{usage.pointsSummary.monthlySpent}}</text>
          </view>
        </view>
      </view>

      <view class="usage-card">
        <view class="usage-card__title">
          套餐次数 / 分钟用量
          <text wx:if="{{usage.quotaMonth}}" class="usage-sub">（{{usage.quotaMonth}}）</text>
        </view>
        <view wx:if="{{usage.quotaRows.length === 0}}" class="usage-empty">当前版本暂无套餐配额项</view>
        <view wx:else class="quota-list">
          <view wx:for="{{usage.quotaRows}}" wx:key="key" class="quota-row">
            <text class="quota-label">{{item.label}}</text>
            <view class="quota-metrics">
              <text>额度 {{item.displayLimit}}</text>
              <text class="quota-used">已用 {{item.displayUsed}}</text>
              <text class="quota-left">剩余 {{item.displayRemaining}}</text>
            </view>
          </view>
        </view>
      </view>

      <view class="usage-card">
        <view class="usage-card__title">积分消耗明细</view>
        <view wx:if="{{usage.pointsLedger.length === 0}}" class="usage-empty">暂无积分消耗记录</view>
        <view wx:else class="ledger-list">
          <view wx:for="{{usage.pointsLedger}}" wx:key="id" class="ledger-row">
            <view class="ledger-main">
              <text class="ledger-kind">{{item.kindLabel}}</text>
              <text wx:if="{{item.note}}" class="ledger-note">{{item.note}}</text>
              <text class="ledger-time">{{item.createdAtLabel}}</text>
            </view>
            <view class="ledger-side">
              <text class="ledger-points">-{{item.points}} 积分</text>
              <text class="ledger-balance">剩余 {{item.balanceAfter}}</text>
            </view>
          </view>
        </view>
      </view>

      <view class="orders-section-title">支付订单</view>

      <view class="orders-tabs">
        <view
          class="orders-tab {{tab === 'all' ? 'is-active' : ''}}"
          data-tab="all"
          bindtap="onPickTab"
        >全部</view>
        <view
          class="orders-tab {{tab === 'membership' ? 'is-active' : ''}}"
          data-tab="membership"
          bindtap="onPickTab"
        >会员</view>
        <view
          class="orders-tab {{tab === 'points' ? 'is-active' : ''}}"
          data-tab="points"
          bindtap="onPickTab"
        >充值</view>
      </view>

      <view wx:if="{{empty}}" class="orders-state orders-state--compact">暂无支付订单</view>

      <view
        wx:for="{{visibleOrders}}"
        wx:key="key"
        class="order-card {{item.highlight ? 'order-card--hl' : ''}}"
      >
        <view class="order-head">
          <view>
            <text class="order-kind">{{item.kindLabel}}</text>
            <text class="order-title">{{item.title}}</text>
          </view>
          <text class="order-status order-status--{{item.status}}">{{item.statusLabel}}</text>
        </view>
        <view class="order-grid">
          <view class="order-cell">
            <text class="order-dt">金额</text>
            <text class="order-dd">¥{{item.amountYuan}}</text>
          </view>
          <view class="order-cell">
            <text class="order-dt">支付方式</text>
            <text class="order-dd">{{item.payModeLabel}}</text>
          </view>
          <view class="order-cell">
            <text class="order-dt">创建时间</text>
            <text class="order-dd">{{item.createdAtLabel}}</text>
          </view>
          <view class="order-cell">
            <text class="order-dt">{{item.paidAtTitle}}</text>
            <text class="order-dd">{{item.paidAtLabel}}</text>
          </view>
        </view>
        <text wx:if="{{item.outTradeNo}}" class="order-no">商户单号 {{item.outTradeNo}}</text>
      </view>
    </block>
  </scroll-view>

  <view class="orders-refresh" bindtap="onReload" wx:if="{{!loading}}">
    <text>刷新</text>
  </view>
</view>
