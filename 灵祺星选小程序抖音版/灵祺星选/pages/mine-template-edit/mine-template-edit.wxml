<view class="page-shell tpl-edit-page">
  <view class="card apply-form">
    <view class="section-head">
      <view class="section-head-dot" />
      <text class="section-title">表单编辑</text>
    </view>
    <text class="tpl-edit-sub">按需自定义达人报名内容，与招募单平台联动</text>
    <view class="form-row">
      <text class="form-label">模版名称</text>
      <input class="input" placeholder="如：小红书探店报名" value="{{name}}" bindinput="onNameInput" />
    </view>
    <view class="form-row">
      <text class="form-label">预览平台（标签随平台变化）</text>
      <picker mode="selector" range="{{platformOptions}}" value="{{previewPlatformIndex}}" bindchange="onPreviewPlatformChange">
        <view class="picker-val">{{previewPlatform}}</view>
      </picker>
    </view>
  </view>

  <view class="card tpl-field-list">
    <view
      class="tpl-field-row"
      wx:for="{{editorRows}}"
      wx:key="id"
    >
      <view class="tpl-field-type">
        <text class="tpl-field-type-txt">{{item.typeIcon}}</text>
        <text class="tpl-field-type-label">{{item.type === 'number' || item.type === 'digit' ? '数字' : '文本'}}</text>
      </view>
      <view class="tpl-field-main">
        <text class="tpl-field-label">{{item.displayLabel}}</text>
        <view class="tpl-field-req">
          <text class="tpl-field-req-txt">必填</text>
          <switch
            class="tpl-req-switch"
            checked="{{item.required}}"
            color="#2563eb"
            disabled="{{item.locked}}"
            data-id="{{item.id}}"
            bindchange="onToggleRequired"
          />
        </view>
      </view>
      <view class="tpl-field-actions">
        <view class="tpl-field-btn" data-id="{{item.id}}" bindtap="onEditField">编辑</view>
        <view
          wx:if="{{item.deletable}}"
          class="tpl-field-btn tpl-field-btn--danger"
          data-id="{{item.id}}"
          bindtap="onDeleteField"
        >
          删除
        </view>
      </view>
    </view>

    <view class="tpl-add-btn" bindtap="onAddCustomField">+ 自定义其他报名项</view>
  </view>

  <view class="tpl-edit-footer">
    <button class="btn-secondary tpl-footer-btn" bindtap="onPreview">预览</button>
    <button class="btn-primary tpl-footer-btn" bindtap="onSave">保存</button>
  </view>
</view>

<view class="tpl-modal-mask" wx:if="{{showFieldModal}}" bindtap="onCloseFieldModal" />
<view class="tpl-modal" wx:if="{{showFieldModal}}">
  <text class="tpl-modal-title">编辑报名项</text>
  <view class="form-row" wx:if="{{canEditLabel}}">
    <text class="form-label">名称</text>
    <input class="input" value="{{editLabel}}" bindinput="onEditLabelInput" />
  </view>
  <view class="form-row" wx:else>
    <text class="form-label">名称</text>
    <text class="tpl-modal-readonly">{{editLabel}}</text>
    <text class="hint">平台联动项名称随招募平台自动变化</text>
  </view>
  <view class="form-row">
    <text class="form-label">占位提示</text>
    <input class="input" placeholder="选填" value="{{editPlaceholder}}" bindinput="onEditPlaceholderInput" />
  </view>
  <view class="form-row tpl-modal-req">
    <text class="form-label">必填</text>
    <switch class="tpl-req-switch" checked="{{editRequired}}" color="#2563eb" bindchange="onEditRequiredChange" />
  </view>
  <view class="tpl-modal-actions">
    <button class="btn-secondary" bindtap="onCloseFieldModal">取消</button>
    <button class="btn-primary" bindtap="onConfirmFieldEdit">确定</button>
  </view>
</view>

<view class="tpl-modal-mask" wx:if="{{showPreviewPanel}}" bindtap="onClosePreview" />
<view class="tpl-preview-sheet" wx:if="{{showPreviewPanel}}">
  <view class="tpl-preview-head">
    <text class="tpl-preview-title">报名预览</text>
    <text class="tpl-preview-sub">{{name || '未命名模版'}} · {{previewPlatform}}</text>
    <view class="tpl-preview-close" bindtap="onClosePreview">关闭</view>
  </view>
  <scroll-view scroll-y class="tpl-preview-scroll">
    <view class="form-row" wx:for="{{previewRows}}" wx:key="id">
      <text class="form-label">{{item.displayLabel}}{{item.required ? ' *' : ''}}</text>
      <view class="picker-val picker-val--placeholder" wx:if="{{item.isPicker || item.isDate || item.isTime || item.isRegion}}">
        {{item.placeholder || '请选择'}}
      </view>
      <view class="picker-val picker-val--placeholder" wx:else>{{item.placeholder || '请填写'}}</view>
    </view>
    <text class="hint tpl-preview-foot">实际报名时字段名称随招募单平台自动变化。</text>
  </scroll-view>
</view>
