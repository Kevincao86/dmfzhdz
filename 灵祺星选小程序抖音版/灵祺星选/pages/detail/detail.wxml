<view class="page-shell page-with-bar {{lqThemeClass}}">
  <view wx:if="{{loading}}" class="card state-loading">
    <view class="loading-dot-wrap">
      <view class="loading-dot" />
      <view class="loading-dot" />
      <view class="loading-dot" />
    </view>
    <text class="hint" style="margin-top:20rpx;">加载任务详情…</text>
  </view>
  <view wx:elif="{{err}}" class="card state-error state-empty">
    <text class="state-empty-icon">!</text>
    <text>{{err}}</text>
  </view>

  <block wx:elif="{{view}}">
    <!-- 图2风格：封面 Banner + 标题 + 信息行 -->
    <view class="detail-v2">
      <view wx:if="{{coverImage}}" class="detail-v2-banner">
        <image class="detail-v2-banner__img" src="{{coverImage}}" mode="aspectFill" />
      </view>

      <view class="detail-v2-head card {{coverImage ? '' : 'detail-v2-head--flush'}}">
        <view class="detail-v2-head__main">
          <text class="detail-v2-title">{{view.title}}</text>
          <view class="detail-v2-tags">
            <text wx:for="{{detailCategoryTags}}" wx:key="*this" class="detail-v2-tag">{{item}}</text>
          </view>
          <view class="order-no detail-v2-order-no" bindtap="copyOrderNo">
            招募单号 {{view.merchantOrderNo}}
            <text class="order-copy">复制</text>
          </view>
          <text wx:if="{{!view.isFormRelay}}" class="detail-v2-countdown detail-v2-countdown--{{signupCountdownTone}}">报名倒计时 {{signupCountdownText}}</text>
        </view>
        <view class="detail-v2-share-wrap">
          <view class="detail-share-menu-mask" wx:if="{{showShareMenu}}" bindtap="onShareMenuClose"></view>
          <view wx:if="{{showShareMenu}}" class="detail-share-menu detail-share-menu--head" catchtap="noopShareSheetTap">
            <button class="detail-share-menu__item detail-share-menu__item--primary" open-type="share" bindtap="onShareMenuClose">分享小程序卡片</button>
            <view class="detail-share-menu__item" bindtap="onSharePickPoster">分享海报</view>
          </view>
          <view class="detail-v2-share-btn" bindtap="onShareTap">
            <text class="detail-v2-share-icon">↗</text>
            <text class="detail-v2-share-label">分享</text>
          </view>
        </view>
        <view class="detail-v2-qr" wx:if="{{prQrImage}}">
          <image
            class="detail-v2-qr-img"
            src="{{prQrImage}}"
            mode="aspectFit"
            bindtap="onPreviewPrQr"
            bindlongpress="onLongPressPrQr"
            show-menu-by-longpress="{{true}}"
          />
          <text class="detail-v2-qr-cap">长按查看认证</text>
        </view>
        <canvas type="2d" id="detailPrQrCanvas" class="detail-hero-qr-canvas" />
      </view>

      <view class="card card--success" wx:if="{{applied && !isIce}}">
        <text class="success-title">✓ 报名已提交</text>
        <view wx:if="{{visitScheduleSubmitted}}" class="visit-schedule-status">
          <text class="visit-schedule-status__title">✓ 档期已提交</text>
          <text class="visit-schedule-status__hint" wx:if="{{visitSubmittedText}}">{{visitSubmittedText}}</text>
        </view>
        <view wx:elif="{{showCheckInBtn && visitHint}}" class="visit-schedule-status visit-schedule-status--assigned">
          <text class="visit-schedule-status__title">✓ PR 已确认排期</text>
          <text class="visit-schedule-status__hint">{{visitHint}}</text>
        </view>
        <text class="hint" style="display:block;margin-top:12rpx;" wx:if="{{visitHint && !visitScheduleSubmitted}}">{{visitHint}}</text>
        <text class="hint" style="display:block;margin-top:12rpx;" wx:elif="{{canContactPr && !showVisitConfirmBtn && !visitScheduleSubmitted}}">PR 已通过您的报名，请填写计划探店日期与时段并提交意向。</text>
        <text class="hint" style="display:block;margin-top:12rpx;" wx:elif="{{!visitScheduleSubmitted && !showVisitConfirmBtn}}">订单 {{view.merchantOrderNo}}，请等待招募方 PR 审核；通过后可联系招募方。</text>
        <view wx:if="{{showVisitConfirmBtn}}" class="visit-action-row">
          <view class="visit-plan-form card">
            <text class="visit-plan-form__title">填写探店计划</text>
            <text wx:if="{{hasLockedPlanDates}}" class="hint" style="display:block;margin-bottom:16rpx;">PR 已开放可探店日期，请从下列选项中选择。</text>
            <block wx:if="{{hasLockedPlanDates}}">
              <picker mode="selector" range="{{visitPlanDateLabels}}" value="{{visitPlanDateIdx}}" bindchange="onVisitPlanDateIdxChange">
                <view class="visit-plan-picker">
                  <text class="visit-plan-picker__label">探店日期</text>
                  <text class="visit-plan-picker__value">{{visitPlanDateLabels[visitPlanDateIdx] || '请选择日期'}}</text>
                </view>
              </picker>
              <picker mode="selector" range="{{visitPlanSlotOptions}}" value="{{visitPlanSlotIdx}}" bindchange="onVisitPlanSlotIdxChange">
                <view class="visit-plan-picker" style="margin-top:16rpx;">
                  <text class="visit-plan-picker__label">探店时段</text>
                  <text class="visit-plan-picker__value">{{visitPlanSlotOptions[visitPlanSlotIdx] || '请选择时段'}}</text>
                </view>
              </picker>
            </block>
            <block wx:else>
            <picker mode="date" value="{{visitPlanDate}}" start="{{visitPlanStart}}" bindchange="onVisitPlanDateChange">
              <view class="visit-plan-picker">
                <text class="visit-plan-picker__label">探店日期</text>
                <text class="visit-plan-picker__value">{{visitPlanDate || '请选择日期'}}</text>
              </view>
            </picker>
            <view class="visit-plan-time-row">
              <picker mode="time" value="{{visitStartTime}}" bindchange="onVisitStartTimeChange">
                <view class="visit-plan-picker visit-plan-picker--half">
                  <text class="visit-plan-picker__label">开始时间</text>
                  <text class="visit-plan-picker__value">{{visitStartTime || '请选择'}}</text>
                </view>
              </picker>
              <picker mode="time" value="{{visitEndTime}}" bindchange="onVisitEndTimeChange">
                <view class="visit-plan-picker visit-plan-picker--half">
                  <text class="visit-plan-picker__label">结束时间</text>
                  <text class="visit-plan-picker__value">{{visitEndTime || '请选择'}}</text>
                </view>
              </picker>
            </view>
            </block>
          </view>
          <button class="btn-primary visit-action-btn" loading="{{visitBusy}}" bindtap="confirmVisitSelection">提交探店意向</button>
        </view>
        <view wx:if="{{showEditVisitBtn}}" class="visit-action-row">
          <view wx:if="{{visitScheduleRevised}}" class="visit-schedule-status visit-schedule-status--warn">
            <text class="visit-schedule-status__title">商单探店时间已变更</text>
            <text class="visit-schedule-status__hint">请与PR沟通并重新调整探店时间</text>
          </view>
          <view class="visit-plan-form card">
            <text class="visit-plan-form__title">{{editVisitMode === 'preference' ? '修改探店意向' : '修改探店排期'}}</text>
            <block wx:if="{{hasLockedPlanDates}}">
              <picker mode="selector" range="{{visitPlanDateLabels}}" value="{{visitPlanDateIdx}}" bindchange="onVisitPlanDateIdxChange">
                <view class="visit-plan-picker">
                  <text class="visit-plan-picker__label">探店日期</text>
                  <text class="visit-plan-picker__value">{{visitPlanDateLabels[visitPlanDateIdx] || '请选择日期'}}</text>
                </view>
              </picker>
              <picker mode="selector" range="{{visitPlanSlotOptions}}" value="{{visitPlanSlotIdx}}" bindchange="onVisitPlanSlotIdxChange">
                <view class="visit-plan-picker" style="margin-top:16rpx;">
                  <text class="visit-plan-picker__label">探店时段</text>
                  <text class="visit-plan-picker__value">{{visitPlanSlotOptions[visitPlanSlotIdx] || '请选择时段'}}</text>
                </view>
              </picker>
            </block>
            <block wx:else>
            <picker mode="date" value="{{visitPlanDate}}" start="{{visitPlanStart}}" bindchange="onVisitPlanDateChange">
              <view class="visit-plan-picker">
                <text class="visit-plan-picker__label">探店日期</text>
                <text class="visit-plan-picker__value">{{visitPlanDate || '请选择日期'}}</text>
              </view>
            </picker>
            <view class="visit-plan-time-row">
              <picker mode="time" value="{{visitStartTime}}" bindchange="onVisitStartTimeChange">
                <view class="visit-plan-picker visit-plan-picker--half">
                  <text class="visit-plan-picker__label">开始时间</text>
                  <text class="visit-plan-picker__value">{{visitStartTime || '请选择'}}</text>
                </view>
              </picker>
              <picker mode="time" value="{{visitEndTime}}" bindchange="onVisitEndTimeChange">
                <view class="visit-plan-picker visit-plan-picker--half">
                  <text class="visit-plan-picker__label">结束时间</text>
                  <text class="visit-plan-picker__value">{{visitEndTime || '请选择'}}</text>
                </view>
              </picker>
            </view>
            </block>
          </view>
          <button class="btn-primary visit-action-btn" loading="{{visitBusy}}" bindtap="updateVisitPlanTap">{{editVisitMode === 'preference' ? '保存意向修改' : '保存排期修改'}}</button>
        </view>
        <view wx:if="{{showAssignConfirmBtn}}" class="visit-action-row visit-action-row--split">
          <button class="btn-primary visit-action-btn visit-action-btn--half" loading="{{visitBusy}}" bindtap="confirmVisitAssignment">确认排期</button>
          <button class="btn-secondary visit-action-btn visit-action-btn--half visit-action-btn--ghost" loading="{{visitBusy}}" bindtap="declineVisitAssignment">我有冲突</button>
        </view>
        <view wx:if="{{showCheckInBtn}}" class="visit-action-row">
          <button class="btn-primary visit-action-btn" loading="{{visitBusy}}" disabled="{{!checkInReady}}" bindtap="visitCheckInTap">{{checkInReady ? '探店签到' : '探店日当天可签到'}}</button>
        </view>
        <text wx:if="{{showCheckInBtn && !showEditVisitBtn && canContactPr}}" class="hint" style="display:block;margin-top:12rpx;">排期已确认，如需调整请联系招募方。</text>
        <view wx:if="{{canViewVideo || canSubmitVisitPublishLink}}" class="visit-action-row" style="margin-top:24rpx;">
          <view wx:if="{{canViewVideo}}" class="visit-video-row">
            <button class="btn-secondary visit-action-btn visit-action-btn--ghost" bindtap="onViewUploadedVideo">查看已上传视频</button>
          </view>
          <block wx:if="{{canSubmitVisitPublishLink}}">
          <text class="visit-plan-form__title">回传发布链接</text>
          <text wx:if="{{visitPublishHint}}" class="hint" style="display:block;margin:12rpx 0;color:#b45309;">{{visitPublishHint}}</text>
          <input class="ice-input" placeholder="{{visitPublishPlaceholder}}" value="{{visitPublishUrl}}" bindinput="onVisitPublishField" />
          <button class="btn-primary visit-action-btn" style="margin-top:16rpx;" loading="{{visitPublishSubmitting}}" bindtap="submitVisitPublishLink">提交链接 · AI 核查</button>
          </block>
        </view>
      </view>

      <view class="detail-v2-info card">
        <view class="detail-v2-info-row">
          <text class="detail-v2-info-icon">🕐</text>
          <view class="detail-v2-info-body">
            <text class="detail-v2-info-label">报名时间</text>
            <text class="detail-v2-info-val">{{signupTimeRange}}</text>
          </view>
        </view>
        <view class="detail-v2-info-row">
          <text class="detail-v2-info-icon">👤</text>
          <view class="detail-v2-info-body">
            <text class="detail-v2-info-label">招募人数</text>
            <text class="detail-v2-info-val">{{recruitCountText}}</text>
          </view>
        </view>
        <view class="detail-v2-info-row">
          <text class="detail-v2-info-icon">✓</text>
          <view class="detail-v2-info-body">
            <text class="detail-v2-info-label">已报名人数</text>
            <text class="detail-v2-info-val">{{applicantCountText}}</text>
          </view>
        </view>
        <view class="detail-v2-info-row">
          <text class="detail-v2-info-icon">📍</text>
          <view class="detail-v2-info-body">
            <text class="detail-v2-info-label">地域</text>
            <text class="detail-v2-info-val">{{locationText}}</text>
          </view>
        </view>
        <view class="detail-v2-info-row">
          <text class="detail-v2-info-icon">🛡</text>
          <view class="detail-v2-info-body">
            <text class="detail-v2-info-label">预算</text>
            <text class="detail-v2-info-val">{{benefitsText}}</text>
          </view>
        </view>
      </view>

    <view class="card">
      <view class="detail-v2-section-title">
        <text class="detail-v2-quote">"</text>
        <text>活动详情</text>
        <text class="detail-v2-quote">"</text>
      </view>
      <view wx:for="{{view.recruitmentInfoLines}}" wx:for-item="line" wx:key="*this" class="line-item detail-v2-line">{{line}}</view>
    </view>
    </view>

    <view class="card card--flat">
      <view class="section-head">
        <view class="section-head-dot" />
        <text class="section-title">参与流程</text>
      </view>
      <view class="steps" wx:if="{{isIce && isEditIce}}">
        <view class="step-item">
          <text class="step-num">1</text>
          <text class="step-body">剪辑身份认领并填写认领条数</text>
        </view>
        <view class="step-item">
          <text class="step-num">2</text>
          <text class="step-body">确认接收后查看剪辑师群码</text>
        </view>
        <view class="step-item">
          <text class="step-num">3</text>
          <text class="step-body">批量回传成片 https 链接</text>
        </view>
      </view>
      <view class="steps" wx:elif="{{isIce}}">
        <view class="step-item">
          <text class="step-num">1</text>
          <text class="step-body">认领云剪任务（闭环）</text>
        </view>
        <view class="step-item">
          <text class="step-num">2</text>
          <text class="step-body">确认接收后下载分配成片</text>
        </view>
        <view class="step-item">
          <text class="step-num">3</text>
          <text class="step-body">{{iceStep3Hint || '发布抖音并回传链接，AI 核查通过后自动完成'}}</text>
        </view>
      </view>
      <view class="steps" wx:elif="{{view.isFormRelay}}">
        <block wx:if="{{view.formRelayGroupQr}}">
          <view class="step-item">
            <text class="step-num">1</text>
            <text class="step-body">点击「前往原表报名」查看群二维码</text>
          </view>
          <view class="step-item">
            <text class="step-num">2</text>
            <text class="step-body">长按识别二维码，加入微信群</text>
          </view>
        </block>
        <block wx:else>
          <view class="step-item">
            <text class="step-num">1</text>
            <text class="step-body">点击「前往原表报名」打开原招募表单</text>
          </view>
          <view class="step-item">
            <text class="step-num">2</text>
            <text class="step-body">在原表填写信息并提交（按原表要求）</text>
          </view>
        </block>
        <view class="step-item">
          <text class="step-num">3</text>
          <text class="step-body">后续进度与结算以原表/招募方通知为准</text>
        </view>
      </view>
      <view class="steps" wx:else>
        <view class="step-item">
          <text class="step-num">1</text>
          <text class="step-body">点击「我要报名」填写信息（无需注册会员）</text>
        </view>
        <view class="step-item">
          <text class="step-num">2</text>
          <text class="step-body">会员可选择是否填入已保存资料</text>
        </view>
        <view class="step-item">
          <text class="step-num">3</text>
          <text class="step-body">招募方 PR 在报名列表「确认选择」您（审核通过）</text>
        </view>
        <view class="step-item">
          <text class="step-num">4</text>
          <text class="step-body">审核通过后可「联系招募方」，并确认探店排期</text>
        </view>
        <view class="step-item">
          <text class="step-num">5</text>
          <text class="step-body">完成内容发布，按约定结算</text>
        </view>
      </view>
    </view>

    <view class="card card--success" wx:if="{{applied && isIce && isEditIce && icePendingConfirm}}">
      <text class="success-title">待确认接收</text>
      <view class="ice-slot-stats">
        <view class="ice-slot-stat">
          <text class="ice-slot-stat__label">认领条数</text>
          <text class="ice-slot-stat__value">{{claimedSlotCount}}</text>
        </view>
      </view>
      <text class="hint" style="display:block;margin-top:12rpx;">请确认是否接受该剪辑云剪任务；拒绝后名额将释放。</text>
      <view style="display:flex;gap:16rpx;margin-top:20rpx;">
        <button class="btn-primary" style="flex:1;" loading="{{iceConfirming}}" bindtap="confirmIceReceipt">确认接收</button>
        <button class="btn-secondary" style="flex:1;" loading="{{iceConfirming}}" bindtap="rejectIceTask">拒绝</button>
      </view>
    </view>

    <view class="card card--success" wx:elif="{{applied && isIce && isEditIce && iceRejected}}">
      <text class="success-title">已拒绝任务</text>
      <text class="hint" style="display:block;margin-top:12rpx;">任务已拒绝，名额已释放，可重新认领。</text>
    </view>

    <view class="card card--success" wx:elif="{{applied && isIce && isEditIce && iceConfirmed}}">
      <text class="success-title">✓ 已确认认领</text>
      <view class="ice-slot-stats">
        <view class="ice-slot-stat">
          <text class="ice-slot-stat__label">认领条数</text>
          <text class="ice-slot-stat__value">{{claimedSlotCount}}</text>
        </view>
        <view class="ice-slot-stat">
          <text class="ice-slot-stat__label">已提交条数</text>
          <text class="ice-slot-stat__value">{{editDeliverSubmittedCount}}</text>
        </view>
      </view>
      <view wx:if="{{editGroupQrImage}}" style="margin-top:20rpx;">
        <text class="hint">剪辑师群二维码</text>
        <image class="ice-qr-img" src="{{editGroupQrImage}}" mode="aspectFit" bindtap="previewEditGroupQr" />
      </view>
      <view wx:if="{{iceVerified}}" style="margin-top:24rpx;">
        <text class="success-title">✓ 已完成</text>
      </view>
      <view wx:elif="{{icePendingPrReview}}" style="margin-top:24rpx;">
        <text class="hint">{{iceStatusHint}}</text>
      </view>
      <view wx:elif="{{!iceVerified}}" style="margin-top:24rpx;">
        <text wx:if="{{iceStatusHint}}" class="hint" style="display:block;margin-bottom:12rpx;color:#b45309;">{{iceStatusHint}}</text>
        <text class="hint">粘贴 {{claimedSlotCount}} 条成片 https 链接（每行一条，已识别 {{deliverParsedCount}}/{{claimedSlotCount}}）：</text>
        <textarea class="ice-input ice-textarea" placeholder="https://…" value="{{deliverText}}" bindinput="onDeliverField" />
        <button class="btn-primary" style="margin-top:16rpx;" loading="{{editDeliverSubmitting}}" bindtap="submitEditDeliver">提交成片链接</button>
      </view>
    </view>

    <view class="card card--success" wx:elif="{{applied && isIce && isEditIce && !icePendingConfirm && !iceRejected && !iceConfirmed}}">
      <text class="success-title">✓ 认领成功</text>
      <text class="hint" style="display:block;margin-top:12rpx;">请确认接收后开始剪辑并回传成片链接。</text>
    </view>

    <view class="card card--success" wx:elif="{{applied && isIce && !isEditIce && icePendingConfirm}}">
      <text class="success-title">待确认接收</text>
      <text class="hint" style="display:block;margin-top:12rpx;">请确认是否接受该云剪投放任务；拒绝后名额将释放。</text>
      <view style="display:flex;gap:16rpx;margin-top:20rpx;">
        <button class="btn-primary" style="flex:1;" loading="{{iceConfirming}}" bindtap="confirmIceReceipt">确认接收</button>
        <button class="btn-secondary" style="flex:1;" loading="{{iceConfirming}}" bindtap="rejectIceTask">拒绝</button>
      </view>
    </view>

    <view class="card card--success" wx:elif="{{applied && isIce && !isEditIce && iceRejected}}">
      <text class="success-title">已拒绝任务</text>
      <text class="hint" style="display:block;margin-top:12rpx;">任务已拒绝，名额已释放，可重新认领。</text>
    </view>

    <view class="card card--success" wx:elif="{{applied && isIce && !isEditIce && assignedVideoUrl}}">
      <text class="success-title">✓ 已分配成片</text>
      <text class="hint" style="display:block;margin-top:12rpx;">{{assignedVideoLabel || '云剪成片'}}</text>
      <button class="btn-primary" style="margin-top:20rpx;" bindtap="openDownload">复制下载链接</button>
      <view wx:if="{{iceVerified}}" style="margin-top:24rpx;">
        <text class="success-title">✓ 已完成</text>
        <text class="hint" style="display:block;margin-top:12rpx;">云剪任务已通过审核，可在「我的报名」查看状态。</text>
      </view>
      <view wx:elif="{{icePendingPrReview}}" style="margin-top:24rpx;">
        <text class="hint">{{iceStatusHint}}</text>
      </view>
      <view wx:elif="{{!iceVerified}}" style="margin-top:24rpx;">
        <text wx:if="{{iceStatusHint}}" class="hint" style="display:block;margin-bottom:12rpx;color:#b45309;">{{iceStatusHint}}</text>
        <text class="hint">发布抖音后粘贴作品链接：</text>
        <input class="ice-input" placeholder="粘贴抖音分享口令或作品链接" value="{{douyinUrl}}" bindinput="onDouyinField" />
        <button class="btn-primary" style="margin-top:16rpx;" loading="{{iceSubmitting}}" bindtap="submitIceDouyin">{{iceSubmitLabel}}</button>
      </view>
    </view>

    <view class="card card--success" wx:elif="{{applied && isIce && !isEditIce && !icePendingConfirm && !iceRejected && !assignedVideoUrl}}">
      <text class="success-title">✓ 认领成功</text>
      <text class="hint" style="display:block;margin-top:12rpx;">正在同步任务状态，请下拉刷新；若长时间无响应请返回重进。</text>
    </view>
  </block>
</view>

<view wx:if="{{view && !loading}}" class="bottom-bar detail-bottom-v2">
  <view class="detail-bottom-v2__fav" bindtap="onToggleFavorite">
    <text class="detail-bottom-v2__fav-icon {{isFavorited ? 'detail-bottom-v2__fav-icon--on' : ''}}">★</text>
    <text class="detail-bottom-v2__fav-label">{{isFavorited ? '已收藏' : '收藏'}}</text>
  </view>
  <view class="detail-bottom-v2__actions">
    <button
      wx:if="{{chatEnabled && prChatMeta && canContactPr}}"
      class="detail-bottom-v2__cta detail-bottom-v2__cta--ghost"
      loading="{{contacting}}"
      bindtap="contactPr"
    >联系招募方</button>
    <button
      wx:elif="{{chatEnabled && prChatMeta && contactPrPending && !isIce}}"
      class="detail-bottom-v2__cta detail-bottom-v2__cta--muted"
      bindtap="onContactPrPending"
    >待 PR 审核</button>
    <button
      wx:if="{{canReclaimIce && !isPr && !signupClosed}}"
      class="detail-bottom-v2__cta"
      bindtap="goApply"
    >{{isEditIce ? '重新认领剪辑云剪' : '重新认领云剪'}}</button>
    <button
      wx:elif="{{!applied && !isPr && !iceSlotsFull && !signupClosed}}"
      class="detail-bottom-v2__cta"
      bindtap="goApply"
    >{{isIce ? (isEditIce ? '认领剪辑云剪' : '认领云剪') : (view.isFormRelay ? '前往原表报名' : '立即报名')}}</button>
    <view wx:if="{{!applied && !isPr && iceSlotsFull && !signupClosed}}" class="detail-bottom-v2__cta detail-bottom-v2__cta--muted detail-bottom-v2__cta--text">已收满</view>
    <view wx:if="{{!applied && !isPr && signupClosed}}" class="detail-bottom-v2__cta detail-bottom-v2__cta--muted detail-bottom-v2__cta--text">报名已截止</view>
    <button
      wx:if="{{!applied && isPr}}"
      class="detail-bottom-v2__cta detail-bottom-v2__cta--muted"
      bindtap="goApply"
    >请切换身份后再报名</button>
    <button
      wx:elif="{{applied && showCheckInBtn}}"
      class="detail-bottom-v2__cta {{checkInReady ? '' : 'detail-bottom-v2__cta--muted'}}"
      loading="{{visitBusy}}"
      disabled="{{!checkInReady}}"
      bindtap="visitCheckInTap"
    >{{checkInReady ? '到店签到' : '探店日当天可签到'}}</button>
    <button wx:elif="{{applied}}" class="detail-bottom-v2__cta" bindtap="onShareTap">邀请好友</button>
  </view>
</view>

<view class="detail-share-sheet-mask" wx:if="{{showSharePosterSheet}}" bindtap="onCloseSharePosterSheet">
  <view class="detail-share-sheet" catchtap="noopShareSheetTap">
    <view class="detail-share-sheet-head">
      <text class="detail-share-sheet-title">分享海报</text>
      <text class="detail-share-sheet-close" bindtap="onCloseSharePosterSheet">×</text>
    </view>
    <view class="detail-share-poster-panel">
      <view wx:if="{{sharePosterLoading}}" class="detail-share-poster-loading">生成海报中…</view>
      <image
        wx:elif="{{sharePosterPath}}"
        class="detail-share-poster-img"
        src="{{sharePosterPath}}"
        mode="widthFix"
        show-menu-by-longpress="{{true}}"
      />
      <text wx:else class="detail-share-poster-err">{{sharePosterErr || '海报生成失败'}}</text>
      <view wx:if="{{sharePosterPath || sharePosterStyleLabel}}" class="detail-share-poster-style-row">
        <text wx:if="{{sharePosterStyleLabel}}" class="detail-share-poster-style-label">当前样式：{{sharePosterStyleLabel}}</text>
        <text class="detail-share-poster-style-btn" style="color: {{sharePosterAccentColor}}" bindtap="onSwitchSharePosterStyle">换个样式</text>
      </view>
      <view
        wx:if="{{sharePosterPath}}"
        class="detail-share-sheet-item detail-share-poster-save"
        style="color: {{sharePosterAccentColor}}"
        bindtap="onSaveSharePoster"
      >保存海报到相册</view>
      <button class="detail-share-sheet-item detail-share-sheet-btn" open-type="share">分享小程序卡片</button>
    </view>
    <view class="detail-share-sheet-cancel" bindtap="onCloseSharePosterSheet">取消</view>
  </view>
</view>

<view class="pr-cert-mask" wx:if="{{prCertVisible}}" bindtap="onClosePrCert">
  <view class="pr-cert-dialog" catchtap="noopShareSheetTap">
    <text class="pr-cert-title">灵祺官方认证</text>
    <view class="pr-cert-body">
      <text wx:for="{{prCertLines}}" wx:key="index" class="pr-cert-line">{{item}}</text>
    </view>
    <view class="pr-cert-actions">
      <view wx:if="{{prCertScanUrl}}" class="pr-cert-btn pr-cert-btn--ghost" bindtap="onCopyPrCertLink">复制链接</view>
      <view class="pr-cert-btn pr-cert-btn--primary" bindtap="onClosePrCert">知道了</view>
    </view>
  </view>
</view>
