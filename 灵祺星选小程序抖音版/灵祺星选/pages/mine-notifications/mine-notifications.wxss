.ntf-page {
  padding: 24rpx 28rpx 48rpx;
  min-height: 100vh;
  box-sizing: border-box;
  background: var(--lq-bg, #f5f6fa);
}

.ntf-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.ntf-tabs {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  gap: 12rpx;
  flex: 1;
  min-width: 0;
}

.ntf-read-all {
  flex-shrink: 0;
  margin: 0;
  padding: 12rpx 20rpx !important;
  line-height: 1.2 !important;
  font-size: 24rpx !important;
  font-weight: 600;
  color: var(--lq-primary) !important;
  background: #fff !important;
  border: 2rpx solid #ddd6fe !important;
  border-radius: 999rpx !important;
}

.ntf-tab {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  padding: 12rpx 22rpx;
  border-radius: 999rpx;
  background: #fff;
  border: 2rpx solid #e5e7eb;
  flex-shrink: 0;
}

.ntf-tab--on {
  background: linear-gradient(135deg, var(--lq-primary) 0%, var(--lq-primary-soft) 100%);
  border-color: transparent;
}

.ntf-tab--on .ntf-tab-label,
.ntf-tab--on .ntf-tab-badge {
  color: #fff;
}

.ntf-tab-label {
  font-size: 26rpx;
  font-weight: 600;
  color: #4b5563;
}

.ntf-tab-badge {
  font-size: 20rpx;
  font-weight: 700;
  color: var(--lq-primary);
  background: #f5f3ff;
  padding: 2rpx 10rpx;
  border-radius: 999rpx;
}

.ntf-tab--on .ntf-tab-badge {
  background: rgba(255, 255, 255, 0.25);
}

.ntf-empty {
  margin-top: 80rpx;
  text-align: center;
  padding: 48rpx 32rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 20rpx;
}

.ntf-empty-title {
  display: block;
  font-size: 32rpx;
  font-weight: 700;
  color: #374151;
  line-height: 1.4;
}

.ntf-empty-hint {
  display: block;
  font-size: 26rpx;
  font-weight: 400;
  color: #6b7280;
  line-height: 1.65;
  max-width: 560rpx;
}

.ntf-section {
  margin-bottom: 28rpx;
}

.ntf-section-title {
  display: block;
  font-size: 24rpx;
  font-weight: 700;
  color: var(--lq-text-secondary, #6b7280);
  margin: 0 8rpx 16rpx;
}

.ntf-card {
  margin-bottom: 16rpx;
  padding: 24rpx;
}

.ntf-card--pinned {
  border: 2rpx solid #c4b5fd;
  box-shadow: 0 8rpx 24rpx rgba(124, 58, 237, 0.12);
}

.ntf-card--unread {
  background: #fafaff;
}

.ntf-card--tappable:active {
  opacity: 0.92;
}

.ntf-card-head-right {
  display: flex;
  align-items: center;
  gap: 8rpx;
  flex-shrink: 0;
}

.ntf-arrow {
  font-size: 36rpx;
  line-height: 1;
  color: #c4b5fd;
  font-weight: 300;
}

.ntf-card-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.ntf-card-head-left {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.ntf-read {
  font-size: 20rpx;
  font-weight: 600;
  padding: 2rpx 10rpx;
  border-radius: 8rpx;
}

.ntf-read--new {
  color: #dc2626;
  background: #fef2f2;
}

.ntf-read--ok {
  color: #6b7280;
  background: #f3f4f6;
}

.ntf-cat {
  font-size: 20rpx;
  font-weight: 700;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
}

.ntf-cat--order {
  color: #1d4ed8;
  background: #eff6ff;
}

.ntf-cat--business {
  color: var(--lq-primary);
  background: #f5f3ff;
}

.ntf-cat--system {
  color: #047857;
  background: #ecfdf5;
}

.ntf-cat--selection {
  color: #b45309;
  background: #fffbeb;
}

.ntf-time {
  font-size: 22rpx;
  color: #9ca3af;
}

.ntf-title {
  display: block;
  margin-bottom: 8rpx;
}

.ntf-body {
  display: block;
  line-height: 1.5;
}

.ntf-body--clamp {
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 3;
  overflow: hidden;
}

.ntf-detail-hint {
  display: block;
  margin-top: 12rpx;
  font-size: 24rpx;
  font-weight: 600;
  color: var(--lq-primary);
}

.ntf-image {
  display: block;
  width: 100%;
  max-width: 420rpx;
  margin-top: 16rpx;
  border-radius: 12rpx;
  border: 2rpx solid var(--lq-primary-100, #e0e7ff);
}

.ntf-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 20rpx;
}

.ntf-action-btn {
  flex: 1;
  margin: 0;
  height: 72rpx;
  line-height: 72rpx;
  font-size: 26rpx;
  font-weight: 600;
  border-radius: 999rpx;
  color: var(--lq-primary-dark, #5b21b6);
  background: #fff;
  border: 2rpx solid var(--lq-primary-100, #e0e7ff);
}

.ntf-action-btn::after {
  border: none;
}

.ntf-action-btn--primary {
  color: #fff;
  background: linear-gradient(135deg, var(--lq-primary) 0%, var(--lq-primary-soft) 100%);
  border-color: transparent;
}
