.lk-page {
  min-height: 100vh;
  padding: 24rpx 24rpx 120rpx;
  background: #f0eff6;
  box-sizing: border-box;
}

.lk-hero {
  margin-bottom: 24rpx;
}

.lk-title {
  display: block;
  font-size: 40rpx;
  font-weight: 700;
  color: #1e293b;
}

.lk-sub {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #64748b;
}

.lk-msg {
  margin-bottom: 16rpx;
  padding: 16rpx 20rpx;
  border-radius: 12rpx;
  background: #ede9fe;
  color: #5b21b6;
  font-size: 24rpx;
}

.lk-card {
  background: #fff;
  border-radius: 20rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  border: 1rpx solid #e2e8f0;
}

.lk-card-title {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  color: #1e293b;
}

.lk-card-desc {
  display: block;
  margin: 8rpx 0 16rpx;
  font-size: 24rpx;
  color: #64748b;
  line-height: 1.5;
}

.lk-sp-ok {
  padding: 16rpx;
  border-radius: 12rpx;
  background: #ecfdf5;
  border: 1rpx solid #a7f3d0;
}

.lk-sp-name {
  display: block;
  font-size: 26rpx;
  color: #065f46;
  font-weight: 600;
}

.lk-sp-id {
  display: block;
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #047857;
}

.lk-sp-clear {
  display: inline-block;
  margin-top: 12rpx;
  font-size: 22rpx;
  color: #dc2626;
  text-decoration: underline;
}

.lk-btn {
  font-size: 26rpx;
  margin: 0;
}

.lk-btn--primary {
  background: #7c3aed;
  color: #fff;
}

.lk-warn {
  display: block;
  margin-top: 12rpx;
  font-size: 22rpx;
  color: #b45309;
}

.lk-client-list {
  margin-top: 16rpx;
  border: 1rpx solid #e2e8f0;
  border-radius: 12rpx;
  overflow: hidden;
}

.lk-client-row {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  padding: 16rpx 20rpx;
  border-bottom: 1rpx solid #f1f5f9;
}

.lk-client-name {
  display: block;
  font-size: 26rpx;
  color: #1e293b;
}

.lk-client-id {
  display: block;
  margin-top: 4rpx;
  font-size: 22rpx;
  color: #64748b;
}

.lk-client-del {
  font-size: 22rpx;
  color: #dc2626;
}

.lk-client-empty {
  padding: 32rpx;
  text-align: center;
  font-size: 24rpx;
  color: #94a3b8;
}

.lk-modal-mask {
  position: fixed;
  inset: 0;
  background: rgba(15, 23, 42, 0.45);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 99;
}

.lk-modal {
  width: 86%;
  background: #fff;
  border-radius: 20rpx;
  padding: 28rpx;
}

.lk-modal-title {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  margin-bottom: 16rpx;
}

.lk-input {
  border: 1rpx solid #cbd5e1;
  border-radius: 12rpx;
  padding: 16rpx 20rpx;
  margin-bottom: 12rpx;
  font-size: 26rpx;
}

.lk-modal-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 8rpx;
}

.lk-modal-actions .lk-btn {
  flex: 1;
}
