@import '../../styles/identity-themes.wxss';

.xx-page {
  min-height: 100vh;
  background: var(--lq-bg);
  box-sizing: border-box;
}

/* —— Hero —— */
.xx-hero {
  position: relative;
  overflow: hidden;
  padding-bottom: 12rpx;
}

.xx-hero-bg {
  position: absolute;
  inset: 0;
  background: var(--lq-gradient-header);
}

.xx-hero-bg::after {
  content: '';
  position: absolute;
  right: -60rpx;
  top: -40rpx;
  width: 240rpx;
  height: 240rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.1);
}

.xx-hero-body {
  position: relative;
  z-index: 2;
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 220rpx;
  padding: 16rpx 20rpx 36rpx 28rpx;
  box-sizing: border-box;
}

.xx-hero-text {
  flex: 1;
  min-width: 0;
  padding-right: 12rpx;
}

.xx-title {
  display: block;
  font-size: 40rpx;
  font-weight: 800;
  color: #fff;
  letter-spacing: 1rpx;
  line-height: 1.25;
}

.xx-sub {
  display: block;
  margin-top: 12rpx;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.92);
  line-height: 1.55;
  max-width: 100%;
}

.xx-hero-art {
  flex-shrink: 0;
  width: 200rpx;
  height: 200rpx;
  margin-right: -4rpx;
}

.xx-orders-link {
  position: absolute;
  right: 28rpx;
  bottom: 16rpx;
  z-index: 3;
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.95);
  font-weight: 600;
}

/* —— Scroll body —— */
.xx-scroll {
  height: calc(100vh - 220rpx);
  padding: 0 24rpx calc(28rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.xx-state {
  padding: 48rpx 28rpx;
  text-align: center;
  color: #64748b;
  font-size: 28rpx;
}

.xx-state--err {
  color: #dc2626;
}

/* —— Status card —— */
.xx-status-card {
  margin-top: -28rpx;
  margin-bottom: 20rpx;
  padding: 24rpx 24rpx 22rpx;
  border-radius: 24rpx;
  background: #fff;
  border: 2rpx solid var(--lq-primary-100);
  box-shadow: var(--lq-shadow-soft);
}

.xx-status-top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
}

.xx-status-left {
  flex: 1;
  min-width: 0;
}

.xx-status-label-row {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.xx-status-label {
  font-size: 22rpx;
  color: #64748b;
}

.xx-status-info {
  font-size: 20rpx;
  color: #94a3b8;
}

.xx-status-val {
  display: block;
  margin-top: 8rpx;
  font-size: 34rpx;
  font-weight: 800;
  color: #0f172a;
  line-height: 1.2;
}

.xx-status-hint {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #94a3b8;
  line-height: 1.45;
}

.xx-status-exp {
  display: block;
  margin-top: 6rpx;
  font-size: 22rpx;
  color: var(--lq-primary);
  font-weight: 600;
}

.xx-compare-link {
  flex-shrink: 0;
  font-size: 24rpx;
  color: var(--lq-primary);
  font-weight: 700;
  padding-top: 28rpx;
}

/* —— Active benefits —— */
.xx-benefits {
  margin-bottom: 20rpx;
  padding: 22rpx 22rpx 20rpx;
  border-radius: 24rpx;
  background: #fff;
  border: 2rpx solid var(--lq-primary-100);
  box-shadow: var(--lq-shadow-soft);
}

.xx-benefits-title {
  display: block;
  font-size: 28rpx;
  font-weight: 800;
  color: #0f172a;
  margin-bottom: 16rpx;
}

.xx-benefits-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx 14rpx;
}

.xx-benefit-cell {
  padding: 14rpx 12rpx;
  border-radius: 16rpx;
  background: var(--lq-primary-50);
  border: 1rpx solid var(--lq-chip-on-border);
}

.xx-benefit-head {
  display: flex;
  align-items: flex-start;
  gap: 8rpx;
}

.xx-benefit-glyph {
  flex-shrink: 0;
  font-size: 22rpx;
  color: #059669;
  font-weight: 800;
  line-height: 1.35;
}

.xx-benefit-title {
  flex: 1;
  font-size: 22rpx;
  font-weight: 700;
  color: #0f172a;
  line-height: 1.35;
}

.xx-benefit-desc {
  display: block;
  margin-top: 6rpx;
  padding-left: 30rpx;
  font-size: 20rpx;
  color: #64748b;
  line-height: 1.45;
}

/* —— Plan tabs —— */
.xx-tabs {
  display: flex;
  gap: 8rpx;
  margin-bottom: 20rpx;
  padding: 8rpx;
  border-radius: 22rpx;
  background: #fff;
  border: 2rpx solid var(--lq-primary-100);
  box-shadow: var(--lq-shadow-soft);
}

.xx-tab {
  position: relative;
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 2rpx;
  padding: 14rpx 4rpx 12rpx;
  border-radius: 16rpx;
  background: transparent;
}

.xx-tab--active {
  background: var(--lq-gradient-tab);
  box-shadow: var(--lq-shadow-tab);
}

.xx-tab-name {
  font-size: 22rpx;
  font-weight: 700;
  color: var(--lq-primary-dark);
  line-height: 1.2;
  text-align: center;
}

.xx-tab-badge {
  font-size: 18rpx;
  color: #64748b;
  line-height: 1.1;
}

.xx-tab--active .xx-tab-name,
.xx-tab--active .xx-tab-badge {
  color: #fff;
}

.xx-tab-cur {
  position: absolute;
  top: -8rpx;
  right: 4rpx;
  padding: 2rpx 8rpx;
  border-radius: 999rpx;
  font-size: 16rpx;
  color: #fff;
  background: #94a3b8;
  line-height: 1.2;
}

.xx-tab--active .xx-tab-cur {
  background: rgba(255, 255, 255, 0.28);
}

/* —— Plan card —— */
.xx-card {
  position: relative;
  margin-bottom: 24rpx;
  border-radius: 28rpx;
  background: #fff;
  overflow: hidden;
  border: 2rpx solid var(--lq-primary-100);
  box-shadow: var(--lq-shadow-soft);
}

.xx-card--current {
  border-color: var(--lq-primary);
  box-shadow: 0 12rpx 36rpx rgba(15, 23, 42, 0.1);
}

.xx-card--rec {
  border-color: var(--lq-primary-soft);
}

.xx-rec-badge {
  position: absolute;
  top: 0;
  right: 24rpx;
  z-index: 3;
  padding: 6rpx 16rpx;
  border-radius: 0 0 14rpx 14rpx;
  background: linear-gradient(135deg, #fbbf24, #f59e0b);
  color: #fff;
  font-size: 20rpx;
  font-weight: 800;
}

.xx-card-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
  padding: 24rpx 24rpx 18rpx;
  background: linear-gradient(180deg, var(--lq-primary-50) 0%, #fff 100%);
  border-bottom: 1rpx solid #f1f5f9;
}

.xx-card-head-left {
  flex: 1;
  min-width: 0;
}

.xx-card-name-row {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 10rpx;
}

.xx-card-name {
  font-size: 32rpx;
  font-weight: 800;
  color: #0f172a;
}

.xx-cur-badge {
  font-size: 20rpx;
  padding: 4rpx 12rpx;
  border-radius: 999rpx;
  background: var(--lq-chip-on-bg);
  border: 1rpx solid var(--lq-chip-on-border);
  color: var(--lq-primary-dark);
  font-weight: 700;
}

.xx-card-tagline {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #64748b;
  line-height: 1.45;
}

.xx-card-head-right {
  flex-shrink: 0;
  text-align: right;
}

.xx-price-main {
  display: block;
  font-size: 40rpx;
  font-weight: 800;
  color: var(--lq-primary);
  line-height: 1.1;
}

.xx-price-main.is-free {
  color: #059669;
}

.xx-price-sub {
  display: block;
  margin-top: 6rpx;
  font-size: 20rpx;
  color: #94a3b8;
  line-height: 1.3;
}

.xx-card-body {
  padding: 8rpx 24rpx 4rpx;
}

.xx-feat-group {
  padding: 16rpx 0 12rpx;
  border-bottom: 1rpx solid #f1f5f9;
}

.xx-feat-group:last-child {
  border-bottom: none;
}

.xx-feat-group-head {
  display: flex;
  align-items: flex-start;
  gap: 14rpx;
  margin-bottom: 10rpx;
}

.xx-feat-block {
  flex-shrink: 0;
  width: 64rpx;
  height: 64rpx;
  border-radius: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.xx-feat-block-icon {
  font-size: 30rpx;
  line-height: 1;
}

.xx-feat-block--blue {
  background: #dbeafe;
}

.xx-feat-block--green {
  background: #d1fae5;
}

.xx-feat-block--purple {
  background: #ede9fe;
}

.xx-feat-block--orange {
  background: #ffedd5;
}

.xx-feat-block--teal {
  background: #ccfbf1;
}

.xx-feat-block--slate {
  background: #e2e8f0;
}

.xx-feat-group-meta {
  flex: 1;
  min-width: 0;
  padding-top: 4rpx;
}

.xx-feat-group-title {
  display: block;
  font-size: 26rpx;
  font-weight: 800;
  color: #0f172a;
  line-height: 1.3;
}

.xx-feat-group-desc {
  display: block;
  margin-top: 4rpx;
  font-size: 22rpx;
  color: #64748b;
  line-height: 1.4;
}

.xx-feat-check {
  display: flex;
  align-items: flex-start;
  gap: 10rpx;
  padding: 6rpx 0 6rpx 78rpx;
}

.xx-feat-check-icon {
  flex-shrink: 0;
  width: 24rpx;
  font-size: 22rpx;
  line-height: 1.45;
  font-weight: 800;
}

.xx-feat-check--yes .xx-feat-check-icon {
  color: #059669;
}

.xx-feat-check--partial .xx-feat-check-icon {
  color: #d97706;
}

.xx-feat-check-text {
  flex: 1;
  font-size: 24rpx;
  color: #334155;
  line-height: 1.45;
}

.xx-feat-detail {
  color: #64748b;
}

.xx-card-foot {
  padding: 12rpx 24rpx 24rpx;
}

.xx-btn {
  width: 100%;
  height: 76rpx;
  line-height: 76rpx;
  font-size: 28rpx;
  font-weight: 700;
  color: #fff;
  background: var(--lq-gradient-tab);
  border-radius: 999rpx;
  border: none;
  box-shadow: var(--lq-shadow-tab);
}

.xx-btn::after {
  border: none;
}

.xx-btn--full {
  width: 100%;
}

.xx-foot-tip {
  display: block;
  text-align: center;
  font-size: 26rpx;
  color: #94a3b8;
  padding: 12rpx 0 4rpx;
}

.xx-foot-tip--current {
  color: var(--lq-primary);
  font-weight: 700;
}

.xx-foot-note {
  display: block;
  margin-top: 8rpx;
  text-align: center;
  font-size: 22rpx;
  color: #94a3b8;
  line-height: 1.45;
}

.xx-foot {
  padding: 8rpx 0 24rpx;
  font-size: 22rpx;
  color: #94a3b8;
  text-align: center;
  line-height: 1.5;
}

/* —— Pay sheet —— */
.xx-pay-mask {
  position: fixed;
  inset: 0;
  z-index: 1000;
  background: rgba(15, 23, 42, 0.45);
  display: flex;
  align-items: flex-end;
}

.xx-pay-sheet {
  width: 100%;
  padding: 28rpx 28rpx calc(28rpx + env(safe-area-inset-bottom));
  background: #fff;
  border-radius: 32rpx 32rpx 0 0;
}

.xx-pay-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.xx-pay-title {
  font-size: 32rpx;
  font-weight: 800;
  color: #0f172a;
}

.xx-pay-close {
  font-size: 44rpx;
  color: #cbd5e1;
  line-height: 1;
  padding: 0 8rpx;
}

.xx-pay-amount {
  display: block;
  font-size: 28rpx;
  color: #334155;
  margin-bottom: 16rpx;
}

.xx-billing {
  display: flex;
  gap: 12rpx;
  margin-bottom: 20rpx;
}

.xx-billing-item {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  border-radius: 16rpx;
  background: #f8fafc;
  border: 2rpx solid #e2e8f0;
  font-size: 26rpx;
  color: #64748b;
}

.xx-billing-item.is-active {
  background: var(--lq-primary-50);
  border-color: var(--lq-primary);
  color: var(--lq-primary-dark);
  font-weight: 700;
}

.xx-pay-hint {
  display: block;
  margin-top: 12rpx;
  font-size: 22rpx;
  color: #94a3b8;
  line-height: 1.45;
}

.xx-pay-hint--warn {
  color: #b45309;
}

.xx-pay-err {
  display: block;
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #dc2626;
}

.xx-pay-msg {
  display: block;
  font-size: 28rpx;
  color: #334155;
  line-height: 1.5;
}
