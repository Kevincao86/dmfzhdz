@import '../../styles/theme.wxss';
@import '../../styles/identity-themes.wxss';
@import '../../styles/hero-deco.wxss';

.login-page {
  box-sizing: border-box;
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  background: var(--lq-bg);
}

.login-body {
  flex: 1;
  display: flex;
  flex-direction: column;
  min-height: 0;
}

.login-top,
.login-hero {
  position: relative;
  overflow: hidden;
  padding-bottom: 88rpx;
  flex-shrink: 0;
  background: var(--lq-gradient-header);
  min-height: 400rpx;
}

.login-hero__bg {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  z-index: 0;
  opacity: 0.32;
}

.login-hero__overlay {
  position: absolute;
  inset: 0;
  z-index: 1;
  background: linear-gradient(
    180deg,
    var(--lq-active-tint) 0%,
    rgba(255, 255, 255, 0.08) 55%,
    rgba(255, 255, 255, 0.02) 100%
  );
  pointer-events: none;
}

.login-hero__cosmos {
  position: absolute;
  inset: 0;
  z-index: 2;
  pointer-events: none;
}

.login-star {
  position: absolute;
  border-radius: 50%;
  background: #fff;
  opacity: 0.8;
}

.login-star--1 {
  width: 6rpx;
  height: 6rpx;
  top: 16%;
  left: 14%;
  box-shadow: 28rpx 36rpx 0 0 rgba(255, 255, 255, 0.55);
}

.login-star--2 {
  width: 8rpx;
  height: 8rpx;
  top: 24%;
  right: 20%;
}

.login-star--3 {
  width: 5rpx;
  height: 5rpx;
  bottom: 38%;
  left: 28%;
}

.login-hero__inner {
  position: relative;
  z-index: 3;
  box-sizing: border-box;
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: flex-start;
  padding: 12rpx 0 0;
}

.login-hero__brand {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: flex-start;
  width: 100%;
  max-width: 640rpx;
  margin: 0 auto;
  padding: 0 48rpx 4rpx;
  box-sizing: border-box;
  text-align: center;
}

.login-hero__title,
.login-hero__sub {
  width: 100%;
  text-align: center;
}

.login-hero__logo {
  width: 108rpx;
  height: 108rpx;
  margin-bottom: 16rpx;
  border: 4rpx solid rgba(255, 255, 255, 0.35);
}

.login-hero__title {
  font-size: 40rpx;
  font-weight: 800;
  color: #fff;
  letter-spacing: 2rpx;
  line-height: 1.25;
}

.login-hero__sub {
  margin-top: 10rpx;
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.9);
}

.login-top--ai {
  background: var(--lq-nav-bar);
}

.login-hero-img {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  z-index: 0;
}

.login-hero-overlay {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 1;
  background: linear-gradient(
    120deg,
    var(--lq-active-tint) 0%,
    rgba(255, 255, 255, 0.1) 45%,
    rgba(251, 191, 36, 0.08) 100%
  );
  pointer-events: none;
}

.login-top-fade {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 72rpx;
  background: linear-gradient(180deg, transparent 0%, var(--lq-bg) 100%);
  pointer-events: none;
  z-index: 2;
}

.login-top-inner {
  position: relative;
  z-index: 3;
  padding-left: 32rpx;
  box-sizing: border-box;
}

.login-nav-spacer {
  height: 80rpx;
  margin-bottom: 8rpx;
}

.login-brand-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding-bottom: 8rpx;
}

.login-logo {
  width: 92rpx;
  height: 92rpx;
}

.login-hero-text {
  flex: 1;
  min-width: 0;
}

.login-brand {
  display: block;
  font-size: 34rpx;
  font-weight: 800;
  color: #fff;
  line-height: 1.25;
}

.login-chips {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 10rpx;
  margin-top: 14rpx;
}

.login-chip {
  display: inline-flex;
  align-items: center;
  gap: 4rpx;
  padding: 6rpx 16rpx;
  font-size: 20rpx;
  font-weight: 600;
  color: rgba(255, 255, 255, 0.94);
  background: rgba(255, 255, 255, 0.14);
  border: 1rpx solid rgba(255, 255, 255, 0.26);
  border-radius: 999rpx;
}

.login-chip__ico {
  font-size: 18rpx;
  line-height: 1;
}

.login-stack {
  margin-top: -64rpx;
  padding: 0 28rpx;
  position: relative;
  z-index: 2;
  flex-shrink: 0;
}

.login-shell {
  border-radius: var(--lq-radius-lg);
  overflow: hidden;
  border: 3rpx solid var(--lq-border);
  box-shadow: var(--lq-shadow-card), var(--lq-shadow-soft);
  background: var(--lq-surface);
}

.login-main {
  padding: 26rpx 26rpx 24rpx;
}

.login-shell {
  border-radius: 36rpx;
  overflow: hidden;
  border: 3rpx solid rgba(255, 255, 255, 0.95);
  box-shadow: 0 16rpx 48rpx var(--lq-active-tint);
  background: var(--lq-surface);
}

.login-id-badge {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 22rpx;
  padding: 14rpx 18rpx;
  border-radius: 20rpx;
  background: var(--lq-primary-50);
  border: 2rpx solid var(--lq-chip-on-border);
}

.login-id-badge__icon {
  width: 44rpx;
  height: 44rpx;
  flex-shrink: 0;
}

.login-id-badge__text {
  flex: 1;
  min-width: 0;
  font-size: 28rpx;
  font-weight: 700;
  color: var(--lq-primary-deep);
}

.login-id-badge__check {
  flex-shrink: 0;
  width: 36rpx;
  height: 36rpx;
  line-height: 36rpx;
  text-align: center;
  border-radius: 50%;
  font-size: 20rpx;
  font-weight: 800;
  color: #fff;
  background: var(--lq-gradient-tab);
}

.login-features {
  display: flex;
  gap: 12rpx;
  padding: 20rpx 18rpx 22rpx;
  background: linear-gradient(180deg, var(--lq-primary-50) 0%, var(--lq-bg) 100%);
  border-top: 1rpx solid var(--lq-border);
}

.login-feature {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
}

.login-feature__orb {
  width: 72rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: var(--lq-gradient-tab);
  box-shadow: var(--lq-shadow-tab);
  margin-bottom: 8rpx;
}

.login-feature__glyph {
  font-size: 28rpx;
  color: #fff;
  line-height: 1;
}

.login-feature__tag {
  font-size: 22rpx;
  font-weight: 700;
  color: var(--lq-primary-deep);
}

.login-feature__sub {
  margin-top: 4rpx;
  font-size: 18rpx;
  color: var(--lq-text-secondary);
  line-height: 1.3;
}

.login-talent-zone {
  flex: 1;
  display: flex;
  flex-direction: column;
  min-height: 0;
  padding: 16rpx 28rpx 0;
}

.login-talent-title {
  display: block;
  text-align: center;
  font-size: 30rpx;
  font-weight: 800;
  color: var(--lq-primary-deep);
  letter-spacing: 1rpx;
}

.login-talent-hint {
  display: block;
  margin-top: 6rpx;
  margin-bottom: 8rpx;
  text-align: center;
  font-size: 22rpx;
  color: var(--lq-text-secondary);
}

.login-forgot {
  display: block;
  margin: 12rpx 0 8rpx;
  font-size: 24rpx;
  color: var(--lq-primary);
  font-weight: 500;
  text-align: right;
}

.login-guest-link {
  display: block;
  margin-top: 20rpx;
  margin-bottom: 4rpx;
  font-size: 26rpx;
  color: var(--lq-primary);
  font-weight: 600;
  text-align: center;
  line-height: 1.5;
}

.login-identity-main {
  flex: 1;
  min-width: 0;
}

.login-identity-label {
  display: block;
  font-size: 22rpx;
  font-weight: 600;
  color: var(--lq-text-secondary);
  margin-bottom: 6rpx;
}

.login-identity-value {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.login-identity-icon {
  width: 44rpx;
  height: 44rpx;
  flex-shrink: 0;
}

.login-identity-value-text {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--lq-primary-deep);
}

.login-identity-placeholder {
  display: block;
  font-size: 24rpx;
  color: #b45309;
}

.login-identity-row--readonly {
  justify-content: flex-start;
}

.login-identity-switch {
  flex-shrink: 0;
  padding: 14rpx 22rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  font-weight: 700;
  color: #fff;
  background: var(--lq-gradient);
  box-shadow: var(--lq-shadow-tab);
}

.login-id-sheet-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 10000;
  background: rgba(45, 27, 78, 0.35);
  display: flex;
  align-items: flex-end;
}

.login-id-sheet-mask--center {
  align-items: center;
  justify-content: center;
  padding: 0 32rpx;
  box-sizing: border-box;
}

.login-legal-mask {
  z-index: 10100;
}

.login-id-sheet {
  width: 100%;
  padding: 28rpx 28rpx calc(28rpx + env(safe-area-inset-bottom));
  background: var(--lq-card);
  border-radius: 40rpx 40rpx 0 0;
  border: 3rpx solid rgba(255, 255, 255, 0.95);
  box-shadow: 0 -12rpx 0 rgba(196, 181, 253, 0.25);
}

.login-id-sheet-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 8rpx;
}

.login-id-sheet-title {
  font-size: 34rpx;
  font-weight: 800;
  color: var(--lq-text);
}

.login-id-sheet-close {
  font-size: 44rpx;
  color: var(--lq-primary-soft);
  line-height: 1;
  padding: 0 8rpx;
}

.login-id-sheet-hint {
  display: block;
  font-size: 24rpx;
  color: var(--lq-text-secondary);
  margin-bottom: 20rpx;
}

.login-id-sheet-opt {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 22rpx 24rpx;
  margin-top: 14rpx;
  border-radius: 28rpx;
  border: 3rpx solid rgba(255, 255, 255, 0.9);
  background: var(--lq-primary-50);
}

.login-id-sheet-opt.active {
  border-color: var(--lq-primary);
  background: var(--lq-primary-50);
}

.login-id-sheet-icon-wrap {
  width: 72rpx;
  height: 72rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 16rpx;
  background: var(--lq-bg);
  border: 1rpx solid var(--lq-chip-on-border);
}

.login-id-sheet-icon {
  width: 44rpx;
  height: 44rpx;
}

.login-id-sheet-body {
  flex: 1;
}

.login-id-sheet-name {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--lq-text);
}

.login-id-sheet-check {
  font-size: 32rpx;
  color: var(--lq-primary);
  font-weight: 800;
}

.login-btn[disabled] {
  opacity: 0.45;
}

.login-tabs {
  margin-bottom: 22rpx;
}

.login-tab {
  font-size: 26rpx;
}

.login-field {
  margin-bottom: 16rpx;
}

.login-field-label {
  display: block;
  margin-bottom: 8rpx;
  padding-left: 4rpx;
  font-size: 24rpx;
  font-weight: 600;
  color: var(--lq-text-secondary);
}

.login-input {
  border: 2rpx solid var(--lq-border);
  border-radius: 20rpx;
  padding: 20rpx 22rpx;
  font-size: 28rpx;
  color: var(--lq-text);
  background: #fff;
}

.login-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  border: none;
  border-radius: 999rpx;
  font-size: 30rpx;
  font-weight: 700;
  padding: 24rpx 0;
}

.login-btn-icon {
  font-size: 26rpx;
  opacity: 0.9;
}

.login-btn--wx {
  background: var(--lq-gradient-tab);
  color: #fff;
  box-shadow: var(--lq-shadow-tab);
}

.login-btn--wx::after {
  border: none;
}

.login-hint {
  display: block;
  margin-top: 16rpx;
  font-size: 22rpx;
  color: var(--lq-text-secondary);
  text-align: center;
}

.login-orbit-zone {
  position: relative;
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: flex-start;
  min-height: 360rpx;
  margin-top: 4rpx;
  padding: 0 0 calc(env(safe-area-inset-bottom) + 12rpx);
  overflow: hidden;
  background: linear-gradient(180deg, var(--lq-bg) 0%, var(--lq-primary-50) 100%);
  border-radius: 28rpx;
}

.login-back-link {
  position: fixed;
  left: 28rpx;
  bottom: calc(env(safe-area-inset-bottom) + 24rpx);
  z-index: 20;
  font-size: 28rpx;
  font-weight: 600;
  color: #64748b;
  line-height: 1.5;
}

.login-legal-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  flex-wrap: nowrap;
  margin-top: 20rpx;
  width: 100%;
  box-sizing: border-box;
}

.login-legal-check {
  flex: none;
  width: 26rpx;
  height: 26rpx;
  margin-right: 8rpx;
  border-radius: 50%;
  border: 2rpx solid var(--lq-active-tint);
  background: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

.login-legal-check__mark {
  font-size: 16rpx;
  line-height: 1;
  color: #fff;
}

.login-legal-check--on {
  background: var(--lq-gradient);
  border-color: transparent;
}

.login-legal-txt,
.login-legal-link {
  flex: none;
  font-size: 22rpx;
  line-height: 26rpx;
  white-space: nowrap;
}

.login-legal-txt {
  color: #64748b;
}

.login-legal-link {
  color: var(--lq-primary);
  font-weight: 600;
}

.login-legal-modal {
  width: 620rpx;
  margin: auto;
  padding: 40rpx 36rpx 32rpx;
  box-sizing: border-box;
  background: #fff;
  border-radius: 32rpx;
  border: 3rpx solid rgba(255, 255, 255, 0.95);
  box-shadow: 0 16rpx 48rpx rgba(45, 27, 78, 0.18);
}

.login-legal-modal-title {
  display: block;
  font-size: 34rpx;
  font-weight: 800;
  color: var(--lq-text);
  text-align: center;
  line-height: 1.35;
}

.login-legal-modal-content {
  display: block;
  margin-top: 24rpx;
  font-size: 28rpx;
  line-height: 1.55;
  color: var(--lq-text-secondary);
  text-align: center;
}

.login-legal-modal-actions {
  display: flex;
  align-items: stretch;
  gap: 20rpx;
  margin-top: 36rpx;
}

.login-legal-modal-btn {
  flex: 1;
  margin: 0;
  padding: 0;
  height: 84rpx;
  line-height: 84rpx;
  border-radius: 999rpx;
  font-size: 28rpx;
  font-weight: 700;
}

.login-legal-modal-btn::after {
  border: none;
}

.login-legal-modal-btn--decline {
  color: #64748b;
  background: #f1f5f9;
  border: 2rpx solid #e2e8f0;
}

.login-legal-modal-btn--agree {
  color: #fff;
  background: var(--lq-gradient-tab);
  box-shadow: var(--lq-shadow-tab);
}

.login-wx-profile {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-bottom: 20rpx;
  padding: 20rpx;
  background: #f8fafc;
  border-radius: 20rpx;
  border: 1rpx solid var(--lq-border);
}

.login-wx-profile--sheet {
  margin: 20rpx 0;
  background: #fff;
}

.login-wx-avatar-btn {
  padding: 0;
  margin: 0;
  background: transparent;
  border: none;
  line-height: 1;
  flex-shrink: 0;
}

.login-wx-avatar-btn::after {
  border: none;
}

.login-wx-avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  border: 2rpx solid #e2e8f0;
}

.login-wx-avatar--ph {
  display: flex;
  align-items: center;
  justify-content: center;
  background: #f1f5f9;
  font-size: 22rpx;
  color: #94a3b8;
}

.login-wx-nick {
  flex: 1;
  min-width: 0;
  height: 72rpx;
  padding: 0 20rpx;
  background: #fff;
  border-radius: 14rpx;
  font-size: 28rpx;
  border: 1rpx solid #e2e8f0;
}

.login-wx-auth-step {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 24rpx;
  margin: 28rpx 0 8rpx;
}

.login-wx-avatar-btn--lg {
  display: block;
  width: 160rpx;
  height: 160rpx;
  overflow: hidden;
}

.login-wx-avatar--lg {
  width: 160rpx;
  height: 160rpx;
  display: block;
}

.login-wx-avatar--ph-img {
  opacity: 0.35;
  background: #f1f5f9;
}

.login-wx-avatar-tip {
  margin-top: -8rpx;
  font-size: 24rpx;
  color: #64748b;
}

.login-wx-auth-step--privacy {
  width: 100%;
  padding-bottom: 8rpx;
}

.login-privacy-contract-link {
  font-size: 24rpx;
  color: var(--lq-primary);
  font-weight: 600;
}

.login-wx-avatar--sm {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  border: 2rpx solid #e2e8f0;
}

.login-wx-nick--sheet {
  width: 100%;
  box-sizing: border-box;
}

.login-wx-nick-display {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  min-height: 72rpx;
  padding: 0 20rpx;
  background: #fff;
  border-radius: 14rpx;
  border: 1rpx solid #e2e8f0;
}

.login-wx-nick-display__text {
  flex: 1;
  min-width: 0;
  font-size: 28rpx;
  color: var(--lq-text);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.login-wx-nick-display__edit {
  flex-shrink: 0;
  font-size: 24rpx;
  font-weight: 600;
  color: var(--lq-primary);
}

.login-id-sheet--center {
  width: 620rpx;
  margin: auto;
  border-radius: 32rpx;
  padding-bottom: 32rpx;
  box-shadow: 0 16rpx 48rpx rgba(45, 27, 78, 0.18);
}

.login-wx-auth-step--nick {
  width: 100%;
  padding-bottom: 8rpx;
}

.login-btn--sheet {
  width: 100%;
  margin-top: 16rpx;
  margin-bottom: 8rpx;
}

.login-err {
  display: block;
  margin-top: 16rpx;
  padding: 12rpx 16rpx;
  font-size: 24rpx;
  color: #b91c1c;
  text-align: center;
  background: #fef2f2;
  border-radius: 14rpx;
}

.login-spark {
  position: relative;
  padding: 12rpx 0 10rpx;
  background: linear-gradient(
    165deg,
    var(--lq-primary-50) 0%,
    var(--lq-bg) 38%,
    var(--lq-surface) 100%
  );
}

.login-spark::before {
  content: '';
  display: block;
  position: absolute;
  left: 36rpx;
  right: 36rpx;
  top: 0;
  height: 2rpx;
  background: linear-gradient(
    90deg,
    transparent 0%,
    var(--lq-active-tint) 30%,
    var(--lq-primary-soft) 50%,
    var(--lq-active-tint) 70%,
    transparent 100%
  );
}

.login-spark-head {
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding: 0 24rpx 14rpx;
}

.login-spark-orb {
  position: relative;
  width: 68rpx;
  height: 68rpx;
  flex-shrink: 0;
}

.login-spark-orb__txt {
  position: relative;
  z-index: 2;
  display: block;
  width: 68rpx;
  height: 68rpx;
  line-height: 68rpx;
  text-align: center;
  font-size: 26rpx;
  font-weight: 800;
  color: #fff;
  border-radius: 50%;
  background: var(--lq-gradient-tab);
  box-shadow: var(--lq-shadow-soft);
}

.login-spark-orb__ring {
  position: absolute;
  left: -8rpx;
  top: -8rpx;
  width: 84rpx;
  height: 84rpx;
  border-radius: 50%;
  border: 2rpx solid rgba(183, 148, 246, 0.35);
  animation: login-orb-pulse 3s ease-in-out infinite;
}

@keyframes login-orb-pulse {
  0%,
  100% {
    transform: scale(1);
    opacity: 0.55;
  }
  50% {
    transform: scale(1.08);
    opacity: 0.9;
  }
}

.login-spark-copy {
  flex: 1;
  min-width: 0;
}

.login-spark-title {
  display: block;
  font-size: 30rpx;
  font-weight: 800;
  color: var(--lq-primary-deep);
}

.login-spark-sub {
  display: block;
  margin-top: 4rpx;
  font-size: 22rpx;
  color: var(--lq-text-secondary);
  line-height: 1.4;
}

.login-spark-grid {
  display: flex;
  gap: 10rpx;
  padding: 0 20rpx 6rpx;
  box-sizing: border-box;
}

.login-spark-pill {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  justify-content: flex-start;
  padding: 10rpx 10rpx 12rpx;
  border-radius: 20rpx;
  background: rgba(255, 255, 255, 0.88);
  border: 2rpx solid var(--lq-border);
  box-shadow: var(--lq-shadow-soft);
}

.login-spark-pill--0 {
  transform: translateY(2rpx);
}

.login-spark-pill--1 {
  transform: translateY(-2rpx);
}

.login-spark-pill--2 {
  transform: translateY(1rpx);
}

.login-spark-pill__tag {
  display: inline-block;
  align-self: flex-start;
  padding: 2rpx 10rpx;
  margin-bottom: 6rpx;
  font-size: 18rpx;
  font-weight: 700;
  color: #fff;
  border-radius: 999rpx;
  background: var(--lq-gradient-tab);
}

.login-spark-pill__text {
  display: block;
  font-size: 22rpx;
  font-weight: 600;
  color: var(--lq-text);
  line-height: 1.35;
}

.login-spark-flow {
  display: block;
  padding: 0 24rpx 2rpx;
  font-size: 20rpx;
  color: var(--lq-text-secondary);
  line-height: 1.45;
  text-align: center;
}

.login-orbit-deco {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  width: 100%;
  height: 100%;
  opacity: 0.42;
  z-index: 0;
  pointer-events: none;
}

.login-orbit-wall-wrap {
  position: relative;
  z-index: 1;
  flex: 1;
  display: flex;
  flex-direction: column;
  min-height: 0;
}

.share-cover-preload {
  position: fixed;
  left: -9999rpx;
  top: -9999rpx;
  width: 1px;
  height: 1px;
  opacity: 0;
  pointer-events: none;
}

.login-field--row {
  display: flex;
  gap: 12rpx;
  align-items: stretch;
}

.login-input--code {
  flex: 1;
}

.login-sms-btn {
  flex-shrink: 0;
  margin: 0;
  padding: 0 20rpx;
  height: auto;
  min-height: 80rpx;
  line-height: 80rpx;
  font-size: 24rpx;
  font-weight: 600;
  color: var(--lq-primary-dark);
  background: var(--lq-primary-50);
  border: 2rpx solid var(--lq-primary-100);
  border-radius: 20rpx;
}

.login-sms-btn::after {
  border: none;
}
