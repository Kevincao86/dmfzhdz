.page {
  padding: 24rpx;
}
.tabs {
  display: flex;
  gap: 16rpx;
  margin-bottom: 16rpx;
}
.tab {
  flex: 1;
  text-align: center;
  padding: 16rpx;
  border-radius: 12rpx;
  background: #f1f5f9;
  font-size: 28rpx;
}
.tab--on {
  background: #6366f1;
  color: #fff;
  font-weight: 600;
}
.card {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
}
.item .name {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
}
.sub {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #64748b;
}
.note {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #b45309;
}
.empty {
  text-align: center;
  color: #94a3b8;
  padding: 48rpx;
}
.btn.danger {
  margin-top: 16rpx;
  color: #dc2626;
}
