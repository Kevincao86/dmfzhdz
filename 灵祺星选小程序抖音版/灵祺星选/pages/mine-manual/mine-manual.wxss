.manual-page {
  height: 100vh;
  box-sizing: border-box;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
}

.manual-hero .title-lg {
  display: block;
  margin-bottom: 8rpx;
}

.manual-section {
  margin-top: 16rpx;
}

.manual-body {
  display: block;
  margin-top: 8rpx;
  line-height: 1.55;
}

.manual-bullet-row {
  display: flex;
  align-items: flex-start;
  gap: 8rpx;
  margin-top: 10rpx;
}

.manual-bullet-dot {
  flex-shrink: 0;
  color: #8b6cf6;
  font-weight: 700;
  line-height: 1.55;
}

.manual-bullet-text {
  flex: 1;
  line-height: 1.55;
}

.manual-foot {
  display: block;
  margin-top: 14rpx;
  color: #64748b;
  line-height: 1.5;
}

.manual-footer {
  margin-top: 16rpx;
  text-align: center;
}
