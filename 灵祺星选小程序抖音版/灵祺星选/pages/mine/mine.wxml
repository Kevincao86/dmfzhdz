<view class="mine-page page-with-bar page-shell-fixed {{lqThemeClass}}">
  <view class="wb-hero lq-hero-header" style="{{headerBandStyle}}">
    <view class="wb-hero-inner lq-hero-header__inner" style="{{headerInnerStyle}}">
      <view class="wb-hero-top">
        <view class="wb-profile-row">
          <button
            wx:if="{{wxLoggedIn}}"
            class="profile-avatar-btn"
            open-type="chooseAvatar"
            bindchooseavatar="onProfileChooseAvatar"
            catchtap="noopProfileTap"
          >
            <image
              class="wb-avatar"
              src="{{avatarUrl}}"
              mode="aspectFill"
              wx:if="{{avatarUrl}}"
            />
            <view class="wb-avatar wb-avatar--ph" wx:else>
              <image class="profile-avatar-logo lq-brand-logo" src="/images/logo.png" mode="aspectFill" />
            </view>
          </button>
          <view wx:else class="profile-avatar-wrap" bindtap="goEditProfile">
            <image
              class="wb-avatar"
              src="{{avatarUrl}}"
              mode="aspectFill"
              wx:if="{{avatarUrl}}"
            />
            <view class="wb-avatar wb-avatar--ph" wx:else>
              <image class="profile-avatar-logo lq-brand-logo" src="/images/logo.png" mode="aspectFill" />
            </view>
          </view>
          <view class="wb-profile-meta">
            <view class="wb-name-row">
              <input
                wx:if="{{wxLoggedIn}}"
                class="wb-nick-input"
                type="nickname"
                placeholder="点击输入昵称"
                value="{{profileNick}}"
                bindinput="onProfileNickInput"
                bindblur="onProfileNickBlur"
              />
              <text wx:else class="wb-name">{{displayName}}</text>
            </view>
            <view class="wb-tag-row">
              <text class="wb-role-pill">{{identityLabel}}工作台</text>
              <text class="profile-badge profile-badge--verified wb-verified-pill" wx:if="{{profileVerified}}">已认证{{identityLabel}}</text>
              <text class="profile-badge profile-badge--muted" wx:if="{{!wxLoggedIn}}">未登录</text>
              <text class="profile-badge profile-badge--muted" wx:elif="{{profileIncomplete}}">资料未完善</text>
            </view>
            <text class="wb-sub">{{displaySub}}</text>
            <text class="wb-id" wx:if="{{identityIdLine}}">{{identityIdLine}}</text>
          </view>
          <view class="wb-switch-btn" bindtap="onSwitchIdentity" hover-class="wb-switch-btn--hover">
            <text class="wb-switch-glyph">⇄</text>
            <text class="wb-switch-text">切换</text>
          </view>
        </view>
      </view>
      <view class="wb-hero-foot" wx:if="{{greeting}}">
        <text class="wb-greeting">{{greeting}}</text>
      </view>
    </view>
  </view>

  <view class="wb-stats-card" wx:if="{{wxLoggedIn}}">
    <view class="wb-stat-cell" bindtap="onMenuTap" data-key="{{statAppliedKey}}">
      <text class="wb-stat-num">{{statApplied}}</text>
      <text class="wb-stat-lbl">{{statAppliedLabel}}</text>
    </view>
    <view class="wb-stat-cell">
      <text class="wb-stat-num">{{statInProgress}}</text>
      <text class="wb-stat-lbl">{{statInProgressLabel}}</text>
    </view>
    <view class="wb-stat-cell">
      <text class="wb-stat-num">{{statCompleted}}</text>
      <text class="wb-stat-lbl">{{statCompletedLabel}}</text>
    </view>
  </view>

  <view class="wx-login-banner card--accent" wx:if="{{!wxLoggedIn}}">
    <text class="vip-text">使用微信昵称头像登录，即可发招募、报名与导出</text>
    <button class="vip-btn" bindtap="onGoLoginPage">微信登录</button>
  </view>

  <scroll-view class="mine-scroll page-scroll-body" scroll-y enhanced show-scrollbar="{{false}}">
    <view class="wb-section" wx:if="{{quickMenus.length}}">
      <view class="wb-section-head">
        <text class="wb-section-title">常用功能</text>
      </view>
      <view class="wb-quick-grid">
        <view
          wx:for="{{quickMenus}}"
          wx:key="key"
          class="wb-quick-tile {{item.comingSoon ? 'wb-quick-tile--soon' : ''}}"
          hover-class="wb-quick-tile--hover"
          data-key="{{item.key}}"
          bindtap="onMenuTap"
        >
          <view class="wb-tile-icon">
            <image class="wb-tile-img" src="{{item.iconSrc}}" mode="aspectFill" />
          </view>
          <text class="wb-tile-label">{{item.label}}</text>
        </view>
      </view>
    </view>

    <view class="wb-section" wx:if="{{bizMenus.length}}">
      <view class="wb-section-head">
        <text class="wb-section-title">业务管理</text>
      </view>
      <view class="wb-biz-card">
        <view
          wx:for="{{bizMenus}}"
          wx:key="key"
          class="wb-biz-row {{item.comingSoon ? 'wb-biz-row--soon' : ''}}"
          hover-class="wb-biz-row--hover"
          data-key="{{item.key}}"
          bindtap="onMenuTap"
        >
          <view class="wb-biz-icon">
            <image class="wb-biz-img" src="{{item.iconSrc}}" mode="aspectFill" />
          </view>
          <view class="wb-biz-body">
            <text class="wb-biz-label">{{item.label}}</text>
            <text class="wb-biz-sub">{{item.sub}}</text>
          </view>
          <view class="wb-biz-right">
            <text class="menu-soon" wx:if="{{item.comingSoon}}">即将开放</text>
            <text class="wb-biz-arrow" wx:else>›</text>
          </view>
        </view>
      </view>
    </view>

    <site-icp-footer />
  </scroll-view>

  <view
    class="id-sheet-mask"
    wx:if="{{showWxLoginSheet}}"
    catchtouchmove="noopSheetTap"
    bindtap="onCloseWxLoginSheet"
  >
    <view class="id-sheet wx-login-sheet">
      <view class="id-sheet-static" catchtap="noopSheetTap">
        <view class="id-sheet-head">
          <text class="id-sheet-title">微信登录 / 注册</text>
          <text class="id-sheet-close" bindtap="onCloseWxLoginSheet">×</text>
        </view>
        <text class="id-sheet-hint">授权头像与昵称后，达人/PR 身份共用同一微信账号</text>
      </view>
      <view class="wx-login-profile">
        <button
          class="wx-avatar-btn"
          hover-class="none"
          catchtap="noopSheetTap"
          open-type="chooseAvatar"
          bindchooseavatar="onChooseAvatar"
        >
          <image class="wx-login-avatar" src="{{wxLoginAvatar}}" mode="aspectFill" wx:if="{{wxLoginAvatar}}" />
          <view class="wx-login-avatar wx-login-avatar--ph" wx:else>
            <text>选头像</text>
          </view>
        </button>
        <input
          class="wx-login-nick-input"
          type="nickname"
          placeholder="点击选用微信昵称"
          value="{{wxLoginNick}}"
          bindinput="onNicknameInput"
          bindnicknamereview="onNicknameReview"
        />
      </view>
      <view class="id-sheet-foot" catchtap="noopSheetTap">
        <button
          class="btn-primary wx-login-submit"
          loading="{{wxLoginSubmitting}}"
          bindtap="onConfirmWxLogin"
        >
          确认登录
        </button>
      </view>
    </view>
  </view>
</view>
