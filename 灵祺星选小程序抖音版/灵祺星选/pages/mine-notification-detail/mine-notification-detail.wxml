<view class="ntf-detail page-shell {{lqThemeClass}}" wx:if="{{row}}">
  <view class="card ntf-detail-card">
    <view class="ntf-detail-head">
      <text class="ntf-cat ntf-cat--{{row.noticeKind}}">{{row.noticeKindLabel}}</text>
      <text class="ntf-read {{row.read ? 'ntf-read--ok' : 'ntf-read--new'}}">{{row.readLabel}}</text>
    </view>
    <text class="ntf-detail-time">{{row.createdAt}}</text>
    <text class="title-lg ntf-detail-title">{{row.title}}</text>
    <text class="ntf-detail-body">{{row.body}}</text>
    <image
      wx:if="{{row.imageUrl}}"
      class="ntf-detail-image"
      src="{{row.imageUrl}}"
      mode="widthFix"
      bindtap="onPreviewImage"
    />
  </view>

  <view wx:if="{{row.showSelectionActions}}" class="ntf-actions ntf-detail-actions">
    <button class="ntf-action-btn" data-action="confirmed" bindtap="onSelectionAction">确认</button>
    <button class="ntf-action-btn ntf-action-btn--primary" data-action="joined" bindtap="onSelectionAction">
      已入群
    </button>
  </view>

  <button wx:if="{{row.detailUrl}}" class="ntf-detail-link" bindtap="onGoOrder">{{row.detailLabel}}</button>
</view>
