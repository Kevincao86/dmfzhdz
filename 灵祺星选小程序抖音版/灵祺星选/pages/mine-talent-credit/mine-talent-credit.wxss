@import '../../styles/xingxuan-subpage.wxss';

.hero {
  text-align: center;
  padding: 40rpx 28rpx 36rpx;
}

.hero-ring {
  width: 220rpx;
  height: 220rpx;
  margin: 0 auto 20rpx;
  border-radius: 50%;
  background: var(--lq-gradient, linear-gradient(135deg, #8b93ff 0%, #b794f6 52%, #f0abfc 100%));
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: var(--lq-shadow-header, 0 14rpx 0 rgba(183, 148, 246, 0.28));
}

.score {
  font-size: 88rpx;
  font-weight: 800;
  color: #fff;
  line-height: 1;
}

.level {
  display: block;
  margin-top: 12rpx;
  font-size: 32rpx;
  color: #0f172a;
  font-weight: 700;
}

.badges {
  margin-top: 20rpx;
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 12rpx;
}

.badge {
  font-size: 22rpx;
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  background: var(--lq-primary-50, #f3f1ff);
  color: var(--lq-primary-dark, #6d28d9);
}

.stats-grid {
  display: flex;
  flex-wrap: wrap;
}

.stat {
  width: 33.33%;
  text-align: center;
  padding: 20rpx 0;
  box-sizing: border-box;
}

.stat-val {
  display: block;
  font-size: 34rpx;
  font-weight: 700;
  color: #0f172a;
}

.stat-lab {
  font-size: 22rpx;
  color: #64748b;
  margin-top: 6rpx;
}

.title {
  font-size: 30rpx;
  font-weight: 700;
  margin-bottom: 16rpx;
  display: block;
}

.tip {
  font-size: 26rpx;
  color: #475569;
  line-height: 1.6;
  margin-bottom: 8rpx;
}

.state-loading,
.state-empty {
  text-align: center;
  padding: 48rpx 32rpx;
}

.err-title {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  color: #0f172a;
  margin-bottom: 12rpx;
}

.btn-retry {
  margin-top: 24rpx;
  font-size: 28rpx;
  color: #fff;
  background: var(--lq-gradient, linear-gradient(135deg, #8b93ff 0%, #b794f6 100%));
  border: none;
  border-radius: 999rpx;
}

.btn-retry::after {
  border: none;
}

.label {
  font-size: 26rpx;
  color: #64748b;
}

.hint {
  font-size: 24rpx;
  color: #64748b;
}
