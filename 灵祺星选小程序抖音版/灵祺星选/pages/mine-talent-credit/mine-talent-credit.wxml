<view class="page">
  <view class="card hero">
    <text class="score">{{credit.score}}</text>
    <text class="label">信用分</text>
    <text class="level">{{credit.levelLabel}}</text>
  </view>

  <view class="card">
    <view class="stat" wx:for="{{stats}}" wx:key="label">
      <text class="stat-val">{{item.value}}</text>
      <text class="stat-lab">{{item.label}}</text>
    </view>
  </view>

  <view class="card" wx:if="{{credit.tips.length}}">
    <text class="title">提升建议</text>
    <view wx:for="{{credit.tips}}" wx:key="*this" class="tip">· {{item}}</view>
  </view>
</view>
