<view class="msg-page page-with-bar page-shell-fixed mp-native-tab {{lqThemeClass}}">
  <view class="msg-nav lq-hero-header lq-hero-header--home" style="{{recHeadBandStyle}}">
    <view class="msg-nav-inner lq-hero-header__inner" style="{{recHeadInnerStyle}}">
      <text class="msg-nav-title">消息</text>
      <text class="msg-nav-sub">{{identityHint}}</text>
    </view>
  </view>

  <view class="msg-tabs">
    <view
      wx:for="{{msgTabs}}"
      wx:key="id"
      class="msg-tab {{msgTab === item.id ? 'msg-tab--on' : ''}}"
      data-id="{{item.id}}"
      bindtap="onMsgTab"
    >{{item.label}}</view>
  </view>

  <view class="msg-search-wrap" wx:if="{{msgTab !== 'system'}}">
    <view class="msg-search">
      <text class="msg-search-icon">⌕</text>
      <input
        class="msg-search-input"
        placeholder="搜索会话、昵称"
        value="{{searchKeyword}}"
        bindinput="onSearchInput"
      />
    </view>
  </view>

  <block wx:if="{{msgTab === 'system'}}">
    <scroll-view
      class="msg-ntf-scroll page-scroll-body"
      scroll-y
      enhanced
      show-scrollbar="{{false}}"
      refresher-enabled="{{true}}"
      refresher-triggered="{{refreshing}}"
      bindrefresherrefresh="onPullRefresh"
    >
      <view wx:if="{{loading}}" class="msg-fixed-tip card state-loading">
        <view class="loading-dot-wrap">
          <view class="loading-dot" />
          <view class="loading-dot" />
          <view class="loading-dot" />
        </view>
        <text class="hint list-hint">加载通知…</text>
      </view>

      <view wx:else class="msg-ntf-body">
        <view wx:if="{{ntfTotalCount > 0}}" class="ntf-head">
          <view class="ntf-tabs">
            <view
              wx:for="{{ntfTabs}}"
              wx:key="id"
              class="ntf-tab {{ntfActiveTab === item.id ? 'ntf-tab--on' : ''}}"
              data-id="{{item.id}}"
              bindtap="onNtfTabChange"
            >
              <text class="ntf-tab-label">{{item.label}}</text>
              <text wx:if="{{item.badge}}" class="ntf-tab-badge">{{item.badge}}</text>
            </view>
          </view>
          <button
            wx:if="{{ntfUnreadCount > 0}}"
            class="ntf-read-all"
            size="mini"
            bindtap="onMarkAllRead"
          >全部已读</button>
        </view>

        <view wx:if="{{ntfTotalCount === 0}}" class="card state-empty ntf-empty">
          <text class="ntf-empty-title">暂无通知</text>
          <text class="ntf-empty-hint">{{ntfEmptyHint || '发单、报名、PR 入选通知会显示在这里'}}</text>
        </view>

        <block wx:elif="{{ntfSections.length === 0}}">
          <view class="card state-empty ntf-empty">
            <text class="ntf-empty-title">该分类暂无消息</text>
            <text class="ntf-empty-hint">可切换到「全部」查看其他通知</text>
          </view>
        </block>

        <block wx:else>
          <view wx:for="{{ntfSections}}" wx:key="id" class="ntf-section">
            <text class="ntf-section-title">{{item.title}}</text>
            <view
              wx:for="{{item.rows}}"
              wx:for-item="row"
              wx:key="id"
              class="card ntf-card {{row.pinned ? 'ntf-card--pinned' : ''}} {{row.read ? '' : 'ntf-card--unread'}} {{row.canOpenDetail ? 'ntf-card--tappable' : ''}}"
              data-id="{{row.id}}"
              bindtap="onOpenNotice"
            >
              <view class="ntf-card-head">
                <view class="ntf-card-head-left">
                  <text class="ntf-cat ntf-cat--{{row.noticeKind}}">{{row.noticeKindLabel}}</text>
                  <text class="ntf-read {{row.read ? 'ntf-read--ok' : 'ntf-read--new'}}">{{row.readLabel}}</text>
                </view>
                <view class="ntf-card-head-right">
                  <text class="ntf-time">{{row.createdAt}}</text>
                  <text wx:if="{{row.canOpenDetail}}" class="ntf-arrow">›</text>
                </view>
              </view>
              <text class="title-lg ntf-title">{{row.title}}</text>
              <text class="hint ntf-body ntf-body--clamp">{{row.body}}</text>
              <text wx:if="{{row.canOpenDetail}}" class="ntf-detail-hint">{{row.detailLabel}}</text>
              <image
                wx:if="{{row.imageUrl}}"
                class="ntf-image"
                src="{{row.imageUrl}}"
                mode="widthFix"
                data-url="{{row.imageUrl}}"
                catchtap="onPreviewInboxImage"
              />
              <view wx:if="{{row.showSelectionActions}}" class="ntf-actions" catchtap="stopBubble">
                <button
                  class="ntf-action-btn"
                  data-id="{{row.id}}"
                  data-action="confirmed"
                  catchtap="onSelectionAction"
                >确认</button>
                <button
                  class="ntf-action-btn ntf-action-btn--primary"
                  data-id="{{row.id}}"
                  data-action="joined"
                  catchtap="onSelectionAction"
                >已入群</button>
              </view>
            </view>
          </view>
        </block>
      </view>
    </scroll-view>
  </block>

  <block wx:else>
    <view wx:if="{{!chatConfigured && msgTab === 'chat'}}" class="msg-fixed-tip card">
      <text class="hint">请在 config.release.js 配置 MERCHANT_API_BASE_URL（体验版 https://mofangdianai.com/erp-api）</text>
    </view>

    <view wx:elif="{{loading}}" class="msg-fixed-tip card state-loading">
      <view class="loading-dot-wrap">
        <view class="loading-dot" />
        <view class="loading-dot" />
        <view class="loading-dot" />
      </view>
      <text class="hint list-hint">加载会话…</text>
    </view>

    <view wx:elif="{{err}}" class="msg-fixed-tip card state-error">
      <text>{{err}}</text>
      <button class="msg-retry-btn" bindtap="bootstrap">重试</button>
    </view>

    <scroll-view
      wx:else
      class="msg-list page-scroll-body"
      scroll-y
      enhanced
      show-scrollbar="{{false}}"
      refresher-enabled="{{chatConfigured}}"
      refresher-triggered="{{refreshing}}"
      bindrefresherrefresh="onPullRefresh"
    >
      <view
        wx:for="{{sessions}}"
        wx:key="id"
        class="msg-entry msg-entry--v2"
        bindtap="openChat"
        data-id="{{item.id}}"
        data-name="{{item.peerName}}"
        data-peer-id="{{item.peerId}}"
        data-avatar="{{item.peerAvatar}}"
      >
        <image
          wx:if="{{item.peerAvatar}}"
          class="msg-entry-avatar"
          src="{{item.peerAvatar}}"
          mode="aspectFill"
        />
        <view wx:else class="msg-entry-avatar msg-entry-avatar--sys">💬</view>
        <view class="msg-entry-body">
          <view class="msg-entry-top">
            <view class="msg-entry-name-wrap">
              <text class="msg-entry-name">{{item.peerName}}</text>
              <text class="msg-entry-id" wx:if="{{item.peerId}}">{{item.peerId}}</text>
            </view>
            <text class="msg-entry-time">{{item.timeText}}</text>
          </view>
          <view class="msg-entry-bottom">
            <text class="msg-entry-preview">{{item.lastText || '暂无消息'}}</text>
            <view class="msg-badge" wx:if="{{item.unread > 0}}">{{item.unread > 99 ? '99+' : item.unread}}</view>
          </view>
        </view>
      </view>

      <view wx:if="{{sessions.length === 0}}" class="msg-empty">
        <text class="msg-empty-icon">💬</text>
        <text class="msg-empty-title">{{emptyTitle}}</text>
        <text class="msg-empty-hint" wx:if="{{emptyHint}}">{{emptyHint}}</text>
      </view>

      <view wx:if="{{showDevTest}}" class="msg-dev-bar">
        <button class="msg-test-btn" bindtap="openTestDialog">打开测试对话（开发）</button>
        <text class="msg-test-hint">PR 建会话后切达人身份可双向回复</text>
      </view>
      <site-icp-footer />
    </scroll-view>
  </block>
  <mp-tab-bar id="mp-tab-bar" />
</view>
