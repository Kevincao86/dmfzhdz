.web-link-fallback {
  padding: 32rpx;
  min-height: 100vh;
  box-sizing: border-box;
  background: #f8fafc;
}

.web-link-card {
  padding: 32rpx;
}

.web-link-title {
  display: block;
  font-size: 34rpx;
  font-weight: 700;
  color: #0f172a;
  margin-bottom: 16rpx;
}

.web-link-hint {
  display: block;
  font-size: 26rpx;
  line-height: 1.75;
  color: #64748b;
  margin-bottom: 24rpx;
}

.web-link-url {
  display: block;
  font-size: 24rpx;
  line-height: 1.7;
  color: #334155;
  word-break: break-all;
  padding: 20rpx;
  border-radius: 12rpx;
  background: #f1f5f9;
  margin-bottom: 24rpx;
}

.web-link-btn {
  background: #7c3aed;
  color: #fff;
  border-radius: 16rpx;
  font-size: 28rpx;
  margin-bottom: 20rpx;
}

.web-link-guide {
  display: block;
  font-size: 24rpx;
  line-height: 1.75;
  color: #7c3aed;
}
