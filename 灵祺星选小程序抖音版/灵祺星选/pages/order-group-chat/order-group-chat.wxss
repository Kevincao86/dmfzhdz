@import '../chat/chat.wxss';

.ogc-page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: #ededed;
}

.ogc-nav-title {
  display: block;
  font-size: 32rpx;
  font-weight: 700;
  color: #111;
  max-width: 420rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.ogc-nav-sub {
  display: block;
  margin-top: 4rpx;
  font-size: 22rpx;
  color: #6b7280;
}

.ogc-media {
  max-width: 360rpx;
  border-radius: 8rpx;
  display: block;
}

.ogc-video-cover {
  position: relative;
  display: inline-block;
}

.ogc-video-play {
  position: absolute;
  left: 50%;
  top: 50%;
  transform: translate(-50%, -50%);
  width: 64rpx;
  height: 64rpx;
  line-height: 64rpx;
  text-align: center;
  background: rgba(0, 0, 0, 0.45);
  color: #fff;
  border-radius: 50%;
  font-size: 28rpx;
}

.ogc-closed-banner {
  padding: 16rpx 20rpx;
  font-size: 24rpx;
  color: #6b7280;
  background: #f3f4f6;
  border-bottom: 1rpx solid #e5e7eb;
  text-align: center;
}

.ogc-composer-tools {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 0 8rpx 8rpx;
}

.ogc-tool-btn {
  width: 64rpx;
  height: 64rpx;
  line-height: 64rpx;
  text-align: center;
  font-size: 36rpx;
  background: transparent;
  border: none;
  padding: 0;
  margin: 0;
}

.ogc-tool-btn::after {
  border: none;
}

.ogc-tool-btn[disabled] {
  opacity: 0.4;
}

.bubble-name {
  display: block;
  font-size: 22rpx;
  color: #6b7280;
  margin-bottom: 6rpx;
}

.bubble-row.their .bubble-name {
  text-align: left;
}

.bubble-row.mine .bubble-name {
  text-align: right;
}

.composer-toolbar {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.composer-main {
  flex: 1;
  min-width: 0;
}

.composer-icon {
  width: 64rpx;
  height: 64rpx;
  line-height: 64rpx;
  text-align: center;
  font-size: 40rpx;
  flex-shrink: 0;
}

.composer-icon--plus {
  font-size: 52rpx;
  font-weight: 300;
}

.composer-icon--active {
  color: #07c160;
}

.voice-hold-btn {
  height: 72rpx;
  line-height: 72rpx;
  text-align: center;
  background: #fff;
  border-radius: 12rpx;
  border: 1rpx solid #e5e7eb;
  font-size: 28rpx;
  color: #374151;
}

.voice-hold-btn--active {
  background: #dcfce7;
  border-color: #86efac;
}

.plus-panel {
  padding: 16rpx 8rpx 8rpx;
  border-top: 1rpx solid #ececec;
  margin-top: 8rpx;
}

.plus-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 24rpx 32rpx;
}

.plus-item {
  width: 120rpx;
  text-align: center;
}

.plus-item-icon {
  width: 112rpx;
  height: 112rpx;
  line-height: 112rpx;
  margin: 0 auto 8rpx;
  background: #fff;
  border-radius: 20rpx;
  font-size: 48rpx;
}

.plus-item-label {
  font-size: 22rpx;
  color: #6b7280;
}

.ogc-audio,
.ogc-location,
.ogc-file {
  display: flex;
  align-items: center;
  gap: 12rpx;
  min-width: 180rpx;
}

.ogc-audio-icon,
.ogc-location-icon,
.ogc-file-icon {
  font-size: 32rpx;
}

.ogc-audio-dur,
.ogc-location-name,
.ogc-file-name {
  font-size: 28rpx;
  word-break: break-all;
}
