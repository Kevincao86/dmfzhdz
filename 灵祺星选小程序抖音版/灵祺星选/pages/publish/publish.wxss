@import '../../styles/theme.wxss';
@import '../../styles/template-edit.wxss';
@import '../../styles/mp-beautify.wxss';

.pub-page {
  height: 100vh;
  box-sizing: border-box;
  overflow: hidden;
}

.pub-page--mode {
  background: linear-gradient(165deg, #e0e7ff 0%, #f4f3f8 45%, #faf8ff 100%);
}

.pub-page--form {
  background: linear-gradient(180deg, #dde4ff 0%, #ede9fe 28%, #f5f3ff 60%, #faf8ff 100%);
}

.pub-form-host {
  position: relative;
  height: 100vh;
  width: 100%;
  overflow: hidden;
}

.pub-form-host > .pub-full {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 30;
}

.pub-screen {
  position: relative;
  height: 100vh;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.pub-screen .pub-form-layout,
.pub-screen .pub-hero,
.pub-screen .pub-mode-list,
.pub-screen .pub-done-wrap {
  position: relative;
  z-index: 1;
}

.pub-life-bg {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  overflow: hidden;
  pointer-events: none;
  z-index: 0;
}

.pub-life-blob {
  position: absolute;
  border-radius: 50%;
  filter: blur(2rpx);
}

.pub-life-blob--1 {
  width: 320rpx;
  height: 320rpx;
  left: -80rpx;
  top: 120rpx;
  background: rgba(99, 102, 241, 0.14);
}

.pub-life-blob--2 {
  width: 280rpx;
  height: 280rpx;
  right: -60rpx;
  top: 360rpx;
  background: rgba(139, 92, 246, 0.12);
}

.pub-life-blob--3 {
  width: 240rpx;
  height: 240rpx;
  left: 40%;
  bottom: 180rpx;
  background: rgba(245, 158, 11, 0.1);
}

.pub-life-ico {
  position: absolute;
  font-size: 44rpx;
  opacity: 0.22;
  line-height: 1;
}

.pub-life-ico--1 { left: 8%; top: 18%; font-size: 52rpx; opacity: 0.18; }
.pub-life-ico--2 { right: 12%; top: 14%; }
.pub-life-ico--3 { left: 6%; top: 42%; font-size: 40rpx; }
.pub-life-ico--4 { right: 8%; top: 38%; font-size: 48rpx; }
.pub-life-ico--5 { left: 14%; bottom: 28%; }
.pub-life-ico--6 { right: 10%; bottom: 22%; font-size: 50rpx; }

.pub-page--done {
  background: linear-gradient(180deg, #e0e7ff 0%, #f5f3ff 100%);
}

.pub-page--target,
.pub-page--target .pub-screen--target,
.pub-page--mode,
.pub-page--mode .pub-screen--mode {
  background: linear-gradient(165deg, #e8eaff 0%, #f4f3f8 38%, #faf8ff 100%);
}

.pub-page--form,
.pub-page--form .pub-screen--form {
  background: linear-gradient(165deg, #e8eaff 0%, #f4f3f8 28%, #faf8ff 100%);
}

.pub-screen--mode,
.pub-screen--form {
  display: flex;
  flex-direction: column;
}

.pub-form-top {
  flex-shrink: 0;
}

.pub-form-title-bar {
  flex-shrink: 0;
  padding: 8rpx 28rpx 16rpx;
  text-align: center;
}

.pub-form-title-bar__title {
  margin-top: 8rpx;
}

.pub-form-mode-chip {
  display: inline-block;
  margin-top: 10rpx;
  padding: 6rpx 18rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  font-weight: 600;
  color: var(--lq-primary-dark);
  background: var(--lq-primary-50);
}

.pub-screen--form .pub-form-scroll {
  flex: 1;
  height: 0;
  min-height: 0;
}

.pub-screen--form .pub-form-body {
  padding-bottom: calc(24rpx + 116rpx + env(safe-area-inset-bottom));
}

.pub-screen--form .pub-form-card {
  margin: 0 28rpx 16rpx;
  border-radius: 20rpx;
  box-shadow: var(--lq-shadow-soft);
  border: 1rpx solid var(--lq-chip-on-border);
}

.pub-target-top {
  flex-shrink: 0;
  padding: 0 28rpx 12rpx;
}

.pub-target-nav {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 56rpx;
  margin-bottom: 8rpx;
}

.pub-target-back {
  position: absolute;
  left: 0;
  top: 50%;
  margin-top: -22rpx;
  width: 44rpx;
  height: 44rpx;
  line-height: 44rpx;
  text-align: center;
  font-size: 44rpx;
  font-weight: 300;
  color: #374151;
}

.pub-target-brand {
  font-size: 34rpx;
  font-weight: 800;
  color: #1f2937;
  letter-spacing: 1rpx;
}

.pub-steps-v2 {
  position: relative;
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  padding: 8rpx 12rpx 0;
}

.pub-steps-v2__line {
  position: absolute;
  top: 28rpx;
  height: 4rpx;
  background: #e5e7eb;
  border-radius: 2rpx;
  z-index: 0;
}

.pub-steps-v2__line--a {
  left: 12%;
  right: 62%;
}

.pub-steps-v2__line--b {
  left: 33%;
  right: 42%;
}

.pub-steps-v2__line--c {
  left: 54%;
  right: 22%;
}

.pub-steps-v2__line--on {
  background: var(--lq-gradient);
}

.pub-steps-v2__line--done {
  background: var(--lq-primary-dark);
}

.pub-step-v2 {
  position: relative;
  z-index: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  flex: 1;
}

.pub-step-v2__num {
  width: 52rpx;
  height: 52rpx;
  line-height: 52rpx;
  text-align: center;
  border-radius: 50%;
  font-size: 26rpx;
  font-weight: 800;
  color: #9ca3af;
  background: #f3f4f6;
  border: 2rpx solid #e5e7eb;
}

.pub-step-v2--on .pub-step-v2__num {
  width: auto;
  min-width: 52rpx;
  padding: 0 18rpx;
  border-radius: 999rpx;
  color: #fff;
  background: var(--lq-gradient);
  border-color: transparent;
  box-shadow: var(--lq-shadow-tab);
}

.pub-step-v2--done .pub-step-v2__num {
  color: #fff;
  background: #34d399;
  border-color: #34d399;
}

.pub-step-v2__label {
  font-size: 22rpx;
  font-weight: 600;
  color: #9ca3af;
  line-height: 1.3;
}

.pub-step-v2--on .pub-step-v2__label {
  color: var(--lq-primary-dark);
  font-weight: 700;
}

.pub-step-v2--done .pub-step-v2__label {
  color: #6b7280;
}

.pub-target-main {
  flex: 1;
  min-height: 0;
  padding: 12rpx 28rpx calc(24rpx + 116rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.pub-target-title {
  display: block;
  text-align: center;
  font-size: 44rpx;
  font-weight: 800;
  color: #1e1b4b;
  line-height: 1.25;
  margin-top: 16rpx;
}

.pub-target-sub {
  display: block;
  text-align: center;
  margin-top: 10rpx;
  margin-bottom: 28rpx;
  font-size: 28rpx;
  font-weight: 600;
  color: var(--lq-primary-dark);
}

.pub-mode-list--target {
  margin-top: 0;
  padding: 0;
}

.pub-mode-card--icon {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 28rpx 72rpx 28rpx 24rpx;
}

.pub-mode-icon {
  flex-shrink: 0;
  width: 88rpx;
  height: 88rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--lq-gradient);
  box-shadow: var(--lq-shadow-soft);
}

.pub-mode-icon-glyph {
  font-size: 40rpx;
  color: #fff;
  line-height: 1;
}

.pub-mode-copy {
  flex: 1;
  min-width: 0;
}

.pub-mode-card--icon .pub-mode-name {
  font-size: 34rpx;
}

.pub-mode-card--icon .pub-mode-sub {
  margin-top: 6rpx;
  font-size: 24rpx;
  color: #6b7280;
}

.pub-hero {
  margin: 0 28rpx 6rpx;
  padding: 8rpx 28rpx 18rpx;
  border-radius: var(--lq-radius-lg);
  background: var(--lq-gradient-header);
  box-shadow: var(--lq-shadow-header);
}

.pub-hero-back {
  display: block;
  margin-bottom: 8rpx;
  font-size: 28rpx;
  font-weight: 600;
  color: rgba(255, 255, 255, 0.95);
  line-height: 1.4;
}

.pub-hero-title {
  display: block;
  font-size: 36rpx;
  font-weight: 800;
  color: #fff;
}

.pub-hero-sub {
  display: block;
  margin-top: 8rpx;
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.88);
}

.pub-mode-list {
  flex: 1;
  min-height: 0;
  margin-top: -4rpx;
  padding: 0 28rpx calc(24rpx + 116rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.pub-mode-card {
  position: relative;
  margin-bottom: 16rpx;
  padding: 28rpx 72rpx 28rpx 28rpx;
  background: rgba(255, 255, 255, 0.96);
  border-radius: 20rpx;
  border: 1rpx solid rgba(199, 210, 254, 0.5);
  box-shadow: 0 10rpx 36rpx rgba(79, 70, 229, 0.1);
}

.pub-mode-card--disabled {
  opacity: 0.78;
  background: rgba(255, 255, 255, 0.9);
}

.pub-mode-card--disabled .pub-mode-sub {
  color: #94a3b8;
}

.pub-mode-badge {
  position: absolute;
  right: 28rpx;
  top: 50%;
  margin-top: -22rpx;
  padding: 8rpx 18rpx;
  font-size: 22rpx;
  font-weight: 600;
  color: #64748b;
  background: #f1f5f9;
  border-radius: 999rpx;
}

.pub-mode-name {
  display: block;
  font-size: 32rpx;
  font-weight: 700;
}

.pub-mode-sub {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  color: var(--lq-text-secondary);
}

.pub-mode-arrow {
  position: absolute;
  right: 28rpx;
  top: 50%;
  margin-top: -20rpx;
  font-size: 40rpx;
  color: #c7d2fe;
}

/* 表单页：顶栏 + 可滚动表单（创建按钮在表单最底部，留白避开 TabBar） */
.pub-form-layout {
  display: flex;
  flex-direction: column;
  height: 100vh;
  box-sizing: border-box;
}

.pub-form-head {
  flex-shrink: 0;
  display: flex;
  flex-direction: column;
  align-items: stretch;
  gap: 0;
  padding-left: 0;
  padding-bottom: 0;
  margin-bottom: -4rpx;
  background: transparent;
  box-sizing: border-box;
}

.pub-form-head-row {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
  padding: 0 24rpx;
}

.pub-form-head-main {
  flex: 1;
  min-width: 0;
}

.pub-back {
  flex-shrink: 0;
  font-size: 28rpx;
  color: var(--lq-primary-dark);
  font-weight: 600;
  line-height: 1.35;
  padding-top: 2rpx;
}

.pub-form-title {
  display: block;
  font-size: 34rpx;
  font-weight: 800;
  line-height: 1.35;
}

.pub-form-badge {
  display: inline-block;
  margin-top: 6rpx;
  padding: 6rpx 16rpx;
  font-size: 22rpx;
  font-weight: 600;
  color: var(--lq-primary-dark);
  background: var(--lq-primary-50);
  border-radius: 8rpx;
}

.pub-form-scroll {
  flex: 1;
  height: 0;
  min-height: 0;
  width: 100%;
}

.pub-form-body {
  padding: 0 24rpx;
  padding-bottom: calc(32rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.pub-form-submit {
  margin-top: 12rpx;
  padding: 12rpx 0 24rpx;
}

.pub-form-submit .pub-create-btn {
  width: 100%;
}

.pub-field {
  margin-bottom: 20rpx;
  padding: 20rpx 22rpx;
  background: rgba(255, 255, 255, 0.94);
  border-radius: 20rpx;
  border: 1rpx solid rgba(199, 210, 254, 0.45);
  box-shadow: 0 8rpx 28rpx rgba(79, 70, 229, 0.07);
}

.pub-label {
  display: block;
  font-size: 28rpx;
  font-weight: 700;
  color: var(--lq-text);
  margin-bottom: 16rpx;
}

.pub-label-hint {
  display: block;
  font-size: 22rpx;
  color: var(--lq-text-secondary);
  margin: -8rpx 0 12rpx;
}

.pub-window-row {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.pub-window-opt {
  padding: 18rpx 20rpx;
  border-radius: 16rpx;
  border: 2rpx solid #e2e8f0;
  background: #f8fafc;
  box-sizing: border-box;
}

.pub-window-opt--on {
  border-color: #93c5fd;
  background: var(--lq-primary-50);
}

.pub-window-opt-name {
  display: block;
  font-size: 28rpx;
  font-weight: 700;
  color: #1e293b;
}

.pub-window-opt--on .pub-window-opt-name {
  color: var(--lq-primary-dark);
}

.pub-window-opt-sub {
  display: block;
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #64748b;
  line-height: 1.4;
}

.pub-deadline-row {
  display: flex;
  gap: 12rpx;
}

.pub-deadline-pick {
  flex: 1;
  min-width: 0;
}

.pub-select--half {
  width: 100%;
}

.pub-field--hint {
  padding-bottom: 16rpx;
}

.pub-urgent-deadline-hint {
  display: block;
  font-size: 26rpx;
  color: var(--lq-primary-dark);
  line-height: 1.5;
  padding: 16rpx 20rpx;
  background: var(--lq-primary-50);
  border-radius: 12rpx;
  border: 2rpx solid #c7d2fe;
}

.pub-radio-pair--fans {
  margin-bottom: 12rpx;
}

.pub-fans-limit-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.pub-fans-limit-k {
  flex-shrink: 0;
  font-size: 28rpx;
  font-weight: 600;
  color: #475569;
}

.pub-input--fans-min {
  flex: 1;
  min-width: 0;
}

.pub-input {
  display: block;
  width: 100%;
  min-height: 88rpx;
  padding: 22rpx 24rpx;
  background: #f8fafc;
  border: 2rpx solid #e2e8f0;
  border-radius: 16rpx;
  font-size: 28rpx;
  line-height: 1.45;
  box-sizing: border-box;
}

.pub-textarea {
  width: 100%;
  min-height: 160rpx;
  height: 160rpx;
  max-height: 240rpx;
  padding: 20rpx 24rpx;
  background: #f8fafc;
  border: 2rpx solid #e2e8f0;
  border-radius: 16rpx;
  font-size: 28rpx;
  line-height: 1.5;
  box-sizing: border-box;
}

.pub-select {
  display: flex;
  align-items: center;
  min-height: 88rpx;
  padding: 0 24rpx;
  background: #f8fafc;
  border: 2rpx solid #e2e8f0;
  border-radius: 16rpx;
  box-sizing: border-box;
}

.pub-select--in {
  margin-bottom: 16rpx;
}

.pub-select--block {
  margin-top: 16rpx;
}

.pub-select-text {
  flex: 1;
  font-size: 28rpx;
  line-height: 1.45;
  color: var(--lq-text);
}

.pub-select__icon {
  width: 40rpx;
  height: 40rpx;
  margin-right: 12rpx;
  flex-shrink: 0;
  border-radius: 8rpx;
}

.pub-select-text--ph {
  color: #94a3b8;
}

.pub-select-arrow {
  font-size: 32rpx;
  color: #cbd5e1;
  margin-left: 8rpx;
}

.pub-fee-panel {
  margin-bottom: 20rpx;
  padding: 20rpx 22rpx;
  background: rgba(255, 255, 255, 0.9);
  border-radius: 20rpx;
  border: 1rpx solid rgba(199, 210, 254, 0.4);
  box-shadow: 0 6rpx 24rpx rgba(79, 70, 229, 0.06);
}

.pub-fee-panel-title {
  display: block;
  font-size: 26rpx;
  color: var(--lq-text-secondary);
  margin-bottom: 20rpx;
}

.pub-tier-card {
  position: relative;
  margin-bottom: 20rpx;
  padding: 20rpx 56rpx 20rpx 20rpx;
  background: #fff;
  border-radius: 16rpx;
  border: 1rpx solid #e2e8f0;
}

.pub-tier-del {
  position: absolute;
  right: 12rpx;
  top: 16rpx;
  font-size: 32rpx;
  padding: 8rpx;
  opacity: 0.7;
}

.pub-tier-row {
  display: flex;
  align-items: center;
  margin-bottom: 12rpx;
}

.pub-tier-k {
  width: 200rpx;
  font-size: 26rpx;
  color: #64748b;
  flex-shrink: 0;
}

.pub-tier-v {
  flex: 1;
  font-size: 28rpx;
}

.pub-tier-input {
  flex: 1;
  height: 72rpx;
  min-height: 72rpx;
  padding: 0 20rpx;
  background: #f8fafc;
  border: 2rpx solid #e2e8f0;
  border-radius: 12rpx;
  font-size: 26rpx;
  line-height: 72rpx;
  box-sizing: border-box;
}

.pub-tier-quote {
  flex-wrap: wrap;
}

.pub-tier-mode-row {
  align-items: center;
}

.pub-tier-mode-tabs {
  flex: 1;
  display: flex;
  gap: 12rpx;
}

.pub-tier-mode-tab {
  flex: 1;
  text-align: center;
  padding: 12rpx 16rpx;
  font-size: 24rpx;
  color: #64748b;
  background: #f8fafc;
  border: 2rpx solid #e2e8f0;
  border-radius: 12rpx;
}

.pub-tier-mode-tab--on {
  color: var(--lq-primary-dark, #4f46e5);
  background: #eef2ff;
  border-color: #c7d2fe;
  font-weight: 600;
}

.pub-tier-self-label {
  flex: 1;
  font-size: 26rpx;
  color: #94a3b8;
}

.pub-radio-pair {
  display: flex;
  gap: 16rpx;
  flex: 1;
}

.pub-radio-pair--wrap {
  flex-wrap: wrap;
}

.pub-radio-opt {
  padding: 10rpx 24rpx;
  font-size: 24rpx;
  color: #64748b;
  border: 2rpx solid #e2e8f0;
  border-radius: 999rpx;
}

.pub-radio-opt--on {
  position: relative;
  padding-left: 40rpx;
  color: var(--lq-primary-dark);
  border-color: #a5b4fc;
  background: var(--lq-primary-50);
  font-weight: 600;
}

.pub-radio-opt--on::after {
  content: '';
  position: absolute;
  left: 16rpx;
  top: 50%;
  width: 14rpx;
  height: 14rpx;
  margin-top: -7rpx;
  border-radius: 50%;
  background: var(--lq-primary-dark);
}

.pub-add-tier {
  text-align: center;
  padding: 22rpx;
  font-size: 28rpx;
  font-weight: 600;
  color: var(--lq-primary-dark);
  border: 2rpx dashed #a5b4fc;
  border-radius: 16rpx;
  background: #fff;
}

.pub-create-btn {
  width: 100%;
  height: 96rpx;
  line-height: 96rpx;
  padding: 0;
  font-size: 32rpx;
  box-sizing: border-box;
}

.pub-create-btn::after {
  border: none;
}

.pub-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 10000;
  display: flex;
  align-items: flex-end;
}

.pub-mask-dim {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(15, 23, 42, 0.5);
}

.pub-sheet {
  width: 100%;
  max-height: 85vh;
  background: #fff;
  border-radius: 28rpx 28rpx 0 0;
  padding: 24rpx 28rpx calc(24rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  position: relative;
  z-index: 10001;
}

.pub-sheet--stack {
  display: flex;
  flex-direction: column;
  max-height: 78vh;
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
}

.pub-sheet-foot {
  flex-shrink: 0;
  padding-top: 12rpx;
}

.pub-sheet-scroll,
.pub-fee-scroll {
  max-height: 52vh;
}

.pub-level-scroll {
  flex: 1;
  max-height: 46vh;
  min-height: 200rpx;
}

.pub-sheet--sm {
  max-height: 50vh;
}

.pub-sheet--city {
  max-height: 88vh;
}

.pub-sheet--fee {
  max-height: 85vh;
}

.pub-sheet-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 8rpx;
}

.pub-sheet-title {
  font-size: 32rpx;
  font-weight: 800;
}

.pub-sheet-close {
  font-size: 44rpx;
  color: #9ca3af;
  padding: 0 8rpx;
}

.pub-sheet-sub {
  display: block;
  font-size: 24rpx;
  color: var(--lq-text-secondary);
  margin-bottom: 16rpx;
}

.pub-sheet-opt {
  padding: 28rpx 16rpx;
  font-size: 30rpx;
  font-weight: 600;
  border-bottom: 1rpx solid #f1f5f9;
}

.pub-sheet-btn {
  margin-top: 16rpx;
}

.pub-tag-scroll {
  flex: 1;
  max-height: 46vh;
  min-height: 240rpx;
}

.pub-range-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.pub-input--range {
  flex: 1;
  min-width: 0;
}

.pub-range-sep {
  flex-shrink: 0;
  font-size: 32rpx;
  font-weight: 700;
  color: #94a3b8;
}

.pub-tag-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.pub-tag-cell {
  width: calc((100% - 36rpx) / 4);
  box-sizing: border-box;
  text-align: center;
  padding: 14rpx 4rpx;
  font-size: 22rpx;
  background: #f8fafc;
  border: 2rpx solid #e5e7eb;
  border-radius: 12rpx;
}

.pub-tag-grid--pick {
  gap: 10rpx;
}

.pub-tag-grid--pick .pub-tag-cell {
  width: calc((100% - 30rpx) / 4);
  padding: 12rpx 6rpx;
  font-size: 22rpx;
}

.pub-tag-cell--on {
  color: #2563eb;
  background: #eff6ff;
  border-color: #93c5fd;
  font-weight: 600;
}

.pub-tag-cell--dis {
  opacity: 0.35;
}

.pub-city-national {
  text-align: center;
  padding: 16rpx;
  margin-bottom: 12rpx;
  font-size: 26rpx;
  font-weight: 600;
  color: var(--lq-primary-dark);
  background: var(--lq-primary-50);
  border-radius: 12rpx;
  border: 2rpx solid #c7d2fe;
}

.pub-city-search {
  margin-bottom: 12rpx;
}

.pub-city-search-input {
  display: block;
  width: 100%;
  height: 72rpx;
  line-height: 72rpx;
  min-height: 72rpx;
  padding: 0 24rpx;
  background: #f8fafc;
  border: 2rpx solid #e2e8f0;
  border-radius: 12rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}

.pub-city-search-ph {
  line-height: 72rpx;
  color: #94a3b8;
}

.pub-city-hint {
  display: block;
  font-size: 22rpx;
  color: #94a3b8;
  margin-bottom: 12rpx;
}

.pub-city-dual-head {
  display: flex;
  margin-bottom: 8rpx;
}

.pub-city-dual-lbl {
  flex: 1;
  font-size: 22rpx;
  color: #94a3b8;
  text-align: center;
}

.pub-city-dual {
  display: flex;
  gap: 12rpx;
  height: 360rpx;
  margin-bottom: 12rpx;
  border: 2rpx solid #e2e8f0;
  border-radius: 12rpx;
  overflow: hidden;
  background: #f8fafc;
}

.pub-city-prov-scroll {
  width: 38%;
  height: 360rpx;
  background: #fff;
  border-right: 1rpx solid #e2e8f0;
  box-sizing: border-box;
}

.pub-city-prov-item {
  padding: 18rpx 12rpx;
  font-size: 24rpx;
  color: #475569;
  border-bottom: 1rpx solid #f1f5f9;
}

.pub-city-prov-item--on {
  color: var(--lq-primary-dark);
  font-weight: 700;
  background: var(--lq-primary-50);
}

.pub-city-list-scroll {
  flex: 1;
  width: 62%;
  height: 360rpx;
  box-sizing: border-box;
}

.pub-city-check-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 16rpx 20rpx;
  border-bottom: 1rpx solid #f1f5f9;
}

.pub-city-check-box {
  flex-shrink: 0;
  width: 36rpx;
  height: 36rpx;
  line-height: 36rpx;
  text-align: center;
  font-size: 22rpx;
  color: #fff;
  background: #fff;
  border: 2rpx solid #cbd5e1;
  border-radius: 8rpx;
  box-sizing: border-box;
}

.pub-city-check-box--on {
  background: var(--lq-primary);
  border-color: var(--lq-primary);
}

.pub-city-check-name {
  flex: 1;
  font-size: 26rpx;
  color: #1e293b;
}

.pub-city-empty {
  padding: 40rpx 16rpx;
  text-align: center;
  font-size: 24rpx;
  color: #94a3b8;
}

.pub-city-chips {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 16rpx;
  max-height: 160rpx;
  overflow: hidden;
}

.pub-city-chip {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 8rpx 16rpx;
  font-size: 24rpx;
  background: var(--lq-primary-50);
  color: var(--lq-primary-dark);
  border-radius: 999rpx;
}

.pub-chip-x {
  font-size: 28rpx;
  color: #94a3b8;
}

.pub-level-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 0;
}

.pub-level-grid--pick {
  gap: 10rpx;
}

.pub-level-cell {
  width: calc((100% - 24rpx) / 3);
  box-sizing: border-box;
  text-align: center;
  padding: 16rpx 8rpx;
  font-size: 26rpx;
  border: 2rpx solid #e5e7eb;
  border-radius: 12rpx;
  background: #f8fafc;
}

.pub-level-grid--pick .pub-level-cell {
  width: calc((100% - 20rpx) / 3);
  padding: 14rpx 6rpx;
}

.pub-level-cell--on {
  color: #2563eb;
  background: #eff6ff;
  border-color: #93c5fd;
  font-weight: 700;
}

.pub-level-cell--dis {
  color: #cbd5e1;
  background: #f8fafc;
}

.pub-fee-row {
  display: flex;
  gap: 20rpx;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #f1f5f9;
}

.pub-fee-radio {
  width: 36rpx;
  height: 36rpx;
  margin-top: 6rpx;
  border-radius: 50%;
  border: 2rpx solid #d1d5db;
  flex-shrink: 0;
}

.pub-fee-radio--on {
  border-color: #4f46e5;
  background: radial-gradient(circle at center, #4f46e5 0, #4f46e5 38%, #fff 40%);
}

.pub-fee-label {
  display: block;
  font-size: 30rpx;
  font-weight: 700;
}

.pub-fee-desc {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  color: var(--lq-text-secondary);
  line-height: 1.45;
}

.pub-done-wrap {
  padding: calc(env(safe-area-inset-top) + 48rpx) 28rpx 40rpx;
}

.pub-done {
  padding: 48rpx 32rpx;
  background: var(--lq-card);
  border-radius: 24rpx;
  text-align: center;
  border: 1rpx solid var(--lq-border);
}

.pub-done-icon {
  width: 96rpx;
  height: 96rpx;
  line-height: 96rpx;
  margin: 0 auto 24rpx;
  border-radius: 50%;
  background: var(--lq-gradient);
  color: #fff;
  font-size: 48rpx;
}

.pub-done-title {
  display: block;
  font-size: 36rpx;
  font-weight: 800;
}

.pub-done-sub {
  display: block;
  margin: 12rpx 0 32rpx;
  font-size: 28rpx;
  color: var(--lq-text-secondary);
}

.pub-done-btn {
  margin-bottom: 20rpx;
}

/* 全屏选择页 */
.pub-full {
  position: relative;
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: linear-gradient(180deg, #dde4ff 0%, #ede9fe 24%, #f5f3ff 58%, #faf8ff 100%);
  overflow: hidden;
}

.pub-full--pick .pub-full-head,
.pub-full--pick .pub-pick-main,
.pub-full--pick .pub-full-scroll,
.pub-full--pick .pub-full-foot {
  position: relative;
  z-index: 1;
}

.pub-full--pick {
  height: 100vh;
}

.pub-pick-main {
  flex: 1;
  min-height: 0;
  padding: 0 24rpx;
  overflow-y: auto;
  box-sizing: border-box;
}

.pub-full-card--fit {
  padding: 16rpx;
  margin-bottom: 0;
}

.pub-full-head {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding-left: 24rpx;
  padding-right: 24rpx;
  padding-bottom: 12rpx;
  box-sizing: border-box;
}

.pub-full-back {
  flex-shrink: 0;
  font-size: 30rpx;
  color: #4f46e5;
  font-weight: 700;
}

.pub-full-title {
  flex: 1;
  font-size: 34rpx;
  font-weight: 800;
  color: #1e1b2e;
}

.pub-full-scroll {
  flex: 1;
  height: 0;
  min-height: 0;
  width: 100%;
}

.pub-full-body {
  padding: 0 24rpx 40rpx;
  box-sizing: border-box;
}

.pub-full-hint {
  display: block;
  font-size: 24rpx;
  color: #64748b;
  margin-bottom: 16rpx;
}

.pub-full-card {
  background: rgba(255, 255, 255, 0.94);
  border-radius: 20rpx;
  border: 1rpx solid rgba(199, 210, 254, 0.55);
  box-shadow: 0 10rpx 36rpx rgba(79, 70, 229, 0.08);
  padding: 20rpx;
  box-sizing: border-box;
}

.pub-full-card--pad {
  padding: 20rpx;
}

.pub-full-opt {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 16rpx;
  padding: 28rpx 24rpx;
  font-size: 30rpx;
  font-weight: 600;
  color: #1e293b;
  background: rgba(255, 255, 255, 0.92);
  border-radius: 16rpx;
  border: 2rpx solid rgba(226, 232, 240, 0.9);
  box-shadow: 0 6rpx 24rpx rgba(99, 102, 241, 0.07);
  box-sizing: border-box;
}

.pub-full-opt__icon {
  width: 44rpx;
  height: 44rpx;
  flex-shrink: 0;
  border-radius: 10rpx;
}

.pub-full-opt__name {
  flex: 1;
  min-width: 0;
}

.pub-full-opt--on {
  color: #4f46e5;
  background: var(--lq-primary-50);
  border-color: #a5b4fc;
}

.pub-full-fee-row {
  margin-bottom: 16rpx;
  padding: 24rpx;
  background: rgba(255, 255, 255, 0.92);
  border-radius: 16rpx;
  border: 2rpx solid rgba(226, 232, 240, 0.85);
  box-shadow: 0 6rpx 24rpx rgba(99, 102, 241, 0.06);
  box-sizing: border-box;
}

.pub-full-fee-row--on {
  background: var(--lq-primary-50);
  border-color: #93c5fd;
}

.pub-full-foot {
  flex-shrink: 0;
  padding: 16rpx 24rpx calc(24rpx + env(safe-area-inset-bottom));
  background: linear-gradient(180deg, rgba(250, 248, 255, 0) 0%, #f0eeff 50%);
}

.pub-full-btn {
  width: 100%;
}

.pub-full-btn::after {
  border: none;
}

.pub-city-dual--full {
  height: 480rpx;
}

.pub-city-dual--full .pub-city-prov-scroll,
.pub-city-dual--full .pub-city-list-scroll {
  height: 480rpx;
}

.pub-full--apply-form {
  height: 100vh;
}

.pub-full--apply-form .pub-full-scroll {
  flex: 1;
  min-height: 0;
}

.pub-full--apply-form .tpl-edit-footer {
  flex-shrink: 0;
  position: relative;
}

.pub-apply-body {
  padding-bottom: 24rpx;
}

.pub-apply-tpl-scroll {
  white-space: nowrap;
  margin-bottom: 20rpx;
}

.pub-apply-tpl-chip {
  display: inline-flex;
  flex-direction: column;
  align-items: flex-start;
  padding: 16rpx 24rpx;
  margin-right: 16rpx;
  border-radius: 16rpx;
  background: #fff;
  border: 2rpx solid #e2e8f0;
  font-size: 24rpx;
  color: #334155;
  vertical-align: top;
}

.pub-apply-tpl-chip--on {
  border-color: #6366f1;
  background: var(--lq-primary-50);
  color: #4338ca;
  font-weight: 600;
}

.pub-apply-tpl-chip-sub {
  font-size: 20rpx;
  color: #94a3b8;
  margin-top: 4rpx;
}

.pub-apply-footer {
  position: relative;
  z-index: 110;
}

.pub-apply-tpl-modal {
  position: fixed;
  left: 48rpx;
  right: 48rpx;
  top: 50%;
  transform: translateY(-50%);
  max-height: 70vh;
  background: #fff;
  border-radius: 24rpx;
  padding: 32rpx;
  z-index: 210;
  display: flex;
  flex-direction: column;
}

.pub-apply-tpl-modal-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #0f172a;
  margin-bottom: 20rpx;
}

.pub-apply-tpl-modal-scroll {
  flex: 1;
  max-height: 48vh;
}

.pub-apply-tpl-modal-item {
  padding: 24rpx 0;
  border-bottom: 2rpx solid #f1f5f9;
}

.pub-apply-tpl-modal-name {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: #0f172a;
}

.pub-apply-tpl-modal-sub {
  display: block;
  font-size: 22rpx;
  color: #94a3b8;
  margin-top: 6rpx;
}

.pub-apply-tpl-modal-cancel {
  margin-top: 24rpx;
  width: 100%;
}

.pub-cover-hint {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  color: rgba(71, 85, 105, 0.85);
}

.pub-cover-preview-wrap {
  position: relative;
  width: 100%;
  margin-top: 16rpx;
  padding-top: 80%;
  border-radius: 16rpx;
  overflow: hidden;
  background: rgba(255, 255, 255, 0.6);
}

.pub-cover-preview {
  position: absolute;
  left: 0;
  top: 0;
  display: block;
  width: 100%;
  height: 100%;
  border-radius: 16rpx;
}

.pub-qr-preview {
  width: 280rpx;
  height: 280rpx;
  margin-left: auto;
  margin-right: auto;
}

.pub-cover-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 16rpx;
}

.pub-cover-btn {
  margin: 0;
  padding: 0 24rpx;
  height: 64rpx;
  line-height: 64rpx;
  font-size: 24rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.85);
  color: #4338ca;
  border: 1rpx solid rgba(99, 102, 241, 0.25);
}

.pub-cover-btn--ghost {
  color: #64748b;
  border-color: rgba(100, 116, 139, 0.25);
}

.pub-cover-btn--on {
  background: #4338ca;
  color: #fff;
  border-color: #4338ca;
}

.pub-cover-btn--ai {
  margin-top: 16rpx;
  width: 100%;
  background: #4338ca;
  color: #fff;
  border-color: #4338ca;
}

.pub-cover-ai {
  margin-top: 16rpx;
  padding: 16rpx;
  border-radius: 16rpx;
  background: rgba(248, 250, 252, 0.92);
  border: 1rpx solid rgba(99, 102, 241, 0.18);
}

.pub-cover-ai-hint {
  display: block;
  margin-bottom: 12rpx;
  font-size: 22rpx;
  color: rgba(71, 85, 105, 0.85);
  line-height: 1.45;
}

.pub-cover-ai-input {
  min-height: 120rpx;
  height: 120rpx;
}

.pub-cover-ai-ref {
  display: block;
  width: 160rpx;
  height: 160rpx;
  margin-top: 12rpx;
  border-radius: 12rpx;
  background: #e2e8f0;
}

.pub-cover-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
  padding: 24rpx;
}

.pub-cover-cell {
  overflow: hidden;
  border-radius: 16rpx;
  border: 2rpx solid transparent;
  background: rgba(255, 255, 255, 0.9);
}

.pub-cover-cell--on {
  border-color: var(--lq-primary-dark);
}

.pub-cover-cell-img {
  display: block;
  width: 100%;
  height: 200rpx;
}

.pub-cover-cell-label {
  display: block;
  padding: 12rpx 16rpx;
  font-size: 22rpx;
  color: #475569;
}

.pub-cover-tabs {
  display: flex;
  gap: 12rpx;
  padding: 0 24rpx 16rpx;
  position: relative;
  z-index: 2;
}

.pub-cover-tab {
  padding: 10rpx 24rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  color: #64748b;
  background: rgba(255, 255, 255, 0.75);
}

.pub-cover-tab--on {
  color: #fff;
  background: var(--lq-primary-dark);
}

.pub-cover-sub-scroll {
  white-space: nowrap;
  padding: 0 0 12rpx;
  position: relative;
  z-index: 2;
}

.pub-cover-sub-row {
  display: inline-flex;
  gap: 12rpx;
  padding: 0 24rpx;
}

.pub-cover-sub {
  display: inline-block;
  padding: 8rpx 20rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  color: #64748b;
  background: rgba(255, 255, 255, 0.7);
}

.pub-cover-sub--on {
  color: #fff;
  background: #0891b2;
}

.pub-full-scroll--cover {
  flex: 1;
  min-height: 0;
}

.pub-linke-card {
  margin: 16rpx 0 24rpx;
  padding: 24rpx;
  border-radius: 20rpx;
  border: 1rpx solid rgba(124, 58, 237, 0.25);
  background: linear-gradient(180deg, rgba(245, 243, 255, 0.95), rgba(255, 255, 255, 0.98));
}

.pub-linke-head {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 8rpx;
}

.pub-linke-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #4c1d95;
}

.pub-linke-tag {
  font-size: 20rpx;
  color: #64748b;
}

.pub-linke-hint {
  display: block;
  font-size: 22rpx;
  color: #64748b;
  line-height: 1.5;
  margin-bottom: 16rpx;
}

.pub-linke-empty {
  font-size: 24rpx;
  color: #b45309;
  background: #fffbeb;
  border-radius: 12rpx;
  padding: 16rpx;
}

.pub-linke-link {
  color: #7c3aed;
  text-decoration: underline;
  margin-left: 8rpx;
}

.pub-linke-sync {
  display: inline-block;
  margin-top: 12rpx;
  margin-left: 0;
  color: #7c83ff;
  font-weight: 600;
}

.pub-linke-client-list {
  max-height: 280rpx;
  overflow-y: auto;
  border: 1rpx solid #e2e8f0;
  border-radius: 12rpx;
  margin-bottom: 16rpx;
}

.pub-linke-client-row {
  padding: 16rpx 20rpx;
  border-bottom: 1rpx solid #f1f5f9;
}

.pub-linke-client-row--on {
  background: #ede9fe;
}

.pub-linke-client-name {
  display: block;
  font-size: 26rpx;
  color: #1e293b;
}

.pub-linke-client-id {
  display: block;
  font-size: 22rpx;
  color: #64748b;
  margin-top: 4rpx;
}

.pub-linke-search-row {
  display: flex;
  gap: 12rpx;
  align-items: center;
}

.pub-linke-search-input {
  flex: 1;
}

.pub-linke-search-btn {
  font-size: 24rpx;
  padding: 0 20rpx;
  line-height: 72rpx;
  height: 72rpx;
  margin: 0;
  background: #fff;
  border: 1rpx solid #cbd5e1;
  border-radius: 12rpx;
}

.pub-linke-product-chips {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 12rpx;
}

.pub-linke-chip {
  font-size: 22rpx;
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  border: 1rpx solid #cbd5e1;
  background: #fff;
  max-width: 100%;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.pub-linke-chip--on {
  background: #7c3aed;
  color: #fff;
  border-color: #7c3aed;
}

.pub-linke-selected {
  display: block;
  margin-top: 12rpx;
  font-size: 22rpx;
  color: #047857;
}
