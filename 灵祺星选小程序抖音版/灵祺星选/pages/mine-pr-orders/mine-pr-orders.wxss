@import '../../styles/theme.wxss';
@import '../../styles/identity-themes.wxss';

.pr-tab-scroll {
  width: 100%;
  white-space: nowrap;
}

.pr-tab-bar {
  display: inline-flex;
  gap: 12rpx;
  padding: 16rpx 0 8rpx;
  min-width: 100%;
}

.pr-tab-chip {
  flex: 0 0 auto;
  min-width: 148rpx;
  text-align: center;
  padding: 16rpx 20rpx;
  font-size: 24rpx;
  color: #64748b;
  background: #fff;
  border: 1rpx solid var(--lq-primary-100);
  border-radius: 999rpx;
  box-shadow: var(--lq-shadow-soft);
}

.pr-tab-chip--on {
  color: #fff;
  background: var(--lq-gradient-tab);
  border-color: var(--lq-primary);
  font-weight: 600;
}

.pr-tab-count {
  margin-left: 4rpx;
  font-size: 22rpx;
  opacity: 0.85;
}

.pr-list-toolbar {
  flex-shrink: 0;
  padding-top: 16rpx;
  margin-bottom: 8rpx;
}

.pr-search-bar {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin: 0 0 12rpx;
  padding: 0 24rpx;
  height: 72rpx;
  box-sizing: border-box;
  background: #fff;
  border-radius: var(--lq-radius-md);
  border: 1rpx solid var(--lq-primary-100);
  box-shadow: var(--lq-shadow-soft);
}

.pr-search-icon {
  flex-shrink: 0;
  font-size: 32rpx;
  color: #9ca3af;
  line-height: 1;
}

.pr-search-input {
  flex: 1;
  min-width: 0;
  height: 72rpx;
  min-height: 72rpx;
  line-height: 72rpx;
  font-size: 28rpx;
  padding: 0;
  margin: 0;
  background: transparent;
  border: none;
  box-sizing: border-box;
}

.pr-search-ph {
  color: #9ca3af;
  font-size: 26rpx;
}

.pr-target-scroll {
  width: 100%;
  margin-bottom: 12rpx;
  white-space: nowrap;
}

.pr-target-row {
  display: inline-flex;
  gap: 12rpx;
  padding: 4rpx 0;
}

.pr-target-chip {
  display: inline-block;
  padding: 10rpx 24rpx;
  font-size: 24rpx;
  color: #64748b;
  background: #fff;
  border: 1rpx solid var(--lq-primary-100);
  border-radius: 999rpx;
}

.pr-target-chip--on {
  color: #fff;
  background: var(--lq-gradient-tab);
  border-color: var(--lq-primary);
}

.pr-filter-scroll {
  width: 100%;
  margin-bottom: 8rpx;
  white-space: nowrap;
}

.pr-filter-bar {
  display: flex;
  align-items: stretch;
  margin-bottom: 8rpx;
  padding: 8rpx 0;
  background: var(--lq-gradient-filter);
  border-radius: var(--lq-radius-md);
  border: 1rpx solid var(--lq-primary-100);
  box-shadow: var(--lq-shadow-card);
}

.pr-filter-bar--inline {
  display: inline-flex;
  align-items: stretch;
  width: max-content;
  min-width: 710rpx;
  margin-bottom: 0;
  padding: 8rpx 20rpx 8rpx 4rpx;
  box-sizing: border-box;
}

.pr-filter-bar--inline .pr-filter-cell {
  flex: 0 0 138rpx;
  width: 138rpx;
  min-width: 138rpx;
}

.pr-filter-cell {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  border-right: 1rpx solid var(--lq-border);
}

.pr-filter-cell:last-child {
  border-right: none;
}

.pr-filter-cell picker {
  width: 100%;
  display: block;
}

.pr-filter-item {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 2rpx;
  width: 100%;
  box-sizing: border-box;
  padding: 12rpx 6rpx;
  font-size: 22rpx;
  color: #64748b;
}

.pr-filter-item--on {
  color: var(--lq-primary-dark);
  font-weight: 600;
}

.pr-filter-item--on .pr-filter-arrow {
  color: var(--lq-primary);
}

.pr-filter-label {
  flex: 1;
  min-width: 0;
  max-width: 108rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  text-align: center;
  line-height: 1.2;
}

.pr-filter-arrow {
  flex-shrink: 0;
  font-size: 18rpx;
  color: #9ca3af;
  line-height: 1;
}

.pr-filter-bar--sub {
  margin-top: 8rpx;
}

.pr-filter-count {
  display: block;
  font-size: 22rpx;
  color: #94a3b8;
  padding: 0 4rpx 8rpx;
}

.pr-order-card {
  position: relative;
  padding: 28rpx 28rpx 24rpx;
  border: 1rpx solid var(--lq-primary-100);
  box-shadow: 0 8rpx 28rpx rgba(15, 23, 42, 0.06);
}

.pr-order-card--muted {
  opacity: 0.82;
}

.pr-draft-card {
  border-color: rgba(245, 158, 11, 0.28);
}

.pr-order-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-bottom: 12rpx;
}

.pr-tag {
  font-size: 20rpx;
  color: #64748b;
  background: #f1f5f9;
  padding: 6rpx 14rpx;
  border-radius: 999rpx;
}

.pr-tag--hall {
  color: var(--lq-primary-dark);
  background: var(--lq-primary-50);
}

.pr-tag--warn {
  color: #b45309;
  background: #fef3c7;
}

.pr-tag--draft {
  color: #d97706;
  background: #fff7ed;
}

.pr-order-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
}

.pr-order-title {
  flex: 1;
  min-width: 0;
  font-size: 32rpx;
  font-weight: 700;
  color: #0f172a;
  line-height: 1.35;
}

.pr-order-meta-line {
  display: block;
  margin-top: 12rpx;
  font-size: 22rpx;
  color: #94a3b8;
  line-height: 1.5;
}

.pr-order-archived-hint {
  display: block;
  margin-top: 20rpx;
  font-size: 22rpx;
  color: #94a3b8;
}

.pr-empty-sub {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #cbd5e1;
}

.pr-state-card {
  margin-top: 12rpx;
}

.pr-state-card--warn .hint {
  color: #d97706;
}

.pr-order-status {
  flex-shrink: 0;
  font-size: 22rpx;
  font-weight: 600;
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
  background: #f1f5f9;
  color: #64748b;
}

.pr-order-status--on {
  background: #ecfdf5;
  color: #059669;
}

.pr-order-status--off {
  background: #fef2f2;
  color: #dc2626;
}

.pr-order-deadline {
  display: block;
  margin-top: 8rpx;
  color: var(--lq-primary);
  font-weight: 500;
}

.pr-order-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 20rpx;
}

.pr-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 12rpx 22rpx;
  font-size: 24rpx;
  font-weight: 600;
  border-radius: 999rpx;
  line-height: 1.2;
}

.pr-btn-count {
  margin-left: 4rpx;
  opacity: 0.85;
}

.pr-btn--primary {
  color: #fff;
  background: var(--lq-gradient);
}

.pr-btn--outline {
  color: var(--lq-primary-dark);
  background: #fff;
  border: 1rpx solid var(--lq-primary-100);
}

.pr-btn--amber {
  color: #b45309;
  background: #fff;
  border: 1rpx solid rgba(245, 158, 11, 0.35);
}

.pr-btn--amber-hot {
  color: #78350f;
  border-color: rgba(180, 83, 9, 0.55);
  font-weight: 700;
}

.pr-btn--ghost {
  color: #475569;
  background: #fff;
  border: 1rpx solid #e2e8f0;
}

.pr-btn--danger {
  color: #dc2626;
  background: #fff;
  border: 1rpx solid rgba(220, 38, 38, 0.35);
}

.pr-order-action {
  font-size: 26rpx;
  color: var(--lq-primary);
  font-weight: 600;
  padding: 8rpx 0;
}

.pr-order-action--danger {
  color: #dc2626;
}

.pr-order-meta {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid var(--lq-border, #e2e8f0);
}

.pr-order-badge {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--lq-primary-dark);
  background: var(--lq-primary-50);
  padding: 8rpx 20rpx;
  border-radius: 999rpx;
}

.pr-order-meta-right {
  display: flex;
  align-items: center;
  gap: 16rpx;
  flex-wrap: wrap;
  justify-content: flex-end;
}

.pr-order-link {
  font-size: 26rpx;
  color: var(--lq-primary);
  font-weight: 600;
}

.pr-order-link--video {
  color: #d97706;
}

.pr-order-link--pending {
  color: #78350f;
  font-weight: 700;
}

.pr-share-sheet-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 10000;
  background: rgba(53, 50, 74, 0.32);
  display: flex;
  align-items: flex-end;
}

.pr-share-sheet {
  width: 100%;
  padding: 28rpx 28rpx calc(28rpx + env(safe-area-inset-bottom));
  background: #fff;
  border-radius: 32rpx 32rpx 0 0;
  box-shadow: 0 -12rpx 48rpx rgba(15, 23, 42, 0.12);
}

.pr-share-sheet-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 8rpx;
}

.pr-share-sheet-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #0f172a;
}

.pr-share-sheet-close {
  font-size: 44rpx;
  color: #94a3b8;
  line-height: 1;
  padding: 0 8rpx;
}

.pr-share-sheet-sub {
  display: block;
  font-size: 24rpx;
  color: #64748b;
  margin-bottom: 20rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.pr-share-sheet-item {
  display: block;
  width: 100%;
  box-sizing: border-box;
  padding: 28rpx 8rpx;
  font-size: 30rpx;
  font-weight: 600;
  color: #0f172a;
  text-align: center;
  border-top: 1rpx solid #e2e8f0;
}

.pr-share-sheet-btn {
  margin: 0;
  background: #fff;
  border: none;
  border-radius: 0;
  line-height: 1.4;
}

.pr-share-sheet-btn::after {
  border: none;
}

.pr-share-sheet-cancel {
  margin-top: 12rpx;
  padding: 28rpx 8rpx;
  font-size: 30rpx;
  color: #64748b;
  text-align: center;
  border-top: 12rpx solid #f1f5f9;
}

.pr-share-tabs {
  display: flex;
  gap: 8rpx;
  margin: 16rpx 0 8rpx;
  border-bottom: 1rpx solid #e2e8f0;
}

.pr-share-tab {
  flex: 1;
  text-align: center;
  padding: 16rpx 8rpx 20rpx;
  font-size: 26rpx;
  color: #64748b;
  border-bottom: 4rpx solid transparent;
}

.pr-share-tab-active {
  color: var(--lq-primary-dark);
  font-weight: 700;
  border-bottom-color: var(--lq-primary);
}

.pr-share-panel {
  padding-top: 8rpx;
}

.pr-share-poster-panel {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 12rpx 0 0;
}

.pr-share-poster-loading {
  width: 420rpx;
  height: 672rpx;
  border-radius: 24rpx;
  background: #f1f5f9;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  color: #64748b;
  margin-bottom: 12rpx;
}

.pr-share-poster-img {
  width: 420rpx;
  border-radius: 24rpx;
  box-shadow: 0 8rpx 32rpx rgba(15, 23, 42, 0.12);
  margin-bottom: 8rpx;
}

.pr-share-poster-err {
  font-size: 26rpx;
  color: #d97706;
  padding: 40rpx 16rpx;
}

.pr-share-poster-save {
  color: var(--lq-primary-dark);
}

.pr-share-poster-style-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  width: 420rpx;
  margin: 8rpx 0 12rpx;
  padding: 0 8rpx;
}

.pr-share-poster-style-label {
  font-size: 22rpx;
  color: #94a3b8;
}

.pr-share-poster-style-btn {
  font-size: 26rpx;
  color: var(--lq-primary-dark);
  font-weight: 600;
  padding: 8rpx 0;
}

.pr-share-link-label {
  display: block;
  font-size: 22rpx;
  color: #94a3b8;
  padding: 16rpx 8rpx 8rpx;
}

.pr-share-link-text {
  display: block;
  font-size: 24rpx;
  color: #0f172a;
  word-break: break-all;
  padding: 0 8rpx 16rpx;
  line-height: 1.5;
}
