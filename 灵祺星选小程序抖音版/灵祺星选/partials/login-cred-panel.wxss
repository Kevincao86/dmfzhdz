.cred-check-row {
  padding: 8rpx 0;
}

.cred-check-label {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
  font-size: 28rpx;
  color: #374151;
  line-height: 1.5;
}

.cred-ready-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  padding: 8rpx 0;
}

.cred-ready-text {
  font-size: 28rpx;
  font-weight: 600;
  color: #047857;
}

.cred-edit-btn {
  margin: 0;
  padding: 0 28rpx;
  height: 56rpx;
  line-height: 56rpx;
  font-size: 24rpx;
  font-weight: 600;
  color: var(--lq-primary-dark);
  background: var(--lq-primary-50);
  border: 2rpx solid var(--lq-primary-100);
  border-radius: 999rpx;
}

.cred-edit-btn::after {
  border: none;
}

.cred-modal-mask {
  position: fixed;
  inset: 0;
  background: rgba(15, 23, 42, 0.45);
  z-index: 200;
}

.cred-modal {
  position: fixed;
  left: 32rpx;
  right: 32rpx;
  top: 50%;
  transform: translateY(-50%);
  background: #fff;
  border-radius: 24rpx;
  padding: 32rpx;
  z-index: 201;
  box-shadow: 0 24rpx 48rpx rgba(15, 23, 42, 0.12);
}

.cred-modal-title {
  display: block;
  font-size: 32rpx;
  font-weight: 700;
  margin-bottom: 24rpx;
  color: #0f172a;
}

.cred-modal-err {
  display: block;
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #dc2626;
}

.cred-modal-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 28rpx;
}

.cred-modal-btn {
  flex: 1;
  margin: 0;
  height: 80rpx;
  line-height: 80rpx;
  font-size: 28rpx;
  font-weight: 600;
  border-radius: 999rpx;
  color: #4b5563;
  background: #f3f4f6;
}

.cred-modal-btn::after {
  border: none;
}

.cred-modal-btn--primary {
  color: #fff;
  background: var(--lq-gradient);
}
