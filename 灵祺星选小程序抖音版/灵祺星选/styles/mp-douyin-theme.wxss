/**
 * 抖音星选：统一薰衣草紫顶栏（与欢迎页 welcome-hero 一致）
 */
page {
  --lq-primary: #7c83ff;
  --lq-primary-dark: #6d28d9;
  --lq-primary-deep: #6d28d9;
  --lq-nav-bar: #9b87f5;
  --lq-primary-soft: #a5abff;
  --lq-primary-50: #f3f1ff;
  --lq-primary-100: #e8e4ff;
  --lq-violet: #b794f6;
  --lq-magenta: #f0abfc;
  --lq-gradient: linear-gradient(135deg, #7c6fe8 0%, #9b87f5 52%, #c4b5fd 100%);
  --lq-gradient-header: linear-gradient(165deg, #5b4fcf 0%, #7c6fe8 38%, #9b87f5 72%, #c4b5fd 100%);
  --lq-gradient-deep: linear-gradient(165deg, #7c83ff 0%, #a78bfa 55%, #f0abfc 100%);
  --lq-gradient-tab: linear-gradient(135deg, #8b93ff 0%, #b794f6 55%, #f0abfc 100%);
  --lq-gradient-tab-track: linear-gradient(90deg, #f3f1ff 0%, #fdf4ff 50%, #fff7ed 100%);
  --lq-gradient-filter: linear-gradient(180deg, #ffffff 0%, #faf8ff 100%);
  --lq-bg: #faf7ff;
  --lq-border: rgba(216, 208, 240, 0.95);
  --lq-shadow: 0 12rpx 0 rgba(199, 186, 255, 0.35);
  --lq-shadow-card: 0 10rpx 0 rgba(216, 200, 255, 0.42);
  --lq-shadow-soft: 0 8rpx 28rpx rgba(139, 147, 255, 0.12);
  --lq-shadow-header: 0 14rpx 0 rgba(183, 148, 246, 0.28);
  --lq-shadow-tab: 0 6rpx 0 rgba(183, 148, 246, 0.38);
  --lq-chip-on-bg: #f3f0ff;
  --lq-chip-on-border: #ddd6fe;
  --lq-active-tint: rgba(124, 58, 237, 0.14);
}

