/**
 * 身份主题 CSS 变量（与星选 Web index.css data-work-identity 对齐）
 * 挂在页面根 view 的 lq-theme-* class 上，子组件继承 var(--lq-*)
 */
@import './theme.wxss';

.lq-theme-talent {
  --lq-primary: #7c4dff;
  --lq-primary-dark: #5b3fd4;
  --lq-primary-deep: #5b3fd4;
  --lq-nav-bar: #7c4dff;
  --lq-primary-soft: #a78bfa;
  --lq-primary-50: #f3eeff;
  --lq-primary-100: #e4d9ff;
  --lq-violet: #7c4dff;
  --lq-gradient: linear-gradient(180deg, #7c4dff 0%, #7c4dff 100%);
  --lq-gradient-header: linear-gradient(180deg, #7c4dff 0%, #7c4dff 100%);
  --lq-gradient-deep: linear-gradient(180deg, #5b3fd4 0%, #7c4dff 100%);
  --lq-gradient-tab: linear-gradient(180deg, #7c4dff 0%, #7c4dff 100%);
  --lq-gradient-tab-track: linear-gradient(90deg, #f3eeff 0%, #f7f6fb 100%);
  --lq-gradient-filter: linear-gradient(180deg, #ffffff 0%, #f7f6fb 100%);
  --lq-bg: #f7f6fb;
  --lq-border: rgba(124, 77, 255, 0.16);
  --lq-shadow: 0 8rpx 28rpx rgba(20, 24, 31, 0.04);
  --lq-shadow-card: 0 8rpx 24rpx rgba(20, 24, 31, 0.04);
  --lq-shadow-soft: 0 8rpx 28rpx rgba(124, 77, 255, 0.1);
  --lq-shadow-header: none;
  --lq-shadow-tab: none;
  --lq-chip-on-bg: #f3eeff;
  --lq-chip-on-border: #c4b5fd;
  --lq-active-tint: rgba(124, 77, 255, 0.12);
  --lq-home-nav: #7c4dff;
  --lq-home-bg: #f7f6fb;
  --lq-home-banner: linear-gradient(180deg, #7c4dff 0%, #7c4dff 100%);
}

.lq-theme-shoot {
  --lq-primary: #5b67f1;
  --lq-primary-dark: #3f4ad4;
  --lq-primary-deep: #3f4ad4;
  --lq-nav-bar: #5b67f1;
  --lq-primary-soft: #a5b0ff;
  --lq-primary-50: #eef0ff;
  --lq-primary-100: #dde1ff;
  --lq-violet: #5b67f1;
  --lq-gradient: linear-gradient(180deg, #5b67f1 0%, #5b67f1 100%);
  --lq-gradient-header: linear-gradient(180deg, #5b67f1 0%, #5b67f1 100%);
  --lq-gradient-deep: linear-gradient(180deg, #3f4ad4 0%, #5b67f1 100%);
  --lq-gradient-tab: linear-gradient(180deg, #5b67f1 0%, #5b67f1 100%);
  --lq-gradient-tab-track: linear-gradient(90deg, #eef0ff 0%, #f7f6fb 100%);
  --lq-gradient-filter: linear-gradient(180deg, #ffffff 0%, #f7f6fb 100%);
  --lq-bg: #f7f6fb;
  --lq-border: rgba(91, 103, 241, 0.16);
  --lq-shadow: 0 8rpx 28rpx rgba(20, 24, 31, 0.04);
  --lq-shadow-card: 0 8rpx 24rpx rgba(20, 24, 31, 0.04);
  --lq-shadow-soft: 0 8rpx 28rpx rgba(91, 103, 241, 0.1);
  --lq-shadow-header: none;
  --lq-shadow-tab: none;
  --lq-chip-on-bg: #eef0ff;
  --lq-chip-on-border: #c7cdff;
  --lq-active-tint: rgba(91, 103, 241, 0.12);
  --lq-home-nav: #5b67f1;
  --lq-home-bg: #f7f6fb;
  --lq-home-banner: linear-gradient(180deg, #5b67f1 0%, #5b67f1 100%);
}

