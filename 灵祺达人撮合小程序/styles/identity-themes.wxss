/**
 * 身份主题 CSS 变量（与星选 Web index.css data-work-identity 对齐）
 * 挂在页面根 view 的 lq-theme-* class 上，子组件继承 var(--lq-*)
 */
@import './theme.wxss';

.lq-theme-talent {
  --lq-primary: #0284c7;
  --lq-primary-dark: #0369a1;
  --lq-primary-deep: #0369a1;
  --lq-nav-bar: #0284c7;
  --lq-primary-soft: #38bdf8;
  --lq-primary-50: #e0f2fe;
  --lq-primary-100: #bae6fd;
  --lq-violet: #38bdf8;
  --lq-gradient: linear-gradient(135deg, #0369a1 0%, #0284c7 52%, #38bdf8 100%);
  --lq-gradient-header: linear-gradient(145deg, #075985 0%, #0284c7 38%, #38bdf8 72%, #7dd3fc 100%);
  --lq-gradient-deep: linear-gradient(165deg, #0369a1 0%, #0284c7 55%, #38bdf8 100%);
  --lq-gradient-tab: linear-gradient(135deg, #0284c7 0%, #38bdf8 55%, #7dd3fc 100%);
  --lq-gradient-tab-track: linear-gradient(90deg, #e0f2fe 0%, #f0f9ff 50%, #fff7ed 100%);
  --lq-gradient-filter: linear-gradient(180deg, #ffffff 0%, #e8eef4 100%);
  --lq-bg: #e8eef4;
  --lq-border: rgba(197, 208, 220, 0.95);
  --lq-shadow: 0 8rpx 28rpx rgba(20, 24, 31, 0.06);
  --lq-shadow-card: 0 8rpx 24rpx rgba(20, 24, 31, 0.06);
  --lq-shadow-soft: 0 8rpx 28rpx rgba(2, 132, 199, 0.12);
  --lq-shadow-header: 0 8rpx 24rpx rgba(3, 105, 161, 0.16);
  --lq-shadow-tab: 0 6rpx 16rpx rgba(2, 132, 199, 0.18);
  --lq-chip-on-bg: #e0f2fe;
  --lq-chip-on-border: #7dd3fc;
  --lq-active-tint: rgba(2, 132, 199, 0.14);
  --lq-home-nav: #0284c7;
  --lq-home-bg: #e8eef4;
  --lq-home-banner: linear-gradient(135deg, #0369a1 0%, #0284c7 52%, #38bdf8 100%);
}

.lq-theme-shoot {
  --lq-primary: #0ea5e9;
  --lq-primary-dark: #0369a1;
  --lq-primary-deep: #0369a1;
  --lq-nav-bar: #0ea5e9;
  --lq-primary-soft: #38bdf8;
  --lq-primary-50: #e0f2fe;
  --lq-primary-100: #bae6fd;
  --lq-violet: #38bdf8;
  --lq-gradient: linear-gradient(135deg, #0369a1 0%, #0ea5e9 52%, #38bdf8 100%);
  --lq-gradient-header: linear-gradient(145deg, #0369a1 0%, #0ea5e9 38%, #38bdf8 72%, #7dd3fc 100%);
  --lq-gradient-deep: linear-gradient(165deg, #0369a1 0%, #0ea5e9 55%, #38bdf8 100%);
  --lq-gradient-tab: linear-gradient(135deg, #0ea5e9 0%, #38bdf8 55%, #7dd3fc 100%);
  --lq-gradient-tab-track: linear-gradient(90deg, #e0f2fe 0%, #f0f9ff 50%, #ecfeff 100%);
  --lq-gradient-filter: linear-gradient(180deg, #ffffff 0%, #e8eef4 100%);
  --lq-bg: #e8eef4;
  --lq-border: rgba(197, 208, 220, 0.95);
  --lq-shadow: 0 8rpx 28rpx rgba(20, 24, 31, 0.06);
  --lq-shadow-card: 0 8rpx 24rpx rgba(20, 24, 31, 0.06);
  --lq-shadow-soft: 0 8rpx 28rpx rgba(14, 165, 233, 0.12);
  --lq-shadow-header: 0 8rpx 24rpx rgba(3, 105, 161, 0.16);
  --lq-shadow-tab: 0 6rpx 16rpx rgba(14, 165, 233, 0.18);
  --lq-chip-on-bg: #e0f2fe;
  --lq-chip-on-border: #7dd3fc;
  --lq-active-tint: rgba(14, 165, 233, 0.14);
  --lq-home-nav: #0ea5e9;
  --lq-home-bg: #e8eef4;
  --lq-home-banner: linear-gradient(135deg, #0369a1 0%, #0ea5e9 52%, #38bdf8 100%);
}

.lq-theme-edit {
  --lq-primary: #14b8a6;
  --lq-primary-dark: #0f766e;
  --lq-primary-deep: #0f766e;
  --lq-nav-bar: #14b8a6;
  --lq-primary-soft: #2dd4bf;
  --lq-primary-50: #ccfbf1;
  --lq-primary-100: #99f6e4;
  --lq-violet: #2dd4bf;
  --lq-gradient: linear-gradient(135deg, #0f766e 0%, #14b8a6 52%, #2dd4bf 100%);
  --lq-gradient-header: linear-gradient(145deg, #0f766e 0%, #14b8a6 38%, #2dd4bf 72%, #5eead4 100%);
  --lq-gradient-deep: linear-gradient(165deg, #0f766e 0%, #14b8a6 55%, #2dd4bf 100%);
  --lq-gradient-tab: linear-gradient(135deg, #14b8a6 0%, #2dd4bf 55%, #5eead4 100%);
  --lq-gradient-tab-track: linear-gradient(90deg, #ccfbf1 0%, #f0fdfa 50%, #ecfeff 100%);
  --lq-gradient-filter: linear-gradient(180deg, #ffffff 0%, #e8eef4 100%);
  --lq-bg: #e8eef4;
  --lq-border: rgba(153, 246, 228, 0.9);
  --lq-shadow: 0 8rpx 28rpx rgba(20, 24, 31, 0.06);
  --lq-shadow-card: 0 8rpx 24rpx rgba(20, 24, 31, 0.06);
  --lq-shadow-soft: 0 8rpx 28rpx rgba(20, 184, 166, 0.12);
  --lq-shadow-header: 0 8rpx 24rpx rgba(15, 118, 110, 0.16);
  --lq-shadow-tab: 0 6rpx 16rpx rgba(20, 184, 166, 0.18);
  --lq-chip-on-bg: #ccfbf1;
  --lq-chip-on-border: #5eead4;
  --lq-active-tint: rgba(20, 184, 166, 0.14);
  --lq-home-nav: #14b8a6;
  --lq-home-bg: #e8eef4;
  --lq-home-banner: linear-gradient(135deg, #0f766e 0%, #14b8a6 52%, #2dd4bf 100%);
}

.lq-theme-pr {
  --lq-primary: #7c3aed;
  --lq-primary-dark: #6d28d9;
  --lq-primary-deep: #6d28d9;
  --lq-nav-bar: #7c3aed;
  --lq-primary-soft: #8b5cf6;
  --lq-primary-50: #f3e8ff;
  --lq-primary-100: #e9d5ff;
  --lq-violet: #8b5cf6;
  --lq-gradient: linear-gradient(135deg, #6d28d9 0%, #7c3aed 52%, #8b5cf6 100%);
  --lq-gradient-header: linear-gradient(145deg, #5b21b6 0%, #7c3aed 38%, #8b5cf6 72%, #a78bfa 100%);
  --lq-gradient-deep: linear-gradient(165deg, #6d28d9 0%, #7c3aed 55%, #8b5cf6 100%);
  --lq-gradient-tab: linear-gradient(135deg, #7c3aed 0%, #8b5cf6 55%, #a78bfa 100%);
  --lq-gradient-tab-track: linear-gradient(90deg, #f3e8ff 0%, #fdf4ff 50%, #fff7ed 100%);
  --lq-gradient-filter: linear-gradient(180deg, #ffffff 0%, #e8eef4 100%);
  --lq-bg: #e8eef4;
  --lq-border: rgba(216, 208, 240, 0.95);
  --lq-shadow: 0 8rpx 28rpx rgba(20, 24, 31, 0.06);
  --lq-shadow-card: 0 8rpx 24rpx rgba(20, 24, 31, 0.06);
  --lq-shadow-soft: 0 8rpx 28rpx rgba(124, 58, 237, 0.12);
  --lq-shadow-header: 0 8rpx 24rpx rgba(109, 40, 217, 0.16);
  --lq-shadow-tab: 0 6rpx 16rpx rgba(124, 58, 237, 0.18);
  --lq-chip-on-bg: #f3e8ff;
  --lq-chip-on-border: #ddd6fe;
  --lq-active-tint: rgba(124, 58, 237, 0.14);
  --lq-home-nav: #7c3aed;
  --lq-home-bg: #e8eef4;
  --lq-home-banner: linear-gradient(135deg, #6d28d9 0%, #7c3aed 52%, #8b5cf6 100%);
}
