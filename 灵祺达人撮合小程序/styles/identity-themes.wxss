  --lq-shadow-soft: 0 8rpx 28rpx rgba(155, 109, 255, 0.1);
  --lq-shadow-header: none;
  --lq-shadow-tab: none;
  --lq-chip-on-bg: #f4eeff;
  --lq-chip-on-border: #d4c4ff;
  --lq-active-tint: rgba(155, 109, 255, 0.12);
  --lq-home-nav: #9b6dff;
  --lq-home-bg: #f7f6fb;
  --lq-home-banner: linear-gradient(180deg, #9b6dff 0%, #9b6dff 100%);
}

