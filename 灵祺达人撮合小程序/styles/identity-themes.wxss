  --lq-primary: #9b6dff;
  --lq-primary-dark: #7a4fe0;
  --lq-primary-deep: #7a4fe0;
  --lq-nav-bar: #9b6dff;
  --lq-primary-soft: #c4b5fd;
  --lq-primary-50: #f4eeff;
  --lq-primary-100: #e7dcff;
