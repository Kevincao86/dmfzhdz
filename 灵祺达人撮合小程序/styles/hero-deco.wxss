/* 顶栏装饰：AI + 本地生活意象（光晕 / 圆环 / 浮动标签） */
.lq-hero-bg {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  overflow: hidden;
  pointer-events: none;
  z-index: 0;
}

.lq-hero-bg__glow,
.lq-hero-bg__ring,
.lq-hero-bg__mesh,
.lq-hero-bg__icon {
  z-index: 1;
}

.lq-hero-bg__glow {
  position: absolute;
  border-radius: 50%;
  filter: blur(2rpx);
}

.lq-hero-bg__glow--1 {
  width: 280rpx;
  height: 280rpx;
  top: -80rpx;
  right: -60rpx;
  background: radial-gradient(circle, rgba(251, 191, 36, 0.35) 0%, transparent 68%);
}

.lq-hero-bg__glow--2 {
  width: 220rpx;
  height: 220rpx;
  bottom: -40rpx;
  left: -50rpx;
  background: radial-gradient(circle, rgba(56, 189, 248, 0.28) 0%, transparent 70%);
}

.lq-hero-bg__ring {
  position: absolute;
  border-radius: 50%;
  border: 2rpx solid rgba(255, 255, 255, 0.14);
}

.lq-hero-bg__ring--1 {
  width: 160rpx;
  height: 160rpx;
  top: 20rpx;
  right: 80rpx;
}

.lq-hero-bg__ring--2 {
  width: 100rpx;
  height: 100rpx;
  bottom: 30rpx;
  right: 200rpx;
  border-color: rgba(255, 255, 255, 0.1);
}

.lq-hero-bg__mesh {
  position: absolute;
  right: 0;
  top: 0;
  width: 55%;
  height: 100%;
  opacity: 0.12;
  background-image: radial-gradient(circle at 20% 30%, #fff 1rpx, transparent 1rpx),
    radial-gradient(circle at 60% 70%, #fff 1rpx, transparent 1rpx);
  background-size: 28rpx 28rpx;
}

.lq-hero-bg__icon {
  position: absolute;
  padding: 8rpx 16rpx;
  font-size: 20rpx;
  font-weight: 700;
  color: rgba(255, 255, 255, 0.92);
  background: rgba(255, 255, 255, 0.12);
  border: 1rpx solid rgba(255, 255, 255, 0.22);
  border-radius: 999rpx;
  backdrop-filter: blur(6px);
  letter-spacing: 1rpx;
}

.lq-hero-bg__icon--ai {
  top: 28rpx;
  right: 36rpx;
  background: linear-gradient(135deg, rgba(129, 140, 248, 0.45), rgba(168, 85, 247, 0.35));
}

.lq-hero-bg__icon--clip {
  top: 100rpx;
  right: 24rpx;
  font-size: 18rpx;
}

.lq-hero-bg__icon--shop {
  bottom: 48rpx;
  right: 120rpx;
  background: linear-gradient(135deg, rgba(251, 191, 36, 0.35), rgba(245, 158, 11, 0.25));
}

.lq-hero-bg__icon--pin {
  bottom: 72rpx;
  right: 28rpx;
  font-size: 18rpx;
}

.lq-hero-bg__icon--spark {
  top: 56rpx;
  right: 168rpx;
  width: 44rpx;
  height: 44rpx;
  padding: 0;
  line-height: 44rpx;
  text-align: center;
  border-radius: 50%;
  font-size: 22rpx;
}

.lq-hero-header {
  position: relative;
  overflow: hidden;
  background: var(--lq-gradient-header);
}

.lq-hero-bg__pattern {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  opacity: 0.42;
  z-index: 0;
  background-image:
    radial-gradient(circle at 18% 22%, rgba(255, 255, 255, 0.28) 0, transparent 42%),
    radial-gradient(circle at 72% 68%, rgba(255, 255, 255, 0.18) 0, transparent 38%),
    linear-gradient(135deg, rgba(255, 255, 255, 0.08) 0%, transparent 55%);
}

.lq-hero-header__inner {
  position: relative;
  z-index: 1;
}

/* 渐变标签条（招募大厅 / 推荐分段） */
.lq-gradient-tabs {
  display: flex;
  gap: 10rpx;
  padding: 8rpx;
  background: var(--lq-gradient-tab-track);
  border-radius: var(--lq-radius-md);
  border: 3rpx solid rgba(216, 200, 255, 0.55);
  box-shadow: 0 8rpx 0 rgba(237, 233, 254, 0.65);
}

.lq-gradient-tabs__item {
  position: relative;
  flex: 1;
  text-align: center;
  padding: 18rpx 10rpx 16rpx;
  font-size: 26rpx;
  font-weight: 600;
  color: #64748b;
  border-radius: 18rpx;
}

.lq-gradient-tabs__item--on {
  color: #fff;
  background: var(--lq-gradient-tab);
  box-shadow: var(--lq-shadow-tab);
  font-weight: 700;
}

.lq-gradient-tabs__item--on .lq-gradient-tabs__count {
  color: rgba(255, 255, 255, 0.92);
}

.lq-gradient-tabs__count {
  margin-left: 6rpx;
  font-size: 22rpx;
  color: var(--lq-primary);
  font-weight: 700;
}
