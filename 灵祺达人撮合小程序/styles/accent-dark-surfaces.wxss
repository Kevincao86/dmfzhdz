/* 自选主题的底板。用少量选择器覆盖常见白底，避免主包超限。 */
.lq-accent-on .home-page--v1,
.lq-accent-on .home-hero-shell,
.lq-accent-on .lq-hero-header--home,
.lq-accent-on .paper-page,
.lq-accent-on .xingxuan-page,
.lq-accent-on .mine-page,
.lq-accent-on .msg-page,
.lq-accent-on .addon-page {
  background-color: var(--lq-bg) !important;
}

.lq-accent-on [class*='card'],
.lq-accent-on [class*='input'],
.lq-accent-on [class*='sheet'],
.lq-accent-on [class*='panel'],
.lq-accent-on [class*='modal'],
.lq-accent-on [class*='search'],
.lq-accent-on [class*='chip'],
.lq-accent-on .eval-tab-bar,
.lq-accent-on .tab-bar,
.lq-accent-on .plat,
.lq-accent-on .source-note,
.lq-accent-on .home-entry__card,
.lq-accent-on .home-kpi,
.lq-accent-on .home-kpi__pill,
.lq-accent-on .home-desk,
.lq-accent-on .mine-accent-row,
.lq-accent-on input,
.lq-accent-on textarea {
  background-color: var(--lq-card) !important;
  border-color: var(--lq-border) !important;
}
