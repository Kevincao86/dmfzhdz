@import './accent-dark-surfaces.wxss';

/* 用户自选主题色：板块、卡片、子页头图跟随 --lq-card / --lq-border */
.lq-accent-on .wb-quick-grid,
.lq-accent-on .wb-biz-grid,
.lq-accent-on .mp-sub-hero,
.lq-accent-on .mp-sub-hero--blue,
.lq-accent-on .xingxuan-card {
  background: var(--lq-card);
  border-color: var(--lq-border);
}

.lq-accent-on [class*='card']:not([class*='__']) {
  background: var(--lq-card) !important;
  border-color: var(--lq-border) !important;
}

.tab-bar.lq-accent-on {
  background: var(--lq-card);
  border-top-color: var(--lq-border);
}

/* 写死的品牌色、行内标签色，在自选主题下让位 */
.lq-accent-on .job-card-v1__ai-tag,
.lq-accent-on .job-card-v1__meta-pill {
  background: var(--lq-primary-50) !important;
  color: var(--lq-primary-dark) !important;
}

.lq-accent-on .section-head-dot,
.lq-accent-on .gender-chip--on,
.lq-accent-on .home-chip--on,
.lq-accent-on .btn-primary {
  background: var(--lq-primary) !important;
  border-color: var(--lq-primary) !important;
}

.lq-accent-on .gender-chip--on,
.lq-accent-on .home-chip--on,
.lq-accent-on .btn-primary {
  color: #fff !important;
}

.lq-accent-dark .section-head-dot,
.lq-accent-dark .gender-chip--on,
.lq-accent-dark .home-chip--on,
.lq-accent-dark .btn-primary {
  background: #3f3f46 !important;
  border-color: #d4d4d8 !important;
  color: #fafafa !important;
}

.lq-accent-dark,
.lq-accent-dark .home-greet,
.lq-accent-dark .home-brand-v1,
.lq-accent-dark .job-card-v1__title,
.lq-accent-dark .page-hero-title,
.lq-accent-dark .section-title,
.lq-accent-dark .wb-section-title,
.lq-accent-dark .wb-stat-num,
.lq-accent-dark .input,
.lq-accent-dark .apply-textarea,
.lq-accent-dark .picker-val,
.lq-accent-dark .apply-recruit-val {
  color: #fafafa !important;
}

.lq-accent-dark .home-hall-mini__item,
.lq-accent-dark .page-hero-sub,
.lq-accent-dark .hint,
.lq-accent-dark .form-label,
.lq-accent-dark .wb-stat-lbl,
.lq-accent-dark .mine-accent-cap {
  color: #a1a1aa !important;
}

.lq-accent-dark .home-hall-mini__item--on,
.lq-accent-dark .mine-accent-hit.is-on .mine-accent-cap {
  color: #fafafa !important;
}

.tab-bar.lq-accent-dark .tab-text {
  color: #a1a1aa;
}

.tab-bar.lq-accent-dark .tab-item.active .tab-text {
  color: #fafafa;
}

/* 暗黑：写死的深色字统一提亮。分数环保持浅底，数字仍用紫色。 */
.lq-accent-dark view,
.lq-accent-dark text,
.lq-accent-dark button,
.lq-accent-dark input,
.lq-accent-dark textarea,
.lq-accent-dark navigator,
.lq-accent-dark label {
  color: #f4f4f5 !important;
}

/* 分享菜单底是浅色卡片时，暗黑会把字提成白色，这里改成深底浅字 */
.lq-accent-dark .order-expand-share-menu,
.lq-accent-dark .detail-share-menu {
  background: #27272a !important;
  border-color: rgba(244, 244, 245, 0.28) !important;
}

.lq-accent-dark .detail-share-menu::after {
  border-color: #27272a transparent transparent !important;
}

.lq-accent-dark .order-expand-share-menu__item,
.lq-accent-dark .order-expand-share-menu__item--primary,
.lq-accent-dark .detail-share-menu__item,
.lq-accent-dark .detail-share-menu__item--primary {
  color: #fafafa !important;
  background: transparent !important;
}

.lq-accent-dark .home-entry__sub,
.lq-accent-dark .home-search-v2__ph,
.lq-accent-dark .eval-tab-tx,
.lq-accent-dark .tab-text,
.lq-accent-dark .hint,
.lq-accent-dark .form-label,
.lq-accent-dark .did,
.lq-accent-dark .page-hero-sub,
.lq-accent-dark .wb-stat-lbl,
.lq-accent-dark .mine-accent-cap {
  color: #a1a1aa !important;
}

.lq-accent-dark .score {
  color: #5b21b6 !important;
}

.lq-accent-dark .home-chip--on,
.lq-accent-dark .gender-chip--on,
.lq-accent-dark .btn-primary,
.lq-accent-dark .btn-main,
.lq-accent-dark .plat--on,
.lq-accent-dark .eval-tab--on .eval-tab-tx,
.lq-accent-dark .tab-item.active .tab-text,
.lq-accent-dark .mine-accent-hit.is-on .mine-accent-cap,
.lq-accent-dark .home-hall-mini__item--on {
  color: #fafafa !important;
}

.lq-accent-dark .job-card-v1__ai-tag,
.lq-accent-dark .job-card-v1__meta-pill,
.lq-accent-dark .home-chip--on,
.lq-accent-dark .gender-chip--on,
.lq-accent-dark .btn-primary,
.lq-accent-dark .btn-main,
.lq-accent-dark .plat--on {
  background-color: #3f3f46 !important;
  border-color: #71717a !important;
}

.lq-accent-on .home-search-v2__input,
.lq-accent-on .home-search-v2__icon {
  background-color: transparent !important;
  border-color: transparent !important;
}

/* 卡片和页面上的标题、资料头、输入用正文色。主题色只铺底板和按钮，避免字和底板同色。 */
.lq-accent-on .section-title,
.lq-accent-on .platform-head,
.lq-accent-on .wb-section-title,
.lq-accent-on .cred-ready-text,
.lq-accent-on .wx-name,
.lq-accent-on .wx-nick-input,
.lq-accent-on .cred-modal-title,
.paper-page.lq-accent-on .section-title,
.paper-page.lq-accent-on .platform-head,
.paper-page.lq-accent-on .wx-name,
.paper-page.lq-accent-on .wx-nick-input,
.paper-page.lq-accent-on .input,
.paper-page.lq-accent-on .picker-val,
.paper-page.lq-accent-on .apply-textarea,
.paper-page.lq-accent-on .btn-outline,
.mine-page.lq-accent-on .wb-section-title,
.mine-page.lq-accent-on .wb-stat-num {
  color: var(--lq-text, #14181f) !important;
}

.lq-accent-on .form-label,
.paper-page.lq-accent-on .form-label,
.paper-page.lq-accent-on .hint,
.paper-page.lq-accent-on .platform-card-summary {
  color: var(--lq-text-secondary, #64748b) !important;
}

.paper-page.lq-accent-on .picker-val {
  -webkit-text-fill-color: var(--lq-text, #14181f);
}

.mine-page.lq-accent-on .wb-nick-input {
  color: var(--lq-on-primary, #ffffff) !important;
  -webkit-text-fill-color: var(--lq-on-primary, #ffffff) !important;
  background: var(--lq-primary) !important;
  background-color: var(--lq-primary) !important;
  border-color: transparent !important;
}

/* 暗黑不用变量回退色。变量没传到子节点时，回退色是近黑，会再次贴住底板。 */
.lq-accent-dark .section-title,
.lq-accent-dark .platform-head,
.lq-accent-dark .wb-section-title,
.lq-accent-dark .page-hero-title,
.lq-accent-dark .cred-ready-text,
.lq-accent-dark .cred-edit-btn,
.lq-accent-dark .cred-modal-title,
.lq-accent-dark .wx-name,
.lq-accent-dark .type-chip-label,
.paper-page.lq-accent-dark .section-title,
.paper-page.lq-accent-dark .platform-head,
.paper-page.lq-accent-dark .page-hero-title,
.paper-page.lq-accent-dark .wx-name,
.paper-page.lq-accent-dark .cred-ready-text,
.paper-page.lq-accent-dark .cred-edit-btn,
.paper-page.lq-accent-dark .picker-val,
.paper-page.lq-accent-dark .btn-outline,
.paper-page.lq-accent-dark text,
.paper-page.lq-accent-dark button,
.paper-page.lq-accent-dark label {
  color: #f4f4f5 !important;
  -webkit-text-fill-color: #f4f4f5 !important;
}

.lq-accent-dark input,
.lq-accent-dark textarea {
  color: #f4f4f5 !important;
}

.lq-accent-dark .form-label,
.lq-accent-dark .hint,
.lq-accent-dark .page-hero-sub,
.paper-page.lq-accent-dark .form-label,
.paper-page.lq-accent-dark .hint,
.paper-page.lq-accent-dark .page-hero-sub,
.paper-page.lq-accent-dark .platform-card-summary {
  color: #d4d4d8 !important;
  -webkit-text-fill-color: #d4d4d8 !important;
}
