/* 增值子页顶部 Hero（仅 Brief / AI 审核页引用） */

.addon-hero-brief {
  position: relative;
  margin: 16rpx 24rpx 8rpx;
  padding: 28rpx 28rpx 24rpx;
  border-radius: 24rpx;
  overflow: hidden;
  background: linear-gradient(135deg, #ffffff 0%, #f5f3ff 48%, #ede9fe 100%);
  border: 1rpx solid rgba(124, 131, 255, 0.22);
  box-shadow: 0 10rpx 32rpx rgba(91, 33, 182, 0.08);
}

.addon-hero-brief__glow {
  position: absolute;
  top: -40rpx;
  right: -20rpx;
  width: 200rpx;
  height: 200rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(124, 131, 255, 0.28) 0%, rgba(124, 131, 255, 0) 70%);
  pointer-events: none;
}

.addon-hero-brief__inner {
  position: relative;
  z-index: 1;
}

.addon-hero-brief__top {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.addon-hero-brief__icon {
  flex-shrink: 0;
  width: 72rpx;
  height: 72rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 800;
  color: #fff;
  box-shadow: 0 8rpx 20rpx rgba(91, 33, 182, 0.22);
}

.addon-hero-brief__icon--brief {
  background: linear-gradient(145deg, #7c83ff, #a78bfa);
}

.addon-hero-brief__icon--review {
  font-size: 24rpx;
  background: linear-gradient(145deg, #6366f1, #8b5cf6);
}

.addon-hero-brief__text {
  flex: 1;
  min-width: 0;
}

.addon-hero-brief__eyebrow {
  display: block;
  font-size: 22rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
  color: #7c3aed;
  opacity: 0.9;
}

.addon-hero-brief__title {
  display: block;
  margin-top: 4rpx;
  font-size: 38rpx;
  font-weight: 800;
  line-height: 1.25;
  color: #1e1b4b;
}

.addon-hero-brief__row {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
}

.addon-hero-brief__row .addon-hero-brief__top {
  flex: 1;
  min-width: 0;
}

.addon-hero-brief__link {
  flex-shrink: 0;
  margin-top: 8rpx;
  padding: 10rpx 20rpx;
  font-size: 24rpx;
  font-weight: 600;
  color: #5b21b6;
  background: rgba(255, 255, 255, 0.88);
  border: 1rpx solid rgba(196, 181, 253, 0.9);
  border-radius: 999rpx;
}

.addon-hero-brief__steps {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 8rpx;
  margin-top: 20rpx;
}

.addon-hero-brief__step {
  padding: 10rpx 18rpx;
  font-size: 22rpx;
  font-weight: 600;
  color: #5b21b6;
  background: rgba(255, 255, 255, 0.92);
  border: 1rpx solid rgba(196, 181, 253, 0.75);
  border-radius: 999rpx;
}

.addon-hero-brief__step-arrow {
  font-size: 22rpx;
  font-weight: 700;
  color: #a78bfa;
  line-height: 1;
}

.addon-hero-brief__sub {
  display: block;
  margin-top: 16rpx;
  font-size: 24rpx;
  line-height: 1.55;
  color: #64748b;
}

.addon-hero-brief__tags {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 18rpx;
}

.addon-hero-brief__tag {
  padding: 8rpx 16rpx;
  font-size: 22rpx;
  font-weight: 600;
  color: #4338ca;
  background: rgba(255, 255, 255, 0.9);
  border: 1rpx solid rgba(165, 180, 252, 0.8);
  border-radius: 10rpx;
}
