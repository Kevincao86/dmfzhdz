/* 深度美化 · 参照 AI 设计稿（首页/推荐/发布/消息/我的） */

/* —— 首页 Hero CTA —— */
.home-hero-cta {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin: 20rpx 0 0;
  padding: 22rpx 24rpx;
  background: rgba(255, 255, 255, 0.18);
  border: 2rpx solid rgba(255, 255, 255, 0.35);
  border-radius: 24rpx;
  backdrop-filter: blur(10px);
}

.home-hero-cta__text {
  flex: 1;
  min-width: 0;
}

.home-hero-cta__title {
  display: block;
  font-size: 28rpx;
  font-weight: 700;
  color: #fff;
  line-height: 1.35;
}

.home-hero-cta__sub {
  display: block;
  margin-top: 4rpx;
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.88);
}

.home-hero-cta__btn {
  flex-shrink: 0;
  padding: 12rpx 28rpx;
  font-size: 24rpx;
  font-weight: 700;
  color: var(--lq-primary-dark);
  background: #fff;
  border-radius: 999rpx;
  box-shadow: 0 6rpx 0 rgba(255, 255, 255, 0.35);
}

.search-btn {
  flex-shrink: 0;
  padding: 10rpx 24rpx;
  font-size: 24rpx;
  font-weight: 700;
  color: #fff;
  background: var(--lq-gradient-tab);
  border-radius: 999rpx;
  box-shadow: var(--lq-shadow-tab);
}

/* —— 类目快捷筛选 —— */
.home-cat-scroll {
  width: 100%;
  white-space: nowrap;
  margin: 16rpx 0 0;
}

.home-cat-row {
  display: inline-flex;
  gap: 12rpx;
  padding: 0 4rpx;
}

.home-cat-chip {
  display: inline-flex;
  align-items: center;
  padding: 12rpx 24rpx;
  font-size: 24rpx;
  font-weight: 600;
  color: var(--lq-text-secondary);
  background: var(--lq-surface);
  border: 2rpx solid var(--lq-border);
  border-radius: 999rpx;
}

.home-cat-chip--on {
  color: #fff;
  background: var(--lq-gradient-tab);
  border-color: transparent;
  box-shadow: var(--lq-shadow-tab);
}

/* —— 商单卡 V2：左图 + 右匹配环 —— */
.job-card-compact--v2 {
  padding: 20rpx 18rpx 18rpx;
}

.job-card-compact--v2 .job-card-compact__row {
  align-items: flex-start;
  gap: 16rpx;
}

.job-card-compact__thumb {
  width: 128rpx;
  height: 128rpx;
  border-radius: 16rpx;
  flex-shrink: 0;
  background: var(--lq-primary-50);
  object-fit: cover;
}

.job-card-compact__thumb--ph {
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}

.job-card-compact__thumb-icon {
  width: 56rpx;
  height: 56rpx;
  border-radius: 12rpx;
}

.job-card-compact--v2 .job-card-compact__title {
  white-space: normal;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.job-card-compact--v2 .job-card-compact__price,
.job-card-compact--v2 .job-card-compact__price--solo {
  color: #e11d48;
  font-size: 26rpx;
}

.job-card-compact__match-ring {
  flex-shrink: 0;
  width: 88rpx;
  height: 88rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: linear-gradient(135deg, #f3f1ff 0%, #ede9fe 100%);
  border: 3rpx solid rgba(124, 131, 255, 0.35);
}

.job-card-compact__match-num {
  font-size: 28rpx;
  font-weight: 800;
  color: var(--lq-primary-dark);
  line-height: 1;
}

.job-card-compact__match-lbl {
  margin-top: 4rpx;
  font-size: 16rpx;
  font-weight: 600;
  color: var(--lq-text-secondary);
}

.job-card-compact__deadline {
  display: block;
  margin-top: 6rpx;
  font-size: 20rpx;
  color: var(--lq-text-secondary);
}

/* —— 推荐大厅 · 智能推荐横滑 —— */
.rec-spotlight {
  margin: 0 0 12rpx;
  padding: 20rpx 0 8rpx;
}

.rec-spotlight-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 28rpx 14rpx;
}

.rec-spotlight-title {
  font-size: 30rpx;
  font-weight: 800;
  color: var(--lq-text);
}

.rec-spotlight-badge {
  padding: 4rpx 14rpx;
  font-size: 20rpx;
  font-weight: 700;
  color: #fff;
  background: var(--lq-gradient-tab);
  border-radius: 999rpx;
}

.rec-spotlight-scroll {
  width: 100%;
  white-space: nowrap;
}

.rec-spotlight-row {
  display: inline-flex;
  gap: 16rpx;
  padding: 0 28rpx 8rpx;
}

.rec-spot-card {
  display: inline-flex;
  flex-direction: column;
  width: 280rpx;
  padding: 16rpx;
  background: var(--lq-card);
  border-radius: var(--lq-radius-sm);
  border: 3rpx solid var(--lq-border);
  box-shadow: var(--lq-shadow-card);
  vertical-align: top;
}

.rec-spot-card__thumb {
  width: 100%;
  height: 140rpx;
  border-radius: 12rpx;
  background: var(--lq-primary-50);
}

.rec-spot-card__title {
  display: block;
  margin-top: 12rpx;
  font-size: 24rpx;
  font-weight: 700;
  color: var(--lq-text);
  line-height: 1.35;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.rec-spot-card__foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 10rpx;
}

.rec-spot-card__price {
  font-size: 24rpx;
  font-weight: 700;
  color: #e11d48;
}

.rec-spot-card__match {
  font-size: 28rpx;
  font-weight: 800;
  color: var(--lq-primary-dark);
}

/* —— 消息页 Tab —— */
.msg-tabs {
  display: flex;
  gap: 12rpx;
  padding: 12rpx 28rpx 8rpx;
  background: var(--lq-bg);
}

.msg-tab {
  flex: 1;
  text-align: center;
  padding: 14rpx 8rpx;
  font-size: 26rpx;
  font-weight: 600;
  color: var(--lq-text-secondary);
  background: var(--lq-surface);
  border-radius: 999rpx;
  border: 2rpx solid var(--lq-border);
}

.msg-tab--on {
  color: #fff;
  background: var(--lq-gradient-tab);
  border-color: transparent;
  box-shadow: var(--lq-shadow-tab);
}

.msg-entry--v2 {
  margin: 0 24rpx 12rpx;
  padding: 20rpx 22rpx;
  background: var(--lq-card);
  border-radius: var(--lq-radius-sm);
  border: 2rpx solid var(--lq-border);
  box-shadow: var(--lq-shadow-soft);
  border-bottom: none;
}

.msg-entry--v2 .msg-entry-avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  border: 3rpx solid var(--lq-primary-100);
}

.msg-entry-tag {
  display: inline-block;
  margin-left: 8rpx;
  padding: 2rpx 10rpx;
  font-size: 18rpx;
  font-weight: 600;
  color: var(--lq-primary-dark);
  background: var(--lq-primary-50);
  border-radius: 8rpx;
  vertical-align: middle;
}

/* —— 我的 · 数据概览 —— */
.mine-stats-card {
  display: flex;
  margin: -48rpx 28rpx 16rpx;
  padding: 28rpx 12rpx;
  background: var(--lq-card);
  border-radius: var(--lq-radius-md);
  border: 3rpx solid rgba(255, 255, 255, 0.95);
  box-shadow: var(--lq-shadow-card);
  position: relative;
  z-index: 5;
}

.mine-stat-cell {
  flex: 1;
  text-align: center;
  border-right: 1rpx solid var(--lq-border);
}

.mine-stat-cell:last-child {
  border-right: none;
}

.mine-stat-num {
  display: block;
  font-size: 34rpx;
  font-weight: 800;
  color: var(--lq-primary-dark);
  line-height: 1.2;
}

.mine-stat-lbl {
  display: block;
  margin-top: 6rpx;
  font-size: 22rpx;
  color: var(--lq-text-secondary);
}

.profile-badge--verified {
  background: linear-gradient(135deg, #34d399, #10b981);
  color: #fff;
  font-weight: 700;
}

/* —— 发布页 · 步骤指示 —— */
.pub-steps {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  padding: 16rpx 28rpx 8rpx;
  position: relative;
  z-index: 2;
}

.pub-step {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
  flex: 1;
  max-width: 200rpx;
}

.pub-step-dot {
  width: 20rpx;
  height: 20rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.45);
  border: 3rpx solid rgba(255, 255, 255, 0.6);
}

.pub-step--on .pub-step-dot {
  background: #fff;
  border-color: #fff;
  box-shadow: 0 0 0 4rpx rgba(255, 255, 255, 0.35);
}

.pub-step--done .pub-step-dot {
  background: #34d399;
  border-color: #34d399;
}

.pub-step-label {
  font-size: 20rpx;
  font-weight: 600;
  color: rgba(255, 255, 255, 0.75);
  text-align: center;
  line-height: 1.3;
}

.pub-step--on .pub-step-label,
.pub-step--done .pub-step-label {
  color: #fff;
  font-weight: 700;
}

.pub-form-card {
  margin-bottom: 20rpx;
  padding: 24rpx;
  background: var(--lq-card);
  border-radius: var(--lq-radius-md);
  border: 3rpx solid var(--lq-border);
  box-shadow: var(--lq-shadow-card);
}

.pub-form-card .pub-field {
  margin-bottom: 0;
}

.pub-form-card .pub-field + .pub-field {
  margin-top: 24rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid var(--lq-primary-100);
}
