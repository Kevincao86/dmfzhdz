/* 商务风通用：图标区、列表行、分组卡片 */

.lq-biz-icon {
  width: 72rpx;
  height: 72rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 16rpx;
  background: var(--lq-primary-50);
  color: var(--lq-primary);
  font-size: 28rpx;
  font-weight: 700;
  letter-spacing: 0;
}

.lq-biz-icon--sm {
  width: 56rpx;
  height: 56rpx;
  font-size: 24rpx;
  border-radius: 12rpx;
}

.lq-biz-icon--list,
.lq-biz-icon--tpl {
  color: #1677ff;
  background: #e8f4ff;
}

.lq-biz-icon--bell {
  color: #1677ff;
  background: #e8f4ff;
}

.lq-biz-icon--chart {
  color: #1677ff;
  background: #e8f4ff;
}

.lq-biz-icon--support {
  color: #1677ff;
  background: #e8f4ff;
}

.lq-biz-icon--info {
  color: #1677ff;
  background: #e8f4ff;
}

.lq-biz-icon--identity {
  font-size: 24rpx;
}

.biz-menu-card {
  margin: 16rpx 24rpx 0;
  background: var(--lq-card);
  border-radius: var(--lq-radius-md);
  border: 1rpx solid var(--lq-border);
  box-shadow: var(--lq-shadow-card);
  overflow: hidden;
}

.biz-menu-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 28rpx 24rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.biz-menu-row:last-child {
  border-bottom: none;
}

.biz-menu-row--hover,
.biz-menu-row:active {
  background: #fafbfc;
}

.biz-menu-body {
  flex: 1;
  min-width: 0;
}

.biz-menu-label {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  color: var(--lq-text);
  line-height: 1.35;
}

.biz-menu-sub {
  display: block;
  margin-top: 4rpx;
  font-size: 24rpx;
  color: var(--lq-text-secondary);
  line-height: 1.4;
}

.biz-menu-arrow {
  font-size: 32rpx;
  color: #c0c4cc;
  font-weight: 300;
  line-height: 1;
}

.biz-menu-badge {
  min-width: 36rpx;
  padding: 0 10rpx;
  line-height: 36rpx;
  border-radius: 18rpx;
  background: #ff4d4f;
  color: #fff;
  font-size: 22rpx;
  font-weight: 600;
  text-align: center;
}

.biz-empty-icon {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 96rpx;
  height: 96rpx;
  margin: 0 auto 16rpx;
  border-radius: 50%;
  background: var(--lq-primary-50);
  color: var(--lq-primary);
  font-size: 36rpx;
  font-weight: 700;
}

.biz-section-bar {
  display: inline-block;
  width: 6rpx;
  height: 28rpx;
  margin-right: 12rpx;
  border-radius: 3rpx;
  background: var(--lq-primary);
  vertical-align: middle;
}
