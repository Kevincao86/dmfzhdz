/* 灵祺星选 · 商务简洁主题（浅蓝 + 白卡片 + 扁平阴影） */
page {
  --lq-primary: #1677ff;
  --lq-primary-dark: #0958d9;
  --lq-primary-deep: #003eb3;
  --lq-primary-soft: #69b1ff;
  --lq-primary-50: #e8f4ff;
  --lq-primary-100: #d6e8ff;
  --lq-accent: #fa8c16;
  --lq-accent-deep: #d46b08;
  --lq-violet: #597ef7;
  --lq-magenta: #1677ff;
  --lq-gradient: linear-gradient(135deg, #1677ff 0%, #4096ff 100%);
  --lq-gradient-header: linear-gradient(180deg, #e8f4ff 0%, #f5f8fc 68%, #f5f7fa 100%);
  --lq-gradient-deep: linear-gradient(135deg, #1677ff 0%, #4096ff 100%);
  --lq-gradient-tab: linear-gradient(135deg, #1677ff 0%, #4096ff 100%);
  --lq-gradient-tab-track: #f0f2f5;
  --lq-gradient-filter: linear-gradient(180deg, #ffffff 0%, #fafbfc 100%);
  --lq-bg: #f5f7fa;
  --lq-surface: #ffffff;
  --lq-card: #ffffff;
  --lq-text: #1f2937;
  --lq-text-secondary: #8c8c8c;
  --lq-border: #eef0f3;
  --lq-shadow: 0 8rpx 24rpx rgba(15, 23, 42, 0.06);
  --lq-shadow-card: 0 4rpx 16rpx rgba(15, 23, 42, 0.04);
  --lq-shadow-soft: 0 2rpx 12rpx rgba(15, 23, 42, 0.05);
  --lq-shadow-header: none;
  --lq-shadow-tab: 0 2rpx 8rpx rgba(22, 119, 255, 0.18);
  --lq-radius-lg: 24rpx;
  --lq-radius-md: 20rpx;
  --lq-radius-sm: 16rpx;
  --lq-header-pad-bottom: 24rpx;
}
