/* 灵祺 · 默认达人主题（与星选 Web talent 一致；身份 class 可覆盖） */
page {
  --lq-primary: #7c4dff;
  --lq-primary-dark: #5b3fd4;
  --lq-primary-deep: #5b3fd4;
  --lq-nav-bar: #7c4dff;
  --lq-primary-soft: #a78bfa;
  --lq-primary-50: #f3eeff;
  --lq-primary-100: #e4d9ff;
  --lq-accent: #ffd166;
  --lq-accent-deep: #ffb347;
  --lq-violet: #7c4dff;
  --lq-magenta: #a78bfa;
  --lq-gradient: linear-gradient(180deg, #7c4dff 0%, #7c4dff 100%);
  --lq-gradient-header: linear-gradient(180deg, #7c4dff 0%, #7c4dff 100%);
  --lq-gradient-deep: linear-gradient(180deg, #5b3fd4 0%, #7c4dff 100%);
  --lq-gradient-tab: linear-gradient(180deg, #7c4dff 0%, #7c4dff 100%);
  --lq-gradient-tab-track: linear-gradient(90deg, #f3eeff 0%, #f7f6fb 100%);
  --lq-gradient-filter: linear-gradient(180deg, #ffffff 0%, #f7f6fb 100%);
  --lq-bg: #f7f6fb;
  --lq-surface: #ffffff;
  --lq-card: #ffffff;
  --lq-text: #14181f;
  --lq-text-secondary: #64748b;
  --lq-border: rgba(124, 77, 255, 0.16);
  --lq-shadow: 0 8rpx 28rpx rgba(20, 24, 31, 0.04);
  --lq-shadow-card: 0 8rpx 24rpx rgba(20, 24, 31, 0.04);
  --lq-shadow-soft: 0 8rpx 28rpx rgba(124, 77, 255, 0.1);
  --lq-shadow-header: none;
  --lq-shadow-tab: none;
  --lq-gold: #f5c84c;
  --lq-gold-ink: #1a1814;
  --lq-chip-on-bg: #f3eeff;
  --lq-chip-on-border: #c4b5fd;
  --lq-active-tint: rgba(124, 77, 255, 0.12);
  --lq-radius-lg: 40rpx;
  --lq-radius-md: 32rpx;
  --lq-radius-sm: 24rpx;
  --lq-header-pad-bottom: 32rpx;
  /* Tab 首页顶栏 / Banner：默认达人蓝（身份 class 可覆盖） */
  --lq-home-nav: #7c4dff;
  --lq-home-bg: #f7f6fb;
  --lq-home-banner: linear-gradient(180deg, #7c4dff 0%, #7c4dff 100%);
}

/** 品牌 Logo：仅圆形徽章，aspectFill 铺满 */
.lq-brand-logo {
  border-radius: 50%;
  overflow: hidden;
  display: block;
  flex-shrink: 0;
}
