/* 紧凑商单卡：柔和间距与圆角 */
.job-card-compact {
  position: relative;
  margin: 0 24rpx 16rpx;
  padding: 18rpx 18rpx 16rpx;
  background: var(--lq-card);
  border-radius: var(--lq-radius-sm);
  border: 3rpx solid var(--lq-border);
  box-shadow: var(--lq-shadow-card);
  overflow: hidden;
}

.job-card-compact--hover {
  opacity: 0.97;
}

.job-card-compact__ribbon {
  position: absolute;
  top: 0;
  right: 0;
  padding: 4rpx 14rpx;
  font-size: 18rpx;
  font-weight: 600;
  color: #fff;
  border-radius: 0 0 0 14rpx;
  background: linear-gradient(135deg, #f5d08a, #e8b86a);
}

.job-card-compact__ribbon--demo {
  background: var(--lq-gradient);
}

.job-card-compact__ai-tag {
  position: absolute;
  top: 0;
  right: 0;
  padding: 4rpx 14rpx;
  font-size: 18rpx;
  font-weight: 600;
  color: #fff;
  border-radius: 0 0 0 14rpx;
  background: var(--lq-gradient);
  z-index: 2;
  max-width: 40%;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.job-card-compact__ai-tag--hot {
  background: linear-gradient(135deg, #f5a88a, #e8926e);
}

.job-card-compact__ai-tag--urgent {
  background: linear-gradient(135deg, #f08a9a, #e07082);
}

.job-card-compact__ai-tag--ice {
  background: linear-gradient(135deg, #8ecae8, #6eb5d8);
}

.job-card-compact__ai-tag--match {
  background: linear-gradient(135deg, #8ed4b8, #6bc4a0);
}

.job-card-compact__ai-tag--budget {
  background: linear-gradient(135deg, #b4a8f0, #9a8ee0);
}

.job-card-compact__ai-tag--niche {
  background: linear-gradient(135deg, #8ed4ce, #6ec4bc);
}

.job-card-compact__tag--match {
  color: #3d8a6e;
  background: #eef8f3;
}

.job-card-compact__row {
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.job-card-compact__icon {
  width: 52rpx;
  height: 52rpx;
  border-radius: 12rpx;
  flex-shrink: 0;
  background: var(--lq-primary-50);
}

.job-card-compact__main {
  flex: 1;
  min-width: 0;
}

.job-card-compact__title {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: var(--lq-text);
  line-height: 1.35;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.job-card-compact__line2 {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-top: 8rpx;
}

.job-card-compact__tag {
  font-size: 18rpx;
  padding: 4rpx 10rpx;
  border-radius: 8rpx;
  color: var(--lq-primary-deep);
  background: linear-gradient(135deg, #eef2ff 0%, #e0e7ff 100%);
  font-weight: 600;
}

.job-card-compact__tag--urgent {
  color: #b8863a;
  background: #fef6e8;
}

.job-card-compact__tag--ice {
  color: #5a8ab0;
  background: #eef6fc;
}

.job-card-compact__tag--gray {
  color: var(--lq-text-secondary);
  background: #f3f2f7;
}

.job-card-compact__tag--hot {
  color: #c2410c;
  background: linear-gradient(135deg, #fff7ed 0%, #ffedd5 100%);
}

.job-card-compact__tag--full {
  color: #6b21a8;
  background: linear-gradient(135deg, #f5f3ff 0%, #ede9fe 100%);
}

.job-card-compact__price {
  font-size: 24rpx;
  font-weight: 700;
  color: var(--lq-primary-dark);
  flex-shrink: 0;
}

.job-card-compact__price--solo {
  display: block;
  margin-top: 8rpx;
  line-height: 1.4;
  word-break: break-all;
}

.job-card-compact__fee {
  width: 100%;
  margin-top: 10rpx;
  padding-top: 8rpx;
  border-top: 1rpx solid var(--lq-primary-100);
}

.job-card-compact__fee-cps {
  display: inline-block;
  font-size: 20rpx;
  font-weight: 600;
  color: #fff;
  background: var(--lq-gradient-tab);
  padding: 4rpx 12rpx;
  border-radius: 10rpx;
  margin-bottom: 6rpx;
}

.job-card-compact__fee-mode {
  display: block;
  font-size: 20rpx;
  font-weight: 600;
  color: var(--lq-primary-dark);
  line-height: 1.4;
  margin-bottom: 6rpx;
}

.job-card-compact__fee-chips {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  align-items: center;
}

.job-card-compact__tier-chip {
  font-size: 20rpx;
  font-weight: 500;
  color: var(--lq-text);
  background: #faf9fd;
  border: 1rpx solid var(--lq-border);
  padding: 4rpx 12rpx;
  border-radius: 10rpx;
  max-width: 100%;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.job-card-compact__tier-more {
  font-size: 18rpx;
  font-weight: 500;
  color: var(--lq-text-secondary);
  padding: 4rpx 10rpx;
}

.job-card-compact__line3 {
  display: block;
  margin-top: 6rpx;
  font-size: 20rpx;
  color: var(--lq-text-secondary);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
