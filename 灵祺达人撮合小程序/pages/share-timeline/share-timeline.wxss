@import '../../styles/theme.wxss';

.share-timeline-page {
  min-height: 100vh;
  padding: 48rpx 32rpx calc(48rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  background: #f0eff6;
  display: flex;
  flex-direction: column;
  align-items: stretch;
}

.share-timeline-card {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 48rpx 32rpx;
  background: #fff;
  border-radius: 24rpx;
  box-shadow: 0 8rpx 32rpx rgba(90, 96, 140, 0.08);
}

.share-timeline-label {
  font-size: 24rpx;
  color: #64748b;
}

.share-timeline-title {
  margin-top: 16rpx;
  font-size: 34rpx;
  font-weight: 700;
  color: #0f172a;
  text-align: center;
  line-height: 1.45;
}

.share-timeline-hint {
  margin-top: 24rpx;
  font-size: 26rpx;
  color: #64748b;
  text-align: center;
  line-height: 1.5;
}

.share-timeline-btn {
  width: 100%;
  margin-top: 48rpx;
  height: 96rpx;
  line-height: 96rpx;
  font-size: 32rpx;
  font-weight: 600;
  color: #fff;
  background: var(--lq-gradient-deep);
  border-radius: 48rpx;
  border: none;
}

.share-timeline-btn::after {
  border: none;
}

.share-timeline-back {
  margin-top: 32rpx;
  height: 88rpx;
  line-height: 88rpx;
  font-size: 28rpx;
  color: #64748b;
  background: transparent;
  border: none;
}

.share-timeline-back::after {
  border: none;
}
