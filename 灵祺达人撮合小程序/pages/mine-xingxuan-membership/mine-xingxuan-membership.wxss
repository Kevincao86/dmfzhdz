@import '../../styles/theme.wxss';

.xx-page {
  min-height: 100vh;
  background: #f5f3ff;
  box-sizing: border-box;
}

/* —— Hero —— */
.xx-hero {
  position: relative;
  overflow: hidden;
  padding-bottom: 8rpx;
}

.xx-hero-bg {
  position: absolute;
  inset: 0;
  background: linear-gradient(145deg, #6d28d9 0%, #9333ea 45%, #a855f7 100%);
}

.xx-hero-bg::after {
  content: '';
  position: absolute;
  right: -80rpx;
  top: -60rpx;
  width: 280rpx;
  height: 280rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.08);
}

.xx-hero-body {
  position: relative;
  z-index: 2;
  min-height: 220rpx;
  padding: 24rpx 28rpx 36rpx;
  box-sizing: border-box;
}

.xx-title {
  display: block;
  font-size: 38rpx;
  font-weight: 800;
  color: #fff;
  letter-spacing: 1rpx;
}

.xx-sub {
  display: block;
  margin-top: 10rpx;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.9);
  line-height: 1.5;
  max-width: 88%;
}

.xx-status-card {
  margin-top: 20rpx;
  padding: 18rpx 20rpx;
  border-radius: 20rpx;
  background: rgba(255, 255, 255, 0.14);
  border: 1rpx solid rgba(255, 255, 255, 0.28);
  backdrop-filter: blur(8px);
}

.xx-status-row {
  display: flex;
  align-items: baseline;
  gap: 12rpx;
}

.xx-status-label {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.82);
}

.xx-status-val {
  font-size: 28rpx;
  font-weight: 800;
  color: #fff;
}

.xx-status-exp {
  display: block;
  margin-top: 6rpx;
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.85);
}

.xx-orders-link {
  position: absolute;
  right: 28rpx;
  bottom: 28rpx;
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.95);
  text-decoration: underline;
  font-weight: 600;
}

/* —— Scroll body —— */
.xx-scroll {
  height: calc(100vh - 280rpx);
  padding: 16rpx 24rpx calc(28rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.xx-state {
  padding: 48rpx 28rpx;
  text-align: center;
  color: #64748b;
  font-size: 28rpx;
}

.xx-state--err {
  color: #dc2626;
}

.xx-benefits {
  margin-bottom: 20rpx;
  padding: 20rpx 22rpx;
  border-radius: 22rpx;
  background: #fff;
  border: 2rpx solid #ddd6fe;
  box-shadow: 0 8rpx 24rpx rgba(124, 58, 237, 0.08);
}

.xx-benefits-title {
  display: block;
  font-size: 26rpx;
  font-weight: 700;
  color: #4c1d95;
}

.xx-benefits-grid {
  margin-top: 12rpx;
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.xx-benefit-item {
  display: flex;
  align-items: flex-start;
  gap: 10rpx;
}

.xx-benefit-glyph {
  flex-shrink: 0;
  width: 28rpx;
  font-size: 22rpx;
  color: #059669;
  font-weight: 800;
  line-height: 1.45;
}

.xx-benefit-text {
  flex: 1;
  font-size: 24rpx;
  color: #334155;
  line-height: 1.45;
}

/* —— Plan tabs —— */
.xx-tabs {
  display: flex;
  gap: 10rpx;
  margin-bottom: 20rpx;
  padding: 6rpx;
  border-radius: 20rpx;
  background: rgba(255, 255, 255, 0.72);
  border: 2rpx solid #e9d5ff;
  box-shadow: 0 6rpx 20rpx rgba(124, 58, 237, 0.08);
}

.xx-tab {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 4rpx;
  padding: 14rpx 6rpx;
  border-radius: 16rpx;
  background: transparent;
  transition: background 0.15s ease;
}

.xx-tab--active {
  background: linear-gradient(135deg, #7c3aed, #a855f7);
  box-shadow: 0 6rpx 16rpx rgba(124, 58, 237, 0.28);
}

.xx-tab-text {
  font-size: 22rpx;
  font-weight: 700;
  color: #6d28d9;
  line-height: 1.2;
  text-align: center;
}

.xx-tab--active .xx-tab-text {
  color: #fff;
}

.xx-tab-dot {
  font-size: 18rpx;
  color: #a78bfa;
  line-height: 1;
}

.xx-tab--active .xx-tab-dot {
  color: rgba(255, 255, 255, 0.92);
}

.xx-tab--cur:not(.xx-tab--active) .xx-tab-text {
  color: #4c1d95;
}

/* —— Plan cards —— */
.xx-card {
  position: relative;
  margin-bottom: 24rpx;
  border-radius: 28rpx;
  background: #fff;
  overflow: hidden;
  border: 2rpx solid #e9d5ff;
  box-shadow: 0 10rpx 32rpx rgba(124, 58, 237, 0.1);
}

.xx-card--current {
  border-color: #7c3aed;
  box-shadow: 0 12rpx 36rpx rgba(124, 58, 237, 0.2);
}

.xx-card--rec {
  border-color: #c084fc;
}

.xx-rec-badge {
  position: absolute;
  top: 0;
  right: 24rpx;
  z-index: 3;
  padding: 6rpx 16rpx;
  border-radius: 0 0 14rpx 14rpx;
  background: linear-gradient(135deg, #fbbf24, #f59e0b);
  color: #fff;
  font-size: 20rpx;
  font-weight: 800;
}

.xx-card-head {
  padding: 24rpx 24rpx 20rpx;
  color: #fff;
}

.xx-card-head--basic {
  background: linear-gradient(135deg, #64748b, #94a3b8);
}

.xx-card-head--pro {
  background: linear-gradient(135deg, #7c3aed, #9333ea);
}

.xx-card-head--flagship {
  background: linear-gradient(135deg, #db2777, #ec4899);
}

.xx-card-head--enterprise {
  background: linear-gradient(135deg, #0f766e, #14b8a6);
}

.xx-card-head-top {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.xx-card-name {
  font-size: 34rpx;
  font-weight: 800;
}

.xx-cur-badge {
  font-size: 20rpx;
  padding: 4rpx 12rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.22);
  border: 1rpx solid rgba(255, 255, 255, 0.45);
  font-weight: 700;
}

.xx-card-tagline {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  opacity: 0.92;
}

.xx-price {
  margin-top: 16rpx;
}

.xx-price-main {
  font-size: 44rpx;
  font-weight: 800;
  line-height: 1.1;
}

.xx-price-main.is-free {
  font-size: 36rpx;
}

.xx-price-sub {
  display: block;
  margin-top: 6rpx;
  font-size: 22rpx;
  opacity: 0.88;
}

.xx-card-body {
  padding: 8rpx 24rpx 4rpx;
}

.xx-feat-group {
  padding: 12rpx 0 8rpx;
  border-bottom: 1rpx solid #f1f5f9;
}

.xx-feat-group:last-child {
  border-bottom: none;
}

.xx-feat-group-title {
  display: block;
  margin-bottom: 8rpx;
  font-size: 22rpx;
  font-weight: 700;
  color: #7c3aed;
  letter-spacing: 1rpx;
}

.xx-feat {
  display: flex;
  align-items: flex-start;
  gap: 10rpx;
  padding: 6rpx 0;
}

.xx-feat-icon {
  flex-shrink: 0;
  width: 28rpx;
  font-size: 22rpx;
  line-height: 1.45;
  font-weight: 800;
}

.xx-feat--yes .xx-feat-icon {
  color: #059669;
}

.xx-feat--partial .xx-feat-icon {
  color: #d97706;
}

.xx-feat--no .xx-feat-icon {
  color: #cbd5e1;
}

.xx-feat--no .xx-feat-text {
  color: #94a3b8;
}

.xx-feat-text {
  flex: 1;
  font-size: 24rpx;
  color: #334155;
  line-height: 1.45;
}

.xx-feat-detail {
  color: #64748b;
}

.xx-card-foot {
  padding: 16rpx 24rpx 24rpx;
}

.xx-btn {
  width: 100%;
  height: 76rpx;
  line-height: 76rpx;
  font-size: 28rpx;
  font-weight: 700;
  color: #fff;
  background: linear-gradient(135deg, #7c3aed, #a855f7);
  border-radius: 999rpx;
  border: none;
  box-shadow: 0 8rpx 20rpx rgba(124, 58, 237, 0.28);
}

.xx-btn::after {
  border: none;
}

.xx-btn--full {
  width: 100%;
}

.xx-foot-tip {
  display: block;
  text-align: center;
  font-size: 26rpx;
  color: #94a3b8;
  padding: 12rpx 0;
}

.xx-foot-tip--current {
  color: #7c3aed;
  font-weight: 700;
}

.xx-foot {
  padding: 8rpx 0 24rpx;
  font-size: 22rpx;
  color: #94a3b8;
  text-align: center;
  line-height: 1.5;
}

/* —— Pay sheet —— */
.xx-pay-mask {
  position: fixed;
  inset: 0;
  z-index: 1000;
  background: rgba(15, 23, 42, 0.45);
  display: flex;
  align-items: flex-end;
}

.xx-pay-sheet {
  width: 100%;
  padding: 28rpx 28rpx calc(28rpx + env(safe-area-inset-bottom));
  background: #fff;
  border-radius: 32rpx 32rpx 0 0;
}

.xx-pay-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.xx-pay-title {
  font-size: 32rpx;
  font-weight: 800;
  color: #1e1b4b;
}

.xx-pay-close {
  font-size: 44rpx;
  color: #c4b5fd;
  line-height: 1;
  padding: 0 8rpx;
}

.xx-pay-amount {
  display: block;
  font-size: 28rpx;
  color: #334155;
  margin-bottom: 16rpx;
}

.xx-billing {
  display: flex;
  gap: 12rpx;
  margin-bottom: 20rpx;
}

.xx-billing-item {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  border-radius: 16rpx;
  background: #f8fafc;
  border: 2rpx solid #e2e8f0;
  font-size: 26rpx;
  color: #64748b;
}

.xx-billing-item.is-active {
  background: #ede9fe;
  border-color: #7c3aed;
  color: #6d28d9;
  font-weight: 700;
}

.xx-pay-hint {
  display: block;
  margin-top: 12rpx;
  font-size: 22rpx;
  color: #94a3b8;
  line-height: 1.45;
}

.xx-pay-hint--warn {
  color: #b45309;
}

.xx-pay-err {
  display: block;
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #dc2626;
}

.xx-pay-msg {
  display: block;
  font-size: 28rpx;
  color: #334155;
  line-height: 1.5;
}
