.frg-page {
  min-height: 100vh;
  padding: 24rpx;
  box-sizing: border-box;
}

.frg-card {
  padding: 32rpx 28rpx 40rpx;
  text-align: center;
}

.frg-title {
  display: block;
  font-size: 34rpx;
  font-weight: 700;
  color: #0f172a;
}

.frg-hint {
  display: block;
  margin-top: 16rpx;
  font-size: 26rpx;
  color: #64748b;
  line-height: 1.5;
}

.frg-loading,
.frg-empty,
.frg-err {
  margin-top: 48rpx;
  padding: 24rpx;
}

.frg-err text {
  color: #dc2626;
  font-size: 26rpx;
}

.frg-qr-wrap {
  margin-top: 36rpx;
  padding: 24rpx;
  background: #f8fafc;
  border-radius: 24rpx;
}

.frg-qr-img {
  width: 520rpx;
  height: 520rpx;
  max-width: 100%;
}
