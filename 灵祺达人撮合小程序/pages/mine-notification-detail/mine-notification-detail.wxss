.ntf-detail {
  padding: 24rpx 28rpx 48rpx;
  min-height: 100vh;
  box-sizing: border-box;
}

.ntf-detail-card {
  padding: 28rpx;
}

.ntf-detail-head {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 8rpx;
}

.ntf-detail-time {
  display: block;
  font-size: 22rpx;
  color: #9ca3af;
  margin-bottom: 20rpx;
}

.ntf-detail-title {
  display: block;
  margin-bottom: 16rpx;
}

.ntf-detail-body {
  display: block;
  font-size: 28rpx;
  line-height: 1.65;
  color: #374151;
  white-space: pre-wrap;
}

.ntf-detail-image {
  display: block;
  width: 100%;
  margin-top: 24rpx;
  border-radius: 12rpx;
  border: 2rpx solid var(--lq-primary-100, #e0e7ff);
}

.ntf-detail-actions {
  margin-top: 24rpx;
}

.ntf-detail-link {
  margin-top: 32rpx;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 999rpx;
  font-size: 30rpx;
  font-weight: 600;
  color: #fff;
  background: linear-gradient(135deg, #1677ff 0%, #4096ff 100%);
}

.ntf-detail-link::after {
  border: none;
}

.ntf-cat--selection {
  color: #b45309;
  background: #fffbeb;
}

.ntf-cat {
  font-size: 20rpx;
  font-weight: 700;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
}

.ntf-read {
  font-size: 20rpx;
  font-weight: 600;
  padding: 2rpx 10rpx;
  border-radius: 8rpx;
}

.ntf-read--new {
  color: #dc2626;
  background: #fef2f2;
}

.ntf-read--ok {
  color: #6b7280;
  background: #f3f4f6;
}

.ntf-actions {
  display: flex;
  gap: 16rpx;
}

.ntf-action-btn {
  flex: 1;
  margin: 0;
  height: 72rpx;
  line-height: 72rpx;
  font-size: 26rpx;
  font-weight: 600;
  border-radius: 999rpx;
  color: #5b21b6;
  background: #fff;
  border: 2rpx solid #e0e7ff;
}

.ntf-action-btn::after {
  border: none;
}

.ntf-action-btn--primary {
  color: #fff;
  background: linear-gradient(135deg, #1677ff 0%, #4096ff 100%);
  border-color: transparent;
}
