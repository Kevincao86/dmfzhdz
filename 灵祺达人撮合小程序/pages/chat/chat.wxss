.chat-page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: #ededed;
}

.chat-nav {
  flex-shrink: 0;
  background: #ededed;
  padding-bottom: 12rpx;
  border-bottom: 1rpx solid #dcdcdc;
}

.chat-nav-inner {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding-left: 16rpx;
  box-sizing: border-box;
}

.chat-back {
  font-size: 52rpx;
  color: #111;
  line-height: 1;
  padding: 0 8rpx;
}

.chat-nav-avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 10rpx;
  flex-shrink: 0;
  background: #fff;
}

.chat-nav-meta {
  flex: 1;
  min-width: 0;
}

.chat-nav-name {
  display: block;
  font-size: 32rpx;
  font-weight: 700;
  color: #111;
}

.chat-nav-sub {
  display: block;
  margin-top: 4rpx;
  font-size: 22rpx;
  color: #6b7280;
}

.chat-scroll {
  flex: 1;
  min-height: 0;
  padding: 16rpx 20rpx;
  box-sizing: border-box;
}

.scroll-pad {
  height: 24rpx;
}

.bubble-row {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
  margin-bottom: 24rpx;
}

.bubble-row.mine {
  justify-content: flex-end;
}

.bubble-row.their {
  justify-content: flex-start;
}

.bubble-avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 10rpx;
  flex-shrink: 0;
  background: #fff;
}

.bubble {
  max-width: 62%;
  padding: 18rpx 22rpx;
  border-radius: 12rpx;
  position: relative;
}

.bubble-mine {
  background: #95ec69;
  color: #111;
  border-top-right-radius: 4rpx;
}

.bubble-their {
  background: #fff;
  color: #111;
  border-top-left-radius: 4rpx;
  border: 1rpx solid #e5e7eb;
}

.bubble-text {
  font-size: 30rpx;
  line-height: 1.5;
  display: block;
  white-space: pre-wrap;
  word-break: break-word;
}

.bubble-at {
  display: block;
  margin-top: 8rpx;
  font-size: 20rpx;
  color: rgba(0, 0, 0, 0.45);
  text-align: right;
}

.chat-composer {
  flex-shrink: 0;
  padding: 12rpx 16rpx calc(12rpx + env(safe-area-inset-bottom));
  background: #f7f7f7;
  border-top: 1rpx solid #dcdcdc;
}

.composer-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.chat-input {
  flex: 1;
  min-height: 72rpx;
  padding: 0 24rpx;
  background: #fff;
  border-radius: 12rpx;
  font-size: 30rpx;
  border: 1rpx solid #e5e7eb;
}

.send-btn {
  flex-shrink: 0;
  padding: 0 28rpx;
  height: 72rpx;
  line-height: 72rpx;
  background: #07c160;
  color: #fff;
  font-size: 28rpx;
  font-weight: 600;
  border-radius: 12rpx;
  border: none;
}

.send-btn::after {
  border: none;
}

.send-btn[disabled] {
  opacity: 0.5;
}
