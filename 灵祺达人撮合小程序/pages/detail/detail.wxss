@import '../../styles/theme.wxss';

.line-link {
  color: #2563eb;
  text-decoration: underline;
  word-break: break-all;
}

/* 详情页补充样式（表单基础见 app.wxss） */
.detail-hero {
  margin-top: 16rpx;
  overflow: hidden;
}

.detail-hero-top {
  margin: -32rpx -32rpx 0;
  padding: 28rpx 32rpx 24rpx;
  background: var(--lq-gradient-deep);
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
}

.detail-hero-main {
  flex: 1;
  min-width: 0;
}

.detail-hero-qr-wrap {
  flex-shrink: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  align-self: flex-end;
}

.detail-hero-qr-img {
  width: 112rpx;
  height: 112rpx;
  border-radius: 12rpx;
  background: #fff;
  padding: 6rpx;
  box-sizing: border-box;
}

.detail-hero-qr-cap {
  margin-top: 6rpx;
  font-size: 18rpx;
  color: rgba(255, 255, 255, 0.78);
  white-space: nowrap;
}

.detail-hero-qr-canvas {
  position: fixed;
  left: -9999px;
  top: -9999px;
  width: 120px;
  height: 120px;
  opacity: 0;
  pointer-events: none;
}

.detail-hero-top .order-no {
  color: rgba(255, 255, 255, 0.65);
}

.detail-hero-top .order-copy {
  color: #c7d2fe;
  margin-left: 12rpx;
  font-size: 24rpx;
}

.detail-hero-top .detail-hero-title {
  display: block;
  font-size: 40rpx;
  font-weight: 700;
  line-height: 1.4;
  color: #fff;
}

.detail-hero-top .detail-hero-order-no {
  margin-top: 12rpx;
}

.detail-hero-top .detail-hero-countdown {
  display: block;
  margin-top: 10rpx;
  font-size: 26rpx;
  font-weight: 600;
  line-height: 1.45;
}

.detail-hero-countdown--green {
  color: #86efac;
}

.detail-hero-countdown--orange {
  color: #fdba74;
}

.detail-hero-countdown--danger {
  color: #fecaca;
}

.detail-hero-countdown--ended {
  color: rgba(255, 255, 255, 0.55);
}

.detail-hero-countdown--unknown {
  color: #fde68a;
}

.detail-hero-top .detail-hero-city {
  font-size: 30rpx;
  font-weight: 600;
  color: rgba(255, 255, 255, 0.88);
}

.detail-hero-top .tag {
  margin-top: 16rpx;
}

.detail-body {
  padding-top: 8rpx;
}

.metrics--ice {
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid #f1f5f9;
}

.ice-slot-stats {
  display: flex;
  gap: 24rpx;
  margin-top: 20rpx;
}

.ice-slot-stat {
  flex: 1;
  padding: 20rpx 16rpx;
  border-radius: 12rpx;
  background: #f8fafc;
  text-align: center;
}

.ice-slot-stat__label {
  display: block;
  font-size: 22rpx;
  color: #64748b;
}

.ice-slot-stat__value {
  display: block;
  margin-top: 8rpx;
  font-size: 36rpx;
  font-weight: 700;
  color: #059669;
}

.region-value {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--lq-primary-dark);
}

.success-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #059669;
}

.platform-block {
  margin-top: 8rpx;
  padding-top: 28rpx;
  border-top: 2rpx solid #f1f5f9;
}

.platform-head {
  display: flex;
  align-items: center;
  gap: 12rpx;
  font-size: 28rpx;
  font-weight: 700;
  color: #0f172a;
  margin-bottom: 8rpx;
}

.platform-head::before {
  content: '';
  width: 6rpx;
  height: 28rpx;
  border-radius: 3rpx;
  background: var(--lq-primary);
}

.platform-head--dy::before {
  background: #1e293b;
}

.platform-head--xhs::before {
  background: #ec4899;
}

.ice-textarea {
  min-height: 160rpx;
  margin-top: 12rpx;
}

.ice-qr-img {
  width: 240rpx;
  height: 240rpx;
  margin-top: 12rpx;
  border-radius: 12rpx;
  border: 1rpx solid rgba(0, 0, 0, 0.08);
}

.detail-share-wrap {
  position: relative;
}

.detail-share-menu-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 120;
}

.detail-share-menu {
  position: absolute;
  left: 0;
  bottom: calc(100% + 16rpx);
  z-index: 130;
  min-width: 280rpx;
  padding: 8rpx 0;
  border-radius: 16rpx;
  background: #fff;
  box-shadow: 0 12rpx 40rpx rgba(15, 23, 42, 0.16);
}

.detail-share-menu::after {
  content: '';
  position: absolute;
  left: 36rpx;
  bottom: -12rpx;
  border-width: 12rpx 10rpx 0;
  border-style: solid;
  border-color: #fff transparent transparent;
}

.detail-share-menu__item {
  display: block;
  padding: 22rpx 28rpx;
  font-size: 28rpx;
  color: #334155;
  line-height: 1.4;
  text-align: left;
  background: #fff;
  border: none;
  border-radius: 0;
}

.detail-share-menu__item::after {
  border: none;
}

.detail-share-menu__item--primary {
  color: #059669;
  font-weight: 600;
  border-bottom: 1rpx solid rgba(15, 23, 42, 0.06);
}

.bottom-icon--active {
  color: var(--lq-primary);
}

.detail-share-sheet-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 140;
  background: rgba(15, 23, 42, 0.45);
  display: flex;
  align-items: flex-end;
}

.detail-share-sheet {
  width: 100%;
  max-height: 88vh;
  padding: 28rpx 28rpx calc(28rpx + env(safe-area-inset-bottom));
  border-radius: 28rpx 28rpx 0 0;
  background: #fff;
  box-sizing: border-box;
}

.detail-share-sheet-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.detail-share-sheet-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #0f172a;
}

.detail-share-sheet-close {
  font-size: 44rpx;
  line-height: 1;
  color: #94a3b8;
  padding: 8rpx 12rpx;
}

.detail-share-poster-panel {
  max-height: 62vh;
  overflow-y: auto;
}

.detail-share-poster-loading,
.detail-share-poster-err {
  display: block;
  padding: 48rpx 24rpx;
  text-align: center;
  font-size: 28rpx;
  color: #64748b;
}

.detail-share-poster-img {
  display: block;
  width: 100%;
  border-radius: 16rpx;
}

.detail-share-poster-style-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 16rpx;
}

.detail-share-poster-style-label {
  font-size: 24rpx;
  color: #64748b;
}

.detail-share-poster-style-btn {
  font-size: 26rpx;
  font-weight: 600;
}

.detail-share-sheet-item {
  margin-top: 16rpx;
  padding: 24rpx;
  text-align: center;
  font-size: 30rpx;
  font-weight: 600;
  border-radius: 16rpx;
  background: #f8fafc;
}

.detail-share-sheet-btn {
  background: #f8fafc;
  color: #334155;
}

.detail-share-sheet-btn::after {
  border: none;
}

.detail-share-poster-save {
  background: rgba(124, 58, 237, 0.08);
}

.detail-share-sheet-cancel {
  margin-top: 20rpx;
  padding: 24rpx;
  text-align: center;
  font-size: 30rpx;
  color: #64748b;
}
