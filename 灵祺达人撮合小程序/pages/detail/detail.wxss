@import '../../styles/theme.wxss';

/* 详情页补充样式（表单基础见 app.wxss） */
.detail-hero {
  margin-top: 16rpx;
  overflow: hidden;
}

.detail-hero-top {
  margin: -32rpx -32rpx 0;
  padding: 28rpx 32rpx 24rpx;
  background: var(--lq-gradient-deep);
}

.detail-hero-top .order-no {
  color: rgba(255, 255, 255, 0.65);
}

.detail-hero-top .order-copy {
  color: #c7d2fe;
  margin-left: 12rpx;
  font-size: 24rpx;
}

.detail-hero-top .merchant-name {
  color: rgba(255, 255, 255, 0.85);
}

.detail-hero-top .title-lg {
  color: #fff;
  margin-top: 16rpx;
}

.detail-hero-top .tag {
  margin-top: 16rpx;
}

.detail-body {
  padding-top: 8rpx;
}

.metrics--ice {
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid #f1f5f9;
}

.ice-slot-stats {
  display: flex;
  gap: 24rpx;
  margin-top: 20rpx;
}

.ice-slot-stat {
  flex: 1;
  padding: 20rpx 16rpx;
  border-radius: 12rpx;
  background: #f8fafc;
  text-align: center;
}

.ice-slot-stat__label {
  display: block;
  font-size: 22rpx;
  color: #64748b;
}

.ice-slot-stat__value {
  display: block;
  margin-top: 8rpx;
  font-size: 36rpx;
  font-weight: 700;
  color: #059669;
}

.region-value {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--lq-primary-dark);
}

.success-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #059669;
}

.platform-block {
  margin-top: 8rpx;
  padding-top: 28rpx;
  border-top: 2rpx solid #f1f5f9;
}

.platform-head {
  display: flex;
  align-items: center;
  gap: 12rpx;
  font-size: 28rpx;
  font-weight: 700;
  color: #0f172a;
  margin-bottom: 8rpx;
}

.platform-head::before {
  content: '';
  width: 6rpx;
  height: 28rpx;
  border-radius: 3rpx;
  background: var(--lq-primary);
}

.platform-head--dy::before {
  background: #1e293b;
}

.platform-head--xhs::before {
  background: #ec4899;
}

.ice-textarea {
  min-height: 160rpx;
  margin-top: 12rpx;
}

.ice-qr-img {
  width: 240rpx;
  height: 240rpx;
  margin-top: 12rpx;
  border-radius: 12rpx;
  border: 1rpx solid rgba(0, 0, 0, 0.08);
}

.detail-share-sheet-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 10000;
}

.detail-share-sheet-mask-bg {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(15, 23, 42, 0.45);
  animation: detail-share-fade-in 0.22s ease;
}

@keyframes detail-share-fade-in {
  from {
    opacity: 0;
  }
  to {
    opacity: 1;
  }
}

@keyframes detail-share-slide-up {
  from {
    opacity: 0;
    transform: translateY(48rpx) scale(0.96);
  }
  to {
    opacity: 1;
    transform: translateY(0) scale(1);
  }
}

.detail-share-float {
  position: absolute;
  left: 32rpx;
  right: 32rpx;
  bottom: calc(32rpx + env(safe-area-inset-bottom));
  padding: 20rpx 28rpx 24rpx;
  background: #fff;
  border-radius: 36rpx;
  box-shadow:
    0 24rpx 64rpx rgba(90, 96, 140, 0.18),
    0 4rpx 16rpx rgba(90, 96, 140, 0.08);
  animation: detail-share-slide-up 0.28s cubic-bezier(0.22, 1, 0.36, 1);
}

.detail-share-float-handle {
  width: 64rpx;
  height: 8rpx;
  margin: 0 auto 16rpx;
  border-radius: 4rpx;
  background: rgba(148, 163, 184, 0.35);
}

.detail-share-float-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 4rpx;
}

.detail-share-float-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #0f172a;
}

.detail-share-float-close {
  font-size: 44rpx;
  color: #94a3b8;
  line-height: 1;
  padding: 0 4rpx;
}

.detail-share-float-sub {
  display: block;
  font-size: 24rpx;
  color: #64748b;
  margin-bottom: 28rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.detail-share-float-options {
  display: flex;
  gap: 20rpx;
  padding: 8rpx 0 4rpx;
}

.detail-share-float-opt {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 24rpx 12rpx 20rpx;
  margin: 0;
  background: #f8f7ff;
  border-radius: 24rpx;
  border: 2rpx solid rgba(216, 208, 240, 0.6);
  line-height: normal;
  transition: transform 0.15s ease, background 0.15s ease;
}

.detail-share-float-opt::after {
  border: none;
}

.detail-share-float-opt--active {
  transform: scale(0.96);
  background: #f0efff;
}

.detail-share-float-icon {
  width: 96rpx;
  height: 96rpx;
  border-radius: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(90, 96, 140, 0.12);
}

.detail-share-float-icon--mp {
  background: linear-gradient(145deg, #34d399 0%, #10b981 100%);
}

.detail-share-float-icon--timeline {
  background: linear-gradient(145deg, #fef3c7 0%, #fce7f3 50%, #ddd6fe 100%);
}

.detail-share-float-icon-img {
  width: 52rpx;
  height: 52rpx;
}

.detail-share-float-moments {
  position: relative;
  width: 52rpx;
  height: 52rpx;
}

.detail-share-float-moment {
  position: absolute;
  width: 22rpx;
  height: 22rpx;
  border-radius: 6rpx;
}

.detail-share-float-moment--1 {
  top: 0;
  left: 0;
  background: #f97316;
}

.detail-share-float-moment--2 {
  top: 0;
  right: 0;
  background: #22c55e;
}

.detail-share-float-moment--3 {
  bottom: 0;
  left: 0;
  background: #3b82f6;
}

.detail-share-float-moment--4 {
  bottom: 0;
  right: 0;
  background: #ef4444;
}

.detail-share-float-opt-label {
  margin-top: 16rpx;
  font-size: 28rpx;
  font-weight: 600;
  color: #0f172a;
}

.detail-share-float-opt-hint {
  margin-top: 6rpx;
  font-size: 20rpx;
  color: #94a3b8;
  text-align: center;
  line-height: 1.35;
}

.detail-share-float-cancel {
  margin-top: 24rpx;
  padding: 22rpx;
  font-size: 28rpx;
  font-weight: 500;
  color: #64748b;
  text-align: center;
  background: #f1f5f9;
  border-radius: 20rpx;
}
