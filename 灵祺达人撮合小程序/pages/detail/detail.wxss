@import '../../styles/theme.wxss';

/* 详情页补充样式（表单基础见 app.wxss） */
.detail-hero {
  margin-top: 16rpx;
  overflow: hidden;
}

.detail-hero-top {
  margin: -32rpx -32rpx 0;
  padding: 28rpx 32rpx 24rpx;
  background: var(--lq-gradient-deep);
}

.detail-hero-top .order-no {
  color: rgba(255, 255, 255, 0.65);
}

.detail-hero-top .order-copy {
  color: #c7d2fe;
  margin-left: 12rpx;
  font-size: 24rpx;
}

.detail-hero-top .merchant-name {
  color: rgba(255, 255, 255, 0.85);
}

.detail-hero-top .title-lg {
  color: #fff;
  margin-top: 16rpx;
}

.detail-hero-top .tag {
  margin-top: 16rpx;
}

.detail-body {
  padding-top: 8rpx;
}

.metrics--ice {
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid #f1f5f9;
}

.ice-slot-stats {
  display: flex;
  gap: 24rpx;
  margin-top: 20rpx;
}

.ice-slot-stat {
  flex: 1;
  padding: 20rpx 16rpx;
  border-radius: 12rpx;
  background: #f8fafc;
  text-align: center;
}

.ice-slot-stat__label {
  display: block;
  font-size: 22rpx;
  color: #64748b;
}

.ice-slot-stat__value {
  display: block;
  margin-top: 8rpx;
  font-size: 36rpx;
  font-weight: 700;
  color: #059669;
}

.region-value {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--lq-primary-dark);
}

.success-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #059669;
}

.platform-block {
  margin-top: 8rpx;
  padding-top: 28rpx;
  border-top: 2rpx solid #f1f5f9;
}

.platform-head {
  display: flex;
  align-items: center;
  gap: 12rpx;
  font-size: 28rpx;
  font-weight: 700;
  color: #0f172a;
  margin-bottom: 8rpx;
}

.platform-head::before {
  content: '';
  width: 6rpx;
  height: 28rpx;
  border-radius: 3rpx;
  background: var(--lq-primary);
}

.platform-head--dy::before {
  background: #1e293b;
}

.platform-head--xhs::before {
  background: #ec4899;
}

.ice-textarea {
  min-height: 160rpx;
  margin-top: 12rpx;
}

.ice-qr-img {
  width: 240rpx;
  height: 240rpx;
  margin-top: 12rpx;
  border-radius: 12rpx;
  border: 1rpx solid rgba(0, 0, 0, 0.08);
}

.detail-share-cover {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 10000;
}

.detail-share-cover__bg {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background-color: rgba(53, 50, 74, 0.32);
}

.detail-share-cover__sheet {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 28rpx 28rpx calc(28rpx + env(safe-area-inset-bottom));
  background-color: #ffffff;
  border-top-left-radius: 32rpx;
  border-top-right-radius: 32rpx;
}

.detail-share-cover__head {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 8rpx;
}

.detail-share-cover__title {
  font-size: 32rpx;
  font-weight: 700;
  color: #0f172a;
}

.detail-share-cover__close {
  font-size: 44rpx;
  color: #94a3b8;
  line-height: 44rpx;
  padding: 0 8rpx;
}

.detail-share-cover__sub {
  font-size: 24rpx;
  color: #64748b;
  margin-bottom: 20rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.detail-share-cover__item {
  display: block;
  width: 100%;
  box-sizing: border-box;
  margin: 0;
  padding: 28rpx 8rpx;
  font-size: 30rpx;
  font-weight: 600;
  color: #0f172a;
  text-align: center;
  background-color: #ffffff;
  border-top: 1rpx solid #e2e8f0;
  border-radius: 0;
  line-height: 1.4;
}

.detail-share-cover__item::after {
  border: none;
}

.detail-share-cover__cancel {
  margin-top: 12rpx;
  padding: 28rpx 8rpx;
  font-size: 30rpx;
  color: #64748b;
  text-align: center;
  border-top: 12rpx solid #f1f5f9;
}
