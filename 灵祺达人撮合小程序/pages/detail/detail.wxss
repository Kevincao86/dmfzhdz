@import '../../styles/theme.wxss';

/* 详情页补充样式（表单基础见 app.wxss） */
.detail-hero {
  margin-top: 16rpx;
  overflow: hidden;
}

.detail-hero-top {
  margin: -32rpx -32rpx 0;
  padding: 28rpx 32rpx 24rpx;
  background: var(--lq-gradient-deep);
}

.detail-hero-top .order-no {
  color: rgba(255, 255, 255, 0.65);
}

.detail-hero-top .order-copy {
  color: #c7d2fe;
  margin-left: 12rpx;
  font-size: 24rpx;
}

.detail-hero-top .merchant-name {
  color: rgba(255, 255, 255, 0.85);
}

.detail-hero-top .title-lg {
  color: #fff;
  margin-top: 16rpx;
}

.detail-hero-top .tag {
  margin-top: 16rpx;
}

.detail-body {
  padding-top: 8rpx;
}

.region-value {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--lq-primary-dark);
}

.success-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #059669;
}

.platform-block {
  margin-top: 8rpx;
  padding-top: 28rpx;
  border-top: 2rpx solid #f1f5f9;
}

.platform-head {
  display: flex;
  align-items: center;
  gap: 12rpx;
  font-size: 28rpx;
  font-weight: 700;
  color: #0f172a;
  margin-bottom: 8rpx;
}

.platform-head::before {
  content: '';
  width: 6rpx;
  height: 28rpx;
  border-radius: 3rpx;
  background: var(--lq-primary);
}

.platform-head--dy::before {
  background: #1e293b;
}

.platform-head--xhs::before {
  background: #ec4899;
}
