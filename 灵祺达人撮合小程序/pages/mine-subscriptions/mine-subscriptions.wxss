.page { padding: 24rpx; background: #f5f7fb; min-height: 100vh; }
.card { background: #fff; border-radius: 20rpx; padding: 28rpx; margin-bottom: 24rpx; }
.title { font-size: 32rpx; font-weight: 600; color: #0f172a; }
.hint { display: block; margin-top: 12rpx; font-size: 24rpx; color: #64748b; line-height: 1.5; }
.row.between { display: flex; justify-content: space-between; align-items: center; }
.label { display: block; margin: 20rpx 0 8rpx; font-size: 26rpx; color: #475569; }
.input { background: #f8fafc; border-radius: 12rpx; padding: 16rpx 20rpx; font-size: 28rpx; }
.chk { display: flex; align-items: center; gap: 12rpx; margin-top: 20rpx; font-size: 26rpx; color: #334155; }
.btn { margin-top: 28rpx; border-radius: 999rpx; font-size: 28rpx; }
.btn.primary { background: #0284c7; color: #fff; }
.match-row { padding: 20rpx 0; border-bottom: 1rpx solid #e2e8f0; }
.match-title { font-size: 28rpx; color: #0f172a; }
.match-sub { font-size: 24rpx; color: #64748b; }
