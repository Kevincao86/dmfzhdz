@import '../../styles/xingxuan-subpage.wxss';
@import '../../styles/recruit-picker.wxss';

.row.between {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.field-label {
  display: block;
  margin-top: 24rpx;
  font-size: 28rpx;
  font-weight: 600;
  color: #334155;
}

.field-label:first-child {
  margin-top: 0;
}

.field-hint {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #94a3b8;
}

.platform-grid {
  margin-top: 16rpx;
}

.platform-grid .pub-tag-cell {
  width: calc((100% - 24rpx) / 3);
}

.chk {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 28rpx;
  font-size: 26rpx;
  color: #334155;
}

.save-btn {
  margin-top: 28rpx;
}

.match-row {
  padding: 20rpx 0;
  border-bottom: 1rpx solid #e2e8f0;
}

.match-title {
  display: block;
  font-size: 28rpx;
  color: #0f172a;
}

.match-sub {
  display: block;
  margin-top: 6rpx;
  font-size: 24rpx;
  color: #64748b;
}
