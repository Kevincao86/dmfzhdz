<view class="page page-shell-fixed">
  <view class="card">
    <text class="title">申请成为推广员</text>
    <text class="sub">个人推广员可推广灵祺 ERP 与星选会员，审核通过后获得专属推广码。</text>

    <view class="result" wx:if="{{result}}">
      <text class="result-title">当前状态：{{result.status === 'pending' ? '待审核' : result.status === 'active' ? '已通过' : result.status === 'rejected' ? '未通过' : '已停用'}}</text>
      <text class="result-line" wx:if="{{result.refCode}}">推广码：{{result.refCode}}</text>
    </view>

    <text class="info" wx:if="{{info}}">{{info}}</text>
    <text class="err" wx:if="{{err}}">{{err}}</text>

    <view class="field">
      <text class="label">真实姓名</text>
      <input class="input" value="{{realName}}" bindinput="onRealNameInput" placeholder="与后续提现账户一致" maxlength="32" />
    </view>
    <view class="field">
      <text class="label">手机号</text>
      <input class="input" type="number" value="{{phone}}" bindinput="onPhoneInput" placeholder="11 位大陆手机号" maxlength="11" />
    </view>
    <view class="field">
      <text class="label">备注（选填）</text>
      <input class="input" value="{{note}}" bindinput="onNoteInput" placeholder="如：主要推广星选会员" maxlength="120" />
    </view>

    <button class="btn-primary" loading="{{submitting}}" bindtap="onSubmit">提交申请</button>
    <button class="btn-secondary" loading="{{checking}}" bindtap="onCheckStatus">查询进度</button>
  </view>
</view>
