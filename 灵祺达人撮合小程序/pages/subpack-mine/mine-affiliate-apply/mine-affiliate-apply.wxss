.page {
  min-height: 100vh;
  padding: 32rpx 28rpx 48rpx;
  background: linear-gradient(180deg, #f5f3ff 0%, #ffffff 40%, #ecfeff 100%);
  box-sizing: border-box;
}

.card {
  background: rgba(255, 255, 255, 0.92);
  border-radius: 28rpx;
  padding: 36rpx 32rpx;
  box-shadow: 0 16rpx 48rpx rgba(15, 23, 42, 0.08);
}

.title {
  display: block;
  font-size: 36rpx;
  font-weight: 700;
  color: #0f172a;
}

.sub {
  display: block;
  margin-top: 16rpx;
  font-size: 26rpx;
  line-height: 1.6;
  color: #64748b;
}

.result {
  margin-top: 24rpx;
  padding: 20rpx 24rpx;
  border-radius: 16rpx;
  background: #ecfdf5;
  border: 1px solid #a7f3d0;
}

.result-title,
.result-line {
  display: block;
  font-size: 26rpx;
  color: #065f46;
}

.result-line {
  margin-top: 8rpx;
  font-family: monospace;
}

.info {
  display: block;
  margin-top: 20rpx;
  font-size: 26rpx;
  color: #4338ca;
}

.err {
  display: block;
  margin-top: 20rpx;
  font-size: 26rpx;
  color: #dc2626;
}

.field {
  margin-top: 28rpx;
}

.label {
  display: block;
  font-size: 24rpx;
  color: #64748b;
  margin-bottom: 8rpx;
}

.input {
  width: 100%;
  box-sizing: border-box;
  padding: 20rpx 24rpx;
  border-radius: 16rpx;
  border: 1px solid #e2e8f0;
  background: #fff;
  font-size: 28rpx;
}

.btn-primary {
  margin-top: 36rpx;
  background: #4f46e5;
  color: #fff;
  border-radius: 16rpx;
  font-size: 30rpx;
}

.btn-secondary {
  margin-top: 16rpx;
  background: #fff;
  color: #334155;
  border: 1px solid #e2e8f0;
  border-radius: 16rpx;
  font-size: 28rpx;
}

.boot {
  display: block;
  margin-top: 24rpx;
  font-size: 26rpx;
  color: #64748b;
}

.btn-link {
  margin-top: 16rpx;
  padding: 0;
  background: transparent;
  color: #4f46e5;
  font-size: 26rpx;
  font-weight: 600;
  text-align: left;
  line-height: 1.5;
}

.btn-link::after {
  border: none;
}

.input[disabled] {
  background: #f8fafc;
  color: #64748b;
}
