<view class="portal-page foot-col">
  <scroll-view scroll-y class="portal-scroll" enhanced show-scrollbar="{{false}}">
    <view class="mp-sub-hero">
      <view class="mp-sub-hero__glow"></view>
      <view class="mp-sub-hero__inner">
        <text class="mp-sub-hero__eyebrow">AFFILIATE</text>
        <text class="mp-sub-hero__title">我的推广</text>
        <text class="mp-sub-hero__sub">专属推广码、链接与佣金数据，扫码即可绑定你的推广关系。</text>
        <view class="mp-sub-hero__chips" wx:if="{{affiliate && affiliate.refCode}}">
          <text class="mp-sub-hero__chip mp-sub-hero__chip--green">{{statusLabel}}</text>
          <text class="mp-sub-hero__chip">{{affiliate.refCode}}</text>
        </view>
      </view>
    </view>

    <view wx:if="{{loading}}" class="portal-loading">
      <text class="portal-loading__text">加载中…</text>
    </view>

    <view wx:if="{{err}}" class="mp-sub-card portal-error">
      <text class="portal-error__text">{{err}}</text>
      <button class="portal-btn portal-btn--ghost" bindtap="onRetryLoad">重新加载</button>
    </view>

    <view wx:if="{{!loading && !err && !affiliate}}" class="mp-sub-card portal-empty">
      <view class="mp-empty-v2">
        <text class="mp-empty-v2__icon">📣</text>
        <text class="mp-empty-v2__title">尚未成为推广员</text>
        <text class="mp-empty-v2__sub">点击申请即成为推广员，并获得专属推广二维码。</text>
        <button class="portal-btn portal-btn--primary" bindtap="onGoApply">申请成为推广员</button>
      </view>
    </view>

    <view wx:if="{{affiliate && affiliate.status !== 'active'}}" class="mp-sub-card">
      <view class="mp-sub-card__head">
        <view class="mp-sub-card__dot"></view>
        <text class="mp-sub-card__title">申请状态</text>
      </view>
      <text class="portal-status-line">当前状态：{{statusLabel}}</text>
      <text class="portal-status-sub" wx:if="{{affiliate.status === 'pending' || affiliate.status === 'rejected'}}">回到申请页点击申请，即可开通并生成推广二维码。</text>
      <button class="portal-btn portal-btn--ghost" bindtap="onGoApply">查看申请 / 重新申请</button>
    </view>

    <view wx:if="{{wallet}}" class="mp-sub-card">
      <view class="mp-sub-card__head">
        <view class="mp-sub-card__dot"></view>
        <text class="mp-sub-card__title">佣金概览</text>
      </view>
      <view class="stats-grid">
        <view class="stat-card stat-card--green">
          <text class="stat-card__label">可提现</text>
          <text class="stat-card__value">¥{{wallet.availableYuan}}</text>
        </view>
        <view class="stat-card stat-card--amber">
          <text class="stat-card__label">冻结中</text>
          <text class="stat-card__value">¥{{wallet.frozenYuan}}</text>
        </view>
        <view class="stat-card">
          <text class="stat-card__label">已提现</text>
          <text class="stat-card__value">¥{{wallet.withdrawnYuan}}</text>
        </view>
        <view class="stat-card stat-card--violet">
          <text class="stat-card__label">累计结算</text>
          <text class="stat-card__value">¥{{stats.settlementTotalYuan}}</text>
        </view>
      </view>
    </view>

    <view wx:if="{{wallet && withdrawGate}}" class="mp-sub-card">
      <view class="mp-sub-card__head">
        <view class="mp-sub-card__dot"></view>
        <text class="mp-sub-card__title">提现申请</text>
      </view>
      <text class="withdraw-hint">{{withdrawGate.windowHint}}</text>
      <text class="withdraw-hint withdraw-hint--muted">{{withdrawGate.payoutHint}}</text>
      <text class="withdraw-hint withdraw-hint--muted">单笔 ¥{{withdrawGate.minYuan}}–¥{{withdrawGate.maxYuan}} · 本月上限 ¥{{withdrawGate.monthlyCapYuan}}</text>
      <view class="withdraw-form">
        <input
          class="withdraw-input"
          type="digit"
          placeholder="输入提现金额（元）"
          value="{{withdrawAmount}}"
          disabled="{{!withdrawGate.open || withdrawing}}"
          bindinput="onWithdrawAmountInput"
        />
        <button class="portal-btn portal-btn--ghost portal-btn--sm" bindtap="onWithdrawAll" disabled="{{!withdrawGate.open || withdrawing}}">全部</button>
        <button
          class="portal-btn portal-btn--primary portal-btn--sm"
          bindtap="onSubmitWithdraw"
          loading="{{withdrawing}}"
          disabled="{{!withdrawGate.open || withdrawing}}"
        >{{withdrawGate.open ? '申请提现' : '非申请时段'}}</button>
      </view>
      <text wx:if="{{!withdrawGate.open}}" class="withdraw-closed">提现按钮仅在每月 {{withdrawGate.windowStartDay}}–{{withdrawGate.windowEndDay}} 日开启</text>
      <view wx:if="{{withdrawHint}}" class="withdraw-toast">{{withdrawHint}}</view>
    </view>

    <view wx:if="{{wallet && withdrawGate}}" class="mp-sub-card">
      <view class="mp-sub-card__head">
        <view class="mp-sub-card__dot"></view>
        <text class="mp-sub-card__title">提现申请明细</text>
      </view>
      <view wx:if="{{!withdrawRequests.length}}" class="withdraw-empty">暂无提现记录，提交申请后将在此显示进度。</view>
      <view class="withdraw-list" wx:else>
        <view class="withdraw-item" wx:for="{{withdrawRequests}}" wx:key="id">
          <view class="withdraw-item__row">
            <text class="withdraw-item__amount">¥{{item.amountYuan}}</text>
            <text class="withdraw-item__status withdraw-item__status--{{item.statusClass}}">{{item.statusLabel}}</text>
          </view>
          <text class="withdraw-item__meta">申请 {{item.createdAtText}}{{item.paidAtText ? ' · 打款 ' + item.paidAtText : ''}}</text>
          <text wx:if="{{item.failReason}}" class="withdraw-item__fail">{{item.failReason}}</text>
        </view>
      </view>
    </view>

    <view wx:if="{{promoLinks}}" class="mp-sub-card">
      <view class="mp-sub-card__head">
        <view class="mp-sub-card__dot"></view>
        <text class="mp-sub-card__title">推广链接与二维码</text>
      </view>
      <text class="wxacode-tip" wx:if="{{commissionHint}}">{{commissionHint}}</text>
      <text class="wxacode-tip">网站二维码用手机扫码打开注册页；小程序二维码请用微信扫一扫。</text>
      <view class="link-item" wx:for="{{linkRows}}" wx:key="key">
        <view class="link-qr">
          <image
            wx:if="{{item.key === 'mp' ? wxacodePath : item.qr}}"
            class="link-qr__img"
            src="{{item.key === 'mp' ? wxacodePath : item.qr}}"
            mode="aspectFit"
            show-menu-by-longpress
          />
          <text wx:else class="link-qr__wait">{{item.key === 'mp' && wxacodeErr ? wxacodeErr : '生成中'}}</text>
        </view>
        <view class="link-item__main">
          <text class="link-item__label">{{item.label}}</text>
          <text class="link-item__url">{{item.url}}</text>
          <view class="link-item__actions">
            <button class="link-item__copy" size="mini" data-url="{{item.url}}" data-label="{{item.label}}" bindtap="onCopyLink">复制{{item.copyLabel}}</button>
            <button class="link-item__copy" size="mini" data-key="{{item.key}}" bindtap="onDownloadQr">下载二维码</button>
          </view>
        </view>
      </view>
      <button wx:if="{{wxacodeErr}}" class="portal-btn portal-btn--ghost portal-btn--sm" bindtap="loadWxacode">重新生成小程序码</button>
    </view>

    <view wx:if="{{promoLinks && attributionStats}}" class="mp-sub-card">
      <view class="mp-sub-card__head">
        <view class="mp-sub-card__dot"></view>
        <text class="mp-sub-card__title">推广商户明细</text>
      </view>
      <text class="attrib-summary">累计注册 {{attributionStats.registrations}} · 已付费 {{attributionStats.paidCount}} · ¥{{attributionStats.paidAmountYuan}}</text>
      <view wx:if="{{!attributions.length}}" class="attrib-empty">暂无推广记录，分享太阳码或链接后即可在此查看。</view>
      <view class="attrib-item" wx:for="{{attributions}}" wx:key="id">
        <view class="attrib-item__row">
          <text class="attrib-item__name">{{item.subjectLabel || '—'}}</text>
          <text class="attrib-item__paid">{{item.paidYuan ? '¥' + item.paidYuan : '未付费'}}</text>
        </view>
        <text class="attrib-item__meta">{{item.subjectTypeLabel}} · {{item.landingLabel}} · {{item.boundAtText}}</text>
      </view>
    </view>

    <view wx:if="{{settlements.length}}" class="mp-sub-card portal-settle-card">
      <view class="mp-sub-card__head">
        <view class="mp-sub-card__dot"></view>
        <text class="mp-sub-card__title">近期结算</text>
      </view>
      <view class="settle-item" wx:for="{{settlements}}" wx:key="id">
        <view class="settle-item__row">
          <text class="settle-item__period">{{item.periodStart}} ~ {{item.periodEnd}}</text>
          <text class="settle-item__status">{{item.statusLabel}}</text>
        </view>
        <text class="settle-item__meta">{{item.orderCount}} 单 · ¥{{item.totalYuan}}</text>
      </view>
    </view>

    <view class="portal-safe-bottom"></view>
  </scroll-view>
  <site-icp-footer />
</view>
