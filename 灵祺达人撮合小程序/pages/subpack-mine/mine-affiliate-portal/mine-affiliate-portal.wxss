@import '../../../styles/mp-mine-sub-hero.wxss';

.portal-page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: linear-gradient(180deg, #ede9fe 0%, #f8fafc 28%, #f1f5f9 100%);
  box-sizing: border-box;
}

.portal-scroll {
  flex: 1;
  height: 0;
  padding: 24rpx 28rpx 0;
  box-sizing: border-box;
}

.portal-safe-bottom {
  height: calc(48rpx + env(safe-area-inset-bottom));
}

.portal-loading {
  padding: 48rpx 0;
  text-align: center;
}

.portal-loading__text {
  font-size: 28rpx;
  color: #64748b;
}

.portal-hint {
  display: block;
  margin: 0 0 16rpx;
  padding: 16rpx 20rpx;
  border-radius: 16rpx;
  background: rgba(109, 40, 217, 0.08);
  color: #6d28d9;
  font-size: 24rpx;
  text-align: center;
}

.portal-error__text {
  display: block;
  font-size: 26rpx;
  line-height: 1.6;
  color: #dc2626;
  margin-bottom: 20rpx;
}

.portal-empty {
  padding: 0;
}

.portal-status-line {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: #334155;
}

.portal-status-sub {
  display: block;
  margin-top: 10rpx;
  font-size: 24rpx;
  line-height: 1.55;
  color: #64748b;
}

.portal-btn {
  margin-top: 20rpx;
  border-radius: 999rpx;
  font-size: 28rpx;
  font-weight: 600;
  border: none;
}

.portal-btn--primary {
  background: linear-gradient(135deg, #7c3aed, #6d28d9);
  color: #fff;
}

.portal-btn--ghost {
  background: #fff;
  color: #475569;
  border: 1rpx solid #e2e8f0;
}

.portal-btn--sm {
  margin-top: 0;
  font-size: 24rpx;
  padding: 0 28rpx;
  line-height: 64rpx;
  height: 64rpx;
}

.wxacode-box {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 360rpx;
  padding: 24rpx;
  border-radius: 24rpx;
  background: linear-gradient(145deg, #faf5ff, #fff);
  border: 1rpx dashed #c4b5fd;
}

.wxacode-box__img {
  width: 320rpx;
  height: 320rpx;
  border-radius: 50%;
}

.wxacode-box__loading,
.wxacode-box__fail {
  font-size: 26rpx;
  color: #64748b;
  text-align: center;
  line-height: 1.6;
}

.wxacode-tip {
  display: block;
  margin-top: 16rpx;
  font-size: 22rpx;
  line-height: 1.55;
  color: #94a3b8;
}

.wxacode-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 20rpx;
}

.wxacode-actions .portal-btn {
  flex: 1;
  margin-top: 0;
}

.link-item {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f1f5f9;
}

.link-item:last-child {
  border-bottom: none;
  padding-bottom: 0;
}

.link-item__main {
  flex: 1;
  min-width: 0;
}

.link-item__label {
  display: block;
  font-size: 24rpx;
  font-weight: 600;
  color: #475569;
}

.link-item__url {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  line-height: 1.5;
  color: #64748b;
  word-break: break-all;
}

.link-item__copy {
  flex-shrink: 0;
  margin: 0;
  padding: 0 20rpx;
  height: 56rpx;
  line-height: 56rpx;
  font-size: 22rpx;
  color: #6d28d9;
  background: #f5f3ff;
  border: 1rpx solid #ddd6fe;
  border-radius: 999rpx;
}

.stats-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
}

.stat-card {
  padding: 24rpx 20rpx;
  border-radius: 20rpx;
  background: #f8fafc;
  border: 1rpx solid #e2e8f0;
}

.stat-card--green {
  background: #ecfdf5;
  border-color: #a7f3d0;
}

.stat-card--amber {
  background: #fffbeb;
  border-color: #fde68a;
}

.stat-card--violet {
  background: #f5f3ff;
  border-color: #ddd6fe;
}

.stat-card__label {
  display: block;
  font-size: 22rpx;
  color: #64748b;
}

.stat-card__value {
  display: block;
  margin-top: 10rpx;
  font-size: 34rpx;
  font-weight: 800;
  color: #0f172a;
}

.settle-item {
  padding: 18rpx 0;
  border-bottom: 1rpx solid #f1f5f9;
}

.settle-item:last-child {
  border-bottom: none;
  padding-bottom: 0;
}

.settle-item__row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
}

.settle-item__period {
  font-size: 26rpx;
  font-weight: 600;
  color: #334155;
}

.settle-item__status {
  font-size: 22rpx;
  color: #6d28d9;
  background: #f5f3ff;
  padding: 4rpx 12rpx;
  border-radius: 999rpx;
}

.settle-item__meta {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #64748b;
}

.portal-settle-card {
  margin-bottom: 8rpx;
}

.attrib-summary {
  display: block;
  margin-bottom: 16rpx;
  font-size: 22rpx;
  color: #64748b;
}

.attrib-empty {
  padding: 24rpx 0;
  text-align: center;
  font-size: 24rpx;
  color: #94a3b8;
}

.attrib-item {
  padding: 18rpx 0;
  border-bottom: 1rpx solid #f1f5f9;
}

.attrib-item:last-child {
  border-bottom: none;
  padding-bottom: 0;
}

.attrib-item__row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
}

.attrib-item__name {
  flex: 1;
  font-size: 28rpx;
  font-weight: 600;
  color: #334155;
}

.attrib-item__paid {
  font-size: 24rpx;
  font-weight: 700;
  color: #059669;
}

.attrib-item__meta {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #94a3b8;
}

.withdraw-hint {
  display: block;
  margin-bottom: 10rpx;
  font-size: 22rpx;
  color: #475569;
}

.withdraw-hint--muted {
  color: #94a3b8;
}

.withdraw-form {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 16rpx;
}

.withdraw-input {
  flex: 1;
  height: 72rpx;
  padding: 0 20rpx;
  border-radius: 16rpx;
  background: #f8fafc;
  border: 1rpx solid #e2e8f0;
  font-size: 28rpx;
}

.withdraw-closed {
  display: block;
  margin-top: 12rpx;
  font-size: 22rpx;
  color: #d97706;
}

.withdraw-list {
  margin-top: 20rpx;
  border-top: 1rpx solid #f1f5f9;
}

.withdraw-item {
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f1f5f9;
}

.withdraw-item:last-child {
  border-bottom: none;
}

.withdraw-item__row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.withdraw-item__amount {
  font-size: 28rpx;
  font-weight: 600;
  color: #334155;
}

.withdraw-item__status {
  font-size: 24rpx;
  color: #059669;
}

.withdraw-item__meta {
  display: block;
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #94a3b8;
}
