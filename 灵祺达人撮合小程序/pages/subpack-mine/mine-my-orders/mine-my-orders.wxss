.orders-page {
  min-height: 100vh;
  background: #f8fafc;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
}

.orders-tabs {
  display: flex;
  gap: 8rpx;
  padding: 16rpx 20rpx;
  background: #fff;
  border-bottom: 1rpx solid #e2e8f0;
  flex-shrink: 0;
}

.orders-tab {
  flex: 1;
  text-align: center;
  padding: 12rpx 0;
  border-radius: 999rpx;
  font-size: 24rpx;
  color: #64748b;
  background: #f1f5f9;
}

.orders-scroll {
  flex: 1;
  height: 0;
  padding: 20rpx 28rpx calc(120rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.usage-note {
  margin-bottom: 20rpx;
  padding: 20rpx 24rpx;
  border-radius: 16rpx;
  background: #f5f3ff;
  border: 2rpx solid #ddd6fe;
  color: #5b21b6;
  font-size: 24rpx;
  line-height: 1.5;
}

.usage-card {
  margin-bottom: 20rpx;
  padding: 24rpx;
  border-radius: 20rpx;
  background: #fff;
  border: 2rpx solid #e2e8f0;
}

.usage-card__title {
  font-size: 30rpx;
  font-weight: 700;
  color: #0f172a;
}

.usage-sub {
  font-size: 24rpx;
  font-weight: 400;
  color: #94a3b8;
}

.usage-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20rpx 24rpx;
  margin-top: 20rpx;
}

.usage-cell {
  min-width: 0;
}

.usage-dt {
  display: block;
  font-size: 22rpx;
  color: #94a3b8;
}

.usage-dd {
  display: block;
  margin-top: 6rpx;
  font-size: 28rpx;
  font-weight: 600;
  color: #334155;
}

.usage-dd--primary {
  font-size: 36rpx;
  color: #7c3aed;
}

.usage-empty {
  margin-top: 16rpx;
  font-size: 26rpx;
  color: #94a3b8;
}

.quota-list {
  margin-top: 16rpx;
}

.quota-row {
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f1f5f9;
}

.quota-row:last-child {
  border-bottom: none;
}

.quota-label {
  display: block;
  font-size: 26rpx;
  color: #0f172a;
  line-height: 1.4;
}

.quota-metrics {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #64748b;
}

.quota-used {
  color: #b45309;
}

.quota-left {
  color: #15803d;
  font-weight: 600;
}

.ledger-list {
  margin-top: 8rpx;
}

.ledger-row {
  display: flex;
  justify-content: space-between;
  gap: 16rpx;
  padding: 18rpx 0;
  border-bottom: 1rpx solid #f1f5f9;
}

.ledger-row:last-child {
  border-bottom: none;
}

.ledger-kind {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: #0f172a;
}

.ledger-note {
  display: block;
  margin-top: 4rpx;
  font-size: 22rpx;
  color: #94a3b8;
}

.ledger-time {
  display: block;
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #94a3b8;
}

.ledger-side {
  flex-shrink: 0;
  text-align: right;
}

.ledger-points {
  display: block;
  font-size: 28rpx;
  font-weight: 700;
  color: #b45309;
}

.ledger-balance {
  display: block;
  margin-top: 4rpx;
  font-size: 22rpx;
  color: #94a3b8;
}

.orders-section-title {
  margin: 8rpx 0 16rpx;
  font-size: 30rpx;
  font-weight: 700;
  color: #0f172a;
}

.orders-tab.is-active {
  color: #fff;
  font-weight: 700;
  background: linear-gradient(135deg, #7c3aed, #a855f7);
}

.orders-state {
  padding: 64rpx 28rpx;
  text-align: center;
  color: #64748b;
  font-size: 28rpx;
}

.orders-state--compact {
  padding: 32rpx 0;
}

.orders-state--err {
  color: #dc2626;
}

.order-card {
  margin-bottom: 20rpx;
  padding: 24rpx;
  border-radius: 20rpx;
  background: #fff;
  border: 2rpx solid #e2e8f0;
}

.order-card--hl {
  border-color: #a855f7;
  box-shadow: 0 0 0 4rpx rgba(168, 85, 247, 0.15);
}

.order-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
}

.order-kind {
  display: block;
  font-size: 22rpx;
  color: #94a3b8;
}

.order-title {
  display: block;
  margin-top: 6rpx;
  font-size: 30rpx;
  font-weight: 700;
  color: #0f172a;
}

.order-status {
  flex-shrink: 0;
  font-size: 22rpx;
  padding: 6rpx 14rpx;
  border-radius: 999rpx;
  font-weight: 600;
}

.order-status--confirmed {
  background: #dcfce7;
  color: #15803d;
}

.order-status--pending {
  background: #fef3c7;
  color: #b45309;
}

.order-status--rejected {
  background: #f1f5f9;
  color: #64748b;
}

.order-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx 20rpx;
  margin-top: 20rpx;
}

.order-dt {
  display: block;
  font-size: 22rpx;
  color: #94a3b8;
}

.order-dd {
  display: block;
  margin-top: 4rpx;
  font-size: 26rpx;
  color: #334155;
  word-break: break-all;
}

.order-no {
  display: block;
  margin-top: 16rpx;
  font-size: 20rpx;
  color: #94a3b8;
  font-family: monospace;
}

.orders-refresh {
  position: fixed;
  left: 50%;
  bottom: calc(32rpx + env(safe-area-inset-bottom));
  transform: translateX(-50%);
  padding: 14rpx 36rpx;
  border-radius: 999rpx;
  background: #fff;
  border: 2rpx solid #ddd6fe;
  color: #7c3aed;
  font-size: 26rpx;
  font-weight: 600;
  box-shadow: 0 8rpx 24rpx rgba(124, 58, 237, 0.12);
}
