<view class="xingxuan-page {{lqThemeClass}}">
  <view class="xingxuan-tabs">
    <text class="xingxuan-tab {{activeTab === 'blacklist' ? 'xingxuan-tab--on' : ''}}" data-tab="blacklist" bindtap="onSwitchTab">黑名单</text>
    <text class="xingxuan-tab {{activeTab === 'graylist' ? 'xingxuan-tab--on' : ''}}" data-tab="graylist" bindtap="onSwitchTab">灰名单</text>
  </view>
  <view class="xingxuan-card">
    <text class="xingxuan-hint">团队内共享 · 黑名单拦截报名 · 灰名单审核警示</text>
  </view>
  <view wx:if="{{!entries.length}}" class="xingxuan-empty">暂无{{activeTab === 'blacklist' ? '黑' : '灰'}}名单达人</view>
  <view wx:for="{{entries}}" wx:key="id" class="xingxuan-card item">
    <text class="name">{{item.displayName}}</text>
    <text class="sub">{{item.platform || '—'}} · {{item.platformAccount || item.talentMemberId || '—'}}</text>
    <text class="note warn" wx:if="{{item.reason}}">{{item.reason}}</text>
    <button class="xingxuan-btn xingxuan-btn--danger btn danger sm" data-id="{{item.id}}" bindtap="remove">移出</button>
  </view>
</view>
