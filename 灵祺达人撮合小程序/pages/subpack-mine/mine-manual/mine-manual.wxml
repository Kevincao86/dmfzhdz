<scroll-view class="manual-page" scroll-y enhanced show-scrollbar="{{false}}">
  <view class="card manual-hero">
    <text class="title-lg">{{productName}}</text>
    <text class="hint">运营台维护的图文使用手册 · 微信 / 抖音小程序同步展示</text>
  </view>

  <view wx:if="{{loading}}" class="card manual-state">
    <text class="hint">加载使用手册…</text>
  </view>

  <view wx:elif="{{err}}" class="card manual-state manual-state--err">
    <text class="hint">加载失败：{{err}}</text>
    <button class="manual-retry-btn" size="mini" bindtap="loadManual">重试</button>
  </view>

  <block wx:elif="{{fromRemote && categoryTabs.length}}">
    <scroll-view class="manual-cat-scroll" scroll-x enhanced show-scrollbar="{{false}}">
      <view class="manual-cat-row">
        <view
          wx:for="{{categoryTabs}}"
          wx:key="id"
          class="manual-cat-chip {{activeCatId === item.id ? 'manual-cat-chip--on' : ''}}"
          data-id="{{item.id}}"
          bindtap="onCatTap"
        >
          <text wx:if="{{item.group}}" class="manual-cat-group">{{item.group}} · </text>
          <text>{{item.title}}</text>
        </view>
      </view>
    </scroll-view>

    <view wx:if="{{displayArticles.length}}" wx:for="{{displayArticles}}" wx:key="id" class="card manual-article">
      <text class="section-title section-title--plain">{{item.title}}</text>
      <rich-text wx:if="{{item.bodyHtml}}" class="manual-rich" nodes="{{item.bodyHtml}}" />
      <text wx:if="{{item.updatedAt}}" class="hint manual-updated">更新于 {{item.updatedAt}}</text>
    </view>

    <view wx:if="{{!displayArticles.length}}" class="card manual-state">
      <text class="hint">该分类暂无文章，请在运营台「小程序使用手册」中添加。</text>
    </view>
  </block>

  <view wx:else class="card manual-state">
    <text class="hint">暂无手册内容，请在运营管控台维护「小程序使用手册」后下拉刷新。</text>
  </view>

  <view class="card manual-footer">
    <text class="hint">灵祺 AI · 灵祺星选</text>
  </view>
</scroll-view>
