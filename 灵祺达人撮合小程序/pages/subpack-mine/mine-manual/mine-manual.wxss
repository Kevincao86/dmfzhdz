.manual-page {
  height: 100vh;
  box-sizing: border-box;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
}

.manual-hero .title-lg {
  display: block;
  margin-bottom: 8rpx;
}

.manual-state {
  margin-top: 16rpx;
  text-align: center;
}

.manual-state--err .hint {
  color: #dc2626;
}

.manual-retry-btn {
  margin-top: 16rpx;
}

.manual-cat-scroll {
  width: 100%;
  margin-top: 16rpx;
  white-space: nowrap;
}

.manual-cat-row {
  display: flex;
  flex-direction: row;
  gap: 12rpx;
  padding: 0 8rpx 8rpx;
}

.manual-cat-chip {
  flex-shrink: 0;
  padding: 12rpx 20rpx;
  border-radius: 999rpx;
  background: #f1f5f9;
  color: #475569;
  font-size: 24rpx;
}

.manual-cat-chip--on {
  background: #8b6cf6;
  color: #fff;
}

.manual-cat-group {
  opacity: 0.85;
}

.manual-article {
  margin-top: 16rpx;
}

.manual-rich {
  display: block;
  margin-top: 12rpx;
  line-height: 1.6;
  font-size: 28rpx;
  color: #334155;
}

.manual-updated {
  display: block;
  margin-top: 16rpx;
  font-size: 22rpx;
}

.manual-footer {
  margin-top: 16rpx;
  text-align: center;
}
