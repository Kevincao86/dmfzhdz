@import '../../../styles/identity-themes.wxss';

.pts-page {
  min-height: 100vh;
  background: var(--lq-bg);
}

.pts-hero {
  position: relative;
  overflow: hidden;
  padding-bottom: 20rpx;
}

.pts-hero-bg {
  position: absolute;
  inset: 0;
  background: var(--lq-gradient-header);
}

.pts-hero-body {
  position: relative;
  z-index: 2;
  padding: 28rpx 28rpx 40rpx;
}

.pts-title {
  display: block;
  font-size: 40rpx;
  font-weight: 800;
  color: #fff;
}

.pts-sub {
  display: block;
  margin-top: 12rpx;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.9);
  line-height: 1.5;
}

.pts-balance {
  margin-top: 24rpx;
  padding: 20rpx 24rpx;
  border-radius: 16rpx;
  background: rgba(255, 255, 255, 0.15);
}

.pts-balance-label {
  display: block;
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.85);
}

.pts-balance-val {
  display: block;
  margin-top: 8rpx;
  font-size: 44rpx;
  font-weight: 800;
  color: #fff;
}

.pts-orders-link {
  position: absolute;
  right: 28rpx;
  bottom: 20rpx;
  z-index: 3;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.95);
}

.pts-body {
  padding: 24rpx 24rpx 48rpx;
}

.pts-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20rpx;
}

.pts-tier {
  padding: 24rpx;
  border-radius: 20rpx;
  background: #fff;
  box-shadow: 0 8rpx 24rpx rgba(15, 23, 42, 0.06);
}

.pts-tier-label {
  display: block;
  font-size: 22rpx;
  color: #7c3aed;
  font-weight: 600;
}

.pts-tier-points {
  display: block;
  margin-top: 12rpx;
  font-size: 36rpx;
  font-weight: 800;
  color: #0f172a;
}

.pts-tier-yuan {
  display: block;
  margin-top: 8rpx;
  font-size: 26rpx;
  color: #64748b;
}

.pts-state {
  padding: 48rpx 28rpx;
  text-align: center;
  color: #64748b;
  font-size: 28rpx;
}

.pts-state--err {
  color: #dc2626;
}

.pts-pay-mask {
  position: fixed;
  inset: 0;
  z-index: 1000;
  background: rgba(15, 23, 42, 0.45);
  display: flex;
  align-items: flex-end;
}

.pts-pay-sheet {
  width: 100%;
  padding: 32rpx 28rpx calc(32rpx + env(safe-area-inset-bottom));
  border-radius: 24rpx 24rpx 0 0;
  background: #fff;
}

.pts-pay-title {
  display: block;
  font-size: 34rpx;
  font-weight: 700;
  color: #0f172a;
}

.pts-pay-amount {
  display: block;
  margin-top: 12rpx;
  font-size: 28rpx;
  color: #64748b;
}

.pts-pay-hint,
.pts-pay-done,
.pts-pay-err {
  display: block;
  margin-top: 16rpx;
  font-size: 24rpx;
  line-height: 1.5;
}

.pts-pay-hint {
  color: #64748b;
}

.pts-pay-done {
  color: #059669;
}

.pts-pay-err {
  color: #dc2626;
}

.pts-pay-btn {
  margin-top: 28rpx;
  background: var(--lq-primary, #7c3aed);
  color: #fff;
  border-radius: 14rpx;
}

.pts-pay-cancel {
  margin-top: 16rpx;
  background: #f1f5f9;
  color: #475569;
  border-radius: 14rpx;
}
