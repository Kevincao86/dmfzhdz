.la {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 24rpx 24rpx 200rpx;
  background: #f4f2fa;
}

.la-hero {
  padding: 8rpx 8rpx 20rpx;
}

.la-hero__kicker {
  display: block;
  font-size: 22rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
  color: #7c4dff;
}

.la-hero__title {
  display: block;
  margin-top: 8rpx;
  font-size: 44rpx;
  font-weight: 700;
  color: #1f1a2e;
}

.la-hero__sub {
  display: block;
  margin-top: 12rpx;
  font-size: 26rpx;
  line-height: 1.55;
  color: #6e687c;
}

.la-card {
  margin-top: 20rpx;
  padding: 28rpx;
  border-radius: 28rpx;
  background: #fff;
}

.la-sec {
  display: block;
  font-size: 30rpx;
  font-weight: 700;
  color: #1f1a2e;
}

.la-sec__hint,
.la-note {
  display: block;
  margin-top: 10rpx;
  font-size: 24rpx;
  line-height: 1.55;
  color: #8b8499;
}

.la-seg {
  display: flex;
  margin-top: 20rpx;
  padding: 6rpx;
  border-radius: 18rpx;
  background: #f4f2fa;
}

.la-seg__item {
  flex: 1;
  height: 72rpx;
  line-height: 72rpx;
  text-align: center;
  border-radius: 14rpx;
  font-size: 26rpx;
  color: #6e687c;
}

.la-seg__item--on {
  background: #fff;
  color: #5b2dcc;
  font-weight: 700;
  box-shadow: 0 6rpx 16rpx rgba(91, 45, 204, 0.08);
}

.la-docs {
  display: flex;
  gap: 16rpx;
  margin-top: 20rpx;
}

.la-doc {
  position: relative;
  flex: 1;
  height: 200rpx;
  overflow: hidden;
  border-radius: 20rpx;
  border: 1rpx dashed #d9d0ee;
  background: #faf8ff;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.la-doc--wide {
  flex: none;
  width: 100%;
  margin-top: 16rpx;
}

.la-doc__img {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
}

.la-doc__name {
  font-size: 28rpx;
  font-weight: 600;
  color: #3d3558;
}

.la-doc__tip {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #8b8499;
}

.la-doc__badge {
  position: absolute;
  left: 12rpx;
  bottom: 12rpx;
  padding: 4rpx 12rpx;
  border-radius: 999rpx;
  background: rgba(31, 26, 46, 0.72);
  color: #fff;
  font-size: 20rpx;
}

.la-label {
  display: block;
  margin-top: 22rpx;
  font-size: 24rpx;
  color: #6e687c;
}

.la-input,
.la-area {
  box-sizing: border-box;
  width: 100%;
  margin-top: 10rpx;
  border-radius: 16rpx;
  background: #f7f6fb;
  font-size: 28rpx;
  color: #1f1a2e;
}

.la-input {
  height: 88rpx;
  padding: 0 24rpx;
}

.la-area {
  height: 200rpx;
  padding: 20rpx 24rpx;
  line-height: 1.5;
}

.la-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 16rpx 24rpx calc(16rpx + env(safe-area-inset-bottom));
  background: rgba(255, 255, 255, 0.96);
  box-shadow: 0 -8rpx 28rpx rgba(31, 26, 46, 0.06);
}

.la-btn {
  height: 92rpx;
  line-height: 92rpx;
  text-align: center;
  border-radius: 18rpx;
  background: #5b2dcc;
  color: #fff;
  font-size: 30rpx;
  font-weight: 700;
}
