@import '../../../styles/mp-addon-page.wxss';

.oa-bind-page {
  min-height: 100vh;
  padding: 0 24rpx calc(48rpx + env(safe-area-inset-bottom));
  background: linear-gradient(180deg, #eef2ff 0%, var(--lq-bg, #f0eff6) 280rpx);
  box-sizing: border-box;
}

.oa-bind-hero {
  padding: 32rpx 8rpx 28rpx;
}

.oa-bind-hero__badge {
  display: inline-block;
  padding: 8rpx 18rpx;
  font-size: 22rpx;
  font-weight: 700;
  color: #4338ca;
  background: rgba(255, 255, 255, 0.85);
  border-radius: 999rpx;
  border: 1rpx solid rgba(99, 102, 241, 0.2);
}

.oa-bind-hero__title {
  display: block;
  margin-top: 20rpx;
  font-size: 44rpx;
  font-weight: 800;
  color: #1e1b4b;
  line-height: 1.25;
}

.oa-bind-hero__sub {
  display: block;
  margin-top: 16rpx;
  font-size: 26rpx;
  line-height: 1.65;
  color: #475569;
}

.oa-bind-card {
  margin-top: 20rpx;
  padding: 32rpx 28rpx;
  background: #fff;
  border-radius: 24rpx;
  border: 1rpx solid var(--lq-border, #e2e8f0);
  box-shadow: 0 8rpx 32rpx rgba(15, 23, 42, 0.06);
}

.oa-bind-card--center {
  text-align: center;
  padding: 48rpx 28rpx;
}

.oa-bind-card--success {
  text-align: center;
}

.oa-bind-card--qr {
  text-align: center;
}

.oa-bind-card__title {
  display: block;
  font-size: 32rpx;
  font-weight: 700;
  color: #1e293b;
}

.oa-bind-card__title--success {
  color: #047857;
}

.oa-bind-card__desc {
  display: block;
  margin-top: 12rpx;
  font-size: 26rpx;
  line-height: 1.65;
  color: #64748b;
}

.oa-bind-card__desc--center {
  text-align: center;
}

.oa-bind-muted {
  display: block;
  margin-top: 16rpx;
  font-size: 24rpx;
  color: #94a3b8;
}

.oa-bind-muted--center {
  text-align: center;
}

.oa-bind-success-icon {
  width: 96rpx;
  height: 96rpx;
  margin: 0 auto 20rpx;
  line-height: 96rpx;
  text-align: center;
  font-size: 48rpx;
  font-weight: 700;
  color: #fff;
  background: linear-gradient(135deg, #34d399, #059669);
  border-radius: 50%;
  box-shadow: 0 12rpx 28rpx rgba(5, 150, 105, 0.28);
}

.oa-bind-steps {
  margin-top: 24rpx;
}

.oa-bind-step {
  display: flex;
  align-items: flex-start;
  gap: 20rpx;
  padding: 20rpx 0;
}

.oa-bind-step + .oa-bind-step {
  border-top: 1rpx solid #f1f5f9;
}

.oa-bind-step__num {
  flex-shrink: 0;
  width: 48rpx;
  height: 48rpx;
  line-height: 48rpx;
  text-align: center;
  font-size: 24rpx;
  font-weight: 700;
  color: #fff;
  background: linear-gradient(135deg, #7c83ff, #6366f1);
  border-radius: 50%;
}

.oa-bind-step__body {
  flex: 1;
  min-width: 0;
}

.oa-bind-step__title {
  display: block;
  font-size: 28rpx;
  font-weight: 700;
  color: #1e293b;
}

.oa-bind-step__desc {
  display: block;
  margin-top: 6rpx;
  font-size: 24rpx;
  line-height: 1.55;
  color: #64748b;
}

.oa-bind-btn {
  margin: 28rpx 0 0;
  height: 88rpx;
  line-height: 88rpx;
  font-size: 30rpx;
  font-weight: 700;
  border-radius: 16rpx;
  border: none;
}

.oa-bind-btn--primary {
  color: #fff;
  background: linear-gradient(135deg, #7c83ff 0%, #6366f1 100%);
  box-shadow: 0 10rpx 28rpx rgba(99, 102, 241, 0.32);
}

.oa-bind-btn--primary[disabled] {
  opacity: 0.65;
}

.oa-bind-btn--ghost {
  color: #6366f1;
  background: #eef2ff;
}

.oa-bind-qr-frame {
  margin: 28rpx auto 0;
  padding: 24rpx;
  width: 460rpx;
  box-sizing: border-box;
  background: linear-gradient(145deg, #f8fafc, #fff);
  border-radius: 24rpx;
  border: 2rpx solid #e0e7ff;
  box-shadow: inset 0 0 0 1rpx rgba(255, 255, 255, 0.8);
}

.oa-bind-qr-img {
  width: 100%;
  height: 412rpx;
  display: block;
  border-radius: 12rpx;
  background: #fff;
}

.oa-bind-polling {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  margin-top: 24rpx;
  padding: 16rpx 24rpx;
  font-size: 24rpx;
  color: #6366f1;
  background: #eef2ff;
  border-radius: 12rpx;
}

.oa-bind-polling__dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #6366f1;
  animation: oa-bind-pulse 1.2s ease-in-out infinite;
}

@keyframes oa-bind-pulse {
  0%,
  100% {
    opacity: 0.35;
    transform: scale(0.85);
  }
  50% {
    opacity: 1;
    transform: scale(1);
  }
}
