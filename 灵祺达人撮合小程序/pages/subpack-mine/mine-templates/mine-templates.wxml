<page-meta page-style="{{lqPageStyle}}" background-color="{{lqPageBg}}" background-color-top="{{lqNavBg}}" background-color-bottom="{{lqPageBg}}" />
<view class="{{lqAccentClass}} page-shell {{lqThemeClass}} foot-col" style="{{lqPageStyle}}">
  <view wx:if="{{mineGuestMode}}" class="card state-empty">
    <text class="state-empty-icon">🔒</text>
    <text class="empty-title">没有数据，请登录后查看</text>
    <text class="hint">请返回「我的」完成微信登录后再管理报名表模版</text>
  </view>
  <block wx:else>
  <view wx:if="{{useHint}}" class="card">
    <text class="hint">{{useHint}}</text>
  </view>
  <view class="card">
    <view class="tpl-kind-tabs">
      <view class="tpl-kind-tab {{section === 'apply' ? 'tpl-kind-tab--active' : ''}}" data-section="apply" bindtap="onSectionTab">达人必填模版</view>
      <view class="tpl-kind-tab {{section === 'recruit' ? 'tpl-kind-tab--active' : ''}}" data-section="recruit" bindtap="onSectionTab">商单招募模版</view>
    </view>
  </view>
  <block wx:if="{{section === 'apply'}}">
  <view class="card">
    <view class="tpl-kind-tabs">
      <view
        wx:for="{{kindTabs}}"
        wx:key="id"
        class="tpl-kind-tab {{kind === item.id ? 'tpl-kind-tab--active' : ''}}"
        data-kind="{{item.id}}"
        bindtap="onKindTab"
      >
        {{item.label}}
      </view>
    </view>
    <button class="btn-primary" bindtap="onAdd">新建自定义模版</button>
  </view>
  <view wx:for="{{rows}}" wx:key="id" class="card tpl-card">
    <view class="tpl-head">
      <text class="title-lg">{{item.name}}</text>
      <text class="tpl-active-badge" wx:if="{{activeId === item.id}}">使用中</text>
    </view>
    <text class="hint">{{item.fields.length}} 个字段</text>
    <view class="tpl-actions">
      <button class="btn-secondary" size="mini" data-id="{{item.id}}" bindtap="onUseTemplate">{{activeId === item.id ? '使用中' : '使用'}}</button>
      <button class="btn-secondary" size="mini" data-id="{{item.id}}" bindtap="onEdit">编辑</button>
      <button class="btn-secondary" size="mini" data-id="{{item.id}}" bindtap="onDelete">删除</button>
    </view>
  </view>
  <view wx:if="{{!rows.length}}" class="card">
    <text class="hint">暂无模版，点击上方按钮新建</text>
  </view>
  </block>
  <block wx:else>
    <view wx:if="{{!editing}}" class="card">
      <button class="btn-primary tpl-create-btn" bindtap="onCreateFormTemplate">+ 新建商单模版</button>
    </view>
    <block wx:if="{{editing}}">
      <view class="card tpl-card">
        <input class="tpl-edit-name" value="{{editing.name}}" bindinput="onEditName" placeholder="模版名称" />
        <view class="tpl-edit-row" wx:for="{{editFields}}" wx:key="key">
          <text>{{item.label}}</text>
          <switch checked="{{item.on}}" color="#5b2dcc" data-key="{{item.key}}" bindchange="onToggleEditField" />
        </view>
        <view class="tpl-edit-row" wx:for="{{editing.customFields}}" wx:for-item="custom" wx:key="id">
          <text>{{custom.label}}</text>
          <text data-id="{{custom.id}}" bindtap="onRemoveEditCustom">删除</text>
        </view>
        <view class="tpl-edit-add">
          <input class="tpl-edit-name" value="{{customDraft}}" bindinput="onCustomDraft" placeholder="新增字段名称" />
          <text bindtap="onAddEditCustom">添加</text>
        </view>
        <view class="tpl-actions">
          <button class="btn-primary" size="mini" bindtap="onSaveFormEdit">{{editing.id ? '保存修改' : '保存模版'}}</button>
          <button class="btn-secondary" size="mini" bindtap="onCancelFormEdit">取消</button>
        </view>
      </view>
    </block>
    <block wx:else>
      <view wx:for="{{formTpls}}" wx:key="id" class="card tpl-card">
        <view class="tpl-head">
          <text class="title-lg">{{item.name}}</text>
          <text class="tpl-active-badge" wx:if="{{activeFormId === item.id}}">使用中</text>
        </view>
        <text class="hint">发招募时选用的字段</text>
        <view class="tpl-actions">
          <button class="btn-secondary" size="mini" data-id="{{item.id}}" bindtap="onUseFormTemplate">{{activeFormId === item.id ? '使用中' : '使用'}}</button>
          <button class="btn-secondary" size="mini" data-id="{{item.id}}" bindtap="onEditFormTemplate">编辑</button>
          <button class="btn-secondary" size="mini" data-id="{{item.id}}" bindtap="onDeleteFormTemplate">删除</button>
        </view>
      </view>
      <view wx:if="{{!formTpls.length}}" class="card">
        <text class="hint">暂无商单招募模版。点上方「新建商单模版」勾选字段后保存，发招募时点「添加字段」即可套用。</text>
      </view>
    </block>
  </block>
  </block>
  <site-icp-footer />
</view>
