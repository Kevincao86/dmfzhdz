.tpl-kind-tabs {
  display: flex;
  gap: 12rpx;
  margin-bottom: 20rpx;
}

.tpl-kind-tab {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  border-radius: 16rpx;
  font-size: 26rpx;
  color: var(--lq-text-muted, #64748b);
  background: rgba(124, 58, 237, 0.06);
  transition: all 0.2s ease;
}

.tpl-kind-tab--active {
  color: #fff;
  background: var(--lq-primary);
  box-shadow: 0 8rpx 20rpx rgba(124, 58, 237, 0.28);
}

.tpl-card {
  transition: transform 0.2s ease, box-shadow 0.2s ease;
}

.tpl-head {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.tpl-active-badge {
  font-size: 22rpx;
  color: #10b981;
}

.tpl-edit-name {
  width: 100%;
  margin-bottom: 16rpx;
  padding: 16rpx 0;
  font-size: 28rpx;
  border-bottom: 1rpx solid rgba(15, 23, 42, 0.08);
}

.tpl-edit-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 12rpx 0;
  font-size: 28rpx;
}

.tpl-edit-add {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 12rpx;
}

.tpl-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 20rpx;
}

.tpl-create-btn {
  width: 100%;
  margin: 0;
  background: #6d28d9;
  color: #ffffff;
  font-size: 32rpx;
  font-weight: 700;
  border-radius: 16rpx;
}
