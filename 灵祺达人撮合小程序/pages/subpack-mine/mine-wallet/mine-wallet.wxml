<view class="wl">
  <text class="wl-sub">积分、培训保证金和课时费。退保证金后讲师变为未认证，不能发布课程。</text>
  <text wx:if="{{err}}" class="wl-err">{{err}}</text>

  <view class="wl-card" wx:if="{{cashVisible}}">
    <text class="wl-name">{{cashTitle}}</text>
    <block wx:if="{{cashLoading}}">
      <text class="wl-value">…</text>
      <text class="wl-hint">正在读取红包</text>
    </block>
    <block wx:else>
      <text class="wl-value">¥{{cashAvailable}}</text>
      <text class="wl-hint">发出去并分享商单后可领取红包 · 已达标 {{cashOrders}} 单</text>
      <text wx:if="{{cashHint}}" class="wl-hint">{{cashHint}}</text>
      <image wx:if="{{cashPoster}}" class="wl-poster" src="{{cashPoster}}" mode="widthFix" />
      <text wx:if="{{cashRules}}" class="wl-hint">{{cashRules}}</text>
      <view class="wl-btn wl-btn--block" bindtap="onCashWithdraw">提现</view>
      <text class="wl-go" bindtap="onWithdrawOrders">提现记录</text>
    </block>
  </view>

  <view class="wl-card">
    <view class="wl-row">
      <view>
        <text class="wl-name">积分</text>
        <text class="wl-value">{{loading ? '…' : balanceLabel}}</text>
        <text class="wl-hint">用于视频、文稿检核和 Brief 生成</text>
      </view>
      <view class="wl-btn" bindtap="onPoints">去充值</view>
    </view>
  </view>

  <view class="wl-card">
    <view class="wl-row">
      <view>
        <text class="wl-name">培训保证金</text>
        <text class="wl-line">{{depositPaid ? '¥' + yuan + ' 已缴纳' : '¥' + yuan + ' 未缴纳'}}</text>
        <text class="wl-hint">讲师履约保证金，和星选同一份记录</text>
      </view>
      <view wx:if="{{depositPaid}}" class="wl-btn wl-btn--ghost" bindtap="onRefund">退款</view>
      <view wx:else class="wl-btn" bindtap="onPayDeposit">微信支付</view>
    </view>
  </view>

  <view class="wl-card">
    <view class="wl-row">
      <view>
        <text class="wl-name">收款账户绑定</text>
        <text class="wl-line">{{accountBound ? '已绑定' : '未绑定'}}</text>
      </view>
      <view class="wl-btn wl-btn--ghost" bindtap="onBindAccount">{{accountBound ? '修改' : '去绑定'}}</view>
    </view>
  </view>

  <view class="wl-card">
    <text class="wl-name">培训结算提现</text>
    <text class="wl-line">可提现 ¥{{netLabel}}</text>
    <text class="wl-hint">已扣佣金 ¥{{commissionLabel}}，个税 ¥{{taxLabel}}。提现到已绑定的收款账户。</text>
    <view class="wl-rules">
      <text class="wl-rules-title">提现规则</text>
      <view class="wl-rule">
        <text class="wl-rule-k">可提现额度</text>
        <text class="wl-rule-v">以本页「可提现」金额为准。只含已到结算日的课时费净额。单笔最低 0.01 元，单笔最高不超过当前可提现余额，一次提取全部。余额为 0 或未绑定收款账户时不能提现。</text>
      </view>
      <view class="wl-rule">
        <text class="wl-rule-k">每日提现次数</text>
        <text class="wl-rule-v">不设每日次数上限。每笔已到结算日的课时费只能提现 1 次，成功后不再计入可提现。</text>
      </view>
      <view class="wl-rule">
        <text class="wl-rule-k">提现时间</text>
        <text class="wl-rule-v">每天 00:00–23:59（北京时间）均可发起。</text>
      </view>
      <view class="wl-rule">
        <text class="wl-rule-k">到账时间</text>
        <text class="wl-rule-v">提交成功后 1–3 个工作日内打入已绑定收款账户，法定节假日顺延。</text>
      </view>
    </view>
    <view class="wl-btn wl-btn--block" bindtap="onWithdraw">提现</view>
    <text class="wl-go" bindtap="onWithdrawOrders">提现记录</text>
    <text class="wl-go" bindtap="onSettle">查看应付款</text>
  </view>

  <view class="wl-card" bindtap="onOrders">
    <text class="wl-name">支付记录</text>
    <text class="wl-hint">会员开通与积分充值</text>
    <text class="wl-go">查看记录</text>
  </view>
  <site-icp-footer />
</view>
