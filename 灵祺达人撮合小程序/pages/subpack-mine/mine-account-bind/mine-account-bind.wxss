.page { padding: 32rpx; }
.lead, .hint, .masked { display: block; font-size: 24rpx; color: #64748b; line-height: 1.6; }
.grid { display: flex; gap: 16rpx; margin-top: 24rpx; }
.cell { flex: 1; border: 1px solid #e2e8f0; border-radius: 16rpx; padding: 16rpx 8rpx; text-align: center; }
.cell.on { border-color: #f5d08a; background: #fff8eb; }
.cell-logo { width: 56rpx; height: 56rpx; margin: 0 auto 8rpx; border-radius: 12rpx; }
.cell-logo--phone { background: #0ea5e9; display: flex; align-items: center; justify-content: center; }
.cell-logo--mail { background: #f59e0b; display: flex; align-items: center; justify-content: center; }
.cell-glyph--phone { width: 22rpx; height: 36rpx; border-radius: 6rpx; background: #fff; }
.cell-glyph--mail { width: 34rpx; height: 22rpx; border-radius: 4rpx; background: #fff; }
.cell-name { display: block; font-size: 26rpx; color: #1e293b; }
.cell-sub { display: block; margin-top: 8rpx; font-size: 20rpx; color: #94a3b8; }
.masked, .hint { margin-top: 16rpx; }
.form { margin-top: 24rpx; }
.input { background: #fff; border: 1px solid #e2e8f0; border-radius: 12rpx; padding: 16rpx 20rpx; font-size: 28rpx; }
.code-row { display: flex; gap: 12rpx; align-items: center; margin-top: 16rpx; }
.code { flex: 1; }
.ghost { margin: 0; }
.submit { margin-top: 20rpx; background: #f59e0b; color: #fff; }
.submit--ghost { background: #fff; color: #b45309; border: 1px solid #f59e0b; }
.err { display: block; margin-top: 16rpx; color: #dc2626; font-size: 24rpx; }
