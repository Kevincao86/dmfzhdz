<view class="page">
  <text class="lead">和商家小程序一样：手机号、邮箱用验证码绑定。同一号码会把微信和抖音并成一个账号。</text>
  <view class="grid">
    <view class="cell {{ids.wechat ? 'on' : ''}}" data-id="wechat" bindtap="onPick">
      <text class="cell-name">微信</text>
      <text class="cell-sub">{{ids.wechat ? '已绑定' : '未绑定'}}</text>
    </view>
    <view class="cell {{ids.douyin ? 'on' : ''}}" data-id="douyin" bindtap="onPick">
      <text class="cell-name">抖音</text>
      <text class="cell-sub">{{ids.douyin ? '已绑定' : '未绑定'}}</text>
    </view>
    <view class="cell {{ids.phone ? 'on' : ''}}" data-id="phone" bindtap="onPick">
      <text class="cell-name">手机</text>
      <text class="cell-sub">{{ids.phone ? '已绑定' : '未绑定'}}</text>
    </view>
    <view class="cell {{ids.email ? 'on' : ''}}" data-id="email" bindtap="onPick">
      <text class="cell-name">邮箱</text>
      <text class="cell-sub">{{ids.email ? '已绑定' : '未绑定'}}</text>
    </view>
  </view>
  <text class="masked" wx:if="{{ids.phoneMasked || ids.emailMasked}}">{{ids.phoneMasked ? '手机 ' + ids.phoneMasked : ''}}{{ids.phoneMasked && ids.emailMasked ? ' · ' : ''}}{{ids.emailMasked ? '邮箱 ' + ids.emailMasked : ''}}</text>
  <text class="hint" wx:if="{{hint}}">{{hint}}</text>
  <button
    wx:if="{{kind && ((kind === 'phone' && ids.phone) || (kind === 'email' && ids.email)) && !editing}}"
    class="submit submit--ghost"
    bindtap="onStartRebind"
  >换绑</button>
  <view class="form" wx:if="{{kind && (!((kind === 'phone' && ids.phone) || (kind === 'email' && ids.email)) || editing)}}">
    <input class="input" placeholder="{{editing ? (kind === 'phone' ? '新手机号' : '新邮箱') : (kind === 'phone' ? '11 位手机号' : '邮箱')}}" value="{{value}}" bindinput="onValue" />
    <view class="code-row">
      <input class="input code" placeholder="6 位验证码" value="{{code}}" bindinput="onCode" />
      <button class="ghost" size="mini" disabled="{{cooldown > 0}}" bindtap="onSend">{{cooldown > 0 ? cooldown + 's' : '获取验证码'}}</button>
    </view>
    <button class="submit" bindtap="onSubmit" disabled="{{busy}}">{{busy ? '提交中…' : (editing ? '确定' : '绑定')}}</button>
  </view>
  <text class="err" wx:if="{{err}}">{{err}}</text>
</view>
