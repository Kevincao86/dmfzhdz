.tr-page { min-height: 100vh; background: #f6f5fb; padding: 24rpx 28rpx 200rpx; box-sizing: border-box; }
.tr-note { display: block; font-size: 24rpx; color: #8b8798; line-height: 1.5; margin-bottom: 20rpx; }
.tr-actions { display: flex; gap: 16rpx; margin: 20rpx 0 24rpx; }
.tr-action { flex: 1; background: #fff; border: 1rpx solid #ece7f6; border-radius: 20rpx; padding: 18rpx 8rpx; text-align: center; }
.tr-action__name { display: block; font-size: 26rpx; font-weight: 600; color: #1f1a2e; }
.tr-action__state { display: block; margin-top: 6rpx; font-size: 20rpx; color: #7c4dff; }
.tr-action--wait .tr-action__state { color: #9a94a8; }
.tr-seg { display: flex; background: #eceaf3; border-radius: 16rpx; padding: 6rpx; margin-bottom: 24rpx; }
.tr-seg__item { flex: 1; text-align: center; font-size: 26rpx; color: #6b6578; line-height: 64rpx; border-radius: 12rpx; }
.tr-seg__item--on { background: #fff; color: #1f1a2e; font-weight: 600; }
.tr-empty { text-align: center; color: #9a94a8; font-size: 26rpx; padding: 80rpx 0; }
.tr-cities { display: flex; flex-wrap: wrap; gap: 12rpx; margin: -8rpx 0 20rpx; }
.tr-city { font-size: 24rpx; color: #6b6578; background: #f4f3f8; border-radius: 999rpx; padding: 8rpx 20rpx; }
.tr-city--on { background: #1f1a2e; color: #fff; }
.tr-card { display: flex; gap: 16rpx; align-items: center; background: #fff; border: 1rpx solid #f0eef5; border-radius: 20rpx; overflow: hidden; margin-bottom: 20rpx; padding: 16rpx; }
.tr-card__cover { width: 112rpx; height: 112rpx; border-radius: 16rpx; display: block; background: #f4f0ff; flex-shrink: 0; }
.tr-card__cover--ph { display: flex; align-items: center; justify-content: center; color: #5b2dcc; font-size: 28rpx; }
.tr-card__body { flex: 1; min-width: 0; padding: 0; }
.tr-card__title { display: block; font-size: 32rpx; font-weight: 700; color: #1f1a2e; }
.tr-card__host { display: block; margin-top: 6rpx; font-size: 24rpx; color: #8b8798; }
.tr-card__meta { display: flex; align-items: center; gap: 12rpx; margin-top: 14rpx; }
.tr-chip { font-size: 22rpx; color: #5b2dcc; background: #f4f0ff; border-radius: 999rpx; padding: 4rpx 14rpx; }
.tr-when { font-size: 22rpx; color: #6b6578; }
.tr-card__foot { display: flex; align-items: center; justify-content: space-between; margin-top: 16rpx; }
.tr-fee { font-size: 32rpx; font-weight: 700; color: #5b2dcc; }
.tr-go { background: #5b2dcc; color: #fff; font-size: 24rpx; border-radius: 999rpx; padding: 8rpx 28rpx; }
.tr-go--mine { background: #f4f0ff; color: #5b2dcc; }
.tr-fab {
  position: fixed;
  right: 32rpx;
  bottom: calc(32rpx + env(safe-area-inset-bottom));
  z-index: 20;
  min-width: 200rpx;
  height: 88rpx;
  padding: 0 36rpx;
  border-radius: 999rpx;
  background: #5b2dcc;
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 12rpx 28rpx rgba(91, 45, 204, 0.32);
}
.tr-fab__main { font-size: 28rpx; font-weight: 600; line-height: 1; }
.tr-fab--done { background: #fff; color: #5b2dcc; border: 1rpx solid #ddd4f5; box-shadow: 0 8rpx 24rpx rgba(31, 26, 46, 0.08); }
.tr-fab--wait { background: #3d3650; box-shadow: 0 12rpx 28rpx rgba(31, 26, 46, 0.18); }
