<view class="tr-page">
  <text class="tr-note">这里是即将开始的课程。线上课直接报名，线下课可以按城市查看。</text>
  <view class="tr-actions">
    <view class="tr-action" bindtap="onApply">
      <text class="tr-action__name">申请讲师</text>
      <text class="tr-action__state">{{lecturerLabel}}</text>
    </view>
  </view>
  <view class="tr-seg">
    <view class="tr-seg__item {{filter === 'all' ? 'tr-seg__item--on' : ''}}" data-id="all" bindtap="onFilter">全部</view>
    <view class="tr-seg__item {{filter === 'online' ? 'tr-seg__item--on' : ''}}" data-id="online" bindtap="onFilter">线上</view>
    <view class="tr-seg__item {{filter === 'offline' ? 'tr-seg__item--on' : ''}}" data-id="offline" bindtap="onFilter">线下</view>
  </view>
  <view wx:if="{{filter === 'offline'}}" class="tr-cities">
    <text class="tr-city {{cityFilter === '全部' ? 'tr-city--on' : ''}}" data-city="全部" bindtap="onCity">全部</text>
    <text wx:for="{{cities}}" wx:key="*this" class="tr-city {{cityFilter === item ? 'tr-city--on' : ''}}" data-city="{{item}}" bindtap="onCity">{{item}}</text>
  </view>
  <view wx:if="{{enrolled.length}}" class="tr-actions">
    <view class="tr-action">
      <text class="tr-action__name">我报名的</text>
      <text class="tr-action__state">{{enrolled.length}} 门</text>
    </view>
  </view>
  <view wx:for="{{enrolled}}" wx:key="id" class="tr-card">
    <view class="tr-card__body">
      <text class="tr-card__title">{{item.title}}</text>
      <text class="tr-card__host">已支付 ¥{{item.pay}} · {{item.status === 'escrow' ? '待核实' : item.status === 'ready' ? '待结算' : item.status === 'settled' ? '已结算' : '处理中'}}</text>
    </view>
  </view>
  <view wx:if="{{loading}}" class="tr-empty">加载中</view>
  <view wx:elif="{{!shown.length}}" class="tr-empty">还没有即将开始的课程</view>
  <view wx:for="{{shown}}" wx:key="id" class="tr-card" data-id="{{item.id}}" bindtap="onOpen">
    <image wx:if="{{item.posterMp || item.poster}}" class="tr-card__cover" src="{{item.posterMp || item.poster}}" mode="aspectFill" />
    <view wx:else class="tr-card__cover tr-card__cover--ph">培训</view>
    <view class="tr-card__body">
      <text class="tr-card__title">{{item.title}}</text>
      <text class="tr-card__host">{{item.hostRole === 'pr' ? 'PR' : item.hostRole === 'shoot' ? '拍摄' : item.hostRole === 'edit' ? '剪辑' : '达人'}} · {{item.hostName}}</text>
      <view class="tr-card__meta">
        <text class="tr-chip">{{item.mode === 'offline' ? '线下' : '线上'}}</text>
        <text class="tr-when">{{item.whenText || '时间由讲师安排'}}</text>
      </view>
      <view class="tr-card__foot">
        <text class="tr-fee">{{item.fee ? '¥' + item.fee : '费用面议'}}</text>
        <text class="tr-go">报名</text>
      </view>
    </view>
  </view>
</view>
