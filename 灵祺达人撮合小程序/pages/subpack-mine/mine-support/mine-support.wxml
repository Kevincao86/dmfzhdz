<view class="page-shell">
  <view class="card">
    <text class="title-lg">我的客服 · 小灵同学</text>
    <text class="hint">常见问题</text>
  </view>
  <view wx:for="{{faqs}}" wx:key="q" class="card">
    <text class="section-title section-title--plain">{{item.q}}</text>
    <text class="hint">{{item.a}}</text>
  </view>
  <view class="card">
    <button class="btn-primary" bindtap="onContact">联系客服</button>
  </view>
</view>
