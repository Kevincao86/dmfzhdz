@import '../../../styles/xingxuan-subpage.wxss';

.row.between {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.name {
  font-size: 30rpx;
  font-weight: 600;
  color: #0f172a;
}

.sub,
.note {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #64748b;
}

.tags {
  margin-top: 12rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
}

.row-actions {
  margin-top: 16rpx;
  display: flex;
  gap: 16rpx;
}

.btn.sm {
  font-size: 24rpx;
}
