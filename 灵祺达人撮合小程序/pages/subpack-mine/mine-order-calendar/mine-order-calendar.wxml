<view class="cal-page {{lqThemeClass}}">
  <view class="cal-hero">
    <text class="cal-title">商单日历</text>
    <text class="cal-sub">{{pageSub}}</text>
    <view class="cal-features">
      <view class="cal-feature cal-feature--green">
        <text class="cal-feature-icon">✓</text>
        <text class="cal-feature-text">近7天待办一目了然</text>
      </view>
      <view class="cal-feature cal-feature--orange">
        <text class="cal-feature-icon">◆</text>
        <text class="cal-feature-text">自定义标签小程序同步</text>
      </view>
      <view class="cal-feature cal-feature--violet">
        <text class="cal-feature-icon">▦</text>
        <text class="cal-feature-text">周/月视图掌握进度</text>
      </view>
    </view>
  </view>

  <view wx:if="{{loading}}" class="cal-state">加载中…</view>
  <view wx:elif="{{err}}" class="cal-state cal-state--err">{{err}}</view>

  <block wx:else>
    <view class="cal-card cal-todo">
      <view class="cal-todo-head">
        <text class="cal-section-title">近7天待办</text>
        <text class="cal-todo-link" bindtap="onScrollToList">全部待办 ›</text>
      </view>
      <view wx:if="{{!upcomingTodos.length}}" class="cal-empty cal-empty--compact">近 7 天暂无待办事项</view>
      <scroll-view wx:else scroll-x class="cal-todo-scroll" enhanced show-scrollbar="{{false}}">
        <view
          wx:for="{{upcomingTodos}}"
          wx:key="id"
          class="cal-todo-card cal-todo-card--{{item.tone}} {{item.selected ? 'cal-todo-card--active' : ''}}"
          data-url="{{item.navUrl}}"
          data-date-key="{{item.dateKey}}"
          bindtap="onOpenTodo"
        >
          <text class="cal-todo-date {{item.selected ? 'cal-todo-date--active' : ''}}">{{item.dateShort}}</text>
          <text class="cal-badge cal-badge--{{item.tone}}">{{item.kindLabel}}</text>
          <text wx:if="{{item.customLabelText}}" class="cal-user-label cal-user-label--{{item.customLabelColor}}">{{item.customLabelText}}</text>
          <text class="cal-todo-title">{{item.orderTitle}}</text>
          <text wx:if="{{item.storeName && item.storeName !== item.orderTitle}}" class="cal-todo-store">📍 {{item.storeName}}</text>
          <view class="cal-todo-status">
            <view class="cal-dot cal-dot--{{item.phase}}" />
            <text>{{item.phaseLabel}}</text>
          </view>
        </view>
      </scroll-view>
    </view>

    <view class="cal-card">
      <view class="cal-toolbar">
        <view class="cal-mode">
          <view class="cal-mode-btn {{viewMode === 'week' ? 'cal-mode-btn--on' : ''}}" data-mode="week" bindtap="onToggleViewMode">周视图</view>
          <view class="cal-mode-btn {{viewMode === 'month' ? 'cal-mode-btn--on' : ''}}" data-mode="month" bindtap="onToggleViewMode">月视图</view>
        </view>
        <view class="cal-chip" bindtap="onBackToday">今天</view>
      </view>

      <view class="cal-toolbar cal-toolbar--sub">
        <view class="cal-nav">
          <view class="cal-nav-btn" bindtap="onPrevMonth">‹</view>
          <text class="cal-nav-label">{{navLabel}}</text>
          <view class="cal-nav-btn" bindtap="onNextMonth">›</view>
        </view>
        <view class="cal-legend">
          <view class="cal-legend-item"><view class="cal-dot cal-dot--active" /><text>进行中</text></view>
          <view class="cal-legend-item"><view class="cal-dot cal-dot--pending" /><text>待开始</text></view>
          <view class="cal-legend-item"><view class="cal-dot cal-dot--ended" /><text>已结束</text></view>
        </view>
      </view>

      <view class="cal-week">
        <text wx:for="{{weekLabels}}" wx:key="*this" class="cal-week-cell {{index === 6 ? 'cal-week-cell--sun' : ''}}">{{item}}</text>
      </view>
      <view class="cal-grid {{viewMode === 'week' ? 'cal-grid--week' : ''}}">
        <view
          wx:for="{{grid}}"
          wx:key="dateKey"
          class="cal-day {{item.inMonth || viewMode === 'week' ? '' : 'cal-day--muted'}} {{item.selected ? 'cal-day--selected' : ''}} {{item.isToday && !item.selected ? 'cal-day--today' : ''}}"
          data-key="{{item.dateKey}}"
          bindtap="onSelectDay"
        >
          <text class="cal-day-num {{item.isToday && !item.selected ? 'cal-day-num--today' : ''}}">{{item.day}}</text>
          <text wx:if="{{viewMode === 'week' && item.weekdayShort}}" class="cal-day-week">{{item.weekdayShort}}</text>
          <view wx:if="{{item.summaryLabel}}" class="cal-day-summary">
            <view class="cal-dot cal-dot--{{item.summaryPhase}}" />
            <text>{{item.summaryLabel}}</text>
          </view>
          <view wx:elif="{{item.dotPhase}}" class="cal-dot cal-dot--{{item.dotPhase}}" />
        </view>
      </view>
    </view>

    <view id="cal-event-list" class="cal-card cal-list">
      <text class="cal-section-title">{{selectedDateKey}} 的商单</text>
      <view wx:if="{{!selectedEvents.length}}" class="cal-empty">该日暂无商单安排</view>
      <view wx:for="{{selectedEvents}}" wx:key="id" class="cal-event">
        <view class="cal-event-main" data-url="{{item.navUrl}}" bindtap="onOpenEvent">
          <view class="cal-event-top">
            <view class="cal-event-left">
              <text class="cal-badge cal-badge--{{item.tone}}">{{item.kindLabel}}</text>
              <text wx:if="{{item.customLabelText}}" class="cal-user-label cal-user-label--{{item.customLabelColor}}">{{item.customLabelText}}</text>
              <text class="cal-event-title">{{item.orderTitle}}</text>
              <text wx:if="{{item.storeName && item.storeName !== item.orderTitle}}" class="cal-event-store">📍 {{item.storeName}}</text>
            </view>
            <view class="cal-event-status-wrap">
              <view class="cal-dot cal-dot--{{item.phase}}" />
              <text class="cal-event-status">{{item.statusLabel}}</text>
            </view>
          </view>
          <view class="cal-event-meta">
            <text wx:if="{{item.timeLabel}}">{{item.timeLabel}}</text>
            <text wx:if="{{item.applicantName && isPr}}">达人：{{item.applicantName}}</text>
            <text wx:if="{{item.platform}}">{{item.platform}}</text>
          </view>
          <text class="cal-event-action">{{item.actionLabel}} ›</text>
        </view>
        <view class="cal-event-actions">
          <button
            class="cal-label-btn {{item.customLabelText ? 'cal-label-btn--set cal-label-btn--' + item.customLabelColor : ''}}"
            size="mini"
            hover-class="cal-label-btn--hover"
            data-mp-order-id="{{item.mpOrderId}}"
            data-title="{{item.orderTitle}}"
            catchtap="onSetLabel"
          >{{item.customLabelText || '设标签'}}</button>
          <button
            class="cal-remind-btn {{item.remindSet ? 'cal-remind-btn--set' : ''}}"
            size="mini"
            data-event-id="{{item.id}}"
            data-mp-order-id="{{item.mpOrderId}}"
            data-kind="{{item.kind}}"
            data-date-key="{{item.dateKey}}"
            data-title="{{item.orderTitle}}"
            data-store="{{item.storeName}}"
            catchtap="onSetReminder"
          >{{item.remindSet ? '已设提醒' : '设提醒'}}</button>
        </view>
      </view>
    </view>
  </block>

  <view wx:if="{{labelSheetOpen}}" class="cal-label-mask" catchtouchmove="onLabelSheetNoop" catchtap="onCloseLabelSheet">
    <view class="cal-label-sheet" catchtap="onLabelSheetNoop">
      <view class="cal-label-sheet-head">
        <view class="cal-label-sheet-titles">
          <text class="cal-label-sheet-title">设置商单标签</text>
          <text class="cal-label-sheet-sub">{{labelSheetTitle}}</text>
        </view>
        <view class="cal-label-sheet-close" catchtap="onCloseLabelSheet">×</view>
      </view>
      <view class="cal-label-presets">
        <view
          wx:for="{{labelPresets}}"
          wx:key="text"
          class="cal-label-chip cal-label-chip--{{item.color}}"
          data-text="{{item.text}}"
          data-color="{{item.color}}"
          catchtap="onPickLabelPreset"
        >{{item.text}}</view>
      </view>
      <view class="cal-label-custom-row">
        <input
          class="cal-label-input"
          maxlength="16"
          placeholder="自定义标签（最多16字）"
          value="{{labelCustomText}}"
          bindinput="onLabelCustomInput"
        />
        <view class="cal-label-save {{labelBusy ? 'cal-label-save--busy' : ''}}" catchtap="onSaveCustomLabel">保存</view>
      </view>
      <view
        wx:if="{{labelSheetHasExisting}}"
        class="cal-label-clear {{labelBusy ? 'cal-label-save--busy' : ''}}"
        catchtap="onClearLabel"
      >清除标签</view>
      <text class="cal-label-hint">标签按当前身份保存，与网页商单日历同步</text>
    </view>
  </view>
</view>
