.cal-page {
  min-height: 100vh;
  padding: 24rpx 24rpx 48rpx;
  background: #f0f9ff;
  box-sizing: border-box;
}

.cal-head {
  margin-bottom: 24rpx;
}

.cal-head-row {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
}

.cal-head-actions {
  display: flex;
  gap: 8rpx;
  flex-shrink: 0;
}

.cal-chip {
  padding: 8rpx 16rpx;
  font-size: 22rpx;
  color: #0369a1;
  background: #e0f2fe;
  border-radius: 999rpx;
}

.cal-chip--on {
  color: #fff;
  background: #0284c7;
}

.cal-title {
  display: block;
  font-size: 36rpx;
  font-weight: 700;
  color: #0f172a;
}

.cal-sub {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #64748b;
}

.cal-state {
  padding: 80rpx 0;
  text-align: center;
  font-size: 28rpx;
  color: #64748b;
}

.cal-state--err {
  color: #dc2626;
}

.cal-card {
  background: #fff;
  border-radius: 20rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(15, 23, 42, 0.06);
}

.cal-nav {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.cal-nav-label {
  font-size: 30rpx;
  font-weight: 600;
  color: #0f172a;
}

.cal-nav-btn {
  width: 64rpx;
  height: 64rpx;
  line-height: 64rpx;
  text-align: center;
  font-size: 40rpx;
  color: #0284c7;
  border-radius: 12rpx;
  background: #e0f2fe;
}

.cal-week {
  display: grid;
  grid-template-columns: repeat(7, 1fr);
  margin-bottom: 8rpx;
}

.cal-week-cell {
  text-align: center;
  font-size: 22rpx;
  color: #94a3b8;
  padding: 8rpx 0;
}

.cal-grid {
  display: grid;
  grid-template-columns: repeat(7, 1fr);
  gap: 8rpx;
}

.cal-day {
  position: relative;
  min-height: 72rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border-radius: 12rpx;
}

.cal-day--muted .cal-day-num {
  color: #cbd5e1;
}

.cal-day--selected {
  background: #0284c7;
}

.cal-day--selected .cal-day-num {
  color: #fff;
}

.cal-day--today {
  box-shadow: inset 0 0 0 2rpx rgba(2, 132, 199, 0.5);
}

.cal-day-num {
  font-size: 28rpx;
  color: #334155;
}

.cal-dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  margin-top: 4rpx;
}

.cal-dot--pending {
  background: #0284c7;
}

.cal-dot--active {
  background: #22c55e;
}

.cal-dot--ended {
  background: #ef4444;
}

.cal-day--selected .cal-dot {
  background: #fff;
}

.cal-list-title {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: #0f172a;
  margin-bottom: 16rpx;
}

.cal-empty {
  padding: 48rpx 0;
  text-align: center;
  font-size: 26rpx;
  color: #94a3b8;
}

.cal-event {
  display: flex;
  align-items: stretch;
  gap: 12rpx;
  padding: 20rpx;
  border: 1rpx solid #e2e8f0;
  border-radius: 16rpx;
  margin-bottom: 16rpx;
}

.cal-event-main {
  flex: 1;
  min-width: 0;
}

.cal-event-top {
  display: flex;
  justify-content: space-between;
  gap: 16rpx;
}

.cal-event-left {
  flex: 1;
  min-width: 0;
}

.cal-badge {
  display: inline-block;
  font-size: 20rpx;
  color: #0284c7;
  background: #e0f2fe;
  padding: 2rpx 10rpx;
  border-radius: 8rpx;
  margin-right: 8rpx;
}

.cal-event-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #0f172a;
}

.cal-event-store {
  display: block;
  font-size: 22rpx;
  color: #64748b;
  margin-top: 4rpx;
}

.cal-event-status {
  font-size: 22rpx;
  color: #64748b;
  flex-shrink: 0;
}

.cal-event-meta {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #94a3b8;
}

.cal-event-action {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #0284c7;
  font-weight: 600;
}

.cal-todo-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.cal-todo-count {
  font-size: 22rpx;
  color: #64748b;
}

.cal-todo-scroll {
  white-space: nowrap;
}

.cal-todo-card {
  display: inline-flex;
  flex-direction: column;
  width: 240rpx;
  padding: 16rpx;
  margin-right: 12rpx;
  border-radius: 16rpx;
  vertical-align: top;
}

.cal-todo-card--green { background: #ecfdf5; border: 1rpx solid #bbf7d0; }
.cal-todo-card--orange { background: #fff7ed; border: 1rpx solid #fed7aa; }
.cal-todo-card--red { background: #fef2f2; border: 1rpx solid #fecaca; }
.cal-todo-card--blue { background: #eff6ff; border: 1rpx solid #bfdbfe; }

.cal-todo-date {
  font-size: 20rpx;
  color: #64748b;
}

.cal-todo-title {
  font-size: 24rpx;
  font-weight: 600;
  color: #0f172a;
  margin-top: 6rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.cal-todo-action {
  font-size: 20rpx;
  color: #0284c7;
  margin-top: 8rpx;
}

.cal-legend {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-bottom: 16rpx;
  padding: 0 4rpx;
}

.cal-legend-item {
  display: flex;
  align-items: center;
  gap: 6rpx;
  font-size: 20rpx;
  color: #64748b;
}

.cal-legend-tag {
  display: inline-block;
  width: 24rpx;
  height: 24rpx;
  line-height: 24rpx;
  text-align: center;
  font-size: 16rpx;
  border-radius: 6rpx;
  color: #fff;
}

.cal-legend-tag--orange { background: #f97316; }
.cal-legend-tag--green { background: #22c55e; }

.cal-badge--green { color: #15803d; background: #dcfce7; }
.cal-badge--orange { color: #c2410c; background: #ffedd5; }
.cal-badge--red { color: #b91c1c; background: #fee2e2; }
.cal-badge--blue { color: #1d4ed8; background: #dbeafe; }

.cal-remind-btn {
  flex-shrink: 0;
  margin: 0 !important;
  padding: 0 16rpx !important;
  font-size: 22rpx !important;
  color: #0369a1 !important;
  background: #e0f2fe !important;
  border: none !important;
  line-height: 2 !important;
  align-self: center;
}

.cal-remind-btn::after {
  border: none;
}

.cal-remind-btn--set {
  color: #64748b !important;
  background: #f1f5f9 !important;
}
