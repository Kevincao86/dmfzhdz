.tp {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 24rpx 24rpx 200rpx;
  background: #f4f2fa;
}

.tp-hero { padding: 8rpx 8rpx 8rpx; }
.tp-hero__kicker { display: block; font-size: 22rpx; font-weight: 600; letter-spacing: 2rpx; color: #7c4dff; }
.tp-hero__title { display: block; margin-top: 8rpx; font-size: 44rpx; font-weight: 700; color: #1f1a2e; }
.tp-hero__sub { display: block; margin-top: 12rpx; font-size: 26rpx; line-height: 1.55; color: #6e687c; }

.tp-card, .tp-course {
  margin-top: 20rpx;
  padding: 28rpx;
  border-radius: 28rpx;
  background: #fff;
}
.tp-sec { display: block; font-size: 30rpx; font-weight: 700; color: #1f1a2e; }
.tp-hint, .tp-course__meta, .tp-course__note {
  display: block;
  margin-top: 10rpx;
  font-size: 24rpx;
  line-height: 1.55;
  color: #8b8499;
}
.tp-course__note { color: #b42318; }
.tp-cond { display: flex; justify-content: space-between; margin-top: 18rpx; font-size: 28rpx; color: #1f1a2e; }
.tp-ok { color: #067647; font-weight: 600; }
.tp-wait { color: #b54708; font-weight: 600; }
.tp-label { display: block; margin-top: 22rpx; font-size: 24rpx; color: #6e687c; }
.tp-input, .tp-area {
  width: 100%;
  box-sizing: border-box;
  margin-top: 10rpx;
  border-radius: 18rpx;
  background: #f7f6fb;
  font-size: 28rpx;
  color: #1f1a2e;
}
.tp-input { height: 88rpx; padding: 0 24rpx; }
.tp-area { height: 180rpx; padding: 20rpx 24rpx; line-height: 1.5; }
.tp-seg { display: flex; margin-top: 12rpx; padding: 6rpx; border-radius: 18rpx; background: #f4f2fa; }
.tp-seg__item { flex: 1; height: 72rpx; line-height: 72rpx; text-align: center; border-radius: 14rpx; font-size: 26rpx; color: #6e687c; }
.tp-seg__item--on { background: #fff; color: #5b2dcc; font-weight: 700; }
.tp-select {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 88rpx;
  margin-top: 10rpx;
  padding: 0 24rpx;
  border-radius: 18rpx;
  background: #f7f6fb;
  font-size: 28rpx;
  color: #1f1a2e;
}
.tp-ph { color: #a39cb0; }
.tp-arrow { color: #a39cb0; font-size: 32rpx; }
.tp-when { display: flex; align-items: center; gap: 12rpx; }
.tp-when picker { flex: 1; min-width: 0; }
.tp-when__to { margin-top: 10rpx; flex-shrink: 0; font-size: 24rpx; color: #6e687c; }
.tp-when .tp-select { padding: 0 16rpx; font-size: 26rpx; }
.tp-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 40;
  display: flex;
  align-items: flex-end;
  background: rgba(15, 12, 28, 0.45);
}
.tp-sheet {
  width: 100%;
  max-height: 86vh;
  padding: 28rpx 28rpx calc(28rpx + env(safe-area-inset-bottom));
  border-radius: 28rpx 28rpx 0 0;
  background: #fff;
  box-sizing: border-box;
}
.tp-sheet__head { display: flex; align-items: center; justify-content: space-between; }
.tp-sheet__title { font-size: 34rpx; font-weight: 700; color: #1f1a2e; }
.tp-sheet__x { font-size: 40rpx; color: #8b8499; padding: 0 8rpx; }
.tp-national {
  margin-top: 16rpx;
  height: 72rpx;
  line-height: 72rpx;
  text-align: center;
  border-radius: 16rpx;
  background: #f4f0ff;
  color: #5b2dcc;
  font-size: 28rpx;
  font-weight: 600;
}
.tp-national--on { background: #5b2dcc; color: #fff; }
.tp-dual { display: flex; height: 420rpx; margin-top: 16rpx; overflow: hidden; border-radius: 18rpx; background: #f7f6fb; }
.tp-dual__col { width: 42%; height: 420rpx; }
.tp-dual__col--cities { width: 58%; background: #fff; }
.tp-prov, .tp-city { padding: 22rpx 20rpx; font-size: 26rpx; color: #3d3650; }
.tp-prov--on { background: #fff; color: #5b2dcc; font-weight: 700; }
.tp-city { display: flex; align-items: center; gap: 12rpx; }
.tp-box {
  width: 32rpx;
  height: 32rpx;
  line-height: 32rpx;
  text-align: center;
  border-radius: 8rpx;
  border: 2rpx solid #d5d0e0;
  font-size: 20rpx;
  color: #fff;
}
.tp-box--on { border-color: #5b2dcc; background: #5b2dcc; }
.tp-chips { display: flex; flex-wrap: wrap; gap: 12rpx; margin-top: 16rpx; }
.tp-chip { padding: 8rpx 16rpx; border-radius: 999rpx; background: #f4f0ff; color: #5b2dcc; font-size: 22rpx; }
.tp-chip--off { background: #f4f2fa; color: #6e687c; }
.tp-chip--on { background: #5b2dcc; color: #fff; }
.tp-add-row { display: flex; align-items: center; gap: 12rpx; }
.tp-add-row .tp-input { flex: 1; }
.tp-add { margin-top: 10rpx; height: 88rpx; line-height: 88rpx; padding: 0 28rpx; border-radius: 18rpx; background: #1f1a2e; color: #fff; font-size: 26rpx; }
.tp-sheet .tp-btn { position: static; width: 100%; margin-top: 20rpx; }

.tp-poster {
  position: relative;
  height: 320rpx;
  margin-top: 16rpx;
  border-radius: 24rpx;
  border: 2rpx dashed #d9d0ee;
  background: #f7f4ff;
  overflow: hidden;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}
.tp-poster--web { height: 360rpx; }
.tp-poster--mp { height: 200rpx; }
.tp-poster__img { position: absolute; left: 0; top: 0; width: 100%; height: 100%; }
.tp-poster__name { font-size: 28rpx; font-weight: 600; color: #1f1a2e; }
.tp-poster__tip { margin-top: 8rpx; font-size: 22rpx; color: #8b8499; }
.tp-poster__badge { position: absolute; right: 16rpx; bottom: 16rpx; padding: 6rpx 16rpx; border-radius: 999rpx; background: rgba(31, 26, 46, 0.72); color: #fff; font-size: 22rpx; }

.tp-course { display: flex; gap: 20rpx; padding: 20rpx; }
.tp-course__cover { width: 168rpx; height: 210rpx; border-radius: 18rpx; background: #f4f0ff; flex-shrink: 0; }
.tp-course__cover--ph { display: flex; align-items: center; justify-content: center; color: #7c4dff; font-size: 24rpx; }
.tp-course__body { flex: 1; min-width: 0; }
.tp-course__top { display: flex; align-items: flex-start; justify-content: space-between; gap: 12rpx; }
.tp-course__title { flex: 1; font-size: 30rpx; font-weight: 700; color: #1f1a2e; line-height: 1.35; }
.tp-status { flex-shrink: 0; padding: 4rpx 12rpx; border-radius: 999rpx; font-size: 20rpx; font-weight: 600; }
.tp-status--pending { color: #b54708; background: #fff4e5; }
.tp-status--rejected { color: #b42318; background: #fdecea; }
.tp-status--approved { color: #067647; background: #e8f7ef; }
.tp-actions { display: flex; align-items: center; justify-content: space-between; margin-top: 16rpx; }
.tp-edit { display: inline-block; padding: 0 24rpx; height: 56rpx; line-height: 56rpx; border-radius: 999rpx; background: #f4f0ff; color: #5b2dcc; font-size: 24rpx; font-weight: 600; }
.tp-del { display: inline-block; padding: 0 24rpx; height: 56rpx; line-height: 56rpx; border-radius: 999rpx; background: #fff; color: #b42318; font-size: 24rpx; font-weight: 600; }

.tp-empty { margin-top: 48rpx; text-align: center; color: #9a94a8; font-size: 26rpx; }

.tp-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  gap: 16rpx;
  padding: 16rpx 24rpx calc(16rpx + env(safe-area-inset-bottom));
  background: rgba(244, 242, 250, 0.96);
}
.tp-btn { flex: 1; height: 92rpx; line-height: 92rpx; text-align: center; border-radius: 20rpx; background: #5b2dcc; color: #fff; font-size: 30rpx; font-weight: 600; }
.tp-btn--ghost { flex: 0 0 180rpx; background: #fff; color: #3d3650; border: 1rpx solid #e4dff0; }
.tp-btn--line { background: #fff; color: #5b2dcc; border: 1rpx solid #d9d0ee; }
.tp-bar--stack { flex-direction: column; }
.tp-bar--stack .tp-btn { flex: none; width: 100%; }
