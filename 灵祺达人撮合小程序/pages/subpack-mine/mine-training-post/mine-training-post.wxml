<view class="tp">
  <view class="tp-hero">
    <text class="tp-hero__kicker">本地生活培训</text>
    <text class="tp-hero__title">{{view === 'form' ? (editingId ? '编辑培训' : '新增培训') : '我的课程'}}</text>
    <text class="tp-hero__sub" wx:if="{{view === 'form'}}">详情按图文填写，和电脑上填写的是同一份。改完会重新提交审核。</text>
    <text class="tp-hero__sub" wx:else>查看已提交的课程，可以新增，也可以改已发布的内容。</text>
  </view>

  <view class="tp-card" wx:if="{{!advanced || !paid}}">
    <text class="tp-sec">发布条件</text>
    <view class="tp-cond">
      <text>高级会员</text>
      <text class="{{advanced ? 'tp-ok' : 'tp-wait'}}">{{advanced ? '已开通' : '未开通'}}</text>
    </view>
    <view class="tp-cond">
      <text>保证金 ¥{{yuan}}</text>
      <text class="{{paid ? 'tp-ok' : 'tp-wait'}}">{{paid ? '已缴纳' : '未缴纳'}}</text>
    </view>
    <text class="tp-hint">保证金到我的钱包缴纳。讲师审核通过后即可发布。收款账户在我的钱包绑定。</text>
  </view>

  <block wx:if="{{view === 'list' && !depositOnly}}">
    <view wx:if="{{loading}}" class="tp-empty">加载中</view>
    <view wx:elif="{{!mine.length}}" class="tp-empty">还没有发布培训</view>
    <view wx:for="{{mine}}" wx:key="id" class="tp-course">
      <image wx:if="{{item.posterMp || item.poster}}" class="tp-course__cover" src="{{item.posterMp || item.poster}}" mode="aspectFill" />
      <view wx:else class="tp-course__cover tp-course__cover--ph">海报</view>
      <view class="tp-course__body">
        <view class="tp-course__top">
          <text class="tp-course__title">{{item.title}}</text>
          <text class="tp-status tp-status--{{item.statusKey}}">{{item.statusText}}</text>
        </view>
        <text class="tp-course__meta">{{item.mode === 'offline' ? '线下' : '线上 · 全国'}}{{item.mode === 'offline' && item.city ? ' · ' + item.city : ''}}{{item.mode === 'offline' && item.address ? ' · ' + item.address : ''}}{{item.whenText ? ' · ' + item.whenText : ''}}</text>
        <text class="tp-course__meta">¥{{item.fee || '0'}} · {{item.signupCount || 0}}/{{item.seats}} 人</text>
        <text wx:if="{{item.reviewStatus === 'rejected' && item.reviewNote}}" class="tp-course__note">{{item.reviewNote}}</text>
        <view class="tp-actions">
          <view class="tp-edit" data-id="{{item.id}}" bindtap="onEdit">编辑</view>
          <view class="tp-del" data-id="{{item.id}}" data-title="{{item.title}}" catchtap="onDelete">删除</view>
        </view>
      </view>
    </view>
  </block>

  <block wx:if="{{view === 'form' && advanced && paid}}">
    <view class="tp-card">
      <text class="tp-sec">课程详情</text>
      <text class="tp-hint">封面和正文显示在课程详情页。文字可以加粗、调大小和颜色，最多插入 8 张图。</text>
      <text class="tp-label">详情封面 · 16:9</text>
      <view class="tp-poster tp-poster--web" data-key="detailCover" bindtap="onPoster">
        <image wx:if="{{detailCover}}" class="tp-poster__img" src="{{detailCover}}" mode="aspectFill" />
        <block wx:else>
          <text class="tp-poster__name">上传详情封面</text>
          <text class="tp-poster__tip">不上传时，详情页用星选宣传图</text>
        </block>
        <text wx:if="{{detailCover}}" class="tp-poster__badge">更换</text>
      </view>
      <view class="tp-tools">
        <view class="tp-tool" data-name="bold" catchtap="onFormat">加粗</view>
        <view class="tp-tool" data-name="italic" catchtap="onFormat">斜体</view>
        <view class="tp-tool" data-name="underline" catchtap="onFormat">下划线</view>
        <view class="tp-tool" data-name="strike" catchtap="onFormat">删除线</view>
        <view class="tp-tool" data-name="header" data-value="H2" catchtap="onFormat">标题</view>
        <view class="tp-tool" data-name="align" data-value="left" catchtap="onFormat">居左</view>
        <view class="tp-tool" data-name="align" data-value="center" catchtap="onFormat">居中</view>
        <view class="tp-tool" data-name="align" data-value="right" catchtap="onFormat">居右</view>
        <view class="tp-tool" data-name="fontSize" data-value="16px" catchtap="onFormat">小</view>
        <view class="tp-tool" data-name="fontSize" data-value="20px" catchtap="onFormat">中</view>
        <view class="tp-tool" data-name="fontSize" data-value="24px" catchtap="onFormat">大</view>
        <view class="tp-tool" data-name="color" data-value="#353535" catchtap="onFormat">黑</view>
        <view class="tp-tool" data-name="color" data-value="#c45c26" catchtap="onFormat">橙</view>
        <view class="tp-tool" data-name="color" data-value="#5b2dcc" catchtap="onFormat">紫</view>
        <view class="tp-tool" data-name="list" data-value="bullet" catchtap="onFormat">列表</view>
        <view class="tp-tool" data-name="list" data-value="ordered" catchtap="onFormat">序号</view>
        <view class="tp-tool" data-name="image" catchtap="onFormat">图片</view>
        <view class="tp-tool" data-name="divider" catchtap="onFormat">分割线</view>
      </view>
      <editor id="articleEditor" class="tp-editor" placeholder="从这里开始写正文" bindready="onEditorReady" show-img-size show-img-toolbar show-img-resize></editor>
    </view>

    <view class="tp-card">
      <text class="tp-sec">宣传图</text>
      <text class="tp-hint">星选和小程序各传一张。星选首页贴齐左右，16:9，建议 1500×844。小程序首页广告栏约 3:1，建议 1500×470。</text>
      <text class="tp-label">星选平台 · 16:9</text>
      <view class="tp-poster tp-poster--web" data-key="poster" bindtap="onPoster">
        <image wx:if="{{poster}}" class="tp-poster__img" src="{{poster}}" mode="aspectFill" />
        <block wx:else>
          <text class="tp-poster__name">上传星选宣传图</text>
          <text class="tp-poster__tip">1500×844，课程名放中间</text>
        </block>
        <text wx:if="{{poster}}" class="tp-poster__badge">更换</text>
      </view>
      <text class="tp-label">小程序 · 约 3:1</text>
      <view class="tp-poster tp-poster--mp" data-key="posterMp" bindtap="onPoster">
        <image wx:if="{{posterMp}}" class="tp-poster__img" src="{{posterMp}}" mode="aspectFill" />
        <block wx:else>
          <text class="tp-poster__name">上传小程序宣传图</text>
          <text class="tp-poster__tip">1500×470，重要内容放中间</text>
        </block>
        <text wx:if="{{posterMp}}" class="tp-poster__badge">更换</text>
      </view>
    </view>

    <view class="tp-card">
      <text class="tp-sec">课程信息</text>
      <text class="tp-label">课程名称</text>
      <input class="tp-input" placeholder="如：宁波探店口播训练营" value="{{title}}" bindinput="onTitle" />
      <text class="tp-label">形式</text>
      <view class="tp-seg">
        <view class="tp-seg__item {{mode === 'online' ? 'tp-seg__item--on' : ''}}" data-id="online" bindtap="onMode">线上</view>
        <view class="tp-seg__item {{mode === 'offline' ? 'tp-seg__item--on' : ''}}" data-id="offline" bindtap="onMode">线下</view>
      </view>
      <text class="tp-label">城市</text>
      <view wx:if="{{mode === 'online'}}" class="tp-select">
        <text>全国</text>
      </view>
      <view wx:else class="tp-select" bindtap="onOpenCity">
        <text class="{{cityDisplay ? '' : 'tp-ph'}}">{{cityDisplay || '请选择城市'}}</text>
        <text class="tp-arrow">›</text>
      </view>
      <block wx:if="{{mode === 'online'}}">
        <text class="tp-label">直播平台</text>
        <view class="tp-seg">
          <view class="tp-seg__item {{livePlatform === 'meeting' ? 'tp-seg__item--on' : ''}}" data-id="meeting" bindtap="onLivePlatform">腾讯会议</view>
          <view class="tp-seg__item {{livePlatform === 'channels' ? 'tp-seg__item--on' : ''}}" data-id="channels" bindtap="onLivePlatform">视频号</view>
          <view class="tp-seg__item {{livePlatform === 'douyin' ? 'tp-seg__item--on' : ''}}" data-id="douyin" bindtap="onLivePlatform">抖音</view>
        </view>
        <text class="tp-label">{{livePlatform === 'channels' ? '视频号 ID' : livePlatform === 'douyin' ? '抖音直播链接' : '会议链接或会议号'}}</text>
        <input class="tp-input" placeholder="{{livePlatform === 'channels' ? 'sph 开头，在视频号助手复制' : livePlatform === 'douyin' ? 'https://live.douyin.com/ 或 v.douyin.com' : '会议链接，或 9 到 12 位会议号'}}" value="{{liveUrl}}" bindinput="onLiveUrl" />
        <text class="tp-hint">{{livePlatform === 'channels' ? '会打开这个视频号的直播。该视频号需要已经和本小程序绑定。' : livePlatform === 'douyin' ? '微信里打不开抖音，这里会复制链接，你到浏览器打开。' : '会直接打开腾讯会议。填写会议号才能自动入会。'}}</text>
      </block>
      <block wx:if="{{mode === 'offline'}}">
        <text class="tp-label">具体地址</text>
        <input class="tp-input" placeholder="门牌、楼层或教室" value="{{address}}" bindinput="onAddress" />
        <text class="tp-label">项目联系人</text>
        <input class="tp-input" placeholder="到场对接人" value="{{contactName}}" bindinput="onContactName" />
        <text class="tp-label">联系方式</text>
        <input class="tp-input" placeholder="手机号或微信" value="{{contactWay}}" bindinput="onContactWay" />
      </block>
      <text class="tp-label">上课日期</text>
      <view class="tp-when">
        <picker mode="date" value="{{whenStartDate}}" start="{{todayDate}}" bindchange="onWhenStartDate">
          <view class="tp-select"><text class="{{whenStartDate ? '' : 'tp-ph'}}">{{whenStartDate || '开始日期'}}</text><text class="tp-arrow">›</text></view>
        </picker>
        <text class="tp-when__to">至</text>
        <picker mode="date" value="{{whenEndDate}}" start="{{whenStartDate || todayDate}}" bindchange="onWhenEndDate">
          <view class="tp-select"><text class="{{whenEndDate ? '' : 'tp-ph'}}">{{whenEndDate || '结束日期'}}</text><text class="tp-arrow">›</text></view>
        </picker>
      </view>
      <text class="tp-label">每天时段</text>
      <view class="tp-when">
        <picker mode="time" value="{{whenStartTime}}" bindchange="onWhenStartTime">
          <view class="tp-select"><text>{{whenStartTime || '14:00'}}</text><text class="tp-arrow">›</text></view>
        </picker>
        <text class="tp-when__to">至</text>
        <picker mode="time" value="{{whenEndTime}}" bindchange="onWhenEndTime">
          <view class="tp-select"><text>{{whenEndTime || '16:00'}}</text><text class="tp-arrow">›</text></view>
        </picker>
      </view>
    </view>

    <view class="tp-card">
      <text class="tp-sec">费用与名额</text>
      <text class="tp-label">课时费（元）</text>
      <input class="tp-input" type="digit" placeholder="平台代收，学员支付这个金额" value="{{fee}}" bindinput="onFee" />
      <text class="tp-label">名额</text>
      <input class="tp-input" type="number" value="{{seats}}" bindinput="onSeats" />
      <text class="tp-label">报名字段</text>
      <text class="tp-hint">学员填完才能支付。姓名必留，身份证和手机号可以关掉。</text>
      <view class="tp-chips">
        <view class="tp-chip tp-chip--on" data-key="name" bindtap="onToggleField">姓名 · 必填</view>
        <view class="tp-chip {{signupOn.idNo ? 'tp-chip--on' : 'tp-chip--off'}}" data-key="idNo" bindtap="onToggleField">身份证号</view>
        <view class="tp-chip {{signupOn.phone ? 'tp-chip--on' : 'tp-chip--off'}}" data-key="phone" bindtap="onToggleField">手机号</view>
        <view wx:for="{{customFields}}" wx:key="key" class="tp-chip tp-chip--on" data-key="{{item.key}}" bindtap="onRemoveField">{{item.label}} ×</view>
      </view>
      <view class="tp-add-row">
        <input class="tp-input" placeholder="自定义字段，如微信号" value="{{fieldDraft}}" bindinput="onFieldDraft" />
        <view class="tp-add" bindtap="onAddField">添加</view>
      </view>
    </view>
  </block>

  <view class="tp-bar {{!advanced && !paid ? 'tp-bar--stack' : ''}}" wx:if="{{depositOnly || !advanced || !paid}}">
    <view class="tp-btn tp-btn--line" wx:if="{{!advanced}}" bindtap="onOpenMember">去开通会员</view>
    <view class="tp-btn" wx:if="{{!paid}}" bindtap="onOpenWallet">去钱包缴纳保证金</view>
  </view>
  <view class="tp-bar" wx:elif="{{view === 'list'}}">
    <view class="tp-btn tp-btn--ghost" bindtap="onSettle">课时结算</view>
    <view class="tp-btn" bindtap="onCreate">新增培训</view>
  </view>
  <view class="tp-bar tp-bar--split" wx:else>
    <view class="tp-btn tp-btn--ghost" bindtap="onBack">返回</view>
    <view class="tp-btn" bindtap="onSubmit">{{editingId ? '保存并重新审核' : '提交审核'}}</view>
  </view>

  <view class="tp-mask" wx:if="{{cityOpen}}" catchtouchmove="noop">
    <view class="tp-sheet" catchtap="noop">
      <view class="tp-sheet__head">
        <text class="tp-sheet__title">选择城市</text>
        <text class="tp-sheet__x" bindtap="onCloseCity">×</text>
      </view>
      <text class="tp-hint">可多选城市；选「全国」则不限地域</text>
      <view class="tp-national {{cityNational ? 'tp-national--on' : ''}}" bindtap="onCityNational">全国</view>
      <input class="tp-input" placeholder="搜索省、市" value="{{cityKeyword}}" bindinput="onCityKeyword" />
      <view class="tp-dual">
        <scroll-view class="tp-dual__col" scroll-y>
          <view wx:for="{{cityProvinceRows}}" wx:key="name" class="tp-prov {{item.active ? 'tp-prov--on' : ''}}" data-name="{{item.name}}" bindtap="onCityProvinceTap">{{item.name}}</view>
        </scroll-view>
        <scroll-view class="tp-dual__col tp-dual__col--cities" scroll-y>
          <view wx:for="{{cityCheckGrid}}" wx:key="name" class="tp-city" data-name="{{item.name}}" bindtap="onCityCheckTap">
            <text class="tp-box {{item.on ? 'tp-box--on' : ''}}">{{item.on ? '✓' : ''}}</text>
            <text>{{item.name}}</text>
          </view>
          <view wx:if="{{!cityCheckGrid.length}}" class="tp-hint">暂无匹配城市</view>
        </scroll-view>
      </view>
      <view class="tp-chips" wx:if="{{selectedCities.length}}">
        <view wx:for="{{selectedCities}}" wx:key="*this" class="tp-chip" data-name="{{item}}" bindtap="onRemoveCity">{{item}} ×</view>
      </view>
      <view class="tp-btn" bindtap="onConfirmCity">确认</view>
    </view>
  </view>
  <site-icp-footer />
</view>
