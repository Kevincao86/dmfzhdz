<view class="tp">
  <view class="tp-hero">
    <text class="tp-hero__kicker">本地生活培训</text>
    <text class="tp-hero__title">{{view === 'form' ? (editingId ? '编辑培训' : '新增培训') : '我发布的'}}</text>
    <text class="tp-hero__sub" wx:if="{{view === 'form'}}">改完会重新提交审核。通过前不会出现在首页广告栏。</text>
    <text class="tp-hero__sub" wx:else>查看已提交的课程，可以新增，也可以改已发布的内容。</text>
  </view>

  <view class="tp-card" wx:if="{{!advanced || !paid}}">
    <text class="tp-sec">发布条件</text>
    <view class="tp-cond">
      <text>高级会员</text>
      <text class="{{advanced ? 'tp-ok' : 'tp-wait'}}">{{advanced ? '已开通' : '未开通'}}</text>
    </view>
    <view class="tp-cond">
      <text>保证金 ¥{{yuan}}</text>
      <text class="{{paid ? 'tp-ok' : 'tp-wait'}}">{{paid ? '已缴纳' : '未缴纳'}}</text>
    </view>
    <text class="tp-hint">保证金到我的钱包缴纳。讲师审核通过后即可发布。收款账户在我的钱包绑定。</text>
  </view>

  <block wx:if="{{view === 'list' && !depositOnly}}">
    <view wx:if="{{loading}}" class="tp-empty">加载中</view>
    <view wx:elif="{{!mine.length}}" class="tp-empty">还没有发布培训</view>
    <view wx:for="{{mine}}" wx:key="id" class="tp-course">
      <image wx:if="{{item.poster}}" class="tp-course__cover" src="{{item.poster}}" mode="aspectFill" />
      <view wx:else class="tp-course__cover tp-course__cover--ph">海报</view>
      <view class="tp-course__body">
        <view class="tp-course__top">
          <text class="tp-course__title">{{item.title}}</text>
          <text class="tp-status tp-status--{{item.statusKey}}">{{item.statusText}}</text>
        </view>
        <text class="tp-course__meta">{{item.modeText}}{{item.city ? ' · ' + item.city : ''}}{{item.whenText ? ' · ' + item.whenText : ''}}</text>
        <text class="tp-course__meta">¥{{item.fee || '0'}} · {{item.signupCount || 0}}/{{item.seats}} 人</text>
        <text wx:if="{{item.reviewStatus === 'rejected' && item.reviewNote}}" class="tp-course__note">{{item.reviewNote}}</text>
        <view class="tp-edit" data-id="{{item.id}}" bindtap="onEdit">编辑</view>
      </view>
    </view>
  </block>

  <block wx:if="{{view === 'form' && advanced && paid}}">
    <view class="tp-card">
      <text class="tp-sec">宣传海报</text>
      <text class="tp-hint">竖图更适合首页广告栏。上传后请看清画面。</text>
      <view class="tp-poster" bindtap="onPoster">
        <image wx:if="{{poster}}" class="tp-poster__img" src="{{poster}}" mode="aspectFill" />
        <block wx:else>
          <text class="tp-poster__name">上传海报</text>
          <text class="tp-poster__tip">点击选择图片</text>
        </block>
        <text wx:if="{{poster}}" class="tp-poster__badge">更换</text>
      </view>
    </view>

    <view class="tp-card">
      <text class="tp-sec">课程信息</text>
      <text class="tp-label">课程名称</text>
      <input class="tp-input" placeholder="如：宁波探店口播训练营" value="{{title}}" bindinput="onTitle" />
      <text class="tp-label">形式</text>
      <view class="tp-seg">
        <view class="tp-seg__item {{mode === 'online' ? 'tp-seg__item--on' : ''}}" data-id="online" bindtap="onMode">线上</view>
        <view class="tp-seg__item {{mode === 'offline' ? 'tp-seg__item--on' : ''}}" data-id="offline" bindtap="onMode">线下</view>
      </view>
      <text class="tp-label">城市</text>
      <input class="tp-input" placeholder="{{mode === 'offline' ? '线下上课城市' : '可留空'}}" value="{{city}}" bindinput="onCity" />
      <text class="tp-label">时间</text>
      <input class="tp-input" placeholder="如：周六 14:00" value="{{whenText}}" bindinput="onWhen" />
    </view>

    <view class="tp-card">
      <text class="tp-sec">费用与名额</text>
      <text class="tp-label">课时费（元）</text>
      <input class="tp-input" type="digit" placeholder="平台代收，学员支付这个金额" value="{{fee}}" bindinput="onFee" />
      <text class="tp-label">名额</text>
      <input class="tp-input" type="number" value="{{seats}}" bindinput="onSeats" />
      <text class="tp-label">课程说明</text>
      <textarea class="tp-area" placeholder="这门课解决什么接单问题，适合谁来听" value="{{note}}" bindinput="onNote" />
    </view>
  </block>

  <view class="tp-bar {{!advanced && !paid ? 'tp-bar--stack' : ''}}" wx:if="{{depositOnly || !advanced || !paid}}">
    <view class="tp-btn tp-btn--line" wx:if="{{!advanced}}" bindtap="onOpenMember">去开通会员</view>
    <view class="tp-btn" wx:if="{{!paid}}" bindtap="onOpenWallet">去钱包缴纳保证金</view>
  </view>
  <view class="tp-bar" wx:elif="{{view === 'list'}}">
    <view class="tp-btn" bindtap="onCreate">新增培训</view>
  </view>
  <view class="tp-bar tp-bar--split" wx:else>
    <view class="tp-btn tp-btn--ghost" bindtap="onBack">返回</view>
    <view class="tp-btn" bindtap="onSubmit">{{editingId ? '保存并重新审核' : '提交审核'}}</view>
  </view>
</view>
