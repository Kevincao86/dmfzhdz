<view class="promo-page">
  <view class="promo-hero">
    <view class="promo-hero__badge">限时福利</view>
    <text class="promo-hero__title">免费送你</text>
    <text class="promo-hero__days">{{grantDays}}天</text>
    <text class="promo-hero__sub">灵祺星选专业版会员</text>
    <text class="promo-hero__deadline">活动截止 {{campaignEndLabel}}</text>
  </view>

  <view wx:if="{{booting}}" class="promo-card promo-card--center">
    <text class="promo-muted">正在加载活动信息…</text>
  </view>

  <view wx:elif="{{invalidEntry}}" class="promo-card">
    <text class="promo-card__title">无法进入领取页</text>
    <text class="promo-card__desc">{{err}}</text>
  </view>

  <view wx:elif="{{needLogin}}" class="promo-card">
    <text class="promo-card__title">登录后领取</text>
    <text class="promo-card__desc">本页仅通过海报扫码进入。登录并完成达人资料后，即可一键领取 {{grantDays}} 天专业版会员。</text>
    <button class="promo-btn promo-btn--primary" bindtap="onGoLogin">去登录</button>
  </view>

  <block wx:else>
    <view class="promo-card">
      <text class="promo-card__title" wx:if="{{status === 'available'}}">确认领取</text>
      <text class="promo-card__title" wx:elif="{{status === 'claimed'}}">已领取</text>
      <text class="promo-card__title" wx:else>活动已结束</text>
      <text class="promo-card__desc">{{info}}</text>

      <view class="promo-benefits">
        <view class="promo-benefit">
          <text class="promo-benefit__icon">🔍</text>
          <view class="promo-benefit__body">
            <text class="promo-benefit__title">海量商单</text>
            <text class="promo-benefit__desc">招募大厅实时更新</text>
          </view>
        </view>
        <view class="promo-benefit">
          <text class="promo-benefit__icon">✨</text>
          <view class="promo-benefit__body">
            <text class="promo-benefit__title">AI 高效报名</text>
            <text class="promo-benefit__desc">智能匹配一键接单</text>
          </view>
        </view>
        <view class="promo-benefit">
          <text class="promo-benefit__icon">🎬</text>
          <view class="promo-benefit__body">
            <text class="promo-benefit__title">精准履约</text>
            <text class="promo-benefit__desc">发单到交片完整闭环</text>
          </view>
        </view>
        <view class="promo-benefit">
          <text class="promo-benefit__icon">🛡</text>
          <view class="promo-benefit__body">
            <text class="promo-benefit__title">AI 审核短视频/文稿</text>
            <text class="promo-benefit__desc">按平台规则智能检核</text>
          </view>
        </view>
      </view>

      <text class="promo-muted" wx:if="{{membershipExpiresAt}}">会员有效期至：{{membershipExpiresAt}}</text>
      <text class="promo-muted" wx:if="{{claimedAt}}">领取时间：{{claimedAt}}</text>
      <text class="promo-err" wx:if="{{err}}">{{err}}</text>

      <button
        wx:if="{{status === 'available'}}"
        class="promo-btn promo-btn--primary"
        loading="{{claiming}}"
        disabled="{{claiming}}"
        bindtap="onClaim"
      >立即领取 {{grantDays}} 天会员</button>

      <button
        wx:if="{{status === 'claimed'}}"
        class="promo-btn promo-btn--ghost"
        bindtap="onGoMembership"
      >查看我的会员权益</button>
    </view>
  </block>
  <site-icp-footer />
</view>
