<view class="page" style="bottom: {{keyboardHeight}}px;">
  <view class="status-bar">
    <text class="status-title">{{humanMode ? '人工客服已接入' : '联系客服 · 智能助手'}}</text>
    <text class="status-sub">{{statusSub}}</text>
  </view>

  <scroll-view
    scroll-y
    class="chat-scroll foot-col"
    scroll-into-view="{{scrollTo}}"
    scroll-with-animation
   enable-flex>
    <view
      wx:for="{{messages}}"
      wx:key="id"
      id="msg-{{item.id}}"
      class="bubble-row {{item.role === 'user' ? 'mine' : 'their'}}"
    >
      <view class="bubble bubble-{{item.role}}">
        <text class="bubble-text">{{item.text}}</text>
        <text class="bubble-at">{{item.at}}</text>
      </view>
    </view>
    <view class="scroll-pad"></view>
    <site-icp-footer />
  </scroll-view>

  <view class="composer {{keyboardHeight ? 'composer--kb' : ''}}">
    <button
      wx:if="{{humanOpen && !humanMode}}"
      class="human-btn"
      bindtap="onRequestHuman"
      loading="{{connecting}}"
      disabled="{{connecting || !ready}}"
    >
      {{connecting ? '排队接入中…' : '进入人工客服'}}
    </button>
    <text wx:elif="{{!humanMode}}" class="human-off">人工客服服务时间为 9:00–22:00</text>
    <text wx:if="{{queueHint && !humanMode}}" class="human-off">{{queueHint}}</text>
    <view class="input-row">
      <input
        class="chat-input"
        placeholder="{{humanMode ? '向人工客服描述问题…' : '输入问题，我会先回答'}}"
        value="{{input}}"
        bindinput="onInput"
        confirm-type="send"
        adjust-position="{{false}}"
        bindkeyboardheightchange="onKeyboardHeightChange"
        bindconfirm="onSend"
        disabled="{{!ready}}"
      />
      <button class="send-btn" bindtap="onSend" disabled="{{!ready || !input}}">发送</button>
    </view>
  </view>
</view>
