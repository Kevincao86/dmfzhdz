@import '../../../styles/xingxuan-subpage.wxss';

.plats {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  padding: 8rpx 0 12rpx;
}

.eval-top {
  display: flex;
  align-items: stretch;
  gap: 16rpx;
}

.eval-bottom {
  padding: 0;
}

.eval-top .xingxuan-card {
  height: 100%;
  margin-bottom: 16rpx;
  box-sizing: border-box;
}

.eval-left .ident {
  text-align: left;
  padding: 28rpx 22rpx;
}

.eval-left .avatar,
.eval-left .avatar--ph {
  width: 88rpx;
  height: 88rpx;
  margin: 0 0 16rpx;
  overflow: hidden;
}

.eval-left .avatar--ph {
  line-height: 1;
  font-size: 36rpx;
}

.eval-left .avatar-letter {
  font-size: 36rpx;
  line-height: 1;
}

.eval-left .nick {
  font-size: 32rpx;
}

.eval-left .did {
  font-size: 22rpx;
  line-height: 1.45;
}

.eval-right .hero {
  padding: 20rpx 16rpx 18rpx;
}

.eval-right .label,
.eval-right .level-title,
.eval-right .level {
  font-size: 22rpx;
}

.eval-right .grade-label {
  font-size: 30rpx;
}

.eval-right .grade-note {
  font-size: 20rpx;
}

.eval-right .btn-main {
  margin: 16rpx 0 0;
  padding: 14rpx 8rpx;
  font-size: 22rpx;
  line-height: 1.35;
  border-radius: 14rpx;
}

.eval-bottom .gains {
  padding: 32rpx 24rpx 28rpx;
}

.eval-bottom .gain-k {
  font-size: 22rpx;
  letter-spacing: 1rpx;
}

.eval-bottom .gain-v {
  margin-top: 0;
  font-size: 56rpx;
}

.gain-metric {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-top: 12rpx;
}

.gain-arrow {
  width: 0;
  height: 0;
  flex-shrink: 0;
  border-left: 14rpx solid transparent;
  border-right: 14rpx solid transparent;
  border-bottom: 22rpx solid #7c4dff;
  animation: arrow-rise 1.05s ease-in-out infinite;
}

.eval-bottom .btn-sub {
  margin: 0 0 8rpx;
}

.eval-bottom .advice-title {
  font-size: 22rpx;
  font-weight: 500;
  color: #64748b;
  letter-spacing: 1rpx;
  text-align: left;
}

.plate--on {
  background: #efeaf8;
  box-shadow: inset 0 0 0 2rpx #ddd6fe;
}

.gain-row {
  display: flex;
  gap: 16rpx;
}

.gain-row .gain {
  flex: 1;
  min-width: 0;
  border-top: 0;
  margin-top: 0;
  padding-top: 0;
}

.plate-grid {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  justify-content: space-between;
  width: 100%;
}

.plate-grid .plate {
  width: 48%;
  flex: 0 0 48%;
  max-width: 48%;
  min-width: 0;
  box-sizing: border-box;
  margin-top: 0;
  margin-bottom: 12rpx;
  flex-direction: column;
}

.eval-left {
  width: 48%;
  flex-shrink: 0;
}

.eval-right {
  flex: 1;
  min-width: 0;
}

.eval-left .xingxuan-card,
.eval-right .xingxuan-card {
  margin-left: 0;
  margin-right: 0;
}

.eval-left .ring-stage,
.eval-left .ring,
.eval-right .ring-stage,
.eval-right .ring {
  width: 200rpx;
  height: 200rpx;
}

.eval-left .ring-hole,
.eval-right .ring-hole {
  width: 148rpx;
  height: 148rpx;
}

.eval-left .score,
.eval-right .score {
  font-size: 56rpx;
}

.gains {
  text-align: left;
}

.gain {
  padding: 16rpx 8rpx 8rpx;
}

.gain + .gain {
  margin-top: 0;
}

.gain-k {
  display: block;
  font-size: 22rpx;
  color: #64748b;
}

.gain-v {
  display: block;
  margin-top: 8rpx;
  font-size: 56rpx;
  font-weight: 800;
  letter-spacing: -1rpx;
  color: #5b21b6;
  line-height: 1.05;
  animation: gain-float 2.6s ease-in-out infinite;
}

.plate {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  margin-top: 16rpx;
  padding: 20rpx;
  border-radius: 20rpx;
  background: #f6f3ee;
  text-align: left;
}

.plate-no {
  width: 48rpx;
  flex-shrink: 0;
  font-size: 24rpx;
  font-weight: 700;
  color: #7c4dff;
  line-height: 1.4;
}

.plate-body {
  flex: 1;
  min-width: 0;
}

.plate-name {
  display: block;
  font-size: 28rpx;
  font-weight: 700;
  color: #0f172a;
}

.plate-line {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  line-height: 1.6;
  color: #475569;
}

.advice--now {
  background: #f3f7ff;
  box-shadow: inset 0 0 0 2rpx #93c5fd;
}

.eval-bottom .advice-title--now {
  color: #1d4ed8;
  font-size: 28rpx;
  font-weight: 800;
}

.plate--now {
  background: #e8f1ff;
}

.plate-no--now {
  color: #1d4ed8;
}

.advice--plan {
  background: #fff7ed;
  box-shadow: inset 0 0 0 2rpx #fb923c;
}

.eval-bottom .advice-title--plan {
  color: #c2410c;
  font-size: 28rpx;
  font-weight: 800;
}

.plan {
  margin-top: 16rpx;
  padding: 20rpx;
  border-radius: 20rpx;
  background: #fff;
  text-align: left;
}

.plan-head {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.plan-no {
  font-size: 24rpx;
  font-weight: 800;
  color: #c2410c;
  line-height: 1;
}

.plan-name {
  font-size: 30rpx;
  font-weight: 700;
  color: #0f172a;
  line-height: 1.3;
}

.plan-block {
  margin-top: 14rpx;
  padding: 16rpx 16rpx 14rpx;
  border-radius: 16rpx;
}

.plan-block--find {
  background: #e8f1ff;
}

.plan-block--adjust {
  background: #f3e8ff;
}

.plan-block--soon {
  background: #ffedd5;
}

.plan-tag {
  display: inline-block;
  margin-bottom: 8rpx;
  padding: 2rpx 12rpx;
  border-radius: 999rpx;
  font-size: 20rpx;
  font-weight: 700;
  line-height: 1.6;
}

.plan-block--find .plan-tag {
  color: #1d4ed8;
  background: #dbeafe;
}

.plan-block--adjust .plan-tag {
  color: #6d28d9;
  background: #e9d5ff;
}

.plan-block--soon .plan-tag {
  color: #c2410c;
  background: #fed7aa;
}

.plan-text {
  display: block;
  font-size: 26rpx;
  line-height: 1.65;
  color: #1e293b;
}

.plat {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  padding: 8rpx 18rpx 8rpx 8rpx;
  border-radius: 999rpx;
  background: #fff;
  color: #64748b;
  font-size: 24rpx;
  border: 2rpx solid #e8e4f4;
  line-height: 1.4;
}

.plat-logo {
  width: 36rpx;
  height: 36rpx;
  border-radius: 8rpx;
  background: #fff;
  flex-shrink: 0;
}

.plat--on {
  background: #7c4dff;
  color: #fff;
  border-color: #7c4dff;
  font-weight: 700;
}

.soon {
  margin-top: 24rpx;
  min-height: 420rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.soon-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #94a3b8;
}

.ident,
.hero,
.advice {
  text-align: center;
}

.avatar {
  width: 144rpx;
  height: 144rpx;
  border-radius: 50%;
  margin: 12rpx auto 16rpx;
  display: block;
  overflow: hidden;
  background: #efeaf8;
}

.avatar--ph {
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 1;
  font-size: 56rpx;
  font-weight: 700;
  color: #7c4dff;
  text-align: center;
}

.avatar-letter {
  display: block;
  font-size: 56rpx;
  font-weight: 700;
  line-height: 1;
  color: #7c4dff;
}

.nick {
  display: block;
  font-size: 36rpx;
  font-weight: 700;
  color: #0f172a;
}

.did,
.hint,
.basis,
.need {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #64748b;
}

.ring-stage {
  position: relative;
  width: 280rpx;
  height: 280rpx;
  margin: 8rpx auto 16rpx;
}

.ring-scan {
  position: absolute;
  z-index: 3;
  left: -10rpx;
  top: -10rpx;
  width: 220rpx;
  height: 220rpx;
  border-radius: 50%;
  box-sizing: border-box;
  border: 8rpx solid rgba(124, 77, 255, 0.16);
  border-top-color: #7c4dff;
  border-right-color: #c084fc;
  animation: eval-spin 0.75s linear infinite;
  pointer-events: none;
}

.ring--wait {
  animation: ring-wait 1.1s ease-in-out infinite;
}

.ring {
  position: relative;
  width: 280rpx;
  height: 280rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 16rpx 40rpx rgba(124, 77, 255, 0.16);
}

.ring--pop {
  animation: ring-pop 0.55s cubic-bezier(0.2, 1.35, 0.36, 1);
}

.ring-hole {
  width: 214rpx;
  height: 214rpx;
  border-radius: 50%;
  background: radial-gradient(circle at 50% 42%, #ffffff 0%, #f7f4ff 72%);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: inset 0 0 0 2rpx rgba(124, 77, 255, 0.08);
}

.score {
  font-size: 80rpx;
  font-weight: 800;
  color: #5b21b6;
  line-height: 1;
  font-variant-numeric: tabular-nums;
}

.score--pop {
  animation: score-pop 0.55s cubic-bezier(0.2, 1.35, 0.36, 1);
}

.score--wait {
  animation: score-wait 0.9s ease-in-out infinite;
}

.label,
.level-title,
.advice-title {
  display: block;
  font-size: 28rpx;
  font-weight: 700;
  color: #0f172a;
}

.advice-lift {
  display: block;
  margin-top: 12rpx;
  font-size: 30rpx;
  font-weight: 700;
  color: #6d28d9;
}

.grade {
  margin-top: 16rpx;
}

.grade-label {
  display: block;
  font-size: 34rpx;
  font-weight: 800;
  line-height: 1.3;
}

.grade-label--excellent {
  color: #15803d;
}

.grade-label--good {
  color: #5b21b6;
}

.grade-label--fix {
  color: #b45309;
}

.grade-label--risk {
  color: #b91c1c;
}

.grade-note {
  display: block;
  margin-top: 6rpx;
  font-size: 24rpx;
  color: #64748b;
  line-height: 1.5;
}

.levels {
  margin-top: 20rpx;
}

.sec--on .sec-name {
  color: #0f172a;
}

.level,
.advice-status,
.sec-line {
  display: block;
  margin-top: 8rpx;
  font-size: 26rpx;
  color: #334155;
  line-height: 1.5;
}

.eval-dock {
  position: fixed;
  left: 0;
  right: 0;
  z-index: 18;
  bottom: calc(96rpx + env(safe-area-inset-bottom));
  padding: 16rpx 24rpx 12rpx;
  background: linear-gradient(180deg, rgba(250, 247, 255, 0) 0%, #faf7ff 36%);
}

.btn-main,
.btn-sub {
  margin: 12rpx 0 0;
  border-radius: 16rpx;
  font-size: 30rpx;
  line-height: 88rpx;
  text-align: center;
  font-weight: 700;
}

.btn-main--hover {
  opacity: 0.88;
}

.btn-sub--hover {
  background: #f5f0ff;
}

.btn--off {
  opacity: 0.45;
}

.btn-main {
  background: #7c4dff;
  color: #fff;
}

.btn-sub {
  background: #fff;
  color: #5b21b6;
  border: 2rpx solid #d8ccff;
}

.err {
  display: block;
  margin: 12rpx 0 0;
  color: #b91c1c;
  font-size: 24rpx;
  text-align: center;
}

.advice {
  text-align: left;
  margin-top: 24rpx;
}

.sec {
  margin-top: 20rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid #efeaf8;
}

.sec-name {
  display: block;
  font-size: 28rpx;
  font-weight: 700;
  color: #5b21b6;
}

.xingxuan-page {
  padding-bottom: calc(128rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.xingxuan-page--dock {
  padding-bottom: calc(420rpx + env(safe-area-inset-bottom));
}

@keyframes gain-float {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-8rpx); }
}

@keyframes eval-spin {
  to {
    transform: rotate(360deg);
  }
}

@keyframes ring-wait {
  0%, 100% { transform: scale(1); }
  50% { transform: scale(1.04); }
}

@keyframes score-wait {
  0%, 100% { opacity: 0.35; }
  50% { opacity: 1; }
}

@keyframes arrow-rise {
  0%, 100% { transform: translateY(6rpx); opacity: 0.55; }
  50% { transform: translateY(-10rpx); opacity: 1; }
}

@keyframes ring-pop {
  0% { transform: scale(0.92); }
  55% { transform: scale(1.04); }
  100% { transform: scale(1); }
}

@keyframes score-pop {
  0% { transform: scale(0.72); opacity: 0.4; }
  60% { transform: scale(1.12); opacity: 1; }
  100% { transform: scale(1); opacity: 1; }
}

/* 分析页在分包里，不能依赖主包 tab 样式，图标尺寸写在本页 */
.eval-tab-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 999;
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-around;
  height: calc(96rpx + env(safe-area-inset-bottom));
  padding: 6rpx 8rpx calc(6rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  background: rgba(255, 255, 255, 0.96);
  border-top: 1rpx solid #e6e4f0;
}

.eval-tab {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-width: 0;
}

.eval-tab-ico {
  position: relative;
  width: 44rpx;
  height: 44rpx;
  flex-shrink: 0;
}

.eval-tab-tx {
  margin-top: 2rpx;
  font-size: 20rpx;
  line-height: 1.2;
  color: #94a3b8;
  white-space: nowrap;
}

.eval-tab--on .eval-tab-tx {
  color: #7c4dff;
  font-weight: 700;
}

.eval-tab-tx--compact {
  font-size: 18rpx;
}

.eval-tab-ai {
  position: absolute;
  top: -4rpx;
  right: -16rpx;
  height: 22rpx;
  line-height: 22rpx;
  padding: 0 6rpx;
  border-radius: 8rpx;
  background: #7c4dff;
  color: #fff;
  font-size: 14rpx;
  font-weight: 800;
  z-index: 2;
}

.ei {
  position: absolute;
  box-sizing: border-box;
}

.ei-home {
  left: 4rpx;
  top: 6rpx;
  width: 36rpx;
  height: 32rpx;
}

.ei-home-roof {
  position: absolute;
  left: 2rpx;
  top: 0;
  width: 0;
  height: 0;
  border-left: 16rpx solid transparent;
  border-right: 16rpx solid transparent;
  border-bottom: 12rpx solid #94a3b8;
}

.ei-home-body {
  position: absolute;
  left: 4rpx;
  top: 10rpx;
  width: 28rpx;
  height: 20rpx;
  border: 3rpx solid #94a3b8;
  border-top: none;
  border-radius: 0 0 6rpx 6rpx;
  box-sizing: border-box;
}

.ei-home-door {
  position: absolute;
  left: 50%;
  bottom: 0;
  width: 10rpx;
  height: 12rpx;
  margin-left: -5rpx;
  background: #94a3b8;
  border-radius: 3rpx 3rpx 0 0;
}

.eval-tab--on .ei-home-roof { border-bottom-color: #7c4dff; }
.eval-tab--on .ei-home-body { border-color: #7c4dff; }
.eval-tab--on .ei-home-door { background: #7c4dff; }

.ei-star {
  left: 8rpx;
  top: 8rpx;
  width: 28rpx;
  height: 28rpx;
  background: #94a3b8;
  clip-path: polygon(50% 2%, 62% 36%, 98% 38%, 70% 58%, 80% 94%, 50% 74%, 20% 94%, 30% 58%, 2% 38%, 38% 36%);
}

.eval-tab--on .ei-star { background: #7c4dff; }

.ei-insight {
  left: 2rpx;
  top: 2rpx;
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #7c4dff 0%, #c084fc 100%);
}

.ei-insight-spark {
  position: absolute;
  left: 9rpx;
  top: 9rpx;
  width: 22rpx;
  height: 22rpx;
  background: #fff;
  clip-path: polygon(50% 0%, 62% 34%, 100% 50%, 62% 66%, 50% 100%, 38% 66%, 0% 50%, 38% 34%);
}

.ei-chat {
  left: 4rpx;
  top: 10rpx;
  width: 34rpx;
  height: 26rpx;
  border: 3rpx solid #94a3b8;
  border-radius: 14rpx;
  background: transparent;
}

.ei-chat-tail {
  position: absolute;
  left: 8rpx;
  bottom: -6rpx;
  width: 10rpx;
  height: 10rpx;
  border: 3rpx solid #94a3b8;
  border-top: none;
  border-right: none;
  border-radius: 0 0 0 6rpx;
  background: #fff;
  transform: rotate(-12deg);
}

.eval-tab--on .ei-chat,
.eval-tab--on .ei-chat-tail { border-color: #7c4dff; }

.ei-user {
  left: 8rpx;
  top: 6rpx;
  width: 28rpx;
  height: 32rpx;
}

.ei-user-head {
  position: absolute;
  top: 0;
  left: 50%;
  width: 18rpx;
  height: 18rpx;
  margin-left: -9rpx;
  border: 3rpx solid #94a3b8;
  border-radius: 50%;
  box-sizing: border-box;
}

.ei-user-shoulder {
  position: absolute;
  bottom: 0;
  left: 0;
  width: 28rpx;
  height: 14rpx;
  border: 3rpx solid #94a3b8;
  border-bottom: none;
  border-radius: 14rpx 14rpx 0 0;
  box-sizing: border-box;
}

.eval-tab--on .ei-user-head,
.eval-tab--on .ei-user-shoulder { border-color: #7c4dff; }

.up-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 80;
  background: rgba(48, 36, 78, 0.42);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 48rpx;
  box-sizing: border-box;
}
.up-card {
  width: 100%;
  background: linear-gradient(165deg, #6d5798 0%, #564484 58%, #4c3c78 100%);
  border-radius: 32rpx;
  padding: 40rpx 36rpx 32rpx;
  box-shadow: 0 28rpx 70rpx rgba(40, 24, 80, 0.32);
}
.up-kicker {
  display: block;
  font-size: 22rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
  color: #ead9a4;
}
.up-title {
  display: block;
  margin-top: 12rpx;
  font-size: 40rpx;
  font-weight: 700;
  color: #f4e4bc;
  line-height: 1.35;
}
.up-lead {
  display: block;
  margin-top: 20rpx;
  font-size: 28rpx;
  line-height: 1.65;
  color: rgba(247, 243, 234, 0.94);
}
.up-sub {
  display: block;
  margin-top: 12rpx;
  font-size: 24rpx;
  line-height: 1.6;
  color: rgba(247, 243, 234, 0.74);
}
.up-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 32rpx;
}
.up-btn {
  position: relative;
  flex: 1;
  height: 88rpx;
  border-radius: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  box-sizing: border-box;
}
.up-btn-tx {
  position: relative;
  z-index: 1;
  font-size: 28rpx;
  font-weight: 700;
}
.up-btn-shine {
  position: absolute;
  top: 0;
  bottom: 0;
  width: 42%;
  z-index: 0;
  pointer-events: none;
}
.up-btn--ghost {
  background: rgba(42, 30, 72, 0.28);
  border: 2rpx solid rgba(244, 228, 188, 0.72);
  animation: up-ghost-breathe 2.4s ease-in-out infinite;
}
.up-btn--ghost .up-btn-shine {
  background: linear-gradient(100deg, rgba(244, 228, 188, 0) 0%, rgba(244, 228, 188, 0.42) 50%, rgba(244, 228, 188, 0) 100%);
  animation: up-btn-shine 3.2s ease-in-out infinite;
}
.up-btn--ghost .up-btn-tx { color: #f4e4bc; }
.up-btn--go {
  border: 2rpx solid transparent;
  background-image: linear-gradient(90deg, #7c5cff, #b08cff, #8d6bff, #7c5cff);
  background-size: 220% 100%;
  animation: up-go-flow 2.6s linear infinite, up-go-breathe 1.8s ease-in-out infinite;
}
.up-btn--go .up-btn-tx { color: #fff; }
.up-btn--go .up-btn-shine {
  background: linear-gradient(100deg, rgba(255, 255, 255, 0) 0%, rgba(255, 255, 255, 0.55) 50%, rgba(255, 255, 255, 0) 100%);
  animation: up-btn-shine 2.2s ease-in-out infinite;
}
@keyframes up-btn-shine {
  0% { transform: translateX(-240%) skewX(-16deg); }
  42%, 100% { transform: translateX(340%) skewX(-16deg); }
}
@keyframes up-go-flow {
  0% { background-position: 0% 50%; }
  100% { background-position: 220% 50%; }
}
@keyframes up-go-breathe {
  0%, 100% {
    transform: scale(1);
    box-shadow: 0 8rpx 18rpx rgba(124, 92, 255, 0.28);
  }
  50% {
    transform: scale(1.045);
    box-shadow: 0 14rpx 32rpx rgba(176, 148, 255, 0.62);
  }
}
@keyframes up-ghost-breathe {
  0%, 100% {
    border-color: rgba(244, 228, 188, 0.5);
    box-shadow: 0 0 0 rgba(244, 228, 188, 0);
  }
  50% {
    border-color: rgba(244, 228, 188, 1);
    box-shadow: 0 0 22rpx rgba(244, 228, 188, 0.38);
  }
}
