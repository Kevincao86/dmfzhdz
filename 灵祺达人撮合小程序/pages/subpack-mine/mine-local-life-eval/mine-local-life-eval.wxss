@import '../../../styles/xingxuan-subpage.wxss';

.plats {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  padding: 8rpx 24rpx 4rpx;
}

.eval-split {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  padding: 0 16rpx 24rpx;
}

.eval-left {
  width: 42%;
  flex-shrink: 0;
}

.eval-right {
  flex: 1;
  min-width: 0;
}

.eval-left .xingxuan-card,
.eval-right .xingxuan-card {
  margin-left: 0;
  margin-right: 0;
}

.eval-left .avatar {
  width: 96rpx;
  height: 96rpx;
}

.eval-left .avatar--ph {
  line-height: 96rpx;
  font-size: 40rpx;
}

.eval-left .ring-stage,
.eval-left .ring {
  width: 200rpx;
  height: 200rpx;
}

.eval-left .ring-hole {
  width: 148rpx;
  height: 148rpx;
}

.eval-left .score {
  font-size: 56rpx;
}

.gains {
  text-align: left;
}

.gain {
  padding: 16rpx 8rpx 8rpx;
}

.gain + .gain {
  border-top: 2rpx solid #efeaf8;
  margin-top: 8rpx;
}

.gain-k {
  display: block;
  font-size: 22rpx;
  color: #64748b;
}

.gain-v {
  display: block;
  margin-top: 8rpx;
  font-size: 56rpx;
  font-weight: 800;
  letter-spacing: -1rpx;
  color: #5b21b6;
  line-height: 1.05;
  animation: gain-float 2.6s ease-in-out infinite;
}

.plate {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  margin-top: 16rpx;
  padding: 20rpx;
  border-radius: 20rpx;
  background: #f6f3ee;
  text-align: left;
}

.plate-no {
  width: 48rpx;
  flex-shrink: 0;
  font-size: 24rpx;
  font-weight: 700;
  color: #7c4dff;
  line-height: 1.4;
}

.plate-body {
  flex: 1;
  min-width: 0;
}

.plate-name {
  display: block;
  font-size: 28rpx;
  font-weight: 700;
  color: #0f172a;
}

.plate-line {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  line-height: 1.6;
  color: #475569;
}

.plat {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  padding: 8rpx 18rpx 8rpx 8rpx;
  border-radius: 999rpx;
  background: #fff;
  color: #64748b;
  font-size: 24rpx;
  border: 2rpx solid #e8e4f4;
  line-height: 1.4;
}

.plat-logo {
  width: 36rpx;
  height: 36rpx;
  border-radius: 8rpx;
  background: #fff;
  flex-shrink: 0;
}

.plat--on {
  background: #7c4dff;
  color: #fff;
  border-color: #7c4dff;
  font-weight: 700;
}

.soon {
  margin-top: 24rpx;
  min-height: 420rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.soon-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #94a3b8;
}

.ident,
.hero,
.advice {
  text-align: center;
}

.avatar {
  width: 144rpx;
  height: 144rpx;
  border-radius: 50%;
  margin: 12rpx auto 16rpx;
  display: block;
  background: #efeaf8;
}

.avatar--ph {
  line-height: 144rpx;
  font-size: 56rpx;
  font-weight: 700;
  color: #7c4dff;
}

.nick {
  display: block;
  font-size: 36rpx;
  font-weight: 700;
  color: #0f172a;
}

.did,
.hint,
.basis,
.need {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #64748b;
}

.ring-stage {
  position: relative;
  width: 280rpx;
  height: 280rpx;
  margin: 8rpx auto 16rpx;
}

.ring-halo {
  position: absolute;
  inset: 8rpx;
  border-radius: 50%;
  background: conic-gradient(from 0deg, transparent 0 62%, rgba(124, 77, 255, 0.55) 78%, transparent 92%);
  filter: blur(6rpx);
  opacity: 0;
}

.ring-halo--on {
  opacity: 1;
  animation: eval-spin 1.15s linear infinite;
}

.ring {
  position: relative;
  width: 280rpx;
  height: 280rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 16rpx 40rpx rgba(124, 77, 255, 0.16);
}

.ring--pop {
  animation: ring-pop 0.55s cubic-bezier(0.2, 1.35, 0.36, 1);
}

.ring-hole {
  width: 214rpx;
  height: 214rpx;
  border-radius: 50%;
  background: radial-gradient(circle at 50% 42%, #ffffff 0%, #f7f4ff 72%);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: inset 0 0 0 2rpx rgba(124, 77, 255, 0.08);
}

.score {
  font-size: 80rpx;
  font-weight: 800;
  color: #5b21b6;
  line-height: 1;
  font-variant-numeric: tabular-nums;
}

.score--pop {
  animation: score-pop 0.55s cubic-bezier(0.2, 1.35, 0.36, 1);
}

.label,
.level-title,
.advice-title {
  display: block;
  font-size: 28rpx;
  font-weight: 700;
  color: #0f172a;
}

.advice-lift {
  display: block;
  margin-top: 12rpx;
  font-size: 30rpx;
  font-weight: 700;
  color: #6d28d9;
}

.grade {
  margin-top: 16rpx;
}

.grade-label {
  display: block;
  font-size: 34rpx;
  font-weight: 800;
  line-height: 1.3;
}

.grade-label--excellent {
  color: #15803d;
}

.grade-label--good {
  color: #5b21b6;
}

.grade-label--fix {
  color: #b45309;
}

.grade-label--risk {
  color: #b91c1c;
}

.grade-note {
  display: block;
  margin-top: 6rpx;
  font-size: 24rpx;
  color: #64748b;
  line-height: 1.5;
}

.levels {
  margin-top: 20rpx;
}

.sec--on .sec-name {
  color: #0f172a;
}

.level,
.advice-status,
.sec-line {
  display: block;
  margin-top: 8rpx;
  font-size: 26rpx;
  color: #334155;
  line-height: 1.5;
}

.eval-dock {
  position: fixed;
  left: 0;
  right: 0;
  z-index: 18;
  bottom: calc(96rpx + env(safe-area-inset-bottom));
  padding: 16rpx 24rpx 12rpx;
  background: linear-gradient(180deg, rgba(250, 247, 255, 0) 0%, #faf7ff 36%);
}

.btn-main,
.btn-sub {
  margin: 12rpx 0 0;
  border-radius: 16rpx;
  font-size: 30rpx;
  line-height: 88rpx;
  text-align: center;
  font-weight: 700;
}

.btn-main--hover {
  opacity: 0.88;
}

.btn-sub--hover {
  background: #f5f0ff;
}

.btn--off {
  opacity: 0.45;
}

.btn-main {
  background: #7c4dff;
  color: #fff;
}

.btn-sub {
  background: #fff;
  color: #5b21b6;
  border: 2rpx solid #d8ccff;
}

.err {
  display: block;
  margin: 12rpx 0 0;
  color: #b91c1c;
  font-size: 24rpx;
  text-align: center;
}

.advice {
  text-align: left;
  margin-top: 24rpx;
}

.sec {
  margin-top: 20rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid #efeaf8;
}

.sec-name {
  display: block;
  font-size: 28rpx;
  font-weight: 700;
  color: #5b21b6;
}

.xingxuan-page {
  padding-bottom: calc(128rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.xingxuan-page--dock {
  padding-bottom: calc(420rpx + env(safe-area-inset-bottom));
}

.eval-tab-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 20;
  display: flex;
  align-items: center;
  height: calc(96rpx + env(safe-area-inset-bottom));
  padding-bottom: env(safe-area-inset-bottom);
  background: rgba(255, 255, 255, 0.96);
  border-top: 1rpx solid rgba(210, 212, 230, 0.88);
  box-shadow: 0 -6rpx 24rpx rgba(90, 96, 140, 0.06);
}

.eval-tab {
  flex: 1;
  text-align: center;
}

.eval-tab-text {
  font-size: 20rpx;
  color: #94a3b8;
  font-weight: 500;
}

.eval-tab--on .eval-tab-text {
  color: #7c4dff;
  font-weight: 700;
}

@keyframes gain-float {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-8rpx); }
}

@keyframes eval-spin {
  to {
    transform: rotate(360deg);
  }
}

@keyframes ring-pop {
  0% { transform: scale(0.92); }
  55% { transform: scale(1.04); }
  100% { transform: scale(1); }
}

@keyframes score-pop {
  0% { transform: scale(0.72); opacity: 0.4; }
  60% { transform: scale(1.12); opacity: 1; }
  100% { transform: scale(1); opacity: 1; }
}
