<view class="xingxuan-page page-shell {{lqThemeClass}} xingxuan-page--dock">
  <view class="plats">
    <view
      wx:for="{{platforms}}"
      wx:key="id"
      class="plat {{platformId === item.id ? 'plat--on' : ''}}"
      data-id="{{item.id}}"
      bindtap="onPlatform"
    >
      <image class="plat-logo" src="{{item.icon}}" mode="aspectFit" />
      <text>{{item.name}}</text>
    </view>
  </view>

  <view class="xingxuan-card ident">
    <image class="avatar" src="{{avatarUrl}}" mode="aspectFill" wx:if="{{avatarUrl}}" />
    <view class="avatar avatar--ph" wx:else>{{avatarLetter}}</view>
    <text class="nick">{{nickname || '未填写昵称'}}</text>
    <text class="did">{{accountLabel}} {{accountId || '未填写'}}</text>
    <text class="did" wx:if="{{basis}}">{{basis}}</text>
    <text class="did" wx:else>按已填写的昵称和账号分析</text>
  </view>

  <view class="xingxuan-card hero">
    <view class="ring-stage">
      <view class="ring-halo {{evaluating ? 'ring-halo--on' : ''}}"></view>
      <view class="ring {{scorePop ? 'ring--pop' : ''}}" style="background: conic-gradient(from -90deg, #7c4dff 0%, #c084fc {{displayScore}}%, #efeaf8 {{displayScore}}%);">
        <view class="ring-hole">
          <text class="score {{scorePop ? 'score--pop' : ''}}">{{displayScore}}</text>
        </view>
      </view>
    </view>
    <text class="label">数据智能分析</text>
    <view class="grade" wx:if="{{showGrade}}">
      <text class="grade-label grade-label--{{gradeKey}}">{{gradeLabel}}</text>
      <text class="grade-note">{{gradeNote}}</text>
    </view>
    <view class="levels" wx:if="{{scoreReady}}">
      <text class="level-title">{{levelTitle}}</text>
      <text class="level">{{levelALabel}} {{videoLevel}}</text>
      <text class="level">{{levelBLabel}} {{liveLevel}}</text>
    </view>
  </view>

  <view class="xingxuan-card advice" wx:if="{{showGrade}}">
    <text class="advice-title">评级释义</text>
    <view class="sec {{gradeKey === item.key ? 'sec--on' : ''}}" wx:for="{{grades}}" wx:key="key">
      <text class="sec-name">{{item.range}}：{{item.label}}</text>
      <text class="sec-line">{{item.note}}</text>
    </view>
  </view>

  <view class="xingxuan-card advice" wx:if="{{scoreReady && situations.length}}">
    <text class="advice-title">达人现状</text>
    <view class="sec" wx:for="{{situations}}" wx:key="name">
      <text class="sec-name">{{item.name}}</text>
      <text class="sec-line">{{item.now}}</text>
    </view>
  </view>

  <view class="xingxuan-card advice" wx:if="{{adviceReady}}">
    <text class="advice-title">整改建议</text>
    <view class="sec" wx:for="{{sections}}" wx:key="name">
      <text class="sec-name">{{item.name}}</text>
      <text class="sec-line">{{item.next}}</text>
    </view>
  </view>

  <view class="eval-dock">
    <button class="btn-main" loading="{{evaluating}}" disabled="{{!canEval || evaluating || advising}}" bindtap="onEvaluate">
      达人信息评估
    </button>
    <button class="btn-sub" loading="{{advising}}" disabled="{{!scoreReady || evaluating || advising}}" bindtap="onAdvise">
      分析整改
    </button>
    <text class="need" wx:if="{{!canEval}}">请先到「我的信息」填写{{nickLabel}}或{{accountLabel}}</text>
    <text class="need" wx:elif="{{!scoreReady}}">请先完成达人信息评估</text>
    <text class="err" wx:if="{{err}}">{{err}}</text>
  </view>

  <view class="eval-tab-bar">
    <view
      wx:for="{{tabs}}"
      wx:key="pagePath"
      class="eval-tab {{item.navigate ? 'eval-tab--on' : ''}}"
      data-path="{{item.pagePath}}"
      data-navigate="{{item.navigate}}"
      bindtap="onTab"
    >
      <text class="eval-tab-text">{{item.text}}</text>
    </view>
  </view>
</view>
