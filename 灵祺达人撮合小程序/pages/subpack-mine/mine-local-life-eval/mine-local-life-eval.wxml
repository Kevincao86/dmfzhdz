<view class="xingxuan-page page-shell {{lqThemeClass}}">
  <view class="plats">
    <view
      wx:for="{{platforms}}"
      wx:key="id"
      class="plat {{platformId === item.id ? 'plat--on' : ''}}"
      data-id="{{item.id}}"
      bindtap="onPlatform"
    >
      <image class="plat-logo" src="{{item.icon}}" mode="aspectFit" />
      <text>{{item.name}}</text>
    </view>
  </view>

  <view class="eval-top">
    <view class="eval-left">
      <view class="xingxuan-card ident">
        <image class="avatar" src="{{avatarUrl}}" mode="aspectFill" wx:if="{{avatarUrl}}" />
        <view class="avatar avatar--ph" wx:else><text class="avatar-letter">{{avatarLetter}}</text></view>
        <text class="nick">{{nickname || '未填写昵称'}}</text>
        <text class="did">{{accountLabel}} {{accountId || '未填写'}}</text>
        <text class="did" wx:if="{{basis}}">{{basis}}</text>
        <text class="did" wx:else>按已填写的昵称和账号分析</text>
      </view>
    </view>
    <view class="eval-right">
      <view class="xingxuan-card hero">
        <view class="ring-stage">
          <view class="ring-scan" wx:if="{{evaluating}}"></view>
          <view class="ring {{scorePop ? 'ring--pop' : ''}} {{evaluating ? 'ring--wait' : ''}}" style="background: conic-gradient(from -90deg, #7c4dff 0%, #c084fc {{displayScore}}%, #efeaf8 {{displayScore}}%);">
            <view class="ring-hole">
              <text class="score {{scorePop ? 'score--pop' : ''}} {{evaluating ? 'score--wait' : ''}}">{{loggedIn ? displayScore : '—'}}</text>
            </view>
          </view>
        </view>
        <text class="label">数据智能分析</text>
        <view class="grade" wx:if="{{showGrade}}">
          <text class="grade-label grade-label--{{gradeKey}}">{{gradeLabel}}</text>
          <text class="grade-note">{{gradeNote}}</text>
        </view>
        <view class="levels" wx:if="{{scoreReady}}">
          <text class="level-title">{{levelTitle}}</text>
          <text class="level">{{levelALabel}} {{videoLevel}}</text>
          <text class="level">{{levelBLabel}} {{liveLevel}}</text>
        </view>
        <view
          class="btn-main {{!canEval || evaluating || advising ? 'btn--off' : ''}}"
          hover-class="btn-main--hover"
          bindtap="onEvaluate"
        >{{evaluating ? '评估中…' : (scoreReady ? reevalCostText : evalCostText)}}</view>
      </view>
    </view>
  </view>

  <view class="eval-bottom">
    <view class="xingxuan-card radar-card" wx:if="{{scoreReady || evaluating}}">
      <text class="radar-title">{{nickname || '达人'}} 6维评估{{scoreReady ? '（' + displayScore + '/100）' : ''}}</text>
      <text class="radar-sub">{{basis || '按已填写资料和公开主页估算'}}</text>
      <canvas type="2d" id="evalRadar" class="radar-canvas"></canvas>
    </view>

    <view class="xingxuan-card gains" wx:if="{{showGains}}">
      <view class="gain-row">
        <view class="gain">
          <text class="gain-k">预计提升曝光</text>
          <view class="gain-metric">
            <view class="gain-arrow"></view>
            <text class="gain-v">{{exposureText}}</text>
          </view>
        </view>
        <view class="gain">
          <text class="gain-k">预计提升带货金额</text>
          <view class="gain-metric">
            <view class="gain-arrow"></view>
            <text class="gain-v">{{salesText}}</text>
          </view>
        </view>
      </view>
    </view>
    <view class="xingxuan-card gains" wx:else>
      <text class="need">完成评估后，这里显示预计提升的曝光和带货金额</text>
    </view>
    <view
      class="btn-sub {{!scoreReady || evaluating || advising ? 'btn--off' : ''}}"
      hover-class="btn-sub--hover"
      bindtap="onAdvise"
    >{{advising ? '分析中…' : adviceCostText}}</view>
    <text class="err" wx:if="{{err}}">{{err}}</text>
    <text class="need">免费版每月可评估 1 次。升级会员后每月可评估 15 次。分析提升每次 5 积分。</text>
    <text class="need" wx:if="{{!loggedIn}}">请先登录后再查看达人分析</text>
    <text class="need" wx:elif="{{!canEval}}">请先到「我的信息」填写{{nickLabel}}或{{accountLabel}}</text>
    <text class="need" wx:elif="{{!scoreReady}}">请先完成达人信息评估</text>

    <view class="xingxuan-card advice advice--now" wx:if="{{scoreReady && situations.length}}">
      <text class="advice-title advice-title--now">达人现状</text>
      <view class="plate-grid">
        <view class="plate plate--now" wx:for="{{situations}}" wx:key="name">
          <text class="plate-no plate-no--now">{{index < 9 ? '0' + (index + 1) : index + 1}}</text>
          <view class="plate-body">
            <text class="plate-name">{{item.name}}{{item.max ? ' ' + item.points + '/' + item.max : ''}}</text>
            <text class="plate-line">{{item.now}}</text>
          </view>
        </view>
      </view>
    </view>

    <view class="xingxuan-card advice advice--plan" wx:if="{{advising}}" id="talent-advice-plan">
      <text class="advice-title advice-title--plan">分析与提升方案</text>
      <text class="plan-wait">正在按绑定资料和公网数据写提升方案…</text>
    </view>

    <view class="xingxuan-card advice advice--plan" wx:if="{{adviceReady && !advising}}" id="talent-advice-plan">
      <text class="advice-title advice-title--plan">分析与提升方案</text>
      <view class="plan-list">
        <view class="plan" wx:for="{{sections}}" wx:key="name">
          <view class="plan-head">
            <text class="plan-no">{{index < 9 ? '0' + (index + 1) : index + 1}}</text>
            <text class="plan-name">{{item.name}}</text>
          </view>
          <view class="plan-block plan-block--find" wx:if="{{item.finding}}">
            <text class="plan-tag">分析结果</text>
            <text class="plan-text">{{item.finding}}</text>
          </view>
          <view class="plan-block plan-block--adjust" wx:if="{{item.adjust}}">
            <text class="plan-tag">怎么调整</text>
            <text class="plan-text">{{item.adjust}}</text>
          </view>
          <view class="plan-block plan-block--soon" wx:if="{{item.soon}}">
            <text class="plan-tag">近期要做</text>
            <text class="plan-text">{{item.soon}}</text>
          </view>
        </view>
      </view>
    </view>

    <view class="xingxuan-card advice" wx:if="{{showGrade}}">
      <text class="advice-title">评级释义</text>
      <view class="plate-grid">
        <view class="plate {{gradeKey === item.key ? 'plate--on' : ''}}" wx:for="{{grades}}" wx:key="key">
          <text class="plate-no">{{item.range}}</text>
          <view class="plate-body">
            <text class="plate-name">{{item.label}}</text>
            <text class="plate-line">{{item.note}}</text>
          </view>
        </view>
      </view>
    </view>

    <view class="source-note">
      <view class="source-line">
        <text class="source-k">数据来源</text>
        <text class="source-v">达人填写的昵称、账号、粉丝、标签、报价；有主页时联网检索公开主页。</text>
      </view>
      <view class="source-line">
        <text class="source-k">分析方式</text>
        <text class="source-v">按六个维度打分。公开主页里有的用检索结果，没有的按同类本地生活达人预估。</text>
      </view>
    </view>
  </view>

  <view class="eval-tab-bar {{lqThemeClass}}">
    <view
      wx:for="{{tabs}}"
      wx:key="pagePath"
      class="eval-tab {{item.navigate ? 'eval-tab--on' : ''}}"
      data-path="{{item.pagePath}}"
      data-navigate="{{item.navigate}}"
      bindtap="onTab"
    >
      <view class="eval-tab-ico">
        <view wx:if="{{item.icon === 'home'}}" class="ei ei-home">
          <view class="ei-home-roof"></view>
          <view class="ei-home-body"><view class="ei-home-door"></view></view>
        </view>
        <view wx:elif="{{item.icon === 'star'}}" class="ei ei-star"></view>
        <view wx:elif="{{item.icon === 'insight'}}" class="ei ei-insight">
          <view class="ei-insight-spark"></view>
        </view>
        <view wx:elif="{{item.icon === 'chat'}}" class="ei ei-chat">
          <view class="ei-chat-tail"></view>
        </view>
        <view wx:else class="ei ei-user">
          <view class="ei-user-head"></view>
          <view class="ei-user-shoulder"></view>
        </view>
        <text wx:if="{{item.aiBadge}}" class="eval-tab-ai">AI</text>
      </view>
      <text class="eval-tab-tx {{item.compact ? 'eval-tab-tx--compact' : ''}}">{{item.text}}</text>
    </view>
  </view>
  <view class="up-mask" wx:if="{{upgradeOpen}}" bindtap="closeUpgrade" catchtouchmove="preventMove">
    <view class="up-card" catchtap="preventMove">
      <text class="up-kicker">开通后可看</text>
      <text class="up-title">看你这个账号的改法</text>
      <text class="up-lead">数千位本地生活达人跑通的做法，收成你这个账号下一步该怎么改的分析。</text>
      <text class="up-sub">先点明现在卡在哪，再给你最该动的一步。</text>
      <view class="up-actions">
        <view class="up-btn up-btn--ghost" bindtap="closeUpgrade">
          <view class="up-btn-shine"></view>
          <text class="up-btn-tx">先看看</text>
        </view>
        <view class="up-btn up-btn--go" bindtap="goUpgrade">
          <view class="up-btn-shine"></view>
          <text class="up-btn-tx">去开通</text>
        </view>
      </view>
    </view>
  </view>

  <site-icp-footer />
</view>
