@import '../../../styles/xingxuan-subpage.wxss';

.funnel-row {
  display: flex;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #e2e8f0;
}

.stage {
  flex: 1;
  font-size: 28rpx;
  color: #0f172a;
}

.count {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--lq-primary-dark, #6d28d9);
  margin-right: 16rpx;
}

.rate {
  font-size: 24rpx;
  color: #64748b;
  min-width: 80rpx;
  text-align: right;
}

.order-row {
  padding: 16rpx 0;
  border-bottom: 1rpx solid #e2e8f0;
}

.order-title {
  font-size: 28rpx;
  color: #0f172a;
  display: block;
}

.order-sub {
  font-size: 24rpx;
  color: #64748b;
  margin-top: 6rpx;
  display: block;
}

.sub-title {
  font-size: 28rpx;
  font-weight: 600;
  margin-bottom: 16rpx;
  display: block;
}
