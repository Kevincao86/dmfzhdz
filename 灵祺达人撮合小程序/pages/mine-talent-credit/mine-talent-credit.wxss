.page { padding: 24rpx; background: #f5f7fb; min-height: 100vh; }
.card { background: #fff; border-radius: 20rpx; padding: 28rpx; margin-bottom: 24rpx; }
.hero { text-align: center; padding: 48rpx 28rpx; }
.score { font-size: 96rpx; font-weight: 700; color: #0284c7; display: block; }
.label { font-size: 26rpx; color: #64748b; }
.level { display: block; margin-top: 12rpx; font-size: 28rpx; color: #0f172a; font-weight: 600; }
.stat { display: inline-block; width: 50%; text-align: center; padding: 16rpx 0; box-sizing: border-box; }
.stat-val { display: block; font-size: 36rpx; font-weight: 600; color: #0f172a; }
.stat-lab { font-size: 24rpx; color: #64748b; }
.title { font-size: 30rpx; font-weight: 600; margin-bottom: 16rpx; display: block; }
.tip { font-size: 26rpx; color: #475569; line-height: 1.6; margin-bottom: 8rpx; }
