<view class="page-shell page-with-bar">
  <view class="page-hero page-hero--compact">
    <text class="page-hero-title">提交报名</text>
    <text class="page-hero-sub">{{isSupplierApply ? (supplierWorkId === 'shoot' ? '拍摄团队' : '剪辑团队') : ('平台 ' + platform)}} · 订单 {{merchantOrderNo}}</text>
  </view>

  <view class="card sync-card" wx:if="{{canSyncMember}}">
    <view class="sync-row">
      <view class="sync-icon-wrap">⇄</view>
      <view class="sync-text">
        <text class="sync-title">填入{{isSupplierApply ? '团队' : '会员'}}资料</text>
        <text class="sync-hint">{{memberTypeLabel}} · 一键填入{{isSupplierApply ? '团队' : platform}}资料</text>
      </view>
      <switch checked="{{syncMemberProfile}}" color="#6366f1" bindchange="onSyncMemberChange" />
    </view>
  </view>

  <view class="card tip-card" wx:elif="{{hasMember}}">
    <text class="hint" wx:if="{{isSupplierApply}}">暂无团队资料可同步，请手动填写或 </text>
    <text class="hint" wx:else>本单为{{platform}}招募，会员资料未含该平台，请手动填写或 </text>
    <text class="link-text" bindtap="goRegister">{{isSupplierApply ? '完善团队信息' : '完善资料'}}</text>
  </view>

  <view class="card tip-card" wx:else>
    <text class="hint">未注册也可直接报名。 </text>
    <text class="link-text" bindtap="goRegister">{{isSupplierApply ? '完善团队信息' : '完善我的信息'}}</text>
    <text class="hint"> 后可下次一键填入。</text>
  </view>

  <view class="card apply-form" wx:if="{{isEditIce}}">
    <view class="section-head">
      <view class="section-head-dot" />
      <text class="section-title">认领条数</text>
    </view>
    <view class="form-row">
      <text class="form-label">认领条数 *</text>
      <input class="input" type="number" placeholder="1" value="{{claimSlotCount}}" bindinput="onClaimSlotInput" />
    </view>
    <text class="hint" style="display:block;margin-top:8rpx;">剩余可认领 {{freeEditSlots}} 条成片位</text>
  </view>

  <view class="card apply-form">
    <view class="section-head">
      <view class="section-head-dot" />
      <text class="section-title">{{isEditIce ? '剪辑师信息' : (isSupplierApply ? (supplierWorkId === 'shoot' ? '拍摄团队报名信息' : '剪辑团队报名信息') : '达人报名信息')}}</text>
    </view>

    <block wx:for="{{applyRows}}" wx:key="id">
      <view class="form-row" wx:if="{{item.bindKey === 'province'}}">
        <text class="form-label">省份{{item.required ? ' *' : ''}}</text>
        <picker mode="selector" range="{{provinces}}" value="{{provinceIndex}}" bindchange="onProvinceChange">
          <view class="picker-val {{province ? '' : 'picker-val--placeholder'}}">{{province || '请选择省份'}}</view>
        </picker>
      </view>

      <view class="form-row" wx:elif="{{item.bindKey === 'city'}}">
        <text class="form-label">城市{{item.required ? ' *' : ''}}</text>
        <picker mode="selector" range="{{cities}}" value="{{cityIndex}}" bindchange="onCityChange">
          <view class="picker-val {{city ? '' : 'picker-val--placeholder'}}">{{city || '请选择城市'}}</view>
        </picker>
      </view>

      <view class="form-row" wx:elif="{{item.isPicker}}">
        <text class="form-label">{{item.displayLabel}}{{item.required ? ' *' : ''}}</text>
        <picker mode="selector" range="{{douyinLevels}}" value="{{douyinLevelIndex}}" bindchange="onDouyinLevelChange">
          <view class="picker-val {{douyinSalesLevel ? '' : 'picker-val--placeholder'}}">
            {{douyinSalesLevel || '请选择'}}
          </view>
        </picker>
      </view>

      <view class="form-row" wx:elif="{{item.isDate}}">
        <text class="form-label">{{item.displayLabel}}{{item.required ? ' *' : ''}}</text>
        <picker mode="date" value="{{visitDate}}" bindchange="onVisitDateChange">
          <view class="picker-val {{visitDate ? '' : 'picker-val--placeholder'}}">{{visitDate || '选择日期'}}</view>
        </picker>
      </view>

      <view class="form-row" wx:elif="{{item.isTime && item.bindKey === 'visitTimeStart'}}">
        <text class="form-label">{{item.displayLabel}}{{item.required ? ' *' : ''}}</text>
        <picker mode="time" value="{{visitTimeStart}}" bindchange="onVisitTimeStartChange">
          <view class="picker-val {{visitTimeStart ? '' : 'picker-val--placeholder'}}">{{visitTimeStart || '时:分'}}</view>
        </picker>
      </view>

      <view class="form-row" wx:elif="{{item.isTime && item.bindKey === 'visitTimeEnd'}}">
        <text class="form-label">{{item.displayLabel}}{{item.required ? ' *' : ''}}</text>
        <picker mode="time" value="{{visitTimeEnd}}" bindchange="onVisitTimeEndChange">
          <view class="picker-val {{visitTimeEnd ? '' : 'picker-val--placeholder'}}">{{visitTimeEnd || '时:分'}}</view>
        </picker>
      </view>

      <view class="form-row" wx:else>
        <text class="form-label">{{item.displayLabel}}{{item.required ? ' *' : ''}}</text>
        <input
          class="input"
          type="{{item.type === 'number' || item.type === 'digit' ? 'digit' : 'text'}}"
          placeholder="{{item.placeholder}}"
          value="{{item.isCustom ? customFields[item.bindKey] : item.fieldValue}}"
          data-k="{{item.bindKey}}"
          data-custom="{{item.isCustom ? '1' : '0'}}"
          bindinput="onField"
        />
      </view>
    </block>
  </view>

  <view class="card card--flat submit-wrap">
    <button class="btn-primary submit-btn" loading="{{submitting}}" disabled="{{submitting}}" bindtap="onSubmit">
      {{isEditIce || isIceMode ? '认领任务' : '提交报名'}}
    </button>
  </view>
</view>
