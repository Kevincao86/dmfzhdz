.page-hero--compact {
  padding: 28rpx 32rpx;
}

.page-hero--compact .page-hero-title {
  font-size: 36rpx;
}

.page-hero--compact .page-hero-sub {
  font-size: 24rpx;
}

.apply-recruit-stats {
  padding: 8rpx 32rpx 16rpx;
}

.apply-recruit-row {
  display: flex;
  align-items: flex-start;
  gap: 20rpx;
  padding: 20rpx 0;
  border-bottom: 2rpx solid #f1f5f9;
}

.apply-recruit-row:last-of-type {
  border-bottom: none;
}

.apply-recruit-icon {
  width: 40rpx;
  font-size: 32rpx;
  line-height: 1.2;
  flex-shrink: 0;
}

.apply-recruit-body {
  flex: 1;
  min-width: 0;
}

.apply-recruit-label {
  display: block;
  font-size: 24rpx;
  color: #64748b;
}

.apply-recruit-val {
  display: block;
  margin-top: 6rpx;
  font-size: 30rpx;
  font-weight: 700;
  color: #0f172a;
}

.apply-tier-hint {
  display: block;
  margin: 0 0 20rpx;
  padding: 16rpx 20rpx;
  font-size: 24rpx;
  line-height: 1.5;
  color: #4338ca;
  background: #eef2ff;
  border-radius: 12rpx;
}

.apply-tier-hint--warn {
  color: #b45309;
  background: #fffbeb;
  border: 1rpx solid #fcd34d;
}

.sync-card {
  background: linear-gradient(135deg, var(--lq-primary-50) 0%, #ffffff 100%);
  border-color: #c7d2fe;
}

.sync-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.sync-icon-wrap {
  width: 72rpx;
  height: 72rpx;
  line-height: 72rpx;
  text-align: center;
  font-size: 32rpx;
  color: var(--lq-primary-dark);
  background: #e0e7ff;
  border-radius: 20rpx;
  flex-shrink: 0;
}

.sync-text {
  flex: 1;
  min-width: 0;
}

.sync-title {
  display: block;
  font-size: 28rpx;
  font-weight: 700;
  color: #0f172a;
}

.sync-hint {
  display: block;
  margin-top: 6rpx;
  font-size: 24rpx;
  color: #64748b;
  line-height: 1.45;
}

.tip-card {
  padding: 24rpx 32rpx;
  background: #f8fafc;
}

.submit-wrap {
  margin-bottom: 48rpx;
  padding: 28rpx 32rpx;
}

.submit-btn {
  width: 100%;
}

.tip-card--warn {
  background: #fef2f2;
  border: 1rpx solid #fecaca;
}

.tip-card--gray {
  background: #fffbeb;
  border: 1rpx solid #fde68a;
}

.warn-text {
  color: #b91c1c;
}

.bundle-row {
  padding: 16rpx 0;
  border-bottom: 1rpx solid #e2e8f0;
}

.bundle-row:last-child {
  border-bottom: none;
}

.bundle-title {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: #0f172a;
}

.bundle-sub {
  display: block;
  margin-top: 6rpx;
  font-size: 24rpx;
  color: #64748b;
}

.apply-textarea {
  width: 100%;
  height: 180rpx;
  min-height: 180rpx;
  max-height: 240rpx;
  padding: 22rpx 24rpx;
  background: #fdfbff;
  border: 3rpx solid var(--lq-border);
  border-radius: var(--lq-radius-sm);
  font-size: 28rpx;
  line-height: 1.5;
  box-sizing: border-box;
}
