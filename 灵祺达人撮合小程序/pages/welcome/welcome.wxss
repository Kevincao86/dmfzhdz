@import '../../styles/theme.wxss';

.welcome-page {
  box-sizing: border-box;
  min-height: 100vh;
  padding: 12rpx 40rpx calc(28rpx + env(safe-area-inset-bottom));
  display: flex;
  flex-direction: column;
  align-items: center;
  background: #f7f6fb;
}

.welcome-head {
  width: 100%;
  padding-top: 24rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.welcome-head__logo {
  width: 96rpx;
  height: 96rpx;
  border: 4rpx solid rgba(255, 255, 255, 0.85);
  box-shadow: 0 10rpx 28rpx rgba(30, 58, 95, 0.12);
}

.welcome-head__title {
  margin-top: 20rpx;
  font-size: 48rpx;
  font-weight: 750;
  color: #2a2140;
  letter-spacing: 2rpx;
}

.welcome-head__sub {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #5b6b7c;
  letter-spacing: 1rpx;
}

.welcome-grid {
  width: 100%;
  margin-top: 32rpx;
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20rpx;
}

.welcome-tile {
  min-height: 188rpx;
  padding: 22rpx 20rpx 18rpx;
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.62);
  border: 2rpx solid rgba(255, 255, 255, 0.88);
  box-shadow: 0 12rpx 36rpx rgba(90, 120, 160, 0.1);
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
}

.welcome-tile--hover {
  background: rgba(255, 255, 255, 0.8);
}

.welcome-tile--on {
  transform: none;
  background: #fff;
  border-color: #7c4dff;
  box-shadow: 0 8rpx 24rpx rgba(124, 77, 255, 0.12);
}

.welcome-tile__mark {
  font-size: 22rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
  color: #7c3aed;
}

.welcome-tile--talent .welcome-tile__mark { color: #2a2140; }
.welcome-tile--shoot .welcome-tile__mark { color: #0f4c5c; }
.welcome-tile--edit .welcome-tile__mark { color: #0f5c54; }

.welcome-tile__label {
  margin-top: 10rpx;
  font-size: 36rpx;
  font-weight: 750;
  color: #2a2140;
}

.welcome-tile__sub {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #64748b;
  line-height: 1.4;
}

.welcome-enter {
  margin-top: 28rpx;
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  font-size: 30rpx;
  font-weight: 700;
  color: #94a3b8;
  background: rgba(255, 255, 255, 0.55);
  border: 2rpx solid rgba(255, 255, 255, 0.8);
  border-radius: 16rpx;
}

.welcome-enter--on {
  color: #fff;
  background: #7c4dff;
  border-color: #7c4dff;
}

.welcome-cluster {
  display: none;
}

.welcome-cluster__glow {
  position: absolute;
  border-radius: 50%;
  pointer-events: none;
}

.welcome-cluster__glow--a {
  width: 280rpx;
  height: 280rpx;
  left: 8%;
  top: 18%;
  background: radial-gradient(circle, rgba(186, 230, 253, 0.55) 0%, transparent 70%);
}

.welcome-cluster__glow--b {
  width: 320rpx;
  height: 320rpx;
  right: 0;
  bottom: 0;
  background: radial-gradient(circle, rgba(221, 214, 254, 0.5) 0%, transparent 70%);
}

.welcome-glass {
  position: absolute;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(255, 255, 255, 0.42);
  border: 2rpx solid rgba(255, 255, 255, 0.78);
  box-shadow: 0 18rpx 40rpx rgba(90, 120, 160, 0.14);
  backdrop-filter: blur(18px);
}

.welcome-glass__icon {
  width: 72%;
  height: 72%;
}

.welcome-glass--0 {
  width: 148rpx;
  height: 148rpx;
  left: 18%;
  top: 22%;
  border-radius: 36rpx;
  transform: rotate(-12deg);
  z-index: 3;
}

.welcome-glass--1 {
  width: 168rpx;
  height: 168rpx;
  left: 42%;
  top: 8%;
  border-radius: 40rpx;
  transform: rotate(8deg);
  z-index: 4;
}

.welcome-glass--2 {
  width: 132rpx;
  height: 132rpx;
  left: 6%;
  top: 52%;
  border-radius: 32rpx;
  transform: rotate(14deg);
  z-index: 2;
}

.welcome-glass--3 {
  width: 140rpx;
  height: 140rpx;
  right: 8%;
  top: 42%;
  border-radius: 34rpx;
  transform: rotate(-7deg);
  z-index: 5;
}

.welcome-glass--4 {
  width: 124rpx;
  height: 124rpx;
  left: 38%;
  top: 58%;
  border-radius: 30rpx;
  transform: rotate(18deg);
  z-index: 1;
}

.welcome-vortex {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 99999;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  pointer-events: auto;
  background: transparent;
}

.welcome-vortex__burst,
.welcome-vortex__spin {
  position: absolute;
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  opacity: 0;
  transform: scale(0);
}

.welcome-vortex__spin {
  width: 64rpx;
  height: 64rpx;
  filter: blur(2rpx);
}

.welcome-vortex--on .welcome-vortex__burst {
  animation: welcome-vortex-burst 0.42s cubic-bezier(0.18, 0.72, 0.22, 1) forwards;
}

.welcome-vortex--on .welcome-vortex__spin {
  animation: welcome-vortex-spin 0.42s cubic-bezier(0.2, 0.65, 0.25, 1) forwards;
}

@keyframes welcome-vortex-burst {
  0% { opacity: 0.85; transform: scale(0); }
  35% { opacity: 1; transform: scale(18); }
  100% { opacity: 1; transform: scale(90); }
}

@keyframes welcome-vortex-spin {
  0% { opacity: 0.55; transform: scale(0) rotate(0deg); }
  40% { opacity: 0.75; transform: scale(14) rotate(120deg); }
  100% { opacity: 0.95; transform: scale(88) rotate(240deg); }
}
