@import '../../styles/theme.wxss';

.welcome-page {
  box-sizing: border-box;
  min-height: 100vh;
  padding: 12rpx 40rpx calc(28rpx + env(safe-area-inset-bottom));
  display: flex;
  flex-direction: column;
  align-items: center;
  background: linear-gradient(180deg, #d9f3fb 0%, #e9f8f4 38%, #f4eefc 72%, #fbf7ff 100%);
}

.welcome-head {
  width: 100%;
  padding-top: 24rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.welcome-head__logo {
  width: 96rpx;
  height: 96rpx;
  border: 4rpx solid rgba(255, 255, 255, 0.85);
  box-shadow: 0 10rpx 28rpx rgba(30, 58, 95, 0.12);
}

.welcome-head__title {
  margin-top: 20rpx;
  font-size: 48rpx;
  font-weight: 750;
  color: #1e3a5f;
  letter-spacing: 2rpx;
}

.welcome-head__sub {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #5b6b7c;
  letter-spacing: 1rpx;
}

.welcome-grid {
  width: 100%;
  margin-top: 56rpx;
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20rpx;
}

.welcome-tile {
  min-height: 220rpx;
  padding: 28rpx 22rpx 24rpx;
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.62);
  border: 2rpx solid rgba(255, 255, 255, 0.88);
  box-shadow: 0 12rpx 36rpx rgba(90, 120, 160, 0.1);
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
}

.welcome-tile--hover {
  background: rgba(255, 255, 255, 0.8);
}

.welcome-tile--on {
  transform: none;
  background: rgba(255, 255, 255, 0.92);
  border-color: #1e3a5f;
  box-shadow: 0 12rpx 36rpx rgba(30, 58, 95, 0.14);
}

.welcome-tile__mark {
  font-size: 22rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
  color: #7c3aed;
}

.welcome-tile--talent .welcome-tile__mark { color: #1e3a5f; }
.welcome-tile--shoot .welcome-tile__mark { color: #0f4c5c; }
.welcome-tile--edit .welcome-tile__mark { color: #0f5c54; }

.welcome-tile__label {
  margin-top: 10rpx;
  font-size: 36rpx;
  font-weight: 750;
  color: #1e3a5f;
}

.welcome-tile__sub {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #64748b;
  line-height: 1.4;
}

.welcome-enter {
  margin-top: 48rpx;
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  font-size: 30rpx;
  font-weight: 700;
  color: #94a3b8;
  background: rgba(255, 255, 255, 0.55);
  border: 2rpx solid rgba(255, 255, 255, 0.8);
  border-radius: 16rpx;
}

.welcome-enter--on {
  color: #1e3a5f;
  background: #f5c84c;
  border-color: #f5c84c;
}

.welcome-plats {
  margin-top: auto;
  padding-top: 36rpx;
  width: 100%;
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
}

.welcome-plat {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}

.welcome-plat__icon {
  width: 64rpx;
  height: 64rpx;
  border-radius: 16rpx;
}

.welcome-plat__name {
  font-size: 18rpx;
  color: #7b8a99;
  line-height: 1.2;
}

.welcome-vortex {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 99999;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  pointer-events: auto;
  background: transparent;
}

.welcome-vortex__burst,
.welcome-vortex__spin {
  position: absolute;
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  opacity: 0;
  transform: scale(0);
}

.welcome-vortex__spin {
  width: 64rpx;
  height: 64rpx;
  filter: blur(2rpx);
}

.welcome-vortex--on .welcome-vortex__burst {
  animation: welcome-vortex-burst 0.42s cubic-bezier(0.18, 0.72, 0.22, 1) forwards;
}

.welcome-vortex--on .welcome-vortex__spin {
  animation: welcome-vortex-spin 0.42s cubic-bezier(0.2, 0.65, 0.25, 1) forwards;
}

@keyframes welcome-vortex-burst {
  0% { opacity: 0.85; transform: scale(0); }
  35% { opacity: 1; transform: scale(18); }
  100% { opacity: 1; transform: scale(90); }
}

@keyframes welcome-vortex-spin {
  0% { opacity: 0.55; transform: scale(0) rotate(0deg); }
  40% { opacity: 0.75; transform: scale(14) rotate(120deg); }
  100% { opacity: 0.95; transform: scale(88) rotate(240deg); }
}
