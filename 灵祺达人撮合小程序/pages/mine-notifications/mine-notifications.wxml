<view class="ntf-page page-shell">
  <view wx:if="{{totalCount === 0}}" class="card state-empty ntf-empty">
    <text class="empty-title">暂无通知</text>
    <text class="hint">{{emptyHint || '发单、报名、PR 入选通知会显示在这里；请下拉刷新'}}</text>
  </view>

  <block wx:else>
    <view wx:for="{{sections}}" wx:key="id" class="ntf-section">
      <text class="ntf-section-title">{{item.title}}</text>
      <view
        wx:for="{{item.rows}}"
        wx:for-item="row"
        wx:key="id"
        class="card ntf-card {{row.pinned ? 'ntf-card--pinned' : ''}} {{row.read ? '' : 'ntf-card--unread'}}"
      >
        <view class="ntf-card-head">
          <view class="ntf-card-head-left">
            <text class="ntf-cat ntf-cat--{{row.category}}">{{row.categoryLabel}}</text>
            <text class="ntf-read {{row.read ? 'ntf-read--ok' : 'ntf-read--new'}}">{{row.readLabel}}</text>
          </view>
          <text class="ntf-time">{{row.createdAt}}</text>
        </view>
        <text class="title-lg ntf-title">{{row.title}}</text>
        <text class="hint ntf-body">{{row.body}}</text>
        <image
          wx:if="{{row.imageUrl}}"
          class="ntf-image"
          src="{{row.imageUrl}}"
          mode="widthFix"
          data-url="{{row.imageUrl}}"
          bindtap="onPreviewInboxImage"
        />
        <view wx:if="{{row.showSelectionActions}}" class="ntf-actions">
          <button
            class="ntf-action-btn"
            data-id="{{row.id}}"
            data-action="confirmed"
            bindtap="onSelectionAction"
          >确认</button>
          <button
            class="ntf-action-btn ntf-action-btn--primary"
            data-id="{{row.id}}"
            data-action="joined"
            bindtap="onSelectionAction"
          >已入群</button>
        </view>
      </view>
    </view>
  </block>
</view>
