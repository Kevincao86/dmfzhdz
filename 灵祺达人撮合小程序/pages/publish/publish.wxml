                  >
                    <text class="pub-linke-client-name">{{item.accountDisplayName || item.clientLabel || '客户商家'}}</text>
                    <text class="pub-linke-client-id">ID {{item.merchantAccountId}}</text>
                  </view>
                </view>
                <view class="pub-field" wx:if="{{form.linkeAttach.clientId}}">
                  <text class="pub-label">商家联系电话 *</text>
