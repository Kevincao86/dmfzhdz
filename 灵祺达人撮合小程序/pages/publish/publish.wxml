              <view
                class="pub-radio-opt {{form.iceVerifyMode !== 'pr' ? 'pub-radio-opt--on' : ''}}"
                data-val="ai"
                catchtap="onIceVerifyModePick"
              >AI 核查</view>
              <view
                class="pub-radio-opt {{form.iceVerifyMode === 'pr' ? 'pub-radio-opt--on' : ''}}"
                data-val="pr"
                catchtap="onIceVerifyModePick"
              >PR 审核</view>
            </view>
