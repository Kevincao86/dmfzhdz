<template name="pubLifeBg">
  <view class="pub-life-bg" aria-hidden="true">
    <view class="pub-life-blob pub-life-blob--1"></view>
    <view class="pub-life-blob pub-life-blob--2"></view>
    <view class="pub-life-blob pub-life-blob--3"></view>
    <text class="pub-life-ico pub-life-ico--1">🍜</text>
    <text class="pub-life-ico pub-life-ico--2">☕</text>
    <text class="pub-life-ico pub-life-ico--3">🏪</text>
    <text class="pub-life-ico pub-life-ico--4">📍</text>
    <text class="pub-life-ico pub-life-ico--5">🎬</text>
    <text class="pub-life-ico pub-life-ico--6">🛍️</text>
  </view>
</template>

<template name="pubStepBarV2">
  <view class="pub-steps-v2">
    <view class="pub-steps-v2__line pub-steps-v2__line--a {{step === 'channel' ? 'pub-steps-v2__line--on' : 'pub-steps-v2__line--done'}}" />
    <view class="pub-steps-v2__line pub-steps-v2__line--b {{step === 'target' ? 'pub-steps-v2__line--on' : (step === 'mode' || step === 'form' || step === 'done' ? 'pub-steps-v2__line--done' : '')}}" />
    <view class="pub-steps-v2__line pub-steps-v2__line--c {{step === 'mode' || step === 'form' ? 'pub-steps-v2__line--on' : (step === 'done' ? 'pub-steps-v2__line--done' : '')}}" />
    <view class="pub-step-v2 {{step === 'channel' ? 'pub-step-v2--on' : 'pub-step-v2--done'}}">
      <view class="pub-step-v2__num">1</view>
      <text class="pub-step-v2__label">招募方式</text>
    </view>
    <view class="pub-step-v2 {{step === 'target' ? 'pub-step-v2--on' : (step === 'mode' || step === 'form' || step === 'done' ? 'pub-step-v2--done' : '')}}">
      <view class="pub-step-v2__num">2</view>
      <text class="pub-step-v2__label">选择对象</text>
    </view>
    <view class="pub-step-v2 {{step === 'mode' || step === 'form' ? 'pub-step-v2--on' : (step === 'done' ? 'pub-step-v2--done' : '')}}">
      <view class="pub-step-v2__num">3</view>
      <text class="pub-step-v2__label">填写信息</text>
    </view>
    <view class="pub-step-v2 {{step === 'done' ? 'pub-step-v2--on' : ''}}">
      <view class="pub-step-v2__num">4</view>
      <text class="pub-step-v2__label">确认发布</text>
    </view>
  </view>
</template>

<template name="pubStepBar">
  <view class="pub-steps">
    <view class="pub-step {{step === 'target' || step === 'placeholder' ? 'pub-step--on' : 'pub-step--done'}}">
      <view class="pub-step-dot" />
      <text class="pub-step-label">选择对象</text>
    </view>
    <view class="pub-step {{step === 'mode' ? 'pub-step--on' : (step === 'form' || step === 'done' ? 'pub-step--done' : '')}}">
      <view class="pub-step-dot" />
      <text class="pub-step-label">填写信息</text>
    </view>
    <view class="pub-step {{step === 'form' ? 'pub-step--on' : (step === 'done' ? 'pub-step--done' : '')}}">
      <view class="pub-step-dot" />
      <text class="pub-step-label">确认发布</text>
    </view>
  </view>
</template>

<view class="pub-page pub-page--{{step}} {{lqThemeClass}}">
  <!-- 第一步：选择普通招募 / 定向邀约 -->
  <block wx:if="{{step === 'channel'}}">
    <view class="pub-screen pub-screen--mode">
      <template is="pubLifeBg" />
      <view class="pub-target-top" style="{{heroHeadStyle}}">
        <view class="pub-target-nav">
          <text class="pub-target-back" bindtap="onBackFromChannel">‹</text>
          <text class="pub-target-brand">灵祺星选</text>
        </view>
        <template is="pubStepBarV2" data="{{step: step}}" />
      </view>
      <view class="pub-target-main">
        <text class="pub-target-title">选择招募方式</text>
        <text class="pub-target-sub">普通招募公开曝光 · 定向邀约点名确认</text>
        <view class="pub-mode-list pub-mode-list--target">
          <view
            wx:for="{{recruitChannels}}"
            wx:key="id"
            class="pub-mode-card pub-mode-card--icon"
            data-id="{{item.id}}"
            bindtap="onSelectChannel"
          >
            <view class="pub-mode-icon pub-mode-icon--{{item.id === 'targeted' ? 'brand' : 'visit'}}">
              <text class="pub-mode-icon-glyph">{{item.iconGlyph}}</text>
            </view>
            <view class="pub-mode-copy">
              <text class="pub-mode-name">{{item.label}}</text>
              <text class="pub-mode-sub">{{item.sub}}</text>
            </view>
            <text class="pub-mode-arrow">›</text>
          </view>
        </view>
      </view>
    </view>
  </block>

  <!-- 第二步：选择招募对象 -->
  <block wx:elif="{{step === 'target'}}">
    <view class="pub-screen pub-screen--target">
      <template is="pubLifeBg" />
      <view class="pub-target-top" style="{{heroHeadStyle}}">
        <view class="pub-target-nav">
          <text class="pub-target-back" bindtap="onBackFromTarget">‹</text>
          <text class="pub-target-brand">灵祺星选</text>
        </view>
        <template is="pubStepBarV2" data="{{step: step}}" />
      </view>
      <view class="pub-target-main">
        <text class="pub-target-title">选择招募对象</text>
        <text class="pub-target-sub">达人 · 拍摄 · 剪辑</text>
        <view class="pub-mode-list pub-mode-list--target">
          <view
            wx:for="{{recruitTargets}}"
            wx:key="id"
            class="pub-mode-card pub-mode-card--icon {{item.placeholder ? 'pub-mode-card--disabled' : ''}}"
            data-id="{{item.id}}"
            bindtap="onSelectTarget"
          >
            <view class="pub-mode-icon pub-mode-icon--{{item.iconKey}}">
              <text class="pub-mode-icon-glyph">{{item.iconGlyph}}</text>
            </view>
            <view class="pub-mode-copy">
              <text class="pub-mode-name">{{item.label}}</text>
              <text class="pub-mode-sub">{{item.sub}}</text>
            </view>
            <text wx:if="{{item.placeholder}}" class="pub-mode-badge">筹备中</text>
            <text wx:else class="pub-mode-arrow">›</text>
          </view>
        </view>
      </view>
    </view>
  </block>

  <block wx:elif="{{step === 'placeholder'}}">
    <view class="pub-screen">
      <template is="pubLifeBg" />
      <view class="pub-hero" style="{{heroHeadStyle}}">
        <text class="pub-hero-back" bindtap="onBackFromPlaceholder">‹ 返回</text>
        <text class="pub-hero-title">{{recruitTargetLabel}}招募</text>
        <text class="pub-hero-sub">表单字段明日整理，敬请期待</text>
      </view>
      <view class="pub-placeholder-card card">
        <text class="hint">当前仅支持「达人」发单；{{recruitTargetLabel}}任务发布表单将随后开放。</text>
      </view>
    </view>
  </block>

  <!-- 第三步：选择招募模式 -->
  <block wx:elif="{{step === 'mode'}}">
    <view class="pub-screen pub-screen--mode">
      <template is="pubLifeBg" />
      <view class="pub-target-top" style="{{heroHeadStyle}}">
        <view class="pub-target-nav">
          <text class="pub-target-back" bindtap="onBackFromMode">‹</text>
          <text class="pub-target-brand">灵祺星选</text>
        </view>
        <template is="pubStepBarV2" data="{{step: step}}" />
      </view>
      <view class="pub-target-main">
        <text class="pub-target-title">选择招募模式</text>
        <text class="pub-target-sub">探店 · 品宣 · 直播达人</text>
        <view class="pub-mode-list pub-mode-list--target">
          <view
            wx:for="{{recruitModes}}"
            wx:key="id"
            class="pub-mode-card pub-mode-card--icon"
            data-id="{{item.id}}"
            bindtap="onSelectMode"
          >
            <view class="pub-mode-icon pub-mode-icon--{{item.iconKey}}">
              <text class="pub-mode-icon-glyph">{{item.iconGlyph}}</text>
            </view>
            <view class="pub-mode-copy">
              <text class="pub-mode-name">{{item.label}}</text>
              <text class="pub-mode-sub">{{item.sub}}</text>
            </view>
            <text class="pub-mode-arrow">›</text>
          </view>
        </view>
      </view>
    </view>
  </block>

  <!-- 填写表单（主界面 + 全屏选择叠层，保留滚动位置） -->
  <block wx:elif="{{step === 'form'}}">
    <view class="pub-form-host">
    <view class="pub-screen pub-screen--form" hidden="{{pickerView}}">
      <template is="pubLifeBg" />
    <view class="pub-form-layout">
      <view class="pub-target-top pub-form-top" style="{{formHeadStyle}}">
        <view class="pub-target-nav">
          <text class="pub-target-back" bindtap="onBackToMode">‹</text>
          <text class="pub-target-brand">灵祺星选</text>
        </view>
        <template is="pubStepBarV2" data="{{step: step}}" />
      </view>
      <view class="pub-form-title-bar">
        <text class="pub-target-title pub-form-title-bar__title">{{isEditMode ? '编辑招募' : (isTargetedRecruit ? '填写定向邀约' : '填写招募信息')}}</text>
        <text class="pub-form-mode-chip">{{isTargetedRecruit ? '定向邀约' : recruitModeLabel}}</text>
      </view>
      <scroll-view
        class="pub-form-scroll"
        scroll-y
        enable-flex
        scroll-top="{{formScrollTop}}"
        scroll-into-view="{{scrollIntoView}}"
        scroll-with-animation="{{scrollWithAnimation}}"
      >
        <view class="pub-form-body">
          <view class="pub-form-card">
          <view class="pub-field" id="field-delivery-window" wx:if="{{!isTargetedRecruit}}">
            <text class="pub-label">投放窗口 *</text>
            <view class="pub-window-row">
              <view
                wx:for="{{deliveryWindows}}"
                wx:key="id"
                class="pub-window-opt {{form.deliveryWindow === item.id ? 'pub-window-opt--on' : ''}}"
                data-id="{{item.id}}"
                bindtap="onDeliveryWindowTap"
              >
                <text class="pub-window-opt-name">{{item.label}}</text>
                <text class="pub-window-opt-sub">{{item.sub}}</text>
              </view>
            </view>
          </view>
          <view class="pub-field" id="field-signup-deadline" wx:if="{{showSignupDeadline && !isTargetedRecruit}}">
            <text class="pub-label">招募报名截止时间 *</text>
            <view class="pub-deadline-row">
              <picker class="pub-deadline-pick" mode="date" value="{{signupDeadlineDate}}" start="{{todayDate}}" bindchange="onSignupDeadlineDate">
                <view class="pub-select pub-select--half">
                  <text class="pub-select-text {{signupDeadlineDate ? '' : 'pub-select-text--ph'}}">{{signupDeadlineDate || '选择日期'}}</text>
                  <text class="pub-select-arrow">›</text>
                </view>
              </picker>
              <picker class="pub-deadline-pick" mode="time" value="{{signupDeadlineTime}}" bindchange="onSignupDeadlineTime">
                <view class="pub-select pub-select--half">
                  <text class="pub-select-text">{{signupDeadlineTime || '23:59'}}</text>
                  <text class="pub-select-arrow">›</text>
                </view>
              </picker>
            </view>
          </view>
          <view class="pub-field pub-field--hint" wx:if="{{!showSignupDeadline && !isTargetedRecruit}}">
            <text class="pub-label">招募报名截止</text>
            <text class="pub-urgent-deadline-hint">急单大厅：发布后 24 小时内截止报名（无需填写）</text>
          </view>
          <view class="pub-field" wx:if="{{isTargetedRecruit}}">
            <text class="pub-label">邀约响应时间 *</text>
            <view class="pub-radio-pair pub-radio-pair--wrap">
              <view
                wx:for="{{inviteHourOptions}}"
                wx:key="id"
                class="pub-radio-opt {{form.inviteResponseHours == item.id ? 'pub-radio-opt--on' : ''}}"
                data-hours="{{item.id}}"
                bindtap="onInviteHoursPick"
              >{{item.label}}</view>
            </view>
            <text class="pub-hint">达人须在此时间内接受或拒绝邀约；可随时补邀更多人</text>
          </view>
          </view>
          <view class="pub-form-card">
          <view class="pub-field" id="field-title">
            <text class="pub-label">招募标题 *</text>
            <input class="pub-input" placeholder="{{recruitMode === 'live' ? '如：火锅专场直播带货招募' : '如：春季火锅探店招募'}}" value="{{form.title}}" data-key="title" bindinput="onFieldInput" />
          </view>
          <block wx:if="{{recruitMode === 'live'}}">
            <view class="pub-field">
              <text class="pub-label">直播平台 *</text>
              <view class="pub-radio-pair pub-radio-pair--wrap">
                <view
                  wx:for="{{livePlatforms}}"
                  wx:key="*this"
                  class="pub-radio-opt {{form.livePlatform === item ? 'pub-radio-opt--on' : ''}}"
                  data-key="livePlatform"
                  data-val="{{item}}"
                  bindtap="onLiveOptionPick"
                >{{item}}</view>
              </view>
            </view>
            <view class="pub-field">
              <text class="pub-label">直播日期 *</text>
              <picker mode="date" value="{{form.liveDate}}" start="{{todayDate}}" bindchange="onLiveDatePick">
                <view class="pub-select">
                  <text class="pub-select-text {{form.liveDate ? '' : 'pub-select-text--ph'}}">{{form.liveDate || '选择日期'}}</text>
                  <text class="pub-select-arrow">›</text>
                </view>
              </picker>
            </view>
            <view class="pub-field">
              <text class="pub-label">开播时间 *</text>
              <picker mode="time" value="{{form.liveTimeStart}}" bindchange="onLiveTimePick">
                <view class="pub-select">
                  <text class="pub-select-text {{form.liveTimeStart ? '' : 'pub-select-text--ph'}}">{{form.liveTimeStart || '选择时间'}}</text>
                  <text class="pub-select-arrow">›</text>
                </view>
              </picker>
            </view>
            <view class="pub-field">
              <text class="pub-label">预计时长 *</text>
              <view class="pub-radio-pair">
                <view
                  wx:for="{{liveDurations}}"
                  wx:key="*this"
                  class="pub-radio-opt {{form.liveDuration === item ? 'pub-radio-opt--on' : ''}}"
                  data-key="liveDuration"
                  data-val="{{item}}"
                  bindtap="onLiveOptionPick"
                >{{item}}</view>
              </view>
            </view>
            <view class="pub-field">
              <text class="pub-label">直播类型 *</text>
              <view class="pub-radio-pair pub-radio-pair--wrap">
                <view
                  wx:for="{{liveTypes}}"
                  wx:key="*this"
                  class="pub-radio-opt {{form.liveType === item ? 'pub-radio-opt--on' : ''}}"
                  data-key="liveType"
                  data-val="{{item}}"
                  bindtap="onLiveOptionPick"
                >{{item}}</view>
              </view>
            </view>
            <view class="pub-field">
              <text class="pub-label">带货商品/套餐说明 *</text>
              <textarea
                class="pub-textarea"
                placeholder="商品名称、规格、团购价、佣金空间、是否独家等"
                value="{{form.productSummary}}"
                data-key="productSummary"
                bindinput="onFieldInput"
                maxlength="800"
              />
            </view>
            <view class="pub-field">
              <text class="pub-label">样品/寄样方式 *</text>
              <view class="pub-radio-pair pub-radio-pair--wrap">
                <view
                  wx:for="{{samplePolicies}}"
                  wx:key="*this"
                  class="pub-radio-opt {{form.samplePolicy === item ? 'pub-radio-opt--on' : ''}}"
                  data-key="samplePolicy"
                  data-val="{{item}}"
                  bindtap="onLiveOptionPick"
                >{{item}}</view>
              </view>
            </view>
            <view class="pub-field">
              <text class="pub-label">脚本/话术要求</text>
              <textarea
                class="pub-textarea"
                placeholder="口播要点、禁说词、优惠机制、挂车链接说明等"
                value="{{form.scriptRequirement}}"
                data-key="scriptRequirement"
                bindinput="onFieldInput"
                maxlength="600"
              />
            </view>
          </block>
          <view class="pub-field" id="field-platform" wx:if="{{!isSupplierPublish && recruitMode !== 'live'}}">
            <text class="pub-label">招募平台 *</text>
            <view class="pub-select" data-view="platform" bindtap="openPicker">
              <image wx:if="{{platformSelectIcon}}" class="pub-select__icon" src="{{platformSelectIcon}}" mode="aspectFit" />
              <text class="pub-select-text {{platformPlaceholder ? 'pub-select-text--ph' : ''}}">{{platformDisplayText}}</text>
              <text class="pub-select-arrow">›</text>
            </view>
          </view>
          <view class="pub-field" id="field-city">
            <text class="pub-label">招募城市 *</text>
            <view class="pub-select" data-view="city" bindtap="openPicker">
              <text class="pub-select-text {{cityPlaceholder ? 'pub-select-text--ph' : ''}}">{{cityDisplayText}}</text>
              <text class="pub-select-arrow">›</text>
            </view>
          </view>
          <view class="pub-field" id="field-merchant-location">
            <text class="pub-label">商家位置</text>
            <text class="pub-label-hint">选填；地图选点后可导航</text>
            <view class="pub-location-row">
              <input
                class="pub-input pub-input--location"
                placeholder="门店名 + 详细地址"
                value="{{form.merchantLocationAddress}}"
                bindinput="onMerchantLocationInput"
              />
              <view class="pub-location-map-btn" bindtap="onPickMerchantLocation">地图选点</view>
            </view>
            <text wx:if="{{merchantLocationMapReady}}" class="pub-location-map-tag">已地图定位 · 达人端可一键导航</text>
          </view>
          <view class="pub-field" id="field-tag">
            <text class="pub-label">{{isSupplierPublish ? '需求品类标签 *' : '需求达人标签 *'}}</text>
            <text class="pub-label-hint">最多 2 个，不可重复</text>
            <view class="pub-select" data-view="tag" bindtap="openPicker">
              <text class="pub-select-text {{tagsPlaceholder ? 'pub-select-text--ph' : ''}}">{{tagsDisplayText}}</text>
              <text class="pub-select-arrow">›</text>
            </view>
          </view>
          <view class="pub-field" id="field-fans" wx:if="{{!isSupplierPublish}}">
            <text class="pub-label">达人粉丝要求 *</text>
            <view class="pub-radio-pair pub-radio-pair--fans">
              <view
                class="pub-radio-opt {{form.fansLimitMode === 'unlimited' ? 'pub-radio-opt--on' : ''}}"
                data-mode="unlimited"
                bindtap="onFansLimitModeTap"
              >不限</view>
              <view
                class="pub-radio-opt {{form.fansLimitMode === 'limit' ? 'pub-radio-opt--on' : ''}}"
                data-mode="limit"
                bindtap="onFansLimitModeTap"
              >限制</view>
            </view>
            <view class="pub-fans-limit-row" wx:if="{{form.fansLimitMode === 'limit'}}">
              <text class="pub-fans-limit-k">粉丝 ≥</text>
              <input
                class="pub-input pub-input--fans-min"
                placeholder="如：10000 或 1万"
                value="{{form.fansMin}}"
                bindinput="onFansMinInput"
              />
            </view>
          </view>
          <block wx:if="{{isSupplierPublish && recruitTarget === 'shoot'}}">
            <view class="pub-field">
              <text class="pub-label">拍摄日期 *</text>
              <picker mode="date" value="{{form.shootDate}}" bindchange="onShootDatePick">
                <view class="pub-select"><text class="pub-select-text {{form.shootDate ? '' : 'pub-select-text--ph'}}">{{form.shootDate || '选择日期'}}</text><text class="pub-select-arrow">›</text></view>
              </picker>
            </view>
            <view class="pub-field">
              <text class="pub-label">拍摄时段 *</text>
              <view class="pub-deadline-row">
                <picker mode="time" value="{{form.shootTimeStart}}" data-key="shootTimeStart" bindchange="onShootTimePick">
                  <view class="pub-select pub-select--half"><text class="pub-select-text">{{form.shootTimeStart || '开始'}}</text></view>
                </picker>
                <picker mode="time" value="{{form.shootTimeEnd}}" data-key="shootTimeEnd" bindchange="onShootTimePick">
                  <view class="pub-select pub-select--half"><text class="pub-select-text">{{form.shootTimeEnd || '结束'}}</text></view>
                </picker>
              </view>
            </view>
            <view class="pub-field">
              <text class="pub-label">拍摄地点 *</text>
              <input class="pub-input" placeholder="门店名 + 详细地址" value="{{form.shootLocation}}" data-key="shootLocation" bindinput="onFieldInput" />
            </view>
            <view class="pub-field">
              <text class="pub-label">成片交付 *</text>
              <view class="pub-radio-pair pub-radio-pair--wrap">
                <view wx:for="{{deliverableGrid}}" wx:key="name" class="pub-radio-opt {{item.on ? 'pub-radio-opt--on' : ''}}" data-field="deliverables" data-name="{{item.name}}" bindtap="onSupplierListTap">{{item.name}}</view>
              </view>
            </view>
            <view class="pub-field">
              <text class="pub-label">设备要求</text>
              <view class="pub-radio-pair pub-radio-pair--wrap">
                <view wx:for="{{equipmentReqGrid}}" wx:key="name" class="pub-radio-opt {{item.on ? 'pub-radio-opt--on' : ''}}" data-field="equipmentRequired" data-name="{{item.name}}" bindtap="onSupplierListTap">{{item.name}}</view>
              </view>
            </view>
          </block>
          <block wx:if="{{isSupplierPublish && recruitTarget === 'edit'}}">
            <view class="pub-field">
              <text class="pub-label">素材来源 *</text>
              <view class="pub-radio-pair">
                <view wx:for="{{materialSources}}" wx:key="*this" class="pub-radio-opt {{form.materialSource === item ? 'pub-radio-opt--on' : ''}}" data-val="{{item}}" bindtap="onMaterialSourcePick">{{item}}</view>
              </view>
            </view>
            <view class="pub-field">
              <text class="pub-label">素材链接</text>
              <input class="pub-input" placeholder="网盘/链接（选填）" value="{{form.materialUrl}}" data-key="materialUrl" bindinput="onFieldInput" />
            </view>
            <view class="pub-field">
              <text class="pub-label">成片画幅 *</text>
              <view class="pub-radio-pair">
                <view wx:for="{{aspectRatios}}" wx:key="*this" class="pub-radio-opt {{form.aspectRatio === item ? 'pub-radio-opt--on' : ''}}" data-val="{{item}}" bindtap="onAspectRatioPick">{{item}}</view>
              </view>
            </view>
            <view class="pub-field">
              <text class="pub-label">目标时长 *</text>
              <view class="pub-radio-pair">
                <view wx:for="{{targetDurations}}" wx:key="*this" class="pub-radio-opt {{form.targetDuration === item ? 'pub-radio-opt--on' : ''}}" data-val="{{item}}" bindtap="onTargetDurationPick">{{item}}</view>
              </view>
            </view>
