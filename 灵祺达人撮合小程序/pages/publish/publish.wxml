      </view>
    </view>
  </block>

  <!-- 全屏：费用模式 -->
  <block wx:if="{{pickerView === 'fee'}}">
    <view class="pub-full pub-full--pick">
      <template is="pubLifeBg" />
      <view class="pub-full-head" style="{{formHeadStyle}}">
        <text class="pub-full-back" bindtap="onPickerBack">‹ 返回</text>
        <text class="pub-full-title">请选择费用模式</text>
      </view>
      <scroll-view class="pub-full-scroll" scroll-y>
        <view class="pub-full-body">
          <view
            wx:for="{{feeTypes}}"
            wx:key="id"
            class="pub-fee-row pub-full-fee-row {{form.feeTypeId === item.id ? 'pub-full-fee-row--on' : ''}}"
            data-id="{{item.id}}"
            bindtap="onFeeSelect"
          >
            <view class="pub-fee-radio {{form.feeTypeId === item.id ? 'pub-fee-radio--on' : ''}}" />
            <view class="pub-fee-text">
              <text class="pub-fee-label">{{item.label}}</text>
              <text class="pub-fee-desc">{{item.desc}}</text>
            </view>
          </view>
        </view>
      </scroll-view>
    </view>
  </block>

  <!-- 全屏：阶梯等级 -->
  <block wx:if="{{pickerView === 'tierLevel'}}">
    <view class="pub-full pub-full--pick">
      <template is="pubLifeBg" />
      <view class="pub-full-head" style="{{formHeadStyle}}">
        <text class="pub-full-back" bindtap="onPickerBack">‹ 返回</text>
        <text class="pub-full-title">达人等级</text>
      </view>
      <view class="pub-pick-main">
        <text class="pub-full-hint">每档仅选一个等级，各阶梯不可重复</text>
        <view class="pub-full-card pub-full-card--fit">
          <view class="pub-level-grid pub-level-grid--pick">
            <view
              wx:for="{{tierLevelGrid}}"
              wx:key="name"
              class="pub-level-cell {{item.on ? 'pub-level-cell--on' : ''}} {{item.disabled ? 'pub-level-cell--dis' : ''}}"
              data-name="{{item.name}}"
              bindtap="onTierLevelTap"
            >{{item.name}}</view>
          </view>
        </view>
      </view>
      <view class="pub-full-foot">
        <button class="btn-primary pub-full-btn" bindtap="confirmTierLevelPicker">确认</button>
      </view>
    </view>
  </block>

  <!-- 全屏：粉丝档位 -->
  <block wx:if="{{pickerView === 'fansTier'}}">
    <view class="pub-full pub-full--pick">
      <template is="pubLifeBg" />
      <view class="pub-full-head" style="{{formHeadStyle}}">
        <text class="pub-full-back" bindtap="onPickerBack">‹ 返回</text>
        <text class="pub-full-title">粉丝档位</text>
      </view>
      <scroll-view class="pub-full-scroll" scroll-y>
        <view class="pub-full-body">
          <view
            wx:for="{{fansTierPickerRanges}}"
            wx:key="*this"
            class="pub-full-opt"
            data-range="{{item}}"
            bindtap="onFansRangeTap"
          >{{item}}</view>
        </view>
      </scroll-view>
    </view>
  </block>

  <!-- 全屏：封面图库 -->
  <block wx:if="{{pickerView === 'coverGallery'}}">
    <view class="pub-full pub-full--pick">
      <template is="pubLifeBg" />
      <view class="pub-full-head" style="{{formHeadStyle}}">
        <text class="pub-full-back" bindtap="onPickerBack">‹ 返回</text>
        <text class="pub-full-title">封面图库</text>
      </view>
      <view class="pub-cover-tabs">
        <text class="pub-cover-tab {{coverGalleryTab === 'recommended' ? 'pub-cover-tab--on' : ''}}" data-tab="recommended" bindtap="onCoverGalleryTab">推荐</text>
        <text class="pub-cover-tab {{coverGalleryTab === 'all' ? 'pub-cover-tab--on' : ''}}" data-tab="all" bindtap="onCoverGalleryTab">全部</text>
        <text class="pub-cover-tab {{coverGalleryTab === 'platform' ? 'pub-cover-tab--on' : ''}}" data-tab="platform" bindtap="onCoverGalleryTab">平台</text>
        <text class="pub-cover-tab {{coverGalleryTab === 'tag' ? 'pub-cover-tab--on' : ''}}" data-tab="tag" bindtap="onCoverGalleryTab">标签</text>
      </view>
      <scroll-view wx:if="{{coverGalleryTab === 'platform'}}" class="pub-cover-sub-scroll" scroll-x enable-flex>
        <view class="pub-cover-sub-row">
          <text wx:for="{{coverPlatformNames}}" wx:key="*this" class="pub-cover-sub {{coverGallerySubKey === item ? 'pub-cover-sub--on' : ''}}" data-key="{{item}}" bindtap="onCoverGallerySubPick">{{item}}</text>
        </view>
      </scroll-view>
      <scroll-view wx:if="{{coverGalleryTab === 'tag'}}" class="pub-cover-sub-scroll" scroll-x enable-flex>
        <view class="pub-cover-sub-row">
          <text wx:for="{{coverTagNames}}" wx:key="*this" class="pub-cover-sub {{coverGallerySubKey === item ? 'pub-cover-sub--on' : ''}}" data-key="{{item}}" bindtap="onCoverGallerySubPick">{{item}}</text>
        </view>
      </scroll-view>
      <scroll-view class="pub-full-scroll pub-full-scroll--cover" scroll-y>
        <view class="pub-cover-grid">
          <view
            wx:for="{{coverGalleryItems}}"
            wx:key="id"
            class="pub-cover-cell {{form.coverLibraryId === item.id ? 'pub-cover-cell--on' : ''}}"
            data-id="{{item.id}}"
            bindtap="onCoverGalleryPick"
          >
            <image class="pub-cover-cell-img" src="{{item.url}}" mode="aspectFill" />
            <text class="pub-cover-cell-label">{{item.label}}</text>
          </view>
        </view>
      </scroll-view>
    </view>
  </block>

  <!-- 全屏：达人报名必填信息 -->
  <block wx:if="{{pickerView === 'applyForm'}}">
    <view class="pub-full pub-full--pick pub-full--apply-form">
      <template is="pubLifeBg" />
      <view class="pub-full-head" style="{{formHeadStyle}}">
        <text class="pub-full-back" bindtap="onPickerBack">‹ 返回</text>
        <text class="pub-full-title">达人报名信息</text>
      </view>
      <scroll-view class="pub-full-scroll" scroll-y>
        <view class="pub-full-body pub-apply-body">
          <text class="pub-full-hint" wx:if="{{applyFormEditorMode === 'template'}}">模版：{{applyFormTemplateName}}</text>
          <text class="pub-full-hint" wx:else>新建报名项 · 前 3 项随招募平台自动更名</text>
          <view class="pub-full-card pub-full-card--pad">
            <view class="tpl-field-row" wx:for="{{applyFormEditorRows}}" wx:key="id">
              <view class="tpl-field-type">
                <text class="tpl-field-type-txt">{{item.typeIcon}}</text>
                <text class="tpl-field-type-label">{{item.type === 'number' || item.type === 'digit' ? '数字' : '文本'}}</text>
              </view>
              <view class="tpl-field-main">
                <text class="tpl-field-label">{{item.displayLabel}}</text>
                <view class="tpl-field-req">
                  <text class="tpl-field-req-txt">必填</text>
                  <switch
                    class="tpl-req-switch"
                    checked="{{item.required}}"
                    color="#2563eb"
                    disabled="{{item.locked}}"
                    data-id="{{item.id}}"
                    bindchange="onApplyToggleRequired"
                  />
                </view>
              </view>
              <view class="tpl-field-actions">
                <view class="tpl-field-btn" data-id="{{item.id}}" bindtap="onApplyEditField">编辑</view>
                <view
                  wx:if="{{item.deletable}}"
                  class="tpl-field-btn tpl-field-btn--danger"
                  data-id="{{item.id}}"
                  bindtap="onApplyDeleteField"
                >删除</view>
              </view>
            </view>
            <view class="tpl-add-btn" bindtap="onApplyAddCustomField">+ 自定义其他报名项</view>
          </view>
        </view>
      </scroll-view>
      <view class="tpl-edit-footer pub-apply-footer">
        <button class="btn-secondary tpl-footer-btn" bindtap="onApplyFormPreview">预览</button>
        <button class="btn-primary tpl-footer-btn" bindtap="onApplyFormConfirm">{{applyFormEditorMode === 'template' || applyFormLibrarySaved ? '确认并返回' : '确认'}}</button>
      </view>
    </view>
    <view class="tpl-modal-mask" wx:if="{{showFieldModal}}" bindtap="onCloseFieldModal" />
    <view class="tpl-modal" wx:if="{{showFieldModal}}">
      <text class="tpl-modal-title">编辑报名项</text>
      <view class="form-row" wx:if="{{canEditLabel}}">
        <text class="form-label">名称</text>
        <input class="input" value="{{editLabel}}" bindinput="onEditLabelInput" />
      </view>
      <view class="form-row" wx:else>
        <text class="form-label">名称</text>
        <text class="tpl-modal-readonly">{{editLabel}}</text>
      </view>
      <view class="form-row">
        <text class="form-label">占位提示</text>
        <input class="input" placeholder="选填" value="{{editPlaceholder}}" bindinput="onEditPlaceholderInput" />
      </view>
      <view class="form-row tpl-modal-req">
        <text class="form-label">必填</text>
        <switch class="tpl-req-switch" checked="{{editRequired}}" color="#2563eb" bindchange="onEditRequiredChange" />
      </view>
      <view class="tpl-modal-actions">
        <button class="btn-secondary" bindtap="onCloseFieldModal">取消</button>
        <button class="btn-primary" bindtap="onConfirmFieldEdit">确定</button>
      </view>
    </view>
    <view class="tpl-modal-mask" wx:if="{{showApplyPreview}}" bindtap="onCloseApplyPreview" />
    <view class="tpl-preview-sheet" wx:if="{{showApplyPreview}}">
      <view class="tpl-preview-head">
        <text class="tpl-preview-title">报名预览</text>
        <text class="tpl-preview-sub">平台 {{applyFormPreviewPlatform}}</text>
        <view class="tpl-preview-close" bindtap="onCloseApplyPreview">关闭</view>
      </view>
      <scroll-view scroll-y class="tpl-preview-scroll">
        <view class="form-row" wx:for="{{applyPreviewRows}}" wx:key="id">
          <text class="form-label">{{item.displayLabel}}{{item.required ? ' *' : ''}}</text>
          <view class="picker-val picker-val--placeholder">{{item.placeholder || '请填写'}}</view>
        </view>
      </scroll-view>
    </view>
  </block>

    </view>
  </block>

  <view class="tpl-modal-mask" wx:if="{{showApplyTplPicker && step === 'form'}}" bindtap="onCloseApplyTplPicker" />
  <view class="pub-apply-tpl-modal" wx:if="{{showApplyTplPicker && step === 'form'}}">
    <text class="pub-apply-tpl-modal-title">使用我的模版</text>
    <scroll-view scroll-y class="pub-apply-tpl-modal-scroll">
      <view
        wx:for="{{customTemplateList}}"
        wx:key="id"
        class="pub-apply-tpl-modal-item"
        data-id="{{item.id}}"
        bindtap="onPickApplyTplFromModal"
      >
        <text class="pub-apply-tpl-modal-name">{{item.name}}</text>
        <text class="pub-apply-tpl-modal-sub">{{item.fields.length}} 个字段</text>
      </view>
    </scroll-view>
    <button class="btn-secondary pub-apply-tpl-modal-cancel" bindtap="onCloseApplyTplPicker">取消</button>
  </view>

  <!-- 创建成功 -->
  <block wx:elif="{{step === 'done'}}">
    <view class="pub-screen pub-screen--done">
      <template is="pubLifeBg" />
    <view class="pub-done-wrap">
      <view class="pub-done">
        <view class="pub-done-icon">✓</view>
        <text class="pub-done-title">招募已创建</text>
        <text class="pub-done-sub">{{createdOrder.title}}</text>
        <button class="btn-primary pub-done-btn" open-type="share">分享招募</button>
        <button class="btn-ghost pub-done-btn" bindtap="onCopyGroupShare">分享群聊（复制招募信息）</button>
        <button class="btn-secondary pub-done-btn" bindtap="onFinish">完成创建</button>
      </view>
    </view>
    </view>
  </block>
</view>
