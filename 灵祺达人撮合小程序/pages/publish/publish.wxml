          </view>
          <view class="pub-linke-card" wx:if="{{!isSupplierPublish && (form.platform === '抖音' || !form.platform)}}">
            <view class="pub-linke-head">
              <text class="pub-linke-title">抖音林客 · 挂接商家</text>
              <text class="pub-linke-tag">非必填</text>
            </view>
            <text class="pub-linke-hint">选「是」后，报名满员并通知达人时将自动在林客端创建定向招募。林客授权请在星选平台 Web 端完成，同账号将自动同步至小程序。</text>
            <view wx:if="{{!hasLinkeClients}}" class="pub-linke-empty">
