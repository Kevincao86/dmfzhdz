                  <view class="pub-tier-mode-tab {{item.priceMode === 'self_quote' ? 'pub-tier-mode-tab--on' : ''}}" data-index="{{tierIdx}}" data-kind="level" data-mode="self_quote" bindtap="onTierPriceModeTap">自报价</view>
                </view>
              </view>
              <view class="pub-tier-row" wx:if="{{item.priceMode !== 'self_quote'}}">
                <text class="pub-tier-k">达人价格</text>
                <input class="pub-tier-input" type="digit" placeholder="请填写 | 0代表置换" value="{{item.price}}" data-index="{{tierIdx}}" data-field="price" bindinput="onTierFieldInput" />
              </view>
              <view class="pub-tier-row" wx:else>
                <text class="pub-tier-k">达人价格</text>
                <text class="pub-tier-self-label">达人报名时自行报价</text>
              </view>
            </view>
            <view class="pub-add-tier" bindtap="onAddLevelTier">+ 添加阶梯</view>
          </view>
          <view class="pub-fee-panel" wx:if="{{form.feeTypeId === 'fans_tier'}}">
