              <view class="pub-tier-row" wx:else>
                <text class="pub-tier-k">达人价格</text>
                <text class="pub-tier-self-label">达人报名时自行报价</text>
              </view>
            </view>
            <view class="pub-add-tier" bindtap="onAddFansTier">+ 添加阶梯</view>
          </view>
          <view class="pub-field">
            <text class="pub-label">佣金 CPS（%）</text>
