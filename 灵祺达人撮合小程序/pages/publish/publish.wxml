                <button class="pub-cover-btn" loading="{{editGroupQrUploading}}" bindtap="onUploadEditGroupQr">{{form.editGroupQrImage ? '已上传群码' : '选择图片'}}</button>
                <button wx:if="{{form.editGroupQrImage}}" class="pub-cover-btn pub-cover-btn--ghost" bindtap="onClearEditGroupQr">清除</button>
              </view>
              <image wx:if="{{form.editGroupQrImage}}" class="pub-cover-preview" src="{{form.editGroupQrImage}}" mode="aspectFit" bindtap="onPreviewEditGroupQr" />
            </view>
          </view>
          <view class="pub-field" id="field-apply-form">
            <text class="pub-label">{{isSupplierPublish ? '团队报名必填信息 *' : '达人报名必填信息 *'}}</text>
            <view class="pub-select" data-view="applyForm" bindtap="openPicker">
              <text class="pub-select-text {{applyFormPlaceholder ? 'pub-select-text--ph' : ''}}">{{applyFormDisplayText}}</text>
              <text class="pub-select-arrow">›</text>
            </view>
          </view>
          <view class="pub-field" id="field-cover">
            <text class="pub-label">招募单封面图（选填）</text>
            <text class="pub-cover-hint">{{coverSourceHint}}</text>
            <image wx:if="{{coverPreviewUrl}}" class="pub-cover-preview" src="{{coverPreviewUrl}}" mode="aspectFill" bindtap="openCoverGallery" />
            <view class="pub-cover-actions">
              <button class="pub-cover-btn" bindtap="onCoverUpload">上传图片</button>
              <button class="pub-cover-btn" bindtap="openCoverGallery">从图库选择</button>
              <button class="pub-cover-btn {{coverAiOpen ? 'pub-cover-btn--on' : ''}}" bindtap="onCoverAiToggle">AI生成</button>
              <button wx:if="{{form.coverImage || form.coverLibraryId}}" class="pub-cover-btn pub-cover-btn--ghost" bindtap="onCoverClear">清除</button>
            </view>
            <view wx:if="{{coverAiOpen}}" class="pub-cover-ai">
              <text class="pub-cover-ai-hint">文字、要求和参考图均可选填 · {{posterAiPoints}}积分/张</text>
              <textarea class="pub-textarea pub-cover-ai-input" value="{{posterAiPrompt}}" maxlength="300" placeholder="选填：封面文字、风格或场景要求" bindinput="onPosterAiPrompt" />
              <view class="pub-cover-actions">
                <button class="pub-cover-btn" bindtap="onPosterAiPickRef">{{posterAiRefPreview ? '已选参考图' : '选填参考图'}}</button>
                <button wx:if="{{posterAiRefPreview}}" class="pub-cover-btn pub-cover-btn--ghost" bindtap="onPosterAiClearRef">清除参考图</button>
              </view>
              <image wx:if="{{posterAiRefPreview}}" class="pub-cover-ai-ref" src="{{posterAiRefPreview}}" mode="aspectFill" bindtap="onPosterAiPickRef" />
              <button class="pub-cover-btn pub-cover-btn--ai" loading="{{posterAiBusy}}" disabled="{{posterAiBusy}}" bindtap="onCoverAiGenerate">开始生成 · {{posterAiPoints}}积分</button>
            </view>
          </view>
          </view>
          <view class="pub-form-submit">
            <button class="btn-primary pub-create-btn" loading="{{submitting}}" disabled="{{submitting}}" bindtap="onCreate">{{isEditMode ? '保存修改' : '创建招募'}}</button>
          </view>
        </view>
      </scroll-view>
    </view>
    </view>

  <!-- 全屏：招募平台 -->
