<page-meta page-style="{{lqPageStyle}}" background-color="{{lqPageBg}}" background-color-top="{{lqNavBg}}" background-color-bottom="{{lqPageBg}}" />
<template name="pubLifeBg">
  <view class="{{lqAccentClass}} pub-life-bg" aria-hidden="true" style="{{lqPageStyle}}">
    <view class="pub-life-blob pub-life-blob--1"></view>
    <view class="pub-life-blob pub-life-blob--2"></view>
    <view class="pub-life-blob pub-life-blob--3"></view>
    <text class="pub-life-ico pub-life-ico--1">🍜</text>
    <text class="pub-life-ico pub-life-ico--2">☕</text>
    <text class="pub-life-ico pub-life-ico--3">🏪</text>
    <text class="pub-life-ico pub-life-ico--4">📍</text>
    <text class="pub-life-ico pub-life-ico--5">🎬</text>
    <text class="pub-life-ico pub-life-ico--6">🛍️</text>
  </view>
</template>

<template name="pubStepBarV2">
  <view class="pub-steps-v2 pub-steps-v2--two">
    <view class="pub-steps-v2__line pub-steps-v2__line--two {{step === 'platform' ? 'pub-steps-v2__line--on' : 'pub-steps-v2__line--done'}}" />
    <view class="pub-step-v2 {{step === 'platform' ? 'pub-step-v2--on' : 'pub-step-v2--done'}}">
      <view class="pub-step-v2__num">1</view>
      <text class="pub-step-v2__label">选择平台</text>
    </view>
    <view class="pub-step-v2 {{step === 'form' ? 'pub-step-v2--on' : (step === 'done' ? 'pub-step-v2--done' : '')}}">
      <view class="pub-step-v2__num">2</view>
      <text class="pub-step-v2__label">填写信息</text>
    </view>
  </view>
</template>

<template name="pubStepBar">
  <view class="pub-steps">
    <view class="pub-step {{step === 'target' || step === 'placeholder' ? 'pub-step--on' : 'pub-step--done'}}">
      <view class="pub-step-dot" />
      <text class="pub-step-label">选择对象</text>
    </view>
    <view class="pub-step {{step === 'mode' ? 'pub-step--on' : (step === 'form' || step === 'done' ? 'pub-step--done' : '')}}">
      <view class="pub-step-dot" />
      <text class="pub-step-label">填写信息</text>
    </view>
    <view class="pub-step {{step === 'form' ? 'pub-step--on' : (step === 'done' ? 'pub-step--done' : '')}}">
      <view class="pub-step-dot" />
      <text class="pub-step-label">确认发布</text>
    </view>
  </view>
</template>

<view class="pub-page pub-page--{{step}} {{lqThemeClass}} foot-col">
  <block wx:if="{{step === 'platform'}}">
    <view class="pub-screen pub-screen--mode">
      <template is="pubLifeBg" />
      <view class="pub-target-top" style="{{heroHeadStyle}}">
        <view class="pub-target-nav">
          <text class="pub-target-back" bindtap="onBackFromPlatform">‹</text>
        </view>
        <template is="pubStepBarV2" data="{{step: step}}" />
      </view>
      <view class="pub-target-main">
        <text class="pub-target-title">选择招募平台</text>
        <view class="pub-mode-list pub-mode-list--target">
          <view
            wx:for="{{platformRows}}"
            wx:key="name"
            class="pub-mode-card pub-mode-card--icon"
            data-name="{{item.name}}"
            bindtap="onSelectPlatform"
          >
            <image class="pub-mode-logo" src="{{item.icon}}" mode="aspectFit" />
            <view class="pub-mode-copy">
              <text class="pub-mode-name">{{item.name}}</text>
            </view>
            <text class="pub-mode-arrow">›</text>
          </view>
        </view>
      </view>
    </view>
  </block>

  <!-- 旧步骤保留，入口已改为先选平台 -->
  <block wx:elif="{{step === 'channel'}}">
    <view class="pub-screen pub-screen--mode">
      <template is="pubLifeBg" />
      <view class="pub-target-top" style="{{heroHeadStyle}}">
        <view class="pub-target-nav">
          <text class="pub-target-back" bindtap="onBackFromChannel">‹</text>
        </view>
        <template is="pubStepBarV2" data="{{step: step}}" />
      </view>
      <view class="pub-target-main">
        <text class="pub-target-title">选择履约方式</text>
        <text class="pub-target-sub">选定后，再选择普通招募或定向邀约</text>
        <view class="pub-mode-list pub-mode-list--target">
          <view
            class="pub-mode-card {{loopChosen && form.fulfillmentLoop !== 'open' ? 'pub-mode-card--on' : ''}}"
            data-val="closed"
            bindtap="onPickFulfillmentLoop"
          >
            <view class="pub-mode-copy">
              <text class="pub-mode-name">闭环<text wx:if="{{loopChosen && form.fulfillmentLoop !== 'open'}}" class="pub-loop-picked">已选</text></text>
              <text class="pub-mode-sub">达人在平台报名。你先定可探店日期和时段，达人只能从这些时间里选。排期确定后直接上传成片，你在平台审核。</text>
            </view>
          </view>
          <view
            class="pub-mode-card {{loopChosen && form.fulfillmentLoop === 'open' ? 'pub-mode-card--on' : ''}}"
            data-val="open"
            bindtap="onPickFulfillmentLoop"
          >
            <view class="pub-mode-copy">
              <text class="pub-mode-name">开环<text wx:if="{{loopChosen && form.fulfillmentLoop === 'open'}}" class="pub-loop-picked">已选</text></text>
              <text class="pub-mode-sub">按通告发到微信群。你确认达人后发送群二维码，达人进群交付。交片和结算都在群里跟进，平台不排探店、不审视频。发布时需要上传群二维码。</text>
            </view>
          </view>
        </view>
      </view>
    </view>
  </block>

  <block wx:elif="{{step === 'recruit'}}">
    <view class="pub-screen pub-screen--mode">
      <template is="pubLifeBg" />
      <view class="pub-target-top" style="{{heroHeadStyle}}">
        <view class="pub-target-nav">
          <text class="pub-target-back" bindtap="onBackFromRecruit">‹</text>
        </view>
        <template is="pubStepBarV2" data="{{step: step}}" />
      </view>
      <view class="pub-target-main">
        <text class="pub-target-title">选择招募方式</text>
        <text class="pub-target-sub">已选{{form.fulfillmentLoop === 'open' ? '开环' : '闭环'}}。请选择普通招募或定向邀约</text>
        <view class="pub-mode-list pub-mode-list--target">
          <view
            wx:for="{{recruitChannels}}"
            wx:key="id"
            class="pub-mode-card pub-mode-card--icon"
            data-id="{{item.id}}"
            bindtap="onSelectChannel"
          >
            <view class="pub-mode-icon">
              <view class="pub-line pub-line--{{item.id}}"></view>
            </view>
            <view class="pub-mode-copy">
              <text class="pub-mode-name">{{item.label}}</text>
              <text class="pub-mode-sub">{{item.sub}}</text>
            </view>
            <text class="pub-mode-arrow">›</text>
          </view>
        </view>
      </view>
    </view>
  </block>

  <!-- 第二步：选择招募对象 -->
  <block wx:elif="{{step === 'target'}}">
    <view class="pub-screen pub-screen--target">
      <template is="pubLifeBg" />
      <view class="pub-target-top" style="{{heroHeadStyle}}">
        <view class="pub-target-nav">
          <text class="pub-target-back" bindtap="onBackFromTarget">‹</text>
        </view>
        <template is="pubStepBarV2" data="{{step: step}}" />
      </view>
      <view class="pub-target-main">
        <text class="pub-target-title">选择招募对象</text>
        <text class="pub-target-sub">达人 · 拍摄 · 剪辑</text>
        <view class="pub-mode-list pub-mode-list--target">
          <view
            wx:for="{{recruitTargets}}"
            wx:key="id"
            class="pub-mode-card pub-mode-card--icon {{item.placeholder ? 'pub-mode-card--disabled' : ''}}"
            data-id="{{item.id}}"
            bindtap="onSelectTarget"
          >
            <view class="pub-mode-icon">
              <view class="pub-line pub-line--{{item.iconKey || item.id}}"></view>
            </view>
            <view class="pub-mode-copy">
              <text class="pub-mode-name">{{item.label}}</text>
              <text class="pub-mode-sub">{{item.sub}}</text>
            </view>
            <text wx:if="{{item.placeholder}}" class="pub-mode-badge">筹备中</text>
            <text wx:else class="pub-mode-arrow">›</text>
          </view>
        </view>
      </view>
    </view>
  </block>

  <block wx:elif="{{step === 'placeholder'}}">
    <view class="pub-screen">
      <template is="pubLifeBg" />
      <view class="pub-hero" style="{{heroHeadStyle}}">
        <text class="pub-hero-back" bindtap="onBackFromPlaceholder">‹ 返回</text>
        <text class="pub-hero-title">{{recruitTargetLabel}}招募</text>
        <text class="pub-hero-sub">表单字段明日整理，敬请期待</text>
      </view>
      <view class="pub-placeholder-card card">
        <text class="hint">当前仅支持「达人」发单；{{recruitTargetLabel}}任务发布表单将随后开放。</text>
      </view>
    </view>
  </block>

  <!-- 第三步：选择招募模式 -->
  <block wx:elif="{{step === 'mode'}}">
    <view class="pub-screen pub-screen--mode">
      <template is="pubLifeBg" />
      <view class="pub-target-top" style="{{heroHeadStyle}}">
        <view class="pub-target-nav">
          <text class="pub-target-back" bindtap="onBackFromMode">‹</text>
        </view>
        <template is="pubStepBarV2" data="{{step: step}}" />
      </view>
      <view class="pub-target-main">
        <text class="pub-target-title">选择招募模式</text>
        <text class="pub-target-sub">探店 · 品宣 · 直播达人</text>
        <view class="pub-mode-list pub-mode-list--target">
          <view
            wx:for="{{recruitModes}}"
            wx:key="id"
            class="pub-mode-card pub-mode-card--icon"
            data-id="{{item.id}}"
            bindtap="onSelectMode"
          >
            <view class="pub-mode-icon">
              <view class="pub-line pub-line--{{item.iconKey || item.id}}"></view>
            </view>
            <view class="pub-mode-copy">
              <text class="pub-mode-name">{{item.label}}</text>
              <text class="pub-mode-sub">{{item.sub}}</text>
            </view>
            <text class="pub-mode-arrow">›</text>
          </view>
        </view>
      </view>
    </view>
  </block>

  <block wx:elif="{{step === 'tpl' || step === 'tplCustom'}}">
    <view class="pub-screen pub-screen--mode">
      <view class="pub-target-top" style="{{heroHeadStyle}}">
        <view class="pub-target-nav">
          <text class="pub-target-back" bindtap="onBackFromTemplate">‹</text>
        </view>
      </view>
      <scroll-view scroll-y class="tpl-scroll" enhanced show-scrollbar="{{false}}">
        <text class="tpl-title">选择招募模版</text>
        <text class="tpl-sub">{{step === 'tplCustom' ? '先勾选要保留的系统项。表单里没有的内容，点底部「新增字段」，再选文字、图片或视频。' : '系统模版沿用现有表单。自定义模版可以勾选字段，并自己新增。'}}</text>
        <view class="pub-mode-list pub-mode-list--target" wx:if="{{step === 'tpl'}}">
          <view class="pub-mode-card pub-mode-card--icon" bindtap="onPickSystemTemplate">
            <view class="pub-mode-copy">
              <text class="pub-mode-name">系统模版</text>
              <text class="pub-mode-sub">使用现在的完整招募表单</text>
            </view>
            <text class="pub-mode-arrow">›</text>
          </view>
          <view class="pub-mode-card pub-mode-card--icon" bindtap="onPickCustomTemplate">
            <view class="pub-mode-copy">
              <text class="pub-mode-name">自定义模版</text>
              <text class="pub-mode-sub">勾选系统字段，或自己新增字段</text>
            </view>
            <text class="pub-mode-arrow">›</text>
          </view>
        </view>
        <block wx:else>
          <view class="tpl-sheet">
            <view class="tpl-row tpl-row--hint">
              <text class="tpl-row__hint">长按 ≡ 再拖动排序，松手后表单跟着排</text>
            </view>
            <view
              class="tpl-row tpl-row--item {{fieldDragKey === item.key ? 'tpl-row--lift' : ''}} {{fieldPressKey === item.key ? 'tpl-row--press' : ''}}"
              wx:for="{{editorRows}}"
              wx:key="key"
              style="{{fieldDragKey === item.key ? 'transform:translateY(' + fieldDragDy + 'px) scale(1.03);' : (fieldDragShift[item.key] ? 'transform:translateY(' + fieldDragShift[item.key] + 'px);' : '')}}"
            >
              <view class="tpl-row__handle" data-key="{{item.key}}" catchtouchstart="onFieldDragStart" catchtouchmove="onFieldDragMove" catchtouchend="onFieldDragEnd" catchtouchcancel="onFieldDragEnd">≡</view>
              <text class="tpl-row__name">{{item.kind === 'custom' ? item.label + ' · ' + item.formatLabel : item.label}}</text>
              <switch wx:if="{{item.kind === 'sys'}}" class="tpl-switch" checked="{{fieldOn[item.key]}}" color="#5b2dcc" data-key="{{item.key}}" bindchange="onTogglePublishField" />
              <text wx:else class="tpl-row__del" data-id="{{item.key}}" bindtap="onRemoveCustomPublishField">删除</text>
            </view>
          </view>
        </block>
      </scroll-view>
      <view class="tpl-dock" wx:if="{{step === 'tplCustom'}}">
        <view class="tpl-dock__add" bindtap="onAddCustomFieldMenu">新增字段</view>
        <view class="tpl-dock__go" bindtap="onCustomTemplateDone">开始填写</view>
      </view>
    </view>
  </block>

  <!-- 填写表单（主界面 + 全屏选择叠层，保留滚动位置） -->
  <block wx:elif="{{step === 'form'}}">
    <view class="pub-form-host">
    <view class="pub-screen pub-screen--form" hidden="{{pickerView}}">
      <template is="pubLifeBg" />
    <view class="pub-form-layout">
      <view class="pub-target-top pub-form-top" style="{{formHeadStyle}}">
        <view class="pub-target-nav">
          <text class="pub-target-back" bindtap="onBackToMode">‹</text>
        </view>
        <template is="pubStepBarV2" data="{{step: step}}" />
      </view>
      <scroll-view
        class="pub-form-scroll"
        scroll-y
        enable-flex
        scroll-top="{{formScrollTop}}"
        scroll-into-view="{{scrollIntoView}}"
        scroll-with-animation="{{scrollWithAnimation}}"
      >
        <view class="pub-form-body">
          <view class="pub-form-card">
            <view class="pub-field">
              <text class="pub-label">招募对象</text>
              <text class="pub-label-hint">{{recruitTarget === 'shoot' ? '找拍摄团队到店或拍产品。' : (recruitTarget === 'edit' ? '找剪辑团队做成片。' : '找达人做探店、品宣或直播。')}}</text>
              <view class="pub-radio-pair pub-radio-pair--wrap">
                <view
                  wx:for="{{recruitTargets}}"
                  wx:key="id"
                  class="pub-radio-opt {{recruitTarget === item.id ? 'pub-radio-opt--on' : ''}}"
                  data-id="{{item.id}}"
                  bindtap="onFormPickTarget"
                >{{item.label}}</view>
              </view>
            </view>
            <view class="pub-field">
              <text class="pub-label">合作模式</text>
              <text class="pub-label-hint">{{recruitModeHint}}</text>
              <view class="pub-radio-pair pub-radio-pair--wrap">
                <view
                  wx:for="{{recruitModes}}"
                  wx:key="id"
                  class="pub-radio-opt {{recruitMode === item.id ? 'pub-radio-opt--on' : ''}}"
                  data-id="{{item.id}}"
                  bindtap="onFormPickMode"
                >{{item.label}}</view>
              </view>
            </view>
            <view class="pub-field">
              <text class="pub-label">履约方式</text>
              <text class="pub-label-hint">{{form.fulfillmentLoop === 'open' ? '发到微信群。确认达人后发群二维码，交片和结算在群里完成。发布时要上传群二维码。' : '达人在平台报名并选择档期，成片上传后由你在平台审核。'}}</text>
              <view class="pub-radio-pair">
                <view class="pub-radio-opt {{form.fulfillmentLoop !== 'open' ? 'pub-radio-opt--on' : ''}}" data-val="closed" bindtap="onFormPickLoop">闭环</view>
                <view class="pub-radio-opt {{form.fulfillmentLoop === 'open' ? 'pub-radio-opt--on' : ''}}" data-val="open" bindtap="onFormPickLoop">开环</view>
              </view>
            </view>
            <view class="pub-field" wx:if="{{recruitTarget === 'talent'}}">
              <text class="pub-label">招募方式</text>
              <text class="pub-label-hint">{{isTargetedRecruit ? '只发给你指定的达人，对方接受后才进入履约。需会员开通。' : '公开在招募大厅报名，符合条件的达人都可以报。'}}</text>
              <view class="pub-radio-pair">
                <view class="pub-radio-opt {{!isTargetedRecruit ? 'pub-radio-opt--on' : ''}}" data-id="open" bindtap="onFormPickChannel">普通招募</view>
                <view class="pub-radio-opt {{isTargetedRecruit ? 'pub-radio-opt--on' : ''}}" data-id="targeted" bindtap="onFormPickChannel">定向邀约</view>
              </view>
            </view>
            <view class="pub-field">
              <view class="pub-apply-head" bindtap="onToggleApplyInfo">
                <text class="pub-label">{{isSupplierPublish ? '团队报名必填信息' : '达人必填信息'}}</text>
                <text class="pub-apply-toggle">{{applyInfoOpen ? '收起' : '展开'}}</text>
              </view>
              <block wx:if="{{applyInfoOpen}}">
                <text class="pub-apply-note">达人报名时要填这些内容。</text>
                <view wx:if="{{applyInfoRows.length}}" class="pub-apply-list">
                  <text wx:for="{{applyInfoRows}}" wx:key="id" class="pub-apply-item">{{item.label}}<text wx:if="{{!item.required}}" class="pub-apply-opt">选填</text></text>
                </view>
                <text wx:else class="pub-cover-hint">还没有报名必填项</text>
                <text class="pub-apply-config" data-view="applyForm" bindtap="openPicker">配置报名项</text>
              </block>
              <text wx:else class="pub-cover-hint">{{applyFormDisplayText}}</text>
            </view>
            <view class="pub-field">
              <text class="pub-label">是否需要达人交票</text>
              <view class="pub-radio-pair">
                <view
                  class="pub-radio-opt {{form.requireTalentInvoice ? '' : 'pub-radio-opt--on'}}"
                  data-val="0"
                  catchtap="onRequireInvoicePick"
                >不需要</view>
                <view
                  class="pub-radio-opt {{form.requireTalentInvoice ? 'pub-radio-opt--on' : ''}}"
                  data-val="1"
                  catchtap="onRequireInvoicePick"
                >需要达人交票</view>
              </view>
              <text class="pub-cover-hint">需要时，达人完成该招募单后可提交发票，你可在本单查看并下载。</text>
            </view>
          </view>
          <view class="pub-form-card pub-field-stack">
          <view class="pub-field" id="field-cover" style="order:{{fieldRank.cover}}" wx:if="{{fieldOn.cover}}">
            <text class="pub-label">招募海报</text>
            <text class="pub-cover-hint">{{coverSourceHint}}</text>
            <view wx:if="{{coverPreviewUrl}}" class="pub-cover-preview-wrap" bindtap="onPreviewCoverImage">
              <image class="pub-cover-preview" src="{{coverPreviewUrl}}" mode="aspectFill" />
            </view>
            <view class="pub-cover-actions">
              <button class="pub-cover-btn" bindtap="onCoverUpload">上传图片</button>
              <button class="pub-cover-btn" bindtap="openCoverGallery">从图库选择</button>
              <button class="pub-cover-btn {{coverAiOpen ? 'pub-cover-btn--on' : ''}}" bindtap="onCoverAiToggle">AI生成</button>
              <button wx:if="{{form.coverImage || form.coverLibraryId}}" class="pub-cover-btn pub-cover-btn--ghost" bindtap="onCoverClear">清除</button>
            </view>
            <view wx:if="{{coverAiOpen}}" class="pub-cover-ai">
              <text class="pub-cover-ai-hint">文字、要求和参考图均可选填 · {{posterAiPoints}}积分/张</text>
              <textarea class="pub-textarea pub-cover-ai-input" value="{{posterAiPrompt}}" maxlength="300" placeholder="选填：封面文字、风格或场景要求" bindinput="onPosterAiPrompt" />
              <view class="pub-cover-actions">
                <button class="pub-cover-btn" bindtap="onPosterAiPickRef">{{posterAiRefPreview ? '已选参考图' : '选填参考图'}}</button>
                <button wx:if="{{posterAiRefPreview}}" class="pub-cover-btn pub-cover-btn--ghost" bindtap="onPosterAiClearRef">清除参考图</button>
              </view>
              <image wx:if="{{posterAiRefPreview}}" class="pub-cover-ai-ref" src="{{posterAiRefPreview}}" mode="aspectFill" bindtap="onPosterAiPickRef" />
              <button class="pub-cover-btn pub-cover-btn--ai" loading="{{posterAiBusy}}" disabled="{{posterAiBusy}}" bindtap="onCoverAiGenerate">开始生成 · {{posterAiPoints}}积分</button>
            </view>
          </view>
          <view class="pub-field" id="field-delivery-window" style="order:{{fieldRank.delivery}}" wx:if="{{!isTargetedRecruit && (fieldOn.delivery)}}">
            <text class="pub-label">投放窗口</text>
            <view class="pub-window-row">
              <view
                wx:for="{{deliveryWindows}}"
                wx:key="id"
                class="pub-window-opt {{form.deliveryWindow === item.id ? 'pub-window-opt--on' : ''}}"
                data-id="{{item.id}}"
                bindtap="onDeliveryWindowTap"
              >
                <text class="pub-window-opt-name">{{item.label}}</text>
                <text class="pub-window-opt-sub">{{item.sub}}</text>
              </view>
            </view>
          </view>
          <view class="pub-field" id="field-signup-deadline" style="order:{{fieldRank.deadline}}" wx:if="{{showSignupDeadline && !isTargetedRecruit && (fieldOn.deadline)}}">
            <text class="pub-label">招募报名截止时间</text>
            <view class="pub-deadline-row">
              <picker class="pub-deadline-pick" mode="date" value="{{signupDeadlineDate}}" start="{{todayDate}}" bindchange="onSignupDeadlineDate">
                <view class="pub-select pub-select--half">
                  <text class="pub-select-text {{signupDeadlineDate ? '' : 'pub-select-text--ph'}}">{{signupDeadlineDate || '选择日期'}}</text>
                  <text class="pub-select-arrow">›</text>
                </view>
              </picker>
              <picker class="pub-deadline-pick" mode="time" value="{{signupDeadlineTime}}" bindchange="onSignupDeadlineTime">
                <view class="pub-select pub-select--half">
                  <text class="pub-select-text">{{signupDeadlineTime || '23:59'}}</text>
                  <text class="pub-select-arrow">›</text>
