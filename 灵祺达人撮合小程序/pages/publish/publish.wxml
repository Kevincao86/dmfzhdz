                </view>
                <view class="pub-field" wx:if="{{form.linkeAttach.clientId}}">
                  <text class="pub-label">林客团购商品 *</text>
                  <view class="pub-linke-search-row">
                    <input class="pub-input pub-linke-search-input" placeholder="商品名称关键词" value="{{linkeProductKw}}" bindinput="onLinkeProductKwInput" />
