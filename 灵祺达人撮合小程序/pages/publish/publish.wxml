          </view>
        </view>
      </scroll-view>
      <view class="tpl-edit-footer pub-apply-footer">
        <button class="btn-secondary tpl-footer-btn" bindtap="onApplyFormPreview">预览</button>
        <button class="btn-primary tpl-footer-btn" bindtap="onApplyFormConfirm">{{applyFormEditorMode === 'template' || applyFormLibrarySaved ? '确认并返回' : '确认'}}</button>
      </view>
    </view>
    <view class="tpl-modal-mask" wx:if="{{showFieldModal}}" bindtap="onCloseFieldModal" />
    <view class="tpl-modal" wx:if="{{showFieldModal}}">
      <text class="tpl-modal-title">编辑报名项</text>
      <view class="form-row" wx:if="{{canEditLabel}}">
        <text class="form-label">名称</text>
        <input class="input" value="{{editLabel}}" bindinput="onEditLabelInput" />
      </view>
      <view class="form-row" wx:if="{{canEditLabel}}">
        <text class="form-label">内容格式</text>
        <view class="apply-format-row">
          <view class="apply-format-btn {{editFieldType !== 'image' && editFieldType !== 'video' ? 'apply-format-btn--on' : ''}}" data-type="text" bindtap="onPickEditFieldType">文字</view>
          <view class="apply-format-btn {{editFieldType === 'image' ? 'apply-format-btn--on' : ''}}" data-type="image" bindtap="onPickEditFieldType">图片</view>
          <view class="apply-format-btn {{editFieldType === 'video' ? 'apply-format-btn--on' : ''}}" data-type="video" bindtap="onPickEditFieldType">视频</view>
        </view>
      </view>
      <view class="form-row" wx:else>
        <text class="form-label">名称</text>
        <text class="tpl-modal-readonly">{{editLabel}}</text>
      </view>
      <view class="form-row">
        <text class="form-label">占位提示</text>
        <input class="input" placeholder="选填" value="{{editPlaceholder}}" bindinput="onEditPlaceholderInput" />
      </view>
      <view class="form-row tpl-modal-req">
        <text class="form-label">必填</text>
        <switch class="tpl-req-switch" checked="{{editRequired}}" color="#2563eb" bindchange="onEditRequiredChange" />
      </view>
      <view class="tpl-modal-actions">
        <button class="btn-secondary" bindtap="onCloseFieldModal">取消</button>
        <button class="btn-primary" bindtap="onConfirmFieldEdit">确定</button>
      </view>
    </view>
    <view class="tpl-modal-mask" wx:if="{{showApplyPreview}}" bindtap="onCloseApplyPreview" />
    <view class="tpl-preview-sheet" wx:if="{{showApplyPreview}}">
      <view class="tpl-preview-head">
        <text class="tpl-preview-title">报名预览</text>
        <text class="tpl-preview-sub">平台 {{applyFormPreviewPlatform}}</text>
        <view class="tpl-preview-close" bindtap="onCloseApplyPreview">关闭</view>
      </view>
      <scroll-view scroll-y class="tpl-preview-scroll">
        <view class="form-row" wx:for="{{applyPreviewRows}}" wx:key="id">
          <text class="form-label">{{item.displayLabel}}{{item.required ? ' *' : ''}}</text>
          <view class="picker-val picker-val--placeholder">{{item.placeholder || '请填写'}}</view>
        </view>
      </scroll-view>
    </view>
  </block>

    </view>
  </block>

  <view class="tpl-modal-mask" wx:if="{{showApplyTplPicker && step === 'form'}}" bindtap="onCloseApplyTplPicker" />
  <view class="pub-apply-tpl-modal" wx:if="{{showApplyTplPicker && step === 'form'}}">
    <text class="pub-apply-tpl-modal-title">使用我的模版</text>
    <scroll-view scroll-y class="pub-apply-tpl-modal-scroll">
      <view
        wx:for="{{customTemplateList}}"
        wx:key="id"
        class="pub-apply-tpl-modal-item"
        data-id="{{item.id}}"
        bindtap="onPickApplyTplFromModal"
      >
        <text class="pub-apply-tpl-modal-name">{{item.name}}</text>
        <text class="pub-apply-tpl-modal-sub">{{item.fields.length}} 个字段</text>
      </view>
    </scroll-view>
    <button class="btn-secondary pub-apply-tpl-modal-cancel" bindtap="onCloseApplyTplPicker">取消</button>
  </view>

  <!-- 创建成功 -->
  <block wx:elif="{{step === 'done'}}">
    <view class="pub-screen pub-screen--done">
      <template is="pubLifeBg" />
    <view class="pub-done-wrap">
      <view class="pub-done">
        <view class="pub-done-icon">✓</view>
        <text class="pub-done-title">招募已创建</text>
        <text class="pub-done-sub">{{createdOrder.title}}</text>
        <button class="btn-primary pub-done-btn" bindtap="onOpenCreatedShare">分享招募</button>
        <button class="btn-ghost pub-done-btn" bindtap="onCopyGroupShare">分享群聊（复制招募信息）</button>
        <button class="btn-secondary pub-done-btn" bindtap="onFinish">完成创建</button>
      </view>
    </view>
    </view>
  </block>
  <recruit-share-dock
    show="{{showShareSheet}}"
    title="{{createdOrder.title}}"
    bind:close="onCloseCreatedShare"
    bind:open="onOpenCreatedStudio"
  />
  <site-icp-footer />
</view>
