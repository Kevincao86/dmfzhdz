      <scroll-view class="pub-full-scroll" scroll-y>
        <view class="pub-full-body">
          <view
            wx:for="{{platformRows}}"
            wx:key="name"
            class="pub-full-opt {{form.platform === item.name ? 'pub-full-opt--on' : ''}}"
