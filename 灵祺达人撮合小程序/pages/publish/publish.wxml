              <view class="pub-tier-del" data-index="{{tierIdx}}" bindtap="onRemoveFansTier">🗑</view>
              <view class="pub-tier-row pub-select pub-select--in" data-index="{{tierIdx}}" bindtap="openFansTierPicker">
                <text class="pub-tier-k">粉丝档位</text>
                <text class="pub-tier-v {{!item.fansRange ? 'pub-select-text--ph' : ''}}">{{item.fansRangeText}}</text>
                <text class="pub-select-arrow">›</text>
              </view>
              <view class="pub-tier-row pub-tier-mode-row">
                <text class="pub-tier-k">价格类型</text>
                <view class="pub-tier-mode-tabs">
                  <view class="pub-tier-mode-tab {{item.priceMode !== 'self_quote' ? 'pub-tier-mode-tab--on' : ''}}" data-index="{{tierIdx}}" data-kind="fans" data-mode="fixed" bindtap="onTierPriceModeTap">固定价</view>
                  <view class="pub-tier-mode-tab {{item.priceMode === 'self_quote' ? 'pub-tier-mode-tab--on' : ''}}" data-index="{{tierIdx}}" data-kind="fans" data-mode="self_quote" bindtap="onTierPriceModeTap">自报价</view>
                </view>
              </view>
              <view class="pub-tier-row" wx:if="{{item.priceMode !== 'self_quote'}}">
                <text class="pub-tier-k">达人价格</text>
