@import "../apply/apply.wxss";
@import "../../partials/login-cred-panel.wxss";
@import "../../partials/account-session-actions.wxss";

.wx-profile {
  display: flex;
  align-items: center;
  gap: 24rpx;
  margin-bottom: 8rpx;
}

.wx-avatar-btn {
  padding: 0;
  margin: 0;
  background: transparent;
  border: none;
  line-height: 1;
  flex-shrink: 0;
}

.wx-avatar-btn::after {
  border: none;
}

.wx-nick-input {
  width: 100%;
  font-size: 32rpx;
  font-weight: 700;
  color: #0f172a;
  padding: 8rpx 0;
}

.wx-avatar {
  width: 104rpx;
  height: 104rpx;
  border-radius: 50%;
  flex-shrink: 0;
  border: 4rpx solid #fff;
  box-shadow: 0 8rpx 24rpx rgba(15, 23, 42, 0.1);
}

.wx-avatar--ph {
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #bbf7d0, #86efac);
}

.wx-avatar-txt {
  font-size: 26rpx;
  font-weight: 600;
  color: #fff;
}

.wx-meta {
  flex: 1;
}

.wx-identity-id {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  font-weight: 700;
  color: var(--lq-text, #14181f);
  letter-spacing: 0.5rpx;
}

.wx-name {
  display: block;
  font-size: 32rpx;
  font-weight: 700;
  color: #0f172a;
}

.type-grid {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.type-chip {
  padding: 24rpx 28rpx;
  border-radius: 20rpx;
  border: 2rpx solid #e2e8f0;
  background: #f8fafc;
  text-align: center;
}

.type-chip.active {
  border-color: #6366f1;
  background: linear-gradient(135deg, #eef2ff, #ffffff);
  box-shadow: 0 8rpx 24rpx rgba(99, 102, 241, 0.15);
}

.type-chip-label {
  font-size: 28rpx;
  font-weight: 600;
  color: #334155;
}

.type-chip.active .type-chip-label {
  color: #4338ca;
}

.platform-head {
  display: flex;
  align-items: center;
  gap: 12rpx;
  font-size: 28rpx;
  font-weight: 700;
  color: var(--lq-text, #0f172a);
  margin-bottom: 16rpx;
  padding-bottom: 16rpx;
  border-bottom: 2rpx solid #f1f5f9;
}

.platform-head::before {
  content: '';
  width: 6rpx;
  height: 28rpx;
  border-radius: 3rpx;
  background: #8b5cf6;
}

.platform-head--dy::before {
  background: #1e293b;
}

.platform-head--xhs::before {
  background: #ec4899;
}

.platform-head--ks::before {
  background: #f97316;
}

.platform-head--dp::before {
  background: #f59e0b;
}

.platform-head--wxv::before {
  background: #22c55e;
}

.platform-card {
  padding-top: 8rpx;
}

.platform-card-head {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 8rpx;
}

.platform-card-icon {
  width: 48rpx;
  height: 48rpx;
  border-radius: 12rpx;
  flex-shrink: 0;
}

.platform-card-title {
  flex: 1;
  font-size: 30rpx;
  font-weight: 700;
  color: #0f172a;
  min-width: 0;
}

.platform-card-actions {
  display: flex;
  align-items: center;
  gap: 8rpx;
  flex-shrink: 0;
}

.platform-detail-btn,
.platform-detail-btn--view {
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  height: 56rpx;
  padding: 0 28rpx;
  font-size: 24rpx;
  font-weight: 600;
  line-height: 52rpx;
  color: #6d28d9;
  background: #f5f3ff;
  border: 2rpx solid #ddd6fe;
  border-radius: 999rpx;
}

.platform-detail-arrow {
  display: inline-block;
  font-size: 26rpx;
  line-height: 1;
  transform: rotate(90deg);
  transition: transform 0.2s ease;
}

.platform-detail-arrow--up {
  transform: rotate(-90deg);
}

.platform-card-summary {
  margin: 4rpx 0 12rpx 64rpx;
  font-size: 24rpx;
  color: #64748b;
}

.platform-card-switch {
  transform: scale(0.82);
}

.gender-row {
  display: flex;
  gap: 16rpx;
  margin-top: 12rpx;
}

.gender-chip {
  min-width: 120rpx;
  padding: 14rpx 28rpx;
  border-radius: 999rpx;
  text-align: center;
  font-size: 28rpx;
  color: #64748b;
  background: #f1f5f9;
  border: 2rpx solid transparent;
}

.gender-chip--on {
  color: #fff;
  background: var(--lq-primary, #6d28d9);
  border-color: var(--lq-primary, #6d28d9);
  font-weight: 600;
}

.platform-avatar {
  width: 128rpx;
  height: 128rpx;
  border-radius: 50%;
  margin: 8rpx 0 16rpx;
  background: #f1f5f9;
}

.profile-autofill-btn {
  margin-top: 16rpx;
  width: 100%;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #6366f1, #8b5cf6);
  color: #fff;
  font-size: 24rpx;
  font-weight: 600;
  line-height: 2.4;
  border: none;
  padding: 0 16rpx;
}

.profile-autofill-btn::after {
  border: none;
}

.submit-wrap {
  margin-bottom: 48rpx;
}

.submit-btn {
  width: 100%;
}

.form-hint {
  display: block;
  font-size: 22rpx;
  color: #94a3b8;
  margin-bottom: 12rpx;
}

.account-tag-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.account-tag-chip {
  width: calc((100% - 36rpx) / 4);
  box-sizing: border-box;
  text-align: center;
  padding: 14rpx 4rpx;
  font-size: 22rpx;
  background: #f8fafc;
  border: 2rpx solid #e5e7eb;
  border-radius: 12rpx;
  color: #475569;
}

.paper-page .platform-card {
  background: #fffdf8;
  border: 1rpx solid #efe8dc;
  border-radius: 28rpx;
  box-shadow: none;
}

.paper-page .wx-nick-input,
.paper-page .wx-name {
  color: var(--lq-text, #1c1917);
}

.paper-page .wx-avatar {
  border-color: #fffdf8;
}

.account-tag-chip--on {
  color: var(--lq-text, #14181f);
  background: var(--lq-primary-50, #f5f3ff);
  border-color: var(--lq-chip-on-border, #ddd6fe);
  font-weight: 600;
}

.paper-page.lq-accent-on .section-title,
.paper-page.lq-accent-on .platform-head,
.paper-page.lq-accent-on .page-hero-title,
.paper-page.lq-accent-on .wx-name,
.paper-page.lq-accent-on .wx-nick-input,
.paper-page.lq-accent-on .cred-ready-text,
.paper-page.lq-accent-on .cred-edit-btn,
.paper-page.lq-accent-on .input,
.paper-page.lq-accent-on .picker-val {
  color: var(--lq-text, #14181f) !important;
}

.paper-page.lq-accent-on .page-hero-sub,
.paper-page.lq-accent-on .form-label,
.paper-page.lq-accent-on .hint,
.paper-page.lq-accent-on .platform-card-summary {
  color: var(--lq-text-secondary, #64748b) !important;
}

.paper-page.lq-accent-on .picker-val {
  -webkit-text-fill-color: var(--lq-text, #14181f);
}

.paper-page.lq-accent-dark .section-title,
.paper-page.lq-accent-dark .platform-head,
.paper-page.lq-accent-dark .page-hero-title,
.paper-page.lq-accent-dark .wx-name,
.paper-page.lq-accent-dark .cred-ready-text,
.paper-page.lq-accent-dark .cred-edit-btn,
.paper-page.lq-accent-dark .cred-check-label,
.paper-page.lq-accent-dark .cred-modal-title,
.paper-page.lq-accent-dark .picker-val,
.paper-page.lq-accent-dark .type-chip-label,
.paper-page.lq-accent-dark .apply-recruit-val,
.paper-page.lq-accent-dark text,
.paper-page.lq-accent-dark button,
.paper-page.lq-accent-dark label {
  color: #f4f4f5 !important;
  -webkit-text-fill-color: #f4f4f5 !important;
}

/* 安卓 input 遇到 -webkit-text-fill-color 会把字抹掉，这里只留 color。 */
.paper-page.lq-accent-dark input,
.paper-page.lq-accent-dark textarea,
.paper-page.lq-accent-dark .input,
.paper-page.lq-accent-dark .wx-nick-input,
.paper-page.lq-accent-dark .apply-textarea {
  color: #f4f4f5 !important;
}

.paper-page.lq-accent-dark .platform-detail-btn {
  background: #eef2ff !important;
}

.paper-page.lq-accent-dark .platform-detail-btn text {
  color: #4338ca !important;
  -webkit-text-fill-color: #4338ca !important;
}

.paper-page.lq-accent-dark .page-hero-sub,
.paper-page.lq-accent-dark .form-label,
.paper-page.lq-accent-dark .hint,
.paper-page.lq-accent-dark .platform-card-summary {
  color: #d4d4d8 !important;
  -webkit-text-fill-color: #d4d4d8 !important;
}

.trade-shot-hint {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  line-height: 1.5;
  color: #64748b;
}

.trade-shot-example,
.trade-shot-preview {
  width: 168rpx;
  height: 224rpx;
  margin-top: 12rpx;
  border-radius: 16rpx;
  background: #f8fafc;
}

.platform-tag-summary {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 12rpx;
}

.trade-shot-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 12rpx;
}

.identity-row {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 16rpx;
  margin: 0 24rpx 20rpx;
}

.identity-chip {
  min-width: 120rpx;
  padding: 12rpx 28rpx;
  border-radius: 999rpx;
  background: #fff;
  color: #57534e;
  font-size: 26rpx;
  text-align: center;
}

.identity-chip--on {
  background: #1c1917;
  color: #fff;
}

.identity-chip--add {
  min-width: 120rpx;
  padding: 12rpx 28rpx;
  font-size: 26rpx;
  line-height: 1.4;
  color: #292524;
  background: #fff;
  border: 2rpx dashed #a8a29e;
}

.identity-back {
  margin-top: 8rpx;
  padding: 10rpx 28rpx;
  border-radius: 999rpx;
  border: 2rpx solid #d6d3d1;
  background: #fff;
  color: #44403c;
  font-size: 26rpx;
  line-height: 1.4;
}

.paper-page.lq-accent-on .cred-ready-actions .cred-edit-btn,
.paper-page.lq-accent-dark .cred-ready-actions .cred-edit-btn {
  width: auto !important;
  min-width: 0 !important;
  max-width: none !important;
  margin: 0 !important;
  padding: 0 28rpx !important;
  height: 56rpx !important;
  line-height: 56rpx !important;
  font-size: 24rpx !important;
  color: #6d28d9 !important;
  -webkit-text-fill-color: #6d28d9 !important;
  background: #f5f3ff !important;
  border-color: #ddd6fe !important;
}

.env .section-head {
  margin-bottom: 0;
}

.env-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(28, 25, 23, 0.45);
  z-index: 300;
}

.env-actions {
  margin-left: auto;
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex-shrink: 0;
}

.env-actions .env-btn {
  margin: 0;
}

.env-btn--view {
  color: #6d28d9;
  background: #f5f3ff;
  border-color: #ddd6fe;
}

.env-letter--view input,
.env-letter--view textarea,
.env-letter--view picker,
.env-letter--view .gender-chip,
.env-letter--view .account-tag-chip,
.env-letter--view switch,
.env-letter--view .picker-val {
  pointer-events: none;
}

.env-btn {
  margin: 0 0 0 auto;
  padding: 0 28rpx;
  height: 56rpx;
  line-height: 56rpx;
  font-size: 24rpx;
  font-weight: 600;
  color: #6d28d9;
  background: #f5f3ff;
  border: 2rpx solid #ddd6fe;
  border-radius: 999rpx;
}

.env-btn--save {
  margin-left: 0;
  color: #fff;
  background: #7c3aed;
  border-color: #7c3aed;
}

.env-btn--save::after {
  border: none;
}

.env-sum {
  display: block;
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #78716c;
  line-height: 1.4;
}

.env-sheet {
  display: none;
}

.env--open .env-sheet {
  display: block;
  position: fixed;
  z-index: 301;
  left: 40rpx;
  right: 40rpx;
  top: 10vh;
  max-height: 78vh;
  overflow: visible;
  background: transparent;
  padding: 0;
}

.env-pop-logo {
  position: absolute;
  left: 50%;
  top: 0;
  z-index: 2;
  width: 88rpx;
  height: 88rpx;
  margin-left: -44rpx;
  margin-top: -44rpx;
  padding: 8rpx;
  border-radius: 50%;
  border: 2rpx solid #d6c4a8;
  background: #fff;
  box-sizing: border-box;
}

.env-letter {
  position: relative;
  z-index: 1;
  max-height: 78vh;
  overflow-y: auto;
  background: #fff;
  border-radius: 28rpx;
  padding: 28rpx;
  box-shadow: 0 24rpx 64rpx rgba(28, 25, 23, 0.18);
}

.env-save-row {
  display: flex;
  justify-content: flex-end;
  gap: 16rpx;
  padding-top: 16rpx;
}

.env-save-row .env-btn {
  margin-left: 0;
}

.paper-page .cred-modal {
  overflow: auto;
  max-height: 78vh;
  background: #fff;
}
