@import "../apply/apply.wxss";
@import "../../partials/login-cred-panel.wxss";
@import "../../partials/account-session-actions.wxss";

.wx-profile {
  display: flex;
  align-items: center;
  gap: 24rpx;
  margin-bottom: 8rpx;
}

.wx-avatar-btn {
  padding: 0;
  margin: 0;
  background: transparent;
  border: none;
  line-height: 1;
  flex-shrink: 0;
}

.wx-avatar-btn::after {
  border: none;
}

.wx-nick-input {
  width: 100%;
  font-size: 32rpx;
  font-weight: 700;
  color: #0f172a;
  padding: 8rpx 0;
}

.wx-avatar {
  width: 104rpx;
  height: 104rpx;
  border-radius: 50%;
  flex-shrink: 0;
  border: 4rpx solid #fff;
  box-shadow: 0 8rpx 24rpx rgba(15, 23, 42, 0.1);
}

.wx-avatar--ph {
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #bbf7d0, #86efac);
}

.wx-avatar-txt {
  font-size: 26rpx;
  font-weight: 600;
  color: #fff;
}

.wx-meta {
  flex: 1;
}

.wx-identity-id {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  font-weight: 700;
  color: #4f46e5;
  letter-spacing: 0.5rpx;
}

.wx-name {
  display: block;
  font-size: 32rpx;
  font-weight: 700;
  color: #0f172a;
}

.type-grid {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.type-chip {
  padding: 24rpx 28rpx;
  border-radius: 20rpx;
  border: 2rpx solid #e2e8f0;
  background: #f8fafc;
  text-align: center;
}

.type-chip.active {
  border-color: #6366f1;
  background: linear-gradient(135deg, #eef2ff, #ffffff);
  box-shadow: 0 8rpx 24rpx rgba(99, 102, 241, 0.15);
}

.type-chip-label {
  font-size: 28rpx;
  font-weight: 600;
  color: #334155;
}

.type-chip.active .type-chip-label {
  color: #4338ca;
}

.platform-head {
  display: flex;
  align-items: center;
  gap: 12rpx;
  font-size: 28rpx;
  font-weight: 700;
  color: #0f172a;
  margin-bottom: 16rpx;
  padding-bottom: 16rpx;
  border-bottom: 2rpx solid #f1f5f9;
}

.platform-head::before {
  content: '';
  width: 6rpx;
  height: 28rpx;
  border-radius: 3rpx;
  background: #8b5cf6;
}

.platform-head--dy::before {
  background: #1e293b;
}

.platform-head--xhs::before {
  background: #ec4899;
}

.platform-head--ks::before {
  background: #f97316;
}

.platform-head--dp::before {
  background: #f59e0b;
}

.platform-head--wxv::before {
  background: #22c55e;
}

.platform-card {
  padding-top: 8rpx;
}

.platform-card-head {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 8rpx;
}

.platform-card-icon {
  width: 48rpx;
  height: 48rpx;
  border-radius: 12rpx;
  flex-shrink: 0;
}

.platform-card-title {
  flex: 1;
  font-size: 30rpx;
  font-weight: 700;
  color: #0f172a;
}

.platform-card-switch {
  transform: scale(0.82);
}

.submit-wrap {
  margin-bottom: 48rpx;
}

.submit-btn {
  width: 100%;
}

.form-hint {
  display: block;
  font-size: 22rpx;
  color: #94a3b8;
  margin-bottom: 12rpx;
}

.account-tag-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.account-tag-chip {
  width: calc((100% - 36rpx) / 4);
  box-sizing: border-box;
  text-align: center;
  padding: 14rpx 4rpx;
  font-size: 22rpx;
  background: #f8fafc;
  border: 2rpx solid #e5e7eb;
  border-radius: 12rpx;
  color: #475569;
}

.account-tag-chip--on {
  color: #2563eb;
  background: #eff6ff;
  border-color: #93c5fd;
  font-weight: 600;
}
