<page-meta page-style="{{lqPageStyle}}{{envScrollLock ? 'overflow:hidden;' : ''}}" background-color="{{lqPageBg}}" background-color-top="{{lqNavBg}}" background-color-bottom="{{lqPageBg}}" />
<view class="{{lqAccentClass}} page-shell page-with-bar paper-page foot-col" style="{{lqPageStyle}}">
  <view class="page-hero page-hero--compact">
    <text class="page-hero-title">{{isSupplier ? (workIdentity === 'edit' ? '剪辑团队信息' : '拍摄团队信息') : '我的信息'}}</text>
    <text class="page-hero-sub">{{isSupplier ? '填写团队服务能力与作品集，报名时可一键填入' : '按平台填写达人资料，报名时可一键填入'}}</text>
  </view>

  <view class="identity-row" wx:if="{{identityChips.length}}">
    <view
      wx:for="{{identityChips}}"
      wx:key="id"
      class="identity-chip {{item.active ? 'identity-chip--on' : ''}}"
      data-identity="{{item.id}}"
      catchtap="onPickIdentity"
    >{{item.label}}</view>
    <view
      wx:for="{{addIdentityChips}}"
      wx:for-item="addItem"
      wx:key="id"
      class="identity-chip identity-chip--add"
      data-identity="{{addItem.id}}"
      catchtap="onPickIdentity"
    >{{addItem.label}}</view>
    <view class="identity-back" wx:if="{{showIdentityBack}}" bindtap="onBackIdentity">返回上一身份</view>
  </view>

  <view class="card">
    <view class="section-head">
      <view class="section-head-dot" />
      <text class="section-title">微信信息</text>
    </view>
    <view class="wx-profile">
      <button class="wx-avatar-btn" open-type="chooseAvatar" bindchooseavatar="onChooseAvatar">
        <image class="wx-avatar" src="{{wxAvatarUrl}}" mode="aspectFill" wx:if="{{wxAvatarUrl}}" />
        <view class="wx-avatar wx-avatar--ph" wx:else>
          <text class="wx-avatar-txt">头像</text>
        </view>
      </button>
      <view class="wx-meta">
        <text class="form-label">昵称 *</text>
        <input style="{{lqInputStyle}}" placeholder-style="{{lqPhStyle}}"
          class="wx-nick-input"
          type="nickname"
          placeholder="点击输入昵称（必填）"
          value="{{wxNickName}}"
          bindinput="onNicknameInput"
        />
        <text class="hint">用于登录与身份展示</text>
        <text class="wx-identity-id" wx:if="{{isSupplier && workIdentity === 'shoot'}}">{{lingqiShootTeamIdLabel || '拍摄团队ID：待生成'}}</text>
        <text class="wx-identity-id" wx:elif="{{isSupplier && workIdentity === 'edit'}}">{{lingqiEditTeamIdLabel || '剪辑团队ID：待生成'}}</text>
        <text class="wx-identity-id" wx:elif="{{lingqiTalentIdLabel}}">{{lingqiTalentIdLabel}}</text>
      </view>
    </view>
    <view class="env-save-row">
      <button class="env-btn env-btn--save" loading="{{submitting}}" disabled="{{submitting}}" data-section="wx" bindtap="onSubmit">保存</button>
    </view>
  </view>

  <include src="../../partials/login-cred-panel.wxml" />

  <view class="card apply-form env {{sectionOpenContact ? 'env--open' : ''}}">
    <view class="section-head">
      <view class="section-head-dot" />
      <text class="section-title">联系信息</text>
      <view class="env-actions">
        <view
          wx:if="{{contact || wechatId || alipayAccount || gender || province || city}}"
          class="env-btn env-btn--view"
          data-key="contact"
          data-mode="view"
          bindtap="onOpenSection"
        >查看</view>
        <view class="env-btn" data-key="contact" data-mode="edit" bindtap="onOpenSection">修改</view>
      </view>
    </view>
    <text class="env-sum">{{contact || '未填写电话'}}{{city ? ' · ' + city : ''}}</text>
    <view class="env-mask" wx:if="{{sectionOpenContact}}" data-key="contact" bindtap="onCloseSection" catchtouchmove="onEnvHold"></view>
    <view class="env-sheet">
    <view class="env-letter {{envelopeViewKey === 'contact' ? 'env-letter--view' : ''}}">
    <view class="form-row">
      <text class="form-label">联系电话 *</text>
      <input style="{{lqInputStyle}}" placeholder-style="{{lqPhStyle}}"
        class="input"
        type="number"
        placeholder="便于招募方联系"
        value="{{contact}}"
        data-k="contact"
        bindinput="onCommonField"
      />
    </view>
    <view class="form-row">
      <text class="form-label">微信号 *</text>
      <input style="{{lqInputStyle}}" placeholder-style="{{lqPhStyle}}"
        class="input"
        placeholder="请填写微信号（非微信昵称）"
        value="{{wechatId}}"
        data-k="wechatId"
        bindinput="onCommonField"
      />
    </view>
    <view class="form-row">
      <text class="form-label">支付宝账号</text>
      <input style="{{lqInputStyle}}" placeholder-style="{{lqPhStyle}}"
        class="input"
        placeholder="选填，用于结算打款"
        value="{{alipayAccount}}"
        data-k="alipayAccount"
        bindinput="onCommonField"
      />
    </view>
    <view class="form-row">
      <text class="form-label">性别 *</text>
      <view class="gender-row">
        <view
          class="gender-chip {{gender === '男' ? 'gender-chip--on' : ''}}"
          data-gender="男"
          bindtap="onGenderTap"
        >男</view>
        <view
          class="gender-chip {{gender === '女' ? 'gender-chip--on' : ''}}"
          data-gender="女"
          bindtap="onGenderTap"
        >女</view>
      </view>
    </view>
    <view class="form-row form-row-inline">
      <view class="form-col">
        <text class="form-label">省份 *</text>
        <picker mode="selector" range="{{provinces}}" value="{{provinceIndex}}" bindchange="onProvinceChange">
          <view class="picker-val {{province ? '' : 'picker-val--placeholder'}}">{{province || '请选择省份'}}</view>
        </picker>
      </view>
      <view class="form-col">
        <text class="form-label">城市 *</text>
        <picker mode="selector" range="{{cities}}" value="{{cityIndex}}" bindchange="onCityChange" disabled="{{!province}}">
          <view class="picker-val {{city ? '' : 'picker-val--placeholder'}}">{{city || '请选择城市'}}</view>
        </picker>
      </view>
    </view>
    <view class="env-save-row">
      <button class="env-btn" data-key="contact" bindtap="onCloseSection">{{envelopeViewKey === 'contact' ? '关闭' : '取消'}}</button>
      <button wx:if="{{envelopeViewKey !== 'contact'}}" class="env-btn env-btn--save" loading="{{submitting}}" disabled="{{submitting}}" data-section="contact" bindtap="onSubmit">保存</button>
    </view>
    </view>
    </view>
  </view>

  <view class="card apply-form env {{sectionOpenTeam ? 'env--open' : ''}}" wx:if="{{isSupplier}}">
    <view class="section-head">
      <view class="section-head-dot" />
      <text class="section-title">团队基本信息</text>
      <view class="env-actions">
        <view
          wx:if="{{supplierProfile.teamName}}"
          class="env-btn env-btn--view"
          data-key="team"
          data-mode="view"
          bindtap="onOpenSection"
        >查看</view>
        <view class="env-btn" data-key="team" data-mode="edit" bindtap="onOpenSection">修改</view>
      </view>
    </view>
    <text class="env-sum">{{supplierProfile.teamName || '未填写团队'}}</text>
    <view class="env-mask" wx:if="{{sectionOpenTeam}}" data-key="team" bindtap="onCloseSection" catchtouchmove="onEnvHold"></view>
    <view class="env-sheet">
    <view class="env-letter {{envelopeViewKey === 'team' ? 'env-letter--view' : ''}}">
    <view class="form-row">
      <text class="form-label">团队名称 *</text>
      <input style="{{lqInputStyle}}" placeholder-style="{{lqPhStyle}}" class="input" placeholder="如：某某跟拍工作室" value="{{supplierProfile.teamName}}" data-k="teamName" bindinput="onSupplierField" />
    </view>
    <view class="form-row">
      <text class="form-label">主体类型</text>
      <picker mode="selector" range="{{entityTypes}}" range-key="label" value="{{entityTypeIndex}}" bindchange="onEntityTypeChange">
        <view class="picker-val">{{entityTypes[entityTypeIndex].label}}</view>
      </picker>
    </view>
    <view class="form-row">
      <text class="form-label">团队人数</text>
      <input style="{{lqInputStyle}}" placeholder-style="{{lqPhStyle}}" class="input" type="number" placeholder="可协同出片人数" value="{{supplierProfile.teamSize}}" data-k="teamSize" bindinput="onSupplierField" />
    </view>
    <view class="form-row" wx:if="{{workIdentity === 'shoot'}}">
      <text class="form-label">从业年限</text>
      <picker mode="selector" range="{{experienceYears}}" value="{{experienceIndex}}" bindchange="onExperienceChange">
        <view class="picker-val picker-val--placeholder" wx:if="{{!supplierProfile.experienceYears}}">请选择</view>
        <view class="picker-val" wx:else>{{supplierProfile.experienceYears}}</view>
      </picker>
    </view>
    <view class="form-row" wx:if="{{workIdentity === 'edit'}}">
      <text class="form-label">日均产能</text>
      <picker mode="selector" range="{{dailyCapacity}}" value="{{dailyCapacityIndex}}" bindchange="onDailyCapacityChange">
        <view class="picker-val picker-val--placeholder" wx:if="{{!supplierProfile.dailyCapacity}}">请选择</view>
        <view class="picker-val" wx:else>{{supplierProfile.dailyCapacity}}</view>
      </picker>
    </view>
    <view class="form-row">
      <text class="form-label">团队简介</text>
      <textarea style="{{lqInputStyle}}" placeholder-style="{{lqPhStyle}}"
        class="apply-textarea"
        maxlength="200"
        auto-height="{{false}}"
        show-confirm-bar="{{false}}"
        placeholder="选填，最多200字"
        value="{{supplierProfile.intro}}"
        data-k="intro"
        bindinput="onSupplierField"
      />
    </view>
    <view class="form-row">
      <text class="form-label">擅长品类</text>
      <text class="form-hint">最多 3 个</text>
      <view class="account-tag-grid">
        <view wx:for="{{categoryTagGrid}}" wx:key="name" class="account-tag-chip {{item.on ? 'account-tag-chip--on' : ''}}" data-name="{{item.name}}" bindtap="onCategoryTagTap">{{item.name}}</view>
      </view>
    </view>
    <view class="form-row" wx:if="{{workIdentity === 'shoot'}}">
      <text class="form-label">拍摄类型</text>
      <view class="account-tag-grid">
        <view wx:for="{{shootTypeGrid}}" wx:key="name" class="account-tag-chip {{item.on ? 'account-tag-chip--on' : ''}}" data-field="shootTypes" data-name="{{item.name}}" bindtap="onSupplierMultiTap">{{item.name}}</view>
      </view>
    </view>
    <view class="form-row" wx:if="{{workIdentity === 'shoot'}}">
      <text class="form-label">设备能力</text>
      <view class="account-tag-grid">
        <view wx:for="{{equipmentGrid}}" wx:key="name" class="account-tag-chip {{item.on ? 'account-tag-chip--on' : ''}}" data-field="equipment" data-name="{{item.name}}" bindtap="onSupplierMultiTap">{{item.name}}</view>
      </view>
    </view>
    <view class="form-row" wx:if="{{workIdentity === 'edit'}}">
      <text class="form-label">成片类型</text>
      <view class="account-tag-grid">
        <view wx:for="{{editTypeGrid}}" wx:key="name" class="account-tag-chip {{item.on ? 'account-tag-chip--on' : ''}}" data-field="editTypes" data-name="{{item.name}}" bindtap="onSupplierMultiTap">{{item.name}}</view>
      </view>
    </view>
    <view class="form-row" wx:if="{{workIdentity === 'edit'}}">
      <text class="form-label">剪辑风格</text>
      <view class="account-tag-grid">
        <view wx:for="{{editStyleGrid}}" wx:key="name" class="account-tag-chip {{item.on ? 'account-tag-chip--on' : ''}}" data-field="editStyles" data-name="{{item.name}}" bindtap="onSupplierMultiTap">{{item.name}}</view>
      </view>
    </view>
    <view class="form-row" wx:if="{{workIdentity === 'edit'}}">
      <text class="form-label">软件能力</text>
      <view class="account-tag-grid">
        <view wx:for="{{softwareGrid}}" wx:key="name" class="account-tag-chip {{item.on ? 'account-tag-chip--on' : ''}}" data-field="software" data-name="{{item.name}}" bindtap="onSupplierMultiTap">{{item.name}}</view>
      </view>
    </view>
    <view class="form-row">
      <text class="form-label">作品集链接 *</text>
      <input style="{{lqInputStyle}}" placeholder-style="{{lqPhStyle}}" class="input" placeholder="样片合集或主页链接" value="{{supplierProfile.portfolioLink}}" data-k="portfolioLink" bindinput="onSupplierField" />
    </view>
    <view class="form-row" wx:if="{{workIdentity === 'shoot'}}">
      <text class="form-label">半日跟拍报价（元）</text>
      <input style="{{lqInputStyle}}" placeholder-style="{{lqPhStyle}}" class="input" type="digit" value="{{supplierProfile.halfDayQuote}}" data-k="halfDayQuote" bindinput="onSupplierField" />
    </view>
    <view class="form-row" wx:if="{{workIdentity === 'shoot'}}">
      <text class="form-label">全日跟拍报价（元）</text>
      <input style="{{lqInputStyle}}" placeholder-style="{{lqPhStyle}}" class="input" type="digit" value="{{supplierProfile.fullDayQuote}}" data-k="fullDayQuote" bindinput="onSupplierField" />
    </view>
    <view class="form-row" wx:if="{{workIdentity === 'edit'}}">
      <text class="form-label">单条剪辑报价（元）</text>
      <input style="{{lqInputStyle}}" placeholder-style="{{lqPhStyle}}" class="input" type="digit" value="{{supplierProfile.perClipQuote}}" data-k="perClipQuote" bindinput="onSupplierField" />
    </view>
    <view class="form-row" wx:if="{{workIdentity === 'edit'}}">
      <text class="form-label">接云剪任务</text>
      <switch checked="{{supplierProfile.acceptsIce}}" color="#6366f1" data-k="acceptsIce" bindchange="onSupplierSwitch" />
    </view>
    <view class="env-save-row">
      <button class="env-btn" data-key="team" bindtap="onCloseSection">{{envelopeViewKey === 'team' ? '关闭' : '取消'}}</button>
      <button wx:if="{{envelopeViewKey !== 'team'}}" class="env-btn env-btn--save" loading="{{submitting}}" disabled="{{submitting}}" data-section="team" bindtap="onSubmit">保存</button>
    </view>
    </view>
    </view>
  </view>

  <view class="card apply-form platform-card env {{item.expanded ? 'env--open' : ''}}" wx:for="{{platformSections}}" wx:key="id" wx:if="{{!isSupplier}}">
    <view class="platform-card-head">
      <image class="platform-card-icon" src="{{item.icon}}" mode="aspectFit" />
      <text class="platform-card-title">{{item.name}}</text>
      <view class="platform-card-actions">
        <view
          wx:if="{{item.enabled && !item.expanded}}"
          class="platform-detail-btn platform-detail-btn--view"
          data-id="{{item.id}}"
          data-mode="view"
          catchtap="onOpenPlatform"
        >查看</view>
        <view
          wx:if="{{!item.expanded}}"
          class="platform-detail-btn"
          data-id="{{item.id}}"
          data-mode="edit"
          catchtap="onOpenPlatform"
        >
          <text>{{item.enabled ? '修改' : '开启'}}</text>
        </view>
      </view>
    </view>
    <view class="platform-card-summary" wx:if="{{!item.enabled}}">
      <text>未启用</text>
    </view>
    <view class="platform-card-summary" wx:if="{{item.enabled && !item.expanded && !item.profile.platformNickname}}">
      <text>已启用</text>
    </view>
    <view class="platform-card-summary" wx:if="{{item.enabled && !item.expanded && item.profile.platformNickname}}">
      <text>{{item.profile.platformNickname}}</text>
      <text wx:if="{{item.profile.followers}}"> · 粉丝 {{item.profile.followers}}</text>
    </view>
    <view class="platform-tag-summary" wx:if="{{item.enabled && !item.expanded && item.selectedTags.length}}">
      <text
        wx:for="{{item.selectedTags}}"
        wx:for-item="tagName"
        wx:key="*this"
        class="account-tag-chip account-tag-chip--on"
      >{{tagName}}</text>
    </view>

    <view class="env-mask" wx:if="{{item.enabled && item.expanded}}" data-id="{{item.id}}" catchtap="onClosePlatform" catchtouchmove="onEnvHold"></view>
    <view class="env-sheet" wx:if="{{item.enabled && item.expanded}}">
      <image class="env-pop-logo" src="{{item.icon}}" mode="aspectFit" />
      <view class="env-letter {{envelopeViewKey === item.id ? 'env-letter--view' : ''}}">
      <view class="platform-head {{item.headClass}}">{{item.name}}达人资料</view>
      <view class="form-row">
        <text class="form-label">{{item.labels.profileLink}} *</text>
        <input style="{{lqInputStyle}}" placeholder-style="{{lqPhStyle}}"
          class="input"
          placeholder="{{item.profileLinkPlaceholder}}"
          value="{{item.profile.profileLink}}"
          data-id="{{item.id}}"
          data-k="profileLink"
          bindinput="onPlatformField"
        />
        <button
          class="profile-autofill-btn"
          size="mini"
          loading="{{profileAutofillLoading && profileAutofillPlatform === item.id}}"
          disabled="{{profileAutofillLoading}}"
          data-id="{{item.id}}"
          bindtap="onProfileLinkAutofill"
          wx:if="{{envelopeViewKey !== item.id}}"
        >AI自动解析链接并填写下方信息</button>
      </view>
      <image
        wx:if="{{item.profile.avatarUrl}}"
        class="platform-avatar"
        src="{{item.profile.avatarUrl}}"
        mode="aspectFill"
      />
      <view class="form-row">
        <text class="form-label">{{item.labels.accountId}} *</text>
        <input style="{{lqInputStyle}}" placeholder-style="{{lqPhStyle}}"
          class="input"
          placeholder="请填写"
          value="{{item.profile.platformAccount}}"
          data-id="{{item.id}}"
          data-k="platformAccount"
          bindinput="onPlatformField"
        />
      </view>
      <view class="form-row">
        <text class="form-label">{{item.labels.nickname}} *</text>
        <input style="{{lqInputStyle}}" placeholder-style="{{lqPhStyle}}"
          class="input"
          placeholder="请填写"
          value="{{item.profile.platformNickname}}"
          data-id="{{item.id}}"
          data-k="platformNickname"
          bindinput="onPlatformField"
        />
      </view>
      <view class="form-row">
        <text class="form-label">{{item.labels.followersLabel}} *</text>
        <input style="{{lqInputStyle}}" placeholder-style="{{lqPhStyle}}"
          class="input"
          type="number"
          placeholder="请填写粉丝数"
          value="{{item.profile.followers}}"
          data-id="{{item.id}}"
          data-k="followers"
          bindinput="onPlatformField"
        />
      </view>
      <block wx:if="{{item.id === 'douyin' || item.id === 'xiaohongshu' || item.id === 'kuaishou' || item.id === 'weixin_video'}}">
        <view class="form-row">
          <text class="form-label">IP属地</text>
          <input style="{{lqInputStyle}}" placeholder-style="{{lqPhStyle}}" class="input" placeholder="解析后自动填入" value="{{item.profile.ipLocation}}" data-id="{{item.id}}" data-k="ipLocation" bindinput="onPlatformField" />
        </view>
        <view class="form-row" wx:if="{{item.id === 'douyin'}}">
          <text class="form-label">年龄</text>
          <input style="{{lqInputStyle}}" placeholder-style="{{lqPhStyle}}" class="input" placeholder="解析后自动填入" value="{{item.profile.age}}" data-id="{{item.id}}" data-k="age" bindinput="onPlatformField" />
        </view>
        <view class="form-row">
          <text class="form-label">关注数</text>
          <input style="{{lqInputStyle}}" placeholder-style="{{lqPhStyle}}" class="input" type="number" value="{{item.profile.followingCount}}" data-id="{{item.id}}" data-k="followingCount" bindinput="onPlatformField" />
        </view>
        <view class="form-row">
          <text class="form-label">{{item.id === 'xiaohongshu' ? '获赞与收藏' : '获赞'}}</text>
          <input style="{{lqInputStyle}}" placeholder-style="{{lqPhStyle}}" class="input" type="number" value="{{item.profile.totalFavorited}}" data-id="{{item.id}}" data-k="totalFavorited" bindinput="onPlatformField" />
        </view>
        <view class="form-row">
          <text class="form-label">作品数</text>
          <input style="{{lqInputStyle}}" placeholder-style="{{lqPhStyle}}" class="input" type="number" value="{{item.profile.awemeCount}}" data-id="{{item.id}}" data-k="awemeCount" bindinput="onPlatformField" />
        </view>
        <view class="form-row">
          <text class="form-label">简介</text>
          <textarea style="{{lqInputStyle}}" placeholder-style="{{lqPhStyle}}" class="input" value="{{item.profile.signature}}" data-id="{{item.id}}" data-k="signature" bindinput="onPlatformField" />
        </view>
      </block>
      <view class="form-row" wx:if="{{item.showTradeShot}}">
        <text class="form-label">近期交易截图（选填）</text>
        <text class="trade-shot-hint">打开抖音或快手「数据中心 → 数据概览 → 交易分析 → 近30日」，截这一屏。不上传也可以保存。</text>
        <image class="trade-shot-example" src="/images/trade-screenshot-example.jpg" mode="aspectFill" bindtap="onPreviewTradeExample" />
        <text class="trade-shot-hint">点击小图可放大。上图是抖音数据中心示例，快手截同样的交易数据页即可。</text>
        <view class="trade-shot-actions" wx:if="{{envelopeViewKey !== item.id}}">
          <button class="profile-autofill-btn" size="mini" data-id="{{item.id}}" bindtap="onUploadTradeShot">{{item.profile.recentTradeScreenshot ? '重新上传' : '上传截图'}}</button>
          <button wx:if="{{item.profile.recentTradeScreenshot}}" class="profile-autofill-btn" size="mini" data-id="{{item.id}}" bindtap="onClearTradeShot">清除</button>
        </view>
        <image wx:if="{{item.profile.recentTradeScreenshot}}" class="trade-shot-preview" src="{{item.profile.recentTradeScreenshot}}" mode="aspectFill" data-id="{{item.id}}" bindtap="onPreviewTradeShot" />
      </view>
      <view class="form-row" wx:if="{{item.showSalesLevel}}">
        <text class="form-label">抖音带货等级 *</text>
        <picker mode="selector" range="{{douyinLevels}}" value="{{item.douyinLevelIndex}}" bindchange="onDouyinLevelChange">
          <view class="picker-val {{item.profile.douyinSalesLevel ? '' : 'picker-val--placeholder'}}">
            {{item.profile.douyinSalesLevel || '请选择带货等级'}}
          </view>
        </picker>
      </view>
      <view class="form-row" wx:if="{{item.showTalentGrade}}">
        <text class="form-label">快手达人等级</text>
        <input style="{{lqInputStyle}}" placeholder-style="{{lqPhStyle}}"
          class="input"
          placeholder="如 Lv3 带货达人"
          value="{{item.profile.talentGrade}}"
          data-id="{{item.id}}"
          data-k="talentGrade"
          bindinput="onPlatformField"
        />
      </view>
      <view class="form-row">
        <text class="form-label">默认报价（元） *</text>
        <input style="{{lqInputStyle}}" placeholder-style="{{lqPhStyle}}"
          class="input"
          type="digit"
          placeholder="请填写报价"
          value="{{item.profile.quotePrice}}"
          data-id="{{item.id}}"
          data-k="quotePrice"
          bindinput="onPlatformField"
        />
      </view>
      <view class="form-row">
        <text class="form-label">账号标签 *</text>
        <text class="form-hint">与发招募需求标签一致，可多选</text>
        <view class="account-tag-grid">
          <view
            wx:for="{{item.tagGrid}}"
            wx:for-item="tag"
            wx:key="name"
            class="account-tag-chip {{tag.on ? 'account-tag-chip--on' : ''}}"
            data-id="{{item.id}}"
            data-name="{{tag.name}}"
            bindtap="onAccountTagTap"
          >
            {{tag.name}}
          </view>
        </view>
      </view>
      <view class="env-save-row">
        <button class="env-btn" data-id="{{item.id}}" catchtap="onClosePlatform">{{envelopeViewKey === item.id ? '关闭' : '取消'}}</button>
        <button wx:if="{{envelopeViewKey !== item.id}}" class="env-btn env-btn--save" loading="{{submitting}}" disabled="{{submitting}}" data-section="platform" data-id="{{item.id}}" bindtap="onSubmit">保存</button>
      </view>
      </view>
    </view>
  </view>

  <view class="account-session-actions">
    <button class="account-session-btn" plain type="default" hover-class="account-session-btn--hover" catchtap="onSwitchAccount">切换账号</button>
    <button class="account-session-btn account-session-btn--ghost" plain type="default" hover-class="account-session-btn--hover" catchtap="onLogoutAccount">退出登录</button>
    <button class="account-session-btn account-session-btn--danger" plain type="default" hover-class="account-session-btn--hover" catchtap="onOpenCloseAccount">注销账号</button>
  </view>
  <view class="close-sheet-mask" wx:if="{{closeSheet}}" catchtap="onCloseCloseSheet"></view>
  <view class="close-sheet" wx:if="{{closeSheet}}">
    <text class="close-sheet-title">注销账号</text>
    <text class="close-sheet-hint">验证码会发到 {{closePhoneMasked}}。注销后这个账号不能再登录。</text>
    <view class="close-sheet-row">
      <input style="{{lqInputStyle}}" placeholder-style="{{lqPhStyle}}" class="close-sheet-input" type="number" maxlength="6" placeholder="6 位验证码" value="{{closeCode}}" bindinput="onCloseCodeInput" />
      <button class="close-sheet-send" disabled="{{closeSending || closeCooldown > 0}}" bindtap="onSendCloseSms">{{closeCooldown > 0 ? closeCooldown + '秒' : '获取验证码'}}</button>
    </view>
    <view class="close-sheet-actions">
      <button class="account-session-btn account-session-btn--ghost" plain type="default" catchtap="onCloseCloseSheet">取消</button>
      <button class="account-session-btn account-session-btn--danger" plain type="default" catchtap="onConfirmCloseAccount">确认注销</button>
    </view>
  </view>
  <site-icp-footer />
</view>
