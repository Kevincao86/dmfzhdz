<scroll-view scroll-y class="op-page" enhanced show-scrollbar="{{false}}">
  <view class="op-hero">
    <text class="op-title">AI 短剧</text>
    <text class="op-sub">和商家端同一套四步：先选场景，再写故事和角色，最后出片。</text>
  </view>

  <view class="op-steps">
    <text class="op-step {{dramaStep === 1 ? 'on' : ''}}" data-step="1" bindtap="onDramaStep">1 场景</text>
    <text class="op-step {{dramaStep === 2 ? 'on' : ''}}" data-step="2" bindtap="onDramaStep">2 故事</text>
    <text class="op-step {{dramaStep === 3 ? 'on' : ''}}" data-step="3" bindtap="onDramaStep">3 角色</text>
    <text class="op-step {{dramaStep === 4 ? 'on' : ''}}" data-step="4" bindtap="onDramaStep">4 出片</text>
  </view>

  <view class="op-card" wx:if="{{dramaStep === 1}}">
    <text class="op-label">世界观</text>
    <view class="op-chips">
      <text
        wx:for="{{worlds}}"
        wx:key="id"
        class="op-chip {{item.on ? 'on' : ''}}"
        data-id="{{item.id}}"
        bindtap="onWorld"
      >{{item.label}}</text>
    </view>
    <text class="op-body muted">{{worldBlurb}}</text>
    <text class="op-label">场景</text>
    <view class="op-chips">
      <text
        wx:for="{{scenes}}"
        wx:key="id"
        class="op-chip {{item.on ? 'on' : ''}}"
        data-id="{{item.id}}"
        bindtap="onScene"
      >{{item.name}}</text>
    </view>
    <text class="op-body muted">钩子：{{sceneHook}}</text>
    <block wx:if="{{sceneId === 'custom_scene'}}">
      <text class="op-label">场景名称</text>
      <input class="op-input" placeholder="例如：深夜档口收摊" value="{{customSceneName}}" bindinput="onCustomSceneName" />
      <text class="op-label">开场钩子</text>
      <input class="op-input" placeholder="这一场前三秒怎么抓住人" value="{{customSceneHook}}" bindinput="onCustomSceneHook" />
      <text class="op-label">画面里必须出现</text>
      <input class="op-input" placeholder="例如：卷帘门、剩汤、路灯" value="{{customSceneMustSee}}" bindinput="onCustomSceneMust" />
    </block>
    <button class="op-btn" bindtap="onDramaNext">下一步：写故事</button>
  </view>

  <view class="op-card" wx:elif="{{dramaStep === 2}}">
    <text class="op-label">成片时长</text>
    <picker mode="selector" range="{{durationOptions}}" range-key="label" value="{{durationIdx}}" bindchange="onDuration">
      <view class="op-picker">{{durationOptions[durationIdx].label}}</view>
    </picker>
    <text class="op-meta">{{durationHint}}</text>
    <text class="op-label">画风</text>
    <view class="op-chips">
      <text wx:for="{{styles}}" wx:key="id" class="op-chip {{item.on ? 'on' : ''}}" data-id="{{item.id}}" bindtap="onStyle">{{item.name}}</text>
    </view>
    <text class="op-label">清晰度</text>
    <view class="op-chips">
      <text wx:for="{{qualities}}" wx:key="id" class="op-chip {{item.on ? 'on' : ''}}" data-id="{{item.id}}" bindtap="onQuality">{{item.label}}</text>
    </view>
    <block wx:for="{{fields}}" wx:key="key">
      <text class="op-label">{{item.label}}</text>
      <input class="op-input" data-key="{{item.key}}" placeholder="{{item.placeholder}}" value="{{item.value}}" bindinput="onField" />
    </block>
    <text class="op-label">一句话故事</text>
    <text class="op-body muted">先选时长。8～15 秒写一个钩子，30 秒起按时间轴把剧情写满。</text>
    <textarea class="op-area" maxlength="2000" placeholder="先选时长，再点 AI生成故事" value="{{story}}" bindinput="onStory" />
    <button class="op-btn-ghost" loading="{{storyBusy}}" bindtap="onAiStory">{{storyBusy ? '正在写故事' : 'AI生成故事'}}</button>
    <view class="op-pair">
      <button class="op-btn-ghost" bindtap="onDramaPrev">上一步</button>
      <button class="op-btn" bindtap="onDramaNext">下一步：角色</button>
    </view>
  </view>

  <view class="op-card" wx:elif="{{dramaStep === 3}}">
    <text class="op-label">角色形象</text>
    <text class="op-body muted">写出角色名和形象词，会写进成片提示词。可加多位。</text>
    <button class="op-btn-ghost" bindtap="onAddCast">新建角色</button>
    <view wx:for="{{cast}}" wx:key="id" class="op-cast-card">
      <view class="op-row">
        <input class="op-input grow" data-id="{{item.id}}" placeholder="角色名" value="{{item.name}}" bindinput="onCastName" />
        <button class="op-btn-ghost" data-id="{{item.id}}" bindtap="onRemoveCast">删除</button>
      </view>
      <textarea
        class="op-area"
        maxlength="300"
        data-id="{{item.id}}"
        placeholder="形象词：年龄、发型发色、衣着"
        value="{{item.desc}}"
        bindinput="onCastDesc"
      />
    </view>
    <view class="op-pair">
      <button class="op-btn-ghost" bindtap="onDramaPrev">上一步</button>
      <button class="op-btn" bindtap="onDramaNext">下一步：出片</button>
    </view>
  </view>

  <view class="op-card" wx:elif="{{dramaStep === 4}}">
    <text class="op-label">出片</text>
    <text class="op-body muted">{{clipHint}}</text>
    <text class="op-body">{{promptPreview}}</text>
    <button class="op-btn" loading="{{busy}}" bindtap="onGenerate">{{busy ? '正在出片' : '生成短剧'}}</button>
    <text wx:if="{{progress}}" class="op-meta">{{progress}}</text>
    <text wx:if="{{err}}" class="op-err">{{err}}</text>
    <video wx:if="{{resultUrl}}" class="op-box" src="{{resultUrl}}" controls object-fit="contain" />
    <button wx:if="{{resultUrl}}" class="op-btn-ghost" bindtap="onSaveVideo">保存到相册</button>
    <button class="op-btn-ghost" bindtap="onDramaPrev">上一步</button>
  </view>
</scroll-view>
