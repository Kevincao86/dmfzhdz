@import "../../../styles/theme.wxss";
@import "../../../styles/identity-themes.wxss";
@import "../../../partials/login-cred-panel.wxss";
@import "../../../partials/account-session-actions.wxss";

.form-row--intro {
  margin-bottom: 8rpx;
}

.pr-intro-input {
  width: 100%;
  height: 168rpx;
  min-height: 168rpx;
  max-height: 168rpx;
  padding: 18rpx 22rpx;
  box-sizing: border-box;
  font-size: 28rpx;
  line-height: 1.45;
  color: #0f172a;
  background: #fdfbff;
  border: 3rpx solid var(--lq-border, #e8e4f8);
  border-radius: var(--lq-radius-sm, 16rpx);
}

.wx-profile {
  display: flex;
  align-items: center;
  gap: 24rpx;
  margin-bottom: 8rpx;
}

.wx-avatar-btn {
  padding: 0;
  margin: 0;
  background: transparent;
  border: none;
  line-height: 1;
  flex-shrink: 0;
}

.wx-avatar-btn::after {
  border: none;
}

.wx-nick-input {
  width: 100%;
  font-size: 32rpx;
  font-weight: 700;
  color: #0f172a;
  padding: 8rpx 0;
}

.wx-avatar {
  width: 104rpx;
  height: 104rpx;
  border-radius: 50%;
  flex-shrink: 0;
  border: 4rpx solid #fff;
  box-shadow: 0 8rpx 24rpx rgba(15, 23, 42, 0.1);
}

.wx-avatar--ph {
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #bbf7d0, #86efac);
}

.wx-avatar-txt {
  font-size: 24rpx;
  color: #166534;
}

.pr-logo-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-top: 12rpx;
}

.pr-logo-preview {
  width: 112rpx;
  height: 112rpx;
  border-radius: 20rpx;
  background: #fff;
  border: 2rpx solid var(--lq-border, #e8e4f8);
  flex-shrink: 0;
}

.pr-logo-preview--ph {
  display: flex;
  align-items: center;
  justify-content: center;
  background: #f8fafc;
  border-style: dashed;
}

.pr-logo-ph {
  font-size: 22rpx;
  color: #94a3b8;
}

.pr-logo-actions {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.pr-logo-btn {
  margin: 0;
}

.pr-logo-btn--ghost {
  background: #fff;
  color: #64748b;
}

.type-switch {
  display: flex;
  flex-direction: row;
  align-items: stretch;
  gap: 0;
  padding: 6rpx;
  border-radius: 999rpx;
  background: var(--lq-primary-50);
  margin-bottom: 8rpx;
}

.type-switch-item {
  flex: 1;
  padding: 22rpx 16rpx;
  border-radius: 999rpx;
  text-align: center;
  transition: background 0.15s ease;
}

.type-switch-item.active {
  background: #fff;
  box-shadow: var(--lq-shadow-soft);
}

.type-switch-label {
  font-size: 26rpx;
  font-weight: 600;
  color: #64748b;
}

.type-switch-item.active .type-switch-label {
  color: var(--lq-primary-dark);
}

.env .section-head {
  margin-bottom: 0;
}

.env-sum {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #64748b;
}

.env-actions {
  margin-left: auto;
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex-shrink: 0;
}

.env-btn {
  margin: 0;
  padding: 0 28rpx;
  height: 56rpx;
  line-height: 56rpx;
  font-size: 24rpx;
  font-weight: 600;
  color: #6d28d9;
  background: #f5f3ff;
  border: 2rpx solid #ddd6fe;
  border-radius: 999rpx;
  box-sizing: border-box;
}

button.env-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: auto !important;
  min-width: 0 !important;
  padding: 0 28rpx !important;
}

button.env-btn::after {
  border: none;
}

.env-btn--save {
  color: #fff;
  background: #6d28d9;
  border-color: #6d28d9;
}

.env-save-row {
  display: flex;
  justify-content: flex-end;
  gap: 16rpx;
  margin-top: 24rpx;
}

.env-sheet {
  display: none;
}

.env--open .env-sheet {
  display: block;
  position: fixed;
  z-index: 301;
  left: 40rpx;
  right: 40rpx;
  top: 12vh;
  max-height: 76vh;
  overflow: visible;
  background: transparent;
  padding: 0;
}

.env-mask {
  position: fixed;
  z-index: 300;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(15, 23, 42, 0.45);
}

.env-letter {
  max-height: 76vh;
  overflow-y: auto;
  background: #fff;
  border-radius: 28rpx;
  padding: 32rpx 28rpx 28rpx;
  box-sizing: border-box;
}

.env-letter--view input,
.env-letter--view textarea,
.env-letter--view picker,
.env-letter--view .type-switch,
.env-letter--view .pr-logo-actions {
  pointer-events: none;
}
