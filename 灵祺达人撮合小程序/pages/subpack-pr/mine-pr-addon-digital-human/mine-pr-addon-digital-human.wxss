@import '../../../styles/mp-addon-page.wxss';

.addon-create-box {
  margin: 24rpx 0 16rpx;
  padding: 20rpx 0 8rpx;
  border-top: 1rpx solid rgba(15, 23, 42, 0.08);
}
.addon-avatar__hint {
  display: block;
  margin-top: 4rpx;
  font-size: 20rpx;
  color: #64748b;
  line-height: 1.3;
}
.addon-avatar__tag {
  display: block;
  font-size: 20rpx;
  color: #94a3b8;
}

.addon-pair button.addon-btn--ghost {
  margin-top: 0;
  flex: 1;
}
