.page { min-height: 100vh; background: #f7f3ec; color: #2c2416; padding: 24rpx 28rpx 80rpx; box-sizing: border-box; }
.strip { background: #fffdf8; border-radius: 20rpx; padding: 22rpx 24rpx; margin-bottom: 20rpx; }
.strip-title { font-size: 34rpx; font-weight: 600; }
.strip-sub { margin-top: 8rpx; font-size: 24rpx; color: #7a6a55; line-height: 1.5; }
.tabs { display: flex; background: #efe8dc; border-radius: 16rpx; padding: 6rpx; margin-bottom: 20rpx; }
.tab { flex: 1; text-align: center; font-size: 28rpx; color: #7a6a55; padding: 16rpx 0; border-radius: 12rpx; }
.tab.on { background: #fffdf8; color: #2c2416; font-weight: 600; }
.card { background: #fffdf8; border-radius: 20rpx; padding: 24rpx; margin-bottom: 20rpx; }
.field { width: 100%; min-height: 88rpx; background: #f7f3ec; border-radius: 14rpx; padding: 20rpx; box-sizing: border-box; font-size: 28rpx; }
.btn { margin-top: 20rpx; background: #3d3228; color: #f7f3ec; border-radius: 14rpx; font-size: 30rpx; line-height: 88rpx; }
.btn[disabled] { opacity: 0.55; }
.ghost { margin-top: 16rpx; background: transparent; color: #3d3228; border: 1px solid #d9cfc0; border-radius: 14rpx; font-size: 28rpx; line-height: 80rpx; }
.chips { display: flex; flex-wrap: wrap; gap: 12rpx; margin-top: 16rpx; }
.chip { font-size: 22rpx; color: #7a6a55; background: #f3ece2; border-radius: 999rpx; padding: 6rpx 16rpx; }
.row { display: flex; align-items: flex-start; padding: 18rpx 0; border-top: 1px solid #f0e8dc; }
.row-label { width: 140rpx; flex-shrink: 0; font-size: 26rpx; color: #7a6a55; }
.row-value { flex: 1; font-size: 28rpx; line-height: 1.5; }
.tag { display: inline-block; margin-left: 12rpx; font-size: 20rpx; color: #8a5a2b; background: #f6ead8; border-radius: 8rpx; padding: 2rpx 8rpx; }
.clock { margin-top: 8rpx; font-size: 22rpx; color: #9a8b76; }
.sheet-row { padding: 16rpx 0; border-top: 1px solid #f0e8dc; font-size: 26rpx; }
.sheet-row.fail { color: #9a4030; }
.sheet-row.ok { color: #3d5a3a; }
.note { font-size: 24rpx; color: #7a6a55; line-height: 1.6; }
