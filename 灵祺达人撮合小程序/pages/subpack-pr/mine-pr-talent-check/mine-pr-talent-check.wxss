.page { min-height: 100vh; background: #f7f3ec; color: #2c2416; padding: 28rpx 28rpx 80rpx; box-sizing: border-box; }
.head { display: flex; align-items: flex-start; justify-content: space-between; }
.title { font-size: 40rpx; font-weight: 650; }
.pills { display: flex; flex-wrap: wrap; justify-content: flex-end; gap: 8rpx; max-width: 340rpx; }
.pill { background: #fffdf8; border: 1px solid #efe6d8; border-radius: 999rpx; padding: 6rpx 14rpx; font-size: 20rpx; color: #7a6a55; }
.hint { margin-top: 12rpx; font-size: 22rpx; color: #7a6a55; line-height: 1.5; }
.platforms { display: flex; flex-wrap: wrap; gap: 12rpx; margin-top: 24rpx; }
.platform { display: flex; align-items: center; gap: 10rpx; background: #fffdf8; border: 1px solid #efe6d8; border-radius: 16rpx; padding: 10rpx 14rpx; }
.platform image { width: 48rpx; height: 48rpx; border-radius: 10rpx; }
.platform.on { border-color: #efe6d8; }
.platform.picked { border-color: #2c2416; background: #fff; }
.platform.off { opacity: 0.72; }
.pname { font-size: 24rpx; font-weight: 600; }
.pclosed { font-size: 18rpx; color: #9a8b76; }
.finder { display: flex; flex-direction: column; align-items: center; }
.tabs { display: flex; background: #efe8dc; border-radius: 14rpx; padding: 4rpx; margin-top: 20rpx; }
.tab { font-size: 24rpx; color: #7a6a55; padding: 10rpx 22rpx; border-radius: 12rpx; }
.tab.on { background: #fffdf8; color: #2c2416; font-weight: 650; }
.search { display: flex; align-items: center; gap: 12rpx; width: 100%; margin-top: 16rpx; box-sizing: border-box; }
.field { flex: 1; display: flex; align-items: center; gap: 10rpx; height: 72rpx; background: #fffdf8; border: 1px solid #2c2416; border-radius: 14rpx; padding: 0 16rpx; }
.field image { width: 36rpx; height: 36rpx; border-radius: 8rpx; }
.field input { flex: 1; font-size: 26rpx; }
.go { height: 72rpx; line-height: 72rpx; margin: 0; padding: 0 28rpx; background: #3d3228; color: #f7f3ec; border-radius: 14rpx; font-size: 26rpx; }
.search .go { width: 168rpx; flex: none; }
button::after { border: none; }
.ghost { height: 72rpx; line-height: 72rpx; margin: 16rpx 0 0; background: transparent; color: #3d3228; border: 1px solid #d9cfc0; border-radius: 14rpx; font-size: 26rpx; }
.chips { display: flex; flex-wrap: wrap; justify-content: center; gap: 10rpx; width: 100%; margin-top: 14rpx; }
.chip, .tag { font-size: 20rpx; color: #7a6a55; background: #f3ece2; border-radius: 999rpx; padding: 4rpx 12rpx; }
.guides { margin-top: 20rpx; }
.guide { background: #fffdf8; border-radius: 16rpx; padding: 16rpx 18rpx; margin-bottom: 12rpx; }
.gb { font-size: 26rpx; font-weight: 600; }
.gs { margin-top: 4rpx; font-size: 22rpx; color: #7a6a55; }
.result { margin-top: 20rpx; background: #fffdf8; border-radius: 16rpx; padding: 20rpx; }
.who { display: flex; gap: 16rpx; align-items: center; }
.avatar, .fallback { width: 96rpx; height: 96rpx; border-radius: 50%; background: #efe8dc; }
.fallback { display: flex; align-items: center; justify-content: center; font-size: 32rpx; }
.nick { font-size: 32rpx; font-weight: 650; }
.account { display: flex; align-items: center; gap: 8rpx; margin-top: 4rpx; font-size: 22rpx; color: #7a6a55; }
.account image { width: 24rpx; height: 24rpx; border-radius: 4rpx; }
.metrics { display: flex; flex-wrap: wrap; margin-top: 16rpx; }
.metric { width: 50%; box-sizing: border-box; padding: 10rpx 8rpx 10rpx 0; }
.ml { display: flex; align-items: center; justify-content: space-between; font-size: 20rpx; color: #9a8b76; }
.mv { margin-top: 4rpx; font-size: 28rpx; font-weight: 650; }
.sales { margin-top: 18rpx; }
.read { margin-top: 16rpx; padding-top: 16rpx; border-top: 1px solid #f0e8dc; }
.read-title { font-size: 26rpx; font-weight: 650; margin-bottom: 8rpx; }
.summary { font-size: 26rpx; line-height: 1.7; color: #2c2416; }
.clock { margin-top: 6rpx; font-size: 20rpx; color: #9a8b76; }
.batch { margin-top: 16rpx; }
.line { padding: 12rpx 0; border-top: 1px solid #f0e8dc; font-size: 24rpx; }
.line.ok { color: #3d5a3a; }
.line.fail { color: #9a4030; }
.history { margin-top: 28rpx; }
.history-title { font-size: 30rpx; font-weight: 650; margin-bottom: 12rpx; }
.history-empty { font-size: 22rpx; color: #9a8b76; line-height: 1.6; }
.history-item { display: flex; align-items: center; gap: 16rpx; background: #fffdf8; border-radius: 16rpx; padding: 16rpx; margin-bottom: 12rpx; }
.history-avatar, .history-fallback { width: 72rpx; height: 72rpx; border-radius: 50%; background: #efe8dc; flex: none; }
.history-fallback { display: flex; align-items: center; justify-content: center; font-size: 28rpx; }
.history-main { flex: 1; min-width: 0; }
.history-name { font-size: 28rpx; font-weight: 650; }
.history-meta { margin-top: 4rpx; font-size: 20rpx; color: #7a6a55; }
.history-time { font-size: 20rpx; color: #9a8b76; flex: none; }
