<view class="page">
  <view class="head">
    <view class="title">达人查验</view>
    <view class="pills">
      <text class="pill">{{member ? '会员 · 余额 ' + pointsBalance : '免费版'}}</text>
      <text class="pill">{{platform === 'xhs' ? xhsPointsPerCheck + '积分/次' : (member ? pointsPerCheck + '积分/次' : (freeRemaining > 0 ? '本月剩 1 次' : '本月已用完'))}}</text>
    </view>
  </view>
  <view class="hint" wx:if="{{hint}}">{{hint}}</view>

  <view class="platforms">
    <view class="platform {{item.open ? 'on' : 'off'}} {{platform === item.id ? 'picked' : ''}}" wx:for="{{platforms}}" wx:key="id" data-id="{{item.id}}" bindtap="onPlatform">
      <image src="{{item.logo}}" mode="aspectFill" />
      <view>
        <view class="pname">{{item.label}}</view>
        <view class="pclosed" wx:if="{{!item.open}}">未开放</view>
      </view>
    </view>
  </view>

  <view class="finder">
    <view class="tabs">
      <view class="tab {{tab === 'single' ? 'on' : ''}}" data-tab="single" bindtap="onTab">单个查验</view>
      <view class="tab {{tab === 'batch' ? 'on' : ''}}" data-tab="batch" bindtap="onTab">批量查验</view>
    </view>
    <block wx:if="{{tab === 'single'}}">
      <view class="search">
        <view class="field">
          <image src="{{platform === 'xhs' ? '/images/platforms/xiaohongshu.png' : '/images/platforms/douyin.png'}}" mode="aspectFill" />
          <input placeholder="{{platform === 'xhs' ? '小红书号、主页链接或昵称' : '抖音号、口令或主页链接'}}" value="{{query}}" bindinput="onQuery" />
        </view>
        <button class="go" loading="{{busy}}" disabled="{{busy}}" bindtap="onCheck">{{singleLabel}}</button>
      </view>
      <view class="chips">
        <text class="chip">公开主页</text>
        <text class="chip">{{platform === 'xhs' ? '笔记互动' : '口令解析'}}</text>
        <text class="chip">{{platform === 'xhs' ? '机构专业解读' : '抖音官方数据检索'}}</text>
      </view>
    </block>
  </view>

  <block wx:if="{{tab === 'single'}}">
    <view class="result" wx:if="{{view}}">
      <view class="who">
        <image class="avatar" wx:if="{{view.avatarUrl}}" src="{{view.avatarUrl}}" mode="aspectFill" />
        <view class="fallback" wx:else>{{view.nickname[0] || '达'}}</view>
        <view>
          <view class="nick">{{view.nickname || '未公开'}}</view>
          <view class="account"><image src="{{view.platform === 'xhs' ? '/images/platforms/xiaohongshu.png' : '/images/platforms/douyin.png'}}" mode="aspectFill" />{{view.account || '未公开'}}</view>
          <text class="tag">公开主页</text>
        </view>
      </view>
      <view class="metrics">
        <view class="metric"><view class="ml"><text>粉丝</text></view><view class="mv">{{view.followersText || '未公开'}}</view></view>
        <view class="metric"><view class="ml"><text>签名</text></view><view class="mv">{{view.signature || '未公开'}}</view></view>
        <view class="metric">
          <view class="ml"><text>内容方向</text><text class="tag">{{view.platform === 'xhs' ? '豆包联网' : '抖音官方数据检索'}}</text></view>
          <view class="mv">{{view.direction || '未写到'}}</view>
          <view class="sales">
            <view class="ml"><text>{{view.platform === 'xhs' ? '近期篇均互动' : '近30天带货金额'}}</text></view>
            <view class="mv">{{view.platform === 'xhs' ? (view.engageText || '未公开') : (view.sales30d || '公开信息不足，暂不估算')}}</view>
          </view>
        </view>
        <view class="metric"><view class="ml"><text>近期内容</text><text class="tag">{{view.platform === 'xhs' ? '公开笔记' : '抖音官方数据检索'}}</text></view><view class="mv">{{view.recentText || '未写到'}}</view></view>
      </view>
      <view class="read">
        <view class="read-title">豆包AI助手解读</view>
        <view class="summary">{{view.summary}}</view>
      </view>
      <view class="clock">核对于 {{view.checkedAtLabel}} · 核验限于达人公开数据{{view.cached ? ' · 24小时内已查过，未再扣积分' : ''}}</view>
    </view>
    <view class="guides" wx:else>
      <view class="guide"><view class="gb">公开主页</view><view class="gs">{{platform === 'xhs' ? '昵称、小红书号、粉丝与简介，以该账号公开主页为准。' : '昵称、抖音号、粉丝与签名，以该账号公开主页为准。'}}</view></view>
      <view class="guide"><view class="gb">{{platform === 'xhs' ? '公开笔记' : '抖音官方数据检索'}}</view><view class="gs">{{platform === 'xhs' ? '近期笔记的赞、藏和篇均互动，按公开笔记计算。' : '内容方向与近期作品标题，依据抖音官方数据检索。'}}</view></view>
      <view class="guide"><view class="gb">核验口径</view><view class="gs">{{platform === 'xhs' ? '粉丝和互动用公开数据，解读由豆包联网完成，不改这些数字。' : '本次只核验达人公开数据，并由官方助手进行达人数据分析和评估。'}}</view></view>
    </view>
  </block>

  <block wx:else>
    <view class="batch">
      <button class="go" loading="{{busy}}" disabled="{{busy}}" bindtap="onPickSheet">上传表格</button>
      <button class="ghost" bindtap="onCopyHeader">复制表头</button>
      <view class="hint">第一列填抖音号。目前只能批量查验抖音，一次最多 30 个。</view>
      <view class="line {{item.state}}" wx:for="{{rows}}" wx:key="douyinId">{{item.nickname || item.douyinId}} · {{item.note}}</view>
      <button class="go" wx:if="{{rows.length}}" loading="{{busy}}" disabled="{{busy}}" bindtap="onBatch">开始批量查验</button>
    </view>
  </block>

  <view class="history">
    <view class="history-title">查验记录</view>
    <view class="history-empty" wx:if="{{!records.length}}">还没有查验记录。查完一个号后会留在这里，点开不重复扣积分。</view>
    <view class="history-item" wx:for="{{records}}" wx:key="account" data-index="{{index}}" bindtap="openRecord">
      <image class="history-avatar" wx:if="{{item.avatarUrl}}" src="{{item.avatarUrl}}" mode="aspectFill" />
      <view class="history-fallback" wx:else>{{item.nickname[0] || '达'}}</view>
      <view class="history-main">
        <view class="history-name">{{item.nickname || '未公开'}}</view>
        <view class="history-meta">{{item.account || '未公开'}} · 粉丝 {{item.followersText || '未公开'}} · {{item.platform === 'xhs' ? (item.engageText || '篇均未公开') : (item.sales30d || '暂不估算')}}</view>
      </view>
      <view class="history-time">{{item.checkedAtLabel}}</view>
    </view>
  </view>
</view>
