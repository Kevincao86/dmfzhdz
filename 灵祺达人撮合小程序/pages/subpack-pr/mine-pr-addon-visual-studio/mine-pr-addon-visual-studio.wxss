@import '../../../styles/mp-addon-page.wxss';

.vs-hero {
  margin: 0 0 8rpx;
  padding: 36rpx 32rpx 32rpx;
  background: linear-gradient(145deg, #6366f1 0%, #7c83ff 45%, #a78bfa 100%);
  border-radius: 0 0 36rpx 36rpx;
  box-shadow: 0 12rpx 36rpx rgba(99, 102, 241, 0.28);
}

.vs-hero__badge {
  display: inline-block;
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 600;
  color: #fff;
  background: rgba(255, 255, 255, 0.22);
  border: 1rpx solid rgba(255, 255, 255, 0.35);
}

.vs-hero__title {
  display: block;
  margin-top: 16rpx;
  font-size: 42rpx;
  font-weight: 800;
  color: #fff;
}

.vs-hero__sub {
  display: block;
  margin-top: 10rpx;
  font-size: 24rpx;
  line-height: 1.55;
  color: rgba(255, 255, 255, 0.9);
}

.vs-playbooks {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin-top: 8rpx;
}

.vs-playbook {
  padding: 22rpx 24rpx;
  border-radius: 16rpx;
  border: 2rpx solid #e2e8f0;
  background: #f8fafc;
}

.vs-playbook--on {
  border-color: #7c83ff;
  background: #eef2ff;
}

.vs-playbook__title {
  display: block;
  font-size: 30rpx;
  font-weight: 700;
  color: #1e293b;
}

.vs-playbook__desc {
  display: block;
  margin-top: 6rpx;
  font-size: 24rpx;
  color: #64748b;
}

.vs-copy-list {
  margin-top: 20rpx;
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.vs-copy {
  padding: 20rpx 22rpx;
  border-radius: 14rpx;
  border: 2rpx solid #e2e8f0;
  background: #fff;
}

.vs-copy--on {
  border-color: #7c83ff;
  background: #f5f3ff;
}

.vs-copy__h {
  display: block;
  font-size: 30rpx;
  font-weight: 700;
  color: #1e293b;
}

.vs-copy__s {
  display: block;
  margin-top: 6rpx;
  font-size: 24rpx;
  color: #64748b;
}

.vs-copy__o {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  font-weight: 600;
  color: #7c3aed;
}

.vs-ref {
  margin-top: 16rpx;
  height: 280rpx;
  border-radius: 16rpx;
  overflow: hidden;
  background: #f1f5f9;
  border: 2rpx dashed #cbd5e1;
}

.vs-ref__img {
  width: 100%;
  height: 100%;
}

.vs-ref__empty {
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #94a3b8;
  font-size: 26rpx;
}

.vs-progress {
  display: block;
  margin-top: 16rpx;
  font-size: 24rpx;
  color: #64748b;
}

.vs-err {
  display: block;
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #dc2626;
}

.vs-result {
  margin-top: 24rpx;
}

.vs-result__img {
  width: 100%;
  border-radius: 16rpx;
  background: #0f172a;
}

.vs-save-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 88rpx;
  line-height: 1.3;
  box-sizing: border-box;
}

.vs-save-btn--hover {
  opacity: 0.88;
}

.addon-pair {
  display: flex;
  gap: 16rpx;
  margin-top: 24rpx;
}

.addon-pair .addon-btn {
  flex: 1;
  margin-top: 0;
}
