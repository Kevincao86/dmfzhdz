<scroll-view class="addon-page addon-scroll {{lqThemeClass}}" scroll-y enhanced show-scrollbar="{{false}}">
  <view class="vs-hero">
    <text class="vs-hero__badge">灵祺视觉工坊</text>
    <text class="vs-hero__title">多端营销海报</text>
    <text class="vs-hero__sub">选渠道 · AI 文案 · 一键出图 · 保存相册（文案 {{copyPoints}} · 常规 {{imageStdPoints}} / 高级 {{imageProPoints}} 积分/张）</text>
  </view>

  <view class="addon-wizard">
    <view
      wx:for="{{wizardSteps}}"
      wx:key="n"
      class="addon-wizard__step {{step === item.n ? 'addon-wizard__step--on' : ''}}"
      data-step="{{item.n}}"
      bindtap="onStep"
    >{{item.n}}.{{item.label}}</view>
  </view>

  <!-- 1 渠道与业态 -->
  <view class="addon-card" wx:if="{{step === 1}}">
    <text class="addon-card__title">投放渠道</text>
    <text class="addon-card__sub">可多选，出图时按主渠道构图</text>
    <view class="addon-chips">
      <view
        wx:for="{{channels}}"
        wx:key="id"
        class="addon-chip {{item.on ? 'addon-chip--on' : ''}}"
        data-id="{{item.id}}"
        bindtap="onToggleChannel"
      >{{item.label}}</view>
    </view>
    <text class="addon-label">业态</text>
    <view class="addon-chips">
      <view
        wx:for="{{industries}}"
        wx:key="id"
        class="addon-chip {{industry === item.id ? 'addon-chip--on' : ''}}"
        data-id="{{item.id}}"
        bindtap="onIndustry"
      >{{item.label}}</view>
    </view>
    <text class="addon-label">门店 / 品牌名</text>
    <input class="addon-input" placeholder="如：灵祺小馆" value="{{storeName}}" bindinput="onStoreName" />
    <button class="addon-btn" bindtap="onNextStep">下一步：选玩法</button>
  </view>

  <!-- 2 玩法 -->
  <view class="addon-card" wx:elif="{{step === 2}}">
    <text class="addon-card__title">这次想做什么</text>
    <view class="vs-playbooks">
      <view
        wx:for="{{playbooks}}"
        wx:key="id"
        class="vs-playbook {{playbook === item.id ? 'vs-playbook--on' : ''}}"
        data-id="{{item.id}}"
        bindtap="onPlaybook"
      >
        <text class="vs-playbook__title">{{item.label}}</text>
        <text class="vs-playbook__desc">{{item.desc}}</text>
      </view>
    </view>
    <view class="addon-pair">
      <button class="addon-btn addon-btn--ghost" bindtap="onPrevStep">上一步</button>
      <button class="addon-btn" bindtap="onNextStep">下一步：文案</button>
    </view>
  </view>

  <!-- 3 文案 -->
  <view class="addon-card" wx:elif="{{step === 3}}">
    <text class="addon-card__title">海报文案</text>
    <text class="addon-card__sub">可手填，或用 AI 生成 3 套方案（{{copyPoints}} 积分/次）</text>
    <button class="addon-btn addon-btn--ghost" loading="{{copyBusy}}" bindtap="onAiCopy">AI 生成文案包</button>
    <view class="vs-copy-list" wx:if="{{copyItems.length}}">
      <view
        wx:for="{{copyItems}}"
        wx:key="index"
        class="vs-copy {{copyIndex === index ? 'vs-copy--on' : ''}}"
        data-index="{{index}}"
        bindtap="onPickCopy"
      >
        <text class="vs-copy__h">{{item.headline}}</text>
        <text class="vs-copy__s">{{item.subheadline}}</text>
        <text class="vs-copy__o" wx:if="{{item.offer}}">{{item.offer}}</text>
      </view>
    </view>
    <text class="addon-label">主标题</text>
    <input class="addon-input" value="{{headline}}" bindinput="onHeadline" maxlength="16" />
    <text class="addon-label">副标题</text>
    <input class="addon-input" value="{{subheadline}}" bindinput="onSubheadline" />
    <text class="addon-label">优惠信息</text>
    <input class="addon-input" value="{{offer}}" bindinput="onOffer" placeholder="如：¥99 双人餐" />
    <view class="addon-pair">
      <button class="addon-btn addon-btn--ghost" bindtap="onPrevStep">上一步</button>
      <button class="addon-btn" bindtap="onNextStep">下一步：出图</button>
    </view>
  </view>

  <!-- 4 出图 -->
  <view class="addon-card" wx:elif="{{step === 4}}">
    <text class="addon-card__title">生成海报</text>
    <text class="addon-card__sub">常规 {{imageStdPoints}} 积分/张 · 高级 GPT Image 2 {{imageProPoints}} 积分/张</text>
    <view class="addon-chips">
      <view class="addon-chip {{imageTier === 'standard' ? 'addon-chip--on' : ''}}" data-tier="standard" bindtap="onImageTier">常规生图 · 万相</view>
      <view class="addon-chip {{imageTier === 'pro' ? 'addon-chip--on' : ''}}" data-tier="pro" bindtap="onImageTier">高级生图 · GPT Image 2</view>
    </view>
    <text class="addon-card__sub" wx:if="{{imageTier === 'pro' && refPath}}">高级生图暂不使用参考图，将按文案纯文生图。</text>
    <view class="vs-ref" bindtap="onPickRef">
      <image wx:if="{{refPath}}" class="vs-ref__img" src="{{refPath}}" mode="aspectFill" />
      <view wx:else class="vs-ref__empty">
        <text>+ 参考图（可选，常规档）</text>
      </view>
    </view>
    <view class="addon-chips">
      <view class="addon-chip {{aspect === '3:4' ? 'addon-chip--on' : ''}}" data-val="3:4" bindtap="onAspect">竖版 3:4</view>
      <view class="addon-chip {{aspect === '1:1' ? 'addon-chip--on' : ''}}" data-val="1:1" bindtap="onAspect">方形 1:1</view>
      <view class="addon-chip {{aspect === '9:16' ? 'addon-chip--on' : ''}}" data-val="9:16" bindtap="onAspect">竖屏 9:16</view>
    </view>
    <button class="addon-btn" loading="{{genBusy}}" bindtap="onGenerate">一键出图（{{imagePoints}} 积分）</button>
    <text class="vs-progress" wx:if="{{progress}}">{{progress}}</text>
    <text class="vs-err" wx:if="{{err}}">{{err}}</text>
    <view class="vs-result" wx:if="{{resultUrl}}">
      <image
        class="vs-result__img"
        src="{{resultUrl}}"
        mode="widthFix"
        show-menu-by-longpress
        bindtap="onPreview"
      />
      <view class="addon-btn vs-save-btn" hover-class="vs-save-btn--hover" catchtap="onSaveAlbum">保存到相册</view>
      <view class="addon-btn addon-btn--ghost vs-save-btn" hover-class="vs-save-btn--hover" catchtap="onPreview">全屏预览</view>
    </view>
    <button class="addon-btn addon-btn--ghost" bindtap="onPrevStep">上一步</button>
  </view>

  <site-icp-footer></site-icp-footer>
</scroll-view>
