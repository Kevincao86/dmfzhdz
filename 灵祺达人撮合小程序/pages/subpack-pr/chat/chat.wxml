<view class="chat-page">
  <view class="chat-nav" style="{{navBarStyle}}">
    <view class="chat-nav-inner" style="{{navInnerStyle}}">
      <text class="chat-back" bindtap="onBack">‹</text>
      <image class="chat-nav-avatar" src="{{peerAvatar || '/images/logo.png'}}" mode="aspectFill" />
      <view class="chat-nav-meta">
        <text class="chat-nav-name">{{peerName}}</text>
        <text class="chat-nav-id" wx:if="{{peerId}}">{{peerId}}</text>
        <text class="chat-nav-sub">{{statusSub}}</text>
      </view>
    </view>
  </view>

  <scroll-view class="chat-scroll" scroll-y scroll-into-view="{{scrollTo}}" scroll-with-animation>
    <view
      wx:for="{{messages}}"
      wx:key="id"
      id="msg-{{item.id}}"
      class="bubble-row {{item.mine ? 'mine' : 'their'}}"
    >
      <image
        wx:if="{{!item.mine}}"
        class="bubble-avatar"
        src="{{peerAvatar || '/images/logo.png'}}"
        mode="aspectFill"
      />
      <view class="bubble {{item.mine ? 'bubble-mine' : 'bubble-their'}}">
        <block wx:if="{{item.kind === 'image'}}">
          <image
            class="chat-media"
            src="{{item.mediaUrl}}"
            mode="widthFix"
            bindtap="onPreviewImage"
            bindlongpress="onImageLongPress"
            data-url="{{item.mediaUrl}}"
          />
        </block>
        <block wx:elif="{{item.kind === 'audio'}}">
          <view class="chat-audio" bindtap="onPlayAudio" data-url="{{item.mediaUrl}}">
            <text>🎤 {{item.durationSec || 1}}″</text>
          </view>
        </block>
        <block wx:elif="{{item.kind === 'location'}}">
          <view class="chat-location" bindtap="onOpenLocation" data-lat="{{item.latitude}}" data-lng="{{item.longitude}}" data-name="{{item.locationName}}">
            <text>📍 {{item.locationName || '位置'}}</text>
          </view>
        </block>
        <block wx:elif="{{item.kind === 'file'}}">
          <view class="chat-file" bindtap="onOpenFile" data-url="{{item.mediaUrl}}">
            <text>📁 {{item.fileName || '文件'}}</text>
          </view>
        </block>
        <block wx:else>
          <text class="bubble-text">{{item.displayText || item.text}}</text>
        </block>
        <text class="bubble-at">{{item.at}}</text>
      </view>
      <image
        wx:if="{{item.mine}}"
        class="bubble-avatar"
        src="{{myAvatar || '/images/logo.png'}}"
        mode="aspectFill"
      />
    </view>
    <view class="chat-turn-empty" wx:if="{{ready && messages.length === 0}}">
      <text>{{turnHint}}</text>
    </view>
    <view class="scroll-pad"></view>
  </scroll-view>

  <view class="chat-composer">
    <view class="chat-turn-banner" wx:if="{{showTurnBanner}}">
      <text>{{sendHint}}</text>
    </view>
    <view class="composer-toolbar">
      <view
        class="toolbar-btn {{voiceMode ? 'toolbar-btn--keyboard' : 'toolbar-btn--voice'}}"
        bindtap="onToggleVoiceMode"
      ></view>
      <view class="composer-main">
        <input
          wx:if="{{!voiceMode}}"
          class="chat-input"
          placeholder="{{inputPlaceholder}}"
          value="{{input}}"
          bindinput="onInput"
          confirm-type="send"
          bindconfirm="onSend"
          disabled="{{!canSend}}"
        />
        <view
          wx:else
          class="voice-hold-btn {{recordingVoice ? 'voice-hold-btn--active' : ''}}"
          bindtouchstart="onVoiceTouchStart"
          bindtouchend="onVoiceTouchEnd"
          bindtouchcancel="onVoiceTouchEnd"
        >{{recordingVoice ? '松开 发送' : '按住 说话'}}</view>
      </view>
      <block wx:if="{{!voiceMode && !showSendBtn}}">
        <view class="toolbar-btn toolbar-btn--emoji {{showEmojiPanel ? 'toolbar-btn--active' : ''}}" bindtap="onToggleEmoji"></view>
        <view class="toolbar-btn toolbar-btn--plus {{showPlusPanel ? 'toolbar-btn--active' : ''}}" bindtap="onTogglePlus"></view>
      </block>
      <button wx:if="{{!voiceMode && showSendBtn}}" class="send-btn send-btn--compact" bindtap="onSend" disabled="{{!canSend}}">发送</button>
    </view>
    <view class="emoji-panel" wx:if="{{showEmojiPanel && canSend}}">
      <view class="emoji-tabs">
        <text class="emoji-tab {{emojiTab === 'default' ? 'emoji-tab--active' : ''}}" data-tab="default" bindtap="onEmojiTab">表情</text>
        <text class="emoji-tab {{emojiTab === 'custom' ? 'emoji-tab--active' : ''}}" data-tab="custom" bindtap="onEmojiTab">收藏</text>
      </view>
      <scroll-view wx:if="{{emojiTab === 'default'}}" class="emoji-scroll" scroll-y>
        <view class="emoji-grid">
          <text class="emoji-cell" wx:for="{{chatEmojis}}" wx:key="*this" data-emoji="{{item}}" bindtap="onPickEmoji">{{item}}</text>
        </view>
      </scroll-view>
      <scroll-view wx:else class="emoji-scroll" scroll-y>
        <view class="emoji-grid emoji-grid--custom">
          <view class="custom-emoji-add" bindtap="onAddCustomEmoji">
            <text class="custom-emoji-add-icon">＋</text>
          </view>
          <image
            class="custom-emoji-cell"
            wx:for="{{customEmojis}}"
            wx:key="id"
            src="{{item.url}}"
            mode="aspectFill"
            data-url="{{item.url}}"
            data-id="{{item.id}}"
            bindtap="onSendCustomEmoji"
            bindlongpress="onLongPressCustomEmoji"
          />
        </view>
      </scroll-view>
    </view>
    <view class="plus-panel" wx:if="{{showPlusPanel && canSend}}">
      <view class="plus-grid">
        <view class="plus-item" wx:for="{{plusActions}}" wx:key="id" data-id="{{item.id}}" bindtap="onPlusAction">
          <view class="plus-item-icon plus-icon {{item.iconClass}}"></view>
          <text class="plus-item-label">{{item.label}}</text>
        </view>
      </view>
    </view>
  </view>
</view>
