<view class="ogc-page chat-page">
  <view class="chat-nav" style="{{navBarStyle}}">
    <view class="chat-nav-inner" style="{{navInnerStyle}}">
      <text class="chat-back" bindtap="onBack">‹</text>
      <view class="chat-nav-meta">
        <text class="ogc-nav-title">{{groupTitle}}</text>
        <text class="ogc-nav-sub">{{memberCount}} 人 · {{statusSub}}</text>
      </view>
    </view>
  </view>

  <view class="ogc-closed-banner" wx:if="{{groupClosed}}">商单已完成超过 7 天，群聊已关闭（仅可查看历史消息）</view>

  <scroll-view class="chat-scroll" scroll-y scroll-into-view="{{scrollTo}}" scroll-with-animation>
    <view
      wx:for="{{messages}}"
      wx:key="id"
      id="msg-{{item.id}}"
      class="bubble-row {{item.mine ? 'mine' : 'their'}}"
    >
      <view class="bubble {{item.mine ? 'bubble-mine' : 'bubble-their'}}">
        <text wx:if="{{!item.mine}}" class="bubble-name">{{item.fromName}}</text>
        <block wx:if="{{item.type === 'image'}}">
          <image
            class="ogc-media"
            src="{{item.mediaUrl}}"
            mode="widthFix"
            bindtap="onPreviewImage"
            bindlongpress="onImageLongPress"
            data-url="{{item.mediaUrl}}"
          />
        </block>
        <block wx:elif="{{item.type === 'video'}}">
          <view class="ogc-video-cover" bindtap="onPlayVideo" data-url="{{item.mediaUrl}}">
            <video class="ogc-media" src="{{item.mediaUrl}}" controls="{{false}}" show-center-play-btn="{{false}}" object-fit="cover" />
            <text class="ogc-video-play">▶</text>
          </view>
        </block>
        <block wx:elif="{{item.type === 'audio'}}">
          <view class="ogc-audio" bindtap="onPlayAudio" data-url="{{item.mediaUrl}}">
            <text class="ogc-audio-icon">🎤</text>
            <text class="ogc-audio-dur">{{item.durationSec || 1}}″</text>
          </view>
        </block>
        <block wx:elif="{{item.type === 'location'}}">
          <view class="ogc-location" bindtap="onOpenLocation" data-lat="{{item.latitude}}" data-lng="{{item.longitude}}" data-name="{{item.locationName}}">
            <text class="ogc-location-icon">📍</text>
            <text class="ogc-location-name">{{item.locationName || '位置'}}</text>
          </view>
        </block>
        <block wx:elif="{{item.type === 'file'}}">
          <view class="ogc-file" bindtap="onOpenFile" data-url="{{item.mediaUrl}}">
            <text class="ogc-file-icon">📁</text>
            <text class="ogc-file-name">{{item.fileName || '文件'}}</text>
          </view>
        </block>
        <block wx:else>
          <text class="bubble-text">{{item.text}}</text>
        </block>
        <text class="bubble-at">{{item.at}}</text>
      </view>
    </view>
    <view class="chat-turn-empty" wx:if="{{ready && messages.length === 0}}">
      <text>发送消息开始协作，支持文字、语音、图片、位置与文件</text>
    </view>
    <view class="scroll-pad"></view>
  </scroll-view>

  <view class="chat-composer">
    <view class="composer-toolbar">
      <view
        class="toolbar-btn {{voiceMode ? 'toolbar-btn--keyboard' : 'toolbar-btn--voice'}}"
        bindtap="onToggleVoiceMode"
      ></view>
      <view class="composer-main">
        <input
          wx:if="{{!voiceMode}}"
          class="chat-input"
          placeholder="{{canSend ? '输入消息…' : '群聊已关闭'}}"
          value="{{input}}"
          bindinput="onInput"
          confirm-type="send"
          bindconfirm="onSend"
          disabled="{{!canSend}}"
        />
        <view
          wx:else
          class="voice-hold-btn {{recordingVoice ? 'voice-hold-btn--active' : ''}}"
          bindtouchstart="onVoiceTouchStart"
          bindtouchend="onVoiceTouchEnd"
          bindtouchcancel="onVoiceTouchEnd"
        >{{recordingVoice ? '松开 发送' : '按住 说话'}}</view>
      </view>
      <text wx:if="{{mentionMembers.length && !voiceMode && !showSendBtn}}" class="toolbar-at" bindtap="onMentionSomeone">@</text>
      <block wx:if="{{!voiceMode && !showSendBtn}}">
        <view class="toolbar-btn toolbar-btn--emoji {{showEmojiPanel ? 'toolbar-btn--active' : ''}}" bindtap="onToggleEmoji"></view>
        <view class="toolbar-btn toolbar-btn--plus {{showPlusPanel ? 'toolbar-btn--active' : ''}}" bindtap="onTogglePlus"></view>
      </block>
      <button wx:if="{{!voiceMode && showSendBtn}}" class="send-btn send-btn--compact" bindtap="onSend" disabled="{{!canSend}}">发送</button>
    </view>
    <view class="emoji-panel" wx:if="{{showEmojiPanel && canSend}}">
      <view class="emoji-tabs">
        <text class="emoji-tab {{emojiTab === 'default' ? 'emoji-tab--active' : ''}}" data-tab="default" bindtap="onEmojiTab">表情</text>
        <text class="emoji-tab {{emojiTab === 'custom' ? 'emoji-tab--active' : ''}}" data-tab="custom" bindtap="onEmojiTab">收藏</text>
      </view>
      <scroll-view wx:if="{{emojiTab === 'default'}}" class="emoji-scroll" scroll-y>
        <view class="emoji-grid">
          <text class="emoji-cell" wx:for="{{chatEmojis}}" wx:key="*this" data-emoji="{{item}}" bindtap="onPickEmoji">{{item}}</text>
        </view>
      </scroll-view>
      <scroll-view wx:else class="emoji-scroll" scroll-y>
        <view class="emoji-grid emoji-grid--custom">
          <view class="custom-emoji-add" bindtap="onAddCustomEmoji">
            <text class="custom-emoji-add-icon">＋</text>
          </view>
          <image
            class="custom-emoji-cell"
            wx:for="{{customEmojis}}"
            wx:key="id"
            src="{{item.url}}"
            mode="aspectFill"
            data-url="{{item.url}}"
            data-id="{{item.id}}"
            bindtap="onSendCustomEmoji"
            bindlongpress="onLongPressCustomEmoji"
          />
        </view>
      </scroll-view>
    </view>
    <view class="mention-panel" wx:if="{{showMentionPanel && canSend}}">
      <view class="mention-panel-head">
        <input
          class="mention-search"
          placeholder="搜索群成员"
          value="{{mentionSearchQ}}"
          bindinput="onMentionSearch"
          focus="{{showMentionPanel}}"
        />
        <text class="mention-close" bindtap="onCloseMentionPanel">取消</text>
      </view>
      <scroll-view class="mention-scroll" scroll-y>
        <view class="mention-item" bindtap="onPickMentionMember" data-all="1">@全体成员</view>
        <view
          class="mention-item"
          wx:for="{{filteredMentionMembers}}"
          wx:key="key"
          bindtap="onPickMentionMember"
          data-key="{{item.key}}"
          data-name="{{item.name}}"
        >@{{item.name}}</view>
        <view class="mention-empty" wx:if="{{mentionSearchQ && !filteredMentionMembers.length}}">未找到成员</view>
      </scroll-view>
    </view>
    <view class="plus-panel" wx:if="{{showPlusPanel && canSend}}">
      <view class="plus-grid">
        <view class="plus-item" wx:for="{{plusActions}}" wx:key="id" data-id="{{item.id}}" bindtap="onPlusAction">
          <view class="plus-item-icon plus-icon {{item.iconClass}}"></view>
          <text class="plus-item-label">{{item.label}}</text>
        </view>
      </view>
    </view>
  </view>
</view>
