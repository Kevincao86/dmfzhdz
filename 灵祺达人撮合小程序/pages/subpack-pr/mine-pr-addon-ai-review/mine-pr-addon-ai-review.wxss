@import '../../../styles/identity-themes.wxss';
@import '../mine-pr-order-script-review/mine-pr-order-script-review.wxss';

.acr-page { padding-bottom: 32rpx; }
.acr-head .acr-sub { display: block; margin-top: 8rpx; }
.acr-tabs { display: flex; flex-wrap: wrap; gap: 12rpx; margin-bottom: 8rpx; }
.acr-tab { font-size: 26rpx; padding: 12rpx 20rpx; border-radius: 12rpx; border: 1rpx solid rgba(99,102,241,.2); color: #64748b; }
.acr-tab--active { background: #7c3aed; color: #fff; border-color: #7c3aed; }
.acr-toolbar { display: flex; flex-wrap: wrap; gap: 12rpx; align-items: center; }
.acr-picker { font-size: 26rpx; color: #334155; padding: 12rpx 16rpx; border: 1rpx solid rgba(99,102,241,.2); border-radius: 12rpx; }
.acr-link-row { display: flex; flex-wrap: wrap; gap: 12rpx; align-items: center; }
.acr-link-input { flex: 1; min-width: 280rpx; font-size: 26rpx; padding: 12rpx 16rpx; border: 1rpx solid rgba(99,102,241,.2); border-radius: 12rpx; }
.acr-btn { font-size: 26rpx; padding: 12rpx 20rpx; border-radius: 12rpx; text-align: center; }
.acr-btn--primary { background: #7c3aed; color: #fff; }
.acr-btn--ai { background: #ecfdf5; color: #047857; border: 1rpx solid rgba(16,185,129,.35); }
.acr-btn--ghost { border: 1rpx solid rgba(100,116,139,.25); color: #64748b; }
.acr-btn--sm { font-size: 24rpx; padding: 8rpx 16rpx; }
.acr-btn--disabled { opacity: .55; }
.acr-card-head { display: flex; justify-content: space-between; gap: 16rpx; }
.acr-card-info { flex: 1; min-width: 0; }
.acr-label { font-size: 28rpx; font-weight: 600; word-break: break-all; }
.acr-link { display: block; margin-top: 8rpx; color: #7c3aed; word-break: break-all; }
.acr-detail { display: block; margin-top: 8rpx; }
.acr-card-side { display: flex; flex-direction: column; align-items: flex-end; gap: 8rpx; max-width: 48%; }
.acr-actions { display: flex; gap: 8rpx; flex-wrap: wrap; justify-content: flex-end; }
