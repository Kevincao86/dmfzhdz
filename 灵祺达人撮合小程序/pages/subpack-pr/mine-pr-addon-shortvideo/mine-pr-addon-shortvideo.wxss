@import '../../../styles/mp-addon-page.wxss';

.addon-pair button.addon-btn--ghost,
.addon-pick-btn {
  margin: 0;
  flex: 1;
  font-size: 24rpx;
  padding: 16rpx 8rpx;
  line-height: 1.4;
  box-sizing: border-box;
}

.addon-pick-btn::after {
  border: none;
}

.imitate-shot {
  margin-top: 16rpx;
  padding: 16rpx;
  border-radius: 16rpx;
  background: rgba(255, 255, 255, 0.72);
}

.imitate-shot__head {
  display: flex;
  gap: 20rpx;
  margin-bottom: 8rpx;
  font-size: 24rpx;
  color: #0e7490;
}

.imitate-input {
  width: 100%;
  margin-top: 8rpx;
  padding: 12rpx 16rpx;
  box-sizing: border-box;
  border-radius: 12rpx;
  background: #fff;
  font-size: 26rpx;
}

.imitate-avatars {
  white-space: nowrap;
  margin: 12rpx 0;
}

.imitate-avatar {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  width: 120rpx;
  margin-right: 12rpx;
  font-size: 22rpx;
  color: #475569;
}

.imitate-avatar--on .imitate-avatar__img {
  border-color: #0891b2;
}

.imitate-avatar__img {
  width: 96rpx;
  height: 128rpx;
  border-radius: 12rpx;
  border: 4rpx solid transparent;
}
