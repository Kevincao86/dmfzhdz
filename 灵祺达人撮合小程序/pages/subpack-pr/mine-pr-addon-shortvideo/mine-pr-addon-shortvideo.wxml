<page-meta page-style="{{lqPageStyle}}" background-color="{{lqPageBg}}" background-color-top="{{lqNavBg}}" background-color-bottom="{{lqPageBg}}" />
<scroll-view class="{{lqAccentClass}} addon-page addon-scroll {{lqThemeClass}} foot-col" scroll-y enhanced show-scrollbar="{{false}}" enable-flex style="{{lqPageStyle}}">
  <view class="addon-mini-hero addon-mini-hero--violet">
    <text class="addon-mini-hero__title">短视频 AI 处理</text>
    <text class="addon-mini-hero__sub">短视频生成 · 模仿视频 · AI 混剪</text>
  </view>
  <view class="addon-tabs">
    <view
      class="addon-tab {{mainPane === 'generate' ? 'addon-tab--on' : ''}} {{!showShortvideo ? 'addon-tab--locked' : ''}}"
      data-pane="generate"
      bindtap="onPane"
    >短视频生成{{!showShortvideo ? ' · 需升级' : ''}}</view>
    <view
      class="addon-tab {{mainPane === 'cloud' ? 'addon-tab--on' : ''}} {{!showCloudEdit ? 'addon-tab--locked' : ''}}"
      data-pane="cloud"
      bindtap="onPane"
    >AI 混剪{{!showCloudEdit ? ' · 需升级' : ''}}</view>
  </view>

  <block wx:if="{{mainPane === 'generate' && showShortvideo}}">
    <view class="addon-chips" style="margin-bottom:16rpx">
      <view class="addon-chip {{genKind !== 'imitate' ? 'addon-chip--on' : ''}}" data-kind="text" bindtap="onGenKind">文生视频</view>
      <view class="addon-chip {{genKind === 'imitate' ? 'addon-chip--on' : ''}}" data-kind="imitate" bindtap="onGenKind">模仿视频</view>
    </view>
    <block wx:if="{{genKind !== 'imitate'}}">
    <view class="addon-card">
      <text class="addon-card__title">视频 AI 引擎</text>
      <text class="addon-card__sub">即梦 / Seedance（与星选平台同源）</text>
      <view class="addon-points-tip">{{pointsHintGenerate}}</view>
      <view class="addon-pair" style="margin-bottom:12px">
        <view class="addon-pair__opt {{longformEnabled ? 'addon-pair__opt--on' : ''}}" data-on="1" bindtap="onLongformMode">长视频 · 目标总时长</view>
        <view class="addon-pair__opt {{!longformEnabled ? 'addon-pair__opt--on' : ''}}" data-on="0" bindtap="onLongformMode">短片 · 单段时长</view>
      </view>
      <text class="addon-label">{{longformEnabled ? '目标总时长' : '单段时长'}}</text>
      <view class="addon-chips">
        <view
          wx:for="{{durationOptions}}"
          wx:key="*this"
          class="addon-chip {{durationSec === item ? 'addon-chip--on' : ''}}"
          data-val="{{item}}"
          bindtap="onDuration"
        >{{item}} 秒</view>
      </view>
      <text class="addon-label">画面比例</text>
      <view class="addon-chips">
        <view class="addon-chip {{aspect === '9:16' ? 'addon-chip--on' : ''}}" data-val="9:16" bindtap="onAspect">9:16</view>
        <view class="addon-chip {{aspect === '16:9' ? 'addon-chip--on' : ''}}" data-val="16:9" bindtap="onAspect">16:9</view>
        <view class="addon-chip {{aspect === '1:1' ? 'addon-chip--on' : ''}}" data-val="1:1" bindtap="onAspect">1:1</view>
      </view>
    </view>

    <view class="addon-card">
      <text class="addon-card__title">文生 / 图生视频</text>
      <button
        class="addon-btn addon-btn--ghost addon-pick-btn"
        bindtap="onPickRefImage"
      >可选：上传参考图</button>
      <image wx:if="{{framePath}}" class="addon-thumb" src="{{framePath}}" mode="aspectFill" />
      <textarea class="addon-textarea" placeholder="描述场景、主体、镜头与风格" value="{{genPrompt}}" bindinput="onGenPrompt" maxlength="800" />
      <text class="addon-err" wx:if="{{err}}">{{err}}</text>
      <text class="addon-progress" wx:if="{{progress}}">{{progress}}</text>
      <button class="addon-btn" loading="{{busy}}" disabled="{{busy}}" bindtap="onGenerate">开始生成</button>
      <video wx:if="{{resultUrl}}" class="addon-video" src="{{resultUrl}}" controls />
      <button wx:if="{{resultUrl}}" class="addon-btn addon-btn--ghost" bindtap="onSaveVideo">保存到相册</button>
    </view>
    </block>
    <view class="addon-card" wx:else>
      <text class="addon-card__title">模仿视频</text>
      <text class="addon-card__sub">拆解后可以直接开始模仿，按镜头生成成片。要按原片换人，再上传 1 分钟内的视频。</text>
      <view class="addon-points-tip">{{pointsHintGenerate}}</view>
      <text class="addon-label">分享链接（可选）</text>
      <textarea class="addon-textarea addon-textarea--sm" placeholder="粘贴分享文案，用来整理画面、口播、背景音" value="{{imitateLink}}" bindinput="onImitateLink" maxlength="500" />
      <button class="addon-btn addon-btn--ghost" bindtap="onPickImitateVideo">{{imitateVideoName || '上传参考视频（换人才需要，1 分钟内）'}}</button>
      <text class="addon-card__sub" wx:if="{{imitateNote}}">{{imitateNote}}</text>
      <view class="imitate-actions">
        <button class="addon-btn addon-btn--ghost" loading="{{busy}}" disabled="{{busy}}" bindtap="onImitateAnalyze">拆解画面 / 口播 / 背景音</button>
        <button class="addon-btn addon-btn--ghost" loading="{{busy}}" disabled="{{busy}}" bindtap="onImitateRewrite">AI 改写口播 / 动作</button>
      </view>
      <view wx:for="{{imitateShots}}" wx:key="id" class="imitate-shot">
        <view class="imitate-shot__head">
          <text>镜头 {{index + 1}}</text>
          <text data-id="{{item.id}}" data-dir="-1" bindtap="onMoveShot">上移</text>
          <text data-id="{{item.id}}" data-dir="1" bindtap="onMoveShot">下移</text>
          <text data-id="{{item.id}}" bindtap="onRemoveShot">删除</text>
        </view>
        <input class="imitate-input" value="{{item.visual}}" data-id="{{item.id}}" data-field="visual" bindinput="onShotField" placeholder="画面" />
        <input class="imitate-input" value="{{item.action}}" data-id="{{item.id}}" data-field="action" bindinput="onShotField" placeholder="动作" />
        <textarea class="addon-textarea addon-textarea--sm" value="{{item.speech}}" data-id="{{item.id}}" data-field="speech" bindinput="onShotField" placeholder="口播" maxlength="200" />
        <view class="addon-chip {{item.hasBgm ? 'addon-chip--on' : ''}}" data-id="{{item.id}}" bindtap="onToggleShotBgm">背景音</view>
      </view>
      <text class="addon-label">人物</text>
      <view class="addon-chips">
        <view class="addon-chip {{characterMode === 'preset' ? 'addon-chip--on' : ''}}" data-mode="preset" bindtap="onCharacterMode">系统人物</view>
        <view class="addon-chip {{characterMode === 'upload' ? 'addon-chip--on' : ''}}" data-mode="upload" bindtap="onCharacterMode">上传全身照</view>
      </view>
      <scroll-view wx:if="{{characterMode === 'preset'}}" scroll-x class="imitate-avatars" enhanced show-scrollbar="{{false}}">
        <view
          wx:for="{{imitateAvatars}}"
          wx:key="id"
          class="imitate-avatar {{presetId === item.id ? 'imitate-avatar--on' : ''}}"
          data-id="{{item.id}}"
          bindtap="onPreset"
        >
          <image class="imitate-avatar__img" src="{{item.url}}" mode="aspectFill" />
          <text>{{item.name}}</text>
        </view>
      </scroll-view>
      <block wx:else>
        <button class="addon-btn addon-btn--ghost" bindtap="onPickImitatePhoto">{{photoPath ? '更换全身照' : '上传全身照'}}</button>
        <image wx:if="{{photoPath}}" class="addon-thumb" src="{{photoPath}}" mode="aspectFill" />
      </block>
      <text class="addon-label">声音</text>
      <view class="addon-chips">
        <view class="addon-chip {{voiceMode === 'keep' ? 'addon-chip--on' : ''}}" data-mode="keep" bindtap="onVoiceMode">原片人声</view>
        <view class="addon-chip {{voiceMode === 'preset' ? 'addon-chip--on' : ''}}" data-mode="preset" bindtap="onVoiceMode">系统音色</view>
        <view class="addon-chip {{voiceMode === 'clone' ? 'addon-chip--on' : ''}}" data-mode="clone" bindtap="onVoiceMode">模仿我的声音</view>
      </view>
      <view class="addon-chips" wx:if="{{voiceMode === 'preset'}}">
        <view
          wx:for="{{imitateVoices}}"
          wx:key="id"
          class="addon-chip {{voiceId === item.id ? 'addon-chip--on' : ''}}"
          data-id="{{item.id}}"
          bindtap="onVoicePreset"
        >{{item.label}}</view>
      </view>
      <button wx:if="{{voiceMode === 'clone'}}" class="addon-btn addon-btn--ghost" bindtap="onPickVoice">{{voiceName || '上传清晰人声'}}</button>
      <text class="addon-label">背景乐</text>
      <view class="addon-chips">
        <view class="addon-chip {{bgmMode === 'keep' ? 'addon-chip--on' : ''}}" data-mode="keep" bindtap="onBgmMode">沿用原片</view>
        <view class="addon-chip {{bgmMode === 'custom' ? 'addon-chip--on' : ''}}" data-mode="custom" bindtap="onBgmMode">自己的音乐</view>
      </view>
      <block wx:if="{{bgmMode === 'custom'}}">
        <text class="addon-card__sub">小程序按整段混入。要裁开头、接多段，或保留原片人声再配乐，请用星选网页。</text>
        <button class="addon-btn addon-btn--ghost" bindtap="onPickBgm">{{bgmName || '上传一段音乐'}}</button>
      </block>
      <text class="addon-err" wx:if="{{err}}">{{err}}</text>
      <text class="addon-progress" wx:if="{{progress}}">{{progress}}</text>
      <button class="addon-btn" loading="{{busy}}" disabled="{{busy}}" bindtap="onImitateGenerate">开始模仿</button>
      <video wx:if="{{resultUrl}}" class="addon-video" src="{{resultUrl}}" controls />
      <button wx:if="{{resultUrl}}" class="addon-btn addon-btn--ghost" bindtap="onSaveVideo">保存到相册</button>
    </view>
  </block>

  <view class="addon-card" wx:elif="{{mainPane === 'generate' && !showShortvideo}}">
    <text class="addon-card__title">短视频生成未开通</text>
    <text class="addon-card__sub">请升级至含「短视频 AI 处理」的会员档位后使用。</text>
    <button class="addon-btn" data-pane="generate" bindtap="onPane">查看升级说明</button>
  </view>

  <block wx:elif="{{mainPane === 'cloud' && showCloudEdit}}">
    <view class="addon-card">
      <text class="addon-card__title">AI 混剪</text>
      <text class="addon-card__sub">批量上传素材、AI 文案指令、一键成片（与星选平台同源）</text>
      <view class="addon-points-tip">{{pointsHintMix}}</view>
      <view class="addon-warn" wx:if="{{!iceConfigured}}">云剪还没开通，请联系客服开通后再使用。</view>
      <view class="addon-tabs addon-tabs--inner">
        <view class="addon-tab {{materialTab === 'video' ? 'addon-tab--on' : ''}}" data-tab="video" bindtap="onMaterialTab">视频队列</view>
        <view class="addon-tab {{materialTab === 'images' ? 'addon-tab--on' : ''}}" data-tab="images" bindtap="onMaterialTab">多图成片</view>
      </view>
      <block wx:if="{{materialTab === 'video'}}">
        <view class="addon-pair">
          <button
            class="addon-btn addon-btn--ghost addon-pick-btn"
            bindtap="onUploadIceVideo"
          >批量上传视频</button>
        </view>
        <textarea class="addon-textarea addon-textarea--sm" placeholder="也可粘贴视频链接，多条用换行分隔" value="{{urlText}}" bindinput="onUrlText" />
        <button class="addon-btn addon-btn--ghost" bindtap="onAddVideoUrls">加入队列</button>
        <view wx:for="{{videoJobs}}" wx:key="id" class="addon-job-row">
          <view class="addon-job-row__head">
            <image wx:if="{{item.thumb}}" class="addon-job-row__thumb" src="{{item.thumb}}" mode="aspectFill" />
            <text class="addon-job-row__title">{{item.label}}</text>
          </view>
          <button class="addon-out__btn" data-id="{{item.id}}" bindtap="onRemoveJob">移除</button>
        </view>
      </block>
      <block wx:else>
        <view class="addon-pair">
          <button
            class="addon-btn addon-btn--ghost addon-pick-btn"
            bindtap="onUploadIceImage"
          >上传图片</button>
        </view>
        <textarea class="addon-textarea addon-textarea--sm" placeholder="也可粘贴图片链接" value="{{imageUrlText}}" bindinput="onImageUrlText" />
        <button class="addon-btn addon-btn--ghost" bindtap="onAddImageUrls">加入图片列表</button>
        <view class="addon-avatar-grid">
          <view wx:for="{{imageItems}}" wx:key="id" class="addon-avatar">
            <image class="addon-avatar__img" src="{{item.previewUrl || item.mediaUrl}}" mode="aspectFill" />
            <text class="addon-avatar__name">{{item.label}}</text>
            <button class="addon-out__btn" data-id="{{item.id}}" bindtap="onRemoveImage">移除</button>
          </view>
        </view>
      </block>
    </view>

    <view class="addon-card">
      <text class="addon-card__title">剪辑文案与指令</text>
      <text class="addon-label">上屏字幕文案</text>
      <textarea class="addon-textarea addon-textarea--sm" placeholder="4-20 字短句，多条换行" value="{{editCopy}}" bindinput="onEditCopy" />
      <text class="addon-label">剪辑操作指令</text>
      <textarea class="addon-textarea addon-textarea--sm" placeholder="BGM、节奏、转场、色调等" value="{{editInstruction}}" bindinput="onEditInstruction" />
      <button class="addon-btn addon-btn--ghost" loading="{{briefAiBusy}}" disabled="{{briefAiBusy || iceBusy}}" bindtap="onAiIceBrief">AI 生成文案与指令</button>
      <text class="addon-label">画幅</text>
      <view class="addon-chips">
        <view wx:for="{{['9:16','16:9','1:1']}}" wx:key="*this" class="addon-chip {{iceAspectId === item ? 'addon-chip--on' : ''}}" data-id="{{item}}" bindtap="onIceAspect">{{item}}</view>
      </view>
      <text class="addon-label">目标总时长（秒）</text>
      <view class="addon-chips">
        <view
          wx:for="{{mixTargetOptions}}"
          wx:key="*this"
          class="addon-chip {{clipEndSec === item ? 'addon-chip--on' : ''}}"
          data-val="{{item}}"
          bindtap="onClipEnd"
        >{{item}}</view>
      </view>
      <text class="addon-label">画面特效</text>
      <view class="addon-chips">
        <view wx:for="{{icePresets}}" wx:key="*this" class="addon-chip {{icePreset === item ? 'addon-chip--on' : ''}}" data-val="{{item}}" bindtap="onIcePreset">{{item}}</view>
      </view>
      <view class="addon-pair" wx:if="{{materialTab === 'video'}}">
        <view class="addon-pair__opt {{batchEnabled ? 'addon-pair__opt--on' : ''}}" bindtap="onBatchToggle">批量生成</view>
      </view>
      <view class="addon-chips" wx:if="{{batchEnabled && materialTab === 'video'}}">
        <view wx:for="{{[10,20,50,100]}}" wx:key="*this" class="addon-chip {{batchCount === item ? 'addon-chip--on' : ''}}" data-val="{{item}}" bindtap="onBatchCount">{{item}} 条</view>
      </view>
      <text class="addon-err" wx:if="{{iceErr}}">{{iceErr}}</text>
      <text class="addon-progress" wx:if="{{iceProgress}}">{{iceProgress}}</text>
      <button class="addon-btn" loading="{{iceBusy}}" disabled="{{iceBusy || !iceConfigured}}" bindtap="onSubmitIce">开始混剪</button>
      <video wx:if="{{iceResultUrl}}" class="addon-video" src="{{iceResultUrl}}" controls />
      <button wx:if="{{iceResultUrl}}" class="addon-btn addon-btn--ghost" bindtap="onSaveVideo">保存到相册</button>
    </view>
  </block>
  <site-icp-footer />
</scroll-view>
