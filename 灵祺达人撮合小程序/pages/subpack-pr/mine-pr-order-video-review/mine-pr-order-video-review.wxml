<view class="vr-page page-shell {{lqThemeClass}}">
  <view class="card vr-head">
    <text class="title-lg">{{reviewLabel}}</text>
    <text class="hint vr-sub">{{isIceOrder ? '云剪单达人抖音链接审核' : '达人成片审核，通过或驳回后将自动通知达人、拍摄与剪辑。'}}</text>
    <view class="vr-back" bindtap="onBackList">{{backLabel}}</view>
  </view>

  <view class="vr-stats">
    <view class="vr-stat">
      <text class="vr-stat-num">{{stats.pending}}</text>
      <text class="vr-stat-label">待审核</text>
    </view>
    <view class="vr-stat">
      <text class="vr-stat-num">{{stats.passed}}</text>
      <text class="vr-stat-label">已通过</text>
    </view>
    <view class="vr-stat">
      <text class="vr-stat-num">{{stats.rejected}}</text>
      <text class="vr-stat-label">已驳回</text>
    </view>
    <view class="vr-stat">
      <text class="vr-stat-num">{{stats.total}}</text>
      <text class="vr-stat-label">总{{itemLabel}}</text>
    </view>
  </view>

  <view wx:if="{{!isIceOrder && !readOnly}}" class="card vr-share">
    <view class="vr-share-head">
      <view class="vr-share-head__icon">🔗</view>
      <view class="vr-share-head__text">
        <text class="title-lg">分享审片</text>
        <text class="hint">生成小程序审片链接，客户打开后可看视频并填写备注（与 Web 端数据同步）</text>
      </view>
    </view>
    <view class="vr-share-actions">
      <image
        wx:if="{{reviewSharePosterUrl}}"
        class="vr-share-poster-preview"
        src="{{reviewSharePosterUrl}}"
        mode="widthFix"
        show-menu-by-longpress="{{true}}"
      />
      <view
        class="vr-share-primary {{shareBusy ? 'vr-share-primary--busy' : ''}}"
        catchtap="onCreateShare"
      >
        <text class="vr-share-primary__icon">{{shareBusy ? '⏳' : '📋'}}</text>
        <text class="vr-share-primary__label">{{shareBusy ? '生成中…' : (shareUrl ? '重新生成并复制' : '生成并复制小程序链接')}}</text>
      </view>
      <view wx:if="{{shareUrl}}" class="vr-share-secondary-row">
        <view class="vr-share-secondary" catchtap="onCopyShareUrl">复制小程序链接</view>
        <button class="vr-share-secondary vr-share-secondary--btn" open-type="share">转发审片卡片</button>
        <view class="vr-share-secondary vr-share-secondary--danger" catchtap="onRevokeShare">失效链接</view>
      </view>
    </view>
    <view wx:if="{{shareUrl}}" class="vr-share-url">
      <text class="vr-share-url__label">当前小程序分享链接</text>
      <text class="vr-share-url__text">{{shareUrl}}</text>
      <text wx:if="{{shareExpiresAt}}" class="hint vr-share-exp">有效至 {{shareExpiresAt}}</text>
    </view>
  </view>

  <view
    wx:if="{{!isIceOrder && !readOnly && batchAiTargetCount > 0}}"
    class="card vr-batch-ai"
  >
    <view
      class="vr-btn vr-btn--ai vr-btn--batch {{batchAiCheckBusy ? 'vr-btn--disabled' : ''}}"
      catchtap="onBatchAiCheck"
    >
      {{batchAiCheckBusy ? '批量检核中…' : 'AI批量检核（' + batchAiTargetCount + '）'}}
    </view>
  </view>

  <view wx:if="{{loading}}" class="card"><text class="hint">加载中…</text></view>
  <view wx:if="{{err}}" class="card"><text class="hint">{{err}}</text></view>

  <view wx:if="{{!loading && !cards.length && !err}}" class="card state-empty">
    <text class="hint">暂无达人上传视频。达人可在「我的报名」中上传成片。</text>
  </view>

  <view
    wx:for="{{cards}}"
    wx:key="id"
    class="card vr-card {{item.previewOpen ? 'vr-card--active' : ''}}"
  >
    <view class="vr-card-head">
      <view class="vr-card-info">
        <text class="title-lg">{{item.displayName}}<text wx:if="{{item.talentMeta}}" class="vr-talent-meta"> {{item.talentMeta}}</text></text>
        <text class="hint vr-meta">
          提交于 {{item.videoSubmittedAt || '—'}} · {{item.submitCountLabel}} · {{item.videoStatusLabel}}
        </text>
      </view>
      <view class="vr-card-side">
        <text wx:if="{{item.aiCheckStatusText}}" class="vr-ai-status vr-ai-status--{{item.aiCheckStatusTone}}">{{item.aiCheckStatusText}}</text>
        <text class="vr-status vr-status--{{item.videoStatus}}">{{item.videoStatusLabel}}</text>
      </view>
    </view>

    <text wx:if="{{item.videoRejectReason}}" class="vr-reject">驳回原因：{{item.videoRejectReason}}</text>

    <view class="vr-actions">
      <view class="vr-btn" data-id="{{item.id}}" catchtap="onTogglePreview">
        {{item.isIceLink ? '打开链接' : (item.previewOpen ? '收起预览' : '视频预览')}}
      </view>
      <view wx:if="{{!item.isIceLink}}" class="vr-btn" data-id="{{item.id}}" catchtap="onDownload">
        {{downloadingId === item.id ? '下载中…' : '下载'}}
      </view>
      <view
        wx:if="{{!item.isIceLink && !readOnly}}"
        class="vr-btn vr-btn--ai"
        data-id="{{item.id}}"
        catchtap="onAiCheck"
      >
        AI检核
      </view>
    </view>

    <view wx:if="{{item.videoStatus === 'passed' && !isIceOrder}}" class="vr-publish">
      <text class="vr-publish__label">平台发布链接</text>
      <text class="vr-publish__status">{{item.publishLinkLabel}}</text>
      <text wx:if="{{item.publishUrl}}" class="vr-publish__url">{{item.publishUrl}}</text>
    </view>

    <view wx:if="{{item.previewOpen}}" class="vr-preview">
      <video
        class="vr-video"
        src="{{item.videoUrl}}"
        controls
        show-center-play-btn
        object-fit="contain"
      />
    </view>

    <view wx:if="{{item.shareFeedback && item.shareFeedback.length}}" class="vr-share-feedback">
      <text class="vr-share-feedback__title">外部分享反馈（{{item.shareFeedback.length}}）</text>
      <view wx:for="{{item.shareFeedback}}" wx:for-item="fb" wx:key="id" class="vr-share-feedback__item">
        <text wx:if="{{fb.frameTimeLabel}}" class="vr-share-tag">{{fb.frameTimeLabel}}</text>
        <text>{{fb.visitorName}} · {{fb.createdAt}}</text>
        <text class="vr-share-feedback__text">{{fb.commentText}}</text>
      </view>
    </view>

    <view wx:if="{{item.videoStatus === 'pending' && !readOnly}}" class="vr-review-actions">
      <button
        class="vr-pass"
        size="mini"
        plain
        disabled="{{busyId === item.id}}"
        data-id="{{item.id}}"
        catchtap="onPass"
      >通过</button>
      <button
        class="vr-reject-btn"
        size="mini"
        plain
        disabled="{{busyId === item.id}}"
        data-id="{{item.id}}"
        catchtap="onOpenReject"
      >驳回</button>
    </view>
  </view>

  <view wx:if="{{rejectModal}}" class="vr-modal-mask" catchtap="onCloseReject">
    <view class="vr-modal" catchtap="stopBubble">
      <text class="title-lg">驳回{{isIceOrder ? '链接' : '视频'}} · {{rejectTargetName}}</text>
      <text class="hint vr-modal-hint">请填写驳回原因，达人将收到通知并可在「我的报名」重新上传。</text>
      <textarea
        class="vr-textarea"
        placeholder="请输入驳回原因"
        value="{{rejectReason}}"
        bindinput="onRejectReasonInput"
        maxlength="200"
      />
      <view class="vr-modal-actions">
        <button size="mini" plain catchtap="onCloseReject">取消</button>
        <button
          size="mini"
          class="vr-reject-btn"
          plain
          disabled="{{!rejectReason || busyId === rejectTargetId}}"
          catchtap="onConfirmReject"
        >确认驳回</button>
      </view>
    </view>
  </view>
</view>
