@import '../../../styles/mp-addon-page.wxss';
@import '../../../styles/mp-addon-hero.wxss';

.addon-page--brief {
  min-height: 100vh;
  padding-bottom: calc(120rpx + env(safe-area-inset-bottom));
}

.addon-card--result {
  margin-bottom: 32rpx;
}

.addon-card--result .addon-out {
  max-height: none;
  overflow: visible;
}

.addon-brief-block--full .addon-brief-block__text {
  max-height: none;
}

.addon-record-body .addon-brief-block__text {
  max-height: none;
}

.addon-progress {
  display: block;
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #4f46e5;
}

.addon-btn--accent {
  background: linear-gradient(135deg, #059669, #10b981);
}

.addon-out--sections {
  margin-top: 24rpx;
}

.addon-brief-actions {
  margin-bottom: 16rpx;
}

.addon-brief-block {
  margin-top: 20rpx;
  padding: 20rpx;
  border-radius: 16rpx;
  background: #f8fafc;
  border: 1rpx solid #e2e8f0;
}

.addon-brief-block__title {
  display: block;
  font-size: 26rpx;
  font-weight: 700;
  color: #0f172a;
  margin-bottom: 12rpx;
}

.addon-brief-block__text {
  display: block;
  font-size: 24rpx;
  line-height: 1.75;
  color: #334155;
  white-space: pre-wrap;
}

.addon-brief-li {
  display: block;
  font-size: 24rpx;
  line-height: 1.65;
  color: #334155;
  margin-top: 6rpx;
}

.addon-brief-scene {
  margin-top: 12rpx;
  padding: 16rpx;
  border-radius: 12rpx;
  background: #fff;
  border: 1rpx solid #e2e8f0;
}

.addon-brief-scene__head {
  display: block;
  font-size: 24rpx;
  font-weight: 600;
  color: #0f172a;
}

.addon-brief-scene__line {
  display: block;
  margin-top: 6rpx;
  font-size: 24rpx;
  line-height: 1.6;
  color: #475569;
}
