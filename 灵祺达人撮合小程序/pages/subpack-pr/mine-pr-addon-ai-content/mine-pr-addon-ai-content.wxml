<scroll-view class="addon-page addon-scroll {{lqThemeClass}}" scroll-y enhanced show-scrollbar="{{false}}">
  <view class="addon-tabs">
    <view class="addon-tab {{mainTab === 'article' ? 'addon-tab--on' : ''}}" data-tab="article" bindtap="onTab">AI 文章生成</view>
    <view class="addon-tab {{mainTab === 'topic' ? 'addon-tab--on' : ''}}" data-tab="topic" bindtap="onTab">AI 话题推荐</view>
    <view class="addon-tab {{mainTab === 'brief' ? 'addon-tab--on' : ''}}" data-tab="brief" bindtap="onTab">招募 Brief</view>
  </view>

  <view class="addon-card">
    <text class="addon-card__title">招募订单筛选</text>
    <text class="addon-card__sub">选择本账号已发布的招募订单，AI 将按订单实际要求生成内容（无需林客绑定）</text>
    <input class="addon-input" placeholder="搜索订单标题、区域、品类…" value="{{orderKeyword}}" bindinput="onOrderKeyword" />
    <view class="addon-order-pick" bindtap="onToggleOrderPicker">
      <text class="addon-order-pick__label">当前订单</text>
      <text class="addon-order-pick__val">{{selectedOrder ? selectedOrder.title : '点击选择招募订单'}}</text>
      <text class="addon-order-pick__arrow">{{showOrderPicker ? '▲' : '▼'}}</text>
    </view>
    <view class="addon-order-list" wx:if="{{showOrderPicker}}">
      <view wx:if="{{filteredOrders.length === 0}}" class="addon-hint">暂无匹配订单，请先在「我的发单」发布招募。</view>
      <view
        wx:for="{{filteredOrders}}"
        wx:key="id"
        class="addon-order-item {{selectedOrderId === item.id ? 'addon-order-item--on' : ''}}"
        data-id="{{item.id}}"
        bindtap="onPickOrder"
      >
        <text class="addon-order-item__title">{{item.title}}</text>
        <text class="addon-order-item__meta">{{item.platform}} · {{item.region}} · {{item.category}}</text>
      </view>
    </view>
    <text class="addon-label">文案 AI 模型</text>
    <view class="addon-chips">
      <view
        wx:for="{{textModels}}"
        wx:key="id"
        class="addon-chip {{textModel === item.id ? 'addon-chip--on' : ''}}"
        data-id="{{item.id}}"
        bindtap="onModel"
      >{{item.label}}</view>
    </view>
    <text class="addon-label">补充要点（可选）</text>
    <textarea class="addon-textarea addon-textarea--sm" placeholder="如：强调周末引流、突出套餐性价比等" value="{{extraHint}}" bindinput="onExtraHint" maxlength="600" />
  </view>

  <view class="addon-card" wx:if="{{mainTab === 'article'}}">
    <text class="addon-card__title">AI 文章生成</text>
    <text class="addon-card__sub">基于所选招募订单的标题、要求与任务详情生成图文稿件</text>
    <text class="addon-err" wx:if="{{articleErr}}">{{articleErr}}</text>
    <button class="addon-btn" loading="{{articleBusy}}" disabled="{{articleBusy}}" bindtap="onGenerateArticle">生成文章</button>
    <view class="addon-out" wx:if="{{articleOut}}">
      <text class="addon-out__text">{{articleOut}}</text>
      <view class="addon-out__actions">
        <button class="addon-out__btn" data-field="articleOut" bindtap="onCopy">复制全文</button>
      </view>
    </view>
  </view>

  <view class="addon-card" wx:elif="{{mainTab === 'topic'}}">
    <text class="addon-card__title">AI 话题推荐</text>
    <text class="addon-card__sub">结合招募订单实际情况生成本周选题建议</text>
    <text class="addon-err" wx:if="{{topicErr}}">{{topicErr}}</text>
    <button class="addon-btn" loading="{{topicBusy}}" disabled="{{topicBusy}}" bindtap="onGenerateTopic">生成选题</button>
    <view class="addon-out" wx:if="{{topicOut}}">
      <text class="addon-out__text">{{topicOut}}</text>
      <view class="addon-out__actions">
        <button class="addon-out__btn" data-field="topicOut" bindtap="onCopy">复制全文</button>
      </view>
    </view>
  </view>

  <view class="addon-card" wx:else>
    <text class="addon-card__title">招募 Brief（云剪文案）</text>
    <text class="addon-card__sub">按订单生成【剪辑指令】+【字幕文案】，可直接用于灵祺 AI 云剪</text>
    <text class="addon-err" wx:if="{{briefErr}}">{{briefErr}}</text>
    <button class="addon-btn" loading="{{briefBusy}}" disabled="{{briefBusy}}" bindtap="onGenerateBrief">生成 Brief</button>
    <view class="addon-out" wx:if="{{briefOut}}">
      <text class="addon-out__text">{{briefOut}}</text>
      <view class="addon-out__actions">
        <button class="addon-out__btn" data-field="briefCopy" bindtap="onCopy">复制字幕</button>
        <button class="addon-out__btn" data-field="briefInstruction" bindtap="onCopy">复制指令</button>
        <button class="addon-out__btn" data-field="briefOut" bindtap="onCopy">复制全文</button>
      </view>
    </view>
  </view>
</scroll-view>
