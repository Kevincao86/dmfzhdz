@import '../video-review-share/video-review-share.wxss';

.ap-meta {
  display: block;
  font-size: 24rpx;
  color: #64748b;
  margin-top: 6rpx;
}

.ap-profile-row {
  margin-top: 12rpx;
}

.ap-avatar {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  flex-shrink: 0;
  margin-right: 16rpx;
  background: #e2e8f0;
}

.ap-avatar--placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  font-weight: 600;
  color: #64748b;
}

.vr-card-head {
  display: flex;
  align-items: flex-start;
}

.vr-card-info {
  flex: 1;
  min-width: 0;
}

.ap-profile-btn {
  display: inline-block;
  padding: 8rpx 20rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  font-weight: 600;
  color: #4f46e5;
  border: 1rpx solid #c7d2fe;
  background: #eef2ff;
}

.ap-tag {
  display: inline-block;
  margin-right: 8rpx;
  margin-top: 8rpx;
  padding: 4rpx 12rpx;
  border-radius: 999rpx;
  background: #f1f5f9;
  font-size: 22rpx;
  color: #475569;
}

.ap-saved-note {
  margin-top: 12rpx;
  padding: 12rpx 16rpx;
  border-radius: 12rpx;
  background: #f0fdf4;
  border: 1rpx solid #bbf7d0;
}

.ap-saved-note__label {
  display: block;
  font-size: 22rpx;
  color: #15803d;
  margin-bottom: 6rpx;
}

.ap-saved-note__text {
  font-size: 26rpx;
  color: #166534;
  line-height: 1.5;
}
