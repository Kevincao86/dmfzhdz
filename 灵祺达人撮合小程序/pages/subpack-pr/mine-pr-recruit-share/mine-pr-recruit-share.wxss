.page {
  min-height: 100vh;
  background: #eef1f6;
  display: flex;
  flex-direction: column;
}
.tabs {
  display: flex;
  background: #fff;
  border-bottom: 1rpx solid #e2e8f0;
}
.tab {
  flex: 1;
  text-align: center;
  padding: 28rpx 0 22rpx;
  font-size: 30rpx;
  color: #64748b;
}
.tab.on {
  color: #2563eb;
  font-weight: 700;
  border-bottom: 4rpx solid #2563eb;
}
.stage {
  flex: 1;
  padding: 28rpx 40rpx 12rpx;
  display: flex;
  justify-content: center;
  align-items: flex-start;
}
.poster {
  width: 520rpx;
  background: #fff;
  border-radius: 16rpx;
}
.qr {
  width: 560rpx;
  background: #fff;
  border-radius: 16rpx;
}
.code-wrap {
  display: flex;
  justify-content: center;
  align-items: center;
}
.code {
  width: 100%;
  height: 100%;
  background: transparent;
}
.notice {
  background: #fff7ed;
  color: #c2410c;
  font-size: 26rpx;
  line-height: 1.5;
  padding: 20rpx 24rpx;
  border-radius: 12rpx;
  margin-bottom: 20rpx;
}
.stage-web {
  display: flex;
  flex-direction: column;
  align-items: stretch;
}
.qr-box {
  width: 100%;
  display: flex;
  justify-content: center;
}
.theme-scroll {
  white-space: nowrap;
  width: 100%;
  margin-bottom: 16rpx;
}
.theme-chip {
  display: inline-flex;
  margin-right: 12rpx;
}
.link-box {
  background: #f1f5f9;
  color: #0f172a;
  font-size: 26rpx;
  line-height: 1.5;
  padding: 24rpx;
  border-radius: 12rpx;
  word-break: break-all;
}
.hint {
  color: #64748b;
  font-size: 26rpx;
  padding: 40rpx 0;
}
.panel {
  background: #fff;
  padding: 16rpx 24rpx calc(24rpx + env(safe-area-inset-bottom));
  border-radius: 24rpx 24rpx 0 0;
}
.editions, .tool-tabs, .chips, .modes, .swatches {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-bottom: 16rpx;
}
.edition, .tool {
  font-size: 26rpx;
  color: #64748b;
  padding-bottom: 8rpx;
}
.edition.on, .tool.on {
  color: #0f172a;
  font-weight: 700;
  border-bottom: 4rpx solid #0f172a;
}
.swatch {
  width: 64rpx;
  height: 64rpx;
  border-radius: 12rpx;
  border: 4rpx solid transparent;
}
.swatch.on {
  border-color: #0f172a;
}
.chip, .mode {
  min-width: 120rpx;
  text-align: center;
  padding: 16rpx 20rpx;
  border: 2rpx solid #e2e8f0;
  border-radius: 12rpx;
  font-size: 26rpx;
  color: #334155;
}
.chip.on, .mode.on {
  border-color: #2563eb;
  color: #2563eb;
  background: #eff6ff;
}
.cap-input {
  background: #f8fafc;
  border-radius: 12rpx;
  padding: 16rpx 20rpx;
  margin-bottom: 16rpx;
  font-size: 26rpx;
}
.save {
  margin-top: 8rpx;
  background: #2563eb;
  color: #fff;
  border-radius: 12rpx;
  font-size: 32rpx;
}
.save::after { border: none; }
