@import '../mine-pr-order-video-review/mine-pr-order-video-review.wxss';

.vr-share-visitor {
  margin-bottom: 16rpx;
}

.vr-share-visitor__label {
  display: block;
  font-size: 26rpx;
  font-weight: 600;
  color: #334155;
  margin-bottom: 12rpx;
}

.vr-share-visitor__input {
  width: 100%;
  height: 72rpx;
  padding: 0 20rpx;
  box-sizing: border-box;
  border: 1rpx solid #e2e8f0;
  border-radius: 12rpx;
  font-size: 28rpx;
  background: #fff;
}

.vr-share-remark {
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid #f1f5f9;
}

.vr-share-remark__label {
  display: block;
  font-size: 26rpx;
  font-weight: 600;
  color: #4f46e5;
  margin-bottom: 12rpx;
}

.vr-share-submit {
  margin-top: 16rpx;
  min-height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #0ea5e9 0%, #6366f1 100%);
  color: #fff;
  font-size: 28rpx;
  font-weight: 700;
}

.vr-share-submit--busy {
  opacity: 0.72;
}
