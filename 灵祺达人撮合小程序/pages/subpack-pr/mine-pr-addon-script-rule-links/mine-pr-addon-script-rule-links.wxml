<view class="addon-page {{lqThemeClass}} foot-col">
  <view class="addon-card">
    <text class="addon-card__title">平台文稿审核规则</text>
    <text class="addon-card__sub">按平台查看小红书、大众点评官方公开规则。点击后打开原网页；若小程序无法内嵌，将复制链接便于在浏览器打开。</text>
  </view>
  <view wx:for="{{groups}}" wx:for-item="group" wx:key="platform" class="addon-card">
    <text class="addon-card__title">{{group.platform}}</text>
    <view
      wx:for="{{group.links}}"
      wx:for-item="link"
      wx:key="url"
      class="addon-order-pick rule-link"
      data-url="{{link.url}}"
      bindtap="onOpenLink"
    >
      <text class="addon-order-pick__label">{{link.title}}</text>
      <text class="addon-order-pick__arrow">›</text>
    </view>
  </view>
  <site-icp-footer />
</view>
