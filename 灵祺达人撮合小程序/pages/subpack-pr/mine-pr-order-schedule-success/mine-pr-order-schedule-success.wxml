<page-meta page-style="{{lqPageStyle}}" background-color="{{lqPageBg}}" background-color-top="{{lqNavBg}}" background-color-bottom="{{lqPageBg}}" />
<view class="{{lqAccentClass}} sch-ok-page page-shell {{lqThemeClass}} foot-col" style="{{lqPageStyle}}">
  <view class="card sch-ok-card">
    <text class="sch-ok-icon" aria-hidden="true">✓</text>
    <text class="sch-ok-title">探店排期已确认并通知达人</text>
    <text class="hint sch-ok-desc">
      {{talentCount > 0
        ? '已把探店日期和时段发给 ' + talentCount + ' 位达人，他们可以在「我的报名」里直接上传成片。'
        : '达人可以在「我的报名」查看排期，并直接上传成片，不用单独签到。'}}
    </text>
    <view class="sch-ok-actions">
      <button class="sch-ok-btn sch-ok-btn--primary" bindtap="goVideoReview">查看待视频审核</button>
      <button class="sch-ok-btn" plain bindtap="goApplicants">报名管理</button>
      <button class="sch-ok-btn" plain bindtap="goOrders">返回发单列表</button>
    </view>
  </view>
  <site-icp-footer />
</view>
