@import '../../styles/theme.wxss';
@import '../../styles/identity-themes.wxss';
@import '../../styles/hero-deco.wxss';
@import '../../styles/mp-beautify.wxss';

.mine-page {
  background: var(--lq-bg);
}

.mine-scroll {
  padding-bottom: 8rpx;
}

/* —— 工作台 Hero —— */
.wb-hero {
  position: relative;
  overflow: hidden;
  padding-bottom: 20rpx;
  border-radius: 0 0 36rpx 36rpx;
  box-shadow: var(--lq-shadow-header);
  background: var(--lq-gradient-header);
}

.wb-hero-inner {
  position: relative;
  z-index: 3;
  padding-left: 28rpx;
  padding-right: 28rpx;
  padding-bottom: 96rpx;
  min-height: 220rpx;
  box-sizing: border-box;
}

.wb-hero-top {
  padding-top: 0;
}

.wb-profile-row {
  display: flex;
  align-items: flex-start;
  gap: 18rpx;
  flex: 1;
  min-width: 0;
}

.wb-switch-btn {
  flex-shrink: 0;
  align-self: flex-start;
  margin-top: 2rpx;
  margin-left: 4rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.2);
  border: 1rpx solid rgba(255, 255, 255, 0.45);
}

.wb-hero-bottom {
  display: none;
}

.wb-membership-panel {
  position: absolute;
  right: 28rpx;
  bottom: 12rpx;
  z-index: 10;
  min-width: 152rpx;
  max-width: 176rpx;
  padding: 10rpx 14rpx 12rpx;
  border-radius: 16rpx;
  background: rgba(255, 255, 255, 0.18);
  border: 1rpx solid rgba(255, 255, 255, 0.48);
  box-sizing: border-box;
  box-shadow: 0 8rpx 20rpx rgba(15, 23, 42, 0.12);
}

.wb-membership-panel--hover {
  background: rgba(255, 255, 255, 0.24);
}

.wb-membership-kicker {
  display: block;
  font-size: 18rpx;
  font-weight: 700;
  color: rgba(255, 255, 255, 0.82);
  letter-spacing: 2rpx;
}

.wb-membership-plan {
  display: block;
  margin-top: 4rpx;
  font-size: 20rpx;
  font-weight: 700;
  color: #fff;
  line-height: 1.25;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.wb-membership-exp {
  display: block;
  margin-top: 2rpx;
  font-size: 16rpx;
  color: rgba(255, 255, 255, 0.78);
  line-height: 1.2;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.wb-membership-cta {
  margin-top: 8rpx;
  padding: 4rpx 0;
  text-align: center;
  font-size: 18rpx;
  font-weight: 700;
  color: #7c3aed;
  background: linear-gradient(135deg, #fde68a, #fbbf24);
  border-radius: 999rpx;
  line-height: 1.4;
}

.profile-avatar-btn,
.profile-avatar-wrap {
  flex-shrink: 0;
}

.profile-avatar-btn {
  padding: 0;
  margin: 0;
  background: transparent;
  border: none;
  line-height: 1;
}

.profile-avatar-btn::after {
  border: none;
}

.wb-avatar {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  border: 4rpx solid rgba(255, 255, 255, 0.92);
  box-shadow: 0 8rpx 20rpx rgba(15, 23, 42, 0.12);
  flex-shrink: 0;
}

.wb-avatar--ph {
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(255, 255, 255, 0.2);
  overflow: hidden;
}

.profile-avatar-logo {
  width: 100%;
  height: 100%;
}

.wb-profile-meta {
  flex: 1;
  min-width: 0;
}

.wb-name-row {
  display: flex;
  align-items: center;
  min-width: 0;
  padding-right: 8rpx;
}

.wb-name {
  font-size: 34rpx;
  font-weight: 700;
  color: #fff;
  max-width: 100%;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.wb-nick-input {
  width: 100%;
  min-width: 0;
  max-width: 100%;
  height: 48rpx;
  padding: 0;
  font-size: 34rpx;
  font-weight: 700;
  color: #fff;
  background: transparent;
}

.wb-tag-row {
  display: flex;
  align-items: center;
  flex-wrap: nowrap;
  gap: 8rpx;
  margin-top: 6rpx;
}

.wb-role-pill {
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
  font-size: 20rpx;
  font-weight: 700;
  color: #fff;
  background: rgba(255, 255, 255, 0.22);
  border: 1rpx solid rgba(255, 255, 255, 0.45);
  white-space: nowrap;
}

.profile-badge {
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
  font-size: 20rpx;
  background: rgba(255, 255, 255, 0.28);
  color: #fff;
  white-space: nowrap;
}

.profile-badge--muted {
  background: rgba(15, 23, 42, 0.15);
}

.wb-verified-pill {
  font-size: 20rpx;
  padding: 4rpx 12rpx;
}

.profile-badge--verified.wb-verified-pill {
  background: linear-gradient(135deg, #34d399, #10b981);
  color: #fff;
  font-weight: 700;
}

.wb-sub {
  display: block;
  margin-top: 4rpx;
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.88);
  line-height: 1.35;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.wb-id {
  display: block;
  margin-top: 2rpx;
  font-size: 20rpx;
  font-weight: 600;
  color: rgba(255, 255, 255, 0.78);
}

.profile-badges {
  display: none;
}

.wb-hero-foot {
  display: none;
}

.wb-greeting {
  display: block;
  margin-top: 10rpx;
  padding-right: 196rpx;
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.86);
  line-height: 1.4;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.wb-switch-btn--hover {
  background: rgba(255, 255, 255, 0.32);
}

.wb-switch-glyph {
  font-size: 26rpx;
  color: #fff;
  line-height: 1;
}

.wb-switch-text {
  margin-top: 2rpx;
  font-size: 18rpx;
  color: rgba(255, 255, 255, 0.92);
  font-weight: 600;
  line-height: 1;
}

/* —— 浮动统计卡 —— */
.wb-stats-card {
  display: flex;
  margin: 8rpx 28rpx 8rpx;
  padding: 20rpx 12rpx;
  background: #fff;
  border-radius: 24rpx;
  border: 2rpx solid rgba(255, 255, 255, 0.95);
  box-shadow: var(--lq-shadow-soft);
  position: relative;
  z-index: 5;
}

.wb-stat-cell {
  flex: 1;
  text-align: center;
  border-right: 1rpx solid var(--lq-border);
}

.wb-stat-cell:last-child {
  border-right: none;
}

.wb-stat-num {
  display: block;
  font-size: 36rpx;
  font-weight: 800;
  color: var(--lq-primary-dark);
  line-height: 1.2;
}

.wb-stat-lbl {
  display: block;
  margin-top: 6rpx;
  font-size: 22rpx;
  color: var(--lq-text-secondary);
}

/* —— 登录条 —— */
.wx-login-banner,
.vip-banner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin: 12rpx 28rpx 0 !important;
}

.wx-login-sheet .wx-login-profile {
  display: flex;
  align-items: center;
  gap: 24rpx;
  margin: 24rpx 0;
}

.wx-avatar-btn {
  padding: 0;
  margin: 0;
  background: transparent;
  border: none;
  line-height: 1;
  flex-shrink: 0;
}

.wx-avatar-btn::after {
  border: none;
}

.wx-login-avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  border: 2rpx solid #e2e8f0;
}

.wx-login-avatar--ph {
  display: flex;
  align-items: center;
  justify-content: center;
  background: #f1f5f9;
  font-size: 24rpx;
  color: #94a3b8;
}

.wx-login-nick-input {
  flex: 1;
  height: 80rpx;
  padding: 0 24rpx;
  background: #f8fafc;
  border-radius: 16rpx;
  font-size: 28rpx;
}

.wx-login-submit {
  margin-top: 8rpx;
}

.id-sheet-foot {
  margin-top: 0;
}

.vip-text {
  flex: 1;
  font-size: 26rpx;
  color: var(--lq-primary-deep);
  font-weight: 500;
}

.vip-btn {
  padding: 0 28rpx;
  height: 64rpx;
  line-height: 64rpx;
  font-size: 24rpx;
  font-weight: 600;
  background: linear-gradient(135deg, #ffd166, #ffb347);
  color: #fff;
  border-radius: 999rpx;
  border: 3rpx solid rgba(255, 255, 255, 0.55);
  box-shadow: 0 8rpx 0 rgba(255, 179, 71, 0.35);
}

.vip-btn::after {
  border: none;
}

/* —— 常用功能宫格 —— */
.wb-section {
  padding: 0 28rpx;
  margin-bottom: 12rpx;
}

.wb-section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 10rpx;
}

.wb-section-title {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--lq-text);
}

.wb-quick-grid {
  display: flex;
  flex-wrap: nowrap;
  background: #fff;
  border-radius: 24rpx;
  padding: 16rpx 8rpx 10rpx;
  box-shadow: var(--lq-shadow-soft);
  border: 2rpx solid rgba(255, 255, 255, 0.95);
}

.wb-quick-tile {
  width: 25%;
  flex-shrink: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 8rpx 4rpx 12rpx;
  box-sizing: border-box;
}

.wb-quick-tile--hover,
.wb-quick-tile:active {
  opacity: 0.82;
}

.wb-quick-tile--soon {
  opacity: 0.72;
}

.wb-tile-icon {
  width: 80rpx;
  height: 80rpx;
  border-radius: 20rpx;
  overflow: hidden;
  margin-bottom: 8rpx;
  box-shadow: 0 6rpx 16rpx rgba(15, 23, 42, 0.08);
}

.wb-tile-img {
  width: 100%;
  height: 100%;
  display: block;
}

.wb-tile-label {
  font-size: 22rpx;
  font-weight: 600;
  color: var(--lq-text);
  text-align: center;
  line-height: 1.3;
  max-width: 100%;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* —— 业务管理列表 —— */
.wb-biz-card {
  background: #fff;
  border-radius: 24rpx;
  overflow: hidden;
  box-shadow: var(--lq-shadow-soft);
  border: 2rpx solid rgba(255, 255, 255, 0.95);
}

.wb-biz-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 26rpx 24rpx;
  border-bottom: 1rpx solid #f1f5f9;
}

.wb-biz-row:last-child {
  border-bottom: none;
}

.wb-biz-row--hover,
.wb-biz-row:active {
  background: var(--lq-active-tint);
}

.wb-biz-row--soon {
  opacity: 0.85;
}

.wb-biz-icon {
  width: 64rpx;
  height: 64rpx;
  flex-shrink: 0;
  border-radius: 16rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 12rpx rgba(15, 23, 42, 0.06);
}

.wb-biz-img {
  width: 100%;
  height: 100%;
  display: block;
}

.wb-biz-body {
  flex: 1;
  min-width: 0;
}

.wb-biz-label {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: var(--lq-text);
}

.wb-biz-sub {
  display: block;
  margin-top: 4rpx;
  font-size: 22rpx;
  color: var(--lq-text-secondary);
  line-height: 1.4;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.wb-biz-right {
  display: flex;
  align-items: center;
  flex-shrink: 0;
}

.wb-biz-arrow {
  font-size: 36rpx;
  color: var(--lq-primary-soft);
}

.menu-soon {
  font-size: 22rpx;
  color: #94a3b8;
  padding: 4rpx 12rpx;
  border-radius: 999rpx;
  background: #f1f5f9;
  line-height: 1.3;
}

/* 身份切换弹层 */
.id-sheet-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 10000;
  background: rgba(45, 27, 78, 0.35);
  display: flex;
  align-items: flex-end;
}

.id-sheet {
  width: 100%;
  padding: 28rpx 28rpx calc(28rpx + env(safe-area-inset-bottom));
  background: var(--lq-card);
  border-radius: 40rpx 40rpx 0 0;
  border: 3rpx solid rgba(255, 255, 255, 0.95);
  box-shadow: 0 -12rpx 0 rgba(196, 181, 253, 0.25);
}

.id-sheet-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 8rpx;
}

.id-sheet-title {
  font-size: 34rpx;
  font-weight: 800;
  color: var(--lq-text);
}

.id-sheet-close {
  font-size: 44rpx;
  color: #c4b5fd;
  line-height: 1;
  padding: 0 8rpx;
}

.id-sheet-hint {
  display: block;
  font-size: 24rpx;
  color: var(--lq-text-secondary);
  margin-bottom: 24rpx;
}
