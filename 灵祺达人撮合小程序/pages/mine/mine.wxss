@import '../../styles/theme.wxss';
@import '../../styles/hero-deco.wxss';

.mine-page {
  background: var(--lq-bg);
}

.mine-header,
.wx-login-banner {
  flex-shrink: 0;
}

.mine-scroll {
  padding-bottom: 8rpx;
}

.mine-header {
  position: relative;
  overflow: hidden;
  padding-bottom: 24rpx;
  border-radius: 0 0 48rpx 48rpx;
  box-shadow: var(--lq-shadow-header);
}

.mine-header-inner {
  position: relative;
  z-index: 3;
  padding-left: 28rpx;
  padding-right: 28rpx;
  padding-bottom: 64rpx;
  min-height: 200rpx;
  box-sizing: border-box;
}

.profile-row {
  display: flex;
  align-items: flex-start;
  gap: 24rpx;
  padding-right: 56rpx;
}

.profile-avatar-btn,
.profile-avatar-wrap {
  flex-shrink: 0;
}

.profile-avatar-btn {
  padding: 0;
  margin: 0;
  background: transparent;
  border: none;
  line-height: 1;
}

.profile-avatar-btn::after {
  border: none;
}

.profile-avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  border: 5rpx solid rgba(255, 255, 255, 0.95);
  box-shadow: 0 8rpx 0 rgba(255, 255, 255, 0.25);
  flex-shrink: 0;
}

.profile-avatar--ph {
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(255, 255, 255, 0.95);
}

.profile-avatar-logo {
  width: 72rpx;
  height: 72rpx;
}

.profile-meta {
  flex: 1;
  min-width: 0;
}

.profile-name-row {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 12rpx;
}

.profile-name {
  font-size: 36rpx;
  font-weight: 700;
  color: #fff;
  max-width: 100%;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.profile-nick-input {
  flex: 1;
  min-width: 120rpx;
  max-width: 100%;
  height: 56rpx;
  padding: 0 8rpx;
  font-size: 36rpx;
  font-weight: 700;
  color: #fff;
  background: transparent;
}

.identity-switch-btn {
  position: absolute;
  right: 28rpx;
  bottom: 20rpx;
  z-index: 10;
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  padding: 12rpx 22rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.42);
  border: 3rpx solid rgba(255, 255, 255, 0.65);
  box-shadow: 0 8rpx 0 rgba(255, 255, 255, 0.18);
  backdrop-filter: blur(8px);
}

/* 我的页：右侧留给身份切换，不铺背景图与浮动标签 */
.mine-header .lq-hero-bg--mine .lq-hero-bg__glow--2 {
  left: -80rpx;
  bottom: -60rpx;
  right: auto;
  opacity: 0.5;
}

.mine-header .lq-hero-bg--mine::after {
  content: '';
  position: absolute;
  top: 0;
  right: 0;
  width: 42%;
  height: 100%;
  background: linear-gradient(90deg, transparent 0%, rgba(79, 70, 229, 0.35) 100%);
  z-index: 2;
  pointer-events: none;
}

.identity-switch-hint {
  font-size: 22rpx;
  font-weight: 500;
  color: rgba(255, 255, 255, 0.88);
  line-height: 1;
}

.identity-switch-label {
  font-size: 26rpx;
  font-weight: 700;
  color: #fff;
  line-height: 1;
}

.identity-switch-arrow {
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.9);
  line-height: 1;
  margin-top: 2rpx;
}

.profile-sub {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.88);
  line-height: 1.4;
}

.profile-identity-id {
  display: block;
  margin-top: 6rpx;
  font-size: 22rpx;
  font-weight: 700;
  color: #fef3c7;
  letter-spacing: 0.5rpx;
}

.profile-badges {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 12rpx;
}

.profile-badge {
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  background: rgba(255, 255, 255, 0.28);
  color: #fff;
}

.profile-badge--muted {
  background: rgba(15, 23, 42, 0.15);
}

.profile-edit {
  font-size: 44rpx;
  color: rgba(255, 255, 255, 0.8);
  font-weight: 300;
  flex-shrink: 0;
}

.wx-login-banner,
.vip-banner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin: 20rpx 28rpx 0 !important;
}

.wx-login-sheet .wx-login-profile {
  display: flex;
  align-items: center;
  gap: 24rpx;
  margin: 24rpx 0;
}

.wx-avatar-btn {
  padding: 0;
  margin: 0;
  background: transparent;
  border: none;
  line-height: 1;
}

.wx-avatar-btn::after {
  border: none;
}

.wx-login-avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  border: 2rpx solid #e2e8f0;
}

.wx-login-avatar--ph {
  display: flex;
  align-items: center;
  justify-content: center;
  background: #f1f5f9;
  font-size: 24rpx;
  color: #94a3b8;
}

.wx-login-nick-input {
  flex: 1;
  height: 80rpx;
  padding: 0 24rpx;
  background: #f8fafc;
  border-radius: 16rpx;
  font-size: 28rpx;
}

.wx-login-submit {
  margin-top: 8rpx;
}

.vip-text {
  flex: 1;
  font-size: 26rpx;
  color: #6d28d9;
  font-weight: 500;
}

.vip-btn {
  padding: 0 28rpx;
  height: 64rpx;
  line-height: 64rpx;
  font-size: 24rpx;
  font-weight: 600;
  background: linear-gradient(135deg, #ffd166, #ffb347);
  color: #fff;
  border-radius: 999rpx;
  border: 3rpx solid rgba(255, 255, 255, 0.55);
  box-shadow: 0 8rpx 0 rgba(255, 179, 71, 0.35);
}

.vip-btn::after {
  border: none;
}

.menu-section {
  padding: 8rpx 0 12rpx;
}

.menu-card {
  display: flex;
  align-items: center;
  gap: 22rpx;
  margin: 14rpx 28rpx 0;
  padding: 24rpx 28rpx;
  background: var(--lq-card);
  border-radius: var(--lq-radius-md);
  border: 3rpx solid rgba(255, 255, 255, 0.95);
  box-shadow: var(--lq-shadow-card);
}

.menu-card:active {
  transform: translateY(4rpx);
  box-shadow: 0 6rpx 0 rgba(216, 200, 255, 0.32);
}

.menu-icon-wrap {
  width: 88rpx;
  height: 88rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 28rpx;
  border: 3rpx solid rgba(255, 255, 255, 0.9);
  box-shadow: 0 6rpx 0 rgba(0, 0, 0, 0.04);
}

.menu-icon-wrap--info {
  background: linear-gradient(145deg, #dbeafe, #bfdbfe);
}

.menu-icon-wrap--list {
  background: linear-gradient(145deg, #ede9fe, #ddd6fe);
}

.menu-icon-wrap--tpl {
  background: linear-gradient(145deg, #ffedd5, #fed7aa);
}

.menu-icon-wrap--bell {
  background: linear-gradient(145deg, #ffe4f0, #ffc8e8);
}

.menu-icon-wrap--chart {
  background: linear-gradient(145deg, #e0e7ff, #c7d2fe);
}

.menu-icon-wrap--support {
  background: linear-gradient(145deg, #d1fae5, #a7f3d0);
}

.menu-emoji {
  font-size: 44rpx;
  line-height: 1;
}

.menu-body {
  flex: 1;
  min-width: 0;
}

.menu-label {
  display: block;
  font-size: 30rpx;
  font-weight: 700;
  color: var(--lq-text);
}

.menu-sub {
  display: block;
  margin-top: 6rpx;
  font-size: 22rpx;
  color: var(--lq-text-secondary);
}

.menu-right {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.menu-arrow {
  font-size: 36rpx;
  color: #d8b4fe;
}

.menu-badge {
  min-width: 36rpx;
  padding: 0 10rpx;
  line-height: 36rpx;
  border-radius: 18rpx;
  background: #fb7185;
  color: #fff;
  font-size: 22rpx;
  font-weight: 700;
  text-align: center;
  box-shadow: 0 4rpx 0 rgba(251, 113, 133, 0.35);
}

/* 身份切换弹层 */
.id-sheet-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 10000;
  background: rgba(45, 27, 78, 0.35);
  display: flex;
  align-items: flex-end;
}

.id-sheet {
  width: 100%;
  padding: 28rpx 28rpx calc(28rpx + env(safe-area-inset-bottom));
  background: var(--lq-card);
  border-radius: 40rpx 40rpx 0 0;
  border: 3rpx solid rgba(255, 255, 255, 0.95);
  box-shadow: 0 -12rpx 0 rgba(196, 181, 253, 0.25);
}

.id-sheet-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 8rpx;
}

.id-sheet-title {
  font-size: 34rpx;
  font-weight: 800;
  color: var(--lq-text);
}

.id-sheet-close {
  font-size: 44rpx;
  color: #c4b5fd;
  line-height: 1;
  padding: 0 8rpx;
}

.id-sheet-hint {
  display: block;
  font-size: 24rpx;
  color: var(--lq-text-secondary);
  margin-bottom: 24rpx;
}

.id-sheet-opt {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 24rpx;
  margin-top: 16rpx;
  border-radius: 28rpx;
  border: 3rpx solid rgba(255, 255, 255, 0.9);
  background: #faf5ff;
  box-shadow: 0 6rpx 0 rgba(196, 181, 253, 0.15);
}

.id-sheet-opt.active {
  border-color: var(--lq-primary);
  background: var(--lq-primary-50);
  box-shadow: 0 6rpx 0 rgba(167, 139, 250, 0.25);
}

.id-sheet-opt-icon {
  width: 80rpx;
  height: 80rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 24rpx;
  font-size: 40rpx;
  line-height: 1;
  border: 3rpx solid rgba(255, 255, 255, 0.9);
  box-shadow: 0 6rpx 0 rgba(0, 0, 0, 0.04);
}

.id-sheet-opt-icon--talent {
  background: linear-gradient(145deg, #ffe4f0, #ffc8e8);
}

.id-sheet-opt-icon--pr {
  background: linear-gradient(145deg, #ede9fe, #ddd6fe);
}

.id-sheet-opt-emoji {
  font-size: 40rpx;
  line-height: 1;
}

.id-sheet-opt-body {
  flex: 1;
  min-width: 0;
}

.id-sheet-opt-title {
  display: block;
  font-size: 30rpx;
  font-weight: 700;
  color: var(--lq-text);
}

.id-sheet-opt-sub {
  display: block;
  margin-top: 6rpx;
  font-size: 22rpx;
  color: var(--lq-text-secondary);
  line-height: 1.4;
}

.id-sheet-check {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--lq-primary-dark);
  flex-shrink: 0;
}
