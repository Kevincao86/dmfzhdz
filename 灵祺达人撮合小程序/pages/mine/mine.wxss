@import '../../styles/theme.wxss';
@import '../../styles/hero-deco.wxss';

.mine-page {
  background: var(--lq-bg);
}

.mine-header,
.wx-login-banner {
  flex-shrink: 0;
}

.mine-scroll {
  padding-bottom: 8rpx;
}

.mine-header {
  position: relative;
  overflow: hidden;
  padding-bottom: 24rpx;
  border-radius: 0 0 32rpx 32rpx;
  box-shadow: none;
}

.mine-header-inner {
  position: relative;
  z-index: 3;
  padding-left: 28rpx;
  padding-right: 28rpx;
  padding-bottom: 64rpx;
  min-height: 200rpx;
  box-sizing: border-box;
}

.profile-row {
  display: flex;
  align-items: flex-start;
  gap: 24rpx;
  padding-right: 56rpx;
}

.profile-avatar-btn,
.profile-avatar-wrap {
  flex-shrink: 0;
}

.profile-avatar-btn {
  padding: 0;
  margin: 0;
  background: transparent;
  border: none;
  line-height: 1;
}

.profile-avatar-btn::after {
  border: none;
}

.profile-avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  border: 3rpx solid #fff;
  box-shadow: 0 4rpx 16rpx rgba(22, 119, 255, 0.12);
  flex-shrink: 0;
}

.profile-avatar--ph {
  display: flex;
  align-items: center;
  justify-content: center;
  background: #fff;
}

.profile-avatar-logo {
  width: 72rpx;
  height: 72rpx;
}

.profile-meta {
  flex: 1;
  min-width: 0;
}

.profile-name-row {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 12rpx;
}

.profile-name {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--lq-text);
  max-width: 100%;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.profile-nick-input {
  flex: 1;
  min-width: 120rpx;
  max-width: 100%;
  height: 56rpx;
  padding: 0 8rpx;
  font-size: 36rpx;
  font-weight: 700;
  color: var(--lq-text);
  background: transparent;
}

.identity-switch-btn {
  position: absolute;
  right: 28rpx;
  bottom: 20rpx;
  z-index: 10;
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  padding: 12rpx 22rpx;
  border-radius: 999rpx;
  background: #fff;
  border: 1rpx solid var(--lq-border);
  box-shadow: var(--lq-shadow-card);
}

.mine-header .lq-hero-bg--mine .lq-hero-bg__glow--2 {
  display: none;
}

.mine-header .lq-hero-bg--mine::after {
  display: none;
}

.identity-switch-hint {
  font-size: 22rpx;
  font-weight: 500;
  color: var(--lq-text-secondary);
  line-height: 1;
}

.identity-switch-label {
  font-size: 26rpx;
  font-weight: 700;
  color: var(--lq-primary);
  line-height: 1;
}

.identity-switch-arrow {
  font-size: 20rpx;
  color: var(--lq-text-secondary);
  line-height: 1;
  margin-top: 2rpx;
}

.profile-sub {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  color: var(--lq-text-secondary);
  line-height: 1.4;
}

.profile-identity-id {
  display: block;
  margin-top: 6rpx;
  font-size: 22rpx;
  font-weight: 600;
  color: var(--lq-primary-dark);
  letter-spacing: 0.5rpx;
}

.profile-badges {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 12rpx;
}

.profile-badge {
  padding: 6rpx 16rpx;
  border-radius: 8rpx;
  font-size: 22rpx;
  background: var(--lq-primary-50);
  color: var(--lq-primary-dark);
}

.profile-badge--muted {
  background: #f0f2f5;
  color: var(--lq-text-secondary);
}

.profile-edit {
  font-size: 40rpx;
  color: #c0c4cc;
  font-weight: 300;
  flex-shrink: 0;
}

.wx-login-banner,
.vip-banner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin: 16rpx 24rpx 0 !important;
}

.wx-login-sheet .wx-login-profile {
  display: flex;
  align-items: center;
  gap: 24rpx;
  margin: 24rpx 0;
}

.wx-avatar-btn {
  padding: 0;
  margin: 0;
  background: transparent;
  border: none;
  line-height: 1;
}

.wx-avatar-btn::after {
  border: none;
}

.wx-login-avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  border: 2rpx solid var(--lq-border);
}

.wx-login-avatar--ph {
  display: flex;
  align-items: center;
  justify-content: center;
  background: #f5f7fa;
  font-size: 24rpx;
  color: var(--lq-text-secondary);
}

.wx-login-nick-input {
  flex: 1;
  height: 80rpx;
  padding: 0 24rpx;
  background: #f5f7fa;
  border-radius: 12rpx;
  font-size: 28rpx;
}

.wx-login-submit {
  margin-top: 8rpx;
}

.vip-text {
  flex: 1;
  font-size: 26rpx;
  color: var(--lq-text);
  font-weight: 500;
}

.vip-btn {
  padding: 0 28rpx;
  height: 64rpx;
  line-height: 64rpx;
  font-size: 24rpx;
  font-weight: 600;
  background: var(--lq-gradient);
  color: #fff;
  border-radius: 12rpx;
  border: none;
  box-shadow: none;
}

.vip-btn::after {
  border: none;
}

.menu-section {
  margin-top: 8rpx;
}

.menu-right {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

/* 身份切换弹层 */
.id-sheet-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 10000;
  background: rgba(15, 23, 42, 0.32);
  display: flex;
  align-items: flex-end;
}

.id-sheet {
  width: 100%;
  padding: 28rpx 28rpx calc(28rpx + env(safe-area-inset-bottom));
  background: var(--lq-card);
  border-radius: 32rpx 32rpx 0 0;
  border: 1rpx solid var(--lq-border);
  box-shadow: 0 -12rpx 48rpx rgba(15, 23, 42, 0.08);
}

.id-sheet-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 8rpx;
}

.id-sheet-title {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--lq-text);
}

.id-sheet-close {
  font-size: 44rpx;
  color: #c0c4cc;
  line-height: 1;
  padding: 0 8rpx;
}

.id-sheet-hint {
  display: block;
  font-size: 24rpx;
  color: var(--lq-text-secondary);
  margin-bottom: 24rpx;
}

.id-sheet-opt {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 24rpx;
  margin-top: 12rpx;
  border-radius: 16rpx;
  border: 1rpx solid var(--lq-border);
  background: #fafbfc;
}

.id-sheet-opt.active {
  border-color: var(--lq-primary);
  background: var(--lq-primary-50);
}

.id-sheet-opt-body {
  flex: 1;
  min-width: 0;
}

.id-sheet-opt-title {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  color: var(--lq-text);
}

.id-sheet-opt-sub {
  display: block;
  margin-top: 6rpx;
  font-size: 22rpx;
  color: var(--lq-text-secondary);
  line-height: 1.4;
}

.id-sheet-check {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--lq-primary);
  flex-shrink: 0;
}
