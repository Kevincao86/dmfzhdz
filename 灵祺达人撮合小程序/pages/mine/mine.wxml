<view class="mine-page page-with-bar page-shell-fixed">
  <view class="mine-header lq-hero-header">
    <view class="lq-hero-bg lq-hero-bg--mine" aria-hidden="true">
      <view class="lq-hero-bg__glow lq-hero-bg__glow--2" />
    </view>
    <view class="mine-header-inner lq-hero-header__inner" style="{{headerInnerStyle}}">
      <view class="profile-row">
        <button
          wx:if="{{wxLoggedIn}}"
          class="profile-avatar-btn"
          open-type="chooseAvatar"
          bindchooseavatar="onProfileChooseAvatar"
          catchtap="noopProfileTap"
        >
          <image
            class="profile-avatar"
            src="{{avatarUrl}}"
            mode="aspectFill"
            wx:if="{{avatarUrl}}"
          />
          <view class="profile-avatar profile-avatar--ph" wx:else>
            <image class="profile-avatar-logo" src="/images/logo.png" mode="aspectFit" />
          </view>
        </button>
        <view wx:else class="profile-avatar-wrap" bindtap="onOpenWxLoginSheet">
          <image
            class="profile-avatar"
            src="{{avatarUrl}}"
            mode="aspectFill"
            wx:if="{{avatarUrl}}"
          />
          <view class="profile-avatar profile-avatar--ph" wx:else>
            <image class="profile-avatar-logo" src="/images/logo.png" mode="aspectFit" />
          </view>
        </view>
        <view class="profile-meta">
          <view class="profile-name-row">
            <input
              wx:if="{{wxLoggedIn}}"
              class="profile-nick-input"
              type="nickname"
              placeholder="点击输入昵称"
              value="{{profileNick}}"
              bindinput="onProfileNickInput"
              bindblur="onProfileNickBlur"
            />
            <text wx:else class="profile-name">{{displayName}}</text>
          </view>
          <text class="profile-sub">{{displaySub}}</text>
          <text class="profile-identity-id" wx:if="{{identityIdLine}}">{{identityIdLine}}</text>
          <view class="profile-badges">
            <text class="profile-badge profile-badge--muted" wx:if="{{!wxLoggedIn}}">未登录</text>
            <text class="profile-badge profile-badge--muted" wx:elif="{{identity === 'talent' && profileIncomplete}}">资料未完善</text>
          </view>
        </view>
        <text class="profile-edit" bindtap="goEditProfile">›</text>
      </view>
      <view class="identity-switch-btn" catchtap="onOpenIdentitySheet">
        <text class="identity-switch-hint">身份切换</text>
        <text class="identity-switch-label">{{identityLabel}}</text>
        <text class="identity-switch-arrow">▾</text>
      </view>
    </view>
  </view>

  <view class="wx-login-banner card--accent" wx:if="{{!wxLoggedIn}}">
    <text class="vip-text">使用微信昵称头像登录，即可发招募、报名与导出</text>
    <button class="vip-btn" bindtap="onOpenWxLoginSheet">微信登录</button>
  </view>

  <scroll-view class="mine-scroll page-scroll-body" scroll-y enhanced show-scrollbar="{{false}}">
  <view class="menu-section">
    <view
      wx:for="{{menus}}"
      wx:key="key"
      class="menu-card"
      hover-class="menu-card--hover"
      data-key="{{item.key}}"
      bindtap="onMenuTap"
    >
      <view class="menu-icon-wrap menu-icon-wrap--{{item.icon}}">
        <text class="menu-emoji">{{item.emoji}}</text>
      </view>
      <view class="menu-body">
        <text class="menu-label">{{item.label}}</text>
        <text class="menu-sub">{{item.sub}}</text>
      </view>
      <view class="menu-right">
        <text class="menu-badge" wx:if="{{item.key === 'notifications' && notifyBadge > 0}}">{{notifyBadge}}</text>
        <text class="menu-arrow">›</text>
      </view>
    </view>
  </view>
  </scroll-view>

  <view
    class="id-sheet-mask"
    wx:if="{{showIdentitySheet}}"
    bindtap="onCloseIdentitySheet"
  >
    <view class="id-sheet" catchtap="noopSheetTap">
      <view class="id-sheet-head">
        <text class="id-sheet-title">切换身份</text>
        <text class="id-sheet-close" bindtap="onCloseIdentitySheet">×</text>
      </view>
      <text class="id-sheet-hint">同一账号可在达人、拍摄、剪辑、PR 四种身份间自由切换</text>
      <view
        class="id-sheet-opt {{identity === 'talent' ? 'active' : ''}}"
        data-id="talent"
        bindtap="onPickIdentity"
      >
        <view class="id-sheet-opt-icon id-sheet-opt-icon--talent">
          <text class="id-sheet-opt-emoji">🎭</text>
        </view>
        <view class="id-sheet-opt-body">
          <text class="id-sheet-opt-title">达人</text>
          <text class="id-sheet-opt-sub">浏览商单、报名招募、管理个人资料</text>
        </view>
        <text class="id-sheet-check" wx:if="{{identity === 'talent'}}">✓</text>
      </view>
      <view
        class="id-sheet-opt {{identity === 'shoot' ? 'active' : ''}}"
        data-id="shoot"
        bindtap="onPickIdentity"
      >
        <view class="id-sheet-opt-icon id-sheet-opt-icon--talent">
          <text class="id-sheet-opt-emoji">📷</text>
        </view>
        <view class="id-sheet-opt-body">
          <text class="id-sheet-opt-title">拍摄团队</text>
          <text class="id-sheet-opt-sub">摄影/拍摄任务接单大厅</text>
        </view>
        <text class="id-sheet-check" wx:if="{{identity === 'shoot'}}">✓</text>
      </view>
      <view
        class="id-sheet-opt {{identity === 'edit' ? 'active' : ''}}"
        data-id="edit"
        bindtap="onPickIdentity"
      >
        <view class="id-sheet-opt-icon id-sheet-opt-icon--talent">
          <text class="id-sheet-opt-emoji">✂️</text>
        </view>
        <view class="id-sheet-opt-body">
          <text class="id-sheet-opt-title">剪辑团队</text>
          <text class="id-sheet-opt-sub">剪辑任务接单大厅</text>
        </view>
        <text class="id-sheet-check" wx:if="{{identity === 'edit'}}">✓</text>
      </view>
      <view
        class="id-sheet-opt {{identity === 'pr' ? 'active' : ''}}"
        data-id="pr"
        bindtap="onPickIdentity"
      >
        <view class="id-sheet-opt-icon id-sheet-opt-icon--pr">
          <text class="id-sheet-opt-emoji">💼</text>
        </view>
        <view class="id-sheet-opt-body">
          <text class="id-sheet-opt-title">PR</text>
          <text class="id-sheet-opt-sub">发布招募、管理发单与达人沟通</text>
        </view>
        <text class="id-sheet-check" wx:if="{{identity === 'pr'}}">✓</text>
      </view>
    </view>
  </view>

  <view
    class="id-sheet-mask"
    wx:if="{{showWxLoginSheet}}"
    bindtap="onCloseWxLoginSheet"
  >
    <view class="id-sheet wx-login-sheet" catchtap="noopSheetTap">
      <view class="id-sheet-head">
        <text class="id-sheet-title">微信登录 / 注册</text>
        <text class="id-sheet-close" bindtap="onCloseWxLoginSheet">×</text>
      </view>
      <text class="id-sheet-hint">授权头像与昵称后，达人/PR 身份共用同一微信账号</text>
      <view class="wx-login-profile">
        <button class="wx-avatar-btn" open-type="chooseAvatar" bindchooseavatar="onChooseAvatar">
          <image class="wx-login-avatar" src="{{wxLoginAvatar}}" mode="aspectFill" wx:if="{{wxLoginAvatar}}" />
          <view class="wx-login-avatar wx-login-avatar--ph" wx:else>
            <text>选头像</text>
          </view>
        </button>
        <input
          class="wx-login-nick-input"
          type="nickname"
          placeholder="点击输入微信昵称"
          value="{{wxLoginNick}}"
          bindinput="onNicknameInput"
        />
      </view>
      <button
        class="btn-primary wx-login-submit"
        loading="{{wxLoginSubmitting}}"
        bindtap="onConfirmWxLogin"
      >
        确认登录
      </button>
    </view>
  </view>
</view>
