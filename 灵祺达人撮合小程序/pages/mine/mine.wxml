<page-meta page-style="{{lqPageStyle}}" background-color="{{lqPageBg}}" background-color-top="{{lqNavBg}}" background-color-bottom="{{lqPageBg}}" />
<view class="mine-page page-with-bar page-shell-fixed {{lqThemeClass}} {{lqAccentClass}}" style="{{lqPageStyle}}">
  <feature-guide page="mine" />
  <view class="wb-hero lq-hero-header" style="{{headerBandStyle}}">
    <view class="wb-hero-inner lq-hero-header__inner" style="{{headerInnerStyle}}">
      <view class="wb-hero-top">
        <view class="wb-profile-row">
          <button
            wx:if="{{wxLoggedIn}}"
            class="profile-avatar-btn"
            open-type="chooseAvatar"
            bindchooseavatar="onProfileChooseAvatar"
            catchtap="noopProfileTap"
          >
            <image
              class="wb-avatar"
              src="{{avatarUrl}}"
              mode="aspectFill"
              wx:if="{{avatarUrl}}"
            />
            <view class="wb-avatar wb-avatar--ph" wx:else>
              <image class="profile-avatar-logo lq-brand-logo" src="/images/logo.png" mode="aspectFill" />
            </view>
          </button>
          <view wx:else class="profile-avatar-wrap" bindtap="goEditProfile">
            <image
              class="wb-avatar"
              src="{{avatarUrl}}"
              mode="aspectFill"
              wx:if="{{avatarUrl}}"
            />
            <view class="wb-avatar wb-avatar--ph" wx:else>
              <image class="profile-avatar-logo lq-brand-logo" src="/images/logo.png" mode="aspectFill" />
            </view>
          </view>
          <view class="wb-profile-meta">
            <view class="wb-name-row">
              <input
                wx:if="{{wxLoggedIn}}"
                class="wb-nick-input"
                type="nickname"
                placeholder="点击输入昵称"
                placeholder-style="color:#a8a29e"
                value="{{profileNick}}"
                bindinput="onProfileNickInput"
                bindblur="onProfileNickBlur"
              />
              <text wx:else class="wb-name">{{displayName}}</text>
            </view>
            <view class="wb-tag-row">
              <text class="wb-role-pill">{{identityLabel}}</text>
              <text class="profile-badge profile-badge--verified wb-verified-pill" wx:if="{{profileVerified}}">已认证{{identityLabel}}</text>
              <text class="profile-badge profile-badge--muted" wx:if="{{!wxLoggedIn}}">未登录</text>
              <text class="profile-badge profile-badge--muted" wx:elif="{{profileIncomplete}}">资料未完善</text>
            </view>
            <text class="wb-sub">{{displaySub}}</text>
            <text class="wb-id" wx:if="{{identityIdLine}}">{{identityIdLine}}</text>
          </view>
        </view>
      </view>
    </view>
  </view>

  <scroll-view
    class="mine-scroll page-scroll-body foot-col"
    scroll-y
    scroll-into-view="{{featureGuideAnchor}}"
    scroll-with-animation
    enhanced
    show-scrollbar="{{false}}"
    refresher-enabled
    refresher-triggered="{{statRefreshing}}"
    bindrefresherrefresh="onStatRefresh"
   enable-flex>
    <view class="mine-vip">
      <view class="mine-vip-head">
        <view class="mine-vip-rank">
          <text class="mine-vip-level">{{workRankTitle}}</text>
          <view class="mine-vip-track">
            <view class="mine-vip-track-on" style="width: {{workRankProgress}}%;"></view>
          </view>
          <text class="mine-vip-hint">{{workRankHint}}</text>
        </view>
        <view class="mine-vip-badge" bindtap="onGoMembership" hover-class="mine-vip-badge--on">
          <image class="mine-vip-badge-bg" src="/images/mine-line/vip-badge.png" mode="scaleToFill" />
          <view class="mine-vip-badge-copy">
            <view class="mine-vip-badge-left">
              <text class="mine-vip-badge-k">会员信息</text>
              <text class="mine-vip-badge-plan">{{membershipLevelLabel}}</text>
            </view>
            <view class="mine-vip-badge-right">
              <image class="mine-vip-crown" src="/images/mine-line/vip-crown.png" mode="aspectFit" />
              <text class="mine-vip-badge-foot">{{membershipBadgeFoot}}</text>
            </view>
          </view>
        </view>
      </view>
      <view class="mine-vip-icons">
        <view
          wx:for="{{spotlightMenus}}"
          wx:key="key"
          id="guide-{{item.key}}"
          class="mine-vip-item"
          hover-class="tap-press"
          data-key="{{item.key}}"
          bindtap="onMenuTap"
        >
          <view class="mine-vip-icon-plate">
            <image class="mine-vip-icon" src="{{item.iconSrc}}" mode="aspectFit" />
          </view>
          <text class="mine-vip-label">{{item.label}}</text>
        </view>
      </view>
    </view>

    <view class="wx-login-banner card--accent" wx:if="{{!wxLoggedIn}}">
      <text class="vip-text">使用微信昵称头像登录，即可发招募、报名与导出</text>
      <button class="vip-btn" bindtap="onGoLoginPage">微信登录</button>
    </view>

    <view class="wb-stats-card" wx:if="{{wxLoggedIn}}">
      <text class="wb-stats-title">{{statBoardTitle}}</text>
      <view class="wb-stats-row">
        <view class="wb-stat-cell" bindtap="onMenuTap" data-key="{{statAppliedKey}}">
          <text class="wb-stat-num">{{statApplied}}</text>
          <text class="wb-stat-lbl">{{statAppliedLabel}}</text>
        </view>
        <view class="wb-stat-cell">
          <text class="wb-stat-num">{{statInProgress}}</text>
          <text class="wb-stat-lbl">{{statInProgressLabel}}</text>
        </view>
        <view class="wb-stat-cell">
          <text class="wb-stat-num">{{statCompleted}}</text>
          <text class="wb-stat-lbl">{{statCompletedLabel}}</text>
        </view>
      </view>
    </view>

    <view class="wb-section" wx:if="{{quickMenus.length}}">
      <view class="wb-section-head">
        <text class="wb-section-title">常用功能</text>
      </view>
      <view class="wb-quick-grid">
        <view
          wx:for="{{quickMenus}}"
          wx:key="key"
          id="guide-{{item.key}}"
          class="wb-quick-tile {{item.comingSoon ? 'wb-quick-tile--soon' : ''}}"
          hover-class="tap-press"
          hover-stay-time="80"
          data-key="{{item.key}}"
          bindtap="onMenuTap"
        >
          <text class="wb-hot-tag" wx:if="{{item.hot}}">火热</text>
          <view class="wb-tile-icon">
            <image class="wb-tile-img" src="{{item.iconSrc}}" mode="aspectFit" />
            <text class="wb-menu-badge" wx:if="{{item.badge}}">{{item.badge}}</text>
          </view>
          <text class="wb-tile-label">{{item.label}}</text>
        </view>
      </view>
    </view>

    <view class="wb-section" wx:for="{{bizGroups}}" wx:key="id">
      <view class="wb-section-head">
        <text class="wb-section-title">{{item.title}}</text>
      </view>
      <view class="wb-biz-grid">
        <view
          wx:for="{{item.items}}"
          wx:for-item="menu"
          wx:key="key"
          id="guide-{{menu.key}}"
          class="wb-quick-tile {{menu.comingSoon ? 'wb-quick-tile--soon' : ''}}"
          hover-class="tap-press"
          hover-stay-time="80"
          data-key="{{menu.key}}"
          bindtap="onMenuTap"
        >
          <text class="wb-hot-tag" wx:if="{{menu.hot}}">火热</text>
          <view class="wb-tile-icon">
            <image class="wb-tile-img" src="{{menu.iconSrc}}" mode="aspectFit" />
            <text class="wb-menu-badge" wx:if="{{menu.badge}}">{{menu.badge}}</text>
          </view>
          <text class="wb-tile-label">{{menu.label}}</text>
        </view>
      </view>
    </view>

    <view class="mine-more" wx:if="{{moreGroups.length}}" bindtap="onOpenMore" hover-class="mine-more--on">
      <view class="mine-more-mosaic">
        <image
          wx:for="{{morePreview}}"
          wx:key="key"
          class="mine-more-mini"
          src="{{item.iconSrc}}"
          mode="aspectFit"
        />
      </view>
      <view class="mine-more-copy">
        <text class="mine-more-title">全部功能</text>
        <text class="mine-more-sub">资金、创作和帮助</text>
      </view>
      <view class="mine-more-go">
        <text>展开</text>
      </view>
    </view>

    <view class="mine-accent-row">
      <view
        wx:for="{{accentSwatches}}"
        wx:key="id"
        class="mine-accent-hit {{(item.id === 'origin' ? !accentId : accentId === item.id) ? 'is-on' : ''}}"
        data-id="{{item.id}}"
        bindtap="onPickAccent"
      >
        <view
          class="mine-accent-dot mine-accent-dot--{{item.id}}"
          style="{{item.dotStyle}}"
        ></view>
        <text class="mine-accent-cap" wx:if="{{item.cap}}">{{item.cap}}</text>
      </view>
    </view>

    <site-icp-footer />
  </scroll-view>

  <view class="id-sheet-mask" wx:if="{{showMoreSheet}}" catchtouchmove="noopSheetTap">
    <view class="id-sheet-mask-bg" bindtap="onCloseMore"></view>
    <view class="id-sheet mine-more-sheet">
      <view class="id-sheet-head">
        <text class="id-sheet-title">全部功能</text>
        <view class="mine-more-close" hover-class="mine-more-close--on" bindtap="onCloseMore">
          <text class="mine-more-close-x">×</text>
        </view>
      </view>
      <text class="mine-more-sheet-lead">资金推广、AI 创作和帮助都在这里</text>
      <scroll-view scroll-y class="mine-more-sheet-body" show-scrollbar="{{false}}">
        <view class="mine-more-block" wx:for="{{moreGroups}}" wx:key="id">
          <text class="mine-more-block-title">{{item.title}}</text>
          <view class="wb-biz-grid mine-more-grid">
            <view
              wx:for="{{item.items}}"
              wx:for-item="menu"
              wx:key="key"
              class="wb-quick-tile"
              hover-class="tap-press"
              data-key="{{menu.key}}"
              bindtap="onMenuTap"
            >
              <view class="wb-tile-icon">
                <image class="wb-tile-img" src="{{menu.iconSrc}}" mode="aspectFit" />
              </view>
              <text class="wb-tile-label">{{menu.label}}</text>
            </view>
          </view>
        </view>
      </scroll-view>
    </view>
  </view>

  <view
    class="id-sheet-mask"
    wx:if="{{showWxLoginSheet}}"
    catchtouchmove="noopSheetTap"
  >
    <view class="id-sheet-mask-bg" bindtap="onCloseWxLoginSheet"></view>
    <view class="id-sheet wx-login-sheet">
      <view class="id-sheet-static">
        <view class="id-sheet-head">
          <text class="id-sheet-title">微信登录 / 注册</text>
          <text class="id-sheet-close" bindtap="onCloseWxLoginSheet">×</text>
        </view>
        <text class="id-sheet-hint">已注册过的，确认后按你的身份直接进入；还没注册的，会去登录页完成注册。</text>
      </view>
      <view class="wx-login-profile">
        <button
          class="wx-avatar-btn"
          hover-class="none"
          open-type="chooseAvatar"
          bindchooseavatar="onChooseAvatar"
        >
          <image class="wx-login-avatar" src="{{wxLoginAvatar}}" mode="aspectFill" wx:if="{{wxLoginAvatar}}" />
          <view class="wx-login-avatar wx-login-avatar--ph" wx:else>
            <text>选头像</text>
          </view>
        </button>
        <input
          class="wx-login-nick-input"
          type="nickname"
          placeholder="点击选用微信昵称"
          value="{{wxLoginNick}}"
          bindinput="onNicknameInput"
          bindblur="onNicknameInput"
          bindnicknamereview="onNicknameReview"
        />
      </view>
      <view class="id-sheet-foot">
        <button
          class="btn-primary wx-login-submit"
          loading="{{wxLoginSubmitting}}"
          bindtap="onConfirmWxLogin"
        >
          确认进入
        </button>
      </view>
    </view>
  </view>
  <view
    wx:if="{{themeVeilOn}}"
    class="mine-theme-veil {{themeVeilAnimate ? 'is-animate' : ''}} {{themeVeilOpen ? 'is-open' : ''}}"
    style="{{themeVeilStyle}}"
    bindtransitionend="onThemeVeilEnd"
  ></view>
</view>
