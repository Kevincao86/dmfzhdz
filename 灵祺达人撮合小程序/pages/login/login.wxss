@import '../../styles/theme.wxss';
@import '../../styles/hero-deco.wxss';

.login-page {
  box-sizing: border-box;
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  background: var(--lq-bg);
}

.login-body {
  flex: 1;
  display: flex;
  flex-direction: column;
  min-height: 0;
}

.login-top {
  position: relative;
  overflow: hidden;
  padding-bottom: 56rpx;
  flex-shrink: 0;
}

.lq-hero-bg--login .lq-hero-bg__pattern {
  opacity: 0.36;
}

.login-top-fade {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 72rpx;
  background: linear-gradient(180deg, transparent 0%, var(--lq-bg) 100%);
  pointer-events: none;
  z-index: 2;
}

.login-top-inner {
  position: relative;
  z-index: 3;
  padding-left: 32rpx;
  box-sizing: border-box;
}

.login-nav-row {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 56rpx;
  margin-bottom: 4rpx;
}

.login-nav-title {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--lq-text);
  letter-spacing: 2rpx;
}

.login-brand-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.login-logo {
  width: 92rpx;
  height: 92rpx;
  flex-shrink: 0;
  border-radius: 20rpx;
  background: #fff;
  box-shadow: var(--lq-shadow-card);
}

.login-hero-text {
  flex: 1;
  min-width: 0;
}

.login-brand {
  display: block;
  font-size: 34rpx;
  font-weight: 700;
  color: var(--lq-text);
  line-height: 1.25;
}

.login-chips {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-top: 10rpx;
}

.login-chip {
  padding: 4rpx 14rpx;
  font-size: 20rpx;
  font-weight: 500;
  color: var(--lq-primary-dark);
  background: var(--lq-primary-50);
  border: 1rpx solid var(--lq-primary-100);
  border-radius: 8rpx;
}

.login-stack {
  margin-top: -48rpx;
  padding: 0 28rpx;
  position: relative;
  z-index: 4;
  flex-shrink: 0;
}

.login-shell {
  border-radius: var(--lq-radius-md);
  overflow: hidden;
  border: 1rpx solid var(--lq-border);
  box-shadow: var(--lq-shadow-card);
  background: var(--lq-surface);
}

.login-main {
  padding: 26rpx 26rpx 24rpx;
}

.login-identity-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 20rpx;
  padding: 18rpx 20rpx;
  border-radius: 16rpx;
  background: #fafbfc;
  border: 1rpx solid var(--lq-border);
}

.login-identity-main {
  flex: 1;
  min-width: 0;
}

.login-identity-label {
  display: block;
  font-size: 22rpx;
  font-weight: 600;
  color: var(--lq-text-secondary);
  margin-bottom: 6rpx;
}

.login-identity-value {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.login-identity-value-text {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--lq-text);
}

.login-identity-placeholder {
  display: block;
  font-size: 24rpx;
  color: #b45309;
}

.login-identity-switch {
  flex-shrink: 0;
  padding: 14rpx 22rpx;
  border-radius: 12rpx;
  font-size: 24rpx;
  font-weight: 600;
  color: var(--lq-primary);
  background: #fff;
  border: 1rpx solid var(--lq-primary-100);
}

.login-id-sheet-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 10000;
  background: rgba(15, 23, 42, 0.32);
  display: flex;
  align-items: flex-end;
}

.login-id-sheet {
  width: 100%;
  padding: 28rpx 28rpx calc(28rpx + env(safe-area-inset-bottom));
  background: var(--lq-card);
  border-radius: 32rpx 32rpx 0 0;
  border: 1rpx solid var(--lq-border);
  box-shadow: 0 -12rpx 48rpx rgba(15, 23, 42, 0.08);
}

.login-id-sheet-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 8rpx;
}

.login-id-sheet-title {
  font-size: 34rpx;
  font-weight: 800;
  color: var(--lq-text);
}

.login-id-sheet-close {
  font-size: 44rpx;
  color: #c0c4cc;
  line-height: 1;
  padding: 0 8rpx;
}

.login-id-sheet-hint {
  display: block;
  font-size: 24rpx;
  color: var(--lq-text-secondary);
  margin-bottom: 20rpx;
}

.login-id-sheet-opt {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 22rpx 24rpx;
  margin-top: 14rpx;
  border-radius: 16rpx;
  border: 1rpx solid var(--lq-border);
  background: #fafbfc;
}

.login-id-sheet-opt.active {
  border-color: var(--lq-primary);
  background: var(--lq-primary-50);
}

.login-id-sheet-body {
  flex: 1;
}

.login-id-sheet-name {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--lq-text);
}

.login-id-sheet-check {
  font-size: 32rpx;
  color: var(--lq-primary);
  font-weight: 800;
}

.login-btn[disabled] {
  opacity: 0.45;
}

.login-tabs {
  margin-bottom: 22rpx;
}

.login-tab {
  font-size: 26rpx;
}

.login-field {
  margin-bottom: 16rpx;
}

.login-field-label {
  display: block;
  margin-bottom: 8rpx;
  padding-left: 4rpx;
  font-size: 24rpx;
  font-weight: 600;
  color: var(--lq-text-secondary);
}

.login-input {
  border: 2rpx solid var(--lq-border);
  border-radius: 20rpx;
  padding: 20rpx 22rpx;
  font-size: 28rpx;
  color: var(--lq-text);
  background: #fff;
}

.login-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  border: none;
  border-radius: 12rpx;
  font-size: 30rpx;
  font-weight: 600;
  padding: 24rpx 0;
}

.login-btn-icon {
  font-size: 26rpx;
  opacity: 0.9;
}

.login-btn--wx {
  background: var(--lq-gradient-tab);
  color: #fff;
  box-shadow: var(--lq-shadow-tab);
}

.login-btn--wx::after {
  border: none;
}

.login-hint {
  display: block;
  margin-top: 14rpx;
  font-size: 22rpx;
  color: var(--lq-text-secondary);
  text-align: center;
  line-height: 1.45;
}

.login-err {
  display: block;
  margin-top: 16rpx;
  padding: 12rpx 16rpx;
  font-size: 24rpx;
  color: #b91c1c;
  text-align: center;
  background: #fef2f2;
  border-radius: 14rpx;
}

.login-spark {
  position: relative;
  padding: 24rpx 0 22rpx;
  background: #fafbfc;
  border-top: 1rpx solid var(--lq-border);
}

.login-spark::before {
  display: none;
}

.login-spark-head {
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding: 0 24rpx 14rpx;
}

.login-spark-orb {
  position: relative;
  width: 68rpx;
  height: 68rpx;
  flex-shrink: 0;
}

.login-spark-orb__txt {
  position: relative;
  z-index: 2;
  display: block;
  width: 68rpx;
  height: 68rpx;
  line-height: 68rpx;
  text-align: center;
  font-size: 26rpx;
  font-weight: 700;
  color: #fff;
  border-radius: 16rpx;
  background: var(--lq-gradient-tab);
  box-shadow: none;
}

.login-spark-orb__ring {
  display: none;
}

.login-spark-copy {
  flex: 1;
  min-width: 0;
}

.login-spark-title {
  display: block;
  font-size: 30rpx;
  font-weight: 800;
  color: var(--lq-primary-deep);
}

.login-spark-sub {
  display: block;
  margin-top: 4rpx;
  font-size: 22rpx;
  color: var(--lq-text-secondary);
  line-height: 1.4;
}

.login-spark-grid {
  display: flex;
  gap: 12rpx;
  padding: 0 20rpx 12rpx;
  box-sizing: border-box;
}

.login-spark-pill {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  justify-content: flex-start;
  padding: 14rpx 12rpx 16rpx;
  border-radius: 12rpx;
  background: #fff;
  border: 1rpx solid var(--lq-border);
  box-shadow: none;
}

.login-spark-pill--0 {
  transform: translateY(2rpx);
}

.login-spark-pill--1 {
  transform: translateY(-2rpx);
}

.login-spark-pill--2 {
  transform: translateY(1rpx);
}

.login-spark-pill__tag {
  display: inline-block;
  align-self: flex-start;
  padding: 2rpx 10rpx;
  margin-bottom: 6rpx;
  font-size: 18rpx;
  font-weight: 700;
  color: #fff;
  border-radius: 999rpx;
  background: var(--lq-gradient-tab);
}

.login-spark-pill__text {
  display: block;
  font-size: 22rpx;
  font-weight: 600;
  color: var(--lq-text);
  line-height: 1.35;
}

.login-spark-flow {
  display: block;
  padding: 0 24rpx;
  font-size: 21rpx;
  color: var(--lq-text-secondary);
  line-height: 1.5;
  text-align: center;
}

.login-orbit-zone {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: flex-start;
  min-height: 480rpx;
  margin-top: 4rpx;
  padding: 0 8rpx calc(env(safe-area-inset-bottom) + 12rpx);
  background: var(--lq-bg);
}

.login-field--row {
  display: flex;
  gap: 12rpx;
  align-items: stretch;
}

.login-input--code {
  flex: 1;
}

.login-sms-btn {
  flex-shrink: 0;
  margin: 0;
  padding: 0 20rpx;
  height: auto;
  min-height: 80rpx;
  line-height: 80rpx;
  font-size: 24rpx;
  font-weight: 600;
  color: var(--lq-primary-dark);
  background: var(--lq-primary-50);
  border: 2rpx solid var(--lq-primary-100);
  border-radius: 20rpx;
}

.login-sms-btn::after {
  border: none;
}
