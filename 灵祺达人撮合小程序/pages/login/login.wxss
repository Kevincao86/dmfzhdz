@import '../../styles/theme.wxss';
@import '../../styles/hero-deco.wxss';

.login-page {
  box-sizing: border-box;
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  background: var(--lq-bg);
}

.login-body {
  flex: 1;
  display: flex;
  flex-direction: column;
  min-height: 0;
}

.login-top {
  position: relative;
  overflow: hidden;
  padding-bottom: 56rpx;
  flex-shrink: 0;
}

.lq-hero-bg--login .lq-hero-bg__pattern {
  opacity: 0.36;
}

.login-top-fade {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 72rpx;
  background: linear-gradient(180deg, transparent 0%, var(--lq-bg) 100%);
  pointer-events: none;
  z-index: 2;
}

.login-top-inner {
  position: relative;
  z-index: 3;
  padding-left: 32rpx;
  box-sizing: border-box;
}

.login-nav-row {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 56rpx;
  margin-bottom: 4rpx;
}

.login-nav-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #fff;
  letter-spacing: 2rpx;
}

.login-brand-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.login-logo {
  width: 92rpx;
  height: 92rpx;
  flex-shrink: 0;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.96);
  box-shadow: 0 10rpx 0 rgba(91, 97, 232, 0.2);
}

.login-hero-text {
  flex: 1;
  min-width: 0;
}

.login-brand {
  display: block;
  font-size: 34rpx;
  font-weight: 800;
  color: #fff;
  line-height: 1.25;
}

.login-chips {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-top: 10rpx;
}

.login-chip {
  padding: 4rpx 14rpx;
  font-size: 20rpx;
  font-weight: 600;
  color: rgba(255, 255, 255, 0.94);
  background: rgba(255, 255, 255, 0.14);
  border: 1rpx solid rgba(255, 255, 255, 0.26);
  border-radius: 999rpx;
}

.login-stack {
  margin-top: -48rpx;
  padding: 0 28rpx;
  position: relative;
  z-index: 4;
  flex-shrink: 0;
}

.login-shell {
  border-radius: var(--lq-radius-lg);
  overflow: hidden;
  border: 3rpx solid rgba(216, 200, 255, 0.48);
  box-shadow: var(--lq-shadow-card), var(--lq-shadow-soft);
  background: var(--lq-surface);
}

.login-main {
  padding: 26rpx 26rpx 24rpx;
}

.login-tabs {
  margin-bottom: 22rpx;
}

.login-tab {
  font-size: 26rpx;
}

.login-field {
  margin-bottom: 16rpx;
}

.login-field-label {
  display: block;
  margin-bottom: 8rpx;
  padding-left: 4rpx;
  font-size: 24rpx;
  font-weight: 600;
  color: var(--lq-text-secondary);
}

.login-input {
  border: 2rpx solid var(--lq-border);
  border-radius: 20rpx;
  padding: 20rpx 22rpx;
  font-size: 28rpx;
  color: var(--lq-text);
  background: #fff;
}

.login-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  border: none;
  border-radius: 999rpx;
  font-size: 30rpx;
  font-weight: 700;
  padding: 24rpx 0;
}

.login-btn-icon {
  font-size: 26rpx;
  opacity: 0.9;
}

.login-btn--wx {
  background: var(--lq-gradient-tab);
  color: #fff;
  box-shadow: var(--lq-shadow-tab);
}

.login-btn--wx::after {
  border: none;
}

.login-hint {
  display: block;
  margin-top: 14rpx;
  font-size: 22rpx;
  color: var(--lq-text-secondary);
  text-align: center;
  line-height: 1.45;
}

.login-err {
  display: block;
  margin-top: 16rpx;
  padding: 12rpx 16rpx;
  font-size: 24rpx;
  color: #b91c1c;
  text-align: center;
  background: #fef2f2;
  border-radius: 14rpx;
}

.login-spark {
  position: relative;
  padding: 24rpx 0 22rpx;
  background: linear-gradient(
    165deg,
    rgba(243, 241, 255, 0.35) 0%,
    rgba(232, 228, 255, 0.72) 38%,
    rgba(250, 247, 255, 0.95) 100%
  );
}

.login-spark::before {
  content: '';
  display: block;
  position: absolute;
  left: 36rpx;
  right: 36rpx;
  top: 0;
  height: 2rpx;
  background: linear-gradient(
    90deg,
    transparent 0%,
    rgba(183, 148, 246, 0.45) 30%,
    rgba(139, 147, 255, 0.55) 50%,
    rgba(183, 148, 246, 0.45) 70%,
    transparent 100%
  );
}

.login-spark-head {
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding: 0 24rpx 14rpx;
}

.login-spark-orb {
  position: relative;
  width: 68rpx;
  height: 68rpx;
  flex-shrink: 0;
}

.login-spark-orb__txt {
  position: relative;
  z-index: 2;
  display: block;
  width: 68rpx;
  height: 68rpx;
  line-height: 68rpx;
  text-align: center;
  font-size: 26rpx;
  font-weight: 800;
  color: #fff;
  border-radius: 50%;
  background: var(--lq-gradient-tab);
  box-shadow: 0 8rpx 20rpx rgba(139, 147, 255, 0.35);
}

.login-spark-orb__ring {
  position: absolute;
  left: -8rpx;
  top: -8rpx;
  width: 84rpx;
  height: 84rpx;
  border-radius: 50%;
  border: 2rpx solid rgba(183, 148, 246, 0.35);
  animation: login-orb-pulse 3s ease-in-out infinite;
}

@keyframes login-orb-pulse {
  0%,
  100% {
    transform: scale(1);
    opacity: 0.55;
  }
  50% {
    transform: scale(1.08);
    opacity: 0.9;
  }
}

.login-spark-copy {
  flex: 1;
  min-width: 0;
}

.login-spark-title {
  display: block;
  font-size: 30rpx;
  font-weight: 800;
  color: var(--lq-primary-deep);
}

.login-spark-sub {
  display: block;
  margin-top: 4rpx;
  font-size: 22rpx;
  color: var(--lq-text-secondary);
  line-height: 1.4;
}

.login-spark-grid {
  display: flex;
  gap: 12rpx;
  padding: 0 20rpx 12rpx;
  box-sizing: border-box;
}

.login-spark-pill {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  justify-content: flex-start;
  padding: 14rpx 12rpx 16rpx;
  border-radius: 20rpx;
  background: rgba(255, 255, 255, 0.88);
  border: 2rpx solid rgba(216, 200, 255, 0.5);
  box-shadow: 0 6rpx 18rpx rgba(139, 147, 255, 0.1);
}

.login-spark-pill--0 {
  transform: translateY(2rpx);
}

.login-spark-pill--1 {
  transform: translateY(-2rpx);
}

.login-spark-pill--2 {
  transform: translateY(1rpx);
}

.login-spark-pill__tag {
  display: inline-block;
  align-self: flex-start;
  padding: 2rpx 10rpx;
  margin-bottom: 6rpx;
  font-size: 18rpx;
  font-weight: 700;
  color: #fff;
  border-radius: 999rpx;
  background: var(--lq-gradient-tab);
}

.login-spark-pill__text {
  display: block;
  font-size: 22rpx;
  font-weight: 600;
  color: var(--lq-text);
  line-height: 1.35;
}

.login-spark-flow {
  display: block;
  padding: 0 24rpx;
  font-size: 21rpx;
  color: var(--lq-text-secondary);
  line-height: 1.5;
  text-align: center;
}

/* 底部填充区：步骤 + 信任文案 + 渐变装饰 */
.login-fill {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
  padding: 20rpx 28rpx calc(env(safe-area-inset-bottom) + 12rpx);
  position: relative;
  overflow: hidden;
  background: linear-gradient(180deg, var(--lq-bg) 0%, #f0ecff 55%, #ebe6ff 100%);
}

.login-steps {
  display: flex;
  align-items: stretch;
  gap: 0;
  margin-bottom: 20rpx;
  padding: 20rpx 16rpx 18rpx;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.72);
  border: 2rpx solid rgba(216, 200, 255, 0.45);
  box-shadow: 0 10rpx 28rpx rgba(139, 147, 255, 0.08);
  position: relative;
  z-index: 2;
}

.login-step {
  flex: 1;
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  padding: 0 6rpx;
}

.login-step__n {
  width: 40rpx;
  height: 40rpx;
  line-height: 40rpx;
  text-align: center;
  font-size: 22rpx;
  font-weight: 800;
  color: #fff;
  border-radius: 50%;
  background: var(--lq-gradient-tab);
  box-shadow: 0 4rpx 12rpx rgba(139, 147, 255, 0.28);
  margin-bottom: 10rpx;
}

.login-step__title {
  display: block;
  font-size: 24rpx;
  font-weight: 700;
  color: var(--lq-primary-deep);
  line-height: 1.3;
}

.login-step__sub {
  display: block;
  margin-top: 4rpx;
  font-size: 20rpx;
  color: var(--lq-text-secondary);
  line-height: 1.35;
}

.login-step__line {
  position: absolute;
  right: -8rpx;
  top: 20rpx;
  width: 16rpx;
  height: 2rpx;
  background: linear-gradient(90deg, rgba(183, 148, 246, 0.5), rgba(139, 147, 255, 0.2));
}

.login-trust {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  padding: 12rpx 8rpx 8rpx;
  position: relative;
  z-index: 2;
}

.login-trust__dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #a78bfa, #6366f1);
  flex-shrink: 0;
  box-shadow: 0 0 12rpx rgba(99, 102, 241, 0.45);
}

.login-trust__text {
  font-size: 21rpx;
  color: var(--lq-text-secondary);
  letter-spacing: 0.5rpx;
  line-height: 1.4;
}

.login-deco {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 200rpx;
  pointer-events: none;
  z-index: 1;
}

.login-deco__blob {
  position: absolute;
  border-radius: 50%;
  filter: blur(40rpx);
  opacity: 0.55;
}

.login-deco__blob--1 {
  width: 280rpx;
  height: 280rpx;
  left: -80rpx;
  bottom: -100rpx;
  background: rgba(167, 139, 250, 0.35);
}

.login-deco__blob--2 {
  width: 240rpx;
  height: 240rpx;
  right: -60rpx;
  bottom: -80rpx;
  background: rgba(129, 140, 248, 0.32);
}

.login-deco__wave {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 120rpx;
  background: linear-gradient(
    180deg,
    transparent 0%,
    rgba(255, 255, 255, 0.35) 100%
  );
}
