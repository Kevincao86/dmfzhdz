@import '../../styles/theme.wxss';
@import '../../styles/hero-deco.wxss';

.login-page {
  box-sizing: border-box;
  min-height: 100vh;
  padding-bottom: calc(env(safe-area-inset-bottom) + 24rpx);
  background: var(--lq-bg);
}

/* 顶区与导航一体，消除系统栏色差 */
.login-top {
  position: relative;
  overflow: hidden;
  padding-bottom: 72rpx;
}

.lq-hero-bg--login .lq-hero-bg__pattern {
  opacity: 0.36;
}

.login-top-fade {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 88rpx;
  background: linear-gradient(180deg, transparent 0%, var(--lq-bg) 100%);
  pointer-events: none;
  z-index: 2;
}

.login-top-inner {
  position: relative;
  z-index: 3;
  padding-left: 32rpx;
  box-sizing: border-box;
}

.login-nav-row {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 64rpx;
  margin-bottom: 8rpx;
}

.login-nav-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #fff;
  letter-spacing: 2rpx;
}

.login-brand-row {
  display: flex;
  align-items: center;
  gap: 22rpx;
}

.login-logo {
  width: 100rpx;
  height: 100rpx;
  flex-shrink: 0;
  border-radius: 26rpx;
  background: rgba(255, 255, 255, 0.96);
  box-shadow: 0 10rpx 0 rgba(91, 97, 232, 0.2);
}

.login-hero-text {
  flex: 1;
  min-width: 0;
}

.login-brand {
  display: block;
  font-size: 36rpx;
  font-weight: 800;
  color: #fff;
  line-height: 1.25;
}

.login-chips {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-top: 12rpx;
}

.login-chip {
  padding: 4rpx 14rpx;
  font-size: 20rpx;
  font-weight: 600;
  color: rgba(255, 255, 255, 0.94);
  background: rgba(255, 255, 255, 0.14);
  border: 1rpx solid rgba(255, 255, 255, 0.26);
  border-radius: 999rpx;
}

.login-stack {
  margin-top: -52rpx;
  padding: 0 28rpx;
  position: relative;
  z-index: 4;
}

.login-shell {
  border-radius: var(--lq-radius-lg);
  overflow: hidden;
  border: 3rpx solid rgba(216, 200, 255, 0.48);
  box-shadow: var(--lq-shadow-card), var(--lq-shadow-soft);
  background: var(--lq-surface);
}

.login-main {
  padding: 30rpx 26rpx 28rpx;
}

.login-tabs {
  margin-bottom: 26rpx;
}

.login-tab {
  font-size: 26rpx;
}

.login-field {
  margin-bottom: 18rpx;
}

.login-field-label {
  display: block;
  margin-bottom: 8rpx;
  padding-left: 4rpx;
  font-size: 24rpx;
  font-weight: 600;
  color: var(--lq-text-secondary);
}

.login-input {
  border: 2rpx solid var(--lq-border);
  border-radius: 20rpx;
  padding: 20rpx 22rpx;
  font-size: 28rpx;
  color: var(--lq-text);
  background: #fff;
}

.login-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  border: none;
  border-radius: 999rpx;
  font-size: 30rpx;
  font-weight: 700;
  padding: 26rpx 0;
}

.login-btn-icon {
  font-size: 26rpx;
  opacity: 0.9;
}

.login-btn--wx {
  background: var(--lq-gradient-tab);
  color: #fff;
  box-shadow: var(--lq-shadow-tab);
}

.login-btn--wx::after {
  border: none;
}

.login-hint {
  display: block;
  margin-top: 16rpx;
  font-size: 22rpx;
  color: var(--lq-text-secondary);
  text-align: center;
  line-height: 1.45;
}

.login-err {
  display: block;
  margin-top: 18rpx;
  padding: 12rpx 16rpx;
  font-size: 24rpx;
  color: #b91c1c;
  text-align: center;
  background: #fef2f2;
  border-radius: 14rpx;
}

/* 登录区下方：渐变融合 + 横向流动胶囊 */
.login-spark {
  position: relative;
  padding: 28rpx 0 26rpx;
  background: linear-gradient(
    165deg,
    rgba(243, 241, 255, 0.35) 0%,
    rgba(232, 228, 255, 0.72) 38%,
    rgba(250, 247, 255, 0.95) 100%
  );
}

.login-spark::before {
  content: '';
  display: block;
  position: absolute;
  left: 36rpx;
  right: 36rpx;
  top: 0;
  height: 2rpx;
  background: linear-gradient(
    90deg,
    transparent 0%,
    rgba(183, 148, 246, 0.45) 30%,
    rgba(139, 147, 255, 0.55) 50%,
    rgba(183, 148, 246, 0.45) 70%,
    transparent 100%
  );
}

.login-spark-head {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 0 26rpx 18rpx;
}

.login-spark-orb {
  position: relative;
  width: 76rpx;
  height: 76rpx;
  flex-shrink: 0;
}

.login-spark-orb__txt {
  position: relative;
  z-index: 2;
  display: block;
  width: 76rpx;
  height: 76rpx;
  line-height: 76rpx;
  text-align: center;
  font-size: 28rpx;
  font-weight: 800;
  color: #fff;
  border-radius: 50%;
  background: var(--lq-gradient-tab);
  box-shadow: 0 8rpx 20rpx rgba(139, 147, 255, 0.35);
}

.login-spark-orb__ring {
  position: absolute;
  left: -10rpx;
  top: -10rpx;
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  border: 2rpx solid rgba(183, 148, 246, 0.35);
  animation: login-orb-pulse 3s ease-in-out infinite;
}

@keyframes login-orb-pulse {
  0%,
  100% {
    transform: scale(1);
    opacity: 0.55;
  }
  50% {
    transform: scale(1.08);
    opacity: 0.9;
  }
}

.login-spark-copy {
  flex: 1;
  min-width: 0;
}

.login-spark-title {
  display: block;
  font-size: 32rpx;
  font-weight: 800;
  color: var(--lq-primary-deep);
}

.login-spark-sub {
  display: block;
  margin-top: 6rpx;
  font-size: 22rpx;
  color: var(--lq-text-secondary);
  line-height: 1.45;
}

.login-spark-track {
  width: 100%;
  white-space: nowrap;
  padding: 4rpx 0 12rpx;
}

.login-spark-pill {
  display: inline-flex;
  flex-direction: column;
  justify-content: center;
  vertical-align: top;
  min-width: 220rpx;
  max-width: 280rpx;
  padding: 18rpx 22rpx;
  margin-right: 16rpx;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.82);
  border: 2rpx solid rgba(216, 200, 255, 0.5);
  box-shadow: 0 8rpx 24rpx rgba(139, 147, 255, 0.1);
}

.login-spark-pill:first-child {
  margin-left: 26rpx;
}

.login-spark-pill:last-child {
  margin-right: 26rpx;
}

.login-spark-pill--0 {
  transform: rotate(-1.5deg) translateY(4rpx);
}

.login-spark-pill--1 {
  transform: rotate(1deg) translateY(-2rpx);
}

.login-spark-pill--2 {
  transform: rotate(-0.5deg) translateY(2rpx);
}

.login-spark-pill__tag {
  display: inline-block;
  align-self: flex-start;
  padding: 2rpx 12rpx;
  margin-bottom: 8rpx;
  font-size: 20rpx;
  font-weight: 700;
  color: #fff;
  border-radius: 999rpx;
  background: var(--lq-gradient-tab);
}

.login-spark-pill__text {
  display: block;
  font-size: 24rpx;
  font-weight: 600;
  color: var(--lq-text);
  line-height: 1.45;
  white-space: normal;
}

.login-spark-flow {
  display: block;
  padding: 0 26rpx;
  font-size: 22rpx;
  color: var(--lq-text-secondary);
  line-height: 1.55;
  text-align: center;
  letter-spacing: 0.5rpx;
}
