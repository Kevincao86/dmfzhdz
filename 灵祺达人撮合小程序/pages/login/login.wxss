@import '../../styles/theme.wxss';
@import '../../styles/hero-deco.wxss';

.login-page {
  box-sizing: border-box;
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  background: var(--lq-bg);
}

.login-body {
  flex: 1;
  display: flex;
  flex-direction: column;
  min-height: 0;
}

.login-top {
  position: relative;
  overflow: hidden;
  padding-bottom: 56rpx;
  flex-shrink: 0;
}

.lq-hero-bg--login .lq-hero-bg__pattern {
  opacity: 0.36;
}

.login-top-fade {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 72rpx;
  background: linear-gradient(180deg, transparent 0%, var(--lq-bg) 100%);
  pointer-events: none;
  z-index: 2;
}

.login-top-inner {
  position: relative;
  z-index: 3;
  padding-left: 32rpx;
  box-sizing: border-box;
}

.login-nav-row {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 56rpx;
  margin-bottom: 4rpx;
}

.login-nav-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #fff;
  letter-spacing: 2rpx;
}

.login-brand-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.login-logo {
  width: 92rpx;
  height: 92rpx;
  flex-shrink: 0;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.96);
  box-shadow: 0 10rpx 0 rgba(91, 97, 232, 0.2);
}

.login-hero-text {
  flex: 1;
  min-width: 0;
}

.login-brand {
  display: block;
  font-size: 34rpx;
  font-weight: 800;
  color: #fff;
  line-height: 1.25;
}

.login-chips {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-top: 10rpx;
}

.login-chip {
  padding: 4rpx 14rpx;
  font-size: 20rpx;
  font-weight: 600;
  color: rgba(255, 255, 255, 0.94);
  background: rgba(255, 255, 255, 0.14);
  border: 1rpx solid rgba(255, 255, 255, 0.26);
  border-radius: 999rpx;
}

.login-stack {
  margin-top: -48rpx;
  padding: 0 28rpx;
  position: relative;
  z-index: 4;
  flex-shrink: 0;
}

.login-shell {
  border-radius: var(--lq-radius-lg);
  overflow: hidden;
  border: 3rpx solid rgba(216, 200, 255, 0.48);
  box-shadow: var(--lq-shadow-card), var(--lq-shadow-soft);
  background: var(--lq-surface);
}

.login-main {
  padding: 26rpx 26rpx 24rpx;
}

.login-tabs {
  margin-bottom: 22rpx;
}

.login-tab {
  font-size: 26rpx;
}

.login-field {
  margin-bottom: 16rpx;
}

.login-field-label {
  display: block;
  margin-bottom: 8rpx;
  padding-left: 4rpx;
  font-size: 24rpx;
  font-weight: 600;
  color: var(--lq-text-secondary);
}

.login-input {
  border: 2rpx solid var(--lq-border);
  border-radius: 20rpx;
  padding: 20rpx 22rpx;
  font-size: 28rpx;
  color: var(--lq-text);
  background: #fff;
}

.login-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  border: none;
  border-radius: 999rpx;
  font-size: 30rpx;
  font-weight: 700;
  padding: 24rpx 0;
}

.login-btn-icon {
  font-size: 26rpx;
  opacity: 0.9;
}

.login-btn--wx {
  background: var(--lq-gradient-tab);
  color: #fff;
  box-shadow: var(--lq-shadow-tab);
}

.login-btn--wx::after {
  border: none;
}

.login-hint {
  display: block;
  margin-top: 14rpx;
  font-size: 22rpx;
  color: var(--lq-text-secondary);
  text-align: center;
  line-height: 1.45;
}

.login-err {
  display: block;
  margin-top: 16rpx;
  padding: 12rpx 16rpx;
  font-size: 24rpx;
  color: #b91c1c;
  text-align: center;
  background: #fef2f2;
  border-radius: 14rpx;
}

.login-orbit-zone {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: center;
  min-height: 640rpx;
  margin-top: 8rpx;
  padding: 0 8rpx calc(env(safe-area-inset-bottom) + 12rpx);
  background: linear-gradient(180deg, var(--lq-bg) 0%, #f3f0ff 50%, #ebe6ff 100%);
}
