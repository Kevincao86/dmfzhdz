.login-page {
  min-height: 100vh;
  padding: 0 40rpx 80rpx;
  box-sizing: border-box;
  background: linear-gradient(165deg, #4f46e5 0%, #7c3aed 42%, #f8fafc 42%, #f8fafc 100%);
}

.login-hero {
  position: relative;
  padding: calc(env(safe-area-inset-top) + 72rpx) 0 56rpx;
  text-align: center;
}

.login-hero__glow {
  position: absolute;
  top: 40rpx;
  left: 50%;
  width: 320rpx;
  height: 320rpx;
  margin-left: -160rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.18);
  filter: blur(40rpx);
}

.login-logo {
  position: relative;
  width: 128rpx;
  height: 128rpx;
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.95);
  box-shadow: 0 16rpx 40rpx rgba(30, 27, 75, 0.2);
}

.login-brand {
  position: relative;
  display: block;
  margin-top: 28rpx;
  font-size: 44rpx;
  font-weight: 700;
  color: #fff;
  letter-spacing: 2rpx;
}

.login-tagline {
  position: relative;
  display: block;
  margin-top: 12rpx;
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.88);
}

.login-card {
  background: #fff;
  border-radius: 32rpx;
  padding: 40rpx 36rpx 48rpx;
  box-shadow: 0 24rpx 64rpx rgba(15, 23, 42, 0.08);
}

.login-tabs {
  display: flex;
  gap: 12rpx;
  padding: 8rpx;
  margin-bottom: 40rpx;
  background: #f1f5f9;
  border-radius: 20rpx;
}

.login-tab {
  flex: 1;
  text-align: center;
  padding: 18rpx 0;
  font-size: 28rpx;
  color: #64748b;
  border-radius: 14rpx;
}

.login-tab--on {
  background: #fff;
  color: #4f46e5;
  font-weight: 600;
  box-shadow: 0 4rpx 16rpx rgba(79, 70, 229, 0.12);
}

.login-input {
  border: 2rpx solid #e2e8f0;
  border-radius: 16rpx;
  padding: 26rpx 28rpx;
  margin-bottom: 24rpx;
  font-size: 30rpx;
  background: #f8fafc;
}

.login-btn {
  border: none;
  border-radius: 999rpx;
  font-size: 32rpx;
  font-weight: 600;
  line-height: 1.2;
  padding: 28rpx 0;
}

.login-btn--wx {
  background: linear-gradient(135deg, #4f46e5, #7c3aed);
  color: #fff;
}

.login-btn--wx::after {
  border: none;
}

.login-err {
  display: block;
  margin-top: 28rpx;
  font-size: 26rpx;
  color: #dc2626;
  line-height: 1.5;
  text-align: center;
}
