<view class="login-page">
  <view class="login-top lq-hero-header" style="{{navBandStyle}}">
    <view class="lq-hero-bg lq-hero-bg--login" aria-hidden="true">
      <view class="lq-hero-bg__pattern" />
      <view class="lq-hero-bg__glow lq-hero-bg__glow--1" />
      <view class="lq-hero-bg__glow lq-hero-bg__glow--2" />
      <view class="lq-hero-bg__mesh" />
      <view class="lq-hero-bg__ring lq-hero-bg__ring--1" />
      <view class="lq-hero-bg__ring lq-hero-bg__ring--2" />
      <text class="lq-hero-bg__icon lq-hero-bg__icon--ai">AI</text>
      <text class="lq-hero-bg__icon lq-hero-bg__icon--shop">探店</text>
      <text class="lq-hero-bg__icon lq-hero-bg__icon--clip">云剪</text>
      <text class="lq-hero-bg__icon lq-hero-bg__icon--spark">✦</text>
    </view>

    <view class="login-top-inner lq-hero-header__inner" style="{{navInnerStyle}}">
      <view class="login-nav-spacer" aria-hidden="true" />
      <view class="login-brand-row">
        <image class="login-logo" src="/images/logo.png" mode="aspectFit" />
        <view class="login-hero-text">
          <text class="login-brand">灵祺星选平台</text>
          <view class="login-chips">
            <text class="login-chip">本地生活</text>
            <text class="login-chip">探店种草</text>
            <text class="login-chip">云剪直派</text>
          </view>
        </view>
      </view>
    </view>
    <view class="login-top-fade" aria-hidden="true" />
  </view>

  <view class="login-body">
  <view class="login-stack">
    <view class="login-shell">
      <view class="login-main">
        <view class="login-identity-row">
          <view class="login-identity-main">
            <text class="login-identity-label">选择登录身份</text>
            <view class="login-identity-value" wx:if="{{loginIdentity}}">
              <image class="login-identity-icon" src="{{loginIdentityIcon}}" mode="aspectFit" />
              <text class="login-identity-value-text">{{loginIdentityLabel}}</text>
            </view>
            <text class="login-identity-placeholder" wx:else>请先切换身份后再登录</text>
          </view>
          <view class="login-identity-switch" bindtap="onOpenIdentitySheet">切换身份</view>
        </view>

        <view class="login-tabs lq-gradient-tabs">
          <view
            class="login-tab lq-gradient-tabs__item {{tab==='wx'?'login-tab--on lq-gradient-tabs__item--on':''}}"
            bindtap="onTabWx"
          >
            微信登录
          </view>
          <view
            class="login-tab lq-gradient-tabs__item {{tab==='pwd'?'login-tab--on lq-gradient-tabs__item--on':''}}"
            bindtap="onTabPwd"
          >
            账号登录
          </view>
          <view
            class="login-tab lq-gradient-tabs__item {{tab==='reg'?'login-tab--on lq-gradient-tabs__item--on':''}}"
            bindtap="onTabReg"
          >
            注册
          </view>
        </view>

        <block wx:if="{{tab==='wx'}}">
          <button class="login-btn login-btn--wx" loading="{{loading}}" disabled="{{!loginIdentity || loading}}" bindtap="onWxLogin">
            <text class="login-btn-icon">◎</text>
            <text>微信一键登录</text>
          </button>
          <view class="login-legal-row" bindtap="onToggleLegalAgree">
            <view class="login-legal-check {{legalAgreed ? 'login-legal-check--on' : ''}}">
              <text wx:if="{{legalAgreed}}" class="login-legal-check__mark">✓</text>
            </view>
            <text class="login-legal-txt">我已阅读并同意</text>
            <text class="login-legal-link" catchtap="onOpenLegal" data-doc="aup">《用户协议》</text>
            <text class="login-legal-txt">和</text>
            <text class="login-legal-link" catchtap="onOpenLegal" data-doc="privacy">《隐私政策》</text>
          </view>
        </block>

        <block wx:elif="{{tab==='pwd'}}">
          <view class="login-field">
            <text class="login-field-label">手机号</text>
            <input
              class="login-input"
              type="number"
              maxlength="11"
              placeholder="11 位大陆手机号"
              value="{{loginName}}"
              bindinput="onLoginName"
            />
          </view>
          <view class="login-field">
            <text class="login-field-label">密码</text>
            <input
              class="login-input"
              password
              placeholder="至少 6 位"
              value="{{password}}"
              bindinput="onPassword"
            />
          </view>
          <button class="login-btn login-btn--wx" loading="{{loading}}" disabled="{{!loginIdentity || loading}}" bindtap="onPwdLogin">登录</button>
        </block>

        <block wx:else>
          <view class="login-field">
            <text class="login-field-label">手机号</text>
            <input
              class="login-input"
              type="number"
              maxlength="11"
              placeholder="11 位大陆手机号"
              value="{{regPhone}}"
              bindinput="onRegPhone"
            />
          </view>
          <view class="login-field login-field--row">
            <input
              class="login-input login-input--code"
              type="number"
              maxlength="6"
              placeholder="6 位验证码"
              value="{{regSmsCode}}"
              bindinput="onRegSmsCode"
            />
            <button
              class="login-sms-btn"
              disabled="{{smsSending || smsCooldown > 0}}"
              bindtap="onSendRegSms"
            >{{smsCooldown > 0 ? smsCooldown + 's' : '获取验证码'}}</button>
          </view>
          <view class="login-field">
            <text class="login-field-label">密码</text>
            <input
              class="login-input"
              password
              placeholder="至少 6 位"
              value="{{regPassword}}"
              bindinput="onRegPassword"
            />
          </view>
          <button class="login-btn login-btn--wx" loading="{{loading}}" disabled="{{!loginIdentity || loading}}" bindtap="onRegister">注册并登录</button>
        </block>

        <text class="login-err" wx:if="{{err}}">{{err}}</text>
      </view>

      <view class="login-spark">
        <view class="login-spark-grid">
          <view
            class="login-spark-pill login-spark-pill--{{index}}"
            wx:for="{{promoPills}}"
            wx:key="tag"
            wx:for-index="index"
          >
            <text class="login-spark-pill__tag">{{item.tag}}</text>
            <text class="login-spark-pill__text">{{item.text}}</text>
          </view>
        </view>

        <text class="login-spark-flow">{{promoFlow}}</text>
      </view>
    </view>
  </view>

  <view class="login-orbit-zone">
    <login-orbit-wall images="{{orbitImages}}" hint="左右滑动旋转达人样片 · 点击查看大图" />
  </view>
  <!-- 供分享卡片 imageUrl 与上传包 include，勿删 -->
  <image class="share-cover-preload" src="/images/share/share-cover-ai-match.jpg" aria-hidden="true" />
  </view>

  <view
    class="login-id-sheet-mask login-id-sheet-mask--center login-legal-mask"
    wx:if="{{showLegalPrompt}}"
    catchtouchmove="noopSheetTap"
  >
    <view class="login-legal-modal" catchtap="noopSheetTap">
      <text class="login-legal-modal-title">请先阅读并同意协议</text>
      <text class="login-legal-modal-content">使用微信一键登录前，请勾选并同意《用户协议》和《隐私政策》。</text>
      <view class="login-legal-modal-actions">
        <button class="login-legal-modal-btn login-legal-modal-btn--decline" bindtap="onLegalDecline">不同意</button>
        <button class="login-legal-modal-btn login-legal-modal-btn--agree" bindtap="onLegalAgreeLogin">同意并登录</button>
      </view>
    </view>
  </view>

  <view class="login-id-sheet-mask" wx:if="{{showWxAuthSheet}}" bindtap="onCloseWxAuthSheet">
    <view class="login-id-sheet" catchtap="noopSheetTap">
      <view class="login-id-sheet-head">
        <text class="login-id-sheet-title">{{wxAuthStep === 'avatar' ? '获取微信头像' : '获取微信昵称'}}</text>
        <text class="login-id-sheet-close" bindtap="onCloseWxAuthSheet">×</text>
      </view>
      <text class="login-id-sheet-hint" wx:if="{{wxAuthStep === 'avatar'}}">请点击下方头像按钮，授权您的微信头像</text>
      <text class="login-id-sheet-hint" wx:else>请点击输入框，选用您的微信昵称</text>
      <view class="login-wx-auth-step" wx:if="{{wxAuthStep === 'avatar'}}">
        <button class="login-wx-avatar-btn login-wx-avatar-btn--lg" open-type="chooseAvatar" bindchooseavatar="onWxChooseAvatar">
          <image class="login-wx-avatar login-wx-avatar--lg" src="{{wxAvatarUrl}}" mode="aspectFill" wx:if="{{wxAvatarUrl}}" />
          <view class="login-wx-avatar login-wx-avatar--lg login-wx-avatar--ph" wx:else>
            <text>点击授权头像</text>
          </view>
        </button>
      </view>
      <view class="login-wx-auth-step" wx:else>
        <image class="login-wx-avatar login-wx-avatar--sm" src="{{wxAvatarUrl}}" mode="aspectFill" wx:if="{{wxAvatarUrl}}" />
        <input
          id="login-wx-nick-input"
          class="login-wx-nick login-wx-nick--sheet"
          type="nickname"
          placeholder="点击选用微信昵称"
          value="{{wxNickName}}"
          bindfocus="onWxNicknameFocus"
          bindinput="onWxNicknameInput"
          bindblur="onWxNicknameBlur"
          bindnicknamereview="onWxNicknameReview"
          focus="{{wxNickInputFocus}}"
        />
        <button class="login-btn login-btn--wx" loading="{{loading}}" bindtap="onConfirmWxNickStep">完成登录</button>
      </view>
    </view>
  </view>

  <view class="login-id-sheet-mask" wx:if="{{showIdentitySheet}}" bindtap="onCloseIdentitySheet">
    <view class="login-id-sheet" catchtap="noopSheetTap">
      <view class="login-id-sheet-head">
        <text class="login-id-sheet-title">切换登录身份</text>
        <text class="login-id-sheet-close" bindtap="onCloseIdentitySheet">×</text>
      </view>
      <text class="login-id-sheet-hint">达人 / 拍摄 / 剪辑 / PR 四选一，选定后再登录</text>
      <view
        wx:for="{{identityOptions}}"
        wx:key="id"
        class="login-id-sheet-opt {{loginIdentity === item.id ? 'active' : ''}}"
        data-id="{{item.id}}"
        bindtap="onPickLoginIdentity"
      >
        <view class="login-id-sheet-icon-wrap">
          <image class="login-id-sheet-icon" src="{{item.icon}}" mode="aspectFit" />
        </view>
        <view class="login-id-sheet-body">
          <text class="login-id-sheet-name">{{item.label}}</text>
        </view>
        <text class="login-id-sheet-check" wx:if="{{loginIdentity === item.id}}">✓</text>
      </view>
    </view>
  </view>
</view>
