<view class="login-page">
  <view class="login-hero">
    <view class="login-hero__glow" aria-hidden="true" />
    <image class="login-logo" src="/images/logo.png" mode="aspectFit" />
    <text class="login-brand">灵祺撮合平台</text>
    <text class="login-tagline">本地生活 · 探店种草 · 云剪直派</text>
  </view>

  <view class="login-card">
    <view class="login-tabs">
      <view class="login-tab {{tab==='wx'?'login-tab--on':''}}" bindtap="onTabWx">微信登录</view>
      <view class="login-tab {{tab==='pwd'?'login-tab--on':''}}" bindtap="onTabPwd">账号密码</view>
    </view>

    <block wx:if="{{tab==='wx'}}">
      <button class="login-btn login-btn--wx" loading="{{loading}}" bindtap="onWxLogin">
        微信一键登录
      </button>
    </block>

    <block wx:else>
      <input class="login-input" placeholder="在「我的信息」中设置的登录名" value="{{loginName}}" bindinput="onLoginName" />
      <input
        class="login-input"
        password
        placeholder="密码（至少 6 位）"
        value="{{password}}"
        bindinput="onPassword"
      />
      <button class="login-btn login-btn--wx" loading="{{loading}}" bindtap="onPwdLogin">登录</button>
    </block>

    <text class="login-err" wx:if="{{err}}">{{err}}</text>
  </view>
</view>
