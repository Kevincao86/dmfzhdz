<view class="app-list-page pr-app-page">
  <view class="app-list-hero app-list-hero--split" wx:if="{{!loading && !err}}">
    <view class="app-list-hero__main">
      <text class="title-lg">{{title}}</text>
      <view class="app-list-hero__tags">
        <text class="app-list-hero__pill">{{hallLabel}}</text>
        <text class="app-list-hero__pill">{{statusLabel}}</text>
        <text class="app-list-hero__pill">已报名 {{applicants.length}} 人</text>
        <text class="app-list-hero__pill app-list-hero__pill--accent" wx:if="{{selectedCount > 0}}">已选 {{selectedCount}} 人</text>
      </view>
    </view>
    <view class="app-list-hero__side">
      <text class="app-list-hero__meta-line">单号 {{orderNo}}</text>
      <text class="app-list-hero__meta-line">发布 {{publishedAt}}</text>
      <text class="app-list-hero__meta-line">截止 {{deadlineText}}</text>
    </view>
  </view>

  <view wx:if="{{loading}}" class="card state-loading">
    <text class="hint">加载报名列表…</text>
  </view>
  <view wx:if="{{err}}" class="card state-empty">
    <text class="hint">{{err}}</text>
  </view>

  <view
    wx:for="{{applicants}}"
    wx:key="id"
    class="applicant-card-v2 {{item.selected ? 'applicant-card-v2--selected' : ''}}"
  >
    <view class="applicant-card-v2__top">
      <view class="applicant-card-v2__top-main">
        <image
          wx:if="{{item.avatar}}"
          class="applicant-card-v2__avatar"
          src="{{item.avatar}}"
          mode="aspectFill"
        />
        <view wx:else class="applicant-card-v2__avatar applicant-card-v2__avatar--ph">
          <image class="applicant-card-v2__avatar-logo" src="/images/logo.png" mode="aspectFit" />
        </view>
        <view class="applicant-card-v2__info">
          <view class="applicant-card-v2__name-row">
            <text class="applicant-card-v2__index">#{{item.index}}</text>
            <text class="applicant-card-v2__name">{{item.displayName}}</text>
          </view>
          <view class="applicant-card-v2__plat-row">
            <image class="applicant-card-v2__plat-icon" src="{{item.platformIcon}}" mode="aspectFill" />
            <text class="applicant-card-v2__plat-text">{{item.displayPlatform}} · 粉丝 {{item.displayFollowers}}</text>
            <text
              wx:for="{{item.accountTags}}"
              wx:for-item="tag"
              wx:key="*this"
              class="applicant-card-v2__tag"
            >{{tag}}</text>
          </view>
        </view>
      </view>
      <button
        class="applicant-card-v2__pick {{item.selected ? 'applicant-card-v2__pick--on' : ''}}"
        loading="{{savingSelect}}"
        data-index="{{index}}"
        catchtap="onToggleSelect"
      >{{item.selected ? '已选择' : '确认选择'}}</button>
    </view>

    <view class="applicant-card-v2__grid">
      <view class="applicant-card-v2__cell" wx:if="{{item.platformAccount}}">
        <text>平台账号</text>
        <text class="applicant-card-v2__cell-val">{{item.platformAccount}}</text>
      </view>
      <view class="applicant-card-v2__cell" wx:if="{{item.quotePrice}}">
        <text>报价</text>
        <text class="applicant-card-v2__cell-val">{{item.quotePrice}}</text>
      </view>
      <view class="applicant-card-v2__cell">
        <text>带货等级</text>
        <text class="applicant-card-v2__cell-val">{{item.displaySalesLevel}}</text>
      </view>
      <view class="applicant-card-v2__cell" wx:if="{{item.contact}}">
        <text>手机</text>
        <text class="applicant-card-v2__cell-val">{{item.contact}}</text>
      </view>
      <view class="applicant-card-v2__cell" wx:if="{{item.wechatId}}">
        <text>微信</text>
        <text class="applicant-card-v2__cell-val">{{item.wechatId}}</text>
      </view>
      <view class="applicant-card-v2__cell">
        <text>报名时间</text>
        <text class="applicant-card-v2__cell-val">{{item.displayAppliedAt}}</text>
      </view>
    </view>

    <view class="applicant-card-v2__actions" catchtap="noop">
      <button
        wx:if="{{item.hasProfileLink}}"
        class="applicant-card-v2__btn applicant-card-v2__btn--link"
        data-index="{{index}}"
        catchtap="onOpenProfile"
      >打开达人主页</button>
      <button
        wx:if="{{chatEnabled}}"
        class="applicant-card-v2__btn applicant-card-v2__btn--primary"
        loading="{{chattingId === item.id}}"
        data-index="{{index}}"
        catchtap="onChatApplicant"
      >私信沟通</button>
      <text class="applicant-card-v2__copy" bindtap="onCopyApplicant" data-index="{{index}}">复制全部资料</text>
    </view>
  </view>

  <view wx:if="{{!loading && !err && applicants.length === 0}}" class="card state-empty">
    <text class="hint">暂无达人报名，分享招募后等待达人提交</text>
  </view>

  <view class="pr-app-footer" wx:if="{{!loading && applicants.length > 0}}">
    <view class="pr-app-toolbar">
      <button class="pr-app-tool-btn" bindtap="onViewSelected">查看已选名单</button>
      <button
        class="pr-app-tool-btn {{groupQrImage ? 'pr-app-tool-btn--ok' : ''}}"
        loading="{{groupQrUploading}}"
        bindtap="onUploadGroupQr"
      >{{groupQrImage ? '已上传群码' : '上传群二维码'}}</button>
    </view>
    <view class="pr-app-toolbar">
      <button
        class="pr-app-tool-btn pr-app-tool-btn--primary"
        loading="{{exportingAll}}"
        bindtap="onExportAll"
      >下载全部明细</button>
      <button
        class="pr-app-tool-btn pr-app-tool-btn--notify"
        loading="{{notifying}}"
        bindtap="onNotifySelected"
      >通知已选达人</button>
    </view>
    <view class="pr-app-qr-preview" wx:if="{{groupQrImage}}" bindtap="onPreviewGroupQr">
      <image class="pr-app-qr-img" src="{{groupQrImage}}" mode="aspectFit" />
      <text class="hint">点击预览群二维码 · 通知已选达人时将随站内信发送</text>
    </view>
    <text class="hint pr-app-footer-hint">已选 {{selectedCount}} 人 · 请先上传群二维码再通知达人</text>
  </view>
</view>

<view
  class="pr-selected-mask"
  wx:if="{{showSelectedPanel}}"
  bindtap="onCloseSelectedPanel"
>
  <view class="pr-selected-sheet" catchtap="noop">
    <text class="pr-selected-title">已选达人（{{selectedCount}}）</text>
    <scroll-view scroll-y class="pr-selected-scroll">
      <view wx:for="{{selectedApplicants}}" wx:key="id" class="pr-selected-row">
        <view class="pr-selected-row__main">
          <view class="pr-selected-row__head">
            <text class="pr-selected-row__idx">#{{item.index}}</text>
            <text class="pr-selected-row__name">{{item.displayName}}</text>
          </view>
          <text class="pr-selected-row__sub">{{item.displayPlatform}} · {{item.quotePrice || '报价待定'}}</text>
        </view>
        <text
          class="pr-selected-row__cancel"
          data-id="{{item.id}}"
          catchtap="onDeselectFromPanel"
        >取消选择</text>
      </view>
    </scroll-view>
    <button class="pr-selected-close" bindtap="onCloseSelectedPanel">关闭</button>
  </view>
</view>
