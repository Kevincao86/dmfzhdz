@import '../../styles/theme.wxss';
@import '../../styles/application-cards.wxss';

.pr-app-page {
  padding-bottom: env(safe-area-inset-bottom);
}

.pr-app-bottom-spacer {
  height: calc(248rpx + env(safe-area-inset-bottom));
  flex-shrink: 0;
}

.pr-app-bottom-spacer--expanded {
  height: calc(420rpx + env(safe-area-inset-bottom));
}

.pr-app-bottom-spacer--ice {
  height: calc(168rpx + env(safe-area-inset-bottom));
}

.pr-app-footer {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 20;
  margin: 0;
  padding: 12rpx 24rpx calc(12rpx + env(safe-area-inset-bottom));
  background: linear-gradient(180deg, rgba(248, 250, 252, 0) 0%, rgba(248, 250, 252, 0.98) 18%, #f8fafc 100%);
  box-shadow: 0 -8rpx 24rpx rgba(15, 23, 42, 0.08);
  backdrop-filter: blur(8px);
}

.pr-app-toolbar {
  display: flex;
  gap: 12rpx;
  margin-bottom: 10rpx;
}

.pr-app-toolbar--last {
  margin-bottom: 0;
}

.pr-app-tool-btn {
  flex: 1;
  margin: 0;
  height: 64rpx;
  line-height: 64rpx;
  padding: 0 12rpx;
  font-size: 24rpx;
  font-weight: 600;
  border-radius: 999rpx;
  color: var(--lq-primary-dark);
  background: #fff;
  border: 2rpx solid var(--lq-primary-100);
}

.pr-app-tool-btn::after {
  border: none;
}

.pr-app-tool-btn--primary {
  color: #fff;
  background: var(--lq-gradient-tab);
  border-color: transparent;
  box-shadow: var(--lq-shadow-tab);
}

.pr-app-tool-btn--batch {
  color: #c2410c;
  border-color: #fdba74;
  background: #fff7ed;
}

.pr-app-tool-btn--active {
  color: #5b21b6;
  border-color: #a78bfa;
  background: #f5f3ff;
}

.applicant-card-v2__check {
  width: 40rpx;
  height: 40rpx;
  margin-right: 12rpx;
  margin-top: 8rpx;
  border-radius: 10rpx;
  border: 2rpx solid #cbd5e1;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  font-size: 24rpx;
  color: #fff;
  background: #fff;
}

.applicant-card-v2__check--on {
  background: #ea580c;
  border-color: #ea580c;
}

.pr-app-tool-btn--notify {
  color: #fff;
  background: linear-gradient(135deg, #7c3aed 0%, #a855f7 100%);
  border-color: transparent;
}

.pr-app-tool-btn--ok {
  color: #047857;
  border-color: #a7f3d0;
  background: #ecfdf5;
}

.pr-app-qr-preview {
  margin-top: 10rpx;
  padding: 12rpx;
  border-radius: 16rpx;
  background: #fff;
  border: 2rpx solid var(--lq-primary-100);
  text-align: center;
}

.pr-app-qr-replace {
  display: inline-block;
  margin-top: 8rpx;
  font-size: 22rpx;
  color: var(--lq-primary);
  padding: 4rpx 8rpx;
}

.pr-app-qr-img {
  width: 160rpx;
  height: 160rpx;
  display: block;
  margin: 0 auto 8rpx;
}

.pr-app-footer-hint {
  display: block;
  text-align: center;
  margin-top: 4rpx;
  font-size: 20rpx;
}

.pr-selected-mask {
  position: fixed;
  inset: 0;
  z-index: 100;
  background: rgba(15, 23, 42, 0.45);
  display: flex;
  align-items: flex-end;
}

.pr-selected-sheet {
  width: 100%;
  max-height: 70vh;
  padding: 28rpx 28rpx calc(28rpx + env(safe-area-inset-bottom));
  border-radius: 24rpx 24rpx 0 0;
  background: #fff;
}

.pr-selected-title {
  display: block;
  font-size: 32rpx;
  font-weight: 700;
  color: var(--lq-text);
  margin-bottom: 16rpx;
}

.pr-selected-scroll {
  max-height: 48vh;
}

.pr-selected-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  padding: 16rpx 0;
  border-bottom: 1rpx solid var(--lq-primary-100);
}

.pr-selected-row__main {
  flex: 1;
  min-width: 0;
}

.pr-selected-row__head {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.pr-selected-row__idx {
  font-size: 22rpx;
  font-weight: 700;
  color: var(--lq-primary-dark);
}

.pr-selected-row__name {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--lq-text);
}

.pr-selected-row__sub {
  display: block;
  margin-top: 6rpx;
  font-size: 22rpx;
  color: var(--lq-text-secondary);
}

.pr-selected-row__cancel {
  flex-shrink: 0;
  font-size: 24rpx;
  font-weight: 600;
  color: #dc2626;
  padding: 8rpx 4rpx;
}

.pr-selected-close {
  margin-top: 20rpx;
  width: 100%;
  background: var(--lq-gradient-tab);
  color: #fff;
  border-radius: 999rpx;
  font-weight: 600;
}

.pr-selected-close::after {
  border: none;
}

.applicant-card-v2__ice-status {
  flex-shrink: 0;
  font-size: 22rpx;
  font-weight: 600;
  color: var(--lq-primary-dark);
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  background: #eef2ff;
}

.ice-app-block {
  margin: 12rpx 0 0;
  padding: 16rpx;
  border-radius: 16rpx;
  background: #f8fafc;
  border: 1rpx solid var(--lq-primary-100);
}

.ice-app-link-row {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.ice-app-link-label {
  font-size: 22rpx;
  color: var(--lq-text-secondary);
}

.ice-app-link {
  font-size: 22rpx;
  color: #2563eb;
  word-break: break-all;
}

.ice-app-copy {
  align-self: flex-start;
  font-size: 22rpx;
  font-weight: 600;
  color: var(--lq-primary-dark);
  padding: 4rpx 0;
}

.ice-app-reject-note {
  display: block;
  margin-top: 10rpx;
  font-size: 22rpx;
  color: #dc2626;
}

.ice-app-review {
  display: flex;
  gap: 12rpx;
  margin-top: 12rpx;
}

.ice-app-pass,
.ice-app-reject {
  margin: 0;
  flex: 1;
  font-size: 24rpx;
  font-weight: 600;
  border-radius: 999rpx;
}

.ice-app-pass {
  color: #047857 !important;
  border-color: #a7f3d0 !important;
  background: #ecfdf5 !important;
}

.ice-app-reject {
  color: #dc2626 !important;
  border-color: #fecaca !important;
  background: #fef2f2 !important;
}

.ice-app-pass::after,
.ice-app-reject::after {
  border: none;
}

.pr-app-footer--ice {
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
}

.ice-reject-mask {
  position: fixed;
  inset: 0;
  z-index: 120;
  background: rgba(15, 23, 42, 0.45);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 32rpx;
}

.ice-reject-modal {
  width: 100%;
  max-width: 640rpx;
  padding: 28rpx;
  border-radius: 24rpx;
  background: #fff;
}

.ice-reject-hint {
  display: block;
  margin: 12rpx 0 16rpx;
}

.ice-reject-textarea {
  width: 100%;
  min-height: 160rpx;
  padding: 16rpx;
  box-sizing: border-box;
  border-radius: 16rpx;
  border: 2rpx solid var(--lq-primary-100);
  font-size: 26rpx;
}

.ice-reject-actions {
  display: flex;
  justify-content: flex-end;
  gap: 16rpx;
  margin-top: 16rpx;
}

.ice-reject-confirm {
  color: #dc2626 !important;
  border-color: #fecaca !important;
}

.pr-app-filters {
  margin-bottom: 16rpx;
  padding: 20rpx 24rpx;
}

.pr-app-filters__head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.pr-app-filters__title {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--lq-text);
}

.pr-app-filters__clear {
  font-size: 24rpx;
  color: var(--lq-primary);
}

.pr-app-filters__row {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  margin-bottom: 12rpx;
}

.pr-app-filters__row--pickers {
  flex-direction: row;
  align-items: stretch;
}

.pr-app-filters__row--pickers picker {
  flex: 1;
  min-width: 0;
}

.pr-app-filters__input,
.pr-app-filters__picker {
  width: 100%;
  box-sizing: border-box;
  min-height: 72rpx;
  padding: 0 20rpx;
  border-radius: 16rpx;
  border: 2rpx solid var(--lq-primary-100);
  background: #fff;
  font-size: 24rpx;
  color: var(--lq-text);
}

.pr-app-filters__row--pickers .pr-app-filters__picker {
  font-size: 22rpx;
  padding: 0 12rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.pr-app-filters__picker {
  display: flex;
  align-items: center;
}

.pr-app-filters__hint {
  display: block;
  margin-top: 4rpx;
}

.applicant-card-v2__tag--notify {
  color: #047857;
  background: #d1fae5;
}

.applicant-card-v2__tag--match {
  color: #0369a1;
  background: #e0f2fe;
}

.pr-app-page .applicant-card-v2 {
  margin-bottom: 16rpx;
}

.pr-app-schedule {
  margin: 16rpx 24rpx;
  padding: 24rpx;
}

.pr-app-schedule__title {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  margin-bottom: 8rpx;
}

.pr-app-schedule__input {
  margin-top: 16rpx;
  padding: 16rpx 20rpx;
  border: 1px solid #e5e7eb;
  border-radius: 12rpx;
  font-size: 26rpx;
}

.pr-app-schedule__row {
  margin: 12rpx 0 16rpx;
}
