.tpl-edit-page {
  padding-bottom: 160rpx;
}

.tpl-edit-sub {
  display: block;
  font-size: 24rpx;
  color: #64748b;
  margin-bottom: 20rpx;
}

.tpl-edit-hint {
  display: block;
  font-size: 22rpx;
  color: #94a3b8;
  margin-top: 8rpx;
}

.tpl-field-list {
  padding: 8rpx 24rpx 24rpx;
}

.tpl-field-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 20rpx 0;
  border-bottom: 2rpx solid #f1f5f9;
}

.tpl-field-row:last-of-type {
  border-bottom: none;
}

.tpl-field-type {
  width: 72rpx;
  flex-shrink: 0;
  text-align: center;
}

.tpl-field-type-txt {
  display: block;
  width: 56rpx;
  height: 56rpx;
  line-height: 56rpx;
  margin: 0 auto 4rpx;
  border-radius: 12rpx;
  background: #eff6ff;
  color: #2563eb;
  font-size: 26rpx;
  font-weight: 700;
}

.tpl-field-type-label {
  font-size: 20rpx;
  color: #94a3b8;
}

.tpl-field-main {
  flex: 1;
  min-width: 0;
}

.tpl-field-label {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: #0f172a;
  margin-bottom: 8rpx;
}

.tpl-field-req {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.tpl-field-req-txt {
  font-size: 22rpx;
  color: #64748b;
}

.tpl-req-switch {
  transform: scale(0.58);
  transform-origin: center right;
  margin-right: -8rpx;
}

.tpl-field-actions {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  flex-shrink: 0;
}

.tpl-field-btn {
  font-size: 22rpx;
  color: #2563eb;
  padding: 8rpx 12rpx;
}

.tpl-field-btn--danger {
  color: #ef4444;
}

.tpl-add-btn {
  width: 100%;
  margin-top: 24rpx;
  padding: 22rpx;
  box-sizing: border-box;
  text-align: center;
  font-size: 26rpx;
  font-weight: 500;
  color: #4338ca;
  background: #fff;
  border: 2rpx dashed #a5b4fc;
  border-radius: 16rpx;
}

.tpl-warn {
  margin-top: 24rpx;
  padding: 20rpx;
  border: 2rpx solid #fecaca;
  border-radius: 12rpx;
  background: #fef2f2;
  font-size: 22rpx;
  color: #b91c1c;
  line-height: 1.5;
}

.tpl-edit-footer {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  gap: 20rpx;
  padding: 20rpx 32rpx calc(20rpx + env(safe-area-inset-bottom));
  background: #fff;
  box-shadow: 0 -8rpx 32rpx rgba(15, 23, 42, 0.08);
  z-index: 100;
}

.tpl-footer-btn {
  flex: 1;
  margin: 0;
}

.tpl-modal-mask {
  position: fixed;
  inset: 0;
  background: rgba(15, 23, 42, 0.45);
  z-index: 200;
}

.tpl-modal {
  position: fixed;
  left: 32rpx;
  right: 32rpx;
  top: 50%;
  transform: translateY(-50%);
  background: #fff;
  border-radius: 24rpx;
  padding: 32rpx;
  z-index: 201;
}

.tpl-modal-title {
  display: block;
  font-size: 32rpx;
  font-weight: 700;
  margin-bottom: 24rpx;
}

.tpl-modal-readonly {
  font-size: 28rpx;
  color: #0f172a;
}

.tpl-modal-req {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.tpl-modal-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 32rpx;
}

.tpl-modal-actions button {
  flex: 1;
  margin: 0;
}

.tpl-preview-sheet {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  max-height: 78vh;
  background: #fff;
  border-radius: 24rpx 24rpx 0 0;
  z-index: 202;
  display: flex;
  flex-direction: column;
  padding-bottom: env(safe-area-inset-bottom);
}

.tpl-preview-head {
  position: relative;
  padding: 28rpx 32rpx 16rpx;
  border-bottom: 2rpx solid #f1f5f9;
}

.tpl-preview-title {
  display: block;
  font-size: 32rpx;
  font-weight: 700;
  color: #0f172a;
}

.tpl-preview-sub {
  display: block;
  font-size: 24rpx;
  color: #64748b;
  margin-top: 8rpx;
}

.tpl-preview-close {
  position: absolute;
  right: 32rpx;
  top: 32rpx;
  font-size: 26rpx;
  color: #2563eb;
}

.tpl-preview-scroll {
  flex: 1;
  max-height: 60vh;
  padding: 16rpx 32rpx 32rpx;
  box-sizing: border-box;
}

.tpl-preview-foot {
  display: block;
  margin-top: 24rpx;
}
