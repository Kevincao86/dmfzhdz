@import '../../styles/job-card-compact.wxss';

.fav-page {
  min-height: 100vh;
  padding-bottom: 32rpx;
}

.fav-empty {
  margin: 48rpx 28rpx;
  text-align: center;
}

.fav-empty-icon {
  display: block;
  font-size: 64rpx;
  margin-bottom: 16rpx;
}

.fav-card {
  margin: 16rpx 28rpx 0;
}

.fav-card__head {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
}

.fav-card__thumb {
  width: 120rpx;
  height: 120rpx;
  border-radius: 16rpx;
  flex-shrink: 0;
  background: var(--lq-primary-50);
}

.fav-card__thumb--ph {
  display: flex;
  align-items: center;
  justify-content: center;
}

.fav-card__thumb-icon {
  width: 52rpx;
  height: 52rpx;
}

.fav-card__main {
  flex: 1;
  min-width: 0;
}

.fav-card__title {
  display: block;
  font-size: 30rpx;
  font-weight: 700;
  color: #1e293b;
  line-height: 1.4;
}

.fav-card__meta {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #64748b;
}

.fav-card__unfav {
  flex-shrink: 0;
  padding: 8rpx 16rpx;
  font-size: 22rpx;
  color: #94a3b8;
  border: 1rpx solid #e2e8f0;
  border-radius: 999rpx;
}

.fav-card--missing .fav-card__title {
  color: #94a3b8;
}
