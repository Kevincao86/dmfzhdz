@import '../../styles/identity-themes.wxss';

.vr-page {
  padding-bottom: 32rpx;
}

.vr-head .vr-sub {
  display: block;
  margin-top: 8rpx;
}

.vr-stats {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 12rpx;
  margin-bottom: 16rpx;
}

.vr-stat {
  background: #fff;
  border-radius: 16rpx;
  border: 1rpx solid rgba(99, 102, 241, 0.12);
  padding: 16rpx 8rpx;
  text-align: center;
}

.vr-stat-num {
  display: block;
  font-size: 34rpx;
  font-weight: 700;
  color: #4f46e5;
}

.vr-stat-label {
  display: block;
  margin-top: 4rpx;
  font-size: 22rpx;
  color: #64748b;
}

.vr-card {
  margin-bottom: 16rpx;
}

.vr-card--active {
  border-color: rgba(99, 102, 241, 0.45);
  box-shadow: 0 8rpx 24rpx rgba(99, 102, 241, 0.12);
}

.vr-card-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
}

.vr-card-info {
  flex: 1;
  min-width: 0;
}

.vr-talent-meta {
  font-size: 24rpx;
  font-weight: 400;
  color: #64748b;
}

.vr-meta {
  display: block;
  margin-top: 8rpx;
}

.vr-card-side {
  flex-shrink: 0;
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 8rpx;
  max-width: 46%;
}

.vr-ai-status {
  font-size: 22rpx;
  line-height: 1.45;
  text-align: right;
  word-break: break-all;
}

.vr-ai-status--checking {
  color: #4b5563;
  font-weight: 500;
}

.vr-ai-status--pass {
  color: #16a34a;
  font-weight: 600;
}

.vr-ai-status--warn {
  color: #dc2626;
  font-weight: 500;
}

.vr-status {
  flex-shrink: 0;
  font-size: 22rpx;
  font-weight: 600;
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
}

.vr-status--pending {
  background: #fffbeb;
  color: #d97706;
}

.vr-status--passed {
  background: #ecfdf5;
  color: #059669;
}

.vr-status--rejected {
  background: #fef2f2;
  color: #dc2626;
}

.vr-reject {
  display: block;
  margin-top: 12rpx;
  padding: 12rpx 16rpx;
  border-radius: 12rpx;
  background: #fef2f2;
  color: #dc2626;
  font-size: 24rpx;
}

.vr-actions {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 24rpx;
  margin-top: 16rpx;
}

.vr-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 48rpx;
  font-size: 26rpx;
  font-weight: 600;
  color: #6366f1;
  padding: 8rpx 0;
  line-height: 1.2;
}

.vr-btn--ai {
  color: #0d9488;
}

.vr-batch-ai {
  padding: 16rpx 24rpx;
}

.vr-btn--batch {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 12rpx 24rpx;
  border-radius: 999rpx;
  background: rgba(16, 185, 129, 0.12);
  border: 1rpx solid rgba(16, 185, 129, 0.35);
  font-weight: 600;
}

.vr-btn--disabled {
  opacity: 0.6;
}

.vr-preview {
  margin-top: 16rpx;
  border-radius: 16rpx;
  overflow: hidden;
  background: #000;
}

.vr-video {
  width: 100%;
  height: 420rpx;
}

.vr-review-actions {
  display: flex;
  flex-direction: row;
  align-items: stretch;
  gap: 16rpx;
  margin-top: 16rpx;
}

.vr-pass,
.vr-reject-btn {
  flex: 1;
  margin: 0 !important;
  padding: 0 !important;
  height: 72rpx;
  line-height: 72rpx;
  font-size: 28rpx;
  font-weight: 600;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
}

.vr-pass {
  color: #059669 !important;
  border-color: #059669 !important;
}

.vr-reject-btn {
  color: #dc2626 !important;
  border-color: #dc2626 !important;
}

.vr-modal-mask {
  position: fixed;
  inset: 0;
  z-index: 1000;
  background: rgba(0, 0, 0, 0.45);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 32rpx;
  box-sizing: border-box;
}

.vr-modal {
  width: 100%;
  max-width: 640rpx;
  background: #fff;
  border-radius: 20rpx;
  padding: 28rpx;
  box-sizing: border-box;
}

.vr-modal-hint {
  display: block;
  margin-top: 8rpx;
}

.vr-textarea {
  width: 100%;
  min-height: 180rpx;
  margin-top: 20rpx;
  padding: 16rpx;
  box-sizing: border-box;
  border: 1rpx solid #e2e8f0;
  border-radius: 12rpx;
  font-size: 28rpx;
}

.vr-modal-actions {
  display: flex;
  justify-content: flex-end;
  gap: 16rpx;
  margin-top: 20rpx;
}

.vr-share {
  margin-bottom: 16rpx;
  border: 1rpx solid rgba(14, 165, 233, 0.18);
  background: linear-gradient(180deg, #f0f9ff 0%, #ffffff 48%);
}

.vr-share-head {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
}

.vr-share-head__icon {
  flex-shrink: 0;
  width: 72rpx;
  height: 72rpx;
  border-radius: 20rpx;
  background: linear-gradient(135deg, #0ea5e9 0%, #6366f1 100%);
  color: #fff;
  font-size: 34rpx;
  line-height: 72rpx;
  text-align: center;
  box-shadow: 0 8rpx 20rpx rgba(14, 165, 233, 0.28);
}

.vr-share-head__text .hint {
  display: block;
  margin-top: 8rpx;
}

.vr-share-actions {
  margin-top: 24rpx;
}

.vr-share-primary {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  min-height: 88rpx;
  padding: 20rpx 28rpx;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #0ea5e9 0%, #6366f1 100%);
  box-shadow: 0 10rpx 28rpx rgba(99, 102, 241, 0.28);
}

.vr-share-primary--busy {
  opacity: 0.72;
}

.vr-share-primary__icon {
  font-size: 30rpx;
  line-height: 1;
}

.vr-share-primary__label {
  font-size: 28rpx;
  font-weight: 700;
  color: #fff;
  line-height: 1.3;
}

.vr-share-secondary-row {
  display: flex;
  gap: 16rpx;
  margin-top: 16rpx;
}

.vr-share-secondary {
  flex: 1;
  min-height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 999rpx;
  border: 1rpx solid rgba(99, 102, 241, 0.28);
  background: #fff;
  color: #4f46e5;
  font-size: 26rpx;
  font-weight: 600;
}

.vr-share-secondary--danger {
  border-color: rgba(220, 38, 38, 0.22);
  color: #dc2626;
  background: #fff5f5;
}

.vr-share-secondary--btn {
  margin: 0;
  padding: 0;
  line-height: normal;
  font-weight: 600;
  font-size: 26rpx;
}

.vr-share-secondary--btn::after {
  border: none;
}

.vr-share-url {
  margin-top: 20rpx;
  padding: 20rpx;
  background: #fff;
  border: 1rpx dashed rgba(14, 165, 233, 0.35);
  border-radius: 16rpx;
  word-break: break-all;
}

.vr-share-url__label {
  display: block;
  font-size: 22rpx;
  font-weight: 600;
  color: #0369a1;
  margin-bottom: 8rpx;
}

.vr-share-url__text {
  display: block;
  font-size: 24rpx;
  color: #334155;
  line-height: 1.5;
}

.vr-share-exp {
  display: block;
  margin-top: 10rpx;
  color: #64748b;
}

.vr-share-feedback {
  margin-top: 16rpx;
  padding: 16rpx;
  background: #fffbeb;
  border: 1rpx solid #fde68a;
  border-radius: 12rpx;
}

.vr-share-feedback__title {
  display: block;
  font-size: 26rpx;
  font-weight: 600;
  margin-bottom: 8rpx;
}

.vr-share-feedback__item {
  padding: 10rpx 0;
  border-bottom: 1rpx solid #fef3c7;
  font-size: 24rpx;
  color: #64748b;
}

.vr-share-feedback__item:last-child {
  border-bottom: none;
}

.vr-share-feedback__text {
  display: block;
  color: #334155;
  margin-top: 4rpx;
}

.vr-share-tag {
  display: inline-block;
  margin-right: 8rpx;
  padding: 2rpx 8rpx;
  background: #ede9fe;
  color: #6d28d9;
  border-radius: 6rpx;
  font-size: 22rpx;
}
