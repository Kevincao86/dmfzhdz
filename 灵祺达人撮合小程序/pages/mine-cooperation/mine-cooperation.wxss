.page { padding: 24rpx; background: #f5f7fb; min-height: 100vh; }
.card { background: #fff; border-radius: 20rpx; padding: 28rpx; margin-bottom: 24rpx; }
.title { font-size: 32rpx; font-weight: 600; }
.hint { display: block; margin: 12rpx 0 20rpx; font-size: 24rpx; color: #64748b; line-height: 1.5; }
.btn { border-radius: 999rpx; font-size: 26rpx; margin-top: 12rpx; }
.btn.danger { background: #fee2e2; color: #b91c1c; }
.btn.sm { margin-top: 16rpx; font-size: 24rpx; }
.row.between { display: flex; justify-content: space-between; align-items: center; }
.name { font-size: 30rpx; font-weight: 600; color: #0f172a; }
.score { font-size: 24rpx; color: #0284c7; }
.sub { display: block; margin-top: 8rpx; font-size: 24rpx; color: #64748b; }
.note { display: block; margin-top: 8rpx; font-size: 24rpx; color: #334155; }
.tags { margin-top: 12rpx; display: flex; flex-wrap: wrap; gap: 8rpx; }
.tag { background: #e0f2fe; color: #0369a1; font-size: 22rpx; padding: 4rpx 12rpx; border-radius: 8rpx; }
.empty { text-align: center; color: #94a3b8; padding: 80rpx 0; font-size: 28rpx; }
