<web-view
  wx:if="{{embed && url && !embedFailed}}"
  src="{{url}}"
  binderror="onWebViewError"
></web-view>
<view wx:else class="web-link-fallback page-shell">
  <view class="web-link-card card">
    <text class="web-link-title">打开原表报名</text>
    <text class="web-link-hint">{{embedFailed ? '小程序内无法直接嵌入该页面（需配置业务域名），链接已复制。' : '报名工具 / 探鲸 / 派单等原表若未配置业务域名，请复制链接到微信聊天中打开。'}}</text>
    <text class="web-link-url">{{url}}</text>
    <button class="web-link-btn" bindtap="copyLink">{{copied ? '已复制，点此再复制' : '复制原表链接'}}</button>
    <text class="web-link-guide">请粘贴到「文件传输助手」或任意微信聊天，点击链接即可打开原表填写报名。</text>
  </view>
</view>
