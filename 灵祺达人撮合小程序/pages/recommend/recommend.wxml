<view class="rec-page page-with-bar page-shell-fixed">
  <view class="rec-top">
    <view class="rec-head-band lq-hero-header" style="{{recHeadBandStyle}}">
      <view class="lq-hero-bg lq-hero-bg--rec" aria-hidden="true">
        <view class="lq-hero-bg__pattern" />
        <view class="lq-hero-bg__glow lq-hero-bg__glow--2" />
      </view>
      <view class="rec-head-inner lq-hero-header__inner" style="{{recHeadInnerStyle}}">
        <image class="rec-head-logo" src="/images/logo.png" mode="aspectFit" />
        <view class="rec-head-main">
          <view class="rec-head-title-row">
            <text class="rec-hero-title">推荐大厅</text>
            <view class="rec-hero-badge">AI</view>
          </view>
          <text class="rec-hero-sub" wx:if="{{talentTestMode}}">预览 PR 端推荐大厅 · 置顶您的达人资料</text>
          <text class="rec-hero-sub" wx:elif="{{isPrMode}}">智能识别 PR 身份 · 达人 / 拍摄 / 剪辑分板块 · 按匹配分排序</text>
          <text class="rec-hero-sub" wx:else>智能识别{{identityLabel}}身份 · 按标签与习惯匹配商单</text>
          <text class="rec-head-meta" wx:if="{{!isPrMode && orderCityHint}}">{{orderCityHint}}</text>
          <text class="rec-head-meta" wx:elif="{{isPrMode && prMatchHint}}">{{prMatchHint}}</text>
          <text class="rec-head-meta" wx:elif="{{isPrMode}}">灵祺 LINGQI · 星选平台</text>
        </view>
      </view>
    </view>

    <view class="rec-search-bar">
      <text class="rec-search-icon">⌕</text>
      <input
        class="rec-search-input"
        placeholder="{{isPrMode ? prSearchPlaceholder : '搜索商单、门店、城市'}}"
        placeholder-class="rec-search-ph"
        value="{{searchKeyword}}"
        confirm-type="search"
        bindinput="onSearchInput"
        bindconfirm="onSearchConfirm"
      />
      <text class="rec-search-clear" wx:if="{{searchKeyword}}" bindtap="onSearchClear">×</text>
    </view>

    <view class="rec-test-bar" wx:if="{{talentTestMode}}">
      <text class="rec-test-bar__text">{{talentTestHint}}</text>
      <text class="rec-test-bar__link" bindtap="goEditSelfProfile">去完善资料 ›</text>
    </view>

    <view class="rec-seg-bar lq-gradient-tabs rec-seg-bar--pr" wx:if="{{isPrMode}}">
      <view
        wx:for="{{prBoardSegments}}"
        wx:key="id"
        class="rec-seg-item lq-gradient-tabs__item {{prBoard === item.id ? 'rec-seg-item--on lq-gradient-tabs__item--on' : ''}}"
        data-id="{{item.id}}"
        bindtap="onPrBoard"
      >
        {{item.label}}
      </view>
    </view>

    <view class="rec-pr-controls" wx:if="{{isPrMode}}">
      <view class="rec-match-order-bar">
        <text class="rec-match-order-label">匹配招募单</text>
        <view class="rec-match-order-picker" bindtap="openPrMatchOrderSheet">
          <view class="rec-match-order-value">
            <text class="rec-match-order-text">{{prMatchOrderLabel}}</text>
            <text class="rec-match-order-arrow">▼</text>
          </view>
        </view>
      </view>

      <view class="rec-view-mode-bar rec-view-mode-bar--inline">
      <text class="rec-view-mode-label">浏览模式</text>
      <view
        class="rec-view-mode-item {{prViewMode === 'ai' ? 'rec-view-mode-item--on' : ''}}"
        data-mode="ai"
        bindtap="onPrViewMode"
      >智能匹配</view>
      <view
        class="rec-view-mode-item {{prViewMode === 'all' ? 'rec-view-mode-item--on' : ''}}"
        data-mode="all"
        bindtap="onPrViewMode"
      >{{prAllModeLabel}}</view>
      </view>
    </view>

    <view class="rec-seg-bar lq-gradient-tabs" wx:if="{{!isPrMode}}">
      <view
        wx:for="{{orderSegments}}"
        wx:key="id"
        class="rec-seg-item lq-gradient-tabs__item {{orderSegment === item.id ? 'rec-seg-item--on lq-gradient-tabs__item--on' : ''}}"
        data-id="{{item.id}}"
        bindtap="onOrderSegment"
      >
        {{item.label}}
      </view>
    </view>

    <view class="rec-filter-bar">
      <view class="rec-filter-cell">
        <picker mode="selector" range="{{platformFilters}}" bindchange="onPlatformFilter">
          <view class="rec-filter-item {{filterPlatform !== '全部' ? 'rec-filter-item--on' : ''}}">
            <text class="rec-filter-label">{{filterPlatform === '全部' ? '平台' : filterPlatform}}</text>
            <text class="rec-filter-arrow">▾</text>
          </view>
        </picker>
      </view>
      <view class="rec-filter-cell">
        <picker mode="selector" range="{{cityFilters}}" bindchange="onCityFilter">
          <view class="rec-filter-item {{filterCity !== '全部' ? 'rec-filter-item--on' : ''}}">
            <text class="rec-filter-label">{{filterCity === '全部' ? '城市' : filterCity}}</text>
            <text class="rec-filter-arrow">▾</text>
          </view>
        </picker>
      </view>
      <block wx:if="{{isPrMode}}">
        <view class="rec-filter-cell">
          <picker mode="selector" range="{{tagFilters}}" bindchange="onTagFilter">
            <view class="rec-filter-item {{filterTag !== '全部' ? 'rec-filter-item--on' : ''}}">
              <text class="rec-filter-label">{{filterTag === '全部' ? '标签' : filterTag}}</text>
              <text class="rec-filter-arrow">▾</text>
            </view>
          </picker>
        </view>
        <view class="rec-filter-cell">
          <picker mode="selector" range="{{genderFilters}}" bindchange="onGenderFilter">
            <view class="rec-filter-item {{filterGender !== '全部' ? 'rec-filter-item--on' : ''}}">
              <text class="rec-filter-label">{{filterGender === '全部' ? '性别' : filterGender}}</text>
              <text class="rec-filter-arrow">▾</text>
            </view>
          </picker>
        </view>
        <view class="rec-filter-cell">
          <picker mode="selector" range="{{statusFilters}}" bindchange="onStatusFilter">
            <view class="rec-filter-item {{filterStatus !== '全部' ? 'rec-filter-item--on' : ''}}">
              <text class="rec-filter-label">{{filterStatus === '全部' ? '筛选' : filterStatus}}</text>
              <text class="rec-filter-arrow">▾</text>
            </view>
          </picker>
        </view>
      </block>
      <view class="rec-filter-cell" wx:else>
        <view
          class="rec-filter-item {{priceSelected.length ? 'rec-filter-item--on' : ''}}"
          bindtap="onOpenPriceSheet"
        >
          <text class="rec-filter-label">{{priceFilterLabel}}</text>
          <text class="rec-filter-arrow">▾</text>
        </view>
      </view>
    </view>
  </view>

  <scroll-view class="rec-scroll page-scroll-body" scroll-y enhanced show-scrollbar="{{false}}">
    <view wx:if="{{loading}}" class="rec-state card state-loading">
      <view class="rec-load-ring" />
      <text class="rec-load-title">{{isPrMode ? '智能匹配准备中' : '加载商单中'}}</text>
      <text class="hint list-hint">{{isPrMode ? '正在同步达人库与发单要求…' : '正在拉取推荐商单…'}}</text>
    </view>

    <view wx:elif="{{err}}" class="rec-state card state-error">
      <text>{{err}}</text>
    </view>

    <block wx:elif="{{isPrMode}}">
    <view
      wx:for="{{displayRows}}"
      wx:key="id"
      class="talent-card-compact {{item.isPreview ? 'talent-card-compact--preview' : ''}} {{item.isSelfTest ? 'talent-card-compact--self' : ''}}"
    >
      <text class="talent-preview-tag" wx:if="{{item.isSelfTest}}">我的</text>
      <text class="talent-preview-tag" wx:elif="{{item.isPreview}}">预览</text>
      <text
        wx:if="{{item.aiTag && !item.isPreview}}"
        class="talent-ai-tag talent-ai-tag--{{item.aiTagTone}}"
      >{{item.aiTag}}</text>
      <text class="talent-match-ribbon" wx:if="{{prViewMode === 'ai' && item.matchScore > 0 && !item.isPreview}}">匹配度 {{item.matchScore}}</text>
      <view class="talent-card-compact__row">
        <view class="talent-avatar-wrap">
          <image class="talent-avatar" src="{{item.avatar || '/images/logo.png'}}" mode="aspectFill" />
          <view class="talent-online-dot" wx:if="{{item.online}}" />
        </view>
        <view class="talent-card-compact__main">
          <view class="talent-line1">
            <text class="talent-nick">{{item.name}}</text>
            <view class="talent-platform-pill">
              <image class="talent-platform-icon" src="{{item.platformIcon}}" mode="aspectFit" />
              <text>{{item.platform}}</text>
            </view>
          </view>
          <view class="talent-line2">
            <text class="talent-meta talent-meta--match" wx:if="{{prViewMode === 'ai' && item.matchScore > 0}}">匹配度 {{item.matchScore}}</text>
            <text class="talent-meta-sep" wx:if="{{prViewMode === 'ai' && item.matchScore > 0}}">·</text>
            <text class="talent-meta" wx:if="{{!item.isSupplier}}">粉 {{item.followers}}</text>
            <text class="talent-meta-sep" wx:if="{{!item.isSupplier}}">·</text>
            <text class="talent-meta talent-meta--grade">{{item.salesGrade}}</text>
          </view>
          <view class="talent-line3" wx:if="{{item.tags.length || item.region || item.chatMutual || item.favorited}}">
            <text class="talent-tag" wx:for="{{item.tags}}" wx:key="*this" wx:for-item="tg">{{tg}}</text>
            <text class="talent-tag talent-tag--muted" wx:if="{{item.region}}">{{item.region}}</text>
            <text class="talent-status-tag talent-status-tag--chat" wx:if="{{item.chatMutual}}">已沟通</text>
            <text class="talent-status-tag talent-status-tag--fav" wx:if="{{item.favorited}}">已收藏</text>
          </view>
        </view>
        <view class="talent-card-actions">
          <view
            class="talent-fav-star {{item.favorited ? 'talent-fav-star--on' : ''}}"
            catchtap="onToggleFavorite"
            data-id="{{item.id}}"
            aria-role="button"
            aria-label="{{item.favorited ? '取消收藏' : '收藏达人'}}"
          >
            <text class="talent-fav-star-glyph">★</text>
          </view>
          <button class="talent-chat-mini" data-id="{{item.id}}" bindtap="onChatTap" hover-class="talent-chat-mini--hover">
            沟通
          </button>
        </view>
      </view>
    </view>
    <view wx:if="{{listEmptyHint}}" class="rec-foot-hint">
      <text class="hint">{{listEmptyHint}}</text>
    </view>
    </block>

    <block wx:else>
    <view
      wx:for="{{orderDisplayRows}}"
      wx:key="id"
      class="job-card-compact"
      bindtap="goOrderDetail"
      data-id="{{item.id}}"
      data-mock="{{item.isMock}}"
      hover-class="job-card-compact--hover"
    >
      <text
        wx:if="{{item.aiTag}}"
        class="job-card-compact__ai-tag"
        style="background:{{item.aiTagBg}};color:{{item.aiTagFg}};"
      >{{item.aiTag}}</text>
      <text class="job-card-compact__ribbon job-card-compact__ribbon--demo" wx:if="{{item.isMock && !item.aiTag}}">演示</text>
      <text class="job-card-compact__ribbon" wx:elif="{{item.aiMatch && !item.aiTag}}">AI荐</text>
      <text class="job-card-compact__ribbon" wx:elif="{{item.recommended && !item.aiTag}}">优质</text>
      <view class="job-card-compact__row">
        <image
          wx:if="{{item.hallIconKind !== 'badge'}}"
          class="job-card-compact__icon"
          src="{{item.platformIcon}}"
          mode="aspectFill"
        />
        <view
          wx:else
          class="job-card-compact__icon job-card-compact__icon--badge {{item.hallIconClass}}"
        >
          <text class="job-card-compact__icon-text">{{item.hallIconText}}</text>
        </view>
        <view class="job-card-compact__main">
          <text class="job-card-compact__title">{{item.title}}</text>
            <view class="job-card-compact__line2">
              <text class="job-card-compact__tag job-card-compact__tag--match" wx:if="{{item.matchScore > 0 && !item.isMock}}">匹配度 {{item.matchScore}}</text>
              <text class="job-card-compact__tag">{{item.statusLabel}}</text>
              <text class="job-card-compact__tag job-card-compact__tag--full" wx:if="{{item.iceSlotsFull}}">已收满</text>
              <text class="job-card-compact__tag job-card-compact__tag--hot" wx:elif="{{item.overRecruitHot}}">🔥 爆满</text>
              <text class="job-card-compact__tag job-card-compact__tag--gray">{{item.signupCountText}}</text>
              <text class="job-card-compact__tag job-card-compact__tag--urgent" wx:if="{{item.urgent}}">急单</text>
            </view>
            <view class="job-card-compact__fee" wx:if="{{item.budgetDisplay.kind === 'tiers'}}">
              <text class="job-card-compact__fee-cps" wx:if="{{item.budgetDisplay.cps}}">{{item.budgetDisplay.cps}}</text>
              <text class="job-card-compact__fee-mode">{{item.budgetDisplay.mode}} · {{item.budgetDisplay.summary}}</text>
              <view class="job-card-compact__fee-chips">
                <text
                  wx:for="{{item.budgetDisplay.chips}}"
                  wx:key="label"
                  wx:for-item="chip"
                  class="job-card-compact__tier-chip"
                >{{chip.label}} {{chip.price}}</text>
                <text wx:if="{{item.budgetDisplay.moreCount > 0}}" class="job-card-compact__tier-more">+{{item.budgetDisplay.moreCount}}档</text>
              </view>
            </view>
            <text wx:else class="job-card-compact__price job-card-compact__price--solo">{{item.budgetDisplay.line}}</text>
            <text class="job-card-compact__line3">{{item.region}} · {{item.platform}} · {{item.categoryTagsText}}</text>
          </view>
        </view>
        <text
          wx:if="{{item.signupCountdownText}}"
          class="job-card-compact__countdown job-card-compact__countdown--{{item.signupCountdownTone || 'unknown'}}"
        >{{item.signupCountdownText}}</text>
      </view>
    <view wx:if="{{orderEmptyHint}}" class="rec-foot-hint">
      <text class="hint">{{orderEmptyHint}}</text>
    </view>
    </block>
  </scroll-view>

  <view
    class="price-sheet-mask"
    wx:if="{{showPriceSheet && !isPrMode}}"
    bindtap="onClosePriceSheet"
  >
    <view class="price-sheet" catchtap="noopSheetTap">
      <view class="price-sheet-head">
        <text class="price-sheet-title">价格筛选（可多选）</text>
        <text class="price-sheet-close" bindtap="onClosePriceSheet">×</text>
      </view>
      <view class="price-chip-grid">
        <view
          wx:for="{{priceBuckets}}"
          wx:key="id"
          class="price-chip {{item.selected ? 'price-chip--on' : ''}}"
          data-id="{{item.id}}"
          bindtap="onTogglePrice"
        >
          {{item.label}}
        </view>
      </view>
      <view class="price-sheet-foot">
        <button class="price-sheet-reset" bindtap="onResetPrice">清空</button>
        <button class="price-sheet-ok" bindtap="onConfirmPrice">确定</button>
      </view>
    </view>
  </view>

  <view class="rec-order-sheet-mask" wx:if="{{showPrMatchOrderSheet}}" bindtap="closePrMatchOrderSheet">
    <view class="rec-order-sheet" catchtap="noopSheetTap">
      <view class="rec-order-sheet-head">
        <text class="rec-order-sheet-title">选择招募单</text>
        <text class="rec-order-sheet-close" bindtap="closePrMatchOrderSheet">×</text>
      </view>
      <view class="rec-order-sheet-search">
        <input
          class="rec-order-sheet-input"
          placeholder="搜索招募标题、单号"
          placeholder-class="rec-order-sheet-ph"
          value="{{prMatchOrderKeyword}}"
          bindinput="onPrMatchOrderKeyword"
          focus="{{showPrMatchOrderSheet}}"
        />
      </view>
      <scroll-view class="rec-order-sheet-list" scroll-y>
        <view
          wx:for="{{prMatchOrderFiltered}}"
          wx:key="id"
          class="rec-order-sheet-item {{prMatchOrderId === item.id ? 'rec-order-sheet-item--on' : ''}}"
          data-id="{{item.id}}"
          bindtap="onPrMatchOrderPick"
        >
          <text class="rec-order-sheet-item-label">{{item.label}}</text>
          <text class="rec-order-sheet-item-sub" wx:if="{{item.title && item.title !== item.label}}">{{item.title}}</text>
        </view>
        <view wx:if="{{!prMatchOrderFiltered.length}}" class="rec-order-sheet-empty">暂无匹配招募单</view>
      </scroll-view>
    </view>
  </view>

  <view wx:if="{{matchingLoading}}" class="rec-match-overlay" catchtouchmove="true">
    <view class="rec-match-card">
      <view class="rec-match-ring" />
      <text class="rec-match-title">智能匹配中</text>
      <text class="rec-match-sub">正在按发单要求计算匹配分</text>
    </view>
  </view>
</view>
