<view class="rec-page page-with-bar page-shell-fixed {{lqThemeClass}} {{isPrMode ? 'rec-page--pr' : ''}}">
  <view class="rec-top">
    <!-- 达人端：标题 + 横滑区 -->
    <block wx:if="{{!isPrMode}}">
      <view class="rec-nav" style="{{recHeadBandStyle}}">
        <view class="rec-nav-inner">
          <view class="rec-nav-brand">
            <text class="rec-nav-title">推荐大厅</text>
            <view class="rec-nav-badge">
              <text class="rec-nav-badge__spark">✦</text>
              <text>Ai</text>
            </view>
          </view>
        </view>
      </view>

      <view class="rec-ai-panel">
        <view class="rec-ai-panel__head">
          <view class="rec-ai-panel__title-wrap">
            <text class="rec-ai-panel__spark">✦</text>
            <view class="rec-ai-panel__copy">
              <text class="rec-ai-panel__title">{{stripTitle}}</text>
              <text class="rec-ai-panel__sub">{{stripSub}}</text>
            </view>
          </view>
          <text class="rec-ai-panel__refresh" bindtap="onSpotlightRefresh" wx:if="{{spotlightRows.length}}">换一批</text>
        </view>
        <scroll-view class="rec-ai-panel__scroll" scroll-x enhanced show-scrollbar="{{false}}" wx:if="{{spotlightRows.length}}">
          <view class="rec-ai-panel__row">
            <view
              wx:for="{{spotlightRows}}"
              wx:key="id"
              class="rec-ai-card"
              bindtap="goOrderDetail"
              data-id="{{item.id}}"
              data-mock="{{item.isMock}}"
            >
              <view class="rec-ai-card__thumb-wrap">
                <image
                  class="rec-ai-card__thumb"
                  src="{{item.coverThumb || item.platformIcon}}"
                  mode="aspectFill"
                />
                <image class="rec-ai-card__plat" src="{{item.platformIcon}}" mode="aspectFit" />
                <text
                  wx:if="{{stripMode !== 'ai' && item.stripLabel}}"
                  class="rec-ai-card__ribbon {{item.stripKind === 'city' ? 'rec-ai-card__ribbon--city' : 'rec-ai-card__ribbon--hot'}}"
                >{{item.stripLabel}}</text>
              </view>
              <text class="rec-ai-card__title">{{item.cardTitle || item.title}}</text>
              <view class="rec-ai-card__foot">
                <block wx:if="{{stripMode === 'ai' && item.matchScore > 0}}">
                  <view class="rec-ai-card__match-wrap">
                    <text class="rec-ai-card__match-label">匹配度</text>
                    <text class="rec-ai-card__match">{{item.matchScore}}%</text>
                  </view>
                </block>
                <block wx:elif="{{stripMode !== 'ai'}}">
                  <text
                    class="rec-ai-card__strip {{item.stripKind === 'city' ? 'rec-ai-card__strip--city' : 'rec-ai-card__strip--hot'}}"
                  >{{item.spotlightTag}}</text>
                </block>
                <text class="rec-ai-card__tag">{{stripMode === 'ai' ? item.spotlightTag : (item.cardBudgetLine || item.category || '')}}</text>
              </view>
            </view>
          </view>
        </scroll-view>
        <view class="rec-strip-empty" wx:else>
          <text class="rec-strip-empty__text">{{stripSub || '暂无推荐商单'}}</text>
        </view>
        <view class="rec-ai-panel__dots" wx:if="{{spotlightDots.length > 1 && spotlightRows.length}}">
          <view
            wx:for="{{spotlightDots}}"
            wx:key="*this"
            class="rec-ai-dot {{spotlightDotIndex === item ? 'rec-ai-dot--on' : ''}}"
          />
        </view>
      </view>
    </block>

    <!-- PR / 预览：紧凑顶栏（对齐达人端 rec-nav） -->
    <block wx:else>
      <view class="rec-nav" style="{{recHeadBandStyle}}">
        <view class="rec-nav-inner" style="{{recHeadInnerStyle}}">
          <view class="rec-nav-brand">
            <text class="rec-nav-title">灵祺星选</text>
            <view class="rec-nav-badge">
              <text class="rec-nav-badge__spark">✦</text>
              <text>AI</text>
            </view>
          </view>
        </view>
      </view>
    </block>

    <view class="rec-pr-locked" wx:if="{{isPrMode && prRecommendLocked}}">
      <view class="rec-pr-locked__icon">🔒</view>
      <text class="rec-pr-locked__title">推荐大厅即将开放使用</text>
      <text class="rec-pr-locked__desc">智能荐达人、匹配招募单与达人库检索为增值能力，需由灵祺运营在后台为您开通后方可使用。</text>
      <text class="rec-pr-locked__hint">如有合作意向请联系灵祺运营申请开通。</text>
      <view class="rec-pr-locked__box">
        <text class="rec-pr-locked__box-title">包含能力</text>
        <text class="rec-pr-locked__bullet">· AI 智能推荐达人</text>
        <text class="rec-pr-locked__bullet">· 全部达人库检索</text>
        <text class="rec-pr-locked__bullet">· 按招募单智能匹配</text>
      </view>
    </view>

    <block wx:elif="{{isPrMode}}">
    <view class="rec-pr-hot-strip">
      <view class="rec-ai-panel rec-pr-hot-strip__panel">
        <view class="rec-ai-panel__head">
          <view class="rec-ai-panel__title-wrap">
            <text class="rec-ai-panel__spark">✦</text>
            <view class="rec-ai-panel__copy">
              <text class="rec-ai-panel__title">热门达人推荐</text>
              <text class="rec-ai-panel__sub">AI 智能匹配优质达人，左右滑动查看更多</text>
            </view>
          </view>
        </view>
        <scroll-view class="rec-ai-panel__scroll" scroll-x enhanced show-scrollbar="{{false}}" wx:if="{{prHotTalentRows.length}}">
          <view class="rec-ai-panel__row">
            <view
              wx:for="{{prHotTalentRows}}"
              wx:key="id"
              class="rec-pr-hot-card"
              bindtap="onChatTap"
              data-id="{{item.id}}"
            >
              <image class="rec-pr-hot-card__avatar" src="{{item.avatar || '/images/logo.png'}}" mode="aspectFill" />
              <text class="rec-pr-hot-card__name">{{item.name}}</text>
              <text class="rec-pr-hot-card__match" wx:if="{{item.matchScore > 0}}">匹配度 {{item.matchScore}}%</text>
              <text class="rec-pr-hot-card__tag" wx:if="{{item.primaryTag}}">{{item.primaryTag}}</text>
            </view>
          </view>
        </scroll-view>
        <view class="rec-strip-empty rec-strip-empty--pr" wx:else>
          <text class="rec-strip-empty__text">暂无推荐达人，发招募后将智能匹配</text>
        </view>
      </view>
    </view>

    <view class="rec-search-bar" wx:if="{{isPrMode}}">
      <text class="rec-search-icon">⌕</text>
      <input
        class="rec-search-input"
        placeholder="{{isPrMode ? prSearchPlaceholder : '搜索商单、门店、城市'}}"
        placeholder-class="rec-search-ph"
        value="{{searchKeyword}}"
        confirm-type="search"
        bindinput="onSearchInput"
        bindconfirm="onSearchConfirm"
      />
      <text class="rec-search-clear" wx:if="{{searchKeyword}}" bindtap="onSearchClear">×</text>
    </view>

    <view class="rec-test-bar" wx:if="{{talentTestMode}}">
      <text class="rec-test-bar__text">{{talentTestHint}}</text>
      <text class="rec-test-bar__link" bindtap="goEditSelfProfile">去完善资料 ›</text>
    </view>

    <view class="rec-seg-bar lq-gradient-tabs rec-seg-bar--pr" wx:if="{{isPrMode}}">
      <view
        wx:for="{{prBoardSegments}}"
        wx:key="id"
        class="rec-seg-item lq-gradient-tabs__item {{prBoard === item.id ? 'rec-seg-item--on lq-gradient-tabs__item--on' : ''}}"
        data-id="{{item.id}}"
        bindtap="onPrBoard"
      >
        {{item.label}}
      </view>
    </view>

    <view class="rec-pr-mode-bar" wx:if="{{isPrMode}}">
      <view class="rec-pr-toolbar__modes rec-pr-toolbar__modes--bar">
        <view
          class="rec-view-mode-item {{prViewMode === 'ai' ? 'rec-view-mode-item--on' : ''}}"
          data-mode="ai"
          bindtap="onPrViewMode"
        >AI 智能推荐</view>
        <view
          class="rec-view-mode-item {{prViewMode === 'all' ? 'rec-view-mode-item--on' : ''}}"
          data-mode="all"
          bindtap="onPrViewMode"
        >{{prAllModeLabel}}</view>
      </view>
    </view>

    <view class="rec-pr-toolbar" wx:if="{{isPrMode}}">
      <view class="rec-pr-toolbar__match" bindtap="openPrMatchOrderSheet">
        <text class="rec-pr-toolbar__match-prefix">匹配招募单：</text>
        <text class="rec-pr-toolbar__match-value">{{prMatchOrderLabel}}</text>
        <text class="rec-pr-toolbar__match-arrow">▾</text>
      </view>
    </view>
    </block>

    <view class="rec-seg-bar lq-gradient-tabs" wx:if="{{!isPrMode}}">
      <view
        wx:for="{{orderSegments}}"
        wx:key="id"
        class="rec-seg-item lq-gradient-tabs__item {{orderSegment === item.id ? 'rec-seg-item--on lq-gradient-tabs__item--on' : ''}}"
        data-id="{{item.id}}"
        bindtap="onOrderSegment"
      >
        {{item.label}}
      </view>
    </view>

    <view class="rec-filter-v2" wx:if="{{!isPrMode}}">
      <view
        class="rec-filter-v2__cell"
        bindtap="onResetAllFilters"
      >
        <text class="rec-filter-v2__label {{allFiltersDefault ? 'rec-filter-v2__label--on' : ''}}">全部</text>
      </view>
      <view class="rec-filter-v2__cell">
        <picker mode="selector" range="{{platformFilters}}" bindchange="onPlatformFilter">
          <view class="rec-filter-v2__picker">
            <text class="rec-filter-v2__label {{filterPlatform !== '全部' ? 'rec-filter-v2__label--on' : ''}}">{{filterPlatform === '全部' ? '平台' : filterPlatform}}</text>
            <text class="rec-filter-v2__arrow">▾</text>
          </view>
        </picker>
      </view>
      <view class="rec-filter-v2__cell">
        <picker mode="selector" range="{{categoryFilters}}" bindchange="onCategoryFilter">
          <view class="rec-filter-v2__picker">
            <text class="rec-filter-v2__label {{filterCategory !== '全部' ? 'rec-filter-v2__label--on' : ''}}">{{filterCategory === '全部' ? '品类' : filterCategory}}</text>
            <text class="rec-filter-v2__arrow">▾</text>
          </view>
        </picker>
      </view>
      <view class="rec-filter-v2__cell" bindtap="onOpenPriceSheet">
        <view class="rec-filter-v2__picker">
          <text class="rec-filter-v2__label {{priceSelected.length ? 'rec-filter-v2__label--on' : ''}}">{{priceFilterLabel}}</text>
          <text class="rec-filter-v2__arrow">▾</text>
        </view>
      </view>
      <view class="rec-filter-v2__cell">
        <picker
          mode="multiSelector"
          range="{{regionMultiRange}}"
          value="{{regionMultiValue}}"
          bindcolumnchange="onRegionFilterColumnChange"
          bindchange="onRegionFilterChange"
        >
          <view class="rec-filter-v2__picker">
            <text class="rec-filter-v2__label {{filterProvince !== '全部' || filterCity !== '全部' ? 'rec-filter-v2__label--on' : ''}}">{{regionFilterLabel}}</text>
            <text class="rec-filter-v2__arrow">▾</text>
          </view>
        </picker>
      </view>
      <view class="rec-filter-v2__adv" bindtap="onOpenFilterSheet" aria-role="button" aria-label="高级筛选">
        <text class="rec-filter-v2__adv-icon">⫶</text>
      </view>
    </view>

    <view class="rec-filter-bar" wx:elif="{{isPrMode}}">
      <view class="rec-filter-cell">
        <picker mode="selector" range="{{platformFilters}}" bindchange="onPlatformFilter">
          <view class="rec-filter-item {{filterPlatform !== '全部' ? 'rec-filter-item--on' : ''}}">
            <text class="rec-filter-label">{{filterPlatform === '全部' ? '平台' : filterPlatform}}</text>
            <text class="rec-filter-arrow">▾</text>
          </view>
        </picker>
      </view>
      <view class="rec-filter-cell">
        <picker mode="selector" range="{{cityFilters}}" bindchange="onCityFilter">
          <view class="rec-filter-item {{filterCity !== '全部' ? 'rec-filter-item--on' : ''}}">
            <text class="rec-filter-label">{{filterCity === '全部' ? '城市' : filterCity}}</text>
            <text class="rec-filter-arrow">▾</text>
          </view>
        </picker>
      </view>
      <block wx:if="{{isPrMode}}">
        <view class="rec-filter-cell">
          <picker mode="selector" range="{{tagFilters}}" bindchange="onTagFilter">
            <view class="rec-filter-item {{filterTag !== '全部' ? 'rec-filter-item--on' : ''}}">
              <text class="rec-filter-label">{{filterTag === '全部' ? '标签' : filterTag}}</text>
              <text class="rec-filter-arrow">▾</text>
            </view>
          </picker>
        </view>
        <view class="rec-filter-cell">
          <picker mode="selector" range="{{genderFilters}}" bindchange="onGenderFilter">
            <view class="rec-filter-item {{filterGender !== '全部' ? 'rec-filter-item--on' : ''}}">
              <text class="rec-filter-label">{{filterGender === '全部' ? '性别' : filterGender}}</text>
              <text class="rec-filter-arrow">▾</text>
            </view>
          </picker>
        </view>
        <view class="rec-filter-cell">
          <picker mode="selector" range="{{statusFilters}}" bindchange="onStatusFilter">
            <view class="rec-filter-item {{filterStatus !== '全部' ? 'rec-filter-item--on' : ''}}">
              <text class="rec-filter-label">{{filterStatus === '全部' ? '筛选' : filterStatus}}</text>
              <text class="rec-filter-arrow">▾</text>
            </view>
          </picker>
        </view>
      </block>
    </view>
  </view>

  <scroll-view class="rec-scroll page-scroll-body" scroll-y enhanced show-scrollbar="{{false}}">
    <view wx:if="{{loading}}" class="rec-state card state-loading">
      <view class="loading-dot-wrap">
        <view class="loading-dot" />
        <view class="loading-dot" />
        <view class="loading-dot" />
      </view>
      <text class="hint list-hint">{{isPrMode ? '智能匹配中…' : '加载商单中…'}}</text>
    </view>

    <view wx:elif="{{err}}" class="rec-state card state-error">
      <text>{{err}}</text>
    </view>

    <block wx:elif="{{isPrMode && !prRecommendLocked}}">
    <view
      wx:for="{{displayRows}}"
      wx:key="id"
      class="talent-card-pr {{item.isPreview ? 'talent-card-pr--preview' : ''}} {{item.isSelfTest ? 'talent-card-pr--self' : ''}}"
    >
      <text class="talent-preview-tag" wx:if="{{item.isSelfTest}}">我的</text>
      <text class="talent-preview-tag" wx:elif="{{item.isPreview}}">预览</text>
      <text
        wx:if="{{item.aiTag && !item.isPreview}}"
        class="talent-ai-tag talent-ai-tag--{{item.aiTagTone}}"
      >{{item.aiTag}}</text>
      <view class="talent-card-pr__row">
        <view class="talent-card-pr__avatar-wrap">
          <image class="talent-card-pr__avatar" src="{{item.avatar || '/images/logo.png'}}" mode="aspectFill" />
          <view class="talent-card-pr__online" wx:if="{{item.online}}" />
        </view>
        <view class="talent-card-pr__main">
          <view class="talent-card-pr__name-row">
            <text class="talent-card-pr__name">{{item.name}}</text>
            <text
              wx:if="{{item.genderSymbol}}"
              class="talent-card-pr__gender talent-card-pr__gender--{{item.genderClass}}"
            >{{item.genderSymbol}}</text>
            <text class="talent-card-pr__tag-pill" wx:if="{{item.primaryTag}}">{{item.primaryTag}}</text>
          </view>
          <view class="talent-card-pr__fans-row" wx:if="{{!item.isSupplier}}">
            <text class="talent-card-pr__fans">粉丝 {{item.followers}}</text>
            <image class="talent-card-pr__plat" src="{{item.platformIcon}}" mode="aspectFit" />
          </view>
          <view class="talent-card-pr__city-row" wx:if="{{item.cityDisplay}}">
            <text class="talent-card-pr__pin">📍</text>
            <text class="talent-card-pr__city">{{item.cityDisplay}}</text>
          </view>
          <view class="talent-card-pr__status-row" wx:if="{{item.chatMutual || item.favorited}}">
            <text class="talent-status-tag talent-status-tag--chat" wx:if="{{item.chatMutual}}">已沟通</text>
            <text class="talent-status-tag talent-status-tag--fav" wx:if="{{item.favorited}}">已收藏</text>
          </view>
        </view>
        <view class="talent-card-pr__aside">
          <view
            class="talent-fav-star {{item.favorited ? 'talent-fav-star--on' : ''}}"
            catchtap="onToggleFavorite"
            data-id="{{item.id}}"
            aria-role="button"
            aria-label="{{item.favorited ? '取消收藏' : '收藏达人'}}"
          >
            <text class="talent-fav-star-glyph">★</text>
          </view>
          <view class="talent-card-pr__match" wx:if="{{prViewMode === 'ai' && item.matchScore > 0}}">
            <text class="talent-card-pr__match-label">匹配度</text>
            <text class="talent-card-pr__match-val">{{item.matchScore}}%</text>
          </view>
          <button
            wx:if="{{item.hasProfileLink}}"
            class="talent-card-pr__profile"
            data-id="{{item.id}}"
            catchtap="onProfileTap"
            hover-class="talent-card-pr__profile--hover"
          >{{item.profileLinkLabel || '主页'}}</button>
          <button
            class="talent-card-pr__chat"
            data-id="{{item.id}}"
            bindtap="onChatTap"
            hover-class="talent-card-pr__chat--hover"
          >沟通</button>
        </view>
      </view>
      <view class="talent-card-pr__advantage" wx:if="{{!item.isPreview}}">
        <text class="talent-card-pr__advantage-label">AI解读</text>
        <text class="talent-card-pr__advantage-text">{{item.cardAdvantage || item.aiAdvantage || '暂无解读'}}</text>
      </view>
    </view>
    <view wx:if="{{listEmptyHint}}" class="rec-foot-hint">
      <text class="hint">{{listEmptyHint}}</text>
    </view>
    </block>

    <block wx:elif="{{!isPrMode}}">
    <view
      wx:for="{{orderDisplayRows}}"
      wx:key="id"
      class="job-card-rec"
      bindtap="goOrderDetail"
      data-id="{{item.id}}"
      data-mock="{{item.isMock}}"
      hover-class="job-card-rec--hover"
    >
      <text class="job-card-rec__ribbon job-card-rec__ribbon--demo" wx:if="{{item.isMock}}">演示</text>
      <view
        class="job-card-rec__fav {{item.favorited ? 'job-card-rec__fav--on' : ''}}"
        catchtap="onToggleOrderFavorite"
        data-id="{{item.id}}"
        aria-role="button"
        aria-label="{{item.favorited ? '取消收藏' : '收藏商单'}}"
      >
        <text class="job-card-rec__fav-glyph">★</text>
      </view>
      <view class="job-card-rec__body">
        <view class="job-card-rec__thumb-wrap">
          <image
            class="job-card-rec__thumb"
            src="{{item.coverThumb || item.platformIcon}}"
            mode="aspectFill"
          />
          <image class="job-card-rec__plat" src="{{item.platformIcon}}" mode="aspectFit" />
        </view>
        <view class="job-card-rec__main">
          <view class="job-card-rec__ai-pill" wx:if="{{item.matchScore > 0 && !item.isMock}}">
            <text class="job-card-rec__ai-pill-text">AI 匹配 {{item.matchScore}}%</text>
          </view>
          <view class="job-card-rec__title-row">
            <text class="job-card-rec__badge job-card-rec__badge--urgent" wx:if="{{item.urgent}}">急</text>
            <text class="job-card-rec__badge job-card-rec__badge--new" wx:elif="{{item.recommended}}">新</text>
            <text class="job-card-rec__title">{{item.cardTitle || item.title}}</text>
          </view>
          <view class="job-card-rec__tags" wx:if="{{item.displayTags && item.displayTags.length}}">
            <text
              wx:for="{{item.displayTags}}"
              wx:key="*this"
              wx:for-item="tg"
              class="job-card-rec__tag"
            >{{tg}}</text>
          </view>
          <view class="job-card-rec__advantage">
            <text class="job-card-rec__advantage-label">AI解读</text>
            <text class="job-card-rec__advantage-text">{{item.cardAdvantage || item.aiAdvantage || '暂无解读'}}</text>
          </view>
          <view class="job-card-rec__meta-row">
            <text class="job-card-rec__plat-info">{{item.cardFansLine}}</text>
            <text class="job-card-rec__signup" wx:if="{{item.signupCountText}}">{{item.signupCountText}}</text>
            <view class="job-card-rec__budget" wx:if="{{item.cardBudgetLine}}">
              <text class="job-card-rec__budget-val">{{item.cardBudgetLine}}</text>
              <text class="job-card-rec__budget-lbl">预算</text>
            </view>
          </view>
        </view>
      </view>
      <text
        wx:if="{{item.signupCountdownText}}"
        class="job-card-rec__countdown job-card-rec__countdown--{{item.signupCountdownTone || 'unknown'}}"
      >{{item.signupCountdownText}}</text>
    </view>
    <view wx:if="{{orderEmptyHint}}" class="rec-foot-hint">
      <text class="hint">{{orderEmptyHint}}</text>
    </view>
    </block>
    <site-icp-footer />
  </scroll-view>

  <view
    class="price-sheet-mask"
    wx:if="{{showPriceSheet && !isPrMode}}"
    bindtap="onClosePriceSheet"
  >
    <view class="price-sheet" catchtap="noopSheetTap">
      <view class="price-sheet-head">
        <text class="price-sheet-title">预算筛选（可多选）</text>
        <text class="price-sheet-close" bindtap="onClosePriceSheet">×</text>
      </view>
      <view class="price-chip-grid">
        <view
          wx:for="{{priceBuckets}}"
          wx:key="id"
          class="price-chip {{item.selected ? 'price-chip--on' : ''}}"
          data-id="{{item.id}}"
          bindtap="onTogglePrice"
        >
          {{item.label}}
        </view>
      </view>
      <view class="price-sheet-foot">
        <button class="price-sheet-reset" bindtap="onResetPrice">清空</button>
        <button class="price-sheet-ok" bindtap="onConfirmPrice">确定</button>
      </view>
    </view>
  </view>

  <view class="rec-order-sheet-mask" wx:if="{{showPrMatchOrderSheet}}" bindtap="closePrMatchOrderSheet">
    <view class="rec-order-sheet" catchtap="noopSheetTap">
      <view class="rec-order-sheet-head">
        <text class="rec-order-sheet-title">选择招募单</text>
        <text class="rec-order-sheet-close" bindtap="closePrMatchOrderSheet">×</text>
      </view>
      <view class="rec-order-sheet-search">
        <input
          class="rec-order-sheet-input"
          placeholder="搜索招募标题、单号"
          placeholder-class="rec-order-sheet-ph"
          value="{{prMatchOrderKeyword}}"
          bindinput="onPrMatchOrderKeyword"
          focus="{{showPrMatchOrderSheet}}"
        />
      </view>
      <scroll-view class="rec-order-sheet-list" scroll-y>
        <view
          wx:for="{{prMatchOrderFiltered}}"
          wx:key="id"
          class="rec-order-sheet-item {{prMatchOrderId === item.id ? 'rec-order-sheet-item--on' : ''}}"
          data-id="{{item.id}}"
          bindtap="onPrMatchOrderPick"
        >
          <text class="rec-order-sheet-item-label">{{item.label}}</text>
          <text class="rec-order-sheet-item-sub" wx:if="{{item.title && item.title !== item.label}}">{{item.title}}</text>
        </view>
        <view wx:if="{{!prMatchOrderFiltered.length}}" class="rec-order-sheet-empty">暂无匹配招募单</view>
      </scroll-view>
    </view>
  </view>
</view>
