<view class="page-shell {{lqThemeClass}}">
  <view wx:if="{{mineGuestMode}}" class="card state-empty">
    <text class="state-empty-icon">🔒</text>
    <text class="empty-title">请登录后管理专属报价</text>
    <text class="hint">返回「我的」完成微信登录</text>
  </view>

  <block wx:else>
    <view class="card apply-form">
      <view class="section-head">
        <view class="section-head-dot" />
        <text class="section-title">已设置的专属价</text>
      </view>
      <text class="form-hint">同一{{isSupplierQuotes ? '报价类型' : '平台'}}可设置多个 PR 专属价（如 PR1、PR2 各不同价格）</text>
      <view wx:if="{{!quoteGroups.length}}" class="form-hint">暂无专属 PR 报价，可在下方添加</view>
      <block wx:for="{{quoteGroups}}" wx:key="platform" wx:for-item="group">
        <view class="quote-platform-head">{{group.platform}}</view>
        <view
          wx:for="{{group.items}}"
          wx:for-item="item"
          wx:key="prLingqiId"
          class="quote-list-item"
        >
          <view class="quote-list-main">
            <text class="quote-list-title">{{item.prDisplayName || item.prLingqiId}} · ¥{{item.quoteYuan}}</text>
            <text class="quote-list-sub">{{item.prLingqiId}}{{item.note ? ' · ' + item.note : ''}}</text>
          </view>
          <view class="quote-list-actions">
            <view
              class="quote-action quote-action--edit"
              catchtap="onEditQuote"
              data-prid="{{item.prLingqiId}}"
              data-platform="{{item.platform}}"
            >
              编辑
            </view>
            <view
              class="quote-action quote-action--delete"
              catchtap="onRemoveQuote"
              data-prid="{{item.prLingqiId}}"
              data-platform="{{item.platform}}"
            >
              删除
            </view>
          </view>
        </view>
      </block>
    </view>

    <view class="card apply-form quote-form-anchor">
      <view class="section-head">
        <view class="section-head-dot" />
        <text class="section-title">{{editingKey ? '编辑专属 PR 报价' : '添加专属 PR 报价'}}</text>
      </view>
      <text class="form-hint" wx:if="{{!editingKey}}">可输入 PRID 精准匹配，或输入名称/手机号模糊搜索后点选；保存后可继续添加下一个 PR</text>
      <text class="form-hint" wx:else>修改报价或备注后点「保存修改」；PR 与{{dimensionLabel}}不可变更</text>

      <view class="form-row">
        <text class="form-label">{{dimensionLabel}}</text>
        <view class="platform-chip-row {{editingKey ? 'platform-chip-row--locked' : ''}}">
          <view
            wx:for="{{platformOptions}}"
            wx:key="name"
            class="platform-chip {{item.name === platformName ? 'platform-chip--on' : ''}}"
            data-name="{{item.name}}"
            bindtap="onPlatformPick"
          >
            {{item.name}}
          </view>
        </view>
      </view>

      <view class="form-row">
        <text class="form-label">PR（PRID / 名称）</text>
        <input
          class="input"
          placeholder="LQ-P-000003 或 PR 名称"
          value="{{prQuery}}"
          disabled="{{!!editingKey}}"
          confirm-type="search"
          bindinput="onPrQueryInput"
          bindconfirm="onPrQueryConfirm"
          bindfocus="onPrQueryFocus"
        />
      </view>

      <view wx:if="{{!editingKey && (prSearchLoading || prSearchResults.length || prSearchEmpty)}}" class="pr-search-list">
        <view wx:if="{{prSearchLoading}}" class="pr-search-item pr-search-item--hint">搜索中…</view>
        <block wx:elif="{{prSearchResults.length}}">
          <view
            wx:for="{{prSearchResults}}"
            wx:for-index="idx"
            wx:key="lingqiPrId"
            class="pr-search-item"
            hover-class="pr-search-item--active"
            data-index="{{idx}}"
            bindtap="onPickPr"
          >
            <text class="pr-search-name">{{item.displayName}}</text>
            <text class="pr-search-meta">{{item.lingqiPrId}}{{item.city ? ' · ' + item.city : ''}}</text>
          </view>
        </block>
        <view wx:elif="{{prSearchEmpty}}" class="pr-search-item pr-search-item--hint">未找到匹配的 PR，请检查名称或改用 PRID</view>
      </view>

      <view class="form-row">
        <text class="form-label">PRID</text>
        <input
          class="input"
          placeholder="LQ-P-000003"
          value="{{exclusivePrId}}"
          disabled="{{!!editingKey}}"
          data-k="exclusivePrId"
          bindinput="onField"
        />
      </view>

      <view class="form-row">
        <text class="form-label">PR 名称（选填）</text>
        <input
          class="input"
          placeholder="便于识别"
          value="{{exclusivePrName}}"
          data-k="exclusivePrName"
          bindinput="onField"
        />
      </view>

      <view class="form-row">
        <text class="form-label">专属报价（元） *</text>
        <input class="input" type="digit" placeholder="请填写报价" value="{{exclusiveQuoteYuan}}" data-k="exclusiveQuoteYuan" bindinput="onField" />
      </view>

      <view class="form-row">
        <text class="form-label">备注（选填）</text>
        <input class="input" placeholder="如：长期合作价" value="{{exclusiveNote}}" data-k="exclusiveNote" bindinput="onField" />
      </view>

      <button class="btn-primary" loading="{{saving}}" disabled="{{saving}}" bindtap="onAddQuote">
        {{editingKey ? '保存修改' : '保存专属报价'}}
      </button>
      <button wx:if="{{editingKey}}" class="btn-secondary quote-cancel-btn" bindtap="onCancelEdit">取消编辑</button>
    </view>
  </block>
</view>
