<view class="pr-page page-shell">
  <view class="pr-tab-bar">
    <view
      class="pr-tab-chip {{tab === 'published' ? 'pr-tab-chip--on' : ''}}"
      data-tab="published"
      bindtap="onTabTap"
    >
      招募单<text wx:if="{{publishedCount > 0}}" class="pr-tab-count">({{publishedCount}})</text>
    </view>
    <view
      class="pr-tab-chip {{tab === 'stopped' ? 'pr-tab-chip--on' : ''}}"
      data-tab="stopped"
      bindtap="onTabTap"
    >
      已停止<text wx:if="{{stoppedCount > 0}}" class="pr-tab-count">({{stoppedCount}})</text>
    </view>
    <view
      class="pr-tab-chip {{tab === 'deleted' ? 'pr-tab-chip--on' : ''}}"
      data-tab="deleted"
      bindtap="onTabTap"
    >
      已删除<text wx:if="{{deletedCount > 0}}" class="pr-tab-count">({{deletedCount}})</text>
    </view>
  </view>

  <view
    wx:if="{{(tab === 'published' && publishedCount > 0) || (tab === 'stopped' && stoppedCount > 0) || (tab === 'deleted' && deletedCount > 0)}}"
    class="pr-list-toolbar"
  >
    <view class="pr-search-bar">
      <text class="pr-search-icon" aria-hidden="true">⌕</text>
      <input
        class="pr-search-input"
        type="text"
        placeholder="搜索招募标题、城市、单号"
        placeholder-class="pr-search-ph"
        value="{{keyword}}"
        bindinput="onKeywordInput"
        confirm-type="search"
      />
    </view>
    <scroll-view class="pr-target-scroll" scroll-x enable-flex show-scrollbar="{{false}}">
      <view class="pr-target-row">
        <view
          wx:for="{{targetOptions}}"
          wx:key="id"
          class="pr-target-chip {{filterTarget === item.id ? 'pr-target-chip--on' : ''}}"
          data-id="{{item.id}}"
          bindtap="onTargetChipTap"
        >
          {{item.label}}
        </view>
      </view>
    </scroll-view>
    <view class="pr-filter-bar">
      <view class="pr-filter-cell">
        <picker mode="selector" range="{{platformOptions}}" bindchange="onPlatformChange">
          <view class="pr-filter-item {{filterPlatform !== '全部' ? 'pr-filter-item--on' : ''}}">
            <text class="pr-filter-label">{{platformLabel}}</text>
            <text class="pr-filter-arrow">▾</text>
          </view>
        </picker>
      </view>
      <view class="pr-filter-cell">
        <picker mode="selector" range="{{categoryOptions}}" bindchange="onCategoryChange">
          <view class="pr-filter-item {{filterCategory !== '全部' ? 'pr-filter-item--on' : ''}}">
            <text class="pr-filter-label">{{categoryLabel}}</text>
            <text class="pr-filter-arrow">▾</text>
          </view>
        </picker>
      </view>
      <view class="pr-filter-cell">
        <picker mode="selector" range="{{hallOptions}}" bindchange="onHallChange">
          <view class="pr-filter-item {{filterHall !== '全部' ? 'pr-filter-item--on' : ''}}">
            <text class="pr-filter-label">{{hallLabel}}</text>
            <text class="pr-filter-arrow">▾</text>
          </view>
        </picker>
      </view>
      <view class="pr-filter-cell">
        <picker mode="selector" range="{{cityOptions}}" bindchange="onCityChange">
          <view class="pr-filter-item {{filterCity !== '全部' ? 'pr-filter-item--on' : ''}}">
            <text class="pr-filter-label">{{cityLabel}}</text>
            <text class="pr-filter-arrow">▾</text>
          </view>
        </picker>
      </view>
    </view>
    <text wx:if="{{filterCountText}}" class="pr-filter-count">{{filterCountText}}</text>
  </view>

  <view wx:if="{{loading}}" class="card"><text class="hint">加载中…</text></view>
  <view wx:if="{{err}}" class="card"><text class="hint">{{err}}</text></view>

  <view
    wx:for="{{filteredRows}}"
    wx:key="mpOrderId"
    class="card pr-order-card"
  >
    <view class="pr-order-head" bindtap="goApplicants" data-id="{{item.mpOrderId}}">
      <text class="title-lg">{{item.title || item.mpOrderId}}</text>
      <text class="pr-order-status {{item.recruiting ? 'pr-order-status--on' : 'pr-order-status--off'}}">{{item.statusLabel}}</text>
    </view>
    <text class="hint" bindtap="goApplicants" data-id="{{item.mpOrderId}}">
      <block wx:if="{{item.isDeleted || item.deletedAt}}">删除于 {{item.deletedAt || '—'}}</block>
      <block wx:else>发布于 {{item.publishedAt}} · {{item.hallLabel}}</block>
    </text>
    <text wx:if="{{!item.isDeleted && !item.deletedAt}}" class="hint pr-order-deadline" bindtap="goApplicants" data-id="{{item.mpOrderId}}">截止：{{item.deadlineDaysText}}</text>
    <view class="pr-order-actions" wx:if="{{!item.isDeleted && !item.deletedAt && !item.isRemovedFromRegistry}}">
      <text
        wx:if="{{item.canToggleRecruit}}"
        class="pr-order-action"
        catchtap="onToggleStatus"
        data-id="{{item.mpOrderId}}"
      >{{item.toggleActionLabel}}</text>
      <text class="pr-order-action" catchtap="onEdit" data-id="{{item.mpOrderId}}">编辑</text>
      <text class="pr-order-action" catchtap="onShare" data-id="{{item.mpOrderId}}">分享</text>
      <text class="pr-order-action pr-order-action--danger" catchtap="onDelete" data-id="{{item.mpOrderId}}">删除</text>
    </view>
    <text wx:if="{{item.isDeleted || item.deletedAt}}" class="hint pr-order-archived-hint">该发单已从招募大厅移除，仅保留历史记录</text>
    <text wx:elif="{{item.isRemovedFromRegistry}}" class="hint pr-order-archived-hint">该发单已从招募大厅移除，仅保留历史记录</text>
    <view class="pr-order-meta" wx:if="{{!item.isDeleted && !item.deletedAt && !item.isRemovedFromRegistry}}">
      <text class="pr-order-badge">{{item.signupLabel}}</text>
      <view class="pr-order-meta-right">
        <text
          class="pr-order-link pr-order-link--video {{item.pendingVideoCount > 0 ? 'pr-order-link--pending' : ''}}"
          catchtap="goVideoReview"
          data-id="{{item.mpOrderId}}"
        >{{item.videoReviewLabel}}</text>
        <text
          class="pr-order-link"
          catchtap="onDownload"
          data-id="{{item.mpOrderId}}"
        >下载</text>
        <text class="pr-order-link" catchtap="goApplicants" data-id="{{item.mpOrderId}}">查看报名 ›</text>
      </view>
    </view>
  </view>

  <view wx:if="{{!loading && tab === 'published' && publishedCount === 0}}" class="card state-empty">
    <text class="hint">暂无发单，去「发招募」创建</text>
  </view>

  <view wx:if="{{!loading && tab === 'stopped' && stoppedCount === 0}}" class="card state-empty">
    <text class="hint">暂无已停止发单</text>
  </view>

  <view wx:if="{{!loading && tab === 'deleted' && deletedCount === 0}}" class="card state-empty">
    <text class="hint">暂无已删除发单</text>
  </view>

  <view wx:if="{{!loading && filteredRows.length === 0 && ((tab === 'published' && publishedCount > 0) || (tab === 'stopped' && stoppedCount > 0) || (tab === 'deleted' && deletedCount > 0))}}" class="card state-empty">
    <text class="hint">当前筛选条件下暂无发单</text>
  </view>

  <view class="pr-share-sheet-mask" wx:if="{{showShareSheet}}" bindtap="onCloseShareSheet">
    <view class="pr-share-sheet" catchtap="noopShareSheetTap">
      <view class="pr-share-sheet-head">
        <text class="pr-share-sheet-title">分享招募</text>
        <text class="pr-share-sheet-close" bindtap="onCloseShareSheet">×</text>
      </view>
      <text wx:if="{{shareTitle}}" class="pr-share-sheet-sub">{{shareTitle}}</text>

      <view class="pr-share-tabs">
        <view
          class="pr-share-tab {{shareTab === 'copy' ? 'pr-share-tab-active' : ''}}"
          bindtap="onShareTab"
          data-tab="copy"
        >文案+链接</view>
        <view
          class="pr-share-tab {{shareTab === 'poster' ? 'pr-share-tab-active' : ''}}"
          bindtap="onShareTab"
          data-tab="poster"
        >海报</view>
        <view
          class="pr-share-tab {{shareTab === 'link' ? 'pr-share-tab-active' : ''}}"
          bindtap="onShareTab"
          data-tab="link"
        >链接</view>
      </view>

      <view wx:if="{{shareTab === 'copy'}}" class="pr-share-panel">
        <view class="pr-share-sheet-item" bindtap="onShareCopyText">复制招募文案</view>
        <button class="pr-share-sheet-item pr-share-sheet-btn" open-type="share">分享小程序卡片</button>
        <view class="pr-share-sheet-item" bindtap="onShareTimelineTap">分享朋友圈（复制文案）</view>
      </view>

      <view wx:elif="{{shareTab === 'poster'}}" class="pr-share-panel pr-share-poster-panel">
        <view wx:if="{{sharePosterLoading}}" class="pr-share-poster-loading">生成海报中…</view>
        <image
          wx:elif="{{sharePosterPath}}"
          class="pr-share-poster-img"
          src="{{sharePosterPath}}"
          mode="widthFix"
          show-menu-by-longpress="{{true}}"
        />
        <text wx:else class="pr-share-poster-err">{{sharePosterErr || '海报生成失败'}}</text>
        <view wx:if="{{sharePosterPath || sharePosterStyleLabel}}" class="pr-share-poster-style-row">
          <text wx:if="{{sharePosterStyleLabel}}" class="pr-share-poster-style-label">当前样式：{{sharePosterStyleLabel}}</text>
          <text class="pr-share-poster-style-btn" bindtap="onSwitchPosterStyle">换个样式</text>
        </view>
        <view
          wx:if="{{sharePosterPath}}"
          class="pr-share-sheet-item pr-share-poster-save"
          bindtap="onSaveSharePoster"
        >保存海报到相册</view>
        <button
          wx:if="{{sharePosterPath}}"
          class="pr-share-sheet-item pr-share-sheet-btn"
          open-type="share"
        >分享小程序卡片</button>
      </view>

      <view wx:elif="{{shareTab === 'link'}}" class="pr-share-panel">
        <text class="pr-share-link-label">报名链接</text>
        <text class="pr-share-link-text">{{shareApplyLink || '生成中…'}}</text>
        <view class="pr-share-sheet-item" bindtap="onShareCopyLink">复制报名链接</view>
      </view>

      <view class="pr-share-sheet-cancel" bindtap="onCloseShareSheet">取消</view>
    </view>
  </view>
</view>
