@import '../../styles/theme.wxss';

.pr-tab-bar {
  display: flex;
  gap: 12rpx;
  padding: 16rpx 0 8rpx;
}

.pr-tab-chip {
  flex: 1;
  text-align: center;
  padding: 16rpx 12rpx;
  font-size: 26rpx;
  color: #64748b;
  background: #fff;
  border: 1rpx solid rgba(99, 102, 241, 0.12);
  border-radius: var(--lq-radius-md);
}

.pr-tab-chip--on {
  color: #fff;
  background: #6366f1;
  border-color: #6366f1;
  font-weight: 600;
}

.pr-tab-count {
  margin-left: 4rpx;
  font-size: 22rpx;
  opacity: 0.85;
}

.pr-list-toolbar {
  flex-shrink: 0;
  padding-top: 16rpx;
  margin-bottom: 8rpx;
}

.pr-search-bar {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin: 0 0 12rpx;
  padding: 0 24rpx;
  height: 72rpx;
  box-sizing: border-box;
  background: #fff;
  border-radius: var(--lq-radius-md);
  border: 1rpx solid rgba(99, 102, 241, 0.15);
  box-shadow: var(--lq-shadow-soft);
}

.pr-search-icon {
  flex-shrink: 0;
  font-size: 32rpx;
  color: #9ca3af;
  line-height: 1;
}

.pr-search-input {
  flex: 1;
  min-width: 0;
  height: 72rpx;
  min-height: 72rpx;
  line-height: 72rpx;
  font-size: 28rpx;
  padding: 0;
  margin: 0;
  background: transparent;
  border: none;
  box-sizing: border-box;
}

.pr-search-ph {
  color: #9ca3af;
  font-size: 26rpx;
}

.pr-target-scroll {
  width: 100%;
  margin-bottom: 12rpx;
  white-space: nowrap;
}

.pr-target-row {
  display: inline-flex;
  gap: 12rpx;
  padding: 4rpx 0;
}

.pr-target-chip {
  display: inline-block;
  padding: 10rpx 24rpx;
  font-size: 24rpx;
  color: #64748b;
  background: #fff;
  border: 1rpx solid rgba(99, 102, 241, 0.12);
  border-radius: 999rpx;
}

.pr-target-chip--on {
  color: #fff;
  background: #6366f1;
  border-color: #6366f1;
}

.pr-filter-bar {
  display: flex;
  align-items: stretch;
  margin-bottom: 8rpx;
  padding: 8rpx 0;
  background: var(--lq-gradient-filter);
  border-radius: var(--lq-radius-md);
  border: 1rpx solid rgba(99, 102, 241, 0.15);
  box-shadow: var(--lq-shadow-card);
}

.pr-filter-cell {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  border-right: 1rpx solid var(--lq-border);
}

.pr-filter-cell:last-child {
  border-right: none;
}

.pr-filter-cell picker {
  width: 100%;
}

.pr-filter-item {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 4rpx;
  padding: 12rpx 8rpx;
  font-size: 24rpx;
  color: #64748b;
}

.pr-filter-item--on {
  color: #4f46e5;
  font-weight: 600;
}

.pr-filter-label {
  max-width: 120rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.pr-filter-arrow {
  font-size: 20rpx;
  color: #9ca3af;
}

.pr-filter-count {
  display: block;
  font-size: 22rpx;
  color: #94a3b8;
  padding: 0 4rpx 8rpx;
}

.pr-order-card {
  position: relative;
}

.pr-order-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
}

.pr-order-head .title-lg {
  flex: 1;
  min-width: 0;
}

.pr-order-status {
  flex-shrink: 0;
  font-size: 22rpx;
  font-weight: 600;
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
  background: #f1f5f9;
  color: #64748b;
}

.pr-order-status--on {
  background: #ecfdf5;
  color: #059669;
}

.pr-order-status--off {
  background: #fef2f2;
  color: #dc2626;
}

.pr-order-deadline {
  display: block;
  margin-top: 8rpx;
  color: #6366f1;
  font-weight: 500;
}

.pr-order-actions {
  display: flex;
  align-items: center;
  gap: 24rpx;
  margin-top: 16rpx;
}

.pr-order-action {
  font-size: 26rpx;
  color: var(--lq-primary, #6366f1);
  font-weight: 600;
  padding: 8rpx 0;
}

.pr-order-action--danger {
  color: #dc2626;
}

.pr-order-meta {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid var(--lq-border, #e2e8f0);
}

.pr-order-badge {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--lq-primary-dark, #4f46e5);
  background: #eef2ff;
  padding: 8rpx 20rpx;
  border-radius: 999rpx;
}

.pr-order-meta-right {
  display: flex;
  align-items: center;
  gap: 16rpx;
  flex-wrap: wrap;
  justify-content: flex-end;
}

.pr-order-link {
  font-size: 26rpx;
  color: var(--lq-primary, #6366f1);
  font-weight: 600;
}

.pr-order-link--video {
  color: #d97706;
}

.pr-order-link--pending {
  color: #78350f;
  font-weight: 700;
}

.pr-share-sheet-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 10000;
  background: rgba(53, 50, 74, 0.32);
  display: flex;
  align-items: flex-end;
}

.pr-share-sheet {
  width: 100%;
  padding: 28rpx 28rpx calc(28rpx + env(safe-area-inset-bottom));
  background: #fff;
  border-radius: 32rpx 32rpx 0 0;
  box-shadow: 0 -12rpx 48rpx rgba(15, 23, 42, 0.12);
}

.pr-share-sheet-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 8rpx;
}

.pr-share-sheet-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #0f172a;
}

.pr-share-sheet-close {
  font-size: 44rpx;
  color: #94a3b8;
  line-height: 1;
  padding: 0 8rpx;
}

.pr-share-sheet-sub {
  display: block;
  font-size: 24rpx;
  color: #64748b;
  margin-bottom: 20rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.pr-share-sheet-item {
  display: block;
  width: 100%;
  box-sizing: border-box;
  padding: 28rpx 8rpx;
  font-size: 30rpx;
  font-weight: 600;
  color: #0f172a;
  text-align: center;
  border-top: 1rpx solid #e2e8f0;
}

.pr-share-sheet-btn {
  margin: 0;
  background: #fff;
  border: none;
  border-radius: 0;
  line-height: 1.4;
}

.pr-share-sheet-btn::after {
  border: none;
}

.pr-share-sheet-cancel {
  margin-top: 12rpx;
  padding: 28rpx 8rpx;
  font-size: 30rpx;
  color: #64748b;
  text-align: center;
  border-top: 12rpx solid #f1f5f9;
}
