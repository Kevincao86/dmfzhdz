@import '../../styles/theme.wxss';
@import '../../styles/job-card-compact.wxss';
@import '../../styles/mp-beautify.wxss';

/* —— 图1 首页版型（薰衣草统一色系） —— */
.home-page--v1 {
  height: 100vh;
  box-sizing: border-box;
  background: var(--lq-bg, #faf7ff);
}

.home-hero-shell {
  padding-bottom: 8rpx;
  background: #9b87f5;
}

.home-scroll-full {
  height: 100%;
  width: 100%;
  box-sizing: border-box;
}

.share-cover-preload {
  position: fixed;
  left: -9999rpx;
  top: -9999rpx;
  width: 1px;
  height: 1px;
  opacity: 0;
  pointer-events: none;
}

/* 顶栏（图2 紫底白字） */
.home-top-v1 {
  padding: 0 0 0;
  background: transparent;
  box-sizing: border-box;
}

.home-brand-v1 {
  display: block;
  padding: 0 28rpx 16rpx;
  font-size: 40rpx;
  font-weight: 800;
  color: #fff;
  letter-spacing: 2rpx;
  line-height: 1.2;
}

/* 搜索条（设计稿版式，紫底通栏居中） */
.home-search-v2 {
  display: flex;
  align-items: center;
  width: calc(100% - 48rpx);
  height: 80rpx;
  margin: 0 auto 20rpx;
  padding: 0 8rpx 0 24rpx;
  box-sizing: border-box;
  background: #fff;
  border-radius: 999rpx;
  box-shadow: 0 8rpx 24rpx rgba(55, 34, 120, 0.12);
}

.home-search-v2__icon {
  flex-shrink: 0;
  width: 36rpx;
  font-size: 34rpx;
  font-weight: 700;
  color: #b8b4c8;
  line-height: 1;
}

.home-search-v2__input {
  flex: 1;
  min-width: 0;
  height: 72rpx;
  margin: 0 12rpx;
  font-size: 26rpx;
  color: #1e293b;
  background: transparent;
}

.home-search-v2__ph {
  color: #a8a3b8;
}

.home-search-v2__btn {
  flex-shrink: 0;
  min-width: 108rpx;
  height: 64rpx;
  padding: 0 24rpx;
  font-size: 26rpx;
  font-weight: 700;
  color: #fff;
  line-height: 64rpx;
  text-align: center;
  background: #9b87f5;
  border-radius: 999rpx;
}

/* 达人 Banner（渐变卡片 + 透明人物） */
.home-banner-v2 {
  position: relative;
  width: calc(100% - 48rpx);
  height: 220rpx;
  margin: 0 auto 16rpx;
  padding: 28rpx 0 28rpx 28rpx;
  box-sizing: border-box;
  overflow: visible;
  border-radius: 24rpx;
  background: linear-gradient(135deg, #c4b5fd 0%, #a78bfa 38%, #9b87f5 100%);
  box-shadow: 0 10rpx 28rpx rgba(76, 52, 160, 0.18);
}

.home-banner-v2__deco {
  position: absolute;
  pointer-events: none;
}

.home-banner-v2__deco--cloud {
  left: 120rpx;
  bottom: 18rpx;
  width: 88rpx;
  height: 36rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.14);
}

.home-banner-v2__deco--star {
  right: 200rpx;
  top: 16rpx;
  width: 20rpx;
  height: 20rpx;
  border-radius: 4rpx;
  background: #fde68a;
  transform: rotate(45deg);
  box-shadow: 18rpx 36rpx 0 -4rpx rgba(253, 230, 138, 0.75);
}

.home-banner-v2__copy {
  position: relative;
  z-index: 2;
  max-width: 58%;
}

.home-banner-v2__title {
  display: block;
  font-size: 34rpx;
  font-weight: 800;
  color: #fff;
  line-height: 1.25;
  letter-spacing: 1rpx;
}

.home-banner-v2__sub {
  display: block;
  margin-top: 6rpx;
  font-size: 34rpx;
  font-weight: 800;
  color: #fff;
  line-height: 1.25;
}

.home-banner-v2__hint {
  display: block;
  margin-top: 10rpx;
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.88);
  line-height: 1.3;
}

.home-banner-v2__cta {
  display: inline-block;
  margin-top: 18rpx;
  padding: 10rpx 32rpx;
  font-size: 24rpx;
  font-weight: 700;
  color: #8b6cf6;
  background: #fff;
  border-radius: 999rpx;
  box-shadow: 0 4rpx 12rpx rgba(76, 52, 160, 0.12);
}

.home-banner-v2__girl {
  position: absolute;
  right: -8rpx;
  bottom: -6rpx;
  z-index: 3;
  width: 248rpx;
  height: 248rpx;
  pointer-events: none;
}

.home-notice-v1 {
  display: inline-flex;
  align-items: center;
  gap: 10rpx;
  margin: 12rpx 28rpx 16rpx;
  padding: 8rpx 18rpx;
  font-size: 22rpx;
  color: #fff;
  background: rgba(255, 255, 255, 0.18);
  border: 1rpx solid rgba(255, 255, 255, 0.28);
  border-radius: 999rpx;
}

.home-notice-v1__dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: #f59e0b;
}

/* 列表区 */
.home-body-v1 {
  margin-top: 0;
  padding: 12rpx 0 24rpx;
  background: #fff;
  border-radius: 28rpx 28rpx 0 0;
  box-shadow: none;
}

/* 类目下划线 Tab */
.home-cat-tabs {
  width: 100%;
  white-space: nowrap;
}

.home-cat-tabs__row {
  display: inline-flex;
  align-items: flex-end;
  gap: 8rpx;
  padding: 16rpx 24rpx 0;
}

.home-cat-tab {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  padding: 8rpx 20rpx 14rpx;
  flex-shrink: 0;
}

.home-cat-tab__text {
  font-size: 28rpx;
  font-weight: 500;
  color: #94a3b8;
  line-height: 1.2;
}

.home-cat-tab--on .home-cat-tab__text {
  font-size: 30rpx;
  font-weight: 800;
  color: #1e293b;
}

.home-cat-tab__line {
  width: 36rpx;
  height: 6rpx;
  margin-top: 8rpx;
  border-radius: 999rpx;
  background: linear-gradient(90deg, #8b5cf6, #7c3aed);
}

/* 大厅切换（紧凑） */
.home-hall-mini {
  display: flex;
  gap: 12rpx;
  padding: 12rpx 24rpx 0;
}

.home-hall-mini__item {
  padding: 10rpx 20rpx;
  font-size: 22rpx;
  font-weight: 600;
  color: #64748b;
  background: #f8fafc;
  border: 1rpx solid #e2e8f0;
  border-radius: 999rpx;
}

.home-hall-mini__item--on {
  color: #fff;
  background: linear-gradient(135deg, #8b5cf6, #7c3aed);
  border-color: transparent;
  box-shadow: 0 4rpx 12rpx rgba(124, 58, 237, 0.25);
}

.home-hall-mini__count {
  margin-left: 4rpx;
  font-size: 20rpx;
  opacity: 0.9;
}

.paichian-sub-tabs--v1 {
  margin: 12rpx 24rpx 0;
}

/* 轻量筛选 */
.home-filter-v1 {
  width: 100%;
  margin-top: 12rpx;
  white-space: nowrap;
}

.home-filter-v1__row {
  display: inline-flex;
  gap: 12rpx;
  padding: 8rpx 24rpx 12rpx;
}

.home-filter-v1__chip {
  display: inline-flex;
  align-items: center;
  padding: 10rpx 20rpx;
  font-size: 22rpx;
  font-weight: 600;
  color: #64748b;
  background: #f8fafc;
  border: 1rpx solid #e8ecf4;
  border-radius: 999rpx;
  flex-shrink: 0;
}

.home-filter-v1__chip--on {
  color: #7c3aed;
  background: #f3f0ff;
  border-color: #ddd6fe;
}

.home-scroll-full .card {
  margin-left: 28rpx;
  margin-right: 28rpx;
}

.home-filters-warn {
  margin: 8rpx 28rpx;
}

.list-hint {
  margin-top: 20rpx;
}

.empty-title {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  margin: 12rpx 0 8rpx;
}

.empty-block {
  margin-bottom: 32rpx;
}

/* 图1 商单卡 */
.job-card-v1 {
  position: relative;
  display: flex;
  align-items: flex-start;
  gap: 20rpx;
  margin: 0 24rpx 20rpx;
  padding: 20rpx;
  background: #fff;
  border-radius: 20rpx;
  border: 1rpx solid #f0f0f5;
  box-shadow: 0 4rpx 20rpx rgba(30, 27, 60, 0.05);
  overflow: hidden;
}

.job-card-v1--hover {
  opacity: 0.96;
}

.job-card-v1__thumb-wrap {
  position: relative;
  flex-shrink: 0;
  width: 160rpx;
  height: 160rpx;
}

.job-card-v1__thumb {
  width: 160rpx;
  height: 160rpx;
  border-radius: 16rpx;
  display: block;
  background: #f3f0ff;
}

.job-card-v1__thumb--ph {
  display: flex;
  align-items: center;
  justify-content: center;
}

.job-card-v1__thumb-icon {
  width: 64rpx;
  height: 64rpx;
}

.job-card-v1__thumb-tag {
  position: absolute;
  left: 0;
  top: 0;
  padding: 4rpx 12rpx;
  font-size: 18rpx;
  font-weight: 700;
  color: #fff;
  background: rgba(124, 58, 237, 0.82);
  border-radius: 16rpx 0 12rpx 0;
  max-width: 100%;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.job-card-v1__main {
  flex: 1;
  min-width: 0;
  padding-right: 8rpx;
}

.job-card-v1__title {
  display: block;
  font-size: 28rpx;
  font-weight: 700;
  color: #1a1a2e;
  line-height: 1.4;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.job-card-v1__meta {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-top: 10rpx;
}

.job-card-v1__meta-pill {
  padding: 4rpx 12rpx;
  font-size: 20rpx;
  color: #64748b;
  background: #f1f5f9;
  border-radius: 8rpx;
}

.job-card-v1__price {
  display: block;
  margin-top: 10rpx;
  font-size: 30rpx;
  font-weight: 800;
  color: #e11d48;
  line-height: 1.3;
}

.job-card-v1__fee .job-card-v1__price {
  margin-top: 10rpx;
}

.job-card-v1__foot {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 10rpx;
}

.job-card-v1__status {
  font-size: 22rpx;
  font-weight: 600;
  color: #64748b;
}

.job-card-v1__status--open {
  color: #16a34a;
}

.job-card-v1__status--open::before {
  content: '● ';
  font-size: 18rpx;
}

.job-card-v1__deadline {
  font-size: 22rpx;
  color: #94a3b8;
}

.job-card-v1__deadline::before {
  content: '⏱ ';
  font-size: 18rpx;
}

.job-card-v1__match {
  flex-shrink: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 88rpx;
  padding-top: 8rpx;
}

.job-card-v1__match-lbl {
  font-size: 18rpx;
  color: #94a3b8;
  font-weight: 600;
}

.job-card-v1__match-num {
  margin-top: 4rpx;
  font-size: 32rpx;
  font-weight: 800;
  color: #7c3aed;
  line-height: 1;
}

.job-card-v1__corner {
  position: absolute;
  top: 0;
  right: 0;
  padding: 4rpx 14rpx;
  font-size: 18rpx;
  font-weight: 600;
  border-radius: 0 20rpx 0 14rpx;
  z-index: 2;
}

/* 弹窗（保留） */
.sel-popup-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 10150;
  background: rgba(45, 27, 78, 0.42);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 32rpx;
  box-sizing: border-box;
}

.sel-popup {
  width: 620rpx;
  max-width: 100%;
  padding: 40rpx 36rpx 32rpx;
  box-sizing: border-box;
  background: #fff;
  border-radius: 32rpx;
  border: 3rpx solid rgba(255, 255, 255, 0.95);
  box-shadow: 0 16rpx 48rpx rgba(45, 27, 78, 0.2);
}

.sel-popup-title {
  display: block;
  font-size: 34rpx;
  font-weight: 800;
  color: var(--lq-text, #1e293b);
  text-align: center;
  line-height: 1.35;
}

.sel-popup-body {
  display: block;
  margin-top: 20rpx;
  font-size: 28rpx;
  line-height: 1.55;
  color: var(--lq-text-secondary, #64748b);
  text-align: center;
}

.sel-popup-tip {
  display: block;
  margin-top: 16rpx;
  font-size: 26rpx;
  font-weight: 600;
  color: #7c3aed;
  text-align: center;
}

.sel-popup-qr {
  display: block;
  width: 320rpx;
  height: 320rpx;
  margin: 24rpx auto 8rpx;
  border-radius: 16rpx;
  background: #f8fafc;
  border: 2rpx solid #e2e8f0;
}

.sel-popup-qr--empty {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 24rpx;
  box-sizing: border-box;
  font-size: 24rpx;
  line-height: 1.5;
  color: #94a3b8;
  text-align: center;
}

.sel-popup-btn {
  margin: 28rpx 0 0;
  height: 84rpx;
  line-height: 84rpx;
  border-radius: 999rpx;
  font-size: 30rpx;
  font-weight: 700;
  color: #fff;
  background: linear-gradient(135deg, #8b5cf6, #6366f1);
  box-shadow: 0 8rpx 0 rgba(99, 102, 241, 0.35);
}

.sel-popup-btn::after {
  border: none;
}

.paichian-sub-tabs {
  display: flex;
  gap: 12rpx;
}

.paichian-sub-tab {
  flex: 1;
  text-align: center;
  padding: 14rpx 8rpx;
  font-size: 24rpx;
  font-weight: 600;
  color: var(--lq-text-secondary);
  background: var(--lq-surface);
  border-radius: 999rpx;
  border: 2rpx solid var(--lq-border);
}

.paichian-sub-tab--on {
  color: #fff;
  background: linear-gradient(135deg, #8b5cf6, #7c3aed);
  border-color: transparent;
  box-shadow: 0 4rpx 12rpx rgba(124, 58, 237, 0.25);
}
