@import '../../styles/theme.wxss';
@import '../../styles/hero-deco.wxss';
@import '../../styles/job-card-compact.wxss';
@import '../../styles/mp-beautify.wxss';

.home-page {
  background: var(--lq-bg);
}

.share-cover-preload {
  position: fixed;
  left: -9999rpx;
  top: -9999rpx;
  width: 1px;
  height: 1px;
  opacity: 0;
  pointer-events: none;
}

.home-header,
.home-toolbar,
.home-filters {
  flex-shrink: 0;
}

/* 顶部渐变区 + AI/本地生活装饰层 */
.home-header {
  padding-bottom: var(--lq-header-pad-bottom);
  border-radius: 0 0 40rpx 40rpx;
  box-shadow: var(--lq-shadow-header);
}

.home-header-inner {
  padding-left: 28rpx;
  box-sizing: border-box;
}

.brand-row {
  display: flex;
  align-items: center;
  gap: 24rpx;
  margin-bottom: 28rpx;
}

.brand-logo {
  flex-shrink: 0;
  display: block;
}

.brand-text {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  justify-content: center;
  gap: 6rpx;
}

.brand-title {
  display: block;
  font-size: 34rpx;
  font-weight: 700;
  color: #fff;
  letter-spacing: 1rpx;
  line-height: 1.25;
}

.brand-slogan {
  display: block;
  font-size: 24rpx;
  font-weight: 600;
  color: rgba(255, 255, 255, 0.95);
  line-height: 1.35;
}

.brand-desc {
  display: block;
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.78);
  line-height: 1.4;
}

.search-bar {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 0 28rpx;
  height: 76rpx;
  background: rgba(255, 255, 255, 0.98);
  border-radius: 999rpx;
  border: 3rpx solid rgba(255, 255, 255, 0.85);
  box-shadow: 0 8rpx 0 rgba(255, 255, 255, 0.22);
}

.search-icon {
  font-size: 36rpx;
  color: #9ca3af;
}

.search-input {
  flex: 1;
  font-size: 28rpx;
  color: var(--lq-text);
}

.search-ph {
  color: #9ca3af;
}

.notice-pill {
  display: inline-flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 20rpx;
  padding: 10rpx 20rpx;
  background: rgba(255, 255, 255, 0.2);
  border-radius: 999rpx;
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.96);
  backdrop-filter: blur(8px);
}

.notice-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: var(--lq-accent);
}

/* 大厅 Tab：渐变轨道 + 选中渐变块 */
.home-toolbar {
  position: relative;
  z-index: 2;
  margin: -20rpx 24rpx 0;
  padding: 0;
  background: transparent;
  border: none;
  box-shadow: none;
}

.hall-tabs-pro {
  width: 100%;
}

.paichian-sub-tabs {
  display: flex;
  gap: 12rpx;
  margin-top: 16rpx;
  padding: 0 4rpx;
}

.paichian-sub-tab {
  flex: 1;
  text-align: center;
  padding: 14rpx 8rpx;
  font-size: 24rpx;
  font-weight: 600;
  color: var(--lq-text-secondary);
  background: var(--lq-surface);
  border-radius: 999rpx;
  border: 2rpx solid var(--lq-border);
}

.paichian-sub-tab--on {
  color: #fff;
  background: var(--lq-gradient-tab);
  border-color: transparent;
  box-shadow: var(--lq-shadow-tab);
}

.hall-tab-pro.active::after {
  display: none;
}

.home-filters {
  padding-top: 8rpx;
}

.home-filters-warn {
  margin: 0 28rpx 8rpx;
}

.home-scroll {
  padding: 12rpx 0 20rpx;
}

.home-scroll .card {
  margin-left: 28rpx;
  margin-right: 28rpx;
}

.list-hint {
  margin-top: 20rpx;
}

.filter-bar {
  display: flex;
  align-items: stretch;
  margin: 0 24rpx 14rpx;
  padding: 10rpx 0;
  background: var(--lq-gradient-filter);
  border-radius: var(--lq-radius-md);
  border: 1rpx solid rgba(99, 102, 241, 0.15);
  box-shadow: var(--lq-shadow-card);
}

.filter-cell {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  border-right: 1rpx solid var(--lq-border);
}

.filter-cell:last-child {
  border-right: none;
}

.filter-cell picker {
  width: 100%;
}

.filter-item {
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 4rpx;
  padding: 8rpx 4rpx;
  box-sizing: border-box;
}

.filter-item--active .filter-label {
  color: var(--lq-primary-dark);
  font-weight: 700;
}

.filter-item--active .filter-arrow {
  color: var(--lq-primary);
}

.filter-label {
  font-size: 24rpx;
  color: var(--lq-text);
  font-weight: 500;
  max-width: 100%;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.filter-item--muted .filter-label {
  color: #9ca3af;
}

.filter-arrow {
  font-size: 20rpx;
  color: #d1d5db;
}

.state-warn {
  margin-bottom: 12rpx;
  background: #fef8ee;
  border-color: #f5e6c8;
}

.empty-title {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  margin: 12rpx 0 8rpx;
}

.empty-block {
  margin-bottom: 32rpx;
}

.sel-popup-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 10150;
  background: rgba(45, 27, 78, 0.42);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 32rpx;
  box-sizing: border-box;
}

.sel-popup {
  width: 620rpx;
  max-width: 100%;
  padding: 40rpx 36rpx 32rpx;
  box-sizing: border-box;
  background: #fff;
  border-radius: 32rpx;
  border: 3rpx solid rgba(255, 255, 255, 0.95);
  box-shadow: 0 16rpx 48rpx rgba(45, 27, 78, 0.2);
}

.sel-popup-title {
  display: block;
  font-size: 34rpx;
  font-weight: 800;
  color: var(--lq-text, #1e293b);
  text-align: center;
  line-height: 1.35;
}

.sel-popup-body {
  display: block;
  margin-top: 20rpx;
  font-size: 28rpx;
  line-height: 1.55;
  color: var(--lq-text-secondary, #64748b);
  text-align: center;
}

.sel-popup-tip {
  display: block;
  margin-top: 16rpx;
  font-size: 26rpx;
  font-weight: 600;
  color: #7c3aed;
  text-align: center;
}

.sel-popup-qr {
  display: block;
  width: 320rpx;
  height: 320rpx;
  margin: 24rpx auto 8rpx;
  border-radius: 16rpx;
  background: #f8fafc;
  border: 2rpx solid #e2e8f0;
}

.sel-popup-qr--empty {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 24rpx;
  box-sizing: border-box;
  font-size: 24rpx;
  line-height: 1.5;
  color: #94a3b8;
  text-align: center;
}

.sel-popup-btn {
  margin: 28rpx 0 0;
  height: 84rpx;
  line-height: 84rpx;
  border-radius: 999rpx;
  font-size: 30rpx;
  font-weight: 700;
  color: #fff;
  background: var(--lq-gradient-tab, linear-gradient(135deg, #8b5cf6, #6366f1));
  box-shadow: var(--lq-shadow-tab, 0 8rpx 0 rgba(99, 102, 241, 0.35));
}

.sel-popup-btn::after {
  border: none;
}
