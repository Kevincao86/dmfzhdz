<view class="home-page page-with-bar page-shell-fixed">
  <!-- 顶部：品牌 + 搜索 -->
  <view class="home-header lq-hero-header">
    <view class="lq-hero-bg" aria-hidden="true">
      <view class="lq-hero-bg__pattern" />
      <view class="lq-hero-bg__mesh" />
      <view class="lq-hero-bg__glow lq-hero-bg__glow--1" />
      <view class="lq-hero-bg__glow lq-hero-bg__glow--2" />
      <view class="lq-hero-bg__ring lq-hero-bg__ring--1" />
      <view class="lq-hero-bg__ring lq-hero-bg__ring--2" />
      <text class="lq-hero-bg__icon lq-hero-bg__icon--spark">✦</text>
      <text class="lq-hero-bg__icon lq-hero-bg__icon--clip">云剪</text>
      <text class="lq-hero-bg__icon lq-hero-bg__icon--shop">探店</text>
      <text class="lq-hero-bg__icon lq-hero-bg__icon--pin">本地生活</text>
    </view>
    <view class="home-header-inner lq-hero-header__inner" style="{{navInnerStyle}}">
      <view class="brand-row" style="{{brandRowStyle}}">
        <image
          class="brand-logo"
          style="{{brandLogoStyle}}"
          src="/images/logo.png"
          mode="aspectFit"
        />
        <view class="brand-text">
          <text class="brand-title">灵祺撮合平台</text>
          <text class="brand-slogan">本地生活 · 探店种草 · 云剪直派</text>
          <text class="brand-desc">商单透明报价 · 平台审核 · 达人安心接单</text>
        </view>
      </view>

      <view class="search-bar">
        <text class="search-icon">⌕</text>
        <input
          class="search-input"
          placeholder="搜索招募、门店、城市"
          placeholder-class="search-ph"
          value="{{searchKeyword}}"
          bindinput="onSearchInput"
        />
      </view>

      <view class="notice-pill" wx:if="{{todayCount > 0}}">
        <text class="notice-dot"></text>
        <text>今日新增招募 {{todayCount}} 条</text>
      </view>
    </view>
  </view>

  <!-- 大厅切换（独立白卡片，不与筛选条叠压） -->
  <view class="home-toolbar">
    <view class="hall-tabs-pro lq-gradient-tabs">
      <view
        class="hall-tab-pro lq-gradient-tabs__item {{hallTab === 'normal' ? 'lq-gradient-tabs__item--on active' : ''}}"
        data-tab="normal"
        bindtap="onHallTab"
      >
        招募大厅
        <text class="tab-count lq-gradient-tabs__count" wx:if="{{normalRows.length}}">{{normalRows.length}}</text>
      </view>
      <view
        class="hall-tab-pro lq-gradient-tabs__item {{hallTab === 'urgent' ? 'lq-gradient-tabs__item--on active' : ''}}"
        data-tab="urgent"
        bindtap="onHallTab"
      >
        急单大厅
      </view>
      <view
        class="hall-tab-pro lq-gradient-tabs__item {{hallTab === 'ice' ? 'lq-gradient-tabs__item--on active' : ''}}"
        data-tab="ice"
        bindtap="onHallTab"
      >
        云剪任务
      </view>
    </view>
  </view>

  <!-- 筛选固定；仅下方列表可滚动 -->
  <view class="home-filters">
    <view class="filter-bar">
      <view class="filter-cell">
        <picker mode="selector" range="{{platformFilters}}" bindchange="onPlatformFilter">
          <view class="filter-item">
            <text class="filter-label">{{filterPlatform === '全部' ? '平台' : filterPlatform}}</text>
            <text class="filter-arrow">▾</text>
          </view>
        </picker>
      </view>
      <view class="filter-cell">
        <picker mode="selector" range="{{cityFilters}}" bindchange="onCityFilter">
          <view class="filter-item">
            <text class="filter-label">{{filterCity === '全部' ? '城市' : filterCity}}</text>
            <text class="filter-arrow">▾</text>
          </view>
        </picker>
      </view>
      <view class="filter-cell">
        <view
          class="filter-item {{priceSelected.length ? 'filter-item--active' : ''}}"
          bindtap="onOpenPriceSheet"
        >
          <text class="filter-label">{{priceFilterLabel}}</text>
          <text class="filter-arrow">▾</text>
        </view>
      </view>
      <view class="filter-cell">
        <picker mode="selector" range="{{sortOptions}}" bindchange="onSortFilter">
          <view class="filter-item {{sortBy !== '发布时间' ? 'filter-item--active' : ''}}">
            <text class="filter-label">{{sortBy === '发布时间' ? '排序' : sortBy}}</text>
            <text class="filter-arrow">▾</text>
          </view>
        </picker>
      </view>
    </view>

    <view wx:if="{{unconfigured}}" class="card state-warn home-filters-warn">
      <text class="hint">尚未连接后台，演示商单可预览；请配置 MERCHANT_API_BASE_URL</text>
    </view>
  </view>

  <scroll-view class="home-scroll page-scroll-body" scroll-y enhanced show-scrollbar="{{false}}">
    <view wx:if="{{loading}}" class="card state-loading">
      <view class="loading-dot-wrap">
        <view class="loading-dot" />
        <view class="loading-dot" />
        <view class="loading-dot" />
      </view>
      <text class="hint list-hint">加载招募中…</text>
    </view>

    <view wx:elif="{{err}}" class="card state-error">
      <text>{{err}}</text>
    </view>

    <block wx:else>
      <view
        wx:for="{{displayRows}}"
        wx:key="id"
        class="job-card-compact"
        bindtap="goDetail"
        data-id="{{item.id}}"
        data-mock="{{item.isMock}}"
        hover-class="job-card-compact--hover"
      >
        <text
          wx:if="{{item.aiTag}}"
          class="job-card-compact__ai-tag job-card-compact__ai-tag--{{item.aiTagTone}}"
        >{{item.aiTag}}</text>
        <text class="job-card-compact__ribbon job-card-compact__ribbon--demo" wx:if="{{item.isMock && !item.aiTag}}">演示</text>
        <text class="job-card-compact__ribbon" wx:elif="{{item.recommended && !item.aiTag}}">推荐</text>
        <view class="job-card-compact__row">
          <image class="job-card-compact__icon" src="{{item.platformIcon}}" mode="aspectFill" />
          <view class="job-card-compact__main">
            <text class="job-card-compact__title">{{item.title}}</text>
            <view class="job-card-compact__line2">
              <text class="job-card-compact__tag">{{item.statusLabel}}</text>
              <text class="job-card-compact__tag job-card-compact__tag--gray">报名{{item.applicantCount}}/{{item.recruitCount}}</text>
              <text class="job-card-compact__tag job-card-compact__tag--urgent" wx:if="{{item.urgent}}">急单</text>
              <text class="job-card-compact__tag job-card-compact__tag--ice" wx:elif="{{item.isIce}}">云剪</text>
            </view>
            <view class="job-card-compact__fee" wx:if="{{item.budgetDisplay.kind === 'tiers'}}">
              <text class="job-card-compact__fee-cps" wx:if="{{item.budgetDisplay.cps}}">{{item.budgetDisplay.cps}}</text>
              <text class="job-card-compact__fee-mode">{{item.budgetDisplay.mode}} · {{item.budgetDisplay.summary}}</text>
              <view class="job-card-compact__fee-chips">
                <text
                  wx:for="{{item.budgetDisplay.chips}}"
                  wx:key="label"
                  wx:for-item="chip"
                  class="job-card-compact__tier-chip"
                >{{chip.label}} {{chip.price}}</text>
                <text wx:if="{{item.budgetDisplay.moreCount > 0}}" class="job-card-compact__tier-more">+{{item.budgetDisplay.moreCount}}档</text>
              </view>
            </view>
            <text wx:else class="job-card-compact__price job-card-compact__price--solo">{{item.budgetDisplay.line}}</text>
            <text class="job-card-compact__line3">{{item.region}} · {{item.platform}} · {{item.merchantName}}</text>
          </view>
        </view>
      </view>

      <view wx:if="{{displayRows.length === 0}}" class="card state-empty empty-block">
        <text class="state-empty-icon">📋</text>
        <text class="empty-title">暂无匹配招募</text>
        <text class="hint">试试切换大厅或调整筛选条件</text>
      </view>
    </block>
  </scroll-view>

  <view class="price-sheet-mask" wx:if="{{showPriceSheet}}" bindtap="onClosePriceSheet">
    <view class="price-sheet" catchtap="noopSheetTap">
      <view class="price-sheet-head">
        <text class="price-sheet-title">价格筛选（可多选）</text>
        <text class="price-sheet-close" bindtap="onClosePriceSheet">×</text>
      </view>
      <view class="price-chip-grid">
        <view
          wx:for="{{priceBuckets}}"
          wx:key="id"
          class="price-chip {{item.selected ? 'price-chip--on' : ''}}"
          data-id="{{item.id}}"
          bindtap="onTogglePrice"
        >
          {{item.label}}
        </view>
      </view>
      <view class="price-sheet-foot">
        <button class="price-sheet-reset" bindtap="onResetPrice">清空</button>
        <button class="price-sheet-ok" bindtap="onConfirmPrice">确定</button>
      </view>
    </view>
  </view>
</view>
