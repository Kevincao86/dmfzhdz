<view class="home-page page-with-bar page-shell-fixed home-page--v1 {{lqThemeClass}}">
  <view class="home-sticky-top">
    <view class="home-hero-shell lq-hero-header lq-hero-header--home" style="{{navTopStyle}}">
      <view class="home-top-v1">
        <text class="home-brand-v1" style="{{brandPadStyle}}">灵祺星选</text>
        <view class="home-search-v2">
          <text class="home-search-v2__icon" aria-hidden="true">⌕</text>
          <input
            class="home-search-v2__input"
            placeholder="搜索招募名称/品牌/类目"
            placeholder-class="home-search-v2__ph"
            value="{{searchKeyword}}"
            confirm-type="search"
            bindinput="onSearchInput"
            bindconfirm="onSearchConfirm"
          />
          <view class="home-search-v2__btn" bindtap="onSearchConfirm">搜索</view>
        </view>
      </view>

      <view class="home-banner-v2" bindtap="goVerifyTalent" wx:if="{{!decorBanner}}">
        <view class="home-banner-v2__deco home-banner-v2__deco--star" />
        <view class="home-banner-v2__copy">
          <text class="home-banner-v2__title">{{bannerTitle}}</text>
          <text class="home-banner-v2__sub">{{bannerSub}}</text>
          <text class="home-banner-v2__hint">{{bannerHint}}</text>
          <view class="home-banner-v2__cta">{{bannerCta}}</view>
        </view>
        <view class="home-banner-v2__scene">
          <image
            wx:if="{{workIdentity !== 'pr'}}"
            class="home-banner-v2__clouds"
            src="{{bannerClouds}}"
            mode="aspectFit"
          />
          <image
            class="home-banner-v2__girl {{workIdentity === 'pr' ? 'home-banner-v2__girl--search' : ''}} {{workIdentity === 'shoot' ? 'home-banner-v2__girl--shoot' : ''}} {{workIdentity === 'edit' ? 'home-banner-v2__girl--edit' : ''}}"
            src="{{bannerGirl}}"
            mode="aspectFit"
          />
        </view>
        <view wx:if="{{todayCount > 0}}" class="home-banner-v2__notice" catchtap="noopSheetTap">
          <text class="home-banner-v2__notice-dot"></text>
          <text>今日新增招募 {{todayCount}} 条</text>
        </view>
      </view>
      <view class="home-decor-banner" wx:elif="{{decorBanner}}" bindtap="onDecorBannerTap">
        <image class="home-decor-banner__img" src="{{decorBanner.imageUrl}}" mode="aspectFill" />
        <text wx:if="{{decorBanner.title}}" class="home-decor-banner__title">{{decorBanner.title}}</text>
      </view>
    </view>

    <view class="home-toolbar">
      <view class="home-hall-mini">
        <view
          class="home-hall-mini__item {{hallTab === 'normal' ? 'home-hall-mini__item--on' : ''}}"
          data-tab="normal"
          bindtap="onHallTab"
        >
          招募大厅<text wx:if="{{tabCounts.normal}}" class="home-hall-mini__count">{{tabCounts.normal}}</text>
        </view>
        <view
          class="home-hall-mini__item {{hallTab === 'urgent' ? 'home-hall-mini__item--on' : ''}}"
          data-tab="urgent"
          bindtap="onHallTab"
        >
          急单大厅<text wx:if="{{tabCounts.urgent}}" class="home-hall-mini__count">{{tabCounts.urgent}}</text>
        </view>
        <view
          class="home-hall-mini__item {{hallTab === 'paichian' ? 'home-hall-mini__item--on' : ''}}"
          data-tab="paichian"
          bindtap="onHallTab"
        >
          拍剪任务
        </view>
      </view>

      <view class="paichian-sub-tabs paichian-sub-tabs--v1" wx:if="{{hallTab === 'paichian'}}">
        <view
          class="paichian-sub-tab {{paichianSubTab === 'shoot' ? 'paichian-sub-tab--on' : ''}}"
          data-sub="shoot"
          bindtap="onPaichianSubTab"
        >拍摄任务</view>
        <view
          class="paichian-sub-tab {{paichianSubTab === 'edit' ? 'paichian-sub-tab--on' : ''}}"
          data-sub="edit"
          bindtap="onPaichianSubTab"
        >剪辑任务</view>
        <view
          class="paichian-sub-tab {{paichianSubTab === 'ice' ? 'paichian-sub-tab--on' : ''}}"
          data-sub="ice"
          bindtap="onPaichianSubTab"
        >云剪任务</view>
      </view>

      <scroll-view class="home-filter-v1" scroll-x show-scrollbar="{{false}}">
        <view class="home-filter-v1__row">
          <picker mode="selector" range="{{platformFilters}}" bindchange="onPlatformFilter">
            <view class="home-filter-v1__chip {{filterPlatform !== '全部' ? 'home-filter-v1__chip--on' : ''}}">
              {{filterPlatform === '全部' ? '平台' : filterPlatform}} ▾
            </view>
          </picker>
          <picker
            mode="multiSelector"
            range="{{regionMultiRange}}"
            value="{{regionMultiValue}}"
            bindcolumnchange="onRegionFilterColumnChange"
            bindchange="onRegionFilterChange"
          >
            <view class="home-filter-v1__chip {{filterProvince !== '全部' || filterCity !== '全部' ? 'home-filter-v1__chip--on' : ''}}">
              {{regionFilterLabel}} ▾
            </view>
          </picker>
          <view
            class="home-filter-v1__chip {{priceSelected.length ? 'home-filter-v1__chip--on' : ''}}"
            bindtap="onOpenPriceSheet"
          >{{priceFilterLabel}} ▾</view>
          <picker mode="selector" range="{{statusFilters}}" bindchange="onStatusFilter">
            <view class="home-filter-v1__chip {{filterStatus !== '全部' ? 'home-filter-v1__chip--on' : ''}}">
              {{filterStatus === '全部' ? '状态' : filterStatus}} ▾
            </view>
          </picker>
          <picker mode="selector" range="{{sortOptions}}" bindchange="onSortFilter">
            <view class="home-filter-v1__chip {{sortBy !== '发布时间' ? 'home-filter-v1__chip--on' : ''}}">
              {{sortBy === '发布时间' ? '排序' : sortBy}} ▾
            </view>
          </picker>
        </view>
      </scroll-view>
    </view>
  </view>

  <scroll-view class="home-list-scroll page-scroll-body" scroll-y enhanced show-scrollbar="{{false}}">
    <view wx:if="{{unconfigured}}" class="card state-warn home-filters-warn">
      <text class="hint">演示模式，连接后台后可查看真实商单</text>
    </view>

    <view wx:if="{{err && displayRows.length}}" class="card state-warn home-refresh-hint">
      <text class="hint">{{err}}</text>
    </view>

    <view wx:if="{{loading && !displayRows.length}}" class="card state-loading">
      <view class="loading-dot-wrap">
        <view class="loading-dot"></view>
        <view class="loading-dot"></view>
        <view class="loading-dot"></view>
      </view>
      <text class="list-hint">加载中</text>
    </view>

    <view wx:elif="{{err && !displayRows.length}}" class="card state-error">
      <text class="err-detail">{{err}}</text>
    </view>

    <block wx:if="{{displayRows.length || (!loading && !err)}}">
      <view
        wx:for="{{displayRows}}"
        wx:key="id"
        class="job-card-v1"
        bindtap="goDetail"
        data-id="{{item.id}}"
        data-mock="{{item.isMock}}"
        hover-class="job-card-v1--hover"
      >
        <view class="job-card-v1__thumb-wrap">
          <image
            wx:if="{{item.coverThumb}}"
            class="job-card-v1__thumb"
            src="{{item.coverThumb}}"
            mode="aspectFill"
          />
          <view wx:else class="job-card-v1__thumb job-card-v1__thumb--ph">
            <image class="job-card-v1__thumb-icon" src="{{item.platformIcon}}" mode="aspectFit" />
          </view>
          <text class="job-card-v1__thumb-tag" wx:if="{{item.statusLabel}}">{{item.statusLabel}}</text>
        </view>
        <view class="job-card-v1__main">
          <view class="job-card-v1__head">
            <text class="job-card-v1__title">{{item.title}}</text>
            <text
              wx:if="{{item.aiTag}}"
              class="job-card-v1__ai-tag"
              style="background:{{item.aiTagBg}};color:{{item.aiTagFg}};"
            >{{item.aiTag}}</text>
          </view>
          <view class="job-card-v1__tags">
            <text class="job-card-v1__meta-pill job-card-v1__meta-pill--hot" wx:if="{{item.overRecruitHot}}">
              <text class="job-card-v1__spark">✦</text>爆火
            </text>
            <text class="job-card-v1__meta-pill job-card-v1__meta-pill--new" wx:if="{{item.isPublishedToday}}">今日新增</text>
            <text class="job-card-v1__meta-pill" wx:if="{{item.region && item.region !== '—'}}">{{item.region}}</text>
            <text class="job-card-v1__meta-pill" wx:if="{{item.category}}">{{item.category}}</text>
          </view>
          <view class="job-card-v1__price-row" wx:if="{{!item.hideBudget}}">
            <text wx:if="{{item.budgetDisplay && item.budgetDisplay.kind === 'tiers'}}" class="job-card-v1__price">{{item.budgetDisplay.summary}}</text>
            <text wx:elif="{{item.cardPriceLine}}" class="job-card-v1__price">{{item.cardPriceLine}}</text>
            <text wx:elif="{{item.budgetDisplay}}" class="job-card-v1__price">{{item.budgetDisplay.line}}</text>
          </view>
          <view class="job-card-v1__foot">
            <text class="job-card-v1__signup" wx:if="{{item.signupCountText}}">{{item.signupCountText}}</text>
            <text class="job-card-v1__deadline" wx:if="{{item.deadlineText}}">截止 {{item.deadlineText}}</text>
          </view>
        </view>
      </view>

      <view wx:if="{{displayRows.length === 0}}" class="card state-empty empty-block">
        <text class="state-empty-icon">📋</text>
        <text class="empty-title">暂无招募商单</text>
        <text class="hint">运营台发布后将在此展示；可切换急单/云剪或下拉刷新</text>
      </view>
    </block>
    <site-icp-footer />
  </scroll-view>

  <view class="price-sheet-mask" wx:if="{{showPriceSheet}}" bindtap="onClosePriceSheet">
    <view class="price-sheet" catchtap="noopSheetTap">
      <view class="price-sheet-head">
        <text class="price-sheet-title">价格筛选（可多选）</text>
        <text class="price-sheet-close" bindtap="onClosePriceSheet">×</text>
      </view>
      <view class="price-chip-grid">
        <view
          wx:for="{{priceBuckets}}"
          wx:key="id"
          class="price-chip {{item.selected ? 'price-chip--on' : ''}}"
          data-id="{{item.id}}"
          bindtap="onTogglePrice"
        >
          {{item.label}}
        </view>
      </view>
      <view class="price-sheet-foot">
        <button class="price-sheet-reset" bindtap="onResetPrice">清空</button>
        <button class="price-sheet-ok" bindtap="onConfirmPrice">确定</button>
      </view>
    </view>
  </view>
  <view
    class="sel-popup-mask"
    wx:if="{{showSelectionPopup && selectionPopup}}"
    catchtouchmove="noopSheetTap"
  >
    <view class="sel-popup" catchtap="noopSheetTap">
      <text class="sel-popup-title">{{selectionPopup.title}}</text>
      <text class="sel-popup-body">{{selectionPopup.body}}</text>
      <text class="sel-popup-tip">长按识别二维码加入项目群（也可点击图片放大）</text>
      <image
        wx:if="{{selectionPopup.imageUrl}}"
        class="sel-popup-qr"
        src="{{selectionPopup.imageUrl}}"
        mode="aspectFit"
        show-menu-by-longpress="{{true}}"
        bindtap="onPreviewSelectionQr"
      />
      <view wx:else class="sel-popup-qr sel-popup-qr--empty">
        <text>群二维码加载中，也可在「我的 → 消息通知」查看</text>
      </view>
      <button class="sel-popup-btn" bindtap="onSelectionPopupDismiss">我知道了</button>
    </view>
  </view>
  <view
    class="sel-popup-mask"
    wx:if="{{showSchedulePopup && schedulePopup}}"
    catchtouchmove="noopSheetTap"
  >
    <view class="sel-popup" catchtap="noopSheetTap">
      <text class="sel-popup-title">{{schedulePopup.title}}</text>
      <text class="sel-popup-body">{{schedulePopup.body}}</text>
      <text class="sel-popup-tip">请按排期时间到店探店；如需调整请联系招募方</text>
      <button class="sel-popup-btn" bindtap="onSchedulePopupDismiss">我知道了</button>
    </view>
  </view>
  <view
    class="sel-popup-mask"
    wx:if="{{showOpsBroadcastPopup && opsBroadcastPopup}}"
    catchtouchmove="noopSheetTap"
  >
    <view class="sel-popup" catchtap="noopSheetTap">
      <text class="sel-popup-title">{{opsBroadcastPopup.title}}</text>
      <rich-text wx:if="{{opsBroadcastPopup.bodyHtml}}" class="sel-popup-body-rich" nodes="{{opsBroadcastPopup.bodyHtml}}" />
      <text wx:else class="sel-popup-body">{{opsBroadcastPopup.body}}</text>
      <text class="sel-popup-tip">平台公告，可在「我的 → 消息通知 → 系统」再次查看</text>
      <button class="sel-popup-btn" bindtap="onOpsBroadcastPopupDismiss">我知道了</button>
    </view>
  </view>
  <view
    class="sel-popup-mask"
    wx:if="{{showDecorPopup && decorPopup}}"
    catchtouchmove="noopSheetTap"
  >
    <view class="decor-popup" catchtap="noopSheetTap">
      <image
        class="decor-popup__img"
        src="{{decorPopup.imageUrl}}"
        mode="widthFix"
        bindtap="onDecorPopupTap"
        show-menu-by-longpress
      />
      <text wx:if="{{decorPopup.title}}" class="decor-popup__title">{{decorPopup.title}}</text>
      <button class="sel-popup-btn" bindtap="onDecorPopupDismiss">关闭</button>
    </view>
  </view>
  <image wx:if="{{shareCoverPreloadUrl}}" class="share-cover-preload" src="{{shareCoverPreloadUrl}}" aria-hidden="true" />
</view>
