<view class="relay-page page-shell {{lqThemeClass}}">
  <view class="relay-hero card">
    <text class="relay-hero__title">外部表单代收</text>
    <text class="relay-hero__sub">支持网站 https、H5 页面、小程序 #小程序:// 分享链接，或选择「二维码加群」上传群码。粘贴原表链接或上传群码生成灵祺代收单，达人报名后导出 CSV 回填原表。</text>
  </view>

  <view class="relay-form card">
    <text class="relay-section-title">新建转发代收</text>

    <view class="relay-field">
      <text class="relay-label">转发平台</text>
      <picker mode="selector" range="{{platformLabels}}" value="{{platformIndex}}" bindchange="onPlatformChange">
        <view class="relay-picker">{{platformLabels[platformIndex]}}</view>
      </picker>
    </view>

    <block wx:if="{{isGroupQrMode}}">
      <view class="relay-group-qr card">
        <text class="relay-group-qr__hint">上传微信群二维码，达人点击「前往原表报名」后长按识别进群。</text>
        <view class="relay-group-qr__preview" bindtap="onPreviewGroupQr">
          <image wx:if="{{groupQrImage}}" class="relay-group-qr__img" src="{{groupQrImage}}" mode="aspectFit" />
          <text wx:else class="hint">尚未上传群二维码</text>
        </view>
        <button class="relay-btn relay-btn--ghost" loading="{{groupQrUploading}}" bindtap="onUploadGroupQr">
          {{groupQrUploading ? '读取中…' : (groupQrImage ? '更换群二维码' : '上传群二维码')}}
        </button>
      </view>
    </block>

    <block wx:else>
      <view class="relay-field">
        <text class="relay-label">快捷模版</text>
        <view class="relay-template-chips">
          <view
            wx:for="{{templatePresets}}"
            wx:key="id"
            class="relay-template-chip"
            data-id="{{item.id}}"
            bindtap="onApplyTemplate"
          >{{item.label}}</view>
        </view>
      </view>
      <view class="relay-field">
        <text class="relay-label">原表链接</text>
        <textarea
          class="relay-input relay-input--area"
          placeholder="支持：网站 https://… · H5 · 群报数 · 小程序 #小程序://"
          placeholder-class="relay-ph"
          value="{{sourceUrl}}"
          bindinput="onSourceUrlInput"
          auto-height
          maxlength="-1"
        />
        <text wx:if="{{linkTypeHint}}" class="relay-link-type">已识别：{{linkTypeHint}}</text>
      </view>
    </block>

    <view class="relay-field">
      <text class="relay-label">代收单标题</text>
      <input
        class="relay-input"
        placeholder="如：XX品牌探店代收"
        placeholder-class="relay-ph"
        value="{{title}}"
        bindinput="onTitleInput"
      />
    </view>
    <view class="relay-field">
      <text class="relay-label">备注（可选）</text>
      <textarea
        class="relay-input relay-input--area relay-input--note"
        placeholder="表单说明、回填注意事项"
        placeholder-class="relay-ph"
        value="{{titleNote}}"
        bindinput="onTitleNoteInput"
        auto-height
        maxlength="-1"
      />
    </view>
    <view wx:if="{{err}}" class="relay-msg relay-msg--err">
      <text class="relay-msg__text">{{err}}</text>
    </view>
    <view wx:if="{{parseWarn}}" class="relay-msg relay-msg--warn">
      <text class="relay-msg__text">{{parseWarn}}</text>
    </view>
    <view wx:if="{{parsePreview && !publishPreview}}" class="relay-parse card">
      <text class="relay-parse__title">已抓取原表信息</text>
      <text wx:if="{{parsePreview.titleHint}}" class="relay-parse__line">标题：{{parsePreview.titleHint}}</text>
      <text wx:if="{{parsePreview.city}}" class="relay-parse__line">城市：{{parsePreview.city}}</text>
      <text wx:if="{{parsePreview.merchantRequirements}}" class="relay-parse__line">招募要求：{{parsePreview.merchantRequirements}}</text>
      <text wx:if="{{parsePreview.taskDetail}}" class="relay-parse__detail">{{parsePreview.taskDetail}}</text>
    </view>
    <view wx:if="{{publishPreview}}" class="relay-publish card">
      <view class="relay-publish__head">
        <text class="relay-publish__title">发布预览</text>
        <text class="relay-publish__hint">可直接在下方修改，确认后发布</text>
      </view>
      <view class="relay-preview-field">
        <text class="relay-label">标题</text>
        <input class="relay-input" value="{{publishPreview.title}}" data-field="title" bindinput="onPreviewFieldInput" />
      </view>
      <view class="relay-preview-row">
        <view class="relay-preview-field relay-preview-field--half">
          <text class="relay-label">平台</text>
          <input class="relay-input" value="{{publishPreview.platform}}" data-field="platform" bindinput="onPreviewFieldInput" />
        </view>
        <view class="relay-preview-field relay-preview-field--half">
          <text class="relay-label">地区</text>
          <input class="relay-input" value="{{publishPreview.region}}" data-field="region" bindinput="onPreviewFieldInput" />
        </view>
      </view>
      <view class="relay-preview-row">
        <view class="relay-preview-field relay-preview-field--half">
          <text class="relay-label">报价</text>
          <input class="relay-input" value="{{publishPreview.budgetText}}" data-field="budgetText" bindinput="onPreviewFieldInput" />
        </view>
        <view class="relay-preview-field relay-preview-field--half">
          <text class="relay-label">截止</text>
          <input class="relay-input" value="{{publishPreview.deadline}}" data-field="deadline" bindinput="onPreviewFieldInput" />
        </view>
      </view>
      <text class="relay-publish__line">原表平台：{{publishPreview.platformLabel}}</text>
      <view wx:if="{{publishPreview.sourceUrl}}" class="relay-publish__link-row">
        <text class="relay-publish__line">原表链接：</text>
        <text class="relay-publish__link" bindtap="openPreviewSourceUrl">{{publishPreview.sourceDisplayLink || publishPreview.sourceUrl}}</text>
      </view>
      <view class="relay-preview-field">
        <text class="relay-label">招募说明（可直接编辑）</text>
        <textarea
          class="relay-input relay-input--area relay-input--preview-info"
          value="{{publishPreview.recruitmentInfo}}"
          data-field="recruitmentInfo"
          bindinput="onPreviewFieldInput"
          maxlength="-1"
        />
      </view>
      <view class="relay-publish__actions">
        <button class="relay-submit relay-submit--inline" loading="{{submitting}}" bindtap="onConfirmPublish">{{submitting ? '发布中…' : '确认发布'}}</button>
        <button class="relay-btn relay-btn--ghost" loading="{{submitting}}" bindtap="onPreview">{{submitting ? '抓取中…' : '重新预览'}}</button>
      </view>
    </view>
    <view wx:if="{{doneId}}" class="relay-done">
      <text class="relay-done__text">已生成代收单 {{doneId}}</text>
      <view class="relay-done__actions">
        <button class="relay-btn relay-btn--ghost" size="mini" bindtap="onCopyShareLink" data-id="{{doneId}}">复制分享链接</button>
        <button class="relay-btn" size="mini" bindtap="goApplicants" data-id="{{doneId}}">查看报名</button>
      </view>
    </view>
    <button wx:if="{{!publishPreview}}" class="relay-submit" loading="{{submitting}}" bindtap="onPreview">{{submitting ? '抓取预览中…' : '预览代收单'}}</button>
  </view>

  <view class="relay-list card">
    <view class="relay-list-head">
      <text class="relay-section-title">我的转发代收</text>
      <text class="relay-refresh" bindtap="loadList">刷新</text>
    </view>
    <view wx:if="{{mineGuestMode}}" class="relay-empty">
      <text class="hint">没有数据，请登录后查看</text>
    </view>
    <view wx:elif="{{loadingList}}" class="relay-empty"><text class="hint">加载中…</text></view>
    <view wx:elif="{{!rows.length}}" class="relay-empty"><text class="hint">暂无转发代收单</text></view>
    <view wx:for="{{rows}}" wx:key="mpOrderId" class="relay-row">
      <view class="relay-row__head">
        <text class="relay-row__title">{{item.title}}</text>
        <text class="relay-row__id">{{item.mpOrderId}}</text>
      </view>
      <text class="hint relay-row__meta">{{item.platformLabel}} · 已报名 {{item.applicantCount}} 人</text>
      <text class="hint relay-row__time">{{item.createdAt}}</text>
      <view class="relay-row__actions">
        <button wx:if="{{item.isGroupQrRelay}}" class="relay-btn relay-btn--ghost" size="mini" bindtap="onReuploadGroupQr" data-id="{{item.mpOrderId}}">补传群码</button>
        <button class="relay-btn relay-btn--ghost" size="mini" bindtap="onCopyShareLink" data-id="{{item.mpOrderId}}">复制分享</button>
        <button class="relay-btn" size="mini" bindtap="goApplicants" data-id="{{item.mpOrderId}}">报名管理</button>
      </view>
    </view>
  </view>
</view>
