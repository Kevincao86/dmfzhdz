@import "../../partials/login-cred-panel.wxss";
@import "../../partials/account-session-actions.wxss";

.textarea { min-height: 120rpx; }

.wx-profile {
  display: flex;
  align-items: center;
  gap: 24rpx;
  margin-bottom: 8rpx;
}

.wx-avatar-btn {
  padding: 0;
  margin: 0;
  background: transparent;
  border: none;
  line-height: 1;
  flex-shrink: 0;
}

.wx-avatar-btn::after {
  border: none;
}

.wx-nick-input {
  width: 100%;
  font-size: 32rpx;
  font-weight: 700;
  color: #0f172a;
  padding: 8rpx 0;
}

.wx-avatar {
  width: 104rpx;
  height: 104rpx;
  border-radius: 50%;
  flex-shrink: 0;
  border: 4rpx solid #fff;
  box-shadow: 0 8rpx 24rpx rgba(15, 23, 42, 0.1);
}

.wx-avatar--ph {
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #bbf7d0, #86efac);
}

.wx-avatar-txt {
  font-size: 24rpx;
  color: #166534;
}

.type-switch {
  display: flex;
  flex-direction: row;
  align-items: stretch;
  gap: 0;
  padding: 6rpx;
  border-radius: 999rpx;
  background: #f1f5f9;
  margin-bottom: 8rpx;
}

.type-switch-item {
  flex: 1;
  padding: 22rpx 16rpx;
  border-radius: 999rpx;
  text-align: center;
  transition: background 0.15s ease;
}

.type-switch-item.active {
  background: #fff;
  box-shadow: 0 6rpx 20rpx rgba(99, 102, 241, 0.18);
}

.type-switch-label {
  font-size: 26rpx;
  font-weight: 600;
  color: #64748b;
}

.type-switch-item.active .type-switch-label {
  color: #4338ca;
}
