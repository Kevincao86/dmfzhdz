@import '../../styles/theme.wxss';

.legal-page {
  min-height: 100vh;
  padding: 24rpx 32rpx calc(32rpx + env(safe-area-inset-bottom));
  background: var(--lq-bg);
  box-sizing: border-box;
}

.legal-head {
  margin-bottom: 24rpx;
  padding: 28rpx;
  border-radius: var(--lq-radius-md);
  background: #fff;
  border: 1rpx solid var(--lq-border);
  box-shadow: var(--lq-shadow-soft);
}

.legal-company {
  display: block;
  font-size: 22rpx;
  color: var(--lq-text-secondary);
}

.legal-title {
  display: block;
  margin-top: 8rpx;
  font-size: 34rpx;
  font-weight: 800;
  color: var(--lq-text);
}

.legal-date,
.legal-phone {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  color: var(--lq-text-secondary);
}

.legal-section {
  margin-bottom: 28rpx;
  padding: 24rpx 28rpx;
  border-radius: var(--lq-radius-md);
  background: #fff;
  border: 1rpx solid var(--lq-border);
}

.legal-section-title {
  display: block;
  font-size: 28rpx;
  font-weight: 700;
  color: var(--lq-text);
  margin-bottom: 12rpx;
}

.legal-paragraph {
  display: block;
  margin-top: 10rpx;
  font-size: 24rpx;
  line-height: 1.75;
  color: var(--lq-text-secondary);
}
