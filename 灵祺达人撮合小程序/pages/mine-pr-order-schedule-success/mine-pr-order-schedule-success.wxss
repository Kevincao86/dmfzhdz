@import '../../styles/theme.wxss';

.sch-ok-page {
  padding: 48rpx 24rpx;
}

.sch-ok-card {
  text-align: center;
  padding: 48rpx 32rpx;
}

.sch-ok-icon {
  font-size: 96rpx;
  color: #047857;
  display: block;
  margin-bottom: 16rpx;
}

.sch-ok-title {
  display: block;
  font-size: 34rpx;
  font-weight: 700;
  color: #047857;
  margin-bottom: 16rpx;
}

.sch-ok-desc {
  display: block;
  line-height: 1.6;
  margin-bottom: 32rpx;
}

.sch-ok-actions {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.sch-ok-btn {
  margin: 0 !important;
  border-radius: 999rpx !important;
}

.sch-ok-btn--primary {
  background: var(--lq-gradient, linear-gradient(135deg, #6366f1, #8b5cf6)) !important;
  color: #fff !important;
  border: none !important;
}
