@import '../../styles/theme.wxss';
@import '../../styles/application-cards.wxss';

.empty-title {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  margin: 12rpx 0 8rpx;
}

.app-tab-scroll {
  width: 100%;
  white-space: nowrap;
  margin-bottom: 8rpx;
}

.app-tab-bar {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  padding: 16rpx 24rpx 8rpx;
  min-width: 100%;
  box-sizing: border-box;
}

.app-tab {
  flex-shrink: 0;
  padding: 12rpx 24rpx;
  border-radius: 999rpx;
  font-size: 26rpx;
  color: #64748b;
  background: rgba(255, 255, 255, 0.85);
  border: 1rpx solid rgba(99, 102, 241, 0.12);
}

.app-tab--on {
  color: var(--lq-primary, #6366f1);
  font-weight: 600;
  background: #fff;
  border-color: rgba(99, 102, 241, 0.35);
  box-shadow: 0 4rpx 12rpx rgba(99, 102, 241, 0.12);
}

.app-card__tag--status-pending {
  color: #c2410c;
  background: rgba(251, 146, 60, 0.12);
}

.app-card__tag--status-accepted {
  color: #1d4ed8;
  background: rgba(59, 130, 246, 0.12);
}

.app-card__tag--status-completed {
  color: #047857;
  background: rgba(16, 185, 129, 0.12);
}

.app-card__tag--status-cancelled {
  color: #6b7280;
  background: rgba(107, 114, 128, 0.12);
}

.app-list-toolbar {
  flex-shrink: 0;
  padding-top: 16rpx;
}

.app-search-bar {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin: 0 24rpx 12rpx;
  padding: 0 24rpx;
  height: 72rpx;
  box-sizing: border-box;
  background: #fff;
  border-radius: var(--lq-radius-md);
  border: 1rpx solid rgba(99, 102, 241, 0.15);
  box-shadow: var(--lq-shadow-soft);
}

.app-search-icon {
  flex-shrink: 0;
  font-size: 32rpx;
  color: #9ca3af;
  line-height: 1;
}

.app-search-input {
  flex: 1;
  min-width: 0;
  height: 72rpx;
  min-height: 72rpx;
  line-height: 72rpx;
  font-size: 28rpx;
  padding: 0;
  margin: 0;
  background: transparent;
  border: none;
  box-sizing: border-box;
}

.app-search-ph {
  color: #9ca3af;
  font-size: 26rpx;
}

.app-filter-scroll {
  width: 100%;
  white-space: nowrap;
}

.app-filter-bar {
  display: inline-flex;
  align-items: stretch;
  min-width: 100%;
  margin: 0 24rpx 16rpx;
  padding: 8rpx 0;
  background: var(--lq-gradient-filter);
  border-radius: var(--lq-radius-md);
  border: 1rpx solid rgba(99, 102, 241, 0.15);
  box-shadow: var(--lq-shadow-card);
}

.app-filter-cell {
  flex: 0 0 20%;
  min-width: 128rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-right: 1rpx solid var(--lq-border);
}

.app-filter-cell:last-child {
  border-right: none;
}

.app-filter-cell picker {
  width: 100%;
}

.app-filter-item {
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 4rpx;
  padding: 8rpx 6rpx;
  box-sizing: border-box;
  min-height: 52rpx;
}

.app-filter-item--on .app-filter-label {
  color: var(--lq-primary-dark);
  font-weight: 700;
}

.app-filter-item--on .app-filter-arrow {
  color: var(--lq-primary);
}

.app-filter-label {
  font-size: 22rpx;
  color: var(--lq-text);
  font-weight: 500;
  line-height: 1.2;
  max-width: 88%;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.app-filter-arrow {
  font-size: 16rpx;
  color: #d1d5db;
  flex-shrink: 0;
}

.app-card__reject {
  margin: 12rpx 24rpx 0;
  padding: 12rpx 16rpx;
  border-radius: 12rpx;
  background: #fef2f2;
  color: #b91c1c;
  font-size: 22rpx;
  line-height: 1.5;
}

.app-card__visit-hint {
  margin: 12rpx 24rpx 0;
  padding: 12rpx 16rpx;
  border-radius: 12rpx;
  background: #fffbeb;
  color: #92400e;
  font-size: 22rpx;
  line-height: 1.5;
}

.app-card__btn--upload {
  align-self: flex-start;
  width: auto !important;
  min-width: 0;
  padding: 10rpx 24rpx !important;
  background: rgba(14, 165, 233, 0.1) !important;
  color: #0369a1 !important;
  border: 1rpx solid rgba(14, 165, 233, 0.35) !important;
  border-radius: 999rpx;
  font-size: 24rpx;
  font-weight: 600;
  line-height: 1.4;
}

.app-card__btn--submit {
  background: rgba(34, 197, 94, 0.12) !important;
  color: #15803d !important;
  border: 1rpx solid rgba(34, 197, 94, 0.35) !important;
}

.app-card__btn-stack {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  flex: 1;
  min-width: 0;
  max-width: 100%;
}

.app-card__btn-row {
  display: flex;
  flex-direction: row;
  align-items: stretch;
  gap: 12rpx;
  flex: 1;
  min-width: 0;
  max-width: 100%;
}

.app-card__btn-row .app-card__btn--pair {
  flex: 1;
  min-width: 0;
  width: auto !important;
  align-self: stretch !important;
  margin: 0 !important;
  padding: 14rpx 10rpx !important;
  min-height: 56rpx;
  box-sizing: border-box;
  font-size: 22rpx;
  line-height: 1.2;
  white-space: nowrap;
  text-align: center;
  display: inline-flex;
  align-items: center;
  justify-content: center;
}

.app-card__btn-row .app-card__btn--ice.app-card__btn--pair {
  flex: 1.45;
}

.app-card__btn-row .app-card__btn--view.app-card__btn--pair {
  flex: 1;
}

.app-card__action-bottom {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  width: 100%;
  box-sizing: border-box;
}

.app-card__btn-group {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  align-items: center;
  justify-content: flex-start;
  gap: 12rpx;
  flex: 1;
  min-width: 0;
}

.app-card__action-bottom .app-card__foot {
  margin-top: 0;
  flex-shrink: 0;
  padding-left: 8rpx;
}

.app-card__btn--half {
  flex: 1;
  min-width: 0;
}

.app-card__btn--view {
  align-self: flex-start;
  width: auto !important;
  min-width: 0;
  padding: 10rpx 24rpx !important;
  background: rgba(2, 132, 199, 0.08) !important;
  color: #0369a1 !important;
  border: 1rpx solid rgba(2, 132, 199, 0.28) !important;
  border-radius: 999rpx;
  font-size: 24rpx;
  font-weight: 600;
  line-height: 1.4;
}

.app-card__btn--ai {
  align-self: flex-start;
  width: auto !important;
  min-width: 0;
  padding: 10rpx 24rpx !important;
  background: rgba(13, 148, 136, 0.08) !important;
  color: #0f766e !important;
  border: 1rpx solid rgba(13, 148, 136, 0.28) !important;
  border-radius: 999rpx;
  font-size: 24rpx;
  font-weight: 600;
  line-height: 1.4;
}

.app-card__actions {
  display: flex;
  flex-direction: column;
  align-items: stretch;
  gap: 12rpx;
  padding: 0 24rpx 16rpx;
}

.app-card__btn {
  margin: 0 !important;
}

.app-card__btn--primary {
  width: 100% !important;
  background: var(--lq-gradient) !important;
  color: #fff !important;
  border: none !important;
  text-align: center;
  padding: 20rpx 0 !important;
  border-radius: 999rpx;
  font-size: 28rpx;
  font-weight: 600;
  line-height: 1.4;
  box-shadow: 0 8rpx 0 rgba(2, 132, 199, 0.28);
}

.app-card__btn--ice {
  align-self: flex-start;
  width: auto !important;
  min-width: 0;
  padding: 10rpx 24rpx !important;
  background: rgba(124, 58, 237, 0.08) !important;
  color: var(--lq-primary) !important;
  border: 1rpx solid rgba(124, 58, 237, 0.28) !important;
  border-radius: 999rpx;
  font-size: 24rpx;
  font-weight: 600;
  line-height: 1.4;
}

.app-card__btn::after {
  border: none;
}

.app-card__btn--hover {
  opacity: 0.88;
}

.app-card__tag--video {
  background: rgba(245, 158, 11, 0.12);
  color: #b45309;
}

.app-card__tag--progress {
  color: #fff;
  background: var(--lq-gradient-tab);
}

.app-card__tag--type {
  color: #4338ca;
  background: #eef2ff;
}
