@import '../../styles/theme.wxss';
@import '../../styles/application-cards.wxss';

.empty-title {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  margin: 12rpx 0 8rpx;
}

.app-list-toolbar {
  flex-shrink: 0;
  padding-top: 16rpx;
}

.app-search-bar {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin: 0 24rpx 12rpx;
  padding: 0 24rpx;
  height: 72rpx;
  box-sizing: border-box;
  background: #fff;
  border-radius: var(--lq-radius-md);
  border: 1rpx solid rgba(99, 102, 241, 0.15);
  box-shadow: var(--lq-shadow-soft);
}

.app-search-icon {
  flex-shrink: 0;
  font-size: 32rpx;
  color: #9ca3af;
  line-height: 1;
}

.app-search-input {
  flex: 1;
  min-width: 0;
  height: 72rpx;
  min-height: 72rpx;
  line-height: 72rpx;
  font-size: 28rpx;
  padding: 0;
  margin: 0;
  background: transparent;
  border: none;
  box-sizing: border-box;
}

.app-search-ph {
  color: #9ca3af;
  font-size: 26rpx;
}

.app-filter-scroll {
  width: 100%;
  white-space: nowrap;
}

.app-filter-bar {
  display: inline-flex;
  align-items: stretch;
  min-width: 100%;
  margin: 0 24rpx 16rpx;
  padding: 8rpx 0;
  background: var(--lq-gradient-filter);
  border-radius: var(--lq-radius-md);
  border: 1rpx solid rgba(99, 102, 241, 0.15);
  box-shadow: var(--lq-shadow-card);
}

.app-filter-cell {
  flex: 0 0 20%;
  min-width: 128rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-right: 1rpx solid var(--lq-border);
}

.app-filter-cell:last-child {
  border-right: none;
}

.app-filter-cell picker {
  width: 100%;
}

.app-filter-item {
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 4rpx;
  padding: 8rpx 6rpx;
  box-sizing: border-box;
  min-height: 52rpx;
}

.app-filter-item--on .app-filter-label {
  color: var(--lq-primary-dark);
  font-weight: 700;
}

.app-filter-item--on .app-filter-arrow {
  color: var(--lq-primary);
}

.app-filter-label {
  font-size: 22rpx;
  color: var(--lq-text);
  font-weight: 500;
  line-height: 1.2;
  max-width: 88%;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.app-filter-arrow {
  font-size: 16rpx;
  color: #d1d5db;
  flex-shrink: 0;
}

.app-card__reject {
  margin: 12rpx 24rpx 0;
  padding: 12rpx 16rpx;
  border-radius: 12rpx;
  background: #fef2f2;
  color: #b91c1c;
  font-size: 22rpx;
  line-height: 1.5;
}

.app-card__actions {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  padding: 0 24rpx 16rpx;
}

.app-card__btn {
  margin: 0 !important;
  width: 100% !important;
}

.app-card__btn--primary {
  background: #7c3aed !important;
  color: #fff !important;
  border: none !important;
  text-align: center;
  padding: 16rpx 0;
  border-radius: 12rpx;
  font-size: 26rpx;
  font-weight: 600;
}

.app-card__btn::after {
  border: none;
}

.app-card__btn--hover {
  opacity: 0.88;
}

.app-card__tag--video {
  background: rgba(245, 158, 11, 0.12);
  color: #b45309;
}

.app-card__tag--progress {
  color: #fff;
  background: var(--lq-gradient-tab);
}

.app-card__tag--type {
  color: #4338ca;
  background: #eef2ff;
}
