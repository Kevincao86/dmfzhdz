@import '../../styles/theme.wxss';
@import '../../styles/application-cards.wxss';

.empty-title {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  margin: 12rpx 0 8rpx;
}

.filter-strip {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  align-items: center;
  padding: 20rpx 24rpx;
  margin-bottom: 16rpx;
}

.filter-strip__label {
  font-size: 22rpx;
  color: var(--text-muted, #888);
}

.filter-pill {
  font-size: 24rpx;
  padding: 10rpx 20rpx;
  border-radius: 999rpx;
  border: 1rpx solid rgba(124, 58, 237, 0.25);
  color: #6d28d9;
  background: #fff;
}

.app-card__reject {
  margin: 12rpx 24rpx 0;
  padding: 12rpx 16rpx;
  border-radius: 12rpx;
  background: #fef2f2;
  color: #b91c1c;
  font-size: 22rpx;
  line-height: 1.5;
}

.app-card__actions {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  padding: 0 24rpx 16rpx;
}

.app-card__btn {
  margin: 0 !important;
  width: 100% !important;
}

.app-card__btn--primary {
  background: #7c3aed !important;
  color: #fff !important;
  border: none !important;
}

.app-card__tag--video {
  background: rgba(245, 158, 11, 0.12);
  color: #b45309;
}
