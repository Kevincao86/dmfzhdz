<view class="app-list-page page-shell {{lqThemeClass}}">
  <scroll-view wx:if="{{rows.length > 0 || !loading}}" class="app-tab-scroll" scroll-x enable-flex show-scrollbar="{{false}}">
    <view class="app-tab-bar">
      <view
        wx:for="{{tabOptions}}"
        wx:key="id"
        class="app-tab {{filterTab === item.id ? 'app-tab--on' : ''}}"
        data-id="{{item.id}}"
        bindtap="onTabChange"
      >
        <text>{{item.label}}</text>
      </view>
    </view>
  </scroll-view>

  <view wx:if="{{rows.length > 0}}" class="app-list-toolbar">
  <view class="app-search-bar">
    <text class="app-search-icon" aria-hidden="true">⌕</text>
    <input
      class="app-search-input"
      type="text"
      placeholder="搜索商单、门店、城市、单号"
      placeholder-class="app-search-ph"
      value="{{keyword}}"
      bindinput="onKeywordInput"
      confirm-type="search"
    />
  </view>
  <scroll-view class="app-filter-scroll" scroll-x enable-flex show-scrollbar="{{false}}">
  <view class="app-filter-bar">
    <view class="app-filter-cell">
      <picker mode="selector" range="{{timeOptions}}" range-key="label" bindchange="onTimeFilterChange">
        <view class="app-filter-item {{timeFilter !== 'all' ? 'app-filter-item--on' : ''}}">
          <text class="app-filter-label">{{timeFilterLabel}}</text>
          <text class="app-filter-arrow">▾</text>
        </view>
      </picker>
    </view>
    <view class="app-filter-cell">
      <picker mode="selector" range="{{orderTypeOptions}}" range-key="label" bindchange="onOrderTypeFilterChange">
        <view class="app-filter-item {{orderTypeFilter !== 'all' ? 'app-filter-item--on' : ''}}">
          <text class="app-filter-label">{{orderTypeFilterLabel}}</text>
          <text class="app-filter-arrow">▾</text>
        </view>
      </picker>
    </view>
    <view class="app-filter-cell">
      <picker mode="selector" range="{{categoryOptions}}" bindchange="onCategoryChange">
        <view class="app-filter-item {{category !== '全部' ? 'app-filter-item--on' : ''}}">
          <text class="app-filter-label">{{categoryLabel}}</text>
          <text class="app-filter-arrow">▾</text>
        </view>
      </picker>
    </view>
    <view class="app-filter-cell">
      <picker mode="selector" range="{{progressOptions}}" range-key="label" bindchange="onProgressFilterChange">
        <view class="app-filter-item {{progressFilter !== 'all' ? 'app-filter-item--on' : ''}}">
          <text class="app-filter-label">{{progressFilterLabel}}</text>
          <text class="app-filter-arrow">▾</text>
        </view>
      </picker>
    </view>
    <view class="app-filter-cell">
      <picker mode="selector" range="{{cityOptions}}" bindchange="onCityChange">
        <view class="app-filter-item {{city !== '全部' ? 'app-filter-item--on' : ''}}">
          <text class="app-filter-label">{{regionLabel}}</text>
          <text class="app-filter-arrow">▾</text>
        </view>
      </picker>
    </view>
  </view>
  </scroll-view>
  </view>

  <view wx:if="{{loading}}" class="card state-loading">
    <text class="hint">加载报名记录…</text>
  </view>

  <view
    wx:for="{{filteredRows}}"
    wx:key="mpOrderId"
    class="app-card"
  >
    <view class="app-card__head app-card--tap" bindtap="goDetail" data-id="{{item.mpOrderId}}">
      <image class="app-card__icon" src="{{item.platformIcon}}" mode="aspectFill" />
      <view class="app-card__main">
        <text class="app-card__title">{{item.title}}</text>
        <text class="app-card__sub">{{item.merchantName}} · {{item.storeName}}</text>
      </view>
    </view>
    <view class="app-card__tags">
      <text class="app-card__tag app-card__tag--status app-card__tag--status-{{item.displayStatusTone}}">{{item.displayStatusLabel || item.progressLabel}}</text>
      <text wx:if="{{item.orderTypeLabel}}" class="app-card__tag app-card__tag--type">{{item.orderTypeLabel}}</text>
      <text class="app-card__tag app-card__tag--hall">{{item.hallLabel}}</text>
      <text class="app-card__tag">{{item.platform}}</text>
      <text wx:if="{{item.videoStatusLabel}}" class="app-card__tag app-card__tag--video">{{item.videoStatusLabel}}</text>
    </view>
    <view class="app-card__meta-grid">
      <text class="app-card__meta-item">酬劳 {{item.budgetText}}</text>
      <text class="app-card__meta-item">地区 {{item.region}}</text>
      <text class="app-card__meta-item">报名 {{item.appliedAt}}</text>
      <text class="app-card__meta-item" wx:if="{{item.mpOrderId || item.merchantOrderNo}}">单号 {{item.mpOrderId || item.merchantOrderNo}}</text>
    </view>
    <view wx:if="{{item.videoStatus === 'rejected' && item.videoRejectReason}}" class="app-card__reject">
      <text>驳回原因：{{item.videoRejectReason}}</text>
    </view>
    <view class="app-card__actions">
      <button
        wx:if="{{item.showConfirmBtn}}"
        class="app-card__btn app-card__btn--primary"
        plain
        hover-class="app-card__btn--hover"
        catchtap="goDetail"
        data-id="{{item.mpOrderId}}"
      >
        确认档期
      </button>
      <button
        wx:if="{{item.showAssignConfirmBtn}}"
        class="app-card__btn app-card__btn--primary"
        plain
        hover-class="app-card__btn--hover"
        catchtap="goDetail"
        data-id="{{item.mpOrderId}}"
      >
        确认排期
      </button>
      <button
        wx:if="{{item.showCheckInBtn}}"
        class="app-card__btn app-card__btn--primary"
        plain
        hover-class="app-card__btn--hover"
        catchtap="goDetail"
        data-id="{{item.mpOrderId}}"
      >
        到店签到
      </button>
      <button
        wx:if="{{item.isIce && item.progressId === 'completed'}}"
        class="app-card__btn app-card__btn--primary"
        plain
        hover-class="app-card__btn--hover"
        catchtap="goDetail"
        data-id="{{item.mpOrderId}}"
      >
        查看详情
      </button>
      <button
        wx:if="{{item.isIce && item.iceActionLabel && item.progressId !== 'completed'}}"
        class="app-card__btn app-card__btn--ice"
        plain
        hover-class="app-card__btn--hover"
        catchtap="goDetail"
        data-id="{{item.mpOrderId}}"
      >
        {{item.iceActionLabel}}
      </button>
      <button
        wx:if="{{item.canUploadVideo}}"
        class="app-card__btn app-card__btn--upload"
        plain
        hover-class="app-card__btn--hover"
        loading="{{uploadingKey === item.mpOrderId + '-' + item.applicantId}}"
        disabled="{{!!uploadingKey}}"
        catchtap="onUploadVideo"
        data-id="{{item.mpOrderId}}"
        data-applicant-id="{{item.applicantId}}"
      >
        {{uploadingKey === item.mpOrderId + '-' + item.applicantId ? '上传中…' : item.uploadBtnLabel}}
      </button>
      <view class="app-card__foot app-card--tap" bindtap="goDetail" data-id="{{item.mpOrderId}}">
        <text>查看商单详情</text>
        <text class="app-card__link">›</text>
      </view>
    </view>
  </view>

  <view wx:if="{{mineGuestMode}}" class="card state-empty">
    <text class="state-empty-icon">🔒</text>
    <text class="empty-title">没有数据，请登录后查看</text>
    <text class="hint">请返回「我的」完成微信登录后再查看报名记录</text>
  </view>

  <view wx:elif="{{!loading && rows.length === 0}}" class="card state-empty">
    <text class="state-empty-icon">📋</text>
    <text class="empty-title">暂无报名记录</text>
    <text class="hint">在招募大厅报名后，将在此展示商单与报名状态</text>
  </view>

  <view wx:if="{{!loading && rows.length > 0 && filteredRows.length === 0}}" class="card state-empty">
    <text class="hint">当前 Tab 或筛选条件下暂无报名</text>
  </view>
</view>
