.dock-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 10000;
  background: rgba(15, 23, 42, 0.45);
  display: flex;
  align-items: flex-end;
}
.dock-sheet {
  width: 100%;
  background: #fff;
  border-radius: 28rpx 28rpx 0 0;
  padding: 28rpx 12rpx calc(16rpx + env(safe-area-inset-bottom));
}
.dock-title {
  display: block;
  text-align: center;
  font-size: 28rpx;
  color: #334155;
  margin-bottom: 20rpx;
  padding: 0 24rpx;
}
.dock-row {
  display: flex;
  justify-content: space-around;
  padding: 8rpx 8rpx 20rpx;
}
.dock-cell,
.dock-btn {
  width: 128rpx;
  margin: 0;
  padding: 0;
  background: transparent;
  line-height: 1.2;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.dock-btn::after {
  border: none;
}
.dock-icon-img {
  display: block;
  width: 96rpx;
  height: 96rpx;
  border-radius: 28rpx;
  flex-shrink: 0;
}
.dock-label {
  margin-top: 12rpx;
  font-size: 22rpx;
  color: #334155;
  text-align: center;
}
.dock-cancel {
  margin: 8rpx 24rpx 0;
  height: 88rpx;
  border-radius: 16rpx;
  background: #f8fafc;
  color: #0f172a;
  font-size: 30rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
