<view class="dock-mask" wx:if="{{show}}" bindtap="onClose">
  <view class="dock-sheet" catchtap="noop">
    <text wx:if="{{title}}" class="dock-title">{{title}}</text>
    <view class="dock-row">
      <button class="dock-cell dock-btn" open-type="share" hover-class="none" bindtap="onClose">
        <view class="dock-icon dock-icon--wx">微</view>
        <text class="dock-label">微信好友</text>
      </button>
      <view class="dock-cell" data-tab="poster" bindtap="onOpen">
        <view class="dock-icon dock-icon--poster">海</view>
        <text class="dock-label">海报分享图</text>
      </view>
      <view class="dock-cell" data-tab="code" bindtap="onOpen">
        <view class="dock-icon dock-icon--code">码</view>
        <text class="dock-label">小程序码</text>
      </view>
      <view class="dock-cell" data-tab="web" data-mode="qr" bindtap="onOpen">
        <view class="dock-icon dock-icon--qr">码</view>
        <text class="dock-label">二维码</text>
      </view>
      <view class="dock-cell" data-tab="web" data-mode="link" bindtap="onOpen">
        <view class="dock-icon dock-icon--link">链</view>
        <text class="dock-label">网页链接</text>
      </view>
    </view>
    <view class="dock-cancel" bindtap="onClose">取消</view>
  </view>
</view>
