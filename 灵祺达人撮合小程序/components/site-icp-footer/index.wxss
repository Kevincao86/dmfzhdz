.site-icp-footer {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  padding: 32rpx 24rpx 24rpx;
  box-sizing: border-box;
}

.site-icp-footer--compact {
  padding: 16rpx 20rpx 12rpx;
}

.site-icp-footer__row {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  align-items: center;
  gap: 8rpx 20rpx;
}

.site-icp-footer__psb {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.site-icp-footer__badge {
  width: 28rpx;
  height: 28rpx;
  flex-shrink: 0;
}

.site-icp-footer__copy,
.site-icp-footer__text {
  font-size: 24rpx;
  line-height: 1.5;
  color: #5c4636;
  text-align: center;
  font-weight: 600;
}
