.site-icp-footer {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
  padding: 24rpx 12rpx 16rpx;
  box-sizing: border-box;
  width: 100%;
}

.site-icp-footer--compact {
  padding: 16rpx 20rpx 12rpx;
}

.site-icp-footer__row {
  display: flex;
  flex-wrap: nowrap;
  justify-content: center;
  align-items: center;
  gap: 8rpx 16rpx;
  max-width: 100%;
}

.site-icp-footer__psb {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.site-icp-footer__badge {
  width: 28rpx;
  height: 28rpx;
  flex-shrink: 0;
}

.site-icp-footer__copy,
.site-icp-footer__text {
  font-size: 20rpx;
  line-height: 1.4;
  color: #5c4636;
  text-align: center;
  white-space: nowrap;
}
