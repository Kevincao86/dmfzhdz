.fg {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  z-index: 10050;
}

.fg-hole {
  position: fixed;
  z-index: 10051;
  border-radius: 20rpx;
  border: 4rpx solid #7c5cff;
  box-shadow: 0 0 0 9999px rgba(15, 23, 42, 0.5);
  pointer-events: none;
}

.fg-card {
  position: fixed;
  left: 32rpx;
  right: 32rpx;
  z-index: 10052;
  padding: 28rpx 28rpx 24rpx;
  border-radius: 28rpx;
  background: #fff;
  box-shadow: 0 16rpx 48rpx rgba(15, 23, 42, 0.2);
  box-sizing: border-box;
}

.fg-kicker {
  display: block;
  font-size: 22rpx;
  font-weight: 700;
  color: #7c5cff;
}

.fg-title {
  display: block;
  margin-top: 8rpx;
  font-size: 34rpx;
  font-weight: 800;
  color: #1c1917;
}

.fg-body {
  display: block;
  margin-top: 12rpx;
  font-size: 26rpx;
  line-height: 1.55;
  color: #57534e;
}

.fg-actions {
  display: flex;
  justify-content: flex-end;
  align-items: center;
  gap: 16rpx;
  margin-top: 24rpx;
}

.fg-skip,
.fg-next {
  min-width: 120rpx;
  height: 64rpx;
  padding: 0 24rpx;
  border-radius: 999rpx;
  font-size: 26rpx;
  font-weight: 700;
  line-height: 64rpx;
  text-align: center;
}

.fg-skip {
  color: #78716c;
  background: #f5f5f4;
}

.fg-next {
  color: #fff;
  background: #7c5cff;
}
