.orbit {
  width: 100%;
  box-sizing: border-box;
}

.orbit__hint {
  text-align: center;
  padding: 6rpx 0 10rpx;
}

.orbit__hint-txt {
  font-size: 22rpx;
  color: var(--lq-text-secondary, #6b7280);
  letter-spacing: 1rpx;
}

.orbit__stage {
  position: relative;
  width: 100%;
  height: 460rpx;
  perspective: 1280rpx;
  perspective-origin: 50% 40%;
}

.orbit__ring {
  position: absolute;
  left: 50%;
  top: 44%;
  width: 0;
  height: 0;
  transform-style: preserve-3d;
  transition: transform 0.05s linear;
  will-change: transform;
}

.orbit__ring--snap {
  transition: transform 0.35s cubic-bezier(0.22, 1, 0.36, 1);
}

.orbit__face {
  position: absolute;
  left: 0;
  top: 0;
  width: 208rpx;
  height: 262rpx;
  margin-left: -104rpx;
  margin-top: -131rpx;
  transform-style: preserve-3d;
  backface-visibility: hidden;
}

.orbit__card {
  width: 100%;
  height: 100%;
  border-radius: 26rpx;
  overflow: hidden;
  border: 4rpx solid rgba(255, 255, 255, 0.95);
  box-shadow:
    0 20rpx 44rpx rgba(99, 102, 241, 0.26),
    0 6rpx 16rpx rgba(15, 23, 42, 0.1);
  background: #fff;
  position: relative;
}

.orbit__img {
  width: 100%;
  height: 100%;
  display: block;
  pointer-events: none;
}

.orbit__shine {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  height: 42%;
  background: linear-gradient(180deg, rgba(255, 255, 255, 0.32) 0%, transparent 100%);
  pointer-events: none;
}

.orbit__zoom-hint {
  position: absolute;
  right: 10rpx;
  bottom: 10rpx;
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  background: rgba(15, 23, 42, 0.42);
  display: flex;
  align-items: center;
  justify-content: center;
  pointer-events: none;
}

.orbit__zoom-icon {
  font-size: 26rpx;
  color: #fff;
  line-height: 1;
}

.orbit__pedestal {
  position: absolute;
  left: 50%;
  bottom: 8rpx;
  width: 520rpx;
  height: 72rpx;
  margin-left: -260rpx;
  border-radius: 50%;
  background: radial-gradient(
    ellipse at center,
    rgba(139, 147, 255, 0.32) 0%,
    rgba(139, 147, 255, 0.08) 55%,
    transparent 72%
  );
  transform: rotateX(72deg);
}
