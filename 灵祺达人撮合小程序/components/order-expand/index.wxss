.order-expand-mask {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  z-index: 900;
  background: rgba(15, 23, 42, 0.38);
  opacity: 0;
  transition: opacity 280ms ease;
}

.order-expand-mask.is-on {
  opacity: 1;
}

.order-expand-card {
  position: fixed;
  z-index: 901;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  box-sizing: border-box;
  background: #fff;
  border-radius: 24rpx;
  box-shadow: 0 24rpx 80rpx rgba(15, 23, 42, 0.28);
  transition:
    top 320ms cubic-bezier(0.2, 0.8, 0.2, 1),
    left 320ms cubic-bezier(0.2, 0.8, 0.2, 1),
    width 320ms cubic-bezier(0.2, 0.8, 0.2, 1),
    height 320ms cubic-bezier(0.2, 0.8, 0.2, 1);
}

.order-expand-card__bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex-shrink: 0;
  padding: 16rpx 20rpx 8rpx;
}

.order-expand-card__x {
  width: 72rpx;
  height: 72rpx;
  border-radius: 999rpx;
  background: #f5f0e8;
  color: #1c1917;
  font-size: 44rpx;
  line-height: 68rpx;
  text-align: center;
}

.order-expand-card__tools {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.order-expand-card__tool {
  display: flex;
  align-items: center;
  gap: 6rpx;
  min-height: 72rpx;
  padding: 0 16rpx;
  border-radius: 999rpx;
  background: #f5f0e8;
  color: #44403c;
  font-size: 24rpx;
  line-height: 1;
}

.order-expand-card__tool-icon {
  font-size: 28rpx;
  color: #a8a29e;
}

.order-expand-card__tool-icon.is-on {
  color: #ea580c;
}

.order-expand-card__bar {
  position: relative;
  z-index: 6;
}

.order-expand-share-dismiss {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 4;
}

.order-expand-share-wrap {
  position: relative;
}

.order-expand-share-menu {
  position: absolute;
  top: calc(100% + 10rpx);
  right: 0;
  z-index: 7;
  min-width: 280rpx;
  padding: 8rpx 0;
  border-radius: 16rpx;
  background: var(--lq-card, #fff);
  border: 1rpx solid var(--lq-border, rgba(15, 23, 42, 0.08));
  box-shadow: 0 12rpx 40rpx rgba(15, 23, 42, 0.16);
}

.order-expand-share-menu__item {
  display: flex;
  align-items: center;
  gap: 14rpx;
  width: 100%;
  margin: 0;
  padding: 16rpx 22rpx;
  border: 0;
  border-radius: 0;
  background: transparent !important;
  color: var(--lq-text, #1c1917);
  font-size: 28rpx;
  line-height: 1.4;
  text-align: left;
  box-sizing: border-box;
}

.order-expand-share-menu__icon {
  width: 44rpx;
  height: 44rpx;
  border-radius: 12rpx;
  flex-shrink: 0;
}

.order-expand-share-menu__item::after {
  border: none;
}

.order-expand-share-menu__item--primary {
  color: #c2410c;
  font-weight: 700;
}

.lq-accent-dark .order-expand-share-menu {
  background: #27272a !important;
  border-color: rgba(244, 244, 245, 0.28) !important;
}

.lq-accent-dark .order-expand-share-menu__item,
.lq-accent-dark .order-expand-share-menu__item--primary {
  color: #fafafa !important;
  background: transparent !important;
}

.order-expand-poster-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 10020;
  display: flex;
  align-items: flex-end;
  justify-content: center;
  padding: 24rpx 24rpx calc(24rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  background: rgba(15, 23, 42, 0.45);
}

.order-expand-poster-sheet {
  display: flex;
  flex-direction: column;
  width: 100%;
  max-height: 86vh;
  overflow: hidden;
  padding: 28rpx 28rpx 8rpx;
  border-radius: 24rpx;
  background: #fff;
  box-sizing: border-box;
}

.order-expand-poster-sheet__scroll {
  height: 52vh;
  min-height: 0;
}

.order-expand-poster-sheet__head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.order-expand-poster-sheet__title {
  color: #1c1917;
  font-size: 32rpx;
  font-weight: 700;
}

.order-expand-poster-sheet__close {
  width: 64rpx;
  height: 64rpx;
  border-radius: 999rpx;
  background: #f5f0e8;
  color: #1c1917;
  font-size: 40rpx;
  line-height: 60rpx;
  text-align: center;
}

.order-expand-poster-sheet__img {
  width: 100%;
  margin-top: 20rpx;
  border-radius: 16rpx;
}

.order-expand-poster-sheet__state {
  display: block;
  padding: 48rpx 0;
  color: #78716c;
  font-size: 26rpx;
  text-align: center;
}

.order-expand-poster-sheet__foot {
  flex-shrink: 0;
  padding: 16rpx 0 20rpx;
  background: #fff;
}

.order-expand-poster-sheet__style {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  color: #57534e;
  font-size: 24rpx;
}

.order-expand-poster-sheet__switch,
.order-expand-poster-sheet__save {
  color: #c2410c;
  font-size: 28rpx;
  font-weight: 700;
}

.order-expand-poster-sheet__save {
  margin-top: 20rpx;
  height: 84rpx;
  border-radius: 16rpx;
  background: #fff7ed;
  line-height: 84rpx;
  text-align: center;
}

.order-expand-card__body {
  height: calc(100% - 240rpx);
  padding: 8rpx 28rpx 12rpx;
  box-sizing: border-box;
  opacity: 0;
}

.order-expand-card.is-open .order-expand-card__body,
.order-expand-card.is-open .order-expand-card__foot {
  opacity: 1;
  transition: opacity 180ms ease 80ms;
}

.order-expand-card__cover {
  width: 100%;
  height: 280rpx;
  border-radius: 16rpx;
  background: #f5f0e8;
}

.order-expand-card__title {
  display: block;
  margin-top: 20rpx;
  color: #1c1917;
  font-size: 34rpx;
  font-weight: 700;
  line-height: 1.35;
}

.order-expand-card__tags {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 16rpx;
}

.order-expand-card__tag {
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
  background: #f5f0e8;
  color: #57534e;
  font-size: 22rpx;
}

.order-expand-card__price {
  display: block;
  margin-top: 16rpx;
  color: #c2410c;
  font-size: 32rpx;
  font-weight: 700;
}

.order-expand-card__meta {
  display: block;
  margin-top: 10rpx;
  color: #78716c;
  font-size: 24rpx;
  line-height: 1.45;
}

.order-expand-card__section {
  margin-top: 28rpx;
}

.order-expand-card__section-title {
  display: block;
  margin-bottom: 10rpx;
  color: #1c1917;
  font-size: 28rpx;
  font-weight: 700;
}

.order-expand-card__line {
  display: block;
  margin-top: 8rpx;
  color: #44403c;
  font-size: 26rpx;
  line-height: 1.55;
}

.order-expand-card__state {
  padding: 48rpx 0;
  color: #78716c;
  font-size: 26rpx;
  text-align: center;
}

.order-expand-card__foot {
  flex-shrink: 0;
  padding: 12rpx 24rpx 20rpx;
  opacity: 0;
}

.order-expand-card__apply {
  height: 84rpx;
  border-radius: 16rpx;
  background: #ea580c;
  color: #fff;
  font-size: 30rpx;
  font-weight: 700;
  line-height: 84rpx;
  text-align: center;
}

.order-expand-card__apply--muted {
  background: #f5f0e8;
  color: #92400e;
  font-size: 26rpx;
  font-weight: 600;
}
