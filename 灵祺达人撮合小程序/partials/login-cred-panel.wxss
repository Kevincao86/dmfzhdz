.cred-check-row {
  padding: 8rpx 0;
}

.cred-check-label {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
  font-size: 28rpx;
  color: #374151;
  line-height: 1.5;
}

.cred-ready-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  padding: 8rpx 0;
}

.cred-ready-text {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--lq-primary-dark, #047857);
}

.cred-ready-actions {
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex-shrink: 0;
}

.cred-view-value {
  display: block;
  margin-top: 8rpx;
  padding: 16rpx 20rpx;
  border-radius: 16rpx;
  background: #fafaf9;
  color: #1c1917;
  font-size: 28rpx;
}

.cred-ready-actions .cred-edit-btn {
  width: auto;
  min-width: 0;
  max-width: none;
  margin: 0;
}

.cred-edit-btn::after {
  border: none;
}

.cred-modal-mask {
  position: fixed;
  inset: 0;
  background: rgba(15, 23, 42, 0.45);
  z-index: 200;
}

.cred-modal {
  position: fixed;
  left: 32rpx;
  right: 32rpx;
  top: 50%;
  transform: translateY(-50%);
  background: #fff;
  border-radius: 24rpx;
  padding: 32rpx;
  z-index: 201;
  box-shadow: 0 24rpx 48rpx rgba(15, 23, 42, 0.12);
}

.cred-modal-title {
  display: block;
  font-size: 32rpx;
  font-weight: 700;
  margin-bottom: 24rpx;
  color: #0f172a;
}

.cred-modal-err {
  display: block;
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #dc2626;
}

.cred-modal-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 28rpx;
}

.cred-modal-btn {
  flex: 1;
  margin: 0;
  height: 80rpx;
  line-height: 80rpx;
  font-size: 28rpx;
  font-weight: 600;
  border-radius: 999rpx;
  color: #4b5563;
  background: #f3f4f6;
}

.cred-modal-btn::after {
  border: none;
}

.cred-modal-btn--primary {
  color: #fff;
  background: var(--lq-gradient);
}

.cred-sms-row {
  display: flex;
  align-items: center;
  gap: 8px;
}

.cred-sms-input {
  flex: 1;
  min-width: 0;
}

.cred-sms-btn {
  flex-shrink: 0;
  margin: 0;
  color: #5b21b6;
  background: #f5f3ff;
}

.cred-sms-btn::after {
  border: none;
}
