<view class="lq-sub-nav lq-hero-header" style="{{subNavBandStyle}}">
  <view class="lq-hero-bg lq-hero-bg--sub" aria-hidden="true">
    <view class="lq-hero-bg__pattern" />
    <view class="lq-hero-bg__glow lq-hero-bg__glow--1" />
    <view class="lq-hero-bg__glow lq-hero-bg__glow--2" />
  </view>
  <view class="lq-sub-nav__inner lq-hero-header__inner" style="{{subNavInnerStyle}}">
    <view class="lq-sub-nav__bar">
      <text class="lq-sub-nav__back" bindtap="onSubNavBack">‹</text>
      <text class="lq-sub-nav__title">{{subNavTitle}}</text>
    </view>
  </view>
</view>
