<view class="tab-bar {{lqThemeClass}} {{hasCenterFab ? 'tab-bar--fab' : ''}} {{guideOn ? 'tab-bar--guide' : ''}}" wx:if="{{!hidden}}">
  <view
    wx:for="{{list}}"
    wx:key="pagePath"
    class="tab-item {{item.center ? 'tab-item--center' : ''}} {{selected === index ? 'active' : ''}} {{guideOn && guideSpot === index ? 'tab-item--spot' : ''}}"
    data-index="{{index}}"
    bindtap="switchTab"
  >
    <block wx:if="{{item.center}}">
      <view class="fab-btn">
        <view class="fab-btn-inner">
          <view class="fab-line fab-line--h"></view>
          <view class="fab-line fab-line--v"></view>
        </view>
      </view>
      <text class="tab-text tab-text--fab">{{item.text}}</text>
    </block>
    <block wx:else>
      <view class="tab-icon-wrap">
        <view class="tab-icon tab-icon-{{item.icon}} {{selected === index ? 'is-active' : ''}}">
          <block wx:if="{{item.icon === 'home'}}">
            <view class="ico ico-home">
              <view class="ico-home-roof"></view>
              <view class="ico-home-body">
                <view class="ico-home-door"></view>
              </view>
            </view>
          </block>
          <block wx:elif="{{item.icon === 'star'}}">
            <view class="ico ico-star"></view>
            <view class="tab-ai-badge" wx:if="{{item.aiBadge}}">AI</view>
          </block>
          <block wx:elif="{{item.icon === 'insight'}}">
            <view class="ico ico-insight">
              <view class="ico-insight-spark"></view>
            </view>
          </block>
          <block wx:elif="{{item.icon === 'chat'}}">
            <view class="ico ico-chat">
              <view class="ico-chat-tail"></view>
            </view>
            <view class="tab-badge" wx:if="{{chatBadge > 0}}">{{chatBadge > 99 ? '99+' : chatBadge}}</view>
          </block>
          <block wx:else>
            <view class="ico ico-user">
              <view class="ico-user-head"></view>
              <view class="ico-user-shoulder"></view>
            </view>
          </block>
        </view>
      </view>
      <text class="tab-text {{item.compact ? 'tab-text--compact' : ''}}">{{item.text}}</text>
    </block>
  </view>
</view>
<view class="menu-guide" wx:if="{{guideOn && !hidden}}" catchtouchmove="preventGuideMove">
  <view class="menu-guide__card" style="left: {{guideLeft}}%;">
    <text class="menu-guide__kicker">操作指引 {{guideStep + 1}}/{{guideTotal}}</text>
    <text class="menu-guide__title">{{guideTitle}}</text>
    <text class="menu-guide__body">{{guideBody}}</text>
    <view class="menu-guide__actions">
      <view class="menu-guide__skip" catchtap="onGuideSkip">跳过</view>
      <view class="menu-guide__next" catchtap="onGuideNext">{{guideLast ? '知道了' : '下一步'}}</view>
    </view>
  </view>
</view>
