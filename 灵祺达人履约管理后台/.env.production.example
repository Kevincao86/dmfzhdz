# 复制为 .env.production（仅 ECS/本机构建用，勿提交 Git）
# 构建脚本会 source 本文件后执行 npm run build（Vite envDir 指向商家目录，须在此显式导出）
# 变量可从 Vercel 履约项目 Environment Variables 对照填写

# 小程序/履约 Web 共用 API（勿带末尾 /，勿写成 .../erp-api/api）
VITE_MP_API_BASE=https://mofangdianai.com/erp-api

# 增值服务嵌入页（抖音来客等，与商家版相同）
VITE_SUPABASE_URL=https://mofangdianai.com
VITE_SUPABASE_ANON_KEY=

# 嵌入 @merchant 页面调用的 ERP API（与 VITE_MP_API_BASE 一致即可）
VITE_ERP_AUTH_API_BASE=https://mofangdianai.com/erp-api
