/**
 * 子菜单深度美化壳层（全页生效）
 * 对齐 docs/mp-erp-ui-mock 浅底 + 青主色 + 卡片质感
 */
.page-pad-v2 {
  min-height: 100vh;
  padding: 20rpx 24rpx calc(24rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  background: #f4f8fc;
}

/* 页头 Hero */
.lq-hero,
.hero-purple {
  position: relative;
  overflow: hidden;
  border-radius: 28rpx;
  padding: 32rpx 28rpx;
  margin-bottom: 20rpx;
  background: #ffffff;
  border: 1rpx solid #d5dde6;
  box-shadow: 0 12rpx 36rpx rgba(30, 58, 95, 0.08);
}

.lq-hero-title,
.hero-purple {
  font-size: 36rpx;
  font-weight: 800;
  color: #1e3a5f;
  letter-spacing: 0.5rpx;
}

.lq-hero-sub {
  display: block;
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #64748b;
  line-height: 1.45;
}

.lq-hero-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.lq-hero-logo {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: #fff;
  box-shadow: 0 8rpx 24rpx rgba(30, 58, 95, 0.18);
  flex-shrink: 0;
}

/* 导航入口卡 */
.lq-nav-card,
.list-card-v2 {
  display: flex;
  align-items: center;
  gap: 18rpx;
  background: #fff;
  border-radius: 24rpx;
  padding: 26rpx 24rpx;
  margin-bottom: 14rpx;
  border: 1rpx solid #d5dde6;
  box-shadow: 0 8rpx 28rpx rgba(15, 23, 42, 0.05);
}

.lq-nav-ico {
  width: 72rpx;
  height: 72rpx;
  border-radius: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  flex-shrink: 0;
  background: transparent;
  color: #1e3a5f;
}

.lq-nav-ico.violet,
.lq-nav-ico.orange,
.lq-nav-ico.teal,
.lq-nav-ico.amber {
  background: transparent;
  color: #1e3a5f;
}

.lq-nav-main {
  flex: 1;
  min-width: 0;
}

.lq-nav-title,
.list-strong {
  display: block;
  font-size: 28rpx;
  font-weight: 700;
  color: #1e3a5f;
}

.lq-nav-desc,
.list-span {
  display: block;
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #94a3b8;
  line-height: 1.4;
}

.lq-nav-card .tag,
.list-card-v2 .tag {
  font-size: 20rpx;
  font-weight: 700;
  color: #1e3a5f;
  background: #eef2f6;
  padding: 6rpx 14rpx;
  border-radius: 999rpx;
}

/* Chip / Tab */
.chip-row {
  display: flex;
  gap: 14rpx;
  margin-bottom: 20rpx;
  flex-wrap: wrap;
}

.chip {
  padding: 14rpx 28rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  background: #fff;
  border: 1rpx solid #e2e8f0;
  color: #64748b;
  box-shadow: 0 4rpx 12rpx rgba(15, 23, 42, 0.03);
}

.chip.on {
  background: #2f6fed;
  color: #fff;
  border-color: transparent;
  font-weight: 700;
  box-shadow: 0 8rpx 20rpx rgba(30, 58, 95, 0.25);
}

/* 表单 / KPI / 空态 */
.form-card-v2 {
  background: #fff;
  border-radius: 28rpx;
  padding: 28rpx;
  margin-bottom: 20rpx;
  border: 1rpx solid #d5dde6;
  box-shadow: 0 10rpx 32rpx rgba(15, 23, 42, 0.05);
}

.hint-v2 {
  font-size: 24rpx;
  color: #64748b;
  margin: 24rpx 8rpx;
  line-height: 1.5;
}

.lq-empty {
  margin: 48rpx 8rpx;
  padding: 48rpx 32rpx;
  text-align: center;
  background: #fff;
  border-radius: 28rpx;
  border: 1rpx dashed #cbd5e1;
}

.lq-empty-title {
  display: block;
  font-size: 28rpx;
  font-weight: 700;
  color: #334155;
  margin-bottom: 10rpx;
}

.lq-empty-desc {
  display: block;
  font-size: 22rpx;
  color: #94a3b8;
}

.btn-v2.primary {
  background: #2f6fed;
  box-shadow: 0 12rpx 32rpx rgba(30, 58, 95, 0.28);
}

/**
 * 输入框防裁切：微信 input 在 line-height=height 时易裁字
 * 用固定高度 + 正常行高 + 零垂直 padding
 */
input,
.op-input,
.cp-input,
.vs-input,
.pe-input,
.plist-search-input,
.rev-search-input,
.leads-search-input,
.composer-input,
.geo-input,
.sm-input,
.bw-input,
.nv-input,
.pro-input {
  min-height: 88rpx !important;
  height: 88rpx !important;
  line-height: normal !important;
  padding-top: 0 !important;
  padding-bottom: 0 !important;
  padding-left: 24rpx !important;
  padding-right: 24rpx !important;
  font-size: 28rpx !important;
  box-sizing: border-box !important;
  vertical-align: middle;
}

textarea,
.op-area,
.cp-area,
.vs-area,
.pe-area {
  min-height: 160rpx !important;
  line-height: 1.5 !important;
  padding: 20rpx 24rpx !important;
  font-size: 28rpx !important;
  box-sizing: border-box !important;
}

.kpi-hero,
.score-v2 {
  background: linear-gradient(135deg, #2f6fed, #2f6fed 55%, #2f6fed);
  box-shadow: 0 16rpx 40rpx rgba(30, 58, 95, 0.28);
}

.pick-v2 {
  border-radius: 24rpx;
  box-shadow: 0 6rpx 20rpx rgba(15, 23, 42, 0.04);
}

.flow-v2 {
  border: 1rpx solid #d5dde6;
  box-shadow: 0 6rpx 18rpx rgba(15, 23, 42, 0.04);
}

/* 通用子页根容器（覆盖各业务页根 class） */
.lq-page-bg,
.plist-page,
.ads-page,
.leads-page,
.wallet-page,
.geo-page,
.rev-page,
.sub-page,
.vs-page,
.ai-page,
.sv-root,
.store-page-v2,
.fin-page,
.dash-page-v2,
.cp-page,
.dh-page,
.op-page,
.nv-scroll,
.pro-scroll,
.bw-scroll,
.wizard-scroll,
.edit-scroll,
.voice-page,
.notify-page,
.pe-page,
.sm-page,
.legal-page {
  min-height: 100vh;
  box-sizing: border-box;
  background: #f4f8fc !important;
}

.func-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
}

.func-cell {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 18rpx 6rpx 16rpx;
  box-sizing: border-box;
}

.func-well {
  width: 88rpx;
  height: 88rpx;
  border-radius: 26rpx;
  background: #e7f0ff;
  display: flex;
  align-items: center;
  justify-content: center;
}

.func-label {
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
  width: 100%;
  margin-top: 10rpx;
  font-size: 22rpx;
  line-height: 1.3;
  font-weight: 600;
  color: #1e3a5f;
  text-align: center;
}
