<view wx:if="{{phase === 'show' || phase === 'cover'}}" class="launch-splash" style="{{stageStyle}}">
  <view wx:if="{{phase === 'show'}}" class="launch-splash__stage" style="{{stageStyle}}">
    <video
      wx:if="{{isVideo}}"
      class="launch-splash__media"
      style="{{stageStyle}}"
      src="{{imageUrl}}"
      autoplay
      muted
      object-fit="cover"
      controls="{{false}}"
      show-center-play-btn="{{false}}"
      show-play-btn="{{false}}"
      show-fullscreen-btn="{{false}}"
      enable-progress-gesture="{{false}}"
      bindtap="onTapPoster"
    />
    <image
      wx:else
      class="launch-splash__media"
      style="{{stageStyle}}"
      src="{{imageUrl}}"
      mode="aspectFill"
      bindtap="onTapPoster"
    />
  </view>
  <view wx:if="{{phase === 'show'}}" class="launch-splash__skip" style="{{skipStyle}}" catchtap="onSkip">跳过 {{remain}}</view>
</view>
