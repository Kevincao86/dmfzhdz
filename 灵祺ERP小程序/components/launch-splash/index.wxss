.launch-splash {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  z-index: 10000;
  background: #1e3a5f;
}

.launch-splash__media {
  width: 100%;
  height: 100%;
}

.launch-splash__skip {
  position: absolute;
  z-index: 2;
  min-width: 128rpx;
  height: 56rpx;
  padding: 0 22rpx;
  border-radius: 999rpx;
  background: rgba(15, 23, 42, 0.45);
  color: #fff;
  font-size: 24rpx;
  line-height: 56rpx;
  text-align: center;
}
