.launch-splash {
  position: fixed;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  z-index: 100000;
  background: #0e1525;
  overflow: hidden;
}

.launch-splash__stage {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  overflow: hidden;
}

.launch-splash__media {
  display: block;
  width: 100%;
  height: 100%;
}

.launch-splash__skip {
  position: absolute;
  z-index: 2;
  min-width: 128rpx;
  height: 56rpx;
  padding: 0 22rpx;
  border-radius: 999rpx;
  background: rgba(15, 23, 42, 0.45);
  color: #fff;
  font-size: 24rpx;
  line-height: 56rpx;
  text-align: center;
}
