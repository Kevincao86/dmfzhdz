.site-icp-footer {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  align-items: center;
  gap: 8rpx 24rpx;
  padding: 28rpx 24rpx 16rpx;
  box-sizing: border-box;
}

.site-icp-footer__psb {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.site-icp-footer__badge {
  width: 28rpx;
  height: 28rpx;
  flex-shrink: 0;
}

.site-icp-footer__text {
  font-size: 22rpx;
  line-height: 1.5;
  color: #94a3b8;
  text-align: center;
}
