:host {
  display: block;
  width: 100%;
  margin-top: auto;
  flex-shrink: 0;
}

.site-icp-spacer {
  width: 100%;
  flex-shrink: 0;
}

.site-icp-footer {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  padding: 28rpx 24rpx 16rpx;
  box-sizing: border-box;
  width: 100%;
}

.site-icp-footer--dock {
  position: fixed;
  left: 0;
  right: 0;
  z-index: 30;
  background: #f5f6f8;
  pointer-events: none;
}

.site-icp-footer--safe {
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
}

.site-icp-footer__row {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  align-items: center;
  gap: 8rpx 24rpx;
}

.site-icp-footer__copy {
  font-size: 22rpx;
  line-height: 1.5;
  color: #94a3b8;
  text-align: center;
}

.site-icp-footer__psb {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.site-icp-footer__badge {
  width: 28rpx;
  height: 28rpx;
  flex-shrink: 0;
}

.site-icp-footer__text {
  font-size: 22rpx;
  line-height: 1.5;
  color: #94a3b8;
  text-align: center;
}
