@import './styles/erp-tokens.wxss';
@import './styles/mockup-base.wxss';
@import './styles/subpage-shell.wxss';
@import './styles/mp-legacy.wxss';

page {
  background: #e8edf2;
  color: #1e3a5f;
  font-size: 28rpx;
  --lq-primary: #1e3a5f;
  --lq-primary-soft: rgba(30, 58, 95, 0.08);
  --lq-bg: #e8edf2;
  --lq-card: #ffffff;
  --lq-text: #1e3a5f;
  --lq-muted: #64748b;
  --lq-radius-card: 28rpx;
  --lq-shadow-card: 0 10rpx 36rpx rgba(15, 23, 42, 0.05);
  --tab-bar-pad: calc(98rpx + env(safe-area-inset-bottom));
}

.page-pad-v2 {
  padding: 0 28rpx 16rpx;
  box-sizing: border-box;
  min-height: 100vh;
  background: var(--lq-bg);
}

.page-func-v2 {
  padding: 0 24rpx 16rpx;
  box-sizing: border-box;
  min-height: 100vh;
}

.hint-v2.err {
  color: #dc2626;
}
