@import './styles/erp-tokens.wxss';
@import './styles/mockup-base.wxss';
@import './styles/subpage-shell.wxss';
@import './styles/mp-legacy.wxss';

/* 页脚在文档流里沉到本页底部：内容少时贴页面下沿，内容多时跟着滚动，不固定在 Tab 上 */
.foot-col.foot-col {
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
}

page > .foot-col {
  min-height: 100vh;
}

.agent-chat.foot-col,
.support-chat.foot-col,
.agent-empty.foot-col {
  min-height: 0;
}

.foot-col.foot-col > view,
.foot-col.foot-col > button,
.foot-col.foot-col > text,
.foot-col.foot-col > image,
.foot-col.foot-col > navigator,
.foot-col.foot-col > input,
.foot-col.foot-col > textarea,
.foot-col.foot-col > video,
.foot-col.foot-col > form,
.foot-col.foot-col > label,
.foot-col.foot-col > picker,
.foot-col.foot-col > swiper,
.foot-col.foot-col > icon,
.foot-col.foot-col > scroll-view,
.foot-col.foot-col > cover-view {
  flex-shrink: 0;
}

page {
  background: #f5f6f8;
  color: #1e3a5f;
  font-size: 28rpx;
  --lq-primary: #2f6fed;
  --lq-primary-soft: rgba(47, 111, 237, 0.12);
  --lq-bg: #f5f6f8;
  --lq-card: #ffffff;
  --lq-text: #1e3a5f;
  --lq-muted: #64748b;
  --lq-radius-card: 28rpx;
  --lq-shadow-card: 0 10rpx 36rpx rgba(15, 23, 42, 0.05);
  --tab-bar-pad: calc(98rpx + env(safe-area-inset-bottom));
}

.page-pad-v2 {
  padding: 0 28rpx 16rpx;
  box-sizing: border-box;
  min-height: 100vh;
  background: var(--lq-bg);
}

.page-func-v2 {
  padding: 0 24rpx 16rpx;
  box-sizing: border-box;
  min-height: 100vh;
}

.hint-v2.err {
  color: #dc2626;
}
