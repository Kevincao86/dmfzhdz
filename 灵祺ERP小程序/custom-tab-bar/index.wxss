/* 内容区须与 app.wxss --tab-bar-pad 一致 */
.tab-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  height: calc(88rpx + env(safe-area-inset-bottom));
  padding-bottom: env(safe-area-inset-bottom);
  box-sizing: border-box;
  display: flex;
  align-items: stretch;
  background: rgba(255, 255, 255, 0.97);
  border-top: 1rpx solid rgba(15, 23, 42, 0.06);
  box-shadow: 0 -10rpx 36rpx rgba(15, 23, 42, 0.06);
  z-index: 9000;
  backdrop-filter: blur(14px);
}

.tab-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: flex-end;
  gap: 6rpx;
  padding-bottom: 10rpx;
  color: #94a3b8;
  transition: color 0.2s ease;
}

.tab-item.active {
  color: #0284c7;
}

.tab-icon-wrap {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  border-radius: 16rpx;
  transition: background 0.2s ease, transform 0.2s ease;
}

.tab-item.active .tab-icon-wrap {
  background: rgba(14, 165, 233, 0.12);
  transform: translateY(-2rpx);
}

.tab-icon {
  position: relative;
  width: 38rpx;
  height: 38rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  opacity: 0.72;
  transform: scale(0.96);
  transition: opacity 0.2s ease, transform 0.2s ease;
}

.tab-item.active .tab-icon {
  opacity: 1;
  transform: scale(1);
}

.tab-text {
  font-size: 20rpx;
  font-weight: 500;
  letter-spacing: 0.5rpx;
  line-height: 1.1;
  flex-shrink: 0;
}

.tab-item.active .tab-text {
  font-weight: 700;
}

/* 灵祺助手：对话气泡 + 角标光点 */
.tab-icon-ai .ai-bubble {
  width: 34rpx;
  height: 26rpx;
  border: 2.5rpx solid currentColor;
  border-radius: 12rpx 12rpx 12rpx 4rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 4rpx;
  padding-bottom: 2rpx;
}

.tab-icon-ai .ai-dot {
  width: 4rpx;
  height: 4rpx;
  border-radius: 50%;
  background: currentColor;
  opacity: 0.55;
}

.tab-item.active .tab-icon-ai .ai-dot {
  opacity: 1;
}

.tab-icon-ai .ai-spark {
  position: absolute;
  top: 0;
  right: 0;
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: currentColor;
  opacity: 0.35;
  box-shadow: -10rpx 5rpx 0 -2rpx currentColor;
}

.tab-item.active .tab-icon-ai .ai-spark {
  opacity: 0.85;
}

/* 经营概览：柱状图 */
.tab-icon-chart {
  display: flex;
  align-items: flex-end;
  justify-content: center;
  gap: 5rpx;
  width: 34rpx;
  height: 30rpx;
}

.tab-icon-chart .chart-bar {
  width: 7rpx;
  border-radius: 4rpx 4rpx 2rpx 2rpx;
  background: currentColor;
  opacity: 0.38;
}

.tab-icon-chart .chart-bar-1 {
  height: 14rpx;
}

.tab-icon-chart .chart-bar-2 {
  height: 24rpx;
}

.tab-icon-chart .chart-bar-3 {
  height: 18rpx;
}

.tab-item.active .tab-icon-chart .chart-bar {
  opacity: 0.92;
}

/* 功能：四宫格 */
.tab-icon-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 6rpx;
  width: 32rpx;
  height: 32rpx;
}

.tab-icon-grid .grid-cell {
  width: 100%;
  height: 100%;
  border-radius: 6rpx;
  background: currentColor;
  opacity: 0.38;
}

.tab-item.active .tab-icon-grid .grid-cell {
  opacity: 0.92;
}

/* 我的：头像轮廓 */
.tab-icon-user .user-head {
  position: absolute;
  top: 5rpx;
  left: 50%;
  width: 14rpx;
  height: 14rpx;
  margin-left: -7rpx;
  border: 2.5rpx solid currentColor;
  border-radius: 50%;
  box-sizing: border-box;
}

.tab-icon-user .user-body {
  position: absolute;
  bottom: 3rpx;
  left: 50%;
  width: 26rpx;
  height: 13rpx;
  margin-left: -13rpx;
  border: 2.5rpx solid currentColor;
  border-top: none;
  border-radius: 0 0 13rpx 13rpx;
  box-sizing: border-box;
  opacity: 0.75;
}

.tab-item.active .tab-icon-user .user-body {
  opacity: 1;
}
