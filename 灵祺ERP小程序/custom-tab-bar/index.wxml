<view class="tab-bar">
  <view
    wx:for="{{list}}"
    wx:key="pagePath"
    class="tab-item {{selected === index ? 'active' : ''}}"
    data-index="{{index}}"
    bindtap="switchTab"
  >
    <view class="tab-icon-wrap">
      <view class="tab-icon tab-icon-{{item.icon}}">
        <block wx:if="{{item.icon === 'ai'}}">
          <view class="ai-bubble">
            <view class="ai-dot"></view>
            <view class="ai-dot"></view>
            <view class="ai-dot"></view>
          </view>
          <view class="ai-spark"></view>
        </block>
        <block wx:elif="{{item.icon === 'grid'}}">
          <view class="grid-cell"></view>
          <view class="grid-cell"></view>
          <view class="grid-cell"></view>
          <view class="grid-cell"></view>
        </block>
        <block wx:elif="{{item.icon === 'chart'}}">
          <view class="chart-bar chart-bar-1"></view>
          <view class="chart-bar chart-bar-2"></view>
          <view class="chart-bar chart-bar-3"></view>
        </block>
        <block wx:else>
          <view class="user-head"></view>
          <view class="user-body"></view>
        </block>
      </view>
    </view>
    <text class="tab-text">{{item.text}}</text>
  </view>
</view>
