<scroll-view scroll-y class="page-pad-v2" enhanced show-scrollbar="{{false}}">
  <view class="lq-hero">
    <text class="lq-hero-title">选择发布方式</text>
    <text class="lq-hero-sub">新手 / 专业发布入口</text>
  </view>
<view class="pick-v2" bindtap="goNovice"><text class="pick-strong">新手发单</text><text class="pick-p">极简填单 · 达人档位</text></view>
<view class="pick-v2 on" bindtap="goPro"><text class="pick-strong">专业发单</text><text class="pick-p">完整 Brief · 达人条件</text></view></scroll-view>