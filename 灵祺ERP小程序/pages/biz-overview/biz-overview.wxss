.dash-page-v2 {
  min-height: 100vh;
  padding: 8rpx 28rpx 160rpx;
  box-sizing: border-box;
  background: #f5f6f8;
}

.home-poster {
  height: 300rpx;
  margin: 20rpx 0 0;
  border-radius: 28rpx;
  overflow: hidden;
}

.home-poster__slide {
  height: 100%;
  box-sizing: border-box;
  padding: 40rpx 36rpx;
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
}

.home-poster__slide--blue {
  background: linear-gradient(135deg, #1d4ed8 0%, #60a5fa 100%);
}

.home-poster__slide--green {
  background: linear-gradient(135deg, #047857 0%, #34d399 100%);
}

.home-poster__slide--violet {
  background: linear-gradient(135deg, #6d28d9 0%, #c4b5fd 100%);
}

.home-poster__kicker {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.82);
  letter-spacing: 4rpx;
}

.home-poster__title {
  display: block;
  margin-top: 12rpx;
  font-size: 40rpx;
  font-weight: 800;
  color: #ffffff;
}

.home-poster__sub {
  display: block;
  margin-top: 10rpx;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.9);
}

.home-feed-title {
  display: block;
  margin: 28rpx 4rpx 16rpx;
  font-size: 30rpx;
  font-weight: 800;
  color: #111827;
}

.home-entry {
  display: flex;
  gap: 16rpx;
  margin: 0 0 12rpx;
}

.home-entry__card {
  flex: 1;
  min-width: 0;
  padding: 22rpx 8rpx 18rpx;
  background: #ffffff;
  border-radius: 24rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-shadow: 0 8rpx 24rpx rgba(15, 23, 42, 0.04);
}

.home-entry__mark {
  width: 84rpx;
  height: 84rpx;
  border-radius: 26rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.home-entry__mark--blue { background: #e8f1ff; }
.home-entry__mark--green { background: #e8f8ee; }
.home-entry__mark--amber { background: #fff4e5; }

.home-entry__ic {
  width: 44rpx;
  height: 44rpx;
}

.home-entry__title {
  margin-top: 12rpx;
  font-size: 24rpx;
  font-weight: 600;
  color: #1e3a5f;
  text-align: center;
}

.dash-head {
  display: flex;
  margin: 20rpx 0 0;
  align-items: center;
  gap: 20rpx;
  padding: 8rpx 0 4rpx;
}

.dash-head-icon {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: #eef2f6;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.dash-hero-ic {
  width: 40rpx;
  height: 40rpx;
}

.dash-title {
  display: block;
  font-size: 36rpx;
  font-weight: 800;
  color: #1e3a5f;
}

.dash-sub {
  display: block;
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #64748b;
}

.dash-range-row {
  display: flex;
  gap: 32rpx;
  margin: 20rpx 0 24rpx;
  padding-bottom: 4rpx;
}

.dash-range {
  font-size: 28rpx;
  color: #94a3b8;
  padding-bottom: 12rpx;
  position: relative;
}

.dash-range.on {
  color: #1e3a5f;
  font-weight: 700;
}

.dash-range.on::after {
  content: '';
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 4rpx;
  background: #2f6fed;
  border-radius: 4rpx;
}

.dash-kpi-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.dash-kpi-card {
  background: #fff;
  border-radius: 28rpx;
  padding: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(15, 23, 42, 0.04);
}

.dash-kpi-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.dash-kpi-label {
  font-size: 22rpx;
  color: #64748b;
}

.dash-kpi-ibox {
  width: 48rpx;
  height: 48rpx;
  border-radius: 14rpx;
  background: transparent;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}

.dash-kpi-ic {
  width: 48rpx;
  height: 48rpx;
  border-radius: 14rpx;
}

.dash-kpi-value {
  display: block;
  font-size: 36rpx;
  font-weight: 800;
  color: #1e3a5f;
  line-height: 1.2;
}

.dash-kpi-delta {
  display: block;
  margin-top: 8rpx;
  font-size: 20rpx;
  color: #94a3b8;
}

.dash-kpi-delta.up {
  color: #ef4444;
}

.dash-chart-card {
  background: #fff;
  border-radius: 28rpx;
  padding: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(15, 23, 42, 0.04);
}

.dash-chart-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.dash-chart-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #1e3a5f;
}

.dash-yday {
  margin-top: 20rpx;
}

.dash-yday-date {
  display: block;
  margin: -8rpx 0 8rpx;
  font-size: 22rpx;
  color: #64748b;
}

.dash-yday-actions {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.dash-yday-auto {
  display: flex;
  align-items: center;
  gap: 4rpx;
  font-size: 22rpx;
  color: #64748b;
}

.dash-yday-switch {
  transform: scale(0.72);
}

.dash-yday-btn {
  font-size: 22rpx;
  color: #1e3a5f;
  font-weight: 700;
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  background: #f4f7fb;
}

.dash-yday-btn.is-off {
  color: #94a3b8;
  background: #f1f5f9;
}

.dash-yday-hint {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #94a3b8;
  line-height: 1.5;
}

.dash-yday-metrics {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 16rpx;
}

.dash-yday-metric {
  width: calc(33.33% - 8rpx);
  box-sizing: border-box;
  background: #f8fafc;
  border-radius: 16rpx;
  padding: 16rpx 12rpx;
}

.dash-yday-metric-label {
  display: block;
  font-size: 20rpx;
  color: #64748b;
}

.dash-yday-metric-value {
  display: block;
  margin-top: 6rpx;
  font-size: 26rpx;
  font-weight: 600;
  color: #1e3a5f;
}

.dash-yday-empty {
  font-size: 24rpx;
  color: #64748b;
  line-height: 1.5;
}

.dash-yday-sec + .dash-yday-sec {
  margin-top: 20rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #f1f5f9;
}

.dash-yday-sec-title {
  display: block;
  margin-bottom: 8rpx;
  font-size: 26rpx;
  font-weight: 700;
  color: #1e3a5f;
}

.dash-yday-sec-body {
  display: block;
  font-size: 26rpx;
  line-height: 1.6;
  color: #334155;
  white-space: pre-wrap;
}

.dash-chart-more {
  font-size: 22rpx;
  color: #94a3b8;
}

.dash-chart-ph {
  height: 280rpx;
  border-radius: 20rpx;
  border: 2rpx dashed #e2e8f0;
  background: #f8fafc;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  color: #94a3b8;
}

.dash-chart-wrap {
  padding-top: 8rpx;
}

.dash-chart-bars {
  display: flex;
  align-items: flex-end;
  gap: 8rpx;
  height: 320rpx;
  padding: 8rpx 0 0;
}

.dash-bar-col {
  flex: 1;
  min-width: 0;
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: flex-end;
}

.dash-bar-tip {
  font-size: 16rpx;
  color: #64748b;
  margin-bottom: 6rpx;
  transform: scale(0.92);
}

.dash-bar-track {
  width: 100%;
  max-width: 36rpx;
  height: 240rpx;
  background: #eef2f6;
  border-radius: 12rpx 12rpx 4rpx 4rpx;
  overflow: hidden;
  display: flex;
  align-items: flex-end;
}

.dash-bar-fill {
  width: 100%;
  background: linear-gradient(180deg, #2f6fed, #2f6fed);
  border-radius: 12rpx 12rpx 4rpx 4rpx;
}

.dash-bar-lab {
  margin-top: 8rpx;
  font-size: 16rpx;
  color: #94a3b8;
  white-space: nowrap;
}

.dash-chart-hint {
  display: block;
  margin-top: 12rpx;
  font-size: 20rpx;
  color: #94a3b8;
}

.dash-loading {
  text-align: center;
  font-size: 24rpx;
  color: #64748b;
  padding: 16rpx;
}
