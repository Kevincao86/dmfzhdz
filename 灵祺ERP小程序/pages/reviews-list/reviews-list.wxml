<view class="rev-page">
  <view class="rev-toolbar">
    <view class="rev-search" bindtap="onFocusSearch">
      <text class="rev-search-ico">⌕</text>
      <input
        class="rev-search-input"
        placeholder="搜索评价内容"
        value="{{searchKw}}"
        bindinput="onSearch"
        confirm-type="search"
      />
    </view>
    <view class="rev-filter-btn" bindtap="onSync">
      <text>{{syncing ? '同步中' : '同步评价'}}</text>
    </view>
    <view class="rev-filter-btn" bindtap="toggleFilter">
      <text class="rev-filter-ico">▾</text>
      <text>筛选</text>
    </view>
  </view>

  <view class="rev-ai-bar">
    <view class="rev-ai-toggle">
      <switch checked="{{aiAutoReply}}" bindchange="onAiToggle" color="#6366f1" disabled="{{autoReplyBusy}}" />
      <view class="rev-ai-toggle-txt">
        <text class="rev-ai-toggle-title">24小时智能自动回复</text>
        <text class="rev-ai-toggle-sub">开启后同步/载入时对未回复评价自动生成并提交</text>
      </view>
    </view>
  </view>
  <view wx:if="{{autoReplyBusy}}" class="rev-auto-banner">
    <text>正在为未回复评价自动生成并提交回复…</text>
  </view>

  <view wx:if="{{showFilter}}" class="rev-filter-panel">
    <view class="rev-filter-row">
      <text class="rev-filter-lab">评价类型</text>
      <view class="rev-chip-row">
        <text
          wx:for="{{reviewKindTabs}}"
          wx:key="id"
          class="rev-chip {{reviewKind === item.id ? 'on' : ''}}"
          data-id="{{item.id}}"
          bindtap="kindTab"
        >{{item.label}}</text>
      </view>
    </view>
    <view class="rev-filter-row">
      <text class="rev-filter-lab">情感</text>
      <view class="rev-chip-row">
        <text
          wx:for="{{sentiments}}"
          wx:key="id"
          class="rev-chip {{sentiment === item.id ? 'on' : ''}}"
          data-id="{{item.id}}"
          bindtap="onSent"
        >{{item.label}}</text>
      </view>
    </view>
    <view class="rev-filter-row">
      <text class="rev-filter-lab">回复状态</text>
      <view class="rev-chip-row">
        <text
          wx:for="{{replyTabs}}"
          wx:key="id"
          class="rev-chip {{replyStatus === item.id ? 'on' : ''}}"
          data-id="{{item.id}}"
          bindtap="onReplyTab"
        >{{item.label}}{{item.cnt !== '0' ? '(' + item.cnt + ')' : ''}}</text>
      </view>
    </view>
    <picker
      wx:if="{{reviewKind === 'store' && activePlatTab === 'douyin'}}"
      mode="selector"
      range="{{storePickerLabels}}"
      value="{{storePickerIndex}}"
      bindchange="onStorePick"
    >
      <view class="rev-store-pick">门店：{{storePickerLabels[storePickerIndex]}}</view>
    </picker>
    <view class="rev-filter-actions">
      <button class="rev-sync-mini" size="mini" loading="{{syncing}}" bindtap="onSync">同步评价</button>
    </view>
  </view>

  <scroll-view scroll-x class="rev-tab-scroll" enhanced show-scrollbar="{{false}}">
    <view class="rev-tab-row">
      <view
        wx:for="{{platTabs}}"
        wx:key="id"
        class="rev-tab {{activePlatTab === item.id ? 'on' : ''}}"
        data-id="{{item.id}}"
        bindtap="onPlat"
      >
        <image wx:if="{{item.logo}}" class="rev-tab-logo" src="{{item.logo}}" mode="aspectFit" />
        <text class="rev-tab-txt">{{item.label}}{{item.count > 0 ? '(' + item.count + ')' : ''}}</text>
      </view>
    </view>
  </scroll-view>

  <view class="rev-sort-bar">
    <text class="rev-sort-l">最新评价</text>
    <picker mode="selector" range="{{sortLabels}}" value="{{sortPickerIndex}}" bindchange="onSortPick">
      <view class="rev-sort-r">
        <text>{{sortLabels[sortPickerIndex]}}</text>
        <text class="rev-chev">▾</text>
      </view>
    </picker>
  </view>

  <scroll-view scroll-y class="rev-list" enhanced show-scrollbar="{{false}}">
    <text wx:if="{{syncedAtText}}" class="rev-sync-hint">{{syncedAtText}}</text>
    <view wx:if="{{loading}}" class="rev-state">加载中…</view>
    <view wx:elif="{{errMsg}}" class="rev-state rev-err">{{errMsg}}</view>
    <view wx:elif="{{!displayItems.length}}" class="rev-state">暂无评价</view>
    <block wx:else>
      <view wx:for="{{displayItems}}" wx:key="id" class="rev-card">
        <view class="rev-card-head">
          <view class="rev-card-plat">
            <image wx:if="{{item.platLogo}}" class="rev-plat-logo" src="{{item.platLogo}}" mode="aspectFit" />
            <text class="rev-plat-name">{{item.platShort}}</text>
            <text class="rev-status rev-status-{{item.replyStatusClass}}">{{item.replyStatusLabel}}</text>
          </view>
          <view class="rev-card-meta">
            <text class="rev-time">{{item.timeText}}</text>
            <text class="rev-more">⋯</text>
          </view>
        </view>
        <view class="rev-stars">{{item.starsLabel}}</view>
        <text class="rev-content">{{item.content}}</text>
        <view wx:if="{{item.keywords.length}}" class="rev-kw-row">
          <text wx:for="{{item.keywords}}" wx:for-item="kw" wx:key="*this" class="rev-kw">{{kw}}</text>
        </view>
        <view wx:if="{{item.replied}}" class="rev-reply-box">
          <text class="rev-reply-title">商家已回复</text>
          <text class="rev-reply-text">{{item.replyText}}</text>
        </view>
        <view wx:if="{{!item.replied && aiAutoReply}}" class="rev-ai-box">
          <text class="rev-ai-title">已开启 24 小时智能自动回复</text>
          <text class="rev-ai-preview">同步或载入后将按本条自动生成话术并尝试提交。关闭开关后可手动回复或点「智能生成话术」。</text>
          <text wx:if="{{processingAutoId === item.id}}" class="rev-ai-preview">正在为本条生成并提交…</text>
        </view>
        <view wx:if="{{!item.replied && !aiAutoReply}}" class="rev-compose">
          <textarea
            class="rev-compose-area"
            maxlength="500"
            placeholder="撰写回复；可先点「智能生成话术」预填草稿，再修改后发送"
            value="{{item.replyDraft}}"
            data-id="{{item.id}}"
            bindinput="onReplyInput"
          />
          <view class="rev-compose-actions">
            <button
              class="rev-ai-btn"
              size="mini"
              data-id="{{item.id}}"
              loading="{{suggestBusyId === item.id}}"
              disabled="{{autoReplyBusy}}"
              bindtap="onAiSuggest"
            >智能生成话术</button>
            <button
              class="rev-btn-primary"
              size="mini"
              data-id="{{item.id}}"
              loading="{{replyingId === item.id}}"
              disabled="{{autoReplyBusy}}"
              bindtap="submitReply"
            >发送回复</button>
          </view>
        </view>
      </view>
    </block>
    <view class="rev-bottom-space"></view>
  </scroll-view>
</view>
