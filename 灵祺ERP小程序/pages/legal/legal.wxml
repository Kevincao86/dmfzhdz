<view class="legal-page">
  <view class="legal-head">
    <text class="legal-company">{{meta.COMPANY}}</text>
    <text class="legal-title">{{title}}</text>
    <text class="legal-date">发布与生效日期：{{meta.EFFECTIVE}}</text>
    <text class="legal-phone" wx:if="{{meta.PHONE}}">联系电话：{{meta.PHONE}}</text>
  </view>
  <view class="legal-body">
    <view wx:for="{{sections}}" wx:key="title" class="legal-section">
      <text class="legal-section-title">{{item.title}}</text>
      <text wx:for="{{item.paragraphs}}" wx:for-item="p" wx:key="*this" class="legal-paragraph">{{p}}</text>
    </view>
  </view>
</view>
