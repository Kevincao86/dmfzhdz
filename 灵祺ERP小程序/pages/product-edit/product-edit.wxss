.edit-scroll {
  height: 100vh;
  padding: 28rpx;
  padding-bottom: 48rpx;
  box-sizing: border-box;
  background: linear-gradient(180deg, #eef4ff 0%, #f3f6fb 40%);
}

.edit-head {
  margin-bottom: 28rpx;
}

.edit-head-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #0f172a;
  display: block;
}

.edit-head-desc {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #64748b;
  line-height: 1.45;
  display: block;
}

.edit-tail-space {
  height: 48rpx;
}

.field {
  margin-bottom: 28rpx;
}

.area {
  min-height: 160rpx;
  height: 160rpx;
  max-height: 240rpx;
}

.area.small {
  min-height: 120rpx;
  height: 120rpx;
  max-height: 160rpx;
  font-size: 24rpx;
  color: #94a3b8;
}

.btn {
  margin-top: 16rpx;
  border: none;
}
