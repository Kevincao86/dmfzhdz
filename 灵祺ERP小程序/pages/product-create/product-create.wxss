.wizard-scroll {
  height: 100vh;
  background: linear-gradient(180deg, #eef6ff 0%, #f8fafc 35%);
  box-sizing: border-box;
}

.wizard-steps {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 24rpx 20rpx 8rpx;
  gap: 8rpx;
}

.step-dot {
  font-size: 22rpx;
  color: #94a3b8;
  padding: 10rpx 16rpx;
  border-radius: 999rpx;
  background: #f1f5f9;
  font-weight: 600;
}

.step-dot.on {
  color: #fff;
  background: linear-gradient(95deg, #0ea5e9, #06b6d4);
}

.step-line {
  width: 24rpx;
  height: 2rpx;
  background: #e2e8f0;
}

.wizard-card {
  margin: 16rpx 24rpx 32rpx;
  padding: 28rpx;
  background: #fff;
  border-radius: 24rpx;
  border: 1rpx solid rgba(15, 23, 42, 0.05);
  box-shadow: 0 8rpx 28rpx rgba(15, 23, 42, 0.05);
}

.wizard-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #0f172a;
  display: block;
}

.wizard-desc {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #64748b;
  line-height: 1.5;
  display: block;
  margin-bottom: 24rpx;
}

.wizard-err {
  margin: 0 24rpx 12rpx;
  padding: 16rpx 20rpx;
  background: #fef2f2;
  color: #b91c1c;
  border-radius: 16rpx;
  font-size: 24rpx;
}

.wizard-loading {
  padding: 32rpx 0;
  text-align: center;
  color: #64748b;
  font-size: 26rpx;
}

.plat-grid {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.plat-chip {
  padding: 24rpx;
  border-radius: 18rpx;
  border: 1rpx solid #e2e8f0;
  background: #f8fafc;
}

.plat-chip.active {
  border-color: #38bdf8;
  background: rgba(56, 189, 248, 0.1);
}

.plat-chip.disabled {
  opacity: 0.55;
}

.plat-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #0f172a;
  display: block;
}

.plat-sub {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #64748b;
  display: block;
}

.picker-box {
  padding: 20rpx 24rpx;
  background: #f8fafc;
  border: 1rpx solid #e2e8f0;
  border-radius: 16rpx;
  margin-bottom: 20rpx;
  color: #0f172a;
}

.type-row,
.poi-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 16rpx 0;
  font-size: 26rpx;
  color: #334155;
}

.wizard-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-top: 28rpx;
}

.wizard-actions button {
  flex: 1;
  min-width: 200rpx;
  margin: 0;
  font-size: 26rpx;
}

.wizard-next {
  margin-top: 24rpx;
}

.area {
  min-height: 160rpx;
  height: 160rpx;
  max-height: 240rpx;
}

.img-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-bottom: 20rpx;
}

.thumb {
  width: 160rpx;
  height: 160rpx;
  border-radius: 16rpx;
  background: #f1f5f9;
}

.mini {
  flex: none;
  padding: 16rpx 24rpx;
  font-size: 24rpx;
}

.action-msg {
  margin-top: 16rpx;
  font-size: 24rpx;
  line-height: 1.45;
}

.action-msg.ok {
  color: #059669;
}

.action-msg.bad {
  color: #dc2626;
}

.step-line.dim {
  opacity: 0.35;
}

.wizard-steps.single {
  justify-content: flex-start;
  gap: 16rpx;
}

.step-extra {
  font-size: 22rpx;
  color: #64748b;
}

.plat-list {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
  margin-bottom: 8rpx;
}

.plat-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 22rpx;
  border-radius: 18rpx;
  border: 1rpx solid #e2e8f0;
  background: #fafafa;
}

.plat-row-off {
  opacity: 0.72;
}

.plat-row-main {
  display: flex;
  align-items: center;
  gap: 16rpx;
  flex: 1;
  min-width: 0;
}

.plat-letter {
  width: 56rpx;
  height: 56rpx;
  border-radius: 14rpx;
  background: linear-gradient(135deg, #38bdf8, #0284c7);
  color: #fff;
  font-size: 26rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.plat-row-text {
  min-width: 0;
  flex: 1;
}

.plat-forbid {
  font-size: 22rpx;
  color: #94a3b8;
}

.check-box {
  width: 40rpx;
  height: 40rpx;
  border-radius: 10rpx;
  border: 2rpx solid #cbd5e1;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
}

.check-box.on {
  border-color: #0284c7;
  background: #0284c7;
}

.check-tick {
  color: #fff;
  font-size: 26rpx;
  font-weight: 700;
  line-height: 1;
}

.confirm-box {
  padding: 24rpx;
  background: linear-gradient(180deg, rgba(56, 189, 248, 0.12), transparent);
  border-radius: 18rpx;
  border: 1rpx solid rgba(14, 165, 233, 0.35);
  margin-bottom: 16rpx;
}

.confirm-name {
  font-size: 32rpx;
  font-weight: 700;
  color: #0f172a;
  display: block;
}

.confirm-tip {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #64748b;
  display: block;
}

.aux-row {
  display: flex;
  flex-direction: row;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.aux-cell {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
}

.aux-thumb {
  width: 120rpx;
  height: 120rpx;
  border-radius: 12rpx;
  background: #f1f5f9;
}

.aux-add {
  width: 120rpx;
  height: 120rpx;
  border-radius: 12rpx;
  border: 2rpx dashed #cbd5e1;
  background: #f8fafc;
  color: #64748b;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  line-height: 1;
  padding: 0;
  margin: 0;
}

.aux-clear {
  font-size: 22rpx;
  color: #0369a1;
}

.meoo-hint {
  font-size: 24rpx;
  color: #94a3b8;
  margin-top: 12rpx;
}

/* ---------- 经营类型（团购 / 外卖）---------- */
.channel-grid {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
  margin-top: 16rpx;
}

.channel-card {
  display: flex;
  flex-direction: column;
  padding: 20rpx 22rpx 22rpx;
  border-radius: 20rpx;
  border: 1rpx solid #e2e8f0;
  background: linear-gradient(180deg, #f8fafc 0%, #fff 52%);
}

.channel-card-hover {
  opacity: 0.92;
  transform: scale(0.99);
}

.channel-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #0f172a;
}

.channel-lines {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #64748b;
  line-height: 1.45;
}

/* ---------- 平台行 Logo（Web 同源图） ---------- */
.plat-avatar-wrap {
  width: 64rpx;
  height: 64rpx;
  border-radius: 16rpx;
  overflow: hidden;
  flex-shrink: 0;
  background: #fff;
  border: 1rpx solid rgba(148, 163, 184, 0.35);
  box-sizing: border-box;
}

.plat-logo-img {
  width: 100%;
  height: 100%;
  display: block;
}

.plat-logo-pad {
  padding: 6rpx;
  box-sizing: border-box;
}

.plat-letter.plat-letter-solo {
  width: 64rpx;
  height: 64rpx;
  border-radius: 16rpx;
}

.wizard-desc-muted {
  margin-top: -16rpx;
  margin-bottom: 20rpx;
  font-size: 22rpx;
  color: #94a3b8;
}

/* ---------- 向导底部按钮 ---------- */
.wizard-next-wrap {
  display: flex;
  justify-content: center;
  margin-top: 28rpx;
  margin-bottom: 8rpx;
}

.wizard-btn-next {
  min-width: 280rpx;
  max-width: 78%;
  height: auto;
  padding: 18rpx 48rpx;
  margin: 0;
  border: none;
  border-radius: 999rpx;
  font-size: 28rpx;
  font-weight: 600;
  line-height: 1.35;
  color: #fff;
  background: linear-gradient(95deg, #0ea5e9, #14b8a6);
  box-shadow: 0 8rpx 22rpx rgba(14, 165, 233, 0.28);
}

.wizard-btn-next::after {
  border: none;
}

.wizard-btn-inline {
  min-width: 0;
  max-width: none;
  flex: 1.2;
  padding: 16rpx 28rpx;
  font-size: 26rpx;
}

.wizard-btn-quiet {
  margin: 16rpx auto 0;
  padding: 0;
  height: auto;
  min-height: auto;
  width: auto;
  border: none;
  background: transparent;
  color: #0369a1;
  font-size: 26rpx;
  font-weight: 500;
  line-height: 1.4;
}

.wizard-btn-quiet::after {
  border: none;
}

.wizard-actions-split {
  flex-wrap: nowrap;
  align-items: stretch;
}

.wizard-actions-split .wizard-btn-muted {
  flex: 1;
  max-width: 38%;
}

.wizard-actions-split .wizard-btn-next {
  flex: 1.35;
}

.wizard-btn-muted {
  margin: 0;
  height: auto;
  padding: 18rpx 24rpx;
  border-radius: 999rpx;
  border: 1rpx solid #cbd5e1;
  background: #f8fafc;
  color: #475569;
  font-size: 26rpx;
  font-weight: 500;
}

.wizard-btn-muted::after {
  border: none;
}

.wizard-footer-fixed {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 16rpx 28rpx calc(16rpx + env(safe-area-inset-bottom));
  background: rgba(255, 255, 255, 0.96);
  box-shadow: 0 -8rpx 24rpx rgba(15, 23, 42, 0.06);
  z-index: 20;
}

.wizard-btn-block {
  width: 100%;
  max-width: none;
  min-width: 0;
}

.wizard-steps-v2 {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 24rpx 20rpx 12rpx;
  gap: 8rpx;
}

.wstep {
  display: flex;
  align-items: center;
  gap: 8rpx;
  color: #94a3b8;
}

.wstep-num {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  border: 2rpx solid #cbd5e1;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  font-weight: 700;
}

.wstep-txt {
  font-size: 22rpx;
}

.wstep.on {
  color: #0284c7;
}

.wstep.on .wstep-num {
  background: #0284c7;
  border-color: #0284c7;
  color: #fff;
}

.wstep.done {
  color: #0284c7;
}

.wstep.done .wstep-num {
  border-color: #0284c7;
  color: #0284c7;
}

.wstep-line {
  width: 40rpx;
  height: 2rpx;
  background: #e2e8f0;
}

.plat-list-v2 {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin-top: 20rpx;
}

.plat-card-v2 {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 24rpx;
  border-radius: 24rpx;
  border: 2rpx solid #e2e8f0;
  background: #fff;
}

.plat-card-v2.on {
  border-color: #0284c7;
  background: #f0f9ff;
}

.plat-card-v2.off {
  opacity: 0.65;
}

.plat-card-logo {
  width: 80rpx;
  height: 80rpx;
  border-radius: 16rpx;
  flex-shrink: 0;
  background: #fff;
}

.plat-card-logo-ph {
  display: flex;
  align-items: center;
  justify-content: center;
  background: #e0f2fe;
  color: #0284c7;
  font-size: 28rpx;
  font-weight: 700;
}

.plat-card-body {
  flex: 1;
  min-width: 0;
}

.plat-card-name {
  display: block;
  font-size: 28rpx;
  font-weight: 700;
  color: #0f172a;
}

.plat-card-desc {
  display: block;
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #64748b;
  line-height: 1.4;
}

.plat-radio {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  border: 2rpx solid #cbd5e1;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
}

.plat-radio.on {
  border-color: #0284c7;
  background: #0284c7;
}

.plat-radio-tick {
  color: #fff;
  font-size: 22rpx;
  font-weight: 700;
}

.wizard-card-pick {
  margin-bottom: 120rpx;
}

.wizard-footer-space {
  height: 140rpx;
}
