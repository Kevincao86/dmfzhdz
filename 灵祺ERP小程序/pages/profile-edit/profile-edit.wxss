.pe-page {
  min-height: 100vh;
  padding: 28rpx;
  box-sizing: border-box;
  background: linear-gradient(180deg, #e8f4fc 0%, #f8fafc 240rpx, #f8fafc 100%);
}
.pe-card {
  background: #fff;
  border-radius: 20rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(15, 23, 42, 0.04);
}
.pe-title {
  display: block;
  font-size: 34rpx;
  font-weight: 700;
  color: #0f172a;
}
.pe-desc {
  display: block;
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #64748b;
  line-height: 1.5;
}
.pe-guest-t {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: #0f172a;
}
.pe-guest-d {
  display: block;
  margin: 10rpx 0 20rpx;
  font-size: 24rpx;
  color: #64748b;
}
.field-label {
  display: block;
  margin: 20rpx 0 12rpx;
  font-size: 24rpx;
  color: #475569;
  font-weight: 600;
}
.pe-avatar-btn {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 0;
  margin: 0;
  background: transparent;
  text-align: left;
}
.pe-avatar-btn::after {
  border: none;
}
.pe-avatar {
  width: 112rpx;
  height: 112rpx;
  border-radius: 28rpx;
  background: #e2e8f0;
}
.pe-avatar-ph {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  color: #64748b;
}
.pe-avatar-tip {
  font-size: 24rpx;
  color: #0284c7;
}
.pe-input {
  height: 80rpx;
  padding: 0 24rpx;
  border-radius: 16rpx;
  background: #f1f5f9;
  font-size: 28rpx;
  color: #0f172a;
}
.pe-disabled {
  color: #94a3b8;
}
.pe-save {
  margin-top: 32rpx;
}
.btn-v2 {
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 16rpx;
  font-size: 28rpx;
  font-weight: 600;
}
.btn-v2.primary {
  background: #0284c7;
  color: #fff;
}
.pe-sec {
  display: block;
  font-size: 30rpx;
  font-weight: 700;
  color: #0f172a;
  margin-bottom: 8rpx;
}
.pe-err {
  display: block;
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #dc2626;
}
.pe-ok {
  display: block;
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #047857;
}
.pe-hint {
  display: block;
  margin-top: 10rpx;
  font-size: 22rpx;
  color: #64748b;
  line-height: 1.45;
}
.pe-masked {
  display: block;
  margin-top: 12rpx;
  font-size: 22rpx;
  color: #64748b;
}
.bind-grid {
  display: flex;
  gap: 12rpx;
  margin-top: 16rpx;
}
.bind-tile {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
  padding: 16rpx 4rpx;
  border-radius: 16rpx;
  background: #f8fafc;
  border: 1rpx solid #e2e8f0;
  font-size: 22rpx;
  color: #94a3b8;
}
.bind-tile.on {
  background: #ecfeff;
  border-color: #a5f3fc;
  color: #0f172a;
}
.bind-ico {
  width: 56rpx;
  height: 56rpx;
  line-height: 56rpx;
  text-align: center;
  border-radius: 14rpx;
  background: #e0f2fe;
  font-size: 26rpx;
  color: #0369a1;
}
.bind-ico.dark {
  background: #0f172a;
  color: #fff;
}
.bind-st {
  font-size: 18rpx;
}
.bind-box {
  margin-top: 20rpx;
  padding: 20rpx;
  border-radius: 16rpx;
  border: 1rpx solid #e2e8f0;
}
.sms-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 8rpx;
}
.flex1 {
  flex: 1;
  min-width: 0;
}
.sms-btn {
  flex-shrink: 0;
  height: 72rpx;
  line-height: 72rpx;
  padding: 0 20rpx;
  font-size: 22rpx;
  color: #0e7490;
  background: #fff;
  border: 1rpx solid #bae6fd;
  border-radius: 16rpx;
}
.sms-btn::after {
  border: none;
}
.row-btns {
  display: flex;
  gap: 16rpx;
  margin-top: 20rpx;
}
.btn-v2.ghost {
  background: #fff;
  color: #334155;
  border: 1rpx solid #e2e8f0;
}
.btn-v2.ghost::after {
  border: none;
}
.pw-tabs {
  display: flex;
  gap: 8rpx;
  margin-top: 16rpx;
  padding: 6rpx;
  border-radius: 16rpx;
  background: #f1f5f9;
}
.pw-tab {
  flex: 1;
  text-align: center;
  font-size: 24rpx;
  line-height: 64rpx;
  color: #64748b;
  border-radius: 12rpx;
}
.pw-tab.on {
  background: #fff;
  color: #0f172a;
  font-weight: 600;
}
.pe-card-last {
  margin-bottom: 48rpx;
}
