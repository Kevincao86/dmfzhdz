.pe-page {
  min-height: 100vh;
  padding: 28rpx;
  box-sizing: border-box;
  background: linear-gradient(180deg, #e8f4fc 0%, #f8fafc 240rpx, #f8fafc 100%);
}
.pe-card {
  background: #fff;
  border-radius: 20rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(15, 23, 42, 0.04);
}
.pe-title {
  display: block;
  font-size: 34rpx;
  font-weight: 700;
  color: #0f172a;
}
.pe-desc {
  display: block;
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #64748b;
  line-height: 1.5;
}
.pe-guest-t {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: #0f172a;
}
.pe-guest-d {
  display: block;
  margin: 10rpx 0 20rpx;
  font-size: 24rpx;
  color: #64748b;
}
.field-label {
  display: block;
  margin: 20rpx 0 12rpx;
  font-size: 24rpx;
  color: #475569;
  font-weight: 600;
}
.pe-avatar-btn {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 0;
  margin: 0;
  background: transparent;
  text-align: left;
}
.pe-avatar-btn::after {
  border: none;
}
.pe-avatar {
  width: 112rpx;
  height: 112rpx;
  border-radius: 28rpx;
  background: #e2e8f0;
}
.pe-avatar-ph {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  color: #64748b;
}
.pe-avatar-tip {
  font-size: 24rpx;
  color: #0284c7;
}
.pe-input {
  height: 80rpx;
  padding: 0 24rpx;
  border-radius: 16rpx;
  background: #f1f5f9;
  font-size: 28rpx;
  color: #0f172a;
}
.pe-disabled {
  color: #94a3b8;
}
.pe-save {
  margin-top: 32rpx;
}
.btn-v2 {
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 16rpx;
  font-size: 28rpx;
  font-weight: 600;
}
.btn-v2.primary {
  background: #0284c7;
  color: #fff;
}
.btn-v2.primary::after {
  border: none;
}
