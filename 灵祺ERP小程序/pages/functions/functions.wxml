<scroll-view scroll-y class="page-func-v2" enhanced show-scrollbar="{{false}}" style="padding-bottom:var(--tab-bar-pad)">
  <view class="func-top" style="padding-top: {{statusBarHeight}}px">
    <view class="func-nav-slot">
      <text class="func-h1">商家能力中心</text>
    </view>
  </view>
  <view wx:if="{{guestMode}}" class="guest-banner" bindtap="onGoLogin">
    <text class="guest-banner-t">游客浏览中 · 可先查看功能模块</text>
    <text class="guest-banner-a">登录后使用完整能力 ›</text>
  </view>
  <block wx:for="{{sections}}" wx:key="id">
    <view class="func-block">
      <view class="func-group-head">
        <view class="func-dot {{item.dotClass}}"></view>
        <text class="func-group-title">{{item.title}}</text>
      </view>
      <view class="func-card">
        <view class="func-grid">
          <view
            wx:for="{{item.items}}"
            wx:for-item="cell"
            wx:key="title"
            class="func-cell"
            data-url="{{cell.url}}"
            bindtap="onOpenCell"
          >
            <view class="func-well {{cell.wellClass}}">
              <image class="func-ic" src="{{cell.iconSrc}}" mode="aspectFit" />
            </view>
            <text class="func-label">{{cell.title}}</text>
          </view>
        </view>
      </view>
    </view>
  </block>
  <site-icp-footer />
</scroll-view>
