@import '../../styles/func-icons.wxss';

.func-illus-img {
  width: 144rpx;
  height: 144rpx;
  flex-shrink: 0;
}

.guest-banner {
  margin: 0 0 20rpx;
  padding: 20rpx 24rpx;
  border-radius: 16rpx;
  background: linear-gradient(90deg, #e0f2fe, #f0f9ff);
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}
.guest-banner-t {
  font-size: 26rpx;
  font-weight: 600;
  color: #0f172a;
}
.guest-banner-a {
  font-size: 22rpx;
  color: #0284c7;
}

.sec-head-v2 text:nth-child(2) {
  flex: 1;
}

/* 子板块：左图标右文字 + 竖分割线（对齐目标稿） */
.page-func-v2 .grid-v2 {
  gap: 0;
}

.page-func-v2 .cell-v2 {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 12rpx;
  text-align: left;
  padding: 20rpx 14rpx;
  box-sizing: border-box;
}

.page-func-v2 .cell-v2-divide {
  border-right: 1rpx solid #e2e8f0;
}

.page-func-v2 .cell-text {
  flex: 1;
  min-width: 0;
}

.page-func-v2 .cell-strong {
  display: block;
  font-size: 22rpx;
  font-weight: 600;
  color: #0f172a;
  line-height: 1.35;
}

.page-func-v2 .cell-span {
  display: block;
  font-size: 18rpx;
  color: #94a3b8;
  margin-top: 4rpx;
  line-height: 1.35;
}

.page-func-v2 .grid-v2-2 .cell-v2:nth-child(n + 3) {
  border-top: 1rpx solid #e2e8f0;
}

.page-func-v2 .grid-v2-3 .cell-v2 {
  padding: 20rpx 10rpx;
}
