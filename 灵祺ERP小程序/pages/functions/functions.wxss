@import '../../styles/func-icons.wxss';

.page-func-v2 {
  min-height: 100vh;
  box-sizing: border-box;
  background: #2f6fed;
}

.func-blue {
  padding: 0 32rpx 88rpx;
  background: linear-gradient(180deg, #2f6fed 0%, #6aa4ff 100%);
  text-align: center;
}

.func-nav-slot {
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 160rpx;
  box-sizing: border-box;
}

.func-h1 {
  font-size: 36rpx;
  font-weight: 800;
  color: #ffffff;
  letter-spacing: 1rpx;
}

.func-p {
  display: block;
  margin-top: 4rpx;
  padding: 0 24rpx 8rpx;
  font-size: 22rpx;
  line-height: 1.45;
  color: rgba(255, 255, 255, 0.88);
}

.func-sheet {
  margin-top: -48rpx;
  min-height: 70vh;
  padding: 28rpx 20rpx 24rpx;
  background: #f4f8fc;
  border-radius: 36rpx 36rpx 0 0;
  box-sizing: border-box;
}

.guest-banner {
  margin: 0 8rpx 20rpx;
  padding: 22rpx 24rpx;
  border-radius: 24rpx;
  background: #ffffff;
  border: 1rpx solid #d6e4fb;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.guest-banner-t {
  font-size: 26rpx;
  font-weight: 600;
  color: #1e3a5f;
}

.guest-banner-a {
  font-size: 22rpx;
  color: #2f6fed;
  font-weight: 600;
}

.func-group {
  margin-bottom: 8rpx;
}

.func-group-title {
  display: block;
  margin: 8rpx 12rpx 4rpx;
  font-size: 26rpx;
  font-weight: 700;
  color: #1e3a5f;
}

.func-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
}

.func-cell {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 18rpx 6rpx 16rpx;
  box-sizing: border-box;
}

.func-well {
  width: 88rpx;
  height: 88rpx;
  border-radius: 26rpx;
  background: #e7f0ff;
  display: flex;
  align-items: center;
  justify-content: center;
}

.func-ic {
  width: 48rpx;
  height: 48rpx;
}

.func-label {
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
  width: 100%;
  margin-top: 10rpx;
  font-size: 22rpx;
  line-height: 1.3;
  font-weight: 600;
  color: #1e3a5f;
  text-align: center;
}
