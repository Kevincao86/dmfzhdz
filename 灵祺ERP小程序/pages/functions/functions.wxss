@import '../../styles/func-icons.wxss';

.home-page {
  min-height: 100vh;
  background: #e8eef4;
  box-sizing: border-box;
}

.home-hero {
  padding: 8rpx 24rpx 20rpx;
  background: #1e3a5f;
}

.home-search {
  display: flex;
  align-items: center;
  height: 68rpx;
  padding: 0 8rpx 0 20rpx;
  box-sizing: border-box;
  background: rgba(255, 255, 255, 0.12);
  border: 1rpx solid rgba(255, 255, 255, 0.18);
  border-radius: 8rpx;
}

.home-search-icon {
  flex-shrink: 0;
  width: 36rpx;
  font-size: 30rpx;
  color: rgba(255, 255, 255, 0.7);
}

.home-search-input {
  flex: 1;
  min-width: 0;
  height: 64rpx;
  margin: 0 12rpx;
  font-size: 26rpx;
  color: #fff;
  background: transparent;
}

.home-search-ph {
  color: rgba(255, 255, 255, 0.55);
}

.home-search-btn {
  flex-shrink: 0;
  min-width: 88rpx;
  height: 52rpx;
  padding: 0 18rpx;
  font-size: 24rpx;
  font-weight: 600;
  color: #1e3a5f;
  line-height: 52rpx;
  text-align: center;
  background: #fff;
  border-radius: 6rpx;
}

.home-desk {
  margin: 0 24rpx;
  padding: 20rpx 20rpx 8rpx;
  background: #fff;
  border-radius: 12rpx 12rpx 0 0;
}

.home-desk-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
}

.home-desk-copy {
  flex: 1;
  min-width: 0;
}

.home-desk-title {
  display: block;
  font-size: 28rpx;
  font-weight: 700;
  color: #14181f;
  line-height: 1.35;
}

.home-desk-sub {
  display: block;
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #64748b;
  line-height: 1.4;
}

.home-desk-cta {
  flex-shrink: 0;
  min-height: 52rpx;
  padding: 10rpx 18rpx;
  font-size: 22rpx;
  font-weight: 650;
  color: #1e3a5f;
  background: #fff;
  border: 1rpx solid #c9d4e0;
  border-radius: 6rpx;
  line-height: 1.2;
}

.home-kpis {
  display: flex;
  gap: 12rpx;
  margin-top: 16rpx;
  padding-bottom: 12rpx;
}

.home-kpi {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  padding: 14rpx;
  background: #f5f8fc;
  border: 1rpx solid #e4ebf3;
  border-radius: 10rpx;
  border-top: 6rpx solid #0284c7;
}

.home-kpi-order {
  background: #fff8f3;
  border-color: #f3e0d0;
  border-top-color: #c2410c;
}

.home-kpi-agent {
  background: #f4f6fb;
  border-top-color: #1e3a5f;
}

.home-kpi-tag {
  font-size: 18rpx;
  font-weight: 650;
  color: #0284c7;
  letter-spacing: 1rpx;
}

.home-kpi-order .home-kpi-tag {
  color: #c2410c;
}

.home-kpi-agent .home-kpi-tag {
  color: #1e3a5f;
}

.home-kpi-num {
  margin-top: 8rpx;
  font-size: 36rpx;
  font-weight: 700;
  color: #14181f;
  line-height: 1.1;
}

.home-kpi-lbl {
  margin-top: 4rpx;
  font-size: 20rpx;
  color: #64748b;
}

.home-hall {
  display: flex;
  gap: 8rpx;
  padding: 4rpx 0 12rpx;
}

.home-hall-item {
  flex: 1;
  min-height: 56rpx;
  padding: 10rpx 0;
  text-align: center;
  font-size: 22rpx;
  color: #64748b;
  border-radius: 8rpx;
  background: #f8fafc;
}

.home-hall-item.on {
  color: #1e3a5f;
  font-weight: 700;
  background: #e8eef4;
}

.guest-banner {
  margin: 0 24rpx 16rpx;
  padding: 20rpx 24rpx;
  background: #fff;
  border-bottom: 1rpx solid #eef1f5;
}

.guest-banner-t {
  display: block;
  font-size: 26rpx;
  font-weight: 600;
  color: #0f172a;
}

.guest-banner-a {
  display: block;
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #0284c7;
}

.home-page .sec-card-v2 {
  margin: 0 24rpx 16rpx;
  padding: 22rpx 20rpx 18rpx;
  border-radius: 12rpx;
  background: #fff;
  border: 1rpx solid #e8edf3;
}

.sec-head-v2 text:nth-child(2) {
  flex: 1;
}

.home-page .sec-head-v2 {
  margin-bottom: 8rpx;
  padding-bottom: 12rpx;
  border-bottom: 1rpx solid #f1f5f9;
}

.home-page .sec-row-v2 {
  padding: 10rpx 4rpx;
}

.home-page .sec-row-title {
  font-size: 28rpx;
  font-weight: 700;
}

.home-page .sec-row-desc {
  font-size: 22rpx;
  color: #94a3b8;
}

.home-page .grid-v2 {
  gap: 8rpx 0;
}

.home-page .cell-v2 {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: flex-start;
  gap: 12rpx;
  text-align: center;
  padding: 22rpx 10rpx 18rpx;
  box-sizing: border-box;
  border-radius: 20rpx;
}

.home-page .cell-v2-divide {
  border-right: 1rpx solid #eef2f7;
}

.home-page .cell-text {
  width: 100%;
  min-width: 0;
}

.home-page .cell-strong {
  display: block;
  font-size: 24rpx;
  font-weight: 700;
  color: #0f172a;
  line-height: 1.35;
}

.home-page .cell-span {
  display: block;
  font-size: 18rpx;
  color: #94a3b8;
  margin-top: 6rpx;
  line-height: 1.35;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.home-page .grid-v2-2 .cell-v2:nth-child(n + 3) {
  border-top: 1rpx solid #eef2f7;
}

.home-page .grid-v2-3 .cell-v2:nth-child(n + 4) {
  border-top: 1rpx solid #eef2f7;
}

.home-page .ibox-sm {
  width: 72rpx;
  height: 72rpx;
  border-radius: 22rpx;
  background: transparent !important;
  box-shadow: none !important;
  overflow: hidden;
}

.home-page .func-ic-sm {
  width: 72rpx;
  height: 72rpx;
  border-radius: 22rpx;
}

.home-empty {
  margin: 24rpx;
  padding: 48rpx 24rpx;
  text-align: center;
  font-size: 26rpx;
  color: #64748b;
  background: #fff;
  border-radius: 12rpx;
}
