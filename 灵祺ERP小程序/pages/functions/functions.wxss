@import '../../styles/func-icons.wxss';

.page-func-v2 {
  padding: 0 24rpx 16rpx;
  box-sizing: border-box;
  background: linear-gradient(180deg, #e8f4fc 0%, #f8fafc 220rpx, #f8fafc 100%);
}

.func-hero {
  position: relative;
  margin: 8rpx 0 24rpx;
  padding: 28rpx 24rpx;
  border-radius: 32rpx;
  background: linear-gradient(135deg, #ffffff 0%, #f0f9ff 55%, #ecfeff 100%);
  border: 1rpx solid rgba(14, 165, 233, 0.12);
  box-shadow: 0 12rpx 40rpx rgba(14, 165, 233, 0.08);
  overflow: hidden;
}

.func-hero-glow {
  position: absolute;
  right: -40rpx;
  top: -40rpx;
  width: 200rpx;
  height: 200rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(14, 165, 233, 0.18) 0%, transparent 70%);
  pointer-events: none;
}

.func-hero-main {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.func-brand-logo {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  flex-shrink: 0;
  box-shadow: 0 8rpx 24rpx rgba(91, 33, 182, 0.22);
  background: #fff;
}

.func-hero-text {
  flex: 1;
  min-width: 0;
}

.func-h1 {
  font-size: 40rpx;
  font-weight: 800;
  color: #0f172a;
  letter-spacing: 0.5rpx;
  display: block;
}

.func-p {
  font-size: 22rpx;
  color: #64748b;
  margin-top: 10rpx;
  line-height: 1.45;
  display: block;
}

.guest-banner {
  margin: 0 0 20rpx;
  padding: 22rpx 24rpx;
  border-radius: 24rpx;
  background: linear-gradient(105deg, #e0f2fe, #f0f9ff 60%, #ffffff);
  border: 1rpx solid rgba(2, 132, 199, 0.14);
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  box-shadow: 0 6rpx 20rpx rgba(2, 132, 199, 0.06);
}

.guest-banner-t {
  font-size: 26rpx;
  font-weight: 600;
  color: #0f172a;
}

.guest-banner-a {
  font-size: 22rpx;
  color: #0284c7;
  font-weight: 500;
}

.page-func-v2 .sec-card-v2 {
  border-radius: 28rpx;
  padding: 22rpx 20rpx 18rpx;
  margin-bottom: 18rpx;
  border: 1rpx solid rgba(15, 23, 42, 0.04);
  box-shadow: 0 10rpx 36rpx rgba(15, 23, 42, 0.05);
}

.sec-head-v2 text:nth-child(2) {
  flex: 1;
}

.page-func-v2 .sec-head-v2 {
  margin-bottom: 8rpx;
  padding-bottom: 12rpx;
  border-bottom: 1rpx solid #f1f5f9;
}

.page-func-v2 .sec-row-v2 {
  padding: 10rpx 4rpx;
}

.page-func-v2 .sec-row-title {
  font-size: 28rpx;
  font-weight: 700;
}

.page-func-v2 .sec-row-desc {
  font-size: 22rpx;
  color: #94a3b8;
}

/* 子板块：上图标下文案宫格（对齐图例） */
.page-func-v2 .grid-v2 {
  gap: 8rpx 0;
}

.page-func-v2 .cell-v2 {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: flex-start;
  gap: 12rpx;
  text-align: center;
  padding: 22rpx 10rpx 18rpx;
  box-sizing: border-box;
  border-radius: 20rpx;
}

.page-func-v2 .cell-v2-divide {
  border-right: 1rpx solid #eef2f7;
}

.page-func-v2 .cell-text {
  width: 100%;
  min-width: 0;
}

.page-func-v2 .cell-strong {
  display: block;
  font-size: 24rpx;
  font-weight: 700;
  color: #0f172a;
  line-height: 1.35;
}

.page-func-v2 .cell-span {
  display: block;
  font-size: 18rpx;
  color: #94a3b8;
  margin-top: 6rpx;
  line-height: 1.35;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.page-func-v2 .grid-v2-2 .cell-v2:nth-child(n + 3) {
  border-top: 1rpx solid #eef2f7;
}

.page-func-v2 .grid-v2-3 .cell-v2:nth-child(n + 4) {
  border-top: 1rpx solid #eef2f7;
}

.page-func-v2 .ibox-sm {
  width: 72rpx;
  height: 72rpx;
  border-radius: 22rpx;
  background: transparent !important;
  box-shadow: none !important;
  overflow: hidden;
}

.page-func-v2 .func-ic-sm {
  width: 72rpx;
  height: 72rpx;
  border-radius: 22rpx;
}
