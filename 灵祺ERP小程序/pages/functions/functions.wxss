@import '../../styles/func-icons.wxss';

.page-func-v2 {
  min-height: 100vh;
  box-sizing: border-box;
  background: #f5f6f8;
}

.func-top {
  background: #ffffff;
}

.func-nav-slot {
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 160rpx;
  box-sizing: border-box;
}

.func-h1 {
  font-size: 40rpx;
  font-weight: 800;
  color: #111827;
  letter-spacing: 1rpx;
}

.guest-banner {
  margin: 20rpx 24rpx 0;
  padding: 22rpx 24rpx;
  border-radius: 24rpx;
  background: #ffffff;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.guest-banner-t {
  font-size: 26rpx;
  font-weight: 600;
  color: #1e3a5f;
}

.guest-banner-a {
  font-size: 22rpx;
  color: #2f6fed;
  font-weight: 600;
}

.func-block {
  margin: 20rpx 24rpx 0;
}

.func-group-head {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin: 0 8rpx 12rpx;
}

.func-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #2f6fed;
}

.dot-blue { background: #2f6fed; }
.dot-green { background: #22c55e; }
.dot-amber { background: #f59e0b; }
.dot-pink { background: #ec4899; }
.dot-violet { background: #8b5cf6; }
.dot-slate { background: #94a3b8; }

.func-group-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #111827;
}

.func-card {
  background: #ffffff;
  border-radius: 28rpx;
  padding: 12rpx 8rpx 8rpx;
  box-shadow: 0 8rpx 28rpx rgba(15, 23, 42, 0.04);
}

.page-func-v2 .func-label {
  color: #334155;
  font-weight: 500;
}

.func-ic {
  width: 48rpx;
  height: 48rpx;
}
