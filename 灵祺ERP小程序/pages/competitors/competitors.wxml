<scroll-view scroll-y class="erp-page" enhanced show-scrollbar="{{false}}">
  <view class="erp-hero">
    <text class="erp-hero-title">竞争对手分析</text>
    <text class="erp-hero-sub">与电脑端同源。选择已认领门店后生成竞品报告。</text>
  </view>

  <view class="erp-card">
    <text class="erp-label">选择门店</text>
    <picker
      mode="selector"
      range="{{storeLabels}}"
      value="{{storeIndex}}"
      disabled="{{storeLoading || !storeLabels.length || busy}}"
      bindchange="onPickStore"
    >
      <view class="erp-input store-pick {{storePicked ? '' : 'is-placeholder'}}">
        {{storeLoading ? '加载门店…' : (storePicked ? storeName : (storeLabels.length ? '请选择已认领门店' : '暂无可选门店'))}}
      </view>
    </picker>
    <text wx:if="{{address}}" class="store-addr">{{address}}</text>
    <text wx:if="{{storeErr}}" class="erp-err">{{storeErr}}</text>
    <button class="erp-btn-primary" loading="{{busy}}" disabled="{{busy}}" bindtap="onAnalyze">
      {{busy ? '分析中…' : '开始分析'}}
    </button>
  </view>

  <view wx:if="{{err}}" class="erp-err">{{err}}</view>

  <view wx:if="{{summary}}" class="erp-card">
    <text class="erp-card-title">综合摘要</text>
    <text class="erp-body" user-select>{{summary}}</text>
  </view>

  <view wx:if="{{competitors.length}}" class="erp-card">
    <text class="erp-card-title">周边竞品</text>
    <view wx:for="{{competitors}}" wx:key="id" class="cp-row">
      <text class="cp-row-name">{{item.name}}</text>
      <text wx:if="{{item.distance}}" class="cp-row-meta">{{item.distance}}</text>
      <text wx:if="{{item.priceBand}}" class="cp-row-meta">价格带：{{item.priceBand}}</text>
      <text wx:if="{{item.note}}" class="cp-row-note">{{item.note}}</text>
    </view>
  </view>

  <view wx:if="{{suggestions.length}}" class="erp-card">
    <text class="erp-card-title">差异化建议</text>
    <view wx:for="{{suggestions}}" wx:key="*this" class="cp-sug">
      <text>· {{item}}</text>
    </view>
  </view>
</scroll-view>
