<scroll-view scroll-y class="cp-page" enhanced show-scrollbar="{{false}}">
  <view class="cp-hero">
    <text class="cp-title">竞争对手分析</text>
    <text class="cp-sub">与电脑端同源 API。填写门店名称与地址后生成竞品报告。</text>
  </view>

  <view class="cp-card">
    <text class="cp-label">门店名称</text>
    <input class="cp-input" value="{{storeName}}" placeholder="必填" bindinput="onStoreName" />
    <text class="cp-label">门店地址</text>
    <input class="cp-input" value="{{address}}" placeholder="含城市的详细地址" bindinput="onAddress" />
    <button class="cp-btn" loading="{{busy}}" disabled="{{busy}}" bindtap="onAnalyze">
      {{busy ? '分析中…' : '开始分析'}}
    </button>
  </view>

  <view wx:if="{{err}}" class="cp-err">{{err}}</view>

  <view wx:if="{{summary}}" class="cp-card">
    <text class="cp-card-title">综合摘要</text>
    <text class="cp-body" user-select>{{summary}}</text>
  </view>

  <view wx:if="{{competitors.length}}" class="cp-card">
    <text class="cp-card-title">周边竞品</text>
    <view wx:for="{{competitors}}" wx:key="id" class="cp-row">
      <text class="cp-row-name">{{item.name}}</text>
      <text wx:if="{{item.distance}}" class="cp-row-meta">{{item.distance}}</text>
      <text wx:if="{{item.priceBand}}" class="cp-row-meta">价格带：{{item.priceBand}}</text>
      <text wx:if="{{item.note}}" class="cp-row-note">{{item.note}}</text>
    </view>
  </view>

  <view wx:if="{{suggestions.length}}" class="cp-card">
    <text class="cp-card-title">差异化建议</text>
    <view wx:for="{{suggestions}}" wx:key="*this" class="cp-sug">
      <text>· {{item}}</text>
    </view>
  </view>
</scroll-view>
