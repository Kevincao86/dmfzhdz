.store-pick.is-placeholder {
  color: #94a3b8;
}

.store-addr {
  display: block;
  margin: 4rpx 0 8rpx;
  font-size: 24rpx;
  line-height: 1.5;
  color: #64748b;
}

.cp-row {
  padding: 16rpx 0;
  border-top: 1rpx solid #f1f5f9;
}

.cp-row:first-child {
  border-top: none;
}

.cp-row-name {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: var(--erp-text);
}

.cp-row-meta {
  display: block;
  margin-top: 4rpx;
  font-size: 22rpx;
  color: var(--erp-muted);
}

.cp-row-note {
  display: block;
  margin-top: 6rpx;
  font-size: 24rpx;
  color: #475569;
  line-height: 1.5;
}

.cp-sug {
  padding: 8rpx 0;
  font-size: 26rpx;
  color: var(--erp-text-secondary);
  line-height: 1.5;
}
