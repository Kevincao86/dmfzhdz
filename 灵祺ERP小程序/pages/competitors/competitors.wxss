.store-pick.is-placeholder {
  color: #94a3b8;
}

.store-addr {
  display: block;
  margin: 4rpx 0 8rpx;
  font-size: 24rpx;
  line-height: 1.5;
  color: #64748b;
}

.cp-row {
  padding: 16rpx 0;
  border-top: 1rpx solid #f1f5f9;
}

.cp-row:first-child {
  border-top: none;
}

.cp-row-name {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: var(--erp-text);
}

.cp-row-meta {
  display: block;
  margin-top: 4rpx;
  font-size: 22rpx;
  color: var(--erp-muted);
}

.cp-row-note {
  display: block;
  margin-top: 6rpx;
  font-size: 24rpx;
  color: #475569;
  line-height: 1.5;
}

.cp-sug {
  padding: 8rpx 0;
  font-size: 26rpx;
  color: var(--erp-text-secondary);
  line-height: 1.5;
}

.intel-map {
  width: 100%;
  height: 420rpx;
  margin-top: 12rpx;
  border-radius: 16rpx;
  overflow: hidden;
}

.heat-drivers {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-top: 12rpx;
}

.heat-chip {
  padding: 6rpx 14rpx;
  border-radius: 999rpx;
  background: #f1f5f9;
  color: #475569;
  font-size: 22rpx;
}

.heat-days {
  margin-top: 12rpx;
}

.heat-day {
  display: flex;
  justify-content: space-between;
  padding: 8rpx 0;
  font-size: 24rpx;
  color: #475569;
}

.heat-day-v {
  font-weight: 600;
  color: var(--erp-text);
}

.cp-hot {
  margin-top: 10rpx;
  padding: 12rpx;
  border-radius: 12rpx;
  background: #fffbeb;
  border: 1rpx solid #fde68a;
}

.cp-hot-title {
  display: block;
  font-size: 22rpx;
  font-weight: 600;
  color: #92400e;
  margin-bottom: 6rpx;
}

.cp-hot-line {
  display: block;
  font-size: 22rpx;
  color: #78350f;
  line-height: 1.5;
}

.cp-bundle {
  padding: 16rpx 0;
  border-top: 1rpx solid #d1fae5;
}

.cp-bundle:first-of-type {
  border-top: none;
}

.cp-bundle-title {
  display: block;
  font-size: 28rpx;
  font-weight: 700;
  color: #065f46;
}

.cp-bundle-price {
  display: block;
  margin-top: 6rpx;
  font-size: 24rpx;
  font-weight: 600;
  color: #047857;
}
