.cp-page {
  min-height: 100vh;
  background: linear-gradient(180deg, #e8f4fc 0%, #f8fafc 240rpx, #f8fafc 100%);
  padding-bottom: 48rpx;
}

.cp-hero {
  margin: 16rpx 24rpx;
  padding: 28rpx 24rpx;
  border-radius: 28rpx;
  background: linear-gradient(160deg, #f5f3ff 0%, #eef2ff 45%, #fff 100%);
}

.cp-title {
  display: block;
  font-size: 40rpx;
  font-weight: 800;
  color: #0f172a;
}

.cp-sub {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #64748b;
  line-height: 1.5;
}

.cp-card {
  margin: 0 24rpx 16rpx;
  padding: 22rpx;
  background: #fff;
  border-radius: 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(15, 23, 42, 0.04);
}

.cp-label {
  display: block;
  font-size: 22rpx;
  color: #64748b;
  margin: 8rpx 0;
}

.cp-input {
  width: 100%;
  box-sizing: border-box;
  padding: 16rpx 20rpx;
  background: linear-gradient(180deg, #e8f4fc 0%, #f8fafc 240rpx, #f8fafc 100%);
  border-radius: 16rpx;
  font-size: 28rpx;
  margin-bottom: 8rpx;
}

.cp-btn {
  margin-top: 16rpx;
  background: #7c3aed !important;
  color: #fff !important;
  border-radius: 999rpx !important;
  font-size: 28rpx !important;
}

.cp-err {
  margin: 0 24rpx 16rpx;
  color: #dc2626;
  font-size: 26rpx;
}

.cp-card-title {
  display: block;
  font-size: 28rpx;
  font-weight: 700;
  color: #0f172a;
  margin-bottom: 12rpx;
}

.cp-body {
  display: block;
  font-size: 26rpx;
  color: #334155;
  line-height: 1.6;
  white-space: pre-wrap;
}

.cp-row {
  padding: 16rpx 0;
  border-top: 1rpx solid #f1f5f9;
}

.cp-row-name {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: #0f172a;
}

.cp-row-meta {
  display: block;
  margin-top: 4rpx;
  font-size: 22rpx;
  color: #64748b;
}

.cp-row-note {
  display: block;
  margin-top: 6rpx;
  font-size: 24rpx;
  color: #475569;
  line-height: 1.5;
}

.cp-sug {
  padding: 8rpx 0;
  font-size: 26rpx;
  color: #334155;
  line-height: 1.5;
}
