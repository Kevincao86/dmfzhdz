<view class="page-agent-v2 support-chat-page">
  <view class="lq-hero support-hero">
    <view class="lq-hero-row">
      <image class="lq-hero-logo" src="{{logoSrc}}" mode="aspectFit" />
      <view>
        <text class="lq-hero-title">在线客服</text>
        <text class="lq-hero-sub">与商家管理后台坐席互通</text>
      </view>
    </view>
  </view>
  <scroll-view scroll-y class="support-chat" scroll-into-view="{{scrollTo}}" enhanced show-scrollbar="{{false}}">
    <view wx:for="{{messages}}" wx:key="id" id="msg-{{item.id}}" class="msg-row {{item.role === 'user' ? 'is-user' : ''}}">
      <image wx:if="{{item.role !== 'user'}}" class="ava" src="{{logoSrc}}" mode="aspectFit" />
      <view class="bubble {{item.role === 'user' ? 'bubble-user' : ''}}">
        <text user-select class="bubble-text">{{item.text || item.content}}</text>
      </view>
      <text wx:if="{{item.role === 'user'}}" class="ava ava-me">我</text>
    </view>
  </scroll-view>
  <view wx:if="{{!humanMode}}" class="support-human">
    <view wx:if="{{humanOpen}}" class="support-human-btn" bindtap="onRequestHuman">{{connecting ? '排队接入中…' : '进入人工客服'}}</view>
    <text wx:else class="support-human-off">人工客服服务时间为 9:00–22:00</text>
    <text wx:if="{{queueHint}}" class="support-human-off">{{queueHint}}</text>
  </view>
  <view class="composer-v2 support-composer">
    <input class="composer-input" placeholder="输入消息…" value="{{input}}" bindinput="onInput" confirm-type="send" bindconfirm="onSend" />
    <view class="send-v2" bindtap="onSend"><text class="send-glyph">➤</text></view>
  </view>
</view>
