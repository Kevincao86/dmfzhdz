.support-chat-page {
  min-height: 100vh;
  background: linear-gradient(180deg, #e8f4fc 0%, #f8fafc 40%, #f8fafc 100%);
  display: flex;
  flex-direction: column;
}
.support-hero {
  margin: 16rpx 24rpx 8rpx;
}
.support-chat {
  flex: 1;
  min-height: 0;
  height: 0;
  padding: 8rpx 24rpx 16rpx;
  box-sizing: border-box;
}
.msg-row {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
  margin-bottom: 20rpx;
}
.msg-row.is-user {
  justify-content: flex-end;
}
.ava {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  flex-shrink: 0;
  background: #fff;
}
.ava-me {
  background: #0891b2;
  color: #fff;
  font-size: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.bubble {
  max-width: 520rpx;
  padding: 20rpx 24rpx;
  border-radius: 16rpx;
  background: #fff;
  border: 1rpx solid rgba(15, 23, 42, 0.06);
  box-sizing: border-box;
}
.bubble-user {
  background: #0891b2;
  border-color: transparent;
}
.bubble-text {
  font-size: 28rpx;
  line-height: 40rpx;
  color: rgba(0, 0, 0, 0.9);
  white-space: pre-wrap;
}
.bubble-user .bubble-text {
  color: #fff;
}
.support-composer {
  margin: 0;
  border-top: 1rpx solid #e2e8f0;
  background: #fff;
  box-shadow: 0 -8rpx 24rpx rgba(15, 23, 42, 0.05);
}
.support-composer .composer-input {
  flex: 1;
}
.support-human {
  padding: 12rpx 24rpx 0;
  background: #fff;
}
.support-human-btn {
  height: 72rpx;
  border-radius: 12rpx;
  background: #fff7ed;
  color: #9a3412;
  border: 1rpx solid #fed7aa;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  font-weight: 600;
}
.support-human-off {
  display: block;
  text-align: center;
  font-size: 22rpx;
  color: #94a3b8;
  line-height: 36rpx;
}
