.support-chat-page {
  min-height: 100vh;
  background: linear-gradient(180deg, #e8f4fc 0%, #f8fafc 40%, #f8fafc 100%);
  display: flex;
  flex-direction: column;
}
.support-hero {
  margin: 16rpx 24rpx 8rpx;
}
.support-chat-page .chat-v2.tall {
  flex: 1;
  min-height: 0;
  padding-bottom: 16rpx;
}
.support-composer {
  margin: 0;
  border-top: 1rpx solid #e2e8f0;
  background: #fff;
  box-shadow: 0 -8rpx 24rpx rgba(15, 23, 42, 0.05);
}
.support-composer .composer-input {
  flex: 1;
}
