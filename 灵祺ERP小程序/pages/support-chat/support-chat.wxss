.support-chat-page {
  min-height: 100vh;
  background: linear-gradient(180deg, #e8f4fc 0%, #f8fafc 40%, #f8fafc 100%);
  display: flex;
  flex-direction: column;
}
.support-hero {
  margin: 16rpx 24rpx 8rpx;
}
.support-chat-page .chat-v2.tall {
  flex: 1;
  min-height: 0;
  padding-bottom: 16rpx;
}
.support-composer {
  margin: 0;
  border-top: 1rpx solid #e2e8f0;
  background: #fff;
  box-shadow: 0 -8rpx 24rpx rgba(15, 23, 42, 0.05);
}
.support-composer .composer-input {
  flex: 1;
}
.support-human {
  padding: 12rpx 24rpx 0;
  background: #fff;
}
.support-human-btn {
  height: 72rpx;
  border-radius: 12rpx;
  background: #fff7ed;
  color: #9a3412;
  border: 1rpx solid #fed7aa;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  font-weight: 600;
}
.support-human-off {
  display: block;
  text-align: center;
  font-size: 22rpx;
  color: #94a3b8;
  line-height: 36rpx;
}
