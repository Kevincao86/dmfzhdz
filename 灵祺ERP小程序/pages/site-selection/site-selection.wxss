.ss-score-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.ss-score {
  font-size: 64rpx;
  font-weight: 800;
  color: var(--erp-accent-strong);
  line-height: 1;
}

.ss-score-unit {
  margin-left: 6rpx;
  font-size: 24rpx;
  color: var(--erp-muted);
}

.ss-dim {
  padding: 14rpx 0;
  border-top: 1rpx solid #f1f5f9;
}

.ss-dim:first-of-type {
  border-top: none;
}

.ss-dim-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.ss-dim-label {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--erp-text);
}

.ss-dim-score {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--erp-accent-strong);
}

.ss-check {
  padding: 8rpx 0;
  font-size: 26rpx;
  color: var(--erp-text-secondary);
  line-height: 1.5;
}

.kb-title {
  display: block;
  font-size: 28rpx;
  font-weight: 700;
  color: var(--erp-text);
}

.intel-map {
  width: 100%;
  height: 420rpx;
  margin-top: 12rpx;
  border-radius: 16rpx;
  overflow: hidden;
}

.heat-drivers {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-top: 12rpx;
}

.heat-chip {
  padding: 6rpx 14rpx;
  border-radius: 999rpx;
  background: #f1f5f9;
  color: #475569;
  font-size: 22rpx;
}

.heat-days {
  margin-top: 12rpx;
}

.heat-day {
  display: flex;
  justify-content: space-between;
  padding: 8rpx 0;
  font-size: 24rpx;
  color: #475569;
}

.heat-day-v {
  font-weight: 600;
  color: var(--erp-text);
}

.ss-rec {
  padding: 16rpx 0;
  border-top: 1rpx solid #d1fae5;
}

.ss-rec:first-of-type {
  border-top: none;
}

.ss-near {
  padding: 12rpx 0;
  border-top: 1rpx solid #f1f5f9;
}

.ss-near:first-of-type {
  border-top: none;
}

.ss-near-name {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: var(--erp-text);
}
