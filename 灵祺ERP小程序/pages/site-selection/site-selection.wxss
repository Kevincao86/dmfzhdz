.ss-score-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.ss-score {
  font-size: 64rpx;
  font-weight: 800;
  color: var(--erp-accent-strong);
  line-height: 1;
}

.ss-score-unit {
  margin-left: 6rpx;
  font-size: 24rpx;
  color: var(--erp-muted);
}

.ss-dim {
  padding: 14rpx 0;
  border-top: 1rpx solid #f1f5f9;
}

.ss-dim:first-of-type {
  border-top: none;
}

.ss-dim-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.ss-dim-label {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--erp-text);
}

.ss-dim-score {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--erp-accent-strong);
}

.ss-check {
  padding: 8rpx 0;
  font-size: 26rpx;
  color: var(--erp-text-secondary);
  line-height: 1.5;
}

.kb-title {
  display: block;
  font-size: 28rpx;
  font-weight: 700;
  color: var(--erp-text);
}
