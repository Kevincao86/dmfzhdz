<scroll-view scroll-y class="erp-page" enhanced show-scrollbar="{{false}}">
  <view class="erp-hero">
    <text class="erp-hero-title">选址参考</text>
    <text class="erp-hero-sub">人流热度、周边地图与综合打分。与电脑端「选址参考」同源 API。</text>
  </view>

  <view class="erp-card">
    <text class="erp-label">选址地址（必填）</text>
    <input class="erp-input" value="{{address}}" placeholder="含城市的详细地址" bindinput="onAddress" />
    <button class="erp-btn-ghost" bindtap="onChooseLocation">从地图选点</button>
    <text class="erp-label">城市（可选）</text>
    <input class="erp-input" value="{{city}}" placeholder="如：宁波" bindinput="onCity" />
    <text class="erp-label">点位备注</text>
    <input class="erp-input" value="{{spotLabel}}" placeholder="如：商场 B1 入口旁" bindinput="onSpot" />
    <text class="erp-label">品牌/门店名</text>
    <input class="erp-input" value="{{brandName}}" placeholder="可选" bindinput="onBrand" />
    <button class="erp-btn-primary" loading="{{busy}}" disabled="{{busy}}" bindtap="onAnalyze">
      {{busy ? '评估中…' : '开始选址评估'}}
    </button>
  </view>

  <view wx:if="{{err}}" class="erp-err">{{err}}</view>

  <view wx:if="{{summary}}" class="erp-card">
    <view class="ss-score-row">
      <view>
        <text class="ss-score">{{overall}}</text>
        <text class="ss-score-unit">分</text>
      </view>
      <text class="erp-chip">{{verdict || '综合评分'}}</text>
    </view>
    <text class="erp-card-title" style="margin-top:16rpx">综合摘要</text>
    <text class="erp-body" user-select>{{summary}}</text>
    <text wx:if="{{heatNote}}" class="erp-hint" style="margin-top:12rpx">人流：{{heatNote}}</text>
  </view>

  <view wx:if="{{showMap}}" class="erp-card">
    <text class="erp-card-title">{{mapSourceLabel || '选址地图'}}</text>
    <map
      class="intel-map"
      latitude="{{mapLat}}"
      longitude="{{mapLng}}"
      scale="14"
      markers="{{markers}}"
      include-points="{{includePoints}}"
      enable-zoom
      enable-scroll
      show-location="{{false}}"
    />
    <text class="erp-hint">蓝标为预想点位，周边针为同业门店。</text>
  </view>

  <view wx:if="{{heat}}" class="erp-card">
    <text class="erp-card-title">近 7 日人流热度</text>
    <text wx:if="{{heat.insight}}" class="erp-body">{{heat.insight}}</text>
    <text wx:if="{{heat.disclaimer}}" class="erp-hint">{{heat.disclaimer}}</text>
    <view wx:if="{{heat.drivers.length}}" class="heat-drivers">
      <text wx:for="{{heat.drivers}}" wx:key="*this" class="heat-chip">{{item}}</text>
    </view>
    <view wx:if="{{heat.days.length}}" class="heat-days">
      <view wx:for="{{heat.days}}" wx:key="id" class="heat-day">
        <text>{{item.label}}</text>
        <text class="heat-day-v">日均 {{item.avg}}</text>
      </view>
    </view>
  </view>

  <view wx:if="{{dimensions.length}}" class="erp-card">
    <text class="erp-card-title">维度得分</text>
    <view wx:for="{{dimensions}}" wx:key="id" class="ss-dim">
      <view class="ss-dim-top">
        <text class="ss-dim-label">{{item.label}}</text>
        <text class="ss-dim-score">{{item.score}}</text>
      </view>
      <text wx:if="{{item.note}}" class="erp-hint">{{item.note}}</text>
    </view>
  </view>

  <view wx:if="{{recommendations.length}}" class="erp-card">
    <text class="erp-card-title">附近合适点位推荐</text>
    <view wx:for="{{recommendations}}" wx:key="id" class="ss-rec">
      <text class="kb-title">{{item.title}}{{item.score ? ' · ' + item.score : ''}}{{item.verdict ? ' · ' + item.verdict : ''}}</text>
      <text wx:if="{{item.distDir}}" class="erp-hint">{{item.distDir}}</text>
      <text wx:if="{{item.address}}" class="erp-hint">{{item.address}}</text>
      <text wx:if="{{item.note}}" class="erp-body">{{item.note}}</text>
      <text wx:if="{{item.countLine}}" class="erp-hint">{{item.countLine}}</text>
    </view>
  </view>

  <view wx:if="{{nearbyCompetitors.length}}" class="erp-card">
    <text class="erp-card-title">同业密度</text>
    <view wx:for="{{nearbyCompetitors}}" wx:key="id" class="ss-near">
      <text class="ss-near-name">{{item.name}}</text>
      <text wx:if="{{item.dist}}" class="erp-hint">{{item.dist}}</text>
    </view>
  </view>

  <view wx:if="{{checklist.length}}" class="erp-card">
    <text class="erp-card-title">落地清单</text>
    <view wx:for="{{checklist}}" wx:key="*this" class="ss-check">
      <text>· {{item}}</text>
    </view>
  </view>
</scroll-view>
