<scroll-view scroll-y class="bw-scroll" enhanced show-scrollbar="{{false}}">
  <text class="bw-back" bindtap="goHub">‹ 返回达人招募中心</text>

  <view class="bw-hero meoo-card">
    <text class="bw-kicker">对齐 Web Brief 弹窗流程</text>
    <text class="bw-title">AI达人Brief 智能生成</text>
    <text class="bw-lead">
      Step 选择投放平台 → 选择商品上下文 → 产出三版可引用 Brief。（生成接口与电脑端同源，需绑定抖音 Bearer。）
    </text>
  </view>

  <view class="bw-stepbar">
    <block wx:for="{{stepLabels}}" wx:for-index="si" wx:key="*this">
      <text class="bw-step-chip {{step === si + 1 ? 'on' : ''}}">{{si + 1}} {{item}}</text>
    </block>
  </view>

  <!-- 1 投放平台 -->
  <view wx:if="{{step === 1}}" class="bw-card meoo-card">
    <text class="bw-sec-title">选择投放平台</text>
    <view class="bw-plat-grid">
      <view
        wx:for="{{platforms}}"
        wx:key="key"
        data-k="{{item.key}}"
        bindtap="pickPlat"
        class="bw-plat-tile {{selectedKey === item.key ? 'on' : ''}}"
      >
        <text class="bw-plat-name">{{item.label}}</text>
        <text class="bw-plat-sub">{{item.sub}}</text>
      </view>
    </view>
    <button class="bw-btn-main" bindtap="tapNext1">下一步</button>
  </view>

  <!-- 2 主推 / 标签 -->
  <view wx:if="{{step === 2}}" class="bw-card meoo-card">
    <text class="bw-sec-title">主推与标签</text>
    <picker mode="selector" range="{{industryOptions}}" value="{{industryIndex}}" bindchange="onIndustryPick">
      <view class="bw-picker-box">经营行业：<text class="bw-pv">{{industryOptions[industryIndex]}}</text></view>
    </picker>

    <text class="bw-lab req">主推商品名称</text>
    <input class="bw-inp" placeholder="主推商品或服务名" bindinput="bindMainName" value="{{mainName}}" />
    <text class="bw-lab req">主推商品价格（元）</text>
    <input class="bw-inp" type="digit" placeholder="¥" bindinput="bindMainPrice" value="{{mainPrice}}" />

    <text class="bw-lab">次推商品（可选）</text>
    <input class="bw-inp" placeholder="次推名称" bindinput="bindSecName" value="{{secName}}" />
    <input class="bw-inp mt" type="digit" placeholder="次推价格（元）" bindinput="bindSecPrice" value="{{secPrice}}" />

    <text class="bw-lab">标签（可选，逗号分隔）</text>
    <textarea class="bw-area-sm" maxlength="400" placeholder="爆款性价比、新店开业、高颜值…" bindinput="bindTags" value="{{tagsComma}}" />

    <text class="bw-lab">门店（可选）</text>
    <input class="bw-inp" placeholder="同城门店称呼" bindinput="bindStore" value="{{storeName}}" />

    <button class="bw-btn-soft" bindtap="tapBack2">上一步</button>
    <button class="bw-btn-main" bindtap="runGenerate" loading="{{generating}}">生成 Brief</button>
    <text wx:if="{{errMsg}}" class="bw-err">{{errMsg}}</text>
  </view>

  <!-- 3 结果 -->
  <view wx:if="{{step === 3}}" class="bw-card meoo-card">
    <text class="bw-sec-title">三套 Brief 文稿</text>
    <button class="bw-btn-soft" bindtap="tapBack3">上一步</button>

    <block wx:for="{{previews}}" wx:for-index="pi" wx:key="pi">
      <view class="bw-result-block">
        <view class="bw-result-head">
          <text class="bw-variant">版本 {{pi === 0 ? 'A' : pi === 1 ? 'B' : 'C'}}</text>
          <view class="bw-result-mini">
            <button size="mini" data-i="{{pi}}" bindtap="onCopyVariant">复制</button>
            <button size="mini" type="primary" data-v="{{pi}}" bindtap="useVariant">写入招募引用</button>
          </view>
        </view>
        <text class="bw-prev-body">{{item}}</text>
      </view>
    </block>

    <button class="bw-btn-soft" bindtap="saveRecords">保存到「Brief生成记录」</button>
    <button class="bw-btn-soft" bindtap="goHub">返回达人招募中心</button>
  </view>

  <view class="bw-space" />
</scroll-view>
