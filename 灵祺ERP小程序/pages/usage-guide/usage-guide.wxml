<page-meta page-style="{{lqPageStyle}}" background-color="{{lqPageBg}}" background-color-top="{{lqNavBg}}" background-color-bottom="{{lqPageBg}}" />
<scroll-view class="{{lqAccentClass}} page foot-col" scroll-y enable-flex style="{{lqPageStyle}}">
  <text class="lead">商家小程序：下面是当前功能，以及对应的操作方式。</text>
  <view class="card" wx:for="{{sections}}" wx:key="title">
    <text class="card-title">{{item.title}}</text>
    <text class="step" wx:for="{{item.steps}}" wx:for-item="step" wx:key="*this">{{index + 1}}. {{step}}</text>
  </view>
<site-icp-footer />
</scroll-view>