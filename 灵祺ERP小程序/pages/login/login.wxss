.login-welcome {
  box-sizing: border-box;
  min-height: 100vh;
  padding: 12rpx 40rpx calc(40rpx + env(safe-area-inset-bottom));
  background: linear-gradient(180deg, #d9f3fb 0%, #e9f8f4 38%, #f4eefc 72%, #fbf7ff 100%);
}

.welcome-head {
  width: 100%;
  padding-top: 8rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.welcome-head__logo {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  border: 4rpx solid rgba(255, 255, 255, 0.85);
  box-shadow: 0 10rpx 28rpx rgba(30, 58, 95, 0.12);
  background: #fff;
}

.welcome-head__title {
  margin-top: 20rpx;
  font-size: 48rpx;
  font-weight: 750;
  color: #1e3a5f;
  letter-spacing: 2rpx;
}

.welcome-head__sub {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #5b6b7c;
  letter-spacing: 1rpx;
}

.welcome-grid {
  width: 100%;
  margin-top: 32rpx;
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20rpx;
}

.welcome-tile {
  min-height: 188rpx;
  padding: 22rpx 20rpx 18rpx;
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.62);
  border: 2rpx solid rgba(255, 255, 255, 0.88);
  box-shadow: 0 12rpx 36rpx rgba(90, 120, 160, 0.1);
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
}

.welcome-tile--hover {
  background: rgba(255, 255, 255, 0.8);
}

.welcome-tile--on {
  background: rgba(255, 255, 255, 0.92);
  border-color: #1e3a5f;
  box-shadow: 0 12rpx 36rpx rgba(30, 58, 95, 0.14);
}

.welcome-tile__mark {
  font-size: 22rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
  color: #7c3aed;
}

.welcome-tile--sms .welcome-tile__mark { color: #1e3a5f; }
.welcome-tile--reg .welcome-tile__mark { color: #0f4c5c; }
.welcome-tile--wx .welcome-tile__mark { color: #07c160; }

.welcome-tile__label {
  margin-top: 10rpx;
  font-size: 36rpx;
  font-weight: 750;
  color: #1e3a5f;
}

.welcome-tile__sub {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #64748b;
  line-height: 1.4;
}

.login-auth-card {
  margin: 24rpx 0 0 !important;
  background: rgba(255, 255, 255, 0.88);
  border: 2rpx solid rgba(255, 255, 255, 0.95);
}

.mode-hint {
  display: block;
  margin-bottom: 16rpx;
  font-size: 22rpx;
  color: #64748b;
  line-height: 1.45;
}

.field-label {
  display: block;
  font-size: 22rpx;
  color: #64748b;
  margin-bottom: 12rpx;
}

.input-field {
  flex: 1;
  min-width: 0;
  padding: 22rpx 0;
  font-size: 26rpx;
  background: transparent;
}

.sms-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.input-wrap.flex1 {
  flex: 1;
  min-width: 0;
}

.sms-btn {
  flex-shrink: 0;
  margin: 0 !important;
  padding: 0 24rpx !important;
  height: 72rpx !important;
  line-height: 72rpx !important;
  font-size: 22rpx !important;
  color: #0369a1 !important;
  background: #f1f5f9 !important;
  border: 1rpx solid #e2e8f0 !important;
  border-radius: 24rpx !important;
}

.sms-btn::after {
  border: none;
}

.err-msg {
  display: block;
  color: #dc2626;
  font-size: 24rpx;
  margin: 16rpx 0 0;
}

.btn-v2.guest-browse {
  margin-top: 20rpx;
  background: rgba(255, 255, 255, 0.72);
  color: #0284c7;
  border: 2rpx solid rgba(125, 211, 252, 0.8);
}
.btn-v2.guest-browse::after {
  border: none;
}
.guest-browse-hint {
  display: block;
  margin-top: 12rpx;
  font-size: 22rpx;
  color: #64748b;
  text-align: center;
}

.welcome-cluster {
  position: relative;
  width: 100%;
  min-height: 360rpx;
  margin-top: 8rpx;
}

.welcome-cluster--compact {
  min-height: 240rpx;
}

.welcome-cluster__glow {
  position: absolute;
  border-radius: 50%;
  pointer-events: none;
}

.welcome-cluster__glow--a {
  width: 280rpx;
  height: 280rpx;
  left: 8%;
  top: 18%;
  background: radial-gradient(circle, rgba(186, 230, 253, 0.55) 0%, transparent 70%);
}

.welcome-cluster__glow--b {
  width: 320rpx;
  height: 320rpx;
  right: 0;
  bottom: 0;
  background: radial-gradient(circle, rgba(221, 214, 254, 0.5) 0%, transparent 70%);
}

.welcome-glass {
  position: absolute;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(255, 255, 255, 0.42);
  border: 2rpx solid rgba(255, 255, 255, 0.78);
  box-shadow: 0 18rpx 40rpx rgba(90, 120, 160, 0.14);
}

.welcome-glass__icon {
  width: 72%;
  height: 72%;
}

.welcome-glass--0 {
  width: 148rpx;
  height: 148rpx;
  left: 18%;
  top: 22%;
  border-radius: 36rpx;
  transform: rotate(-12deg);
  z-index: 3;
}

.welcome-glass--1 {
  width: 168rpx;
  height: 168rpx;
  left: 42%;
  top: 8%;
  border-radius: 40rpx;
  transform: rotate(8deg);
  z-index: 4;
}

.welcome-glass--2 {
  width: 132rpx;
  height: 132rpx;
  left: 6%;
  top: 52%;
  border-radius: 32rpx;
  transform: rotate(14deg);
  z-index: 2;
}

.welcome-glass--3 {
  width: 140rpx;
  height: 140rpx;
  right: 8%;
  top: 42%;
  border-radius: 34rpx;
  transform: rotate(-7deg);
  z-index: 5;
}

.welcome-glass--4 {
  width: 124rpx;
  height: 124rpx;
  left: 38%;
  top: 58%;
  border-radius: 30rpx;
  transform: rotate(18deg);
  z-index: 1;
}

.login-submit {
  width: 100%;
  margin-top: 16rpx;
}

.login-submit::after {
  border: none;
}

.btn-v2.wx-login {
  width: 100%;
  margin-top: 8rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  background: #07c160 !important;
  color: #fff !important;
  border: none !important;
  font-size: 28rpx;
  font-weight: 700;
  border-radius: 28rpx;
  padding: 24rpx 32rpx;
}

.btn-v2.wx-login::after {
  border: none;
}

.wx-icon {
  width: 40rpx;
  height: 40rpx;
  flex-shrink: 0;
  border-radius: 8rpx;
  background: #fff;
}

.login-legal-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  flex-wrap: wrap;
  margin: 20rpx 0 0;
  gap: 4rpx;
}

.login-legal-check {
  width: 28rpx;
  height: 28rpx;
  margin-right: 8rpx;
  border-radius: 50%;
  border: 2rpx solid #7dd3fc;
  background: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

.login-legal-check__mark {
  font-size: 16rpx;
  line-height: 1;
  color: #fff;
}

.login-legal-check--on {
  background: #0284c7;
  border-color: #0284c7;
}

.login-legal-txt,
.login-legal-link {
  font-size: 22rpx;
  line-height: 1.4;
  color: #64748b;
}

.login-legal-link {
  color: #0284c7;
}

.login-legal-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 1000;
  background: rgba(15, 23, 42, 0.45);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 48rpx;
  box-sizing: border-box;
}

.login-legal-modal {
  width: 100%;
  max-width: 620rpx;
  padding: 36rpx 32rpx 28rpx;
  border-radius: 24rpx;
  background: #fff;
  box-sizing: border-box;
}

.login-legal-modal-title {
  display: block;
  font-size: 32rpx;
  font-weight: 700;
  color: #0f172a;
  text-align: center;
}

.login-legal-modal-content {
  display: block;
  margin-top: 18rpx;
  font-size: 26rpx;
  line-height: 1.55;
  color: #475569;
  text-align: center;
}

.login-legal-modal-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 28rpx;
}

.login-legal-modal-btn {
  flex: 1;
  height: 80rpx;
  line-height: 80rpx;
  border-radius: 16rpx;
  font-size: 28rpx;
  font-weight: 600;
  padding: 0;
  margin: 0;
}

.login-legal-modal-btn::after {
  border: none;
}

.login-legal-modal-btn--decline {
  background: #f1f5f9;
  color: #475569;
}

.login-legal-modal-btn--agree {
  background: #0284c7;
  color: #fff;
}
