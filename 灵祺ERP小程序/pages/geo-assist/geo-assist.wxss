.geo-page {
  min-height: 100vh;
  background: linear-gradient(180deg, #e8f4fc 0%, #f8fafc 240rpx, #f8fafc 100%);
  padding-bottom: calc(140rpx + env(safe-area-inset-bottom));
}

.geo-nav {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 28rpx 8rpx;
  background: #fff;
}

.geo-nav-title {
  font-size: 34rpx;
  font-weight: 800;
  color: #0f172a;
}

.geo-nav-report {
  display: flex;
  align-items: center;
  gap: 6rpx;
  font-size: 24rpx;
  color: #0284c7;
}

.geo-nav-report-ico {
  font-size: 24rpx;
}

.geo-score-card {
  margin: 16rpx 24rpx;
  padding: 28rpx 24rpx;
  border-radius: 28rpx;
  background: linear-gradient(135deg, #1d4ed8 0%, #0ea5e9 55%, #22d3ee 100%);
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  box-shadow: 0 16rpx 40rpx rgba(14, 165, 233, 0.28);
  overflow: hidden;
  position: relative;
}

.geo-score-card::before {
  content: '';
  position: absolute;
  left: -20rpx;
  top: -20rpx;
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.08);
}

.geo-score-left {
  flex: 1;
  min-width: 0;
  position: relative;
  z-index: 1;
}

.geo-score-label {
  display: block;
  font-size: 30rpx;
  font-weight: 700;
  color: #fff;
}

.geo-score-sub {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.9);
  line-height: 1.45;
}

.geo-score-trend {
  display: inline-flex;
  align-items: center;
  gap: 6rpx;
  margin-top: 14rpx;
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.18);
  font-size: 20rpx;
  color: #fff;
}

.geo-trend-up {
  color: #86efac;
  font-weight: 700;
}

.geo-gauge {
  flex-shrink: 0;
  position: relative;
  z-index: 1;
}

.geo-gauge-ring {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  border: 10rpx solid rgba(255, 255, 255, 0.25);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: radial-gradient(circle at 50% 60%, rgba(255, 255, 255, 0.12), transparent 70%);
  box-shadow: inset 0 0 0 6rpx rgba(255, 255, 255, 0.15);
}

.geo-gauge-num {
  font-size: 52rpx;
  font-weight: 800;
  color: #fff;
  line-height: 1;
}

.geo-gauge-total {
  margin-top: 4rpx;
  font-size: 18rpx;
  color: rgba(255, 255, 255, 0.85);
}

.geo-suggest-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 8rpx 28rpx 12rpx;
}

.geo-suggest-title {
  font-size: 30rpx;
  font-weight: 800;
  color: #0f172a;
}

.geo-suggest-more {
  font-size: 24rpx;
  color: #64748b;
}

.geo-suggest-list {
  padding: 0 24rpx;
}

.geo-suggest-item {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  padding: 22rpx 20rpx;
  margin-bottom: 14rpx;
  background: #fff;
  border-radius: 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(15, 23, 42, 0.04);
}

.geo-suggest-icon {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  flex-shrink: 0;
}

.geo-suggest-body {
  flex: 1;
  min-width: 0;
}

.geo-suggest-row1 {
  display: flex;
  align-items: center;
  gap: 10rpx;
  flex-wrap: wrap;
}

.geo-suggest-name {
  font-size: 28rpx;
  font-weight: 700;
  color: #0f172a;
}

.geo-suggest-badge {
  padding: 4rpx 12rpx;
  border-radius: 999rpx;
  font-size: 20rpx;
  font-weight: 600;
}

.geo-badge-good {
  color: #047857;
  background: #d1fae5;
}

.geo-badge-warn {
  color: #c2410c;
  background: #ffedd5;
}

.geo-suggest-desc {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #64748b;
  line-height: 1.45;
}

.geo-suggest-right {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 8rpx;
  flex-shrink: 0;
}

.geo-suggest-score {
  font-size: 26rpx;
  font-weight: 800;
}

.geo-score-good {
  color: #047857;
}

.geo-score-warn {
  color: #c2410c;
}

.geo-suggest-chev {
  font-size: 32rpx;
  color: #cbd5e1;
}

.geo-store-line {
  padding: 8rpx 28rpx 16rpx;
  font-size: 22rpx;
  color: #94a3b8;
}

.geo-tabs-scroller {
  width: 100%;
  white-space: nowrap;
  margin-bottom: 8rpx;
}

.geo-tabs {
  display: inline-flex;
  gap: 12rpx;
  padding: 0 24rpx 16rpx;
}

.geo-tab {
  flex-shrink: 0;
  padding: 14rpx 22rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  color: #64748b;
  background: #fff;
  border: 1rpx solid #e2e8f0;
}

.geo-tab.active {
  color: #fff;
  background: linear-gradient(95deg, #2563eb, #0891b2);
  border-color: transparent;
}

.geo-card {
  margin: 0 24rpx 16rpx;
  padding: 24rpx;
  background: #fff;
  border-radius: 20rpx;
  border: 1rpx solid rgba(15, 23, 42, 0.06);
  box-shadow: 0 6rpx 20rpx rgba(15, 23, 42, 0.04);
}

.geo-card-title {
  font-size: 26rpx;
  font-weight: 700;
  color: #0f172a;
}

.geo-card-body {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #475569;
  line-height: 1.55;
  display: block;
}

.geo-muted {
  font-size: 22rpx;
  color: #94a3b8;
}

.geo-muted-block {
  display: block;
  margin-top: 12rpx;
}

.geo-sync-btn {
  background: linear-gradient(95deg, #2563eb, #06b6d4) !important;
  color: #fff !important;
  border: none !important;
  border-radius: 999rpx !important;
}

.geo-area {
  margin-top: 12rpx;
  min-height: 200rpx;
  height: 200rpx;
  max-height: 280rpx;
  width: 100%;
  padding: 16rpx;
  border-radius: 14rpx;
  background: #f8fafc;
  border: 1rpx solid #e2e8f0;
  box-sizing: border-box;
}

.geo-single {
  margin-top: 12rpx;
  min-height: 80rpx;
  height: 80rpx;
  max-height: 120rpx;
  width: 100%;
  padding: 16rpx 18rpx;
  border-radius: 14rpx;
  border: 1rpx solid #e2e8f0;
  background: #f8fafc;
  box-sizing: border-box;
}

.geo-actions {
  margin-top: 12rpx;
  display: flex;
  gap: 12rpx;
}

.geo-primary {
  margin-top: 16rpx;
  background: linear-gradient(95deg, #2563eb, #06b6d4) !important;
  color: #fff !important;
  border-radius: 999rpx !important;
}

.geo-reply {
  margin-top: 16rpx;
  padding: 16rpx;
  border-radius: 14rpx;
  font-size: 24rpx;
  color: #1e293b;
  background: rgba(56, 189, 248, 0.1);
}

.geo-btn-ghost {
  border-radius: 999rpx !important;
}

.geo-footer-spacer {
  height: 40rpx;
}

.geo-fab-wrap {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 16rpx 28rpx calc(16rpx + env(safe-area-inset-bottom));
  background: rgba(255, 255, 255, 0.96);
  box-shadow: 0 -8rpx 24rpx rgba(15, 23, 42, 0.06);
  z-index: 30;
}

.geo-fab {
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  height: 88rpx;
  border-radius: 999rpx;
  background: linear-gradient(95deg, #0ea5e9, #22d3ee) !important;
  color: #fff !important;
  font-size: 28rpx;
  font-weight: 700;
  border: none !important;
  margin: 0;
}

.geo-fab::after {
  border: none;
}

.geo-fab-ico {
  font-size: 32rpx;
}
