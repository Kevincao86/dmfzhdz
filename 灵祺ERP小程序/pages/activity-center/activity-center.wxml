<scroll-view scroll-y class="page-pad-v2" enhanced show-scrollbar="{{false}}">
  <view class="lq-hero">
    <text class="lq-hero-title">活动中心</text>
    <text class="lq-hero-sub">多平台活动同步 · 状态一目了然</text>
  </view>
  <view class="chip-row">
    <text
      wx:for="{{tabs}}"
      wx:key="id"
      class="chip {{platform === item.id ? 'on' : ''}}"
      data-id="{{item.id}}"
      bindtap="onTab"
    >{{item.label}}</text>
  </view>
  <view wx:if="{{loading}}" class="lq-empty">
    <text class="lq-empty-title">加载中…</text>
    <text class="lq-empty-desc">正在同步活动数据</text>
  </view>
  <view wx:elif="{{err}}" class="lq-empty">
    <text class="lq-empty-title">加载失败</text>
    <text class="lq-empty-desc">{{err}}</text>
  </view>
  <view wx:elif="{{!items.length}}" class="lq-empty">
    <text class="lq-empty-title">暂无活动</text>
    <text class="lq-empty-desc">切换平台或稍后再试</text>
  </view>
  <block wx:else>
    <view wx:for="{{items}}" wx:key="id" class="lq-nav-card">
      <view class="lq-nav-ico orange">营</view>
      <view class="lq-nav-main">
        <text class="lq-nav-title">{{item.title}}</text>
        <text class="lq-nav-desc">{{item.summary}}</text>
      </view>
      <text class="tag">{{item.uiStatusLabel}}</text>
    </view>
  </block>
</scroll-view>
