<scroll-view scroll-y class="page" enhanced show-scrollbar="{{false}}">
  <view class="card">
    <text class="title">申请成为推广员</text>
    <text class="sub">点击申请即成为推广员，并生成专属推广二维码。好友扫码完成注册并支付后，按后台设置的比例获得佣金。</text>

    <view wx:if="{{booting}}" class="hint">正在加载…</view>
    <text wx:if="{{err}}" class="err">{{err}}</text>
    <text wx:if="{{info}}" class="info">{{info}}</text>

    <block wx:if="{{!booting && !active}}">
      <view class="field">
        <text class="label">真实姓名</text>
        <input class="input" value="{{realName}}" bindinput="onRealName" placeholder="与后续提现账户一致" maxlength="32" />
      </view>
      <view class="field">
        <text class="label">手机号</text>
        <input class="input" type="number" value="{{phone}}" bindinput="onPhone" placeholder="11 位大陆手机号" maxlength="11" />
      </view>
      <button class="btn" loading="{{submitting}}" disabled="{{submitting}}" bindtap="onApply">申请成为推广员</button>
    </block>

    <block wx:if="{{!booting && active}}">
      <text class="code">推广码 {{refCode}}</text>
      <text class="hint" wx:if="{{commissionHint}}">{{commissionHint}}</text>
      <text class="hint">网站二维码用手机扫码打开注册页；小程序二维码请用微信扫一扫。</text>
      <view class="link" wx:for="{{linkRows}}" wx:key="key">
        <view class="link-qr">
          <image
            wx:if="{{item.key === 'mp' ? wxacodePath : item.qr}}"
            class="link-qr-img"
            src="{{item.key === 'mp' ? wxacodePath : item.qr}}"
            mode="aspectFit"
            show-menu-by-longpress
          />
          <text wx:else class="hint">生成中</text>
        </view>
        <text class="link-label">{{item.label}}</text>
        <text class="link-url">{{item.url}}</text>
        <view class="row">
          <button class="btn btn-ghost btn-sm" data-url="{{item.url}}" bindtap="onCopyLink">复制{{item.copyLabel}}</button>
          <button class="btn btn-sm" data-key="{{item.key}}" bindtap="onDownloadQr">下载二维码</button>
        </view>
      </view>
      <view class="stats" wx:if="{{wallet}}">
        <text>可提现 ¥{{wallet.availableYuan}}</text>
        <text>已提现 ¥{{wallet.withdrawnYuan}}</text>
      </view>
    </block>
  </view>
  <site-icp-footer />
</scroll-view>
