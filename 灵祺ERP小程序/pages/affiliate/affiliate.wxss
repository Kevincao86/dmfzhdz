.page {
  min-height: 100vh;
  background: #f5f6f8;
  box-sizing: border-box;
}
.card {
  margin: 24rpx;
  padding: 32rpx;
  background: #fff;
  border-radius: 24rpx;
}
.title {
  display: block;
  font-size: 36rpx;
  font-weight: 700;
  color: #0f172a;
}
.sub, .hint, .info {
  display: block;
  margin-top: 16rpx;
  font-size: 26rpx;
  line-height: 1.6;
  color: #64748b;
}
.info { color: #1d4ed8; }
.err {
  display: block;
  margin-top: 16rpx;
  font-size: 26rpx;
  color: #b91c1c;
}
.field { margin-top: 28rpx; }
.label {
  display: block;
  margin-bottom: 8rpx;
  font-size: 24rpx;
  color: #475569;
}
.input {
  height: 80rpx;
  padding: 0 20rpx;
  border: 1rpx solid #e2e8f0;
  border-radius: 16rpx;
  font-size: 28rpx;
}
.btn {
  margin-top: 28rpx;
  background: #2f6fed;
  color: #fff;
  font-size: 28rpx;
  border-radius: 16rpx;
}
.btn-ghost {
  background: #fff;
  color: #1e293b;
  border: 1rpx solid #e2e8f0;
}
.btn-sm { margin-top: 12rpx; font-size: 24rpx; }
.code {
  display: block;
  margin-top: 24rpx;
  font-size: 32rpx;
  font-weight: 700;
  color: #0f172a;
}
.qr-box {
  margin-top: 20rpx;
  display: flex;
  justify-content: center;
}
.qr {
  width: 320rpx;
  height: 320rpx;
}
.row {
  display: flex;
  gap: 16rpx;
}
.row .btn { flex: 1; }
.link-qr {
  width: 220rpx;
  height: 220rpx;
  margin-top: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #f8fafc;
  border-radius: 16rpx;
}
.link-qr-img {
  width: 200rpx;
  height: 200rpx;
}
.link {
  margin-top: 24rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #f1f5f9;
}
.link-label, .link-url, .stats text {
  display: block;
  font-size: 24rpx;
  color: #334155;
}
.link-url {
  margin-top: 6rpx;
  color: #64748b;
  word-break: break-all;
}
.stats {
  margin-top: 28rpx;
  display: flex;
  justify-content: space-between;
}
