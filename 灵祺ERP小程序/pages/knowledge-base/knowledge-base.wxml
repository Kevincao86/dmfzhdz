<scroll-view scroll-y class="erp-page" enhanced show-scrollbar="{{false}}">
  <view class="erp-hero">
    <text class="erp-hero-title">我的知识库</text>
    <text class="erp-hero-sub">投喂门店资料、FAQ 与话术，供运营方案与内容创作引用。与电脑端同源。</text>
  </view>

  <view class="erp-card">
    <button class="erp-btn-ghost" bindtap="onToggleForm">{{showForm ? '收起投喂' : '＋ 投喂文本资料'}}</button>
    <block wx:if="{{showForm}}">
      <text class="erp-label">标题</text>
      <input class="erp-input" value="{{title}}" placeholder="如：门店介绍 / 停车说明" bindinput="onTitle" />
      <text class="erp-label">正文</text>
      <textarea class="erp-textarea" value="{{plainText}}" placeholder="粘贴或输入文本内容" bindinput="onPlain" maxlength="20000" />
      <button class="erp-btn-primary" loading="{{busy}}" disabled="{{busy}}" bindtap="onSubmit">
        {{busy ? '提交中…' : '保存并投喂知识库'}}
      </button>
      <text class="erp-hint" style="margin-top:12rpx">复杂文件上传请到电脑端 cs.mofangdianai.com → 我的知识库</text>
    </block>
  </view>

  <view wx:if="{{err}}" class="erp-err">{{err}}</view>
  <view wx:if="{{loading}}" class="erp-card"><text class="erp-hint">加载中…</text></view>

  <view wx:if="{{!loading && !docs.length}}" class="erp-card erp-empty">
    <text class="erp-empty-title">暂无资料</text>
    <text class="erp-empty-desc">先投喂一段门店介绍，后续运营方案与文案会更贴合你的店。</text>
  </view>

  <view wx:if="{{docs.length}}" class="erp-card">
    <text class="erp-card-title">已入库 {{docs.length}} 份</text>
    <view wx:for="{{docs}}" wx:key="id" class="erp-row kb-row">
      <view class="kb-main">
        <text class="kb-title">{{item.title}}</text>
        <text wx:if="{{item.summary}}" class="kb-sum">{{item.summary}}</text>
        <view class="kb-meta">
          <text class="erp-chip">{{item.feedLabel}}</text>
          <text class="kb-time">{{item.updatedAt}}</text>
        </view>
      </view>
      <text class="kb-del" data-id="{{item.id}}" bindtap="onDelete">删除</text>
    </view>
  </view>
</scroll-view>
