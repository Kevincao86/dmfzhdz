<scroll-view scroll-y class="ads-page" enhanced show-scrollbar="{{false}}">
  <view class="ads-head">
    <view class="ads-head-main">
      <text class="ads-title">投流管理</text>
      <text class="ads-sub">管理广告投放，掌握推广效果</text>
    </view>
    <view class="ads-head-actions">
      <view class="ads-bell" bindtap="onBell">
        <text>🔔</text>
        <view wx:if="{{hasUnread}}" class="ads-bell-dot"></view>
      </view>
      <button class="ads-new-btn" bindtap="onCreateAd">+ 新建</button>
    </view>
  </view>

  <view class="ads-channel-row">
    <view
      wx:for="{{channels}}"
      wx:key="id"
      class="ads-channel {{channel === item.id ? 'on' : ''}}"
      data-id="{{item.id}}"
      bindtap="onChannel"
    >{{item.label}}</view>
  </view>
  <text wx:if="{{bindHint}}" class="ads-bind-hint">{{bindHint}}</text>

  <view class="ads-today-card">
    <view class="ads-today-head">
      <text class="ads-today-title">今日数据</text>
      <text class="ads-today-more" bindtap="onViewAllData">查看全部 ›</text>
    </view>
    <view class="ads-kpi-grid">
      <view wx:for="{{todayStats}}" wx:key="key" class="ads-kpi">
        <text class="ads-kpi-val">{{item.value}}</text>
        <text class="ads-kpi-lab">{{item.label}}</text>
        <text class="ads-kpi-trend">较昨日 ↑ {{item.trend}}%</text>
      </view>
    </view>
  </view>

  <view class="ads-tab-bar">
    <scroll-view scroll-x class="ads-tab-scroll" enhanced show-scrollbar="{{false}}">
      <view class="ads-tab-row">
        <view
          wx:for="{{statusTabs}}"
          wx:key="id"
          class="ads-tab {{activeTab === item.id ? 'on' : ''}}"
          data-id="{{item.id}}"
          bindtap="onTab"
        >{{item.labelFull}}</view>
      </view>
    </scroll-view>
    <view class="ads-filter" bindtap="toggleFilter">
      <text>筛选</text>
      <text class="ads-filter-ico">▾</text>
    </view>
  </view>

  <view wx:if="{{showFilter}}" class="ads-filter-panel">
    <text class="ads-filter-tip">筛选当前渠道计划状态；本地推、千川、聚光账号互相隔离，与网页同源接口。</text>
  </view>

  <view wx:if="{{loading}}" class="ads-state">加载中…</view>
  <view wx:elif="{{err}}" class="ads-state ads-err">{{err}}</view>
  <view wx:elif="{{!displayItems.length}}" class="ads-state">暂无广告计划</view>
  <block wx:else>
    <view wx:for="{{displayItems}}" wx:key="id" class="ads-card">
      <image wx:if="{{item.thumb}}" class="ads-thumb" src="{{item.thumb}}" mode="aspectFill" />
      <view wx:else class="ads-thumb ads-thumb-ph">广</view>
      <view class="ads-card-main">
        <view class="ads-card-top">
          <text class="ads-card-name">{{item.name}}</text>
          <text class="ads-more">⋯</text>
        </view>
        <view class="ads-card-tags">
          <text class="ads-status ads-status-{{item.statusClass}}">● {{item.statusLabel}}</text>
          <text wx:for="{{item.tags}}" wx:for-item="tag" wx:key="*this" class="ads-tag">{{tag}}</text>
        </view>
        <view class="ads-metrics">
          <view class="ads-metric">
            <text class="ads-metric-lab">日预算(元)</text>
            <text class="ads-metric-val">{{item.dailyBudget}} ✎</text>
          </view>
          <view class="ads-metric">
            <text class="ads-metric-lab">消耗(元)</text>
            <text class="ads-metric-val">{{item.spend}}</text>
          </view>
          <view class="ads-metric">
            <text class="ads-metric-lab">曝光</text>
            <text class="ads-metric-val">{{item.exposure}}</text>
          </view>
        </view>
        <view class="ads-card-foot">
          <text class="ads-duration">投放时长 {{item.duration}}</text>
          <button class="ads-action-btn" size="mini" data-id="{{item.id}}" bindtap="onManage">{{item.actionLabel}}</button>
        </view>
        <text class="ads-data-link" data-id="{{item.id}}" bindtap="onViewData">{{expandedId === item.id ? '收起数据' : '查看数据'}} ›</text>
        <view wx:if="{{expandedId === item.id}}" class="ads-expand">
          <text>消耗 {{item.spend}} · 曝光 {{item.exposure}}</text>
          <text wx:if="{{item.click}}">点击 {{item.click}}</text>
        </view>
      </view>
    </view>
  </block>
  <view class="ads-bottom-space"></view>
</scroll-view>

<view wx:if="{{createOpen}}" class="ads-mask" catchtouchmove="noop">
  <view class="ads-sheet">
    <text class="ads-sheet-title">新建{{channel === 'xhs_juguang' ? '聚光' : channel === 'qianchuan' ? '千川' : '本地推'}}计划</text>
    <text class="ads-sheet-lab">计划名称</text>
    <input class="ads-sheet-input" value="{{createName}}" bindinput="onCreateName" placeholder="如：周末到店引流" />
    <text class="ads-sheet-lab">日预算（元，至少 100）</text>
    <input class="ads-sheet-input" type="digit" value="{{createBudget}}" bindinput="onCreateBudget" />
    <text class="ads-sheet-lab">投放目标</text>
    <view class="ads-channel-row" style="margin: 8rpx 0 16rpx;">
      <view
        wx:for="{{createGoals}}"
        wx:key="id"
        class="ads-channel {{createGoal === item.id ? 'on' : ''}}"
        data-id="{{item.id}}"
        bindtap="onCreateGoal"
      >{{item.label}}</view>
    </view>
    <text class="ads-bind-hint">将调用巨量/聚光开放接口创建项目或广告组。视频/创意素材仍可能需在广告后台补齐。</text>
    <view class="ads-sheet-row">
      <button class="ads-sheet-btn ghost" bindtap="onCreateClose">取消</button>
      <button class="ads-sheet-btn" loading="{{createBusy}}" bindtap="onCreateSubmit">创建</button>
    </view>
  </view>
</view>
