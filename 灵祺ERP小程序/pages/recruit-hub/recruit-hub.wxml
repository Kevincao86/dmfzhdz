<scroll-view scroll-y class="page-pad-v2 foot-col" enhanced show-scrollbar="{{false}}" enable-flex>
  <view class="lq-hero">
    <view class="lq-hero-row">
      <image class="lq-hero-logo" src="{{logoSrc}}" mode="aspectFit" />
      <view>
        <text class="lq-hero-title">达人招募</text>
        <text class="lq-hero-sub">开环探店 · 订单履约全链路</text>
      </view>
    </view>
  </view>

  <view class="func-grid hub-grid">
    <navigator url="/pages/recruit-flow/recruit-flow" class="func-cell" hover-class="none">
      <view class="func-well well-blue"><text class="hub-mark">①</text></view>
      <text class="func-label">五步流程</text>
    </navigator>
    <navigator url="/pages/recruitment/recruitment" class="func-cell" hover-class="none">
      <view class="func-well well-green"><text class="hub-mark">◎</text></view>
      <text class="func-label">查看达人订单</text>
    </navigator>
  </view>
<site-icp-footer />
</scroll-view>