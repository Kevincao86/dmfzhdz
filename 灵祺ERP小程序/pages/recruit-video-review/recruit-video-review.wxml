<scroll-view scroll-y class="page-pad-v2" enhanced show-scrollbar="{{false}}">
<view wx:if="{{loading}}" class="hint-v2">加载中…</view>
<view wx:elif="{{err}}" class="hint-v2 err">{{err}}</view>
<view wx:elif="{{!cards.length}}" class="hint-v2">暂无数据</view>
<block wx:else>
  <view wx:for="{{cards}}" wx:key="id" class="list-card-v2">
    <view>
      <text class="list-strong">{{item.title}}</text>
      <text class="list-span">{{item.sub}}</text>
    </view>
    <text class="tag">{{item.tag}}</text>
  </view>
</block></scroll-view>
