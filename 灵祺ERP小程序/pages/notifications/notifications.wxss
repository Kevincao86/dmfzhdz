.notify-page {
  min-height: 100vh;
  background: #f3f6fb;
  padding: 16rpx 24rpx;
  box-sizing: border-box;
}

.notify-empty {
  padding: 80rpx 24rpx;
  text-align: center;
  font-size: 26rpx;
  color: #94a3b8;
}

.notify-card {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  padding: 22rpx 20rpx;
  margin-bottom: 14rpx;
  background: #fff;
  border-radius: 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(15, 23, 42, 0.04);
}

.notify-icon {
  width: 80rpx;
  height: 80rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  flex-shrink: 0;
}

.notify-body {
  flex: 1;
  min-width: 0;
}

.notify-title {
  display: block;
  font-size: 28rpx;
  font-weight: 700;
  color: #0f172a;
}

.notify-desc {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #64748b;
  line-height: 1.45;
}

.notify-side {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 16rpx;
  flex-shrink: 0;
}

.notify-time {
  font-size: 20rpx;
  color: #94a3b8;
}

.notify-chev {
  font-size: 32rpx;
  color: #cbd5e1;
}

.notify-bottom-space {
  height: 24rpx;
}
