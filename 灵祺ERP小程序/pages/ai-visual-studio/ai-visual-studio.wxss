.vs-page {
  min-height: 100vh;
  padding-bottom: calc(48rpx + env(safe-area-inset-bottom));
  background: #f8fafc;
  box-sizing: border-box;
}

.vs-hero {
  margin: 0 0 8rpx;
  padding: 36rpx 32rpx 32rpx;
  background: linear-gradient(145deg, #4f46e5 0%, #6366f1 45%, #818cf8 100%);
  border-radius: 0 0 36rpx 36rpx;
}

.vs-hero__badge {
  display: inline-block;
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 600;
  color: #fff;
  background: rgba(255, 255, 255, 0.22);
}

.vs-hero__title {
  display: block;
  margin-top: 16rpx;
  font-size: 42rpx;
  font-weight: 800;
  color: #fff;
}

.vs-hero__sub {
  display: block;
  margin-top: 10rpx;
  font-size: 24rpx;
  line-height: 1.55;
  color: rgba(255, 255, 255, 0.92);
}

.vs-wizard {
  display: flex;
  margin: 20rpx 24rpx 0;
  padding: 6rpx;
  background: #fff;
  border-radius: 16rpx;
  border: 1rpx solid #e2e8f0;
}

.vs-wizard__step {
  flex: 1;
  text-align: center;
  padding: 16rpx 4rpx;
  font-size: 24rpx;
  font-weight: 600;
  color: #64748b;
  border-radius: 12rpx;
}

.vs-wizard__step.on {
  color: #4338ca;
  background: #eef2ff;
}

.vs-card {
  margin: 20rpx 24rpx;
  padding: 28rpx;
  background: #fff;
  border-radius: 20rpx;
  border: 1rpx solid #e2e8f0;
}

.vs-card__title {
  display: block;
  font-size: 32rpx;
  font-weight: 700;
  color: #0f172a;
}

.vs-card__sub {
  display: block;
  margin-top: 8rpx;
  margin-bottom: 16rpx;
  font-size: 24rpx;
  color: #64748b;
  line-height: 1.5;
}

.vs-label {
  display: block;
  margin-top: 20rpx;
  margin-bottom: 10rpx;
  font-size: 24rpx;
  font-weight: 600;
  color: #475569;
}

.vs-input {
  height: 80rpx;
  padding: 0 24rpx;
  border-radius: 14rpx;
  border: 1rpx solid #e2e8f0;
  background: #f8fafc;
  font-size: 28rpx;
}

.vs-chips {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 8rpx;
}

.vs-chip {
  padding: 14rpx 22rpx;
  border-radius: 999rpx;
  border: 1rpx solid #e2e8f0;
  background: #f8fafc;
  font-size: 24rpx;
  color: #475569;
}

.vs-chip.on {
  border-color: #6366f1;
  background: #eef2ff;
  color: #4338ca;
  font-weight: 600;
}

.vs-btn {
  margin-top: 24rpx;
  background: #4f46e5;
  color: #fff;
  font-size: 28rpx;
  font-weight: 600;
  border-radius: 16rpx;
}

.vs-btn.ghost {
  background: #fff;
  color: #4f46e5;
  border: 1rpx solid #c7d2fe;
}

.vs-pair {
  display: flex;
  gap: 16rpx;
  margin-top: 8rpx;
}

.vs-pair .vs-btn {
  flex: 1;
}

.vs-playbooks {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.vs-playbook {
  padding: 22rpx 24rpx;
  border-radius: 16rpx;
  border: 2rpx solid #e2e8f0;
  background: #f8fafc;
}

.vs-playbook.on {
  border-color: #6366f1;
  background: #eef2ff;
}

.vs-playbook__title {
  display: block;
  font-size: 30rpx;
  font-weight: 700;
  color: #1e293b;
}

.vs-playbook__desc {
  display: block;
  margin-top: 6rpx;
  font-size: 24rpx;
  color: #64748b;
}

.vs-copy-list {
  margin-top: 20rpx;
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.vs-copy {
  padding: 20rpx 22rpx;
  border-radius: 14rpx;
  border: 2rpx solid #e2e8f0;
  background: #fff;
}

.vs-copy.on {
  border-color: #6366f1;
  background: #f5f3ff;
}

.vs-copy__h {
  display: block;
  font-size: 30rpx;
  font-weight: 700;
  color: #1e293b;
}

.vs-copy__s {
  display: block;
  margin-top: 6rpx;
  font-size: 24rpx;
  color: #64748b;
}

.vs-copy__o {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  font-weight: 600;
  color: #4f46e5;
}

.vs-ref {
  margin-top: 16rpx;
  height: 280rpx;
  border-radius: 16rpx;
  overflow: hidden;
  background: #f1f5f9;
  border: 2rpx dashed #cbd5e1;
}

.vs-ref__img {
  width: 100%;
  height: 100%;
}

.vs-ref__empty {
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #94a3b8;
  font-size: 26rpx;
}

.vs-progress {
  display: block;
  margin-top: 16rpx;
  font-size: 24rpx;
  color: #64748b;
}

.vs-err {
  display: block;
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #dc2626;
}

.vs-result {
  margin-top: 24rpx;
}

.vs-result__img {
  width: 100%;
  border-radius: 16rpx;
  background: #0f172a;
}
