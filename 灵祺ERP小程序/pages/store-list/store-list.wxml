<scroll-view scroll-y class="store-page-v2" enhanced show-scrollbar="{{false}}">
  <view wx:if="{{mode === 'info' && showNotice}}" class="store-notice">
    <text class="store-notice-text">完善多平台店铺信息，提升曝光与转化</text>
    <text class="store-notice-close" bindtap="onCloseNotice">×</text>
  </view>
  <view wx:if="{{mode === 'decoration'}}" class="store-notice store-notice-soft">
    <text class="store-notice-text">展示各平台门店名称与地址，装修素材请在对应平台商家中心维护。</text>
  </view>

  <scroll-view scroll-x class="store-tab-scroll" enhanced show-scrollbar="{{false}}">
    <view class="store-tab-row">
      <view
        wx:for="{{tabs}}"
        wx:key="id"
        class="store-tab {{platform === item.id ? 'on' : ''}}"
        data-id="{{item.id}}"
        bindtap="onTab"
      >
        <image wx:if="{{item.showLogo}}" class="store-tab-logo" src="{{item.logo}}" mode="aspectFit" />
        <text>{{item.shortLabel}}</text>
      </view>
    </view>
  </scroll-view>

  <view class="store-body">
    <view wx:if="{{loading}}" class="store-state">加载中…</view>
    <block wx:elif="{{platCard}}">
      <view class="store-plat-card">
        <image
          wx:if="{{platCard.logo}}"
          class="store-plat-logo"
          src="{{platCard.logo}}"
          mode="aspectFit"
        />
        <view wx:else class="store-plat-logo store-plat-logo-ph">{{platCard.shortLabel}}</view>
        <view class="store-plat-main">
          <view class="store-plat-head">
            <text class="store-plat-name">{{platCard.title}}</text>
            <text class="store-badge store-badge-{{platCard.statusClass}}">{{platCard.statusText}}</text>
          </view>
          <text wx:if="{{platCard.subtitle}}" class="store-plat-sub">{{platCard.subtitle}}</text>
          <text wx:if="{{platCard.meta}}" class="store-plat-meta">{{platCard.meta}}</text>
        </view>
        <text class="chev store-plat-chev">›</text>
      </view>
      <view class="store-plat-action">
        <text class="store-plat-btn">{{platCard.actionLabel}}</text>
      </view>

      <view wx:if="{{err}}" class="store-state store-err">{{err}}</view>
      <view wx:elif="{{!platCard.connected}}" class="store-state store-err-soft">尚未绑定{{platCard.name}}</view>

      <view wx:if="{{items.length}}" class="store-list-block">
        <text class="store-list-title">门店列表</text>
        <view wx:for="{{items}}" wx:key="id" class="store-list-card">
          <text class="store-list-name">{{item.name}}</text>
          <text wx:if="{{item.address}}" class="store-list-addr">{{item.address}}</text>
          <text class="store-list-id">ID {{item.id}}</text>
        </view>
      </view>
    </block>
  </view>

  <view wx:if="{{mode === 'info'}}" class="store-foot-hint">
    <text>所有平台信息均通过官方授权，安全可靠</text>
  </view>
</scroll-view>
