.sv-root {
  height: 100vh;
  background: linear-gradient(180deg, #ecfeff 0%, #f0f9ff 280rpx, #f8fafc 100%);
  box-sizing: border-box;
}

.sv-header {
  position: relative;
  padding: 32rpx 28rpx 20rpx;
}

.sv-header-bar {
  position: absolute;
  left: 16rpx;
  top: 36rpx;
  width: 8rpx;
  height: 88rpx;
  border-radius: 8rpx;
  background: linear-gradient(180deg, #06b6d4, #0891b2);
}

.sv-header-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding-left: 16rpx;
}

.sv-header-icon {
  width: 64rpx;
  height: 64rpx;
  line-height: 64rpx;
  text-align: center;
  border-radius: 18rpx;
  background: linear-gradient(135deg, #cffafe, #a5f3fc);
  color: #0e7490;
  font-weight: 800;
  box-shadow: 0 8rpx 24rpx rgba(8, 145, 178, 0.18);
}

.sv-header-titles {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.sv-header-title {
  font-size: 40rpx;
  font-weight: 800;
  color: #0f172a;
}

.sv-header-sub {
  font-size: 22rpx;
  color: #0891b2;
  font-weight: 600;
}

.sv-header-desc {
  display: block;
  margin-top: 16rpx;
  padding-left: 16rpx;
  font-size: 26rpx;
  color: #475569;
  line-height: 1.55;
}

.sv-persist-tip {
  display: block;
  margin: 16rpx 8rpx 0 16rpx;
  padding: 14rpx 18rpx;
  border-radius: 12rpx;
  background: #fffbeb;
  border: 1rpx solid #fde68a;
  font-size: 22rpx;
  color: #92400e;
  line-height: 1.5;
}

.sv-points-bar {
  margin: 0 28rpx 12rpx;
  padding: 16rpx 20rpx;
  border-radius: 16rpx;
  background: #ecfeff;
  border: 1rpx solid #a5f3fc;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.sv-points-bal {
  font-size: 26rpx;
  font-weight: 700;
  color: #0e7490;
}

.sv-points-rate,
.sv-points-tip {
  font-size: 22rpx;
  color: #64748b;
  line-height: 1.45;
}

.sv-points-tip {
  margin: 0 28rpx 16rpx;
  padding: 12rpx 16rpx;
  border-radius: 12rpx;
  background: #f8fafc;
}

.sv-quick-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 14rpx;
  margin: 0 28rpx 20rpx;
}

.sv-quick-card {
  padding: 20rpx 18rpx;
  border-radius: 20rpx;
  background: rgba(255, 255, 255, 0.92);
  border: 1rpx solid #e2e8f0;
  box-shadow: 0 8rpx 28rpx -18rpx rgba(15, 23, 42, 0.2);
}

.sv-quick-card.on {
  border-color: #67e8f9;
  background: #ecfeff;
}

.sv-quick-lab {
  display: block;
  font-size: 28rpx;
  font-weight: 700;
  color: #0f172a;
}

.sv-quick-desc {
  display: block;
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #64748b;
}

.sv-main-tabs {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin: 0 28rpx 24rpx;
}

.sv-main-tab {
  padding: 12rpx 22rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  color: #475569;
  background: #fff;
  border: 1rpx solid #e2e8f0;
}

.sv-main-tab.active {
  color: #fff;
  background: linear-gradient(135deg, #06b6d4, #0891b2);
  border-color: transparent;
  font-weight: 700;
}

.sv-cabin-wrap {
  margin: 0 24rpx 24rpx;
}

.sv-cabin-heading {
  text-align: center;
  margin-bottom: 20rpx;
}

.sv-cabin-h1 {
  display: block;
  font-size: 34rpx;
  font-weight: 700;
  color: #0f172a;
}

.sv-cabin-h2 {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #64748b;
}

.sv-cabin {
  position: relative;
  padding: 28rpx 24rpx 32rpx;
  border-radius: 36rpx;
  background: rgba(255, 255, 255, 0.96);
  border: 1rpx solid rgba(226, 232, 240, 0.95);
  box-shadow: 0 24rpx 60rpx -28rpx rgba(15, 23, 42, 0.22);
}

.sv-skill-bar {
  margin-bottom: 12rpx;
}

.sv-skill-chip {
  display: inline-block;
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  background: #ecfeff;
  color: #0e7490;
  font-size: 22rpx;
  font-weight: 600;
  border: 1rpx solid #a5f3fc;
}

.sv-skill-clear {
  margin-left: 12rpx;
  font-size: 22rpx;
  color: #94a3b8;
}

.sv-slot-row {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-top: 10rpx;
}

.sv-slot {
  padding: 4rpx 12rpx;
  border-radius: 999rpx;
  font-size: 20rpx;
}

.sv-slot.ok {
  background: #ecfdf5;
  color: #047857;
}

.sv-slot.miss {
  background: #fffbeb;
  color: #b45309;
}

.sv-cabin-area {
  width: 100%;
  min-height: 200rpx;
  padding: 12rpx 8rpx;
  font-size: 28rpx;
  line-height: 1.55;
  color: #1e293b;
  box-sizing: border-box;
}

.sv-cabin-toolbar {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid #f1f5f9;
  margin-bottom: 16rpx;
}

.sv-chip {
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  background: #f1f5f9;
  color: #334155;
}

.sv-chip.cyan {
  background: #ecfeff;
  color: #0e7490;
  font-weight: 700;
  border: 1rpx solid #a5f3fc;
}

.sv-chip.dark {
  background: #0f172a;
  color: #fff;
}

.sv-dropdown {
  margin-bottom: 16rpx;
  max-height: 480rpx;
  overflow-y: auto;
  border-radius: 24rpx;
  border: 1rpx solid #e2e8f0;
  background: #fff;
  box-shadow: 0 16rpx 40rpx -20rpx rgba(15, 23, 42, 0.25);
}

.sv-dd-item {
  padding: 20rpx 22rpx;
  border-bottom: 1rpx solid #f1f5f9;
}

.sv-dd-item.on {
  background: #ecfeff;
}

.sv-dd-title {
  display: block;
  font-size: 28rpx;
  font-weight: 700;
  color: #0f172a;
}

.sv-dd-desc {
  display: block;
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #64748b;
  line-height: 1.4;
}

.sv-params-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
  margin-bottom: 16rpx;
}

.sv-params-grid.three {
  grid-template-columns: 1fr 1fr;
}

.sv-params-grid.four {
  grid-template-columns: 1fr 1fr;
}

.sv-field {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.sv-field.span2 {
  grid-column: span 2;
}

.sv-field-lab {
  font-size: 22rpx;
  color: #64748b;
}

.sv-pick,
.sv-input {
  padding: 16rpx 18rpx;
  border-radius: 14rpx;
  background: #f8fafc;
  border: 1rpx solid #e2e8f0;
  font-size: 26rpx;
  color: #0f172a;
}

.sv-longform-box {
  margin: 8rpx 0 20rpx;
  padding: 16rpx;
  border-radius: 20rpx;
  background: #f0f9ff;
  border: 1rpx solid #bae6fd;
}

.sv-check-row {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
}

.sv-check-title {
  display: block;
  font-size: 26rpx;
  font-weight: 700;
  color: #0f172a;
}

.sv-check-sub {
  display: block;
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #64748b;
  line-height: 1.45;
}

.sv-longform-extra {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 12rpx;
  margin-top: 16rpx;
}

.sv-script-panel {
  margin-bottom: 20rpx;
}

.sv-script-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}

.sv-script-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #0f172a;
}

.sv-script-acts {
  display: flex;
  gap: 20rpx;
}

.sv-link {
  font-size: 24rpx;
  color: #0891b2;
}

.sv-link.cyan {
  color: #0891b2;
  font-weight: 700;
}

.sv-link.danger {
  color: #dc2626;
}

.sv-script-card {
  margin-bottom: 14rpx;
  padding: 16rpx;
  border-radius: 18rpx;
  background: #f8fafc;
  border: 1rpx solid #e2e8f0;
}

.sv-script-card-top {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 10rpx;
}

.sv-script-idx {
  font-weight: 800;
  color: #0891b2;
  font-size: 24rpx;
}

.sv-area-sm {
  width: 100%;
  min-height: 100rpx;
  margin-top: 10rpx;
  padding: 12rpx;
  border-radius: 12rpx;
  background: #fff;
  border: 1rpx solid #e2e8f0;
  font-size: 24rpx;
  box-sizing: border-box;
}

.sv-music-sel {
  margin-bottom: 12rpx;
  font-size: 24rpx;
  color: #0e7490;
}

.sv-ref-thumb image {
  width: 100%;
  height: 240rpx;
  border-radius: 16rpx;
  margin-bottom: 12rpx;
}

.sv-story-list {
  margin-bottom: 12rpx;
}

.sv-story-item {
  display: block;
  font-size: 22rpx;
  color: #64748b;
}

.sv-adv-toggle {
  margin: 8rpx 0 12rpx;
  font-size: 22rpx;
  color: #64748b;
  text-decoration: underline;
}

.sv-adv-box {
  padding: 16rpx;
  margin-bottom: 16rpx;
  border-radius: 16rpx;
  background: #f8fafc;
  border: 1rpx dashed #cbd5e1;
}

.sv-radio-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 12rpx;
  font-size: 26rpx;
}

.sv-radio-dot {
  width: 28rpx;
  height: 28rpx;
  border-radius: 50%;
  border: 2rpx solid #94a3b8;
}

.sv-radio-dot.on {
  border-color: #0891b2;
  background: radial-gradient(circle, #06b6d4 40%, transparent 45%);
}

.sv-alert {
  margin: 12rpx 0;
  padding: 16rpx 18rpx;
  border-radius: 14rpx;
  font-size: 24rpx;
  line-height: 1.45;
}

.sv-alert.err {
  background: #fef2f2;
  color: #b91c1c;
  border: 1rpx solid #fecaca;
}

.sv-alert.hint {
  background: #ecfeff;
  color: #0e7490;
  border: 1rpx solid #a5f3fc;
}

.sv-btn-cyan,
.sv-btn-dark,
.sv-btn-outline,
.sv-btn-violet,
.sv-btn-green,
.sv-btn-ai,
.sv-btn-lite {
  margin-top: 12rpx;
  border-radius: 999rpx;
  font-size: 28rpx;
  font-weight: 700;
  border: none;
}

.sv-btn-cyan {
  background: linear-gradient(135deg, #22d3ee, #0891b2);
  color: #fff;
  box-shadow: 0 12rpx 28rpx -10rpx rgba(8, 145, 178, 0.55);
}

.sv-btn-cyan.sm,
.sv-btn-outline.sm,
.sv-btn-dark.sm {
  font-size: 24rpx;
  padding: 0 24rpx;
  margin: 0;
  line-height: 2.2;
}

.sv-btn-cyan.full,
.sv-btn-dark.full {
  width: 100%;
}

.sv-btn-dark {
  background: #0f172a;
  color: #fff;
}

.sv-btn-outline {
  background: #fff;
  color: #0f172a;
  border: 1rpx solid #cbd5e1 !important;
}

.sv-btn-violet {
  background: linear-gradient(135deg, #a78bfa, #7c3aed);
  color: #fff;
}

.sv-btn-green {
  background: #059669;
  color: #fff;
}

.sv-btn-ai {
  background: #ecfeff;
  color: #0e7490;
  font-size: 24rpx;
  padding: 0 20rpx;
  line-height: 2;
  border: 1rpx solid #a5f3fc !important;
}

.sv-btn-lite {
  background: #f1f5f9;
  color: #334155;
  font-size: 24rpx;
  padding: 0 20rpx;
  line-height: 2;
}

.sv-cabin-tip {
  display: block;
  margin-top: 12rpx;
  text-align: center;
  font-size: 22rpx;
  color: #94a3b8;
}

.sv-pane-head {
  display: flex;
  gap: 16rpx;
  align-items: flex-start;
  margin: 0 28rpx 20rpx;
}

.sv-pane-icon {
  width: 64rpx;
  height: 64rpx;
  line-height: 64rpx;
  text-align: center;
  border-radius: 18rpx;
  font-weight: 800;
  flex-shrink: 0;
}

.sv-pane-icon.cyan {
  background: #cffafe;
  color: #0e7490;
}

.sv-pane-title {
  display: block;
  font-size: 32rpx;
  font-weight: 800;
  color: #0f172a;
}

.sv-pane-sub {
  display: block;
  margin-top: 6rpx;
  font-size: 24rpx;
  color: #64748b;
  line-height: 1.45;
}

.sv-flow,
.sv-cases,
.sv-music {
  margin-bottom: 24rpx;
}

.sv-case-strip {
  white-space: nowrap;
  margin: 0 0 20rpx;
  padding: 0 28rpx;
}

.sv-case-strip-row {
  display: inline-flex;
  gap: 12rpx;
}

.sv-case-chip {
  display: inline-block;
  padding: 12rpx 20rpx;
  border-radius: 999rpx;
  background: #fff;
  border: 1rpx solid #a5f3fc;
  color: #0e7490;
  font-size: 22rpx;
}

.sv-flow-line {
  padding: 0 28rpx;
}

.sv-flow-node {
  position: relative;
  display: flex;
  gap: 16rpx;
  margin-bottom: 8rpx;
}

.sv-flow-dot {
  width: 48rpx;
  height: 48rpx;
  line-height: 48rpx;
  text-align: center;
  border-radius: 50%;
  background: linear-gradient(135deg, #22d3ee, #0891b2);
  color: #fff;
  font-weight: 800;
  font-size: 24rpx;
  flex-shrink: 0;
  z-index: 1;
}

.sv-flow-card {
  flex: 1;
  padding: 16rpx 18rpx;
  border-radius: 18rpx;
  background: #fff;
  border: 1rpx solid #e2e8f0;
  box-shadow: 0 8rpx 24rpx -18rpx rgba(15, 23, 42, 0.2);
}

.sv-flow-time {
  display: block;
  font-size: 22rpx;
  color: #0891b2;
  font-weight: 700;
}

.sv-flow-vis,
.sv-flow-dlg {
  display: block;
  margin-top: 6rpx;
  font-size: 24rpx;
  color: #334155;
  line-height: 1.4;
}

.sv-flow-acts {
  display: flex;
  gap: 20rpx;
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #0891b2;
}

.sv-flow-connector {
  position: absolute;
  left: 22rpx;
  top: 48rpx;
  bottom: -8rpx;
  width: 4rpx;
  background: linear-gradient(180deg, #67e8f9, #bae6fd);
}

.sv-actions {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  padding: 20rpx 28rpx;
}

.sv-case-preview {
  margin: 0 28rpx 20rpx;
}

.sv-case-grid {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  padding: 0 28rpx;
}

.sv-case-card {
  border-radius: 24rpx;
  overflow: hidden;
  background: #fff;
  border: 1rpx solid #e2e8f0;
  box-shadow: 0 12rpx 32rpx -20rpx rgba(15, 23, 42, 0.2);
}

.sv-case-cover {
  width: 100%;
  height: 280rpx;
  background: #e2e8f0;
}

.sv-case-body {
  padding: 18rpx 20rpx 22rpx;
}

.sv-case-badge {
  display: inline-block;
  padding: 4rpx 12rpx;
  border-radius: 999rpx;
  background: #ecfeff;
  color: #0e7490;
  font-size: 20rpx;
  margin-bottom: 8rpx;
}

.sv-case-title {
  display: block;
  font-size: 30rpx;
  font-weight: 800;
  color: #0f172a;
}

.sv-case-sub {
  display: block;
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #64748b;
}

.sv-case-btns {
  display: flex;
  gap: 12rpx;
  margin-top: 16rpx;
}

.sv-mood-scroll {
  white-space: nowrap;
  margin-bottom: 16rpx;
  padding: 0 28rpx;
}

.sv-mood-row {
  display: inline-flex;
  gap: 10rpx;
}

.sv-mood {
  display: inline-block;
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  background: #fff;
  border: 1rpx solid #e2e8f0;
  font-size: 22rpx;
  color: #475569;
}

.sv-mood.on {
  background: #0891b2;
  color: #fff;
  border-color: #0891b2;
}

.sv-music-row {
  display: flex;
  justify-content: space-between;
  gap: 16rpx;
  margin: 0 28rpx 14rpx;
  padding: 18rpx 20rpx;
  border-radius: 18rpx;
  background: #fff;
  border: 1rpx solid #e2e8f0;
}

.sv-music-title {
  display: block;
  font-size: 28rpx;
  font-weight: 700;
  color: #0f172a;
}

.sv-music-desc {
  display: block;
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #64748b;
}

.sv-music-acts {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  align-items: flex-end;
  flex-shrink: 0;
}

.sv-ice {
  margin: 0 24rpx 24rpx;
  padding: 24rpx;
  border-radius: 28rpx;
  background: #fff;
  border: 1rpx solid #e2e8f0;
}

.sv-ice-head {
  display: flex;
  justify-content: space-between;
  gap: 12rpx;
  margin-bottom: 20rpx;
}

.sv-ice-title-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.sv-ice-logo {
  width: 48rpx;
  height: 48rpx;
  line-height: 48rpx;
  text-align: center;
  border-radius: 14rpx;
  background: #ecfeff;
  color: #0891b2;
  font-weight: 800;
}

.sv-ice-title {
  font-size: 32rpx;
  font-weight: 800;
}

.sv-ice-desc {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #64748b;
  line-height: 1.45;
}

.sv-badge {
  align-self: flex-start;
  padding: 8rpx 14rpx;
  border-radius: 999rpx;
  font-size: 20rpx;
  background: #f1f5f9;
  color: #64748b;
}

.sv-badge.ok {
  background: #ecfdf5;
  color: #047857;
}

.sv-ice-sec {
  margin-bottom: 24rpx;
}

.sv-ice-sec-head {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-bottom: 12rpx;
}

.sv-ice-sec-head.between {
  justify-content: space-between;
}

.sv-step-n {
  width: 40rpx;
  height: 40rpx;
  line-height: 40rpx;
  text-align: center;
  border-radius: 50%;
  background: #0891b2;
  color: #fff;
  font-size: 22rpx;
  font-weight: 700;
}

.sv-step-n.sm {
  width: 32rpx;
  height: 32rpx;
  line-height: 32rpx;
  font-size: 20rpx;
}

.sv-ice-sec-title {
  font-size: 28rpx;
  font-weight: 700;
}

.sv-mat-tabs {
  display: flex;
  gap: 12rpx;
  margin-bottom: 16rpx;
}

.sv-mat-tab {
  padding: 12rpx 20rpx;
  border-radius: 999rpx;
  background: #f1f5f9;
  font-size: 24rpx;
  color: #475569;
}

.sv-mat-tab.on {
  background: #0891b2;
  color: #fff;
}

.sv-mat-tab.violet.on {
  background: #7c3aed;
}

.sv-warn-box {
  padding: 16rpx;
  margin-bottom: 12rpx;
  border-radius: 14rpx;
  background: #fffbeb;
  color: #92400e;
  font-size: 22rpx;
  line-height: 1.45;
}

.sv-warn-box .bold {
  display: block;
  font-weight: 700;
  margin-bottom: 6rpx;
}

.sv-upload-zone {
  padding: 28rpx 20rpx;
  margin-bottom: 12rpx;
  border-radius: 18rpx;
  border: 2rpx dashed #67e8f9;
  background: #ecfeff;
  text-align: center;
}

.sv-upload-zone.violet {
  border-color: #c4b5fd;
  background: #f5f3ff;
}

.sv-upload-zone.muted {
  opacity: 0.7;
}

.sv-upload-title {
  display: block;
  font-size: 28rpx;
  font-weight: 700;
  color: #0f172a;
}

.sv-upload-hint {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #64748b;
}

.sv-url-area,
.sv-area {
  width: 100%;
  min-height: 140rpx;
  padding: 16rpx;
  margin-bottom: 12rpx;
  border-radius: 14rpx;
  background: #f8fafc;
  border: 1rpx solid #e2e8f0;
  font-size: 26rpx;
  box-sizing: border-box;
}

.sv-ice-btns {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 12rpx;
}

.sv-queue-row,
.sv-task-item {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  align-items: center;
  padding: 14rpx 0;
  border-bottom: 1rpx solid #f1f5f9;
  font-size: 24rpx;
}

.sv-queue-name {
  flex: 1;
  color: #0f172a;
}

.sv-queue-phase {
  color: #64748b;
}

.sv-queue-del {
  color: #dc2626;
}

.sv-img-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 12rpx;
  margin-top: 12rpx;
}

.sv-img-cell {
  position: relative;
  height: 160rpx;
  border-radius: 12rpx;
  overflow: hidden;
}

.sv-img-cell image {
  width: 100%;
  height: 100%;
}

.sv-img-del {
  position: absolute;
  right: 8rpx;
  top: 4rpx;
  color: #fff;
  background: rgba(0, 0, 0, 0.45);
  width: 36rpx;
  height: 36rpx;
  text-align: center;
  line-height: 36rpx;
  border-radius: 50%;
}

.sv-out-params {
  margin-top: 12rpx;
}

.sv-batch-counts {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 12rpx;
}

.sv-batch-counts.dim {
  opacity: 0.45;
}

.sv-batch-n {
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  background: #f1f5f9;
  font-size: 24rpx;
}

.sv-batch-n.on {
  background: #0891b2;
  color: #fff;
}

.sv-submit-sticky {
  margin-top: 8rpx;
}

.sv-output {
  margin-top: 24rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #f1f5f9;
}

.sv-output-title {
  font-size: 28rpx;
  font-weight: 700;
}

.sv-output-empty {
  padding: 40rpx 0;
  text-align: center;
  color: #94a3b8;
  font-size: 24rpx;
}

.sv-video {
  width: 100%;
  margin: 12rpx 0;
  border-radius: 16rpx;
  background: #0f172a;
}

.sv-video.dark {
  background: #020617;
}

.sv-result {
  margin: 0 28rpx 24rpx;
  padding: 24rpx;
  border-radius: 24rpx;
  background: #0f172a;
  color: #e2e8f0;
}

.sv-result-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.sv-result-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #fff;
}

.sv-segments {
  margin-top: 16rpx;
}

.sv-label {
  display: block;
  margin-bottom: 8rpx;
  font-size: 24rpx;
  color: #94a3b8;
}

.sv-footer {
  display: block;
  text-align: center;
  padding: 12rpx 28rpx 40rpx;
  font-size: 22rpx;
  color: #94a3b8;
}

.sv-bottom-sp {
  height: 80rpx;
}

.sv-muted {
  font-size: 22rpx;
  color: #94a3b8;
}

.pad {
  padding: 0 4rpx;
}
