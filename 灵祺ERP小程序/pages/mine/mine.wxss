@import '../../styles/func-icons.wxss';

.page-mine-v2 {
  padding: 0 24rpx;
  box-sizing: border-box;
  background: linear-gradient(180deg, #e8f4fc 0%, #f8fafc 240rpx, #f8fafc 100%);
}

.profile-v2-hover {
  opacity: 0.94;
}

.profile-edit-pill {
  margin-top: 14rpx;
  display: inline-flex;
  align-items: center;
  gap: 6rpx;
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
  background: rgba(224, 242, 254, 0.95);
  border: 1rpx solid rgba(2, 132, 199, 0.16);
}
.profile-edit-text {
  font-size: 22rpx;
  color: #0284c7;
  font-weight: 600;
}
.profile-edit-arrow {
  font-size: 22rpx;
  color: #0284c7;
}

.guest-login-card {
  margin: 0 0 20rpx;
  padding: 22rpx 24rpx;
  border-radius: 24rpx;
  background: #fff;
  border: 1rpx solid rgba(2, 132, 199, 0.12);
  box-shadow: 0 10rpx 28rpx rgba(2, 132, 199, 0.06);
}
.guest-login-t {
  display: block;
  font-size: 26rpx;
  font-weight: 600;
  color: #0f172a;
}
.guest-login-a {
  display: block;
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #0284c7;
}

/* AI 圆角图标 */
.mine-line-ic {
  width: 48rpx;
  height: 48rpx;
  display: block;
  flex-shrink: 0;
  background: transparent;
  border-radius: 14rpx;
}

.mine-menu-ic {
  margin-right: 4rpx;
}

.store-logo-line {
  width: 112rpx;
  height: 112rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  border-radius: 50%;
  background: #fff;
  box-shadow: 0 10rpx 28rpx rgba(91, 33, 182, 0.18);
}

.store-logo-img {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: transparent;
}

.plat-line-ic {
  width: 44rpx;
  height: 44rpx;
  flex-shrink: 0;
  background: transparent;
}

.bind-label {
  flex: 1;
  min-width: 0;
  color: #0f172a;
}

.bind-head-v2 {
  margin-bottom: 0;
}

.bind-head-title {
  flex: 1;
}

.bind-chev {
  margin-left: auto;
  transition: transform 0.2s ease;
}

.bind-chev-open {
  transform: rotate(180deg);
}

.bind-hint {
  display: block;
  margin: 12rpx 0 4rpx;
  padding: 0 8rpx;
}

.bind-card-v2 .bind-row:first-of-type {
  border-top: 2rpx solid #f1f5f9;
  margin-top: 16rpx;
}

.menu-item-title {
  flex: 1;
  color: #0f172a;
}

.logout-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 10000;
  background: rgba(15, 23, 42, 0.45);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 48rpx;
  box-sizing: border-box;
}

.logout-dialog {
  width: 100%;
  max-width: 560rpx;
}

.logout-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 32rpx;
}

.logout-actions .btn-v2 {
  flex: 1;
  margin: 0;
}

.logout-actions .btn-v2::after {
  border: none;
}

.page-mine-v2 .logout-v2 {
  width: 100%;
  padding: 26rpx;
  border: 1rpx solid #fecaca;
  border-radius: 28rpx;
  background: #fff;
  color: #ef4444;
  font-size: 28rpx;
  font-weight: 600;
  box-shadow: 0 8rpx 24rpx rgba(239, 68, 68, 0.06);
}

.page-mine-v2 .logout-v2::after {
  border: none;
}

.page-mine-v2 .menu-item-title {
  font-weight: 600;
}

.page-mine-v2 .bind-card-v2 {
  border-radius: 28rpx;
}
