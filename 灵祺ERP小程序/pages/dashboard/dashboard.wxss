.home-page {
  min-height: 100vh;
  box-sizing: border-box;
  background: #f5f6f8;
}

.home-poster {
  height: 396rpx;
  margin: 20rpx 24rpx 0;
  border-radius: 28rpx;
  overflow: hidden;
  background: #e8eef8;
}

.home-poster__slide,
.home-poster__img {
  width: 100%;
  height: 100%;
}

.home-poster__slide {
  position: relative;
}

.home-poster__title {
  position: absolute;
  left: 24rpx;
  right: 24rpx;
  bottom: 28rpx;
  font-size: 34rpx;
  font-weight: 800;
  color: #ffffff;
  text-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.45);
}

.home-feed-title {
  display: block;
  margin: 28rpx 28rpx 16rpx;
  font-size: 30rpx;
  font-weight: 800;
  color: #111827;
}

.home-entry {
  display: flex;
  gap: 16rpx;
  margin: 0 24rpx 24rpx;
}

.home-entry__card {
  flex: 1;
  min-width: 0;
  background: #ffffff;
  border-radius: 24rpx;
  overflow: hidden;
  box-shadow: 0 8rpx 24rpx rgba(15, 23, 42, 0.05);
}

.home-entry__img {
  width: 100%;
  height: 160rpx;
  display: block;
}

.home-entry__title {
  display: block;
  padding: 14rpx 8rpx 16rpx;
  font-size: 24rpx;
  font-weight: 600;
  color: #1e3a5f;
  text-align: center;
}

.home-card {
  margin: 0 24rpx 20rpx;
  padding: 8rpx 8rpx 12rpx;
  background: #ffffff;
  border-radius: 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(15, 23, 42, 0.05);
}

.home-card__title {
  display: block;
  margin: 16rpx 20rpx 8rpx;
  font-size: 30rpx;
  font-weight: 800;
  color: #111827;
}

.home-muted {
  margin: 8rpx 20rpx 20rpx;
  font-size: 26rpx;
  color: #94a3b8;
}

.home-todo {
  display: flex;
  align-items: center;
  margin: 0 12rpx;
  padding: 18rpx 12rpx;
}

.home-todo__dot {
  width: 16rpx;
  height: 16rpx;
  margin-right: 16rpx;
  border-radius: 50%;
  flex-shrink: 0;
}

.dot-amber {
  background: #f5b942;
}

.dot-violet {
  background: #8b7cf6;
}

.home-todo__title {
  flex: 1;
  min-width: 0;
  font-size: 28rpx;
  color: #1e293b;
}

.home-todo__count {
  margin-right: 8rpx;
  font-size: 28rpx;
  font-weight: 700;
  color: #2f6fed;
}

.home-todo__chev {
  font-size: 28rpx;
  color: #94a3b8;
}

.home-card__head {
  display: flex;
  align-items: center;
}

.home-card__head .home-card__title {
  flex: 1;
}

.home-card__action {
  margin-right: 20rpx;
  font-size: 26rpx;
  font-weight: 600;
  color: #2f6fed;
}

.home-recruit {
  display: flex;
  align-items: center;
  margin: 0 20rpx 12rpx;
  padding: 20rpx 0;
  border-top: 1rpx solid #f1f5f9;
}

.home-recruit__title {
  flex: 1;
  min-width: 0;
  font-size: 28rpx;
  color: #1e293b;
}

.home-recruit__status {
  margin-left: 16rpx;
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
  background: #f4efe6;
  color: #8a6a2f;
  font-size: 22rpx;
}
