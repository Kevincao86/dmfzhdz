.home-page {
  min-height: 100vh;
  box-sizing: border-box;
  background: #f5f6f8;
}

.home-poster {
  height: 396rpx;
  margin: 20rpx 24rpx 0;
  border-radius: 28rpx;
  overflow: hidden;
  background: #e8eef8;
}

.home-poster__slide,
.home-poster__img {
  width: 100%;
  height: 100%;
}

.home-poster__slide {
  position: relative;
}

.home-poster__title {
  position: absolute;
  left: 24rpx;
  right: 24rpx;
  bottom: 28rpx;
  font-size: 34rpx;
  font-weight: 800;
  color: #ffffff;
  text-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.45);
}

.home-feed-title {
  display: block;
  margin: 28rpx 28rpx 16rpx;
  font-size: 30rpx;
  font-weight: 800;
  color: #111827;
}

.home-entry {
  display: flex;
  gap: 16rpx;
  margin: 0 24rpx 24rpx;
}

.home-entry__card {
  flex: 1;
  min-width: 0;
  background: #ffffff;
  border-radius: 24rpx;
  overflow: hidden;
  box-shadow: 0 8rpx 24rpx rgba(15, 23, 42, 0.05);
}

.home-entry__img {
  width: 100%;
  height: 160rpx;
  display: block;
}

.home-entry__title {
  display: block;
  padding: 14rpx 8rpx 16rpx;
  font-size: 24rpx;
  font-weight: 600;
  color: #1e3a5f;
  text-align: center;
}
