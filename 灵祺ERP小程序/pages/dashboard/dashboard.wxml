<scroll-view scroll-y class="home-page" enhanced show-scrollbar="{{false}}" style="padding-bottom:var(--tab-bar-pad)">
  <swiper
    class="home-poster"
    indicator-dots
    indicator-color="rgba(255,255,255,0.55)"
    indicator-active-color="#ffffff"
    circular
    autoplay
    interval="{{posterInterval}}"
    duration="400"
  >
    <swiper-item wx:for="{{posters}}" wx:key="key">
      <view class="home-poster__slide" data-index="{{index}}" bindtap="onPosterTap">
        <video
          wx:if="{{item.isVideo}}"
          class="home-poster__img"
          src="{{item.imageUrl}}"
          autoplay
          muted
          loop
          show-center-play-btn="{{false}}"
          show-play-btn="{{false}}"
          controls="{{false}}"
          object-fit="cover"
        />
        <image wx:else class="home-poster__img" src="{{item.imageUrl}}" mode="aspectFill" />
        <text wx:if="{{item.title}}" class="home-poster__title">{{item.title}}</text>
      </view>
    </swiper-item>
  </swiper>

  <text class="home-feed-title">常用入口</text>
  <view class="home-entry">
    <view
      wx:for="{{entries}}"
      wx:key="id"
      class="home-entry__card"
      data-id="{{item.id}}"
      bindtap="onEntryTap"
    >
      <image class="home-entry__img" src="{{item.imageUrl}}" mode="aspectFill" />
      <text class="home-entry__title">{{item.title}}</text>
    </view>
  </view>
  <view class="home-card">
    <text class="home-card__title">今日待办</text>
    <view wx:if="{{!todoLoaded}}" class="home-muted">加载中…</view>
    <view wx:elif="{{!todos.length}}" class="home-muted">今天没有待处理</view>
    <block wx:else>
      <view class="home-todo" wx:for="{{todos}}" wx:key="id" data-url="{{item.url}}" bindtap="onTodoTap">
        <view class="home-todo__dot {{item.dot}}"></view>
        <text class="home-todo__title">{{item.title}}</text>
        <text class="home-todo__count">{{item.count}}</text>
        <text class="home-todo__chev">›</text>
      </view>
    </block>
  </view>

  <view class="home-card home-card--tap" bindtap="onYesterdayTap">
    <text class="home-card__title">昨日一句</text>
    <view class="home-yday">
      <text class="home-yday__text">{{yesterdayText}}</text>
      <text class="home-yday__link">查看</text>
    </view>
  </view>

  <view wx:if="{{recruits.length}}" class="home-card">
    <text class="home-card__title">进行中的招募</text>
    <view class="home-recruit" wx:for="{{recruits}}" wx:key="id" bindtap="onRecruitTap">
      <text class="home-recruit__title">{{item.title}}</text>
      <text class="home-recruit__status">{{item.status}}</text>
    </view>
  </view>

  <site-icp-footer />
</scroll-view>
