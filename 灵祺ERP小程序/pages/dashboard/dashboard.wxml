<scroll-view scroll-y class="home-page" enhanced show-scrollbar="{{false}}" style="padding-bottom:var(--tab-bar-pad)">
  <swiper
    class="home-poster"
    indicator-dots
    indicator-color="rgba(255,255,255,0.55)"
    indicator-active-color="#ffffff"
    circular
    autoplay
    interval="{{posterInterval}}"
    duration="400"
  >
    <swiper-item wx:for="{{posters}}" wx:key="key">
      <view class="home-poster__slide" data-index="{{index}}" bindtap="onPosterTap">
        <video
          wx:if="{{item.isVideo}}"
          class="home-poster__img"
          src="{{item.imageUrl}}"
          autoplay
          muted
          loop
          show-center-play-btn="{{false}}"
          show-play-btn="{{false}}"
          controls="{{false}}"
          object-fit="cover"
        />
        <image wx:else class="home-poster__img" src="{{item.imageUrl}}" mode="aspectFill" />
        <text wx:if="{{item.title}}" class="home-poster__title">{{item.title}}</text>
      </view>
    </swiper-item>
  </swiper>

  <text class="home-feed-title">常用入口</text>
  <view class="home-entry">
    <view
      wx:for="{{entries}}"
      wx:key="id"
      class="home-entry__card"
      data-id="{{item.id}}"
      bindtap="onEntryTap"
    >
      <image class="home-entry__img" src="{{item.imageUrl}}" mode="aspectFill" />
      <text class="home-entry__title">{{item.title}}</text>
    </view>
  </view>
  <site-icp-footer />
</scroll-view>
