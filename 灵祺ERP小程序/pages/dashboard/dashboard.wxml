<scroll-view scroll-y class="dash-page-v2" enhanced show-scrollbar="{{false}}">
  <view class="dash-head">
    <view class="dash-head-icon">
      <image class="dash-hero-ic" src="{{heroIconSrc}}" mode="aspectFit" />
    </view>
    <view>
      <text class="dash-title">经营概览</text>
      <text class="dash-sub">商家经营数据</text>
    </view>
  </view>

  <view class="dash-range-row">
    <text
      wx:for="{{rangeTabs}}"
      wx:key="id"
      class="dash-range {{range === item.id ? 'on' : ''}}"
      data-id="{{item.id}}"
      bindtap="onRangeTap"
    >{{item.label}}</text>
  </view>

  <view class="dash-kpi-grid">
    <view wx:for="{{kpis}}" wx:key="label" class="dash-kpi-card">
      <view class="dash-kpi-top">
        <text class="dash-kpi-label">{{item.label}}</text>
        <view class="dash-kpi-ibox">
          <image class="dash-kpi-ic" src="{{item.iconSrc}}" mode="aspectFit" />
        </view>
      </view>
      <text class="dash-kpi-value">{{item.value}}</text>
      <text wx:if="{{item.delta}}" class="dash-kpi-delta {{item.deltaUp ? 'up' : ''}}">{{item.delta}} ▲</text>
    </view>
  </view>

  <view class="dash-chart-card">
    <view class="dash-chart-head">
      <text class="dash-chart-title">{{chartTitle}}</text>
    </view>
    <view wx:if="{{chartEmpty}}" class="dash-chart-ph">
      <text>{{chartHint || '暂无数据'}}</text>
    </view>
    <view wx:else class="dash-chart-wrap">
      <view class="dash-chart-bars">
        <view wx:for="{{chartBars}}" wx:key="label" class="dash-bar-col">
          <text class="dash-bar-tip">{{item.tip}}</text>
          <view class="dash-bar-track">
            <view class="dash-bar-fill" style="height: {{item.pct}}%;"></view>
          </view>
          <text class="dash-bar-lab">{{item.label}}</text>
        </view>
      </view>
      <text wx:if="{{chartHint}}" class="dash-chart-hint">{{chartHint}}</text>
    </view>
  </view>

  <view class="dash-chart-card dash-yday">
    <view class="dash-chart-head">
      <text class="dash-chart-title">{{ydayTitle}}</text>
      <text class="dash-yday-btn {{ydayLoading ? 'is-off' : ''}}" bindtap="onManualYesterdayAnalysis">{{ydayLoading ? '分析中' : '手动分析'}}</text>
    </view>
    <text wx:if="{{ydayDate}}" class="dash-yday-date">{{ydayDate}} · 每天 10:00 自动分析</text>
    <text class="dash-yday-hint">{{ydayHint}}</text>
    <view wx:if="{{ydayLoading}}" class="dash-yday-empty">正在生成昨日分析…</view>
    <view wx:elif="{{ydayEmpty}}" class="dash-yday-empty">{{ydayEmpty}}</view>
    <view wx:else>
      <view wx:for="{{ydaySections}}" wx:key="id" class="dash-yday-sec">
        <text wx:if="{{item.title}}" class="dash-yday-sec-title">{{item.title}}</text>
        <text class="dash-yday-sec-body" user-select>{{item.body}}</text>
      </view>
    </view>
  </view>

  <view wx:if="{{loading}}" class="dash-loading">加载中…</view>
</scroll-view>
