<view class="shop-eval-page">
  <view class="source-note">
    <view class="source-line">
      <text class="source-k">数据来源</text>
      <text class="source-v">商家填写的店名、地址、分类，以及已绑定的门店资料；评估时联网检索公开主页、套餐和评价。</text>
    </view>
    <view class="source-line">
      <text class="source-k">分析方式</text>
      <text class="source-v">按六个维度打分。公开页面里有的用检索结果，没有的按同城同品类门店预估。</text>
    </view>
  </view>
  <view class="plats">
    <view
      wx:for="{{platforms}}"
      wx:key="id"
      class="plat {{platformId === item.id ? 'plat--on' : ''}}"
      data-id="{{item.id}}"
      bindtap="onPlatform"
    >
      <image class="plat-logo" src="{{item.icon}}" mode="aspectFit" style="width:56rpx;height:56rpx;" />
      <text class="plat-name">{{item.name}}</text>
    </view>
  </view>

  <view class="card form" wx:if="{{!binding && boundCount < 1}}">
    <text class="advice-title">免费评估</text>
    <text class="form-label">门店名称</text>
    <input class="form-input" placeholder="输入门店或品牌名称" value="{{formName}}" bindinput="onFormName" />
    <text class="form-label">地址</text>
    <picker mode="region" bindchange="onRegion" value="{{region}}">
      <view class="form-input">{{regionText || '选择省市区'}}</view>
    </picker>
    <input class="form-input" placeholder="详细地址，如道路、门牌、商场楼层" value="{{detailAddress}}" bindinput="onDetail" />
    <text class="form-label">分类</text>
    <view class="form-row">
      <picker class="form-pick" mode="selector" range="{{cat1List}}" value="{{cat1Index}}" bindchange="onCat1">
        <view class="form-input">{{cat1List[cat1Index] || '一级分类'}}</view>
      </picker>
      <picker class="form-pick" mode="selector" range="{{cat2List}}" value="{{cat2Index}}" bindchange="onCat2">
        <view class="form-input">{{cat2List[cat2Index] || '二级分类'}}</view>
      </picker>
    </view>
  </view>

  <view class="card form-note" wx:if="{{boundCount >= 2}}">
    <view class="focus-row">
      <view class="focus-btn {{scopeLabel.indexOf('总品牌') === 0 ? 'focus-btn--on' : ''}}" bindtap="onChooseBrand">总品牌 · {{boundCount}}家</view>
      <view class="focus-btn {{scopeLabel === '单门店' ? 'focus-btn--on' : ''}}" bindtap="onOpenStorePick">筛选门店</view>
    </view>
    <text class="focus-hint">绑定后默认按总品牌。点「筛选门店」改为其中 1 家，分析提升跟着当前选择走。</text>
  </view>

  <view class="eval-top">
    <view class="eval-left">
      <view class="card ident">
        <view class="avatar">{{avatarLetter}}</view>
        <text class="nick">{{formName || storeName || '填写门店名称'}}</text>
        <text class="scope">{{scopeLabel}}</text>
        <text class="did">{{platformName}}</text>
        <text class="did" wx:if="{{basis}}">{{basis}}</text>
        <text class="did" wx:elif="{{boundCount >= 1}}">已使用绑定门店的资料</text>
        <text class="did" wx:else>填写名称、省市区、详细地址和分类后即可免费评估</text>
      </view>
    </view>
    <view class="eval-right">
      <view class="card hero">
        <view class="hero-score">
          <text class="score {{scorePop ? 'score--pop' : ''}} {{evaluating ? 'score--wait' : ''}}">{{displayScore}}</text>
          <text class="hero-total">/100</text>
        </view>
        <text class="label">{{evalTitle}}</text>
        <view class="grade" wx:if="{{showGrade}}">
          <text class="grade-label">{{gradeLabel}}</text>
          <text class="grade-note">{{gradeNote}}</text>
        </view>
        <view class="levels" wx:if="{{scoreReady}}">
          <text class="level">{{levelA}} {{searchLevel}}</text>
          <text class="level">{{levelB}} {{verifyLevel}}</text>
        </view>
        <view class="btn-main {{!canEval || evaluating || advising ? 'btn--off' : ''}}" bindtap="onEvaluate">
          {{evaluating ? '评估中…' : (quotaRemaining === 0 ? (quotaPaid ? '本月次数已用完' : '升级后每月 30 次') : (scoreReady ? '重新评估' : (quotaPaid ? '评估 · 剩' + quotaRemaining + '次' : '免费评估')))}}
        </view>
      </view>
    </view>
  </view>

  <view class="card radar-card" wx:if="{{evaluating || indicators.length}}">
    <text class="radar-title">{{formName || storeName || '门店'}} 6维评估（{{displayScore}}/100）</text>
    <text class="radar-sub">{{scopeLabel}} · 公网六维</text>
    <canvas type="2d" id="shopRadar" class="radar-canvas"></canvas>
  </view>

  <view class="card report" wx:if="{{positioning}}">
    <text class="advice-title">定位</text>
    <text class="report-text">{{positioning}}</text>
    <text class="report-summary" wx:if="{{summary}}">{{summary}}</text>
    <text class="report-note" wx:if="{{disclaimer}}">{{disclaimer}}</text>
  </view>
  <view class="card report" wx:else>
    <text class="need">完成评估后，这里显示公开渠道上的定位和综合判断</text>
  </view>

  <view class="card score-table" wx:if="{{scoreReady && indicators.length}}">
    <view class="score-head">
      <text>指标</text>
      <text>得分</text>
      <text>点评</text>
    </view>
    <view class="score-row" wx:for="{{indicators}}" wx:key="name">
      <text class="score-name">{{item.name}}</text>
      <view class="score-num">
        <text class="score-val">{{item.score}}<text class="score-max">/{{item.weight}}</text></text>
        <view class="metric-bar"><view class="metric-fill" style="width: {{item.pct}}%;"></view></view>
      </view>
      <text class="score-comment">{{item.comment}}</text>
    </view>
  </view>

  <view class="card report" wx:if="{{highlights.length}}">
    <text class="advice-title">优势亮点</text>
    <view class="report-line" wx:for="{{highlights}}" wx:key="*this">
      <text class="report-no">{{index + 1}}.</text>
      <text class="report-text">{{item}}</text>
    </view>
  </view>
  <view class="card report report--gap" wx:if="{{gaps.length}}">
    <text class="advice-title advice-title--plan">核心短板</text>
    <view class="report-line" wx:for="{{gaps}}" wx:key="*this">
      <text class="report-no">{{index + 1}}.</text>
      <text class="report-text">{{item}}</text>
    </view>
  </view>
  <view class="card report" wx:if="{{sources.length}}">
    <text class="advice-title">公开来源</text>
    <text class="source-chip" wx:for="{{sources}}" wx:key="*this">{{item}}</text>
  </view>

  <view class="card gains" wx:if="{{showGains}}">
    <view class="gain-row">
      <view class="gain">
        <text class="gain-k">预计提升曝光</text>
        <view class="gain-metric">
          <view class="gain-arrow"></view>
          <text class="gain-v">{{exposureText}}</text>
        </view>
      </view>
      <view class="gain">
        <text class="gain-k">预计提升核销额</text>
        <view class="gain-metric">
          <view class="gain-arrow"></view>
          <text class="gain-v">{{salesText}}</text>
        </view>
      </view>
    </view>
  </view>
  <view class="card gains" wx:else>
    <text class="need">完成评估后，这里显示预计提升的曝光和核销额</text>
  </view>

  <view class="btn-sub {{!scoreReady || evaluating || advising ? 'btn--off' : ''}}" bindtap="onAdvise">
    {{advising ? '分析提升中…' : '分析提升 · 5积分'}}
  </view>
  <text class="need">首次评估免费。升级会员后每月可评估 30 次。生成分析提升每次 5 积分，并需先绑定门店账号。</text>
  <text class="err" wx:if="{{err}}">{{err}}</text>
  <text class="need" wx:if="{{!canEval}}">{{boundCount >= 1 ? '请先选择总品牌或一家门店' : '请填写门店名称、省市区、详细地址和分类'}}</text>
  <text class="need" wx:elif="{{!scoreReady}}">请先完成门店评估</text>

  <view class="card advice advice--plan" wx:if="{{adviceReady}}">
    <text class="advice-title advice-title--plan">分析与提升方案</text>
    <view class="plan" wx:for="{{sections}}" wx:key="name">
      <view class="plan-head">
        <text class="plan-no">{{index < 9 ? '0' + (index + 1) : index + 1}}</text>
        <text class="plan-name">{{item.name}}</text>
        <text class="plan-mod" wx:if="{{item.module}}">{{item.module}}</text>
      </view>
      <view class="plan-block plan-block--find" wx:if="{{item.finding}}">
        <text class="plan-tag">短板</text>
        <text class="plan-text">{{item.finding}}</text>
      </view>
      <view class="plan-block plan-block--adjust" wx:if="{{item.adjust}}">
        <text class="plan-tag">系统里怎么做</text>
        <text class="plan-text">{{item.adjust}}</text>
      </view>
      <view class="plan-block plan-block--soon" wx:if="{{item.soon}}">
        <text class="plan-tag">近期要做</text>
        <text class="plan-text">{{item.soon}}</text>
      </view>
    </view>
  </view>

  <view class="card advice" wx:if="{{showGrade}}">
    <text class="advice-title">评级释义</text>
    <view class="plate-grid">
      <view class="plate {{gradeKey === item.key ? 'plate--on' : ''}}" wx:for="{{grades}}" wx:key="key">
        <text class="plate-no">{{item.range}}</text>
        <view class="plate-body">
          <text class="plate-name">{{item.label}}</text>
          <text class="plate-line">{{item.note}}</text>
        </view>
      </view>
    </view>
  </view>
  <view class="chooser-mask" wx:if="{{chooser}}" catchtouchmove="true">
    <view class="chooser-sheet" catchtap="true">
      <block wx:if="{{chooser === 'mode'}}">
        <text class="chooser-title">这个账号绑定了 {{boundCount}} 家门店</text>
        <text class="chooser-sub">选择这次评估的范围。分析提升会按同样的范围来写。</text>
        <view class="chooser-btn chooser-btn--main" bindtap="onChooseBrand">按总品牌分析</view>
        <view class="chooser-btn" bindtap="onOpenStorePick">分析单门店</view>
        <view class="chooser-cancel" bindtap="onCloseChooser">取消</view>
      </block>
      <block wx:else>
        <view class="chooser-head">
          <text class="chooser-title">选择 1 家门店</text>
          <view class="chooser-close" hover-class="chooser-close--on" bindtap="onBackChooser">关闭</view>
        </view>
        <input class="form-input" placeholder="按店名或地址筛选" value="{{storeQuery}}" bindinput="onStoreQuery" />
        <scroll-view class="chooser-list" scroll-y>
          <view class="chooser-store" wx:for="{{filteredStores}}" wx:key="id" data-id="{{item.id}}" bindtap="onPickStore">
            <text class="chooser-store-name">{{item.name}}</text>
            <text class="chooser-store-addr" wx:if="{{item.address}}">{{item.address}}</text>
          </view>
          <text class="chooser-empty" wx:if="{{!filteredStores.length}}">没有匹配的门店</text>
        </scroll-view>
        <view class="chooser-cancel" bindtap="onBackChooser">关闭</view>
      </block>
    </view>
  </view>

  <view class="up-mask" wx:if="{{upgradeOpen}}" bindtap="closeUpgrade" catchtouchmove="preventMove">
    <view class="up-card" catchtap="preventMove">
      <text class="up-kicker">开通后可看</text>
      <text class="up-title">看你这家店的改法</text>
      <text class="up-lead">数十位本地生活操盘手带过店的做法，写成你这家店这周能照着改的提升方案。</text>
      <text class="up-sub">对着刚才的评估说短板，不讲空的行业套话。</text>
      <view class="up-actions">
        <view class="up-btn up-btn--ghost" bindtap="closeUpgrade">
          <view class="up-btn-shine"></view>
          <text class="up-btn-tx">先看看</text>
        </view>
        <view class="up-btn up-btn--go" bindtap="goUpgrade">
          <view class="up-btn-shine"></view>
          <text class="up-btn-tx">去开通</text>
        </view>
      </view>
    </view>
  </view>

  <site-icp-footer />
</view>
