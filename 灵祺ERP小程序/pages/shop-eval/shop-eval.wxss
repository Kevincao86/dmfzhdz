.form-label {
  display: block;
  margin-top: 16rpx;
  font-size: 24rpx;
  color: #64748b;
}

.form-input {
  margin-top: 8rpx;
  padding: 18rpx 20rpx;
  border-radius: 16rpx;
  background: #f8fafc;
  font-size: 28rpx;
  color: #1e3a5f;
}

.form-row {
  display: flex;
  gap: 16rpx;
}

.form-pick {
  flex: 1;
}

.form-note {
  margin-top: 16rpx;
  padding: 20rpx 24rpx;
  font-size: 24rpx;
  line-height: 1.6;
  color: #475569;
}

.focus-row {
  display: flex;
  gap: 16rpx;
}

.focus-btn {
  flex: 1;
  padding: 16rpx 12rpx;
  border-radius: 999rpx;
  text-align: center;
  font-size: 26rpx;
  font-weight: 700;
  color: #334155;
  background: #f1f5f9;
}

.focus-btn--on {
  color: #fff;
  background: #1e3a5f;
}

.focus-hint {
  display: block;
  margin-top: 12rpx;
  font-size: 22rpx;
  line-height: 1.5;
  color: #64748b;
}

.chooser-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 40;
  display: flex;
  align-items: flex-end;
  background: rgba(15, 23, 42, 0.4);
}

.chooser-sheet {
  width: 100%;
  max-height: 78vh;
  padding: 32rpx 28rpx calc(28rpx + env(safe-area-inset-bottom));
  border-radius: 28rpx 28rpx 0 0;
  background: #fff;
  box-sizing: border-box;
}

.chooser-title {
  display: block;
  font-size: 34rpx;
  font-weight: 700;
  color: #1e3a5f;
}

.chooser-sub {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  line-height: 1.5;
  color: #64748b;
}

.chooser-btn {
  margin-top: 20rpx;
  padding: 22rpx 16rpx;
  border-radius: 16rpx;
  text-align: center;
  font-size: 28rpx;
  font-weight: 700;
  color: #1e3a5f;
  background: #f1f5f9;
}

.chooser-btn--main {
  color: #fff;
  background: #1e3a5f;
}

.chooser-cancel {
  margin-top: 16rpx;
  text-align: center;
  font-size: 26rpx;
  color: #94a3b8;
}

.chooser-list {
  max-height: 52vh;
  margin-top: 16rpx;
}

.chooser-store {
  padding: 20rpx 8rpx;
  border-bottom: 1rpx solid #e2e8f0;
}

.chooser-store-name {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: #1e3a5f;
}

.chooser-store-addr {
  display: block;
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #64748b;
}

.chooser-empty {
  display: block;
  padding: 40rpx 0;
  text-align: center;
  font-size: 26rpx;
  color: #94a3b8;
}

.shop-eval-page {
  min-height: 100vh;
  padding: 16rpx 24rpx calc(24rpx + var(--tab-bar-pad));
  box-sizing: border-box;
  background: #e8edf2;
}

.plats {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  justify-content: space-between;
  padding: 4rpx 0 8rpx;
}

.plat {
  display: flex;
  flex-direction: row;
  align-items: center;
  width: 340rpx;
  height: 88rpx;
  margin-bottom: 16rpx;
  padding: 0 24rpx 0 12rpx;
  border-radius: 44rpx;
  background: #fff;
  border: 2rpx solid #d5e3ee;
  box-sizing: border-box;
}

.plat-logo {
  width: 56rpx;
  height: 56rpx;
  border-radius: 16rpx;
  background: #fff;
  flex-shrink: 0;
}

.plat-name {
  margin-left: 12rpx;
  font-size: 30rpx;
  line-height: 42rpx;
  color: #334155;
  white-space: nowrap;
  flex-shrink: 0;
}

.plat--on {
  background: #1e3a5f;
  border-color: #1e3a5f;
}

.plat--on .plat-name {
  color: #fff;
  font-weight: 700;
}

.plat--off {
  background: #eef2f6;
  border-color: #e2e8f0;
}

.plat--off .plat-name {
  color: #94a3b8;
}

.plat--off .plat-logo {
  opacity: 0.35;
}

.report {
  margin-top: 16rpx;
}

.report-text {
  display: block;
  margin-top: 8rpx;
  font-size: 26rpx;
  line-height: 40rpx;
  color: #334155;
}

.report-summary {
  display: block;
  margin-top: 16rpx;
  font-size: 28rpx;
  line-height: 42rpx;
  font-weight: 700;
  color: #1e3a5f;
}

.report-line {
  display: flex;
  margin-top: 12rpx;
}

.report-no {
  width: 36rpx;
  flex-shrink: 0;
  font-size: 26rpx;
  font-weight: 700;
  color: #3d5270;
}

.metric {
  margin-top: 20rpx;
  padding-top: 16rpx;
  border-top: 2rpx solid #e2e8f0;
}

.metric-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.metric-name {
  font-size: 28rpx;
  font-weight: 700;
  color: #1e3a5f;
}

.metric-score {
  font-size: 34rpx;
  font-weight: 800;
  color: #3d5270;
}

.metric-bar {
  height: 10rpx;
  margin-top: 10rpx;
  border-radius: 999rpx;
  background: #e2e8f0;
  overflow: hidden;
}

.metric-fill {
  height: 10rpx;
  border-radius: 999rpx;
  background: #3d5270;
}

.metric-comment {
  display: block;
  margin-top: 10rpx;
  font-size: 24rpx;
  line-height: 38rpx;
  color: #475569;
}

.source-chip {
  display: block;
  margin-top: 10rpx;
  font-size: 22rpx;
  line-height: 34rpx;
  color: #64748b;
}

.eval-top {
  display: flex;
  align-items: stretch;
  gap: 16rpx;
}

.eval-left,
.eval-right {
  min-width: 0;
}

.eval-left {
  width: 46%;
  flex-shrink: 0;
}

.eval-right {
  flex: 1;
}

.card {
  background: #fff;
  border-radius: 28rpx;
  padding: 28rpx 24rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 10rpx 36rpx rgba(15, 23, 42, 0.05);
}

.ident {
  height: 100%;
  text-align: left;
  box-sizing: border-box;
}

.avatar {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  margin-bottom: 16rpx;
  background: #1e3a5f;
  color: #fff;
  font-size: 36rpx;
  font-weight: 800;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  line-height: 1;
}

.nick {
  display: block;
  font-size: 32rpx;
  font-weight: 800;
  color: #1e3a5f;
}

.scope {
  display: inline-flex;
  margin-top: 10rpx;
  padding: 4rpx 12rpx;
  border-radius: 999rpx;
  background: #eef2f6;
  color: #0e7490;
  font-size: 20rpx;
  font-weight: 700;
}

.did,
.need {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  line-height: 1.5;
  color: #64748b;
}

.hero {
  text-align: center;
}

.ring-stage {
  position: relative;
  width: 200rpx;
  height: 200rpx;
  margin: 0 auto 12rpx;
}

.ring-scan {
  position: absolute;
  z-index: 3;
  left: -10rpx;
  top: -10rpx;
  width: 220rpx;
  height: 220rpx;
  border-radius: 50%;
  border: 8rpx solid rgba(30, 58, 95, 0.16);
  border-top-color: #1e3a5f;
  animation: eval-spin 0.75s linear infinite;
  box-sizing: border-box;
}

.ring {
  width: 200rpx;
  height: 200rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.ring--wait {
  animation: ring-wait 1.1s ease-in-out infinite;
}

.ring--pop {
  animation: ring-pop 0.55s cubic-bezier(0.2, 1.35, 0.36, 1);
}

.ring-hole {
  width: 148rpx;
  height: 148rpx;
  border-radius: 50%;
  background: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
}

.score {
  font-size: 56rpx;
  font-weight: 800;
  color: #0e7490;
  line-height: 1;
}

.score--wait {
  animation: score-wait 0.9s ease-in-out infinite;
}

.score--pop {
  animation: score-pop 0.55s cubic-bezier(0.2, 1.35, 0.36, 1);
}

.label {
  display: block;
  font-size: 22rpx;
  font-weight: 700;
  color: #1e3a5f;
}

.grade-label {
  display: block;
  margin-top: 8rpx;
  font-size: 30rpx;
  font-weight: 800;
  color: #0e7490;
}

.grade-note,
.level {
  display: block;
  margin-top: 4rpx;
  font-size: 20rpx;
  color: #64748b;
}

.btn-main,
.btn-sub {
  margin-top: 16rpx;
  padding: 16rpx 12rpx;
  border-radius: 16rpx;
  text-align: center;
  font-size: 24rpx;
  font-weight: 700;
  color: #fff;
  background: #1e3a5f;
}

.btn-sub {
  background: #c2410c;
  margin: 0 0 12rpx;
}

.btn--off {
  opacity: 0.4;
}

.gains {
  text-align: left;
}

.gain-row {
  display: flex;
  gap: 16rpx;
}

.gain {
  flex: 1;
  min-width: 0;
}

.gain-k {
  display: block;
  font-size: 22rpx;
  color: #64748b;
}

.gain-metric {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-top: 12rpx;
}

.gain-arrow {
  width: 0;
  height: 0;
  border-left: 14rpx solid transparent;
  border-right: 14rpx solid transparent;
  border-bottom: 22rpx solid #1e3a5f;
  animation: arrow-rise 1.05s ease-in-out infinite;
}

.gain-v {
  font-size: 48rpx;
  font-weight: 800;
  color: #0e7490;
  line-height: 1.05;
  animation: gain-float 2.6s ease-in-out infinite;
}

.err {
  display: block;
  margin: 8rpx 0;
  color: #b91c1c;
  font-size: 24rpx;
  text-align: center;
}

.advice--now {
  background: #f4f7fb;
  box-shadow: inset 0 0 0 2rpx #d5dde6;
}

.advice-title {
  display: block;
  font-size: 28rpx;
  font-weight: 800;
  color: #1e3a5f;
  margin-bottom: 12rpx;
}

.advice-title--now {
  color: #3d5270;
}

.advice--plan {
  background: #e8edf2;
  box-shadow: inset 0 0 0 2rpx #fb923c;
}

.advice-title--plan {
  color: #c2410c;
}

.plate-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.plate {
  width: calc(50% - 6rpx);
  box-sizing: border-box;
  display: flex;
  gap: 12rpx;
  padding: 18rpx;
  border-radius: 20rpx;
  background: #f8fafc;
  text-align: left;
}

.plate--now {
  background: #eef2f6;
}

.plate--on {
  background: #eef2f6;
  box-shadow: inset 0 0 0 2rpx #1e3a5f;
}

.plate-no {
  font-size: 22rpx;
  font-weight: 800;
  color: #1e3a5f;
}

.plate-name {
  display: block;
  font-size: 26rpx;
  font-weight: 700;
  color: #1e3a5f;
}

.plate-line {
  display: block;
  margin-top: 6rpx;
  font-size: 22rpx;
  line-height: 1.55;
  color: #475569;
}

.plan {
  margin-top: 16rpx;
  padding: 20rpx;
  border-radius: 20rpx;
  background: #fff;
}

.plan-head {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.plan-no {
  font-size: 24rpx;
  font-weight: 800;
  color: #c2410c;
}

.plan-name {
  font-size: 30rpx;
  font-weight: 700;
}

.plan-block {
  margin-top: 14rpx;
  padding: 16rpx;
  border-radius: 16rpx;
}

.plan-block--find {
  background: #eef2f6;
}

.plan-block--adjust {
  background: #f3e8ff;
}

.plan-block--soon {
  background: #eef2f6;
}

.plan-tag {
  display: inline-block;
  margin-bottom: 8rpx;
  padding: 2rpx 12rpx;
  border-radius: 999rpx;
  font-size: 20rpx;
  font-weight: 700;
}

.plan-block--find .plan-tag {
  color: #3d5270;
  background: #d5dde6;
}

.plan-block--adjust .plan-tag {
  color: #1e3a5f;
  background: #e9d5ff;
}

.plan-block--soon .plan-tag {
  color: #c2410c;
  background: #d5dde6;
}

.plan-text {
  display: block;
  font-size: 26rpx;
  line-height: 1.65;
  color: #1e293b;
}

@keyframes eval-spin {
  to { transform: rotate(360deg); }
}
@keyframes ring-wait {
  0%, 100% { transform: scale(1); }
  50% { transform: scale(1.04); }
}
@keyframes score-wait {
  0%, 100% { opacity: 0.35; }
  50% { opacity: 1; }
}
@keyframes ring-pop {
  0% { transform: scale(0.92); }
  55% { transform: scale(1.04); }
  100% { transform: scale(1); }
}
@keyframes score-pop {
  0% { transform: scale(0.72); opacity: 0.4; }
  60% { transform: scale(1.12); opacity: 1; }
  100% { transform: scale(1); }
}
@keyframes gain-float {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-8rpx); }
}
@keyframes arrow-rise {
  0%, 100% { transform: translateY(6rpx); opacity: 0.55; }
  50% { transform: translateY(-10rpx); opacity: 1; }
}
