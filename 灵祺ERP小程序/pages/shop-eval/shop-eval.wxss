.form-label {
  display: block;
  margin-top: 16rpx;
  font-size: 24rpx;
  color: #64748b;
}

.form-input {
  margin-top: 8rpx;
  padding: 18rpx 20rpx;
  border-radius: 16rpx;
  background: #f8fafc;
  font-size: 28rpx;
  color: #1e3a5f;
}

.form-row {
  display: flex;
  gap: 16rpx;
}

.form-pick {
  flex: 1;
}

.form-note {
  margin-top: 16rpx;
  padding: 20rpx 24rpx;
  font-size: 24rpx;
  line-height: 1.6;
  color: #475569;
}

.focus-row {
  display: flex;
  gap: 16rpx;
}

.focus-btn {
  flex: 1;
  padding: 16rpx 12rpx;
  border-radius: 999rpx;
  text-align: center;
  font-size: 26rpx;
  font-weight: 700;
  color: #334155;
  background: #f1f5f9;
}

.focus-btn--on {
  color: #fff;
  background: #2f6fed;
}

.focus-hint {
  display: block;
  margin-top: 12rpx;
  font-size: 22rpx;
  line-height: 1.5;
  color: #64748b;
}

.chooser-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 9100;
  display: flex;
  align-items: flex-end;
  background: rgba(15, 23, 42, 0.4);
}

.chooser-sheet {
  width: 100%;
  max-height: 78vh;
  padding: 32rpx 28rpx calc(28rpx + env(safe-area-inset-bottom));
  border-radius: 28rpx 28rpx 0 0;
  background: #fff;
  box-sizing: border-box;
}

.chooser-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.chooser-title {
  display: block;
  flex: 1;
  min-width: 0;
  font-size: 34rpx;
  font-weight: 700;
  color: #1e3a5f;
}

.chooser-close {
  flex-shrink: 0;
  min-width: 120rpx;
  height: 88rpx;
  padding: 0 28rpx;
  border-radius: 999rpx;
  background: #f1f5f9;
  text-align: center;
  line-height: 88rpx;
  font-size: 28rpx;
  font-weight: 700;
  color: #1e3a5f;
}

.chooser-close--on {
  background: #e2e8f0;
}

.chooser-sub {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  line-height: 1.5;
  color: #64748b;
}

.chooser-btn {
  margin-top: 20rpx;
  padding: 22rpx 16rpx;
  border-radius: 16rpx;
  text-align: center;
  font-size: 28rpx;
  font-weight: 700;
  color: #1e3a5f;
  background: #f1f5f9;
}

.chooser-btn--main {
  color: #fff;
  background: #2f6fed;
}

.chooser-cancel {
  margin-top: 16rpx;
  text-align: center;
  font-size: 26rpx;
  color: #94a3b8;
}

.chooser-list {
  max-height: 52vh;
  margin-top: 16rpx;
}

.chooser-store {
  padding: 20rpx 8rpx;
  border-bottom: 1rpx solid #e2e8f0;
}

.chooser-store-name {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: #1e3a5f;
}

.chooser-store-addr {
  display: block;
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #64748b;
}

.chooser-empty {
  display: block;
  padding: 40rpx 0;
  text-align: center;
  font-size: 26rpx;
  color: #94a3b8;
}

.shop-eval-page {
  min-height: 100vh;
  padding: 16rpx 24rpx calc(24rpx + var(--tab-bar-pad));
  box-sizing: border-box;
  background: #f4f8fc;
}

.source-note {
  margin: 16rpx 0 0;
  padding: 20rpx 22rpx;
  background: #fff;
  border-radius: 20rpx;
  border-left: 6rpx solid #4f46e5;
}

.source-line {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
}

.source-line + .source-line {
  margin-top: 10rpx;
}

.source-k {
  flex-shrink: 0;
  font-size: 24rpx;
  font-weight: 700;
  color: #4338ca;
  line-height: 1.5;
}

.source-v {
  flex: 1;
  font-size: 24rpx;
  color: #64748b;
  line-height: 1.5;
}

.plats {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  justify-content: space-between;
  padding: 4rpx 0 8rpx;
}

.plat {
  display: flex;
  flex-direction: row;
  align-items: center;
  width: 340rpx;
  height: 88rpx;
  margin-bottom: 16rpx;
  padding: 0 24rpx 0 12rpx;
  border-radius: 44rpx;
  background: #fff;
  border: 2rpx solid #d5e3ee;
  box-sizing: border-box;
}

.plat-logo {
  width: 56rpx;
  height: 56rpx;
  border-radius: 16rpx;
  background: #fff;
  flex-shrink: 0;
}

.plat-name {
  margin-left: 12rpx;
  font-size: 30rpx;
  line-height: 42rpx;
  color: #334155;
  white-space: nowrap;
  flex-shrink: 0;
}

.plat--on {
  background: #2f6fed;
  border-color: #2f6fed;
}

.plat--on .plat-name {
  color: #fff;
  font-weight: 700;
}

.plat--off {
  background: #eef2f6;
  border-color: #e2e8f0;
}

.plat--off .plat-name {
  color: #94a3b8;
}

.plat--off .plat-logo {
  opacity: 0.35;
}

.report {
  margin-top: 16rpx;
}

.report-text {
  display: block;
  margin-top: 8rpx;
  font-size: 26rpx;
  line-height: 40rpx;
  color: #334155;
}

.report-summary {
  display: block;
  margin-top: 16rpx;
  font-size: 28rpx;
  line-height: 42rpx;
  font-weight: 700;
  color: #1e3a5f;
}

.report-note {
  display: block;
  margin-top: 16rpx;
  font-size: 22rpx;
  line-height: 34rpx;
  color: #64748b;
}

.report-line {
  display: flex;
  margin-top: 12rpx;
}

.report-no {
  width: 36rpx;
  flex-shrink: 0;
  font-size: 26rpx;
  font-weight: 700;
  color: #3d5270;
}

.metric {
  margin-top: 20rpx;
  padding-top: 16rpx;
  border-top: 2rpx solid #e2e8f0;
}

.metric-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.metric-name {
  font-size: 28rpx;
  font-weight: 700;
  color: #1e3a5f;
}

.metric-score {
  font-size: 34rpx;
  font-weight: 800;
  color: #3d5270;
}

.metric-bar {
  height: 10rpx;
  margin-top: 10rpx;
  border-radius: 999rpx;
  background: #e2e8f0;
  overflow: hidden;
}

.metric-fill {
  height: 10rpx;
  border-radius: 999rpx;
  background: #3d5270;
}

.metric-comment {
  display: block;
  margin-top: 10rpx;
  font-size: 24rpx;
  line-height: 38rpx;
  color: #475569;
}

.source-chip {
  display: block;
  margin-top: 10rpx;
  font-size: 22rpx;
  line-height: 34rpx;
  color: #64748b;
}

.eval-top {
  display: flex;
  align-items: stretch;
  gap: 16rpx;
}

.eval-left,
.eval-right {
  min-width: 0;
}

.eval-left {
  width: 46%;
  flex-shrink: 0;
}

.eval-right {
  flex: 1;
}

.card {
  background: #fff;
  border-radius: 28rpx;
  padding: 28rpx 24rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 10rpx 36rpx rgba(15, 23, 42, 0.05);
}

.ident {
  height: 100%;
  text-align: left;
  box-sizing: border-box;
}

.avatar {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  margin-bottom: 16rpx;
  background: #2f6fed;
  color: #fff;
  font-size: 36rpx;
  font-weight: 800;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  line-height: 1;
}

.nick {
  display: block;
  font-size: 32rpx;
  font-weight: 800;
  color: #1e3a5f;
}

.scope {
  display: inline-flex;
  margin-top: 10rpx;
  padding: 4rpx 12rpx;
  border-radius: 999rpx;
  background: #eef2f6;
  color: #0e7490;
  font-size: 20rpx;
  font-weight: 700;
}

.did,
.need {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  line-height: 1.5;
  color: #64748b;
}

.hero {
  text-align: center;
}

.hero-score {
  display: flex;
  align-items: flex-end;
  justify-content: center;
  gap: 4rpx;
  min-height: 72rpx;
}

.hero-total {
  margin-bottom: 8rpx;
  font-size: 22rpx;
  font-weight: 700;
  color: #94a3b8;
}

.radar-card {
  text-align: center;
}

.radar-title {
  display: block;
  font-size: 30rpx;
  font-weight: 700;
  color: #1a1b1c;
}

.radar-sub {
  display: block;
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #6b7280;
}

.radar-canvas {
  width: 100%;
  height: 640rpx;
  margin-top: 8rpx;
}

.ring-stage {
  position: relative;
  width: 200rpx;
  height: 200rpx;
  margin: 0 auto 12rpx;
}

.ring-scan {
  position: absolute;
  z-index: 3;
  left: -10rpx;
  top: -10rpx;
  width: 220rpx;
  height: 220rpx;
  border-radius: 50%;
  border: 8rpx solid rgba(30, 58, 95, 0.16);
  border-top-color: #1e3a5f;
  animation: eval-spin 0.75s linear infinite;
  box-sizing: border-box;
}

.ring {
  width: 200rpx;
  height: 200rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.ring--wait {
  animation: ring-wait 1.1s ease-in-out infinite;
}

.ring--pop {
  animation: ring-pop 0.55s cubic-bezier(0.2, 1.35, 0.36, 1);
}

.ring-hole {
  width: 148rpx;
  height: 148rpx;
  border-radius: 50%;
  background: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
}

.score {
  font-size: 56rpx;
  font-weight: 800;
  color: #0e7490;
  line-height: 1;
}

.score--wait {
  animation: score-wait 0.9s ease-in-out infinite;
}

.score--pop {
  animation: score-pop 0.55s cubic-bezier(0.2, 1.35, 0.36, 1);
}

.label {
  display: block;
  font-size: 22rpx;
  font-weight: 700;
  color: #1e3a5f;
}

.grade-label {
  display: block;
  margin-top: 8rpx;
  font-size: 30rpx;
  font-weight: 800;
  color: #0e7490;
}

.grade-note,
.level {
  display: block;
  margin-top: 4rpx;
  font-size: 20rpx;
  color: #64748b;
}

.btn-main,
.btn-sub {
  margin-top: 16rpx;
  padding: 16rpx 12rpx;
  border-radius: 16rpx;
  text-align: center;
  font-size: 24rpx;
  font-weight: 700;
  color: #fff;
  background: #2f6fed;
}

.btn-sub {
  background: #c2410c;
  margin: 0 0 12rpx;
}

.btn--off {
  opacity: 0.4;
}

.gains {
  text-align: left;
}

.gain-row {
  display: flex;
  gap: 16rpx;
}

.gain {
  flex: 1;
  min-width: 0;
}

.gain-k {
  display: block;
  font-size: 22rpx;
  color: #64748b;
}

.gain-metric {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-top: 12rpx;
}

.gain-arrow {
  width: 0;
  height: 0;
  border-left: 14rpx solid transparent;
  border-right: 14rpx solid transparent;
  border-bottom: 22rpx solid #1e3a5f;
  animation: arrow-rise 1.05s ease-in-out infinite;
}

.gain-v {
  font-size: 48rpx;
  font-weight: 800;
  color: #0e7490;
  line-height: 1.05;
  animation: gain-float 2.6s ease-in-out infinite;
}

.err {
  display: block;
  margin: 8rpx 0;
  color: #b91c1c;
  font-size: 24rpx;
  text-align: center;
}

.advice--now {
  background: #f4f7fb;
  box-shadow: inset 0 0 0 2rpx #d5dde6;
}

.advice-title {
  display: block;
  font-size: 28rpx;
  font-weight: 800;
  color: #1e3a5f;
  margin-bottom: 12rpx;
}

.advice-title--now {
  color: #3d5270;
}

.advice--plan {
  background: #f4f8fc;
  box-shadow: inset 0 0 0 2rpx #fb923c;
}

.advice-title--plan {
  color: #c2410c;
}

.plate-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.plate {
  width: calc(50% - 6rpx);
  box-sizing: border-box;
  display: flex;
  gap: 12rpx;
  padding: 18rpx;
  border-radius: 20rpx;
  background: #f8fafc;
  text-align: left;
}

.plate--now {
  background: #eef2f6;
}

.plate--on {
  background: #eef2f6;
  box-shadow: inset 0 0 0 2rpx #1e3a5f;
}

.plate-no {
  font-size: 22rpx;
  font-weight: 800;
  color: #1e3a5f;
}

.plate-name {
  display: block;
  font-size: 26rpx;
  font-weight: 700;
  color: #1e3a5f;
}

.plate-line {
  display: block;
  margin-top: 6rpx;
  font-size: 22rpx;
  line-height: 1.55;
  color: #475569;
}

.plan {
  margin-top: 16rpx;
  padding: 20rpx;
  border-radius: 20rpx;
  background: #fff;
}

.plan-head {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.plan-no {
  font-size: 24rpx;
  font-weight: 800;
  color: #c2410c;
}

.plan-name {
  font-size: 30rpx;
  font-weight: 700;
}

.plan-block {
  margin-top: 14rpx;
  padding: 16rpx;
  border-radius: 16rpx;
}

.plan-block--find {
  background: #e8f1ff;
}

.plan-block--adjust {
  background: #f3e8ff;
}

.plan-block--soon {
  background: #ffedd5;
}

.plan-tag {
  display: inline-block;
  margin-bottom: 8rpx;
  padding: 2rpx 12rpx;
  border-radius: 999rpx;
  font-size: 20rpx;
  font-weight: 700;
}

.plan-block--find .plan-tag {
  color: #1d4ed8;
  background: #dbeafe;
}

.plan-block--adjust .plan-tag {
  color: #6d28d9;
  background: #e9d5ff;
}

.plan-block--soon .plan-tag {
  color: #c2410c;
  background: #fed7aa;
}

.plan-mod {
  margin-left: auto;
  padding: 2rpx 14rpx;
  border-radius: 999rpx;
  background: #fff7ed;
  color: #c2410c;
  font-size: 20rpx;
  font-weight: 700;
}

.score-table {
  padding: 0;
  overflow: hidden;
}

.score-head,
.score-row {
  display: grid;
  grid-template-columns: 1.35fr 0.7fr 1.15fr;
  gap: 12rpx;
  align-items: start;
  padding: 18rpx 20rpx;
}

.score-head {
  background: #1e3a5f;
  color: #fff;
  font-size: 22rpx;
  font-weight: 700;
}

.score-row {
  border-top: 2rpx solid #f1f5f9;
}

.score-name,
.score-comment {
  font-size: 24rpx;
  line-height: 1.55;
  color: #334155;
}

.score-name {
  font-weight: 700;
  color: #0f172a;
}

.score-val {
  font-size: 32rpx;
  font-weight: 800;
  color: #1e3a5f;
}

.score-max {
  font-size: 22rpx;
  font-weight: 600;
  color: #94a3b8;
}

.plan-text {
  display: block;
  font-size: 26rpx;
  line-height: 1.65;
  color: #1e293b;
}

@keyframes eval-spin {
  to { transform: rotate(360deg); }
}
@keyframes ring-wait {
  0%, 100% { transform: scale(1); }
  50% { transform: scale(1.04); }
}
@keyframes score-wait {
  0%, 100% { opacity: 0.35; }
  50% { opacity: 1; }
}
@keyframes ring-pop {
  0% { transform: scale(0.92); }
  55% { transform: scale(1.04); }
  100% { transform: scale(1); }
}
@keyframes score-pop {
  0% { transform: scale(0.72); opacity: 0.4; }
  60% { transform: scale(1.12); opacity: 1; }
  100% { transform: scale(1); }
}
@keyframes gain-float {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-8rpx); }
}
@keyframes arrow-rise {
  0%, 100% { transform: translateY(6rpx); opacity: 0.55; }
  50% { transform: translateY(-10rpx); opacity: 1; }
}
.up-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 80;
  background: rgba(48, 36, 78, 0.42);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 48rpx;
  box-sizing: border-box;
}
.up-card {
  width: 100%;
  background: linear-gradient(165deg, #6d5798 0%, #564484 58%, #4c3c78 100%);
  border-radius: 32rpx;
  padding: 40rpx 36rpx 32rpx;
  box-shadow: 0 28rpx 70rpx rgba(40, 24, 80, 0.32);
}
.up-kicker {
  display: block;
  font-size: 22rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
  color: #ead9a4;
}
.up-title {
  display: block;
  margin-top: 12rpx;
  font-size: 40rpx;
  font-weight: 700;
  color: #f4e4bc;
  line-height: 1.35;
}
.up-lead {
  display: block;
  margin-top: 20rpx;
  font-size: 28rpx;
  line-height: 1.65;
  color: rgba(247, 243, 234, 0.94);
}
.up-sub {
  display: block;
  margin-top: 12rpx;
  font-size: 24rpx;
  line-height: 1.6;
  color: rgba(247, 243, 234, 0.74);
}
.up-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 32rpx;
}
.up-btn {
  position: relative;
  flex: 1;
  height: 88rpx;
  border-radius: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  box-sizing: border-box;
}
.up-btn-tx {
  position: relative;
  z-index: 1;
  font-size: 28rpx;
  font-weight: 700;
}
.up-btn-shine {
  position: absolute;
  top: 0;
  bottom: 0;
  width: 42%;
  z-index: 0;
  pointer-events: none;
}
.up-btn--ghost {
  background: rgba(42, 30, 72, 0.28);
  border: 2rpx solid rgba(244, 228, 188, 0.72);
  animation: up-ghost-breathe 2.4s ease-in-out infinite;
}
.up-btn--ghost .up-btn-shine {
  background: linear-gradient(100deg, rgba(244, 228, 188, 0) 0%, rgba(244, 228, 188, 0.42) 50%, rgba(244, 228, 188, 0) 100%);
  animation: up-btn-shine 3.2s ease-in-out infinite;
}
.up-btn--ghost .up-btn-tx { color: #f4e4bc; }
.up-btn--go {
  border: 2rpx solid transparent;
  background-image: linear-gradient(90deg, #7c5cff, #b08cff, #8d6bff, #7c5cff);
  background-size: 220% 100%;
  animation: up-go-flow 2.6s linear infinite, up-go-breathe 1.8s ease-in-out infinite;
}
.up-btn--go .up-btn-tx { color: #fff; }
.up-btn--go .up-btn-shine {
  background: linear-gradient(100deg, rgba(255, 255, 255, 0) 0%, rgba(255, 255, 255, 0.55) 50%, rgba(255, 255, 255, 0) 100%);
  animation: up-btn-shine 2.2s ease-in-out infinite;
}
@keyframes up-btn-shine {
  0% { transform: translateX(-240%) skewX(-16deg); }
  42%, 100% { transform: translateX(340%) skewX(-16deg); }
}
@keyframes up-go-flow {
  0% { background-position: 0% 50%; }
  100% { background-position: 220% 50%; }
}
@keyframes up-go-breathe {
  0%, 100% {
    transform: scale(1);
    box-shadow: 0 8rpx 18rpx rgba(124, 92, 255, 0.28);
  }
  50% {
    transform: scale(1.045);
    box-shadow: 0 14rpx 32rpx rgba(176, 148, 255, 0.62);
  }
}
@keyframes up-ghost-breathe {
  0%, 100% {
    border-color: rgba(244, 228, 188, 0.5);
    box-shadow: 0 0 0 rgba(244, 228, 188, 0);
  }
  50% {
    border-color: rgba(244, 228, 188, 1);
    box-shadow: 0 0 22rpx rgba(244, 228, 188, 0.38);
  }
}
