.shop-eval-page {
  min-height: 100vh;
  padding: 16rpx 24rpx calc(24rpx + var(--tab-bar-pad));
  box-sizing: border-box;
  background: linear-gradient(180deg, #e8f4fc 0%, #f8fafc 280rpx, #f8fafc 100%);
}

.plats {
  padding: 8rpx 0 4rpx;
  font-size: 0;
  line-height: 0;
}

.plat {
  display: inline-block;
  margin: 0 16rpx 16rpx 0;
  padding: 10rpx 24rpx 10rpx 10rpx;
  border-radius: 999rpx;
  background: #fff;
  border: 2rpx solid #e2e8f0;
  vertical-align: middle;
  white-space: nowrap;
  font-size: 0;
  line-height: 0;
  box-sizing: border-box;
  overflow: hidden;
}

.plat-logo {
  display: inline-block;
  width: 52rpx;
  height: 52rpx;
  margin-right: 12rpx;
  border-radius: 12rpx;
  background: #fff;
  vertical-align: middle;
}

.plat-name {
  display: inline-block;
  height: 52rpx;
  line-height: 52rpx;
  font-size: 28rpx;
  color: #64748b;
  vertical-align: middle;
  white-space: nowrap;
}

.plat--on {
  background: #0891b2;
  border-color: #0891b2;
}

.plat--on .plat-name {
  color: #fff;
  font-weight: 700;
}

.eval-top {
  display: flex;
  align-items: stretch;
  gap: 16rpx;
}

.eval-left,
.eval-right {
  min-width: 0;
}

.eval-left {
  width: 46%;
  flex-shrink: 0;
}

.eval-right {
  flex: 1;
}

.card {
  background: #fff;
  border-radius: 28rpx;
  padding: 28rpx 24rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 10rpx 36rpx rgba(15, 23, 42, 0.05);
}

.ident {
  height: 100%;
  text-align: left;
  box-sizing: border-box;
}

.avatar {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  margin-bottom: 16rpx;
  background: #0891b2;
  color: #fff;
  font-size: 36rpx;
  font-weight: 800;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  line-height: 1;
}

.nick {
  display: block;
  font-size: 32rpx;
  font-weight: 800;
  color: #0f172a;
}

.scope {
  display: inline-flex;
  margin-top: 10rpx;
  padding: 4rpx 12rpx;
  border-radius: 999rpx;
  background: #e0f2fe;
  color: #0e7490;
  font-size: 20rpx;
  font-weight: 700;
}

.did,
.need {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  line-height: 1.5;
  color: #64748b;
}

.hero {
  text-align: center;
}

.ring-stage {
  position: relative;
  width: 200rpx;
  height: 200rpx;
  margin: 0 auto 12rpx;
}

.ring-scan {
  position: absolute;
  z-index: 3;
  left: -10rpx;
  top: -10rpx;
  width: 220rpx;
  height: 220rpx;
  border-radius: 50%;
  border: 8rpx solid rgba(8, 145, 178, 0.16);
  border-top-color: #0891b2;
  animation: eval-spin 0.75s linear infinite;
  box-sizing: border-box;
}

.ring {
  width: 200rpx;
  height: 200rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.ring--wait {
  animation: ring-wait 1.1s ease-in-out infinite;
}

.ring--pop {
  animation: ring-pop 0.55s cubic-bezier(0.2, 1.35, 0.36, 1);
}

.ring-hole {
  width: 148rpx;
  height: 148rpx;
  border-radius: 50%;
  background: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
}

.score {
  font-size: 56rpx;
  font-weight: 800;
  color: #0e7490;
  line-height: 1;
}

.score--wait {
  animation: score-wait 0.9s ease-in-out infinite;
}

.score--pop {
  animation: score-pop 0.55s cubic-bezier(0.2, 1.35, 0.36, 1);
}

.label {
  display: block;
  font-size: 22rpx;
  font-weight: 700;
  color: #0f172a;
}

.grade-label {
  display: block;
  margin-top: 8rpx;
  font-size: 30rpx;
  font-weight: 800;
  color: #0e7490;
}

.grade-note,
.level {
  display: block;
  margin-top: 4rpx;
  font-size: 20rpx;
  color: #64748b;
}

.btn-main,
.btn-sub {
  margin-top: 16rpx;
  padding: 16rpx 12rpx;
  border-radius: 16rpx;
  text-align: center;
  font-size: 24rpx;
  font-weight: 700;
  color: #fff;
  background: #0891b2;
}

.btn-sub {
  background: #c2410c;
  margin: 0 0 12rpx;
}

.btn--off {
  opacity: 0.4;
}

.gains {
  text-align: left;
}

.gain-row {
  display: flex;
  gap: 16rpx;
}

.gain {
  flex: 1;
  min-width: 0;
}

.gain-k {
  display: block;
  font-size: 22rpx;
  color: #64748b;
}

.gain-metric {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-top: 12rpx;
}

.gain-arrow {
  width: 0;
  height: 0;
  border-left: 14rpx solid transparent;
  border-right: 14rpx solid transparent;
  border-bottom: 22rpx solid #0891b2;
  animation: arrow-rise 1.05s ease-in-out infinite;
}

.gain-v {
  font-size: 48rpx;
  font-weight: 800;
  color: #0e7490;
  line-height: 1.05;
  animation: gain-float 2.6s ease-in-out infinite;
}

.err {
  display: block;
  margin: 8rpx 0;
  color: #b91c1c;
  font-size: 24rpx;
  text-align: center;
}

.advice--now {
  background: #f0f9ff;
  box-shadow: inset 0 0 0 2rpx #7dd3fc;
}

.advice-title {
  display: block;
  font-size: 28rpx;
  font-weight: 800;
  color: #0f172a;
  margin-bottom: 12rpx;
}

.advice-title--now {
  color: #0369a1;
}

.advice--plan {
  background: #fff7ed;
  box-shadow: inset 0 0 0 2rpx #fb923c;
}

.advice-title--plan {
  color: #c2410c;
}

.plate-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.plate {
  width: calc(50% - 6rpx);
  box-sizing: border-box;
  display: flex;
  gap: 12rpx;
  padding: 18rpx;
  border-radius: 20rpx;
  background: #f8fafc;
  text-align: left;
}

.plate--now {
  background: #e0f2fe;
}

.plate--on {
  background: #e0f2fe;
  box-shadow: inset 0 0 0 2rpx #0891b2;
}

.plate-no {
  font-size: 22rpx;
  font-weight: 800;
  color: #0891b2;
}

.plate-name {
  display: block;
  font-size: 26rpx;
  font-weight: 700;
  color: #0f172a;
}

.plate-line {
  display: block;
  margin-top: 6rpx;
  font-size: 22rpx;
  line-height: 1.55;
  color: #475569;
}

.plan {
  margin-top: 16rpx;
  padding: 20rpx;
  border-radius: 20rpx;
  background: #fff;
}

.plan-head {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.plan-no {
  font-size: 24rpx;
  font-weight: 800;
  color: #c2410c;
}

.plan-name {
  font-size: 30rpx;
  font-weight: 700;
}

.plan-block {
  margin-top: 14rpx;
  padding: 16rpx;
  border-radius: 16rpx;
}

.plan-block--find {
  background: #e0f2fe;
}

.plan-block--adjust {
  background: #f3e8ff;
}

.plan-block--soon {
  background: #ffedd5;
}

.plan-tag {
  display: inline-block;
  margin-bottom: 8rpx;
  padding: 2rpx 12rpx;
  border-radius: 999rpx;
  font-size: 20rpx;
  font-weight: 700;
}

.plan-block--find .plan-tag {
  color: #0369a1;
  background: #bae6fd;
}

.plan-block--adjust .plan-tag {
  color: #6d28d9;
  background: #e9d5ff;
}

.plan-block--soon .plan-tag {
  color: #c2410c;
  background: #fed7aa;
}

.plan-text {
  display: block;
  font-size: 26rpx;
  line-height: 1.65;
  color: #1e293b;
}

@keyframes eval-spin {
  to { transform: rotate(360deg); }
}
@keyframes ring-wait {
  0%, 100% { transform: scale(1); }
  50% { transform: scale(1.04); }
}
@keyframes score-wait {
  0%, 100% { opacity: 0.35; }
  50% { opacity: 1; }
}
@keyframes ring-pop {
  0% { transform: scale(0.92); }
  55% { transform: scale(1.04); }
  100% { transform: scale(1); }
}
@keyframes score-pop {
  0% { transform: scale(0.72); opacity: 0.4; }
  60% { transform: scale(1.12); opacity: 1; }
  100% { transform: scale(1); }
}
@keyframes gain-float {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-8rpx); }
}
@keyframes arrow-rise {
  0%, 100% { transform: translateY(6rpx); opacity: 0.55; }
  50% { transform: translateY(-10rpx); opacity: 1; }
}
