<scroll-view scroll-y class="op-page" enhanced show-scrollbar="{{false}}">
  <view class="op-hero">
    <text class="op-title">AI 短剧</text>
    <text class="op-sub">和电脑端同一套：场景、故事、角色（可保存、可按参考图二选一）、再出片。分四步，每步只做一件事。</text>
    <text class="op-meta">{{rateLabel}}</text>
  </view>

  <view class="op-steps">
    <text class="op-step {{dramaStep === 1 ? 'on' : ''}}" data-step="1" bindtap="onDramaStep">1 场景</text>
    <text class="op-step {{dramaStep === 2 ? 'on' : ''}}" data-step="2" bindtap="onDramaStep">2 故事</text>
    <text class="op-step {{dramaStep === 3 ? 'on' : ''}}" data-step="3" bindtap="onDramaStep">3 角色</text>
    <text class="op-step {{dramaStep === 4 ? 'on' : ''}}" data-step="4" bindtap="onDramaStep">4 出片</text>
  </view>

  <view class="op-card" wx:if="{{dramaStep === 1}}">
    <text class="op-label">世界观</text>
    <view class="op-chips">
      <text
        wx:for="{{worlds}}"
        wx:key="id"
        class="op-chip {{item.on ? 'on' : ''}}"
        data-id="{{item.id}}"
        bindtap="onWorld"
      >{{item.label}}</text>
    </view>
    <text class="op-body muted">{{worldBlurb}}</text>
    <text class="op-label">场景</text>
    <view class="op-chips">
      <text
        wx:for="{{scenes}}"
        wx:key="id"
        class="op-chip {{item.on ? 'on' : ''}}"
        data-id="{{item.id}}"
        bindtap="onScene"
      >{{item.name}}</text>
    </view>
    <text class="op-body muted">钩子：{{sceneHook}}</text>
    <block wx:if="{{sceneId === 'custom_scene'}}">
      <text class="op-label">场景名称</text>
      <input class="op-input" placeholder="例如：深夜档口收摊" value="{{customSceneName}}" bindinput="onCustomSceneName" />
      <text class="op-label">开场钩子</text>
      <input class="op-input" placeholder="这一场前三秒怎么抓住人" value="{{customSceneHook}}" bindinput="onCustomSceneHook" />
      <text class="op-label">画面里必须出现</text>
      <input class="op-input" placeholder="例如：卷帘门、剩汤、路灯" value="{{customSceneMustSee}}" bindinput="onCustomSceneMust" />
    </block>
    <button class="op-btn" bindtap="onDramaNext">下一步：写故事</button>
  </view>

  <view class="op-card" wx:elif="{{dramaStep === 2}}">
    <text class="op-label">成片时长</text>
    <picker mode="selector" range="{{durationOptions}}" range-key="label" value="{{durationIdx}}" bindchange="onDuration">
      <view class="op-picker">{{durationOptions[durationIdx].label}}</view>
    </picker>
    <text class="op-meta">{{durationHint}}</text>
    <text class="op-label">画风</text>
    <view class="op-chips">
      <text wx:for="{{styles}}" wx:key="id" class="op-chip {{item.on ? 'on' : ''}}" data-id="{{item.id}}" bindtap="onStyle">{{item.name}}</text>
    </view>
    <text class="op-label">清晰度</text>
    <view class="op-chips">
      <text wx:for="{{qualities}}" wx:key="id" class="op-chip {{item.on ? 'on' : ''}}" data-id="{{item.id}}" bindtap="onQuality">{{item.label}}</text>
    </view>
    <block wx:for="{{fields}}" wx:key="key">
      <text class="op-label">{{item.label}}</text>
      <input class="op-input" data-key="{{item.key}}" placeholder="{{item.placeholder}}" value="{{item.value}}" bindinput="onField" />
    </block>
    <text class="op-label">一句话故事</text>
    <text class="op-body muted">先选时长。8～15 秒写一个钩子，30 秒起按时间轴把剧情写满。</text>
    <textarea class="op-area" maxlength="2000" placeholder="先选时长，再点 AI生成故事" value="{{story}}" bindinput="onStory" />
    <button class="op-btn-ghost" loading="{{storyBusy}}" bindtap="onAiStory">{{storyBusy ? '正在写故事' : 'AI生成故事'}}</button>
    <view class="op-pair">
      <button class="op-btn-ghost" bindtap="onDramaPrev">上一步</button>
      <button class="op-btn" bindtap="onDramaNext">下一步：角色</button>
    </view>
  </view>

  <view class="op-card" wx:elif="{{dramaStep === 3}}">
    <text class="op-label">角色形象</text>
    <text class="op-body muted">每位角色二选一：写文字形象，或上传参考图。上传后还要再选：按图美化生成，或识别成文字。不能两路一起用。</text>
    <view class="op-row">
      <button class="op-btn-ghost" bindtap="onToggleCastLibrary">选用已存{{castPacks.length ? ' ' + castPacks.length : ''}}</button>
      <button class="op-btn-ghost" bindtap="onToggleCastSave">保存角色</button>
      <button class="op-btn-ghost" bindtap="onAddCast">新建角色</button>
    </view>

    <view wx:if="{{showCastSave}}" class="op-box">
      <text class="op-body">保存当前全部角色，下次做续集可直接载入。</text>
      <input class="op-input" placeholder="角色组名称，如小柔 / 男顾客" value="{{castPackName}}" bindinput="onCastPackName" />
      <button class="op-btn" bindtap="onSaveCastPack">确认保存</button>
    </view>

    <view wx:if="{{showCastLibrary}}" class="op-box">
      <text wx:if="{{!castPacks.length}}" class="op-body muted">还没有已存角色组。确认形象后点「保存角色」。</text>
      <view wx:for="{{castPacks}}" wx:key="id" class="op-pack">
        <text class="op-body">{{item.name}} · {{item.members.length}} 人</text>
        <button class="op-btn" data-id="{{item.id}}" bindtap="onLoadCastPack">载入</button>
        <button class="op-btn-ghost" data-id="{{item.id}}" bindtap="onDeleteCastPack">删除</button>
      </view>
    </view>

    <view wx:for="{{cast}}" wx:key="id" class="op-cast-card">
      <view class="op-row">
        <input class="op-input grow" data-id="{{item.id}}" placeholder="角色名" value="{{item.name}}" bindinput="onCastName" />
        <button class="op-btn-ghost" data-id="{{item.id}}" bindtap="onRemoveCast">删除</button>
      </view>
      <button
        wx:if="{{!item.sourceDataUrl}}"
        class="op-btn-ghost"
        loading="{{portraitBusyId === item.id}}"
        disabled="{{portraitBusyId === item.id}}"
        data-id="{{item.id}}"
        bindtap="onEnrichCast"
      >{{portraitBusyId === item.id ? '正在补充画像' : 'AI补充画像'}}</button>
      <textarea
        class="op-area"
        maxlength="300"
        data-id="{{item.id}}"
        disabled="{{item.sourceDataUrl ? true : false}}"
        placeholder="{{item.sourceDataUrl ? '已选用参考图，文字已锁定。若要改文字，请先去掉参考图。' : '形象词：年龄、发型发色、衣着。写完后点生成预览。'}}"
        value="{{item.desc}}"
        bindinput="onCastDesc"
      />
      <button wx:if="{{item.sourceDataUrl}}" class="op-btn-ghost" data-id="{{item.id}}" bindtap="onClearCastPhoto">改用文字描述（去掉参考图）</button>
      <button wx:elif="{{item.desc}}" class="op-btn-ghost" data-id="{{item.id}}" bindtap="onClearCastText">改用参考图（清空文字）</button>
      <button wx:if="{{!item.sourceDataUrl}}" class="op-btn-ghost" loading="{{castBusyId === item.id}}" data-id="{{item.id}}" bindtap="onGenCast">生成预览</button>
      <button class="op-btn-ghost" data-id="{{item.id}}" bindtap="onPickCastPhoto">上传参考图</button>

      <view wx:if="{{item.sourceDataUrl}}" class="op-box">
        <text class="op-label">参考图用法（二选一）</text>
        <view class="op-chips">
          <text class="op-chip {{item.refMode === 'beautify' ? 'on' : ''}}" data-id="{{item.id}}" data-mode="beautify" bindtap="onCastRefMode">按图美化</text>
          <text class="op-chip {{item.refMode === 'describe' ? 'on' : ''}}" data-id="{{item.id}}" data-mode="describe" bindtap="onCastRefMode">识别成文字</text>
        </view>
        <text class="op-body muted">按图美化：成片锁这张脸。识别成文字：填完后不再用原图锁脸。</text>
        <button class="op-btn" loading="{{castBusyId === item.id}}" data-id="{{item.id}}" bindtap="onApplyCastRef">
          {{item.refMode === 'describe' ? '识别并填入文案' : item.refMode === 'beautify' ? '按图美化生成' : '请先选一种用法'}}
        </button>
      </view>

      <view wx:if="{{item.previewPath || item.sourcePath}}" class="op-cast">
        <image class="op-cast-img" src="{{item.previewPath || item.sourcePath}}" mode="aspectFill" data-id="{{item.id}}" bindtap="onPreviewCast" />
        <text class="op-meta">{{item.confirmed ? '角色形象 · 已确认' : '角色形象 · 待确认'}}</text>
        <button class="op-btn-ghost" data-id="{{item.id}}" bindtap="onConfirmCast">{{item.confirmed ? '已确认角色' : '用此图确认角色'}}</button>
      </view>
    </view>

    <view class="op-pair">
      <button class="op-btn-ghost" bindtap="onDramaPrev">上一步</button>
      <button class="op-btn" bindtap="onDramaNext">下一步：出片</button>
    </view>
  </view>

  <view class="op-card" wx:elif="{{dramaStep === 4}}">
    <text class="op-label">参考画面（可不传，最多 3 张）</text>
    <text class="op-body muted">传了则按这些画面的背景出片；不传则按故事匹配场景。角色脸用上一步已确认的图。</text>
    <button class="op-btn-ghost" bindtap="onPickRefs">上传参考图</button>
    <button wx:if="{{refPaths.length}}" class="op-btn-ghost" bindtap="clearRefs">去掉参考图</button>
    <view wx:if="{{refPaths.length}}" class="op-chips">
      <image wx:for="{{refPaths}}" wx:key="*this" src="{{item}}" mode="aspectFill" style="width:140rpx;height:140rpx;border-radius:12rpx" />
    </view>
    <text class="op-label">对白钩子（选填）</text>
    <input class="op-input" placeholder="一句口语对白" value="{{dialogue}}" bindinput="onDialogue" />
    <text class="op-meta" wx:if="{{durationSec}}">成片时长：{{durationOptions[durationIdx].label}} · {{styleName}} · {{qualityLabel}}</text>
    <button class="op-btn" loading="{{busy}}" disabled="{{busy}}" bindtap="onGenerate">
      {{busy ? (progress || '生成中') : '生成短剧'}}
    </button>
    <button wx:if="{{busy}}" class="op-btn-ghost" bindtap="cancelWait">停止等待</button>
    <text wx:if="{{pointsHint}}" class="op-meta">{{pointsHint}}</text>
    <button class="op-btn-ghost" bindtap="onDramaPrev">上一步</button>
  </view>

  <view wx:if="{{err}}" class="op-err">{{err}}</view>
  <view wx:if="{{hint}}" class="op-card"><text class="op-body">{{hint}}</text></view>

  <view wx:if="{{resultUrl}}" class="op-card">
    <text class="op-card-title">成片预览</text>
    <video src="{{resultUrl}}" controls object-fit="contain" style="width:100%;height:520rpx;background:#1e3a5f" />
    <button class="op-btn" bindtap="saveAlbum">保存到相册</button>
    <button class="op-btn-ghost" bindtap="copyResult">复制链接</button>
  </view>
</scroll-view>
<site-icp-footer />
