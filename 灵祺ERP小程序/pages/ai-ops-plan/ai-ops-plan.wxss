.op-page {
  min-height: 100vh;
  background: #e8edf2;
  padding-bottom: 48rpx;
}

.op-hero {
  margin: 16rpx 24rpx;
  padding: 28rpx 24rpx;
  border-radius: 28rpx;
  background: linear-gradient(160deg, #f4f7fb 0%, #eef2f6 45%, #fff 100%);
}

.op-title {
  display: block;
  font-size: 40rpx;
  font-weight: 800;
  color: #1e3a5f;
}

.op-sub {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #64748b;
  line-height: 1.5;
}

.op-card {
  margin: 0 24rpx 16rpx;
  padding: 22rpx;
  background: #fff;
  border-radius: 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(15, 23, 42, 0.04);
}

.op-label {
  display: block;
  font-size: 22rpx;
  color: #64748b;
  margin: 10rpx 0 6rpx;
}

.op-chips {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.op-chip {
  padding: 10rpx 22rpx;
  border-radius: 999rpx;
  background: #f1f5f9;
  font-size: 24rpx;
  color: #475569;
}

.op-chip.on {
  background: #1e3a5f;
  color: #fff;
}

.op-input {
  width: 100%;
  box-sizing: border-box;
  height: 88rpx;
  line-height: normal;
  padding: 0 24rpx;
  background: #f8fafc;
  border-radius: 16rpx;
  font-size: 28rpx;
  color: #1e3a5f;
}

.op-picker {
  height: 88rpx;
  line-height: normal;
  display: flex;
  align-items: center;
  padding: 0 24rpx;
  background: #f8fafc;
  border-radius: 16rpx;
  font-size: 28rpx;
  color: #1e3a5f;
  box-sizing: border-box;
}

.op-area {
  width: 100%;
  min-height: 160rpx;
  box-sizing: border-box;
  padding: 20rpx 24rpx;
  line-height: 1.5;
  background: #f8fafc;
  border-radius: 16rpx;
  font-size: 28rpx;
  color: #1e3a5f;
}

.op-btn {
  margin-top: 20rpx;
  background: #1e3a5f !important;
  color: #fff !important;
  border-radius: 999rpx !important;
  font-size: 28rpx !important;
}

.op-meta {
  display: block;
  margin-top: 12rpx;
  font-size: 22rpx;
  color: #64748b;
}

.op-err {
  margin: 0 24rpx 16rpx;
  color: #dc2626;
  font-size: 26rpx;
}

.op-card-title {
  display: block;
  font-size: 28rpx;
  font-weight: 700;
  color: #1e3a5f;
  margin-bottom: 12rpx;
}

.op-body {
  display: block;
  font-size: 26rpx;
  color: #334155;
  line-height: 1.6;
  white-space: pre-wrap;
  margin-bottom: 8rpx;
}

.op-body.muted {
  color: #64748b;
  font-size: 24rpx;
}

.op-li {
  padding: 6rpx 0;
  font-size: 26rpx;
  color: #334155;
  line-height: 1.5;
}
