<scroll-view scroll-y class="sm-page" enhanced show-scrollbar="{{false}}">
  <view class="sm-hero">
    <text class="sm-title">菜单价目表</text>
    <text class="sm-sub">与电脑端同源。拍照识别或上传 Excel，保存后门店经营分析可引用。</text>
  </view>

  <view class="sm-card">
    <view class="sm-name-row">
      <view class="sm-name-field">
        <text class="sm-label">门店名称</text>
        <input class="sm-input" value="{{storeName}}" placeholder="选填，如：旗舰店" bindinput="onStoreName" />
      </view>
      <button class="sm-btn save-name" size="mini" loading="{{busy}}" bindtap="onSaveStoreName">保存</button>
    </view>
    <text wx:if="{{updatedAt}}" class="sm-meta">更新 {{updatedAt}}</text>
  </view>

  <view class="sm-card">
    <view class="sm-card-head">
      <text class="sm-card-title">价目（{{items.length}}）</text>
      <button class="sm-btn" size="mini" bindtap="onAdd">新增</button>
    </view>
    <view class="sm-tools">
      <view class="sm-tool" bindtap="onSyncCloud">
        <text class="sm-tool-t">云端同步</text>
      </view>
      <view class="sm-tool" bindtap="onPhoto">
        <text class="sm-tool-t">拍照识别</text>
      </view>
      <view class="sm-tool" bindtap="onExcel">
        <text class="sm-tool-t">Excel</text>
      </view>
    </view>
    <view wx:if="{{!items.length}}" class="sm-empty">暂无价目，可新增、拍照或从云端同步</view>
    <view wx:for="{{items}}" wx:key="index" class="sm-item">
      <view class="sm-item-main" data-idx="{{index}}" bindtap="onEdit">
        <text wx:if="{{item.category}}" class="sm-cat">{{item.category}}</text>
        <text class="sm-item-name">{{item.name}}</text>
      </view>
      <text class="sm-item-price">¥{{item.priceYuan}}</text>
      <text class="sm-del" data-idx="{{index}}" bindtap="onDelete">删除</text>
    </view>
  </view>
</scroll-view>

<view wx:if="{{editing}}" class="sm-mask" catchtouchmove="noop">
  <view class="sm-sheet">
    <text class="sm-sheet-title">{{editIndex >= 0 ? '编辑价目' : '新增价目'}}</text>
    <input class="sm-input" placeholder="名称" value="{{formName}}" bindinput="onFormName" />
    <input class="sm-input" type="digit" placeholder="价格（元）" value="{{formPrice}}" bindinput="onFormPrice" />
    <input class="sm-input" placeholder="分类（选填）" value="{{formCategory}}" bindinput="onFormCategory" />
    <view class="sm-row-btns">
      <button class="sm-btn ghost" bindtap="onCancelEdit">取消</button>
      <button class="sm-btn primary" bindtap="onSaveItem">保存</button>
    </view>
  </view>
</view>
