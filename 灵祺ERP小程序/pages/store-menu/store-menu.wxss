.sm-page {
  min-height: 100vh;
  background: linear-gradient(180deg, #e8f4fc 0%, #f8fafc 240rpx, #f8fafc 100%);
  padding-bottom: 48rpx;
  box-sizing: border-box;
}

.sm-hero {
  margin: 16rpx 24rpx;
  padding: 28rpx 24rpx;
  border-radius: 28rpx;
  background: linear-gradient(160deg, #ecfeff 0%, #f0fdfa 50%, #fff 100%);
}

.sm-title {
  display: block;
  font-size: 40rpx;
  font-weight: 800;
  color: #0f172a;
}

.sm-sub {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #64748b;
  line-height: 1.5;
}

.sm-card {
  margin: 0 24rpx 16rpx;
  padding: 22rpx;
  background: #fff;
  border-radius: 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(15, 23, 42, 0.04);
}

.sm-label {
  display: block;
  font-size: 22rpx;
  color: #64748b;
  margin-bottom: 8rpx;
}

.sm-input {
  width: 100%;
  box-sizing: border-box;
  padding: 16rpx 20rpx;
  margin-bottom: 12rpx;
  background: #f8fafc;
  border-radius: 16rpx;
  font-size: 28rpx;
  color: #0f172a;
}

.sm-row-btns {
  display: flex;
  gap: 16rpx;
  margin-top: 8rpx;
}

.sm-btn {
  background: #0891b2 !important;
  color: #fff !important;
  border-radius: 999rpx !important;
  font-size: 24rpx !important;
}

.sm-btn.ghost {
  background: #e2e8f0 !important;
  color: #334155 !important;
}

.sm-btn.primary {
  background: #0284c7 !important;
}

.sm-meta {
  display: block;
  margin-top: 12rpx;
  font-size: 20rpx;
  color: #94a3b8;
}

.sm-card-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.sm-card-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #0f172a;
}

.sm-empty {
  padding: 32rpx 0;
  text-align: center;
  color: #94a3b8;
  font-size: 26rpx;
}

.sm-item {
  display: flex;
  align-items: center;
  padding: 18rpx 0;
  border-top: 1rpx solid #f1f5f9;
}

.sm-item-main {
  flex: 1;
  min-width: 0;
}

.sm-item-name {
  display: block;
  font-size: 28rpx;
  color: #0f172a;
  font-weight: 600;
}

.sm-item-price {
  display: block;
  margin-top: 4rpx;
  font-size: 24rpx;
  color: #0891b2;
}

.sm-del {
  padding: 8rpx 16rpx;
  font-size: 24rpx;
  color: #dc2626;
}

.sm-mask {
  position: fixed;
  inset: 0;
  background: rgba(15, 23, 42, 0.45);
  z-index: 100;
  display: flex;
  align-items: flex-end;
}

.sm-sheet {
  width: 100%;
  padding: 32rpx 28rpx calc(32rpx + env(safe-area-inset-bottom));
  background: #fff;
  border-radius: 28rpx 28rpx 0 0;
}

.sm-sheet-title {
  display: block;
  font-size: 32rpx;
  font-weight: 700;
  margin-bottom: 20rpx;
  color: #0f172a;
}
