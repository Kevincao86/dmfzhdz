<view class="agent-page">
  <view class="agent-hero">
    <view class="agent-hero-main">
      <image class="agent-logo" src="{{logoSrc}}" mode="aspectFit" />
      <view class="agent-hero-text">
        <text class="agent-h1">灵祺助手</text>
        <text class="agent-p">与电脑端 AI 智能体同源 · 写操作需确认后再执行</text>
      </view>
    </view>
    <view class="agent-hero-actions">
      <view class="agent-chip" bindtap="onNewChat">新对话</view>
      <navigator url="/pages/shortvideo-ai/shortvideo-ai" class="agent-chip ghost" hover-class="none">短视频出片</navigator>
    </view>
  </view>

  <scroll-view
    wx:if="{{!hasChat}}"
    scroll-y
    class="agent-empty"
    enhanced
    show-scrollbar="{{false}}"
  >
    <text class="empty-title">今天要处理哪件事？</text>
    <text class="empty-sub">点快捷任务或直接输入，规则与商家后台助手一致</text>
    <view class="shortcut-fold" bindtap="onToggleShortcuts">
      <text class="shortcut-fold-t">{{shortcutsCollapsed ? '快捷任务 · 展开' : '快捷任务 · 收起'}}</text>
      <text class="shortcut-fold-n">{{shortcuts.length}}</text>
    </view>
    <view wx:if="{{!shortcutsCollapsed}}" class="shortcut-grid">
      <view
        wx:for="{{shortcuts}}"
        wx:key="type"
        class="shortcut"
        data-prompt="{{item.prompt}}"
        bindtap="onShortcut"
      >
        <text class="shortcut-t">{{item.label}}</text>
      </view>
    </view>
  </scroll-view>

  <scroll-view
    wx:else
    scroll-y
    class="agent-chat"
    scroll-into-view="{{scrollTo}}"
    enhanced
    show-scrollbar="{{false}}"
  >
    <view wx:for="{{messages}}" wx:key="id" id="msg-{{item.id}}" class="msg-row {{item.role === 'user' ? 'is-user' : ''}}">
      <image wx:if="{{item.role !== 'user'}}" class="ava" src="{{logoSrc}}" mode="aspectFit" />
      <view class="bubble {{item.role === 'user' ? 'bubble-user' : ''}} {{item.role === 'task_preview' ? 'bubble-preview' : ''}}">
        <text user-select class="bubble-text">{{item.content}}</text>
        <image
          wx:for="{{item.imageUrls || []}}"
          wx:for-item="img"
          wx:key="*this"
          class="bubble-img"
          src="{{img}}"
          mode="widthFix"
          bindtap="onPreviewBubbleImage"
          data-url="{{img}}"
        />
        <view wx:if="{{item.preview && item.preview.taskType === 'create_product' && item.preview.productPlans.length}}" class="plan-list">
          <view wx:for="{{item.preview.productPlans}}" wx:for-item="plan" wx:key="slotKey" class="plan-card">
            <text class="plan-name">{{plan.productName || plan.slotLabel}}</text>
            <text class="plan-price">{{plan.suggestedPriceYuan > 0 ? '建议 ¥' + plan.suggestedPriceYuan : '建议售价生成中'}}</text>
            <text wx:if="{{plan.description}}" class="plan-desc">{{plan.description}}</text>
            <text wx:if="{{plan.comboText}}" class="plan-desc">{{plan.comboText}}</text>
          </view>
        </view>
        <view wx:if="{{item.uploadSheets && item.uploadSheets.length && item.previewStatus === 'pending'}}" class="upload-sheets">
          <text class="upload-h">请确认后上传</text>
          <text wx:if="{{item.uploadContext.categoryName}}" class="upload-ai">AI 已补充：{{item.uploadContext.categoryName}} · {{item.uploadContext.typeLabel}} · {{item.uploadContext.storeNames}}</text>
          <text wx:elif="{{item.uploadContext.message}}" class="upload-ai">{{item.uploadContext.message}}</text>
          <view wx:for="{{item.uploadSheets}}" wx:for-item="sheet" wx:key="slotKey" class="sheet">
            <text class="plan-name">{{sheet.productName}}</text>
            <view class="field-row">
              <text class="field-lab">标价</text>
              <input class="field-inp" type="digit" value="{{sheet.form.originYuan}}" data-id="{{item.id}}" data-slot="{{sheet.slotKey}}" data-field="originYuan" bindinput="onUploadField" />
            </view>
            <view class="field-row">
              <text class="field-lab">售价</text>
              <input class="field-inp" type="digit" value="{{sheet.form.priceYuan}}" data-id="{{item.id}}" data-slot="{{sheet.slotKey}}" data-field="priceYuan" bindinput="onUploadField" />
            </view>
            <view class="field-row">
              <text class="field-lab">库存</text>
              <input class="field-inp" type="number" value="{{sheet.form.stockQty}}" data-id="{{item.id}}" data-slot="{{sheet.slotKey}}" data-field="stockQty" bindinput="onUploadField" />
            </view>
            <text class="field-lab block">组合内容（一行一项）</text>
            <textarea class="field-area" value="{{sheet.form.comboText}}" data-id="{{item.id}}" data-slot="{{sheet.slotKey}}" data-field="comboText" bindinput="onUploadField" auto-height />
            <view class="field-row">
              <text class="field-lab">售卖开始</text>
              <picker mode="date" value="{{sheet.form.saleStart}}" data-id="{{item.id}}" data-slot="{{sheet.slotKey}}" data-field="saleStart" bindchange="onUploadDate">
                <text class="field-inp picker">{{sheet.form.saleStart}}</text>
              </picker>
            </view>
            <view class="field-row">
              <text class="field-lab">售卖结束</text>
              <picker mode="date" value="{{sheet.form.saleEnd}}" data-id="{{item.id}}" data-slot="{{sheet.slotKey}}" data-field="saleEnd" bindchange="onUploadDate">
                <text class="field-inp picker">{{sheet.form.saleEnd}}</text>
              </picker>
            </view>
            <view class="field-row">
              <text class="field-lab">可用天数</text>
              <input class="field-inp" type="number" value="{{sheet.form.useDays}}" data-id="{{item.id}}" data-slot="{{sheet.slotKey}}" data-field="useDays" bindinput="onUploadField" />
            </view>
            <view class="head-row">
              <image wx:if="{{sheet.form.headLocal || sheet.form.headUrl}}" class="head-img" src="{{sheet.form.headLocal || sheet.form.headUrl}}" mode="aspectFill" />
              <view wx:else class="head-empty">主图可选</view>
              <view class="head-actions">
                <view class="mini-btn" data-id="{{item.id}}" data-slot="{{sheet.slotKey}}" bindtap="onPickProductHead">相册</view>
                <view class="mini-btn" data-id="{{item.id}}" data-slot="{{sheet.slotKey}}" data-name="{{sheet.productName}}" bindtap="onGenProductHead">AI 生成</view>
              </view>
            </view>
          </view>
        </view>
        <view wx:if="{{item.role === 'task_preview' && item.previewStatus === 'pending' && item.preview.taskType === 'create_product'}}" class="plat-row">
          <view
            wx:for="{{item.previewPlatforms}}"
            wx:for-item="plat"
            wx:key="id"
            class="plat-chip {{plat.checked ? 'on' : ''}}"
            data-id="{{item.id}}"
            data-plat="{{plat.id}}"
            catchtap="onToggleProductPlatform"
          >{{plat.label}}</view>
        </view>
        <view wx:if="{{item.role === 'task_preview' && item.previewStatus === 'pending' && item.preview.taskType === 'create_product'}}" class="preview-actions">
          <view class="btn-ghost" data-id="{{item.id}}" data-mode="draft" bindtap="onConfirmPreview">保存至草稿</view>
          <view class="btn-primary" data-id="{{item.id}}" data-mode="submit" bindtap="onConfirmPreview">提交至平台</view>
        </view>
        <view
          wx:if="{{item.role === 'task_preview' && item.preview && item.preview.taskType === 'create_product'}}"
          class="preview-link"
          data-id="{{item.id}}"
          bindtap="onOpenModule"
        >去商品列表</view>
        <view wx:if="{{item.role === 'task_preview' && item.previewStatus === 'pending' && item.preview.taskType !== 'create_product'}}" class="preview-actions">
          <view class="btn-ghost" data-id="{{item.id}}" bindtap="onOpenModule">去对应模块</view>
          <view class="btn-primary" data-id="{{item.id}}" bindtap="onConfirmPreview">确认执行</view>
        </view>
        <text wx:if="{{item.previewStatus === 'done'}}" class="preview-done">已确认</text>
      </view>
      <view wx:if="{{item.role === 'user'}}" class="ava ava-me">我</view>
    </view>
    <view wx:if="{{sending}}" id="msg-thinking" class="msg-row">
      <image class="ava" src="{{logoSrc}}" mode="aspectFit" />
      <view class="bubble">
        <text class="bubble-text muted">{{thinkingText}}</text>
      </view>
    </view>
  </scroll-view>

  <view class="wx-composer">
    <scroll-view wx:if="{{attachments.length}}" class="attach-row" scroll-x enhanced show-scrollbar="{{false}}">
      <view class="attach-chip" wx:for="{{attachments}}" wx:key="id">
        <image wx:if="{{item.preview}}" class="attach-thumb" src="{{item.preview}}" mode="aspectFill" />
        <view wx:else class="attach-file">
          <text class="attach-file-t">{{item.kind === 'video' ? '视频' : '文件'}}</text>
          <text class="attach-file-n">{{item.name}}</text>
        </view>
        <view class="attach-x" data-id="{{item.id}}" catchtap="onRemoveAttach">×</view>
      </view>
    </scroll-view>
    <view class="wx-bar">
      <view
        class="wx-icon {{voiceMode ? 'wx-icon--kb' : 'wx-icon--mic'}}"
        bindtap="onToggleVoiceMode"
      ></view>
      <input
        wx:if="{{!voiceMode}}"
        class="wx-input"
        placeholder=""
        value="{{input}}"
        disabled="{{false}}"
        bindinput="onInput"
        bindfocus="onInputFocus"
        confirm-type="send"
        bindconfirm="onSend"
        adjust-position="{{!showPlusPanel}}"
        cursor-spacing="24"
      />
      <view
        wx:else
        class="wx-hold {{recordingVoice ? 'on' : ''}}"
        bindtouchstart="onVoiceTouchStart"
        bindtouchend="onVoiceTouchEnd"
        bindtouchcancel="onVoiceTouchEnd"
      >{{recordingVoice ? '松开 结束' : '按住 说话'}}</view>
      <view
        wx:if="{{sending}}"
        class="wx-send wx-stop"
        bindtap="onStop"
      >停止</view>
      <view
        wx:elif="{{!voiceMode && !showSendBtn}}"
        class="wx-icon wx-icon--plus {{showPlusPanel ? 'on' : ''}}"
        bindtap="onTogglePlus"
      ></view>
      <view wx:elif="{{!voiceMode && showSendBtn}}" class="wx-send" bindtap="onSend">发送</view>
    </view>
    <view wx:if="{{showPlusPanel && !voiceMode}}" class="wx-plus">
      <view class="plus-grid">
        <view class="plus-item" wx:for="{{plusActions}}" wx:key="id" data-id="{{item.id}}" bindtap="onPlusAction">
          <view class="plus-item-icon plus-icon {{item.iconClass}}"></view>
          <text class="plus-item-label">{{item.label}}</text>
        </view>
      </view>
    </view>
  </view>
</view>
