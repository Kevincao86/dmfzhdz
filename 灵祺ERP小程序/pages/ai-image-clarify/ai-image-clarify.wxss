.page { padding: 24rpx; }
.card { background: #fff; border-radius: 24rpx; padding: 28rpx; }
.title { display: block; font-size: 36rpx; font-weight: 700; color: #0f172a; }
.sub { display: block; margin-top: 12rpx; font-size: 24rpx; line-height: 1.6; color: #64748b; }
.btn { margin-top: 24rpx; border-radius: 999rpx; background: #2f6fed; color: #fff; font-size: 28rpx; }
.btn--go { background: #1d4ed8; }
.btn::after { border: none; }
.pair { display: flex; gap: 16rpx; margin-top: 24rpx; }
.shot { flex: 1; min-width: 0; }
.label { display: block; margin-bottom: 8rpx; font-size: 22rpx; color: #94a3b8; }
.pic { width: 100%; height: 360rpx; background: #f8fafc; border-radius: 16rpx; }
.empty { height: 360rpx; border-radius: 16rpx; background: #f8fafc; color: #94a3b8; font-size: 24rpx; display: flex; align-items: center; justify-content: center; }
.msg { display: block; margin-top: 16rpx; font-size: 24rpx; color: #b45309; }
