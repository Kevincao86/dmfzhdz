<view class="page">
  <view class="card">
    <text class="title">图片变清晰</text>
    <text class="sub">上传照片后自动变清晰。{{imagePoints}} 积分/张。清晰后的图可点击查看大图。</text>
    <button class="btn" bindtap="onPick">选择图片</button>
    <view class="pair">
      <view class="shot">
        <text class="label">原图</text>
        <image wx:if="{{sourcePath}}" class="pic" src="{{sourcePath}}" mode="aspectFit" />
        <view wx:else class="empty">尚未选择</view>
      </view>
      <view class="shot">
        <text class="label">清晰后</text>
        <image wx:if="{{resultUrl}}" class="pic" src="{{resultUrl}}" mode="aspectFit" bindtap="onPreview" />
        <view wx:else class="empty {{busy ? 'empty--busy' : ''}}">
          <view wx:if="{{busy}}" class="scan"></view>
          <text>{{busy ? (stage || '处理中…') : '等待生成'}}</text>
        </view>
      </view>
    </view>
    <button class="btn btn--go" loading="{{busy}}" disabled="{{busy || !sourceData}}" bindtap="onClarify">开始变清晰</button>
    <text wx:if="{{choice && !busy}}" class="choice">{{choice}}</text>
    <text wx:if="{{msg}}" class="msg">{{msg}}</text>
  </view>
  <site-icp-footer />
</view>
