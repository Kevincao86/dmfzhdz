page {
  height: 100%;
  background: #f3f6fb;
}

.voice-root {
  height: 100vh;
  width: 100%;
  overflow: hidden;
  box-sizing: border-box;
  background: #f3f6fb;
}

.voice-scroll {
  height: 100%;
  width: 100%;
  box-sizing: border-box;
}

.voice-inner {
  width: 100%;
  padding: 16rpx 16rpx calc(48rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.voice-hero {
  width: 100%;
  padding: 8rpx 8rpx 16rpx;
  box-sizing: border-box;
}

.voice-hero-title {
  display: block;
  font-size: 36rpx;
  font-weight: 800;
  color: #0f172a;
}

.voice-hero-desc {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #64748b;
  line-height: 1.55;
}

.voice-card {
  width: 100%;
  margin-top: 8rpx;
  padding: 28rpx 20rpx;
  background: #fff;
  border-radius: 24rpx;
  box-sizing: border-box;
}

.voice-h {
  display: block;
  font-size: 30rpx;
  font-weight: 700;
  color: #0f172a;
  margin-bottom: 8rpx;
}

.sec-lab {
  display: block;
  margin: 20rpx 0 12rpx;
  font-size: 22rpx;
  font-weight: 700;
  color: #64748b;
}

.plat {
  display: flex;
  flex-direction: row;
  align-items: center;
  width: 100%;
  min-height: 148rpx;
  box-sizing: border-box;
  padding: 28rpx 24rpx;
  margin-bottom: 16rpx;
  border: 2rpx solid #e2e8f0;
  border-radius: 24rpx;
  background: #fff;
}

.plat.on {
  border-color: #0284c7;
  background: #f0f9ff;
}

.plat.off {
  opacity: 0.55;
}

.plat-logo-wrap {
  width: 96rpx;
  height: 96rpx;
  min-width: 96rpx;
  max-width: 96rpx;
  flex: 0 0 96rpx;
  overflow: hidden;
  border-radius: 20rpx;
  background: #f8fafc;
}

.plat-logo {
  width: 96rpx;
  height: 96rpx;
  border-radius: 20rpx;
  background-repeat: no-repeat;
  background-position: center;
  background-size: contain;
}

.plat-logo.ph {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  font-weight: 700;
  color: #0284c7;
  background: #e0f2fe;
}

.plat-body {
  flex: 1;
  min-width: 0;
  margin: 0 20rpx;
}

.plat-name {
  display: block;
  font-size: 30rpx;
  font-weight: 700;
  color: #0f172a;
  line-height: 1.4;
  word-break: break-all;
}

.plat-status {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #94a3b8;
  line-height: 1.4;
}

.plat-status.ok {
  color: #059669;
}

.plat-radio {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  border: 2rpx solid #cbd5e1;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  color: #fff;
  font-weight: 800;
}

.plat-radio.on {
  border-color: #0284c7;
  background: #0284c7;
}

.voice-next {
  margin-top: 24rpx;
}

.voice-p {
  display: block;
  font-size: 24rpx;
  color: #64748b;
  line-height: 1.5;
  margin-bottom: 16rpx;
}

.voice-note {
  display: block;
  font-size: 22rpx;
  color: #5b21b6;
  background: #f5f3ff;
  padding: 12rpx 16rpx;
  border-radius: 12rpx;
  margin-bottom: 16rpx;
}

.voice-plat {
  display: block;
  font-size: 24rpx;
  font-weight: 600;
  color: #0369a1;
  margin-bottom: 16rpx;
}

.req-lab,
.opt-lab {
  display: block;
  margin: 20rpx 0 8rpx;
  font-size: 22rpx;
  font-weight: 700;
}

.req-lab {
  color: #b45309;
}

.opt-lab {
  color: #6d28d9;
}

.req-check {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 12rpx;
  margin: 16rpx 0 8rpx;
  padding: 16rpx;
  border-radius: 14rpx;
  border: 1rpx solid #fde68a;
  background: #fffbeb;
  font-size: 24rpx;
  color: #92400e;
}

.req-check.on {
  border-color: #34d399;
  background: #ecfdf5;
  color: #047857;
}

.req-box {
  width: 36rpx;
  height: 36rpx;
  border-radius: 8rpx;
  border: 2rpx solid currentColor;
  text-align: center;
  line-height: 32rpx;
  font-weight: 800;
  flex-shrink: 0;
}

.voice-raw {
  display: block;
  margin: 16rpx 0;
  font-size: 20rpx;
  color: #94a3b8;
  line-height: 1.4;
}

.voice-record-btn {
  margin-top: 8rpx;
}

.skip {
  background: transparent;
  margin-top: 12rpx;
}

.voice-pulse {
  display: block;
  margin-top: 16rpx;
  text-align: center;
  color: #dc2626;
  font-size: 24rpx;
}

.area {
  min-height: 160rpx;
}
