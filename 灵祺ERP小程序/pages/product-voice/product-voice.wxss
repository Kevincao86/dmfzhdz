.voice-page {
  min-height: 100vh;
  padding: 16rpx 24rpx 48rpx;
  box-sizing: border-box;
  background: #f8fafc;
}

.voice-hero-title {
  display: block;
  font-size: 36rpx;
  font-weight: 800;
  color: #0f172a;
}

.voice-hero-desc {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #64748b;
  line-height: 1.5;
}

.voice-card {
  margin-top: 16rpx;
  padding: 24rpx;
  background: #fff;
  border-radius: 24rpx;
}

.voice-h {
  display: block;
  font-size: 30rpx;
  font-weight: 700;
  color: #0f172a;
  margin-bottom: 16rpx;
}

.voice-p {
  display: block;
  font-size: 24rpx;
  color: #64748b;
  line-height: 1.5;
  margin-bottom: 16rpx;
}

.voice-note {
  display: block;
  font-size: 22rpx;
  color: #5b21b6;
  background: #f5f3ff;
  padding: 12rpx 16rpx;
  border-radius: 12rpx;
  margin-bottom: 16rpx;
}

.voice-plat {
  display: block;
  font-size: 24rpx;
  font-weight: 600;
  color: #0369a1;
  margin-bottom: 16rpx;
}

.plat {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 16rpx;
  border: 1rpx solid #e2e8f0;
  border-radius: 16rpx;
  margin-bottom: 12rpx;
}

.plat.on {
  border-color: #38bdf8;
  background: #f0f9ff;
}

.plat.off {
  opacity: 0.55;
}

.plat-logo {
  width: 56rpx;
  height: 56rpx;
  border-radius: 12rpx;
}

.plat-body {
  flex: 1;
  min-width: 0;
}

.plat-name {
  display: block;
  font-size: 26rpx;
  font-weight: 700;
  color: #0f172a;
}

.plat-desc {
  display: block;
  font-size: 20rpx;
  color: #94a3b8;
}

.plat-tick {
  color: #0284c7;
  font-weight: 800;
}

.req-lab,
.opt-lab {
  display: block;
  margin: 20rpx 0 8rpx;
  font-size: 22rpx;
  font-weight: 700;
}

.req-lab {
  color: #b45309;
}

.opt-lab {
  color: #6d28d9;
}

.req-check {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin: 16rpx 0 8rpx;
  padding: 16rpx;
  border-radius: 14rpx;
  border: 1rpx solid #fde68a;
  background: #fffbeb;
  font-size: 24rpx;
  color: #92400e;
}

.req-check.on {
  border-color: #34d399;
  background: #ecfdf5;
  color: #047857;
}

.req-box {
  width: 36rpx;
  height: 36rpx;
  border-radius: 8rpx;
  border: 2rpx solid currentColor;
  text-align: center;
  line-height: 32rpx;
  font-weight: 800;
}

.voice-raw {
  display: block;
  margin: 16rpx 0;
  font-size: 20rpx;
  color: #94a3b8;
  line-height: 1.4;
}

.voice-record-btn {
  margin-top: 8rpx;
}

.skip {
  background: transparent;
  margin-top: 12rpx;
}

.voice-pulse {
  display: block;
  margin-top: 16rpx;
  text-align: center;
  color: #dc2626;
  font-size: 24rpx;
}

.area {
  min-height: 160rpx;
}
