.sch-scroll {
  height: 100vh;
  box-sizing: border-box;
  padding: 20rpx 26rpx calc(36rpx + env(safe-area-inset-bottom));
  background: #f8fafc;
}

.sch-back {
  font-size: 26rpx;
  color: #64748b;
  display: block;
  margin-bottom: 14rpx;
}

.sch-head-row {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  justify-content: space-between;
}

.sch-head-main {
  flex: 1;
  min-width: 0;
}

.sch-h1 {
  font-size: 40rpx;
  font-weight: 800;
  color: #0f172a;
  display: block;
}

.sch-muted {
  margin-top: 8rpx;
  font-size: 23rpx;
  color: #64748b;
  line-height: 1.5;
  display: block;
}

.sch-steps {
  margin-top: 24rpx;
  padding: 22rpx 20rpx;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.sch-step-item {
  font-size: 24rpx;
  color: #94a3b8;
}

.sch-step-item.done {
  color: #047857;
  font-weight: 600;
}

.sch-step-item.on {
  color: #1d4ed8;
  font-weight: 800;
}

.sch-card {
  margin-top: 20rpx;
  padding: 8rpx 0 28rpx;
}

.sch-row {
  padding: 20rpx 22rpx;
  border-bottom: 1rpx solid #f1f5f9;
}

.sch-time {
  font-size: 26rpx;
  font-weight: 700;
  color: #0f172a;
  display: block;
}

.sch-tal {
  margin-top: 6rpx;
  font-size: 26rpx;
  color: #334155;
  display: block;
}

.sch-store {
  margin-top: 4rpx;
  font-size: 23rpx;
  color: #64748b;
  display: block;
}

.sch-note {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #94a3b8;
  display: block;
}

.sch-empty {
  padding: 80rpx 32rpx;
  text-align: center;
}

.sch-empty-icon {
  font-size: 72rpx;
  display: block;
  opacity: 0.35;
}

.sch-empty-text {
  margin-top: 14rpx;
  font-size: 26rpx;
  color: #94a3b8;
  line-height: 1.55;
}

.sch-bar-tip {
  margin-top: 28rpx;
  padding: 22rpx 20rpx;
  border-radius: 16rpx;
  border: 1rpx solid #bbf7d0;
  background: rgba(236, 253, 245, 0.9);
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 16rpx;
}

.sch-bar-msg {
  flex: 1;
  min-width: 200rpx;
  font-size: 23rpx;
  color: #064e3b;
  line-height: 1.45;
}

.sch-space {
  height: 32rpx;
}
