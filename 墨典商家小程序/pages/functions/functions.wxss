.func-scroll {
  height: 100vh;
  background: linear-gradient(180deg, #eef6ff 0%, #f3f6fb 28%, #f8fafc 100%);
  padding-bottom: var(--tab-bar-pad);
  box-sizing: border-box;
}

.func-hero {
  padding: 28rpx 28rpx 8rpx;
}

.func-hero-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #0f172a;
  display: block;
}

.func-hero-desc {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #64748b;
  line-height: 1.5;
  display: block;
}

.func-banner {
  margin-top: 16rpx;
  padding: 16rpx 20rpx;
  border-radius: 16rpx;
  background: rgba(251, 191, 36, 0.12);
  color: #92400e;
  font-size: 22rpx;
  line-height: 1.45;
}

.sec-card {
  margin: 20rpx 28rpx 0;
  padding: 28rpx 24rpx 24rpx;
  background: #fff;
  border-radius: 24rpx;
  border: 1rpx solid rgba(15, 23, 42, 0.04);
  box-shadow: 0 6rpx 24rpx rgba(15, 23, 42, 0.04);
}

.sec-head {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.sec-icon {
  width: 72rpx;
  height: 72rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  font-weight: 800;
  color: #fff;
}

.sec-tone-cyan { background: linear-gradient(145deg, #22d3ee, #0891b2); }
.sec-tone-orange { background: linear-gradient(145deg, #fb923c, #ea580c); }
.sec-tone-violet { background: linear-gradient(145deg, #a78bfa, #7c3aed); }
.sec-tone-rose { background: linear-gradient(145deg, #fb7185, #e11d48); }
.sec-tone-blue { background: linear-gradient(145deg, #60a5fa, #2563eb); }
.sec-tone-emerald { background: linear-gradient(145deg, #34d399, #059669); }

.sec-meta {
  flex: 1;
  min-width: 0;
}

.sec-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #0f172a;
  display: block;
}

.sec-desc {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #64748b;
  display: block;
}

.item-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.item-cell {
  width: calc(50% - 8rpx);
  box-sizing: border-box;
  padding: 22rpx 18rpx;
  border-radius: 18rpx;
  background: #fafbfc;
  border: 1rpx solid rgba(226, 232, 240, 0.9);
}

.item-cell-hover {
  background: #f1f5f9;
}

.cell-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 10rpx;
}

.cell-glyph {
  width: 48rpx;
  height: 48rpx;
  border-radius: 14rpx;
  background: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  font-weight: 800;
  color: #0284c7;
  border: 1rpx solid rgba(14, 165, 233, 0.2);
}

.cell-badge {
  font-size: 18rpx;
  color: #7c3aed;
  background: rgba(124, 58, 237, 0.12);
  padding: 4rpx 10rpx;
  border-radius: 8rpx;
  font-weight: 700;
}

.cell-title {
  font-size: 26rpx;
  font-weight: 600;
  color: #0f172a;
  display: block;
}

.cell-desc {
  margin-top: 6rpx;
  font-size: 20rpx;
  color: #64748b;
  line-height: 1.4;
  display: block;
}

.item-cell-text-only .cell-title {
  margin-top: 0;
}

.item-cell-compact {
  min-height: 124rpx;
  display: flex;
  flex-direction: column;
  justify-content: center;
  background: linear-gradient(155deg, #ffffff 0%, #f8fafc 100%);
  border-color: rgba(99, 102, 241, 0.12);
}

.item-cell-compact .cell-title {
  font-size: 28rpx;
  font-weight: 700;
}

.item-cell-compact .cell-glyph {
  background: linear-gradient(135deg, #e0e7ff, #cffafe);
  color: #4338ca;
  border-color: rgba(79, 70, 229, 0.2);
}

.func-footer-space {
  height: 40rpx;
}
