@import '../product-edit/product-edit.wxss';

.rec-page {
  padding: 28rpx;
  padding-bottom: 48rpx;
  box-sizing: border-box;
  min-height: 100vh;
}

.rec-banner-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #0f172a;
  display: block;
  margin-bottom: 12rpx;
}

.rec-actions {
  margin-bottom: 24rpx;
}

.rec-mt {
  margin-top: 20rpx;
}

.rec-center {
  text-align: center;
  padding: 48rpx 24rpx;
  color: #64748b;
  font-size: 26rpx;
}

.rec-err {
  color: #b91c1c;
}

.rec-filter-hint {
  display: block;
  font-size: 22rpx;
  color: #94a3b8;
  margin-bottom: 16rpx;
}

.rec-row {
  margin-bottom: 20rpx;
}

.rec-row-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #0f172a;
  display: block;
}

.rec-row-sub {
  font-size: 22rpx;
  color: #64748b;
  margin-top: 8rpx;
  display: block;
}

.rec-row-sum {
  font-size: 22rpx;
  color: #475569;
  margin-top: 12rpx;
  display: block;
  line-height: 1.45;
}
