.mine-scroll {
  height: 100vh;
  background: linear-gradient(180deg, #eef6ff 0%, #f8fafc 40%);
  padding-bottom: var(--tab-bar-pad);
  box-sizing: border-box;
}

.profile-card {
  margin: 28rpx 24rpx 20rpx;
  padding: 32rpx 28rpx;
  background: linear-gradient(135deg, #0ea5e9 0%, #6366f1 100%);
  border-radius: 28rpx;
  display: flex;
  align-items: center;
  gap: 24rpx;
  box-shadow: 0 10rpx 36rpx rgba(14, 165, 233, 0.25);
}

.avatar {
  width: 112rpx;
  height: 112rpx;
  border-radius: 28rpx;
  background: #0a0a0a;
  padding: 12rpx;
  box-sizing: border-box;
  flex-shrink: 0;
}

.profile-text {
  flex: 1;
  min-width: 0;
}

.profile-name-row {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 12rpx;
}

.profile-name {
  font-size: 36rpx;
  font-weight: 800;
  color: #fff;
}

.plan-pill {
  font-size: 20rpx;
  font-weight: 600;
  padding: 6rpx 14rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.25);
  color: #fff;
}

.plan-pill-member {
  background: rgba(251, 191, 36, 0.35);
}

.plan-pill-plus {
  background: rgba(167, 139, 250, 0.45);
}

.plan-pill-dev {
  background: rgba(255, 255, 255, 0.2);
}

.profile-sub {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.85);
  display: block;
}

.dev-pill {
  margin-top: 12rpx;
  display: inline-block;
  font-size: 20rpx;
  color: #fff;
  background: rgba(255, 255, 255, 0.22);
  padding: 6rpx 14rpx;
  border-radius: 999rpx;
}

.menu-card {
  margin: 0 28rpx;
  background: #fff;
  border-radius: 24rpx;
  overflow: hidden;
  border: 1rpx solid rgba(15, 23, 42, 0.04);
  box-shadow: 0 8rpx 28rpx rgba(15, 23, 42, 0.04);
}

.menu-row {
  display: flex;
  align-items: center;
  padding: 28rpx 24rpx;
  border-bottom: 1rpx solid #f1f5f9;
}

.menu-row:last-child {
  border-bottom: none;
}

.menu-icon {
  width: 64rpx;
  height: 64rpx;
  border-radius: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 800;
  color: #fff;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.menu-tone-cyan { background: linear-gradient(145deg, #22d3ee, #0891b2); }
.menu-tone-blue { background: linear-gradient(145deg, #60a5fa, #2563eb); }
.menu-tone-amber { background: linear-gradient(145deg, #fbbf24, #d97706); }
.menu-tone-violet { background: linear-gradient(145deg, #a78bfa, #7c3aed); }
.menu-tone-indigo { background: linear-gradient(145deg, #818cf8, #4f46e5); }

.menu-body {
  flex: 1;
  min-width: 0;
}

.menu-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #0f172a;
  display: block;
}

.menu-desc {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #64748b;
  display: block;
}

.menu-arrow {
  font-size: 32rpx;
  color: #cbd5e1;
}

.logout-btn {
  margin: 32rpx 24rpx;
  background: #fff;
  color: #dc2626;
  border: 1rpx solid rgba(220, 38, 38, 0.25);
  border-radius: 20rpx;
  font-size: 28rpx;
  font-weight: 600;
}

.mine-footer-space {
  height: 24rpx;
}
