<scroll-view scroll-y class="mine-scroll" enhanced show-scrollbar="{{false}}">
  <view class="profile-card">
    <image class="avatar" src="/images/logo.png" mode="aspectFit" />
    <view class="profile-text">
      <view class="profile-name-row">
        <text class="profile-name">{{storeName}}</text>
        <text wx:if="{{planLabel}}" class="plan-pill plan-pill-{{planPillClass}}">{{planLabel}}</text>
      </view>
      <text class="profile-sub">账户 {{loginName || '—'}}</text>
      <text wx:if="{{devMode}}" class="dev-pill">开发预览</text>
    </view>
  </view>

  <view class="bindings-card">
    <view class="bindings-head">
      <text class="bindings-title">平台绑定</text>
      <text wx:if="{{bindingsLoading}}" class="bindings-meta">同步中…</text>
    </view>
    <text class="bindings-hint">{{bindingsHint}}</text>
    <view wx:for="{{cloudPlatformRows}}" wx:key="id" class="binding-row">
      <text class="binding-label">{{item.label}}</text>
      <text class="binding-status binding-status-{{item.statusClass}}">{{item.statusText}}</text>
    </view>
    <view wx:if="{{webPlatformRows.length}}" class="bindings-divider"></view>
    <text wx:if="{{webPlatformRows.length}}" class="bindings-sub">以下平台绑定仅存于电脑浏览器，换设备需重新授权</text>
    <view wx:for="{{webPlatformRows}}" wx:key="id" class="binding-row">
      <text class="binding-label">{{item.label}}</text>
      <text class="binding-status binding-status-{{item.statusClass}}">{{item.statusText}}</text>
    </view>
  </view>

  <view class="menu-card">
    <view
      wx:for="{{menu}}"
      wx:key="id"
      class="menu-row"
      data-action="{{item.action}}"
      data-url="{{item.url}}"
      bindtap="onMenuTap"
    >
      <view class="menu-icon menu-tone-{{item.tone}}">{{item.glyph}}</view>
      <view class="menu-body">
        <text class="menu-title">{{item.title}}</text>
        <text class="menu-desc">{{item.desc}}</text>
      </view>
      <text class="menu-arrow">›</text>
    </view>
  </view>

  <view class="logout-btn" bindtap="onLogout">退出登录</view>
  <view class="mine-footer-space"></view>
</scroll-view>

<view wx:if="{{showLogoutConfirm}}" class="logout-mask" catchtouchmove="true">
  <view class="logout-dialog" catchtap="true">
    <text class="logout-dialog-title">退出当前账号</text>
    <text class="logout-dialog-desc">确定退出登录？</text>
    <view class="logout-dialog-actions">
      <view class="logout-dialog-btn ghost" bindtap="onCancelLogout">取消</view>
      <view class="logout-dialog-btn primary" bindtap="onConfirmLogout">确定</view>
    </view>
  </view>
</view>
