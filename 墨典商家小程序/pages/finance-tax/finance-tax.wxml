<scroll-view scroll-y class="mp-page" style="height:100vh">
  <view class="mp-form-card">
    <text class="wizard-title">报税辅助</text>
    <text class="wizard-desc">按平台汇总近 {{days}} 日成交额与核销额，便于申报核对（数据来自财务对账接口）。</text>
    <button class="meoo-btn-primary" bindtap="onLoad" loading="{{loading}}">拉取汇总</button>
    <view wx:if="{{err}}" class="mp-err" style="text-align:left;margin-top:16rpx">{{err}}</view>
    <view wx:for="{{rows}}" wx:key="key" class="mp-list-card" style="margin-top:16rpx">
      <text class="mp-list-title">{{item.platformLabel}}</text>
      <text class="mp-list-sub">成交额合计 ¥{{item.sales}}</text>
      <text class="mp-list-meta">核销额合计 ¥{{item.verify}}</text>
    </view>
  </view>
  <view class="mp-list-footer"></view>
</scroll-view>
