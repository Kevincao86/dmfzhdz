.pick-page {
  min-height: 100vh;
  padding: 28rpx;
  padding-bottom: 48rpx;
  box-sizing: border-box;
  background: linear-gradient(180deg, #f8fafc 0%, #e2e8f0 100%);
}

.pick-back {
  font-size: 26rpx;
  color: #475569;
  margin-bottom: 24rpx;
}

.pick-h1 {
  font-size: 38rpx;
  font-weight: 800;
  color: #0f172a;
  display: block;
}

.pick-lead {
  margin-top: 16rpx;
  margin-bottom: 36rpx;
  font-size: 24rpx;
  color: #64748b;
  line-height: 1.55;
}

.pick-row {
  display: flex;
  gap: 20rpx;
}

.pick-card {
  flex: 1;
  min-height: 280rpx;
  padding: 24rpx 20rpx;
  border-radius: 22rpx;
  display: flex;
  flex-direction: column;
}

.pick-card-hover {
  opacity: 0.93;
}

.pick-novice {
  border: 2rpx solid rgba(147, 51, 234, 0.35);
  background: linear-gradient(160deg, #faf5ff 0%, #fff 62%);
}

.pick-pro {
  border: 2rpx solid rgba(59, 130, 246, 0.35);
  background: linear-gradient(160deg, #eff6ff 0%, #fff 58%);
}

.pick-icon {
  width: 76rpx;
  height: 76rpx;
  border-radius: 20rpx;
  font-size: 36rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.pick-icon-novice {
  background: linear-gradient(135deg, #a855f7, #ec4899);
  color: #fff;
}

.pick-icon-pro {
  background: #2563eb;
  color: #fff;
}

.pick-card-title {
  margin-top: 20rpx;
  font-size: 26rpx;
  font-weight: 800;
  color: #1e293b;
  line-height: 1.35;
}

.pick-card-cta {
  margin-top: auto;
  padding-top: 28rpx;
  font-size: 24rpx;
  font-weight: 700;
}

.pick-card-cta.purple {
  color: #7c3aed;
}

.pick-card-cta.blue {
  color: #2563eb;
}
