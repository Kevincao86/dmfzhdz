<scroll-view scroll-y class="scroll">
  <view class="range-pill">{{rangeLabel}}</view>
  <text class="subhead">数字由各平台店铺汇总；详细图表请在电脑端商家首页查看</text>
  <text wx:if="{{loading}}" class="loading-line">正在拉取汇总…</text>

  <view class="stat-grid">
    <view class="stat-card meoo-card" wx:for="{{stats}}" wx:key="label">
      <text class="stat-label">{{item.label}}</text>
      <text class="stat-value">{{item.value}}</text>
      <text wx:if="{{item.hint}}" class="stat-hint">{{item.hint}}</text>
    </view>
  </view>

  <text class="section-title">平台</text>
  <view class="plat-row">
    <view
      class="plat-chip meoo-card plat-{{item.tone}} {{item.connected ? '' : 'plat-off'}}"
      wx:for="{{platforms}}"
      wx:key="id"
    >
      <view wx:if="{{item.connected}}" class="plat-dot" />
      <text class="plat-name">{{item.name}}</text>
    </view>
  </view>

  <text class="section-title">快捷待办</text>
  <navigator
    wx:for="{{todos}}"
    wx:key="url"
    url="{{item.url}}"
    class="todo-card meoo-card todo-link"
    hover-class="todo-hover"
  >
    <text class="todo-title">{{item.title}}</text>
    <text class="todo-sub">{{item.sub}}</text>
    <text class="todo-arrow">›</text>
  </navigator>
</scroll-view>
