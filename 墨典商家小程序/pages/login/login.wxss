.page-scroll {
  height: 100vh;
  box-sizing: border-box;
}

.wrap {
  min-height: 100vh;
  padding: 56rpx 36rpx 80rpx;
  box-sizing: border-box;
  background: linear-gradient(185deg, #e0efff 0%, #f3f6fb 45%);
}

.brand {
  margin-bottom: 36rpx;
}

.brand-logo {
  width: 128rpx;
  height: 128rpx;
  display: block;
  margin-bottom: 20rpx;
}

.tag {
  font-size: 20rpx;
  letter-spacing: 0.18em;
  color: #0284c7;
  font-weight: 600;
  display: block;
}

.title {
  font-size: 44rpx;
  font-weight: 800;
  color: #0f172a;
  margin-top: 16rpx;
  display: block;
}

.desc {
  font-size: 26rpx;
  color: #64748b;
  margin-top: 16rpx;
  line-height: 1.55;
  display: block;
}

.auth-tabs {
  display: flex;
  gap: 32rpx;
  margin-bottom: 16rpx;
  border-bottom: 1rpx solid #e2e8f0;
}

.auth-tab {
  position: relative;
  padding-bottom: 16rpx;
  font-size: 30rpx;
  font-weight: 600;
  color: #94a3b8;
}

.auth-tab.on {
  color: #0f172a;
}

.auth-tab.on::after {
  content: '';
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 4rpx;
  border-radius: 4rpx;
  background: linear-gradient(95deg, #0ea5e9, #14b8a6);
}

.mode-hint {
  display: block;
  font-size: 24rpx;
  color: #64748b;
  line-height: 1.5;
  margin-bottom: 20rpx;
}

.secure-box {
  padding: 20rpx 22rpx;
  margin-bottom: 24rpx;
  border-radius: 16rpx;
  background: #f8fafc;
  border: 1rpx solid #e2e8f0;
}

.secure-title {
  display: block;
  font-size: 26rpx;
  font-weight: 600;
  color: #0f172a;
}

.secure-desc {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #64748b;
  line-height: 1.5;
}

.method-tabs {
  display: flex;
  gap: 12rpx;
  margin-bottom: 24rpx;
}

.method-tab {
  flex: 1;
  text-align: center;
  padding: 14rpx 0;
  font-size: 24rpx;
  color: #64748b;
  background: #f8fafc;
  border-radius: 12rpx;
  border: 1rpx solid #e2e8f0;
}

.method-tab.on {
  color: #0369a1;
  font-weight: 600;
  background: #e0f2fe;
  border-color: #bae6fd;
}

.field {
  margin-bottom: 28rpx;
}

.sms-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.sms-input {
  flex: 1;
  min-width: 0;
}

.sms-btn {
  flex-shrink: 0;
  margin: 0 !important;
  padding: 0 20rpx !important;
  height: 72rpx !important;
  line-height: 72rpx !important;
  font-size: 22rpx !important;
  color: #0369a1 !important;
  background: #f1f5f9 !important;
  border: 1rpx solid #e2e8f0 !important;
  border-radius: 12rpx !important;
}

.info-hint {
  display: block;
  margin-bottom: 20rpx;
  padding: 16rpx 20rpx;
  font-size: 24rpx;
  color: #0c4a6e;
  background: #e0f2fe;
  border-radius: 12rpx;
  border: 1rpx solid #bae6fd;
}

.err {
  color: #dc2626;
  font-size: 24rpx;
  margin-bottom: 24rpx;
  display: block;
}

.btn {
  margin-top: 8rpx;
  border: none;
}

.refresh-btn {
  margin-top: 24rpx;
  border: none;
  background: #f8fafc;
  color: #0369a1;
  font-size: 28rpx;
  font-weight: 600;
  line-height: 1.4;
}

.refresh-btn::after {
  border: none;
}

.refresh-hint {
  display: block;
  margin-top: 12rpx;
  text-align: center;
  font-size: 22rpx;
  color: #94a3b8;
  line-height: 1.5;
}

.dev-preview-btn {
  margin-top: 20rpx;
  border: none;
  background: transparent;
  color: #64748b;
  font-size: 24rpx;
  font-weight: 500;
  line-height: 1.4;
}

.dev-preview-btn::after {
  border: none;
}
