<scroll-view scroll-y class="page-scroll" enhanced show-scrollbar="{{false}}">
  <view class="wrap">
    <view class="brand">
      <image class="brand-logo" src="/images/logo.png" mode="aspectFit" />
      <text class="tag">LOCAL LIFE OS</text>
      <text class="title">墨典AI智能ERP</text>
      <text class="desc">商家端 · 登录后进入工作台</text>
    </view>

    <view class="card meoo-card">
      <view class="auth-tabs">
        <view class="auth-tab {{mode === 'login' ? 'on' : ''}}" data-mode="login" bindtap="onSwitchMode">登录</view>
        <view class="auth-tab {{mode === 'register' ? 'on' : ''}}" data-mode="register" bindtap="onSwitchMode">注册</view>
      </view>

      <text class="mode-hint">{{modeHint}}</text>

      <view class="secure-box">
        <text class="secure-title">安全可信</text>
        <text class="secure-desc">短信由阿里云发送，登录会话经加密存储，保障账号安全。</text>
      </view>

      <text wx:if="{{infoHint}}" class="info-hint">{{infoHint}}</text>

      <block wx:if="{{mode === 'login'}}">
        <view class="method-tabs">
          <view
            class="method-tab {{loginMethod === 'password' ? 'on' : ''}}"
            data-method="password"
            bindtap="onSwitchLoginMethod"
          >密码登录</view>
          <view
            class="method-tab {{loginMethod === 'sms' ? 'on' : ''}}"
            data-method="sms"
            bindtap="onSwitchLoginMethod"
          >验证码登录</view>
        </view>

        <block wx:if="{{loginMethod === 'password'}}">
          <view class="field">
            <text class="meoo-label">账户名</text>
            <input class="meoo-input" placeholder="门店简称或工号" value="{{loginName}}" bindinput="onLoginName" />
          </view>
          <view class="field">
            <text class="meoo-label">密码</text>
            <input class="meoo-input" password placeholder="至少 6 位" value="{{password}}" bindinput="onPassword" />
          </view>
        </block>

        <block wx:else>
          <view class="field">
            <text class="meoo-label">手机号</text>
            <input
              class="meoo-input"
              type="number"
              maxlength="11"
              placeholder="11 位大陆手机号"
              value="{{loginPhone}}"
              bindinput="onLoginPhone"
            />
          </view>
          <view class="field">
            <text class="meoo-label">短信验证码</text>
            <view class="sms-row">
              <input
                class="meoo-input sms-input"
                type="number"
                maxlength="6"
                placeholder="6 位验证码"
                value="{{loginSmsCode}}"
                bindinput="onLoginSmsCode"
              />
              <button
                class="sms-btn"
                size="mini"
                disabled="{{busy || loginSmsSending || loginSmsCooldown > 0}}"
                bindtap="onSendLoginSms"
              >
                {{loginSmsSending ? '发送中…' : (loginSmsCooldown > 0 ? loginSmsCooldown + 's' : '获取验证码')}}
              </button>
            </view>
          </view>
        </block>
      </block>

      <block wx:else>
        <view class="field">
          <text class="meoo-label">登录名（字母+数字 4–32 位）</text>
          <input class="meoo-input" placeholder="如 shop2026" value="{{regLoginName}}" bindinput="onRegLoginName" />
        </view>
        <view class="field">
          <text class="meoo-label">商家名简称</text>
          <input class="meoo-input" placeholder="如：墨典咖啡" value="{{merchantName}}" bindinput="onMerchantName" />
        </view>
        <view class="field">
          <text class="meoo-label">手机号</text>
          <input
            class="meoo-input"
            type="number"
            maxlength="11"
            placeholder="11 位大陆手机号"
            value="{{phone}}"
            bindinput="onPhone"
          />
        </view>
        <view class="field">
          <text class="meoo-label">短信验证码</text>
          <view class="sms-row">
            <input
              class="meoo-input sms-input"
              type="number"
              maxlength="6"
              placeholder="6 位验证码"
              value="{{smsCode}}"
              bindinput="onSmsCode"
            />
            <button
              class="sms-btn"
              size="mini"
              disabled="{{busy || smsSending || smsCooldown > 0}}"
              bindtap="onSendRegSms"
            >
              {{smsSending ? '发送中…' : (smsCooldown > 0 ? smsCooldown + 's' : '获取验证码')}}
            </button>
          </view>
        </view>
        <view class="field">
          <text class="meoo-label">密码</text>
          <input class="meoo-input" password placeholder="至少 6 位" value="{{regPassword}}" bindinput="onRegPassword" />
        </view>
        <view class="field">
          <text class="meoo-label">确认密码</text>
          <input
            class="meoo-input"
            password
            placeholder="再次输入密码"
            value="{{confirmPassword}}"
            bindinput="onConfirmPassword"
          />
        </view>
      </block>

      <text wx:if="{{err}}" class="err">{{err}}</text>

      <button class="meoo-btn-primary btn" loading="{{busy}}" disabled="{{busy}}" bindtap="onSubmit">
        {{submitLabel}}
      </button>

      <button wx:if="{{devSkip}}" class="dev-preview-btn" bindtap="onDevPreview">开发预览（跳过登录）</button>
    </view>
  </view>
</scroll-view>
