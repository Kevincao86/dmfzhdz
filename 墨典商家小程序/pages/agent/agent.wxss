.agent-page {
  height: 100vh;
  background: #f8fafc;
  overflow: hidden;
}

.agent-header {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  z-index: 100;
  background: #fff;
  border-bottom: 1rpx solid rgba(15, 23, 42, 0.06);
}

.header-row {
  display: flex;
  align-items: center;
  padding: 10rpx 20rpx 12rpx;
  gap: 12rpx;
}

.menu-btn {
  width: 60rpx;
  height: 60rpx;
  border-radius: 16rpx;
  background: #f1f5f9;
  display: flex;
  align-items: center;
  justify-content: center;
}

.menu-glyph {
  font-size: 30rpx;
  color: #334155;
  font-weight: 700;
}

.header-center {
  flex: 1;
}

.header-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #0f172a;
}

.chat-scroll {
  height: 100vh;
  box-sizing: border-box;
}

.chat-inner {
  padding: 12rpx 20rpx;
}

.msg-row {
  display: flex;
  margin-bottom: 14rpx;
}

.msg-row.user {
  justify-content: flex-end;
}

.msg-row.bot {
  justify-content: flex-start;
}

.bubble {
  max-width: 86%;
  padding: 14rpx 18rpx;
  border-radius: 18rpx;
  line-height: 1.5;
}

.bubble-user {
  background: linear-gradient(135deg, #0ea5e9, #06b6d4);
  color: #fff;
}

.bubble-bot {
  background: #fff;
  color: #1e293b;
  border: 1rpx solid rgba(15, 23, 42, 0.06);
}

.msg-images {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-bottom: 8rpx;
}

.msg-thumb {
  width: 112rpx;
  height: 112rpx;
  border-radius: 10rpx;
  background: #f1f5f9;
}

.bubble-text {
  font-size: 26rpx;
  white-space: pre-wrap;
  word-break: break-word;
}

.composer-dock {
  position: fixed;
  left: 16rpx;
  right: 16rpx;
  bottom: calc(76rpx + env(safe-area-inset-bottom) + 36rpx);
  z-index: 10001;
  padding-bottom: 4rpx;
}

.attach-row {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-bottom: 8rpx;
  padding: 0 4rpx;
}

.attach-item {
  position: relative;
  width: 80rpx;
  height: 80rpx;
}

.attach-thumb {
  width: 80rpx;
  height: 80rpx;
  border-radius: 10rpx;
  background: #f1f5f9;
}

.attach-remove {
  position: absolute;
  top: -6rpx;
  right: -6rpx;
  width: 32rpx;
  height: 32rpx;
  border-radius: 999rpx;
  background: #0f172a;
  color: #fff;
  font-size: 22rpx;
  line-height: 32rpx;
  text-align: center;
}

.composer-bar {
  display: flex;
  align-items: center;
  gap: 10rpx;
  padding: 10rpx 12rpx;
  background: #fff;
  border-radius: 999rpx;
  border: 1rpx solid #e2e8f0;
  box-shadow: 0 6rpx 28rpx rgba(15, 23, 42, 0.12);
}

.bar-plus {
  width: 56rpx;
  height: 56rpx;
  border-radius: 999rpx;
  background: #f8fafc;
  border: 1rpx solid #e2e8f0;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.bar-plus.disabled {
  opacity: 0.4;
}

.bar-plus-txt {
  font-size: 36rpx;
  color: #475569;
  line-height: 1;
  margin-top: -4rpx;
}

.bar-center {
  flex: 1;
  min-width: 0;
}

.bar-input {
  width: 100%;
  min-height: 56rpx;
  max-height: 160rpx;
  font-size: 28rpx;
  line-height: 1.4;
  padding: 8rpx 4rpx;
  box-sizing: border-box;
}

.bar-hold {
  height: 56rpx;
  line-height: 56rpx;
  text-align: center;
  font-size: 28rpx;
  color: #334155;
  font-weight: 500;
  border-radius: 12rpx;
}

.bar-hold.recording {
  background: #fef2f2;
  color: #dc2626;
}

.bar-mode {
  width: 56rpx;
  height: 56rpx;
  border-radius: 999rpx;
  background: #f8fafc;
  border: 1rpx solid #e2e8f0;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.bar-mode-img {
  width: 36rpx;
  height: 36rpx;
  display: block;
}

.bar-model {
  max-width: 168rpx;
  height: 56rpx;
  padding: 0 14rpx;
  border-radius: 999rpx;
  background: #f0f9ff;
  border: 1rpx solid #bae6fd;
  display: flex;
  align-items: center;
  gap: 4rpx;
  flex-shrink: 0;
}

.bar-model-txt {
  font-size: 22rpx;
  color: #0369a1;
  font-weight: 600;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  max-width: 120rpx;
}

.bar-model-arrow {
  font-size: 18rpx;
  color: #0284c7;
}

.model-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 10002;
  background: rgba(15, 23, 42, 0.35);
}

.model-sheet {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  max-height: 62vh;
  background: #fff;
  border-radius: 24rpx 24rpx 0 0;
  padding-bottom: calc(76rpx + env(safe-area-inset-bottom));
  display: flex;
  flex-direction: column;
}

.sheet-head {
  padding: 20rpx 24rpx 12rpx;
  border-bottom: 1rpx solid #f1f5f9;
}

.sheet-title {
  font-size: 22rpx;
  color: #94a3b8;
  display: block;
  margin-bottom: 12rpx;
}

.sheet-tabs {
  display: flex;
  gap: 10rpx;
}

.sheet-tab {
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  color: #64748b;
  background: #f8fafc;
}

.sheet-tab.on {
  background: #e0f2fe;
  color: #0369a1;
  font-weight: 600;
}

.sheet-list {
  flex: 1;
  height: 0;
  max-height: 48vh;
}

.sheet-item {
  padding: 22rpx 28rpx;
  font-size: 26rpx;
  color: #334155;
  border-bottom: 1rpx solid #f8fafc;
}

.sheet-item.on {
  color: #0369a1;
  font-weight: 600;
  background: #f0f9ff;
}
