.pay-scroll {
  height: 100vh;
  box-sizing: border-box;
  padding: 20rpx 26rpx calc(36rpx + env(safe-area-inset-bottom));
  background: #f8fafc;
}

.pay-back {
  font-size: 26rpx;
  color: #64748b;
  display: block;
  margin-bottom: 18rpx;
}

.pay-card {
  padding: 38rpx 28rpx 44rpx;
}

.pay-h1 {
  font-size: 38rpx;
  font-weight: 800;
  color: #0f172a;
  display: block;
}

.pay-lead {
  margin-top: 16rpx;
  font-size: 26rpx;
  color: #475569;
  line-height: 1.55;
  display: block;
}

.pay-row {
  margin-top: 42rpx;
  padding-bottom: 18rpx;
  border-bottom: 1rpx solid #f1f5f9;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.pay-k {
  font-size: 26rpx;
  color: #334155;
}

.pay-v {
  font-size: 30rpx;
  font-weight: 700;
  color: #0f172a;
}

.pay-btn {
  margin-top: 48rpx;
  border-radius: 16rpx;
  padding: 24rpx 0;
  background: linear-gradient(95deg, #4f46e5, #6366f1);
  color: #fff;
  font-weight: 700;
}

.pay-space {
  height: 24rpx;
}
