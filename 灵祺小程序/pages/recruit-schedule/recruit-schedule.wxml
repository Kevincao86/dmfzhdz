<scroll-view scroll-y class="sch-scroll" enhanced show-scrollbar="{{false}}">
  <text class="sch-back" bindtap="goBack">‹ 返回五步流程</text>

  <view class="sch-head-row">
    <view class="sch-head-main">
      <text class="sch-h1">AI 自动排期</text>
      <text class="sch-muted">达人池已有「已确认」达人后，可由本页按规则写入排期注册表。</text>
    </view>
    <button size="mini" type="primary" bindtap="onReschedule" loading="{{busy}}" disabled="{{busy}}">重新排期</button>
  </view>

  <view class="sch-steps meoo-card">
    <text class="sch-step-item done">1 达人池确认 ✓</text>
    <text class="sch-step-item on">2 AI 自动排期</text>
    <text class="sch-step-item">3 执行探店</text>
  </view>

  <view class="sch-card meoo-card">
    <block wx:if="{{rows.length}}">
      <block wx:for="{{rows}}" wx:key="id">
        <view class="sch-row">
          <text class="sch-time">{{item.time}}</text>
          <text class="sch-tal">{{item.talentName}}</text>
          <text class="sch-store">{{item.storeName}}</text>
          <text class="sch-note">{{item.tableNote}}</text>
        </view>
      </block>
    </block>
    <view wx:else class="sch-empty">
      <text class="sch-empty-icon">📅</text>
      <text class="sch-empty-text">暂无排期，请点击「重新排期」生成并写入注册表</text>
    </view>
  </view>

  <view class="sch-bar-tip">
    <text class="sch-bar-msg">排期结果已写入注册表，可与管控台或其它模块对齐。</text>
    <button size="mini" type="primary" bindtap="goVideoAudit">进入视频审核 →</button>
  </view>

  <view class="sch-space" />
</scroll-view>
