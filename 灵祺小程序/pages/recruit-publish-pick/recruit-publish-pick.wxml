<view class="pick-page">
  <view class="pick-back" bindtap="backFlow">‹ 返回全流程</view>

  <text class="pick-h1">选择发布方式</text>
  <text class="pick-lead">新手版侧重极简填单与 AI 档位分配；专业版保留完整 Brief、门店与达人条件配置（与 Web 一致）。</text>

  <view class="pick-row">
    <view class="pick-card pick-novice" bindtap="goNovice" hover-class="pick-card-hover">
      <view class="pick-icon pick-icon-novice">✦</view>
      <text class="pick-card-title">新手版（AI 纯智能处理）</text>
      <text class="pick-card-cta purple">进入新手发布 →</text>
    </view>
    <view class="pick-card pick-pro" bindtap="goPro" hover-class="pick-card-hover">
      <view class="pick-icon pick-icon-pro">🎓</view>
      <text class="pick-card-title">专业版（AI 辅助处理）</text>
      <text class="pick-card-cta blue">进入专业发布 →</text>
    </view>
  </view>
</view>
