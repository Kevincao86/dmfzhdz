<scroll-view scroll-y class="br-scroll" enhanced show-scrollbar="{{false}}">
  <text class="br-back" bindtap="goHub">‹ 返回达人招募中心</text>

  <text class="br-title">Brief 生成记录</text>
  <text class="br-lead">本列表读取小程序本地保存的三版文稿，可在「专业版发布招募」中引用任一版本。</text>

  <view wx:if="{{!records.length}}" class="br-empty meoo-card">
    <text class="br-empty-title">暂无记录</text>
    <text class="br-empty-sub">请先完成 AI Brief 向导并保存，或在此处返回生成。</text>
    <button class="br-outline" bindtap="goWizard">去生成 Brief</button>
  </view>

  <block wx:for="{{records}}" wx:key="_sn">
    <view class="br-card meoo-card">
      <text class="br-card-title">{{item.mainProductName || 'Brief'}}</text>
      <text class="br-meta">{{item.platform}} · {{item.createdAt}}</text>
      <text wx:if="{{item.tags && item.tags.length}}" class="br-tags">标签 {{item.tags.join('、')}}</text>
      <view class="br-row-mini">
        <button size="mini" data-id="{{item.id}}" data-v="{{0}}" bindtap="pickForRecruit">引用 A</button>
        <button size="mini" data-id="{{item.id}}" data-v="{{1}}" bindtap="pickForRecruit">引用 B</button>
        <button size="mini" data-id="{{item.id}}" data-v="{{2}}" bindtap="pickForRecruit">引用 C</button>
      </view>
      <view class="br-row-mini">
        <button size="mini" class="br-ghost" data-id="{{item.id}}" data-v="{{0}}" bindtap="copyVariant">复制 A</button>
        <button size="mini" class="br-ghost" data-id="{{item.id}}" data-v="{{1}}" bindtap="copyVariant">复制 B</button>
        <button size="mini" class="br-ghost" data-id="{{item.id}}" data-v="{{2}}" bindtap="copyVariant">复制 C</button>
      </view>
      <text class="br-snippet">{{item.prevSnippet}}</text>
    </view>
  </block>

  <view class="br-space" />
</scroll-view>
