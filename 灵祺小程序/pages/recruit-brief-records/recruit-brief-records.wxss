.br-scroll {
  height: 100vh;
  padding: 24rpx 28rpx 48rpx;
  box-sizing: border-box;
  background: linear-gradient(180deg, #f8fafc 0%, #eef2ff 100%);
}

.br-back {
  font-size: 26rpx;
  color: #64748b;
  display: block;
  margin-bottom: 14rpx;
}

.br-title {
  font-size: 36rpx;
  font-weight: 800;
  color: #0f172a;
  display: block;
}

.br-lead {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #64748b;
  line-height: 1.52;
}

.br-empty {
  margin-top: 24rpx;
  padding: 48rpx 28rpx;
  text-align: center;
}

.br-empty-title {
  font-size: 30rpx;
  font-weight: 800;
  color: #475569;
  display: block;
}

.br-empty-sub {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #94a3b8;
}

.br-outline {
  margin-top: 28rpx;
  border-radius: 999rpx;
  padding: 18rpx 28rpx;
  border: 1rpx solid #6366f1;
  background: #fff;
  color: #4f46e5;
}

.br-outline::after {
  border: none;
}

.br-card {
  margin-top: 18rpx;
  padding: 24rpx 22rpx 28rpx !important;
}

.br-card-title {
  font-size: 30rpx;
  font-weight: 800;
  color: #111827;
}

.br-meta {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #64748b;
  display: block;
}

.br-tags {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #475569;
  display: block;
}

.br-snippet {
  margin-top: 14rpx;
  font-size: 23rpx;
  color: #334155;
  line-height: 1.45;
}

.br-row-mini {
  margin-top: 12rpx;
  display: flex;
  gap: 12rpx;
  flex-wrap: wrap;
}

.br-ghost {
  background: #f8fafc !important;
  color: #64748b !important;
}

.br-space {
  height: 32rpx;
}
