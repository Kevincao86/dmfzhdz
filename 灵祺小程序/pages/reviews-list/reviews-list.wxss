.rev-page {
  min-height: 100vh;
  padding: 18rpx 24rpx 120rpx;
  box-sizing: border-box;
  background: linear-gradient(168deg, #eff6ff 0%, #f8fafc 48%);
}

.rev-warn {
  padding: 28rpx;
}

.rev-warn-t {
  font-size: 30rpx;
  font-weight: 800;
  color: #c2410c;
}

.rev-warn-s {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #78716c;
}

.rev-head-card {
  padding: 24rpx 22rpx 20rpx;
  margin-bottom: 16rpx;
}

.rev-head-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.rev-h-title {
  font-size: 34rpx;
  font-weight: 800;
  color: #0f172a;
}

.rev-sync {
  padding: 10rpx 22rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  font-weight: 700;
  color: #fff;
  background: linear-gradient(120deg, #2563eb, #0ea5e9);
}

.rev-h-muted {
  margin-top: 10rpx;
  font-size: 22rpx;
  color: #64748b;
  display: block;
  line-height: 1.45;
}

.rev-sync-hint {
  margin-top: 8rpx;
  font-size: 20rpx;
  color: #94a3b8;
  display: block;
}

.rev-kind-tabs {
  display: flex;
  gap: 12rpx;
  margin-bottom: 14rpx;
}

.rev-kind-chip {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  border-radius: 16rpx;
  font-weight: 700;
  font-size: 26rpx;
  color: #475569;
  background: rgba(255, 255, 255, 0.88);
  border: 2rpx solid #e2e8f0;
}

.rev-kind-chip.on {
  background: #2563eb;
  color: #fff;
  border-color: transparent;
}

.rev-plat-scroll {
  width: 100%;
  margin-bottom: 14rpx;
  white-space: nowrap;
}

.rev-plat-inner {
  display: inline-flex;
  gap: 10rpx;
  padding-bottom: 6rpx;
}

.rev-plat-cell {
  display: inline-flex;
  align-items: center;
  gap: 6rpx;
  padding: 12rpx 20rpx;
  border-radius: 999rpx;
  font-size: 23rpx;
  font-weight: 600;
  color: #334155;
  background: rgba(255, 255, 255, 0.9);
  border: 1rpx solid rgba(226, 232, 240, 0.95);
}

.rev-plat-cell.on {
  color: #1d4ed8;
  border-color: rgba(37, 99, 235, 0.45);
  background: rgba(239, 246, 255, 0.95);
}

.rev-plat-cell.soon {
  opacity: 0.6;
}

.soon-tag {
  font-size: 18rpx;
  padding: 2rpx 8rpx;
  border-radius: 8rpx;
  background: #ffedd5;
  color: #c2410c;
}

.rev-store-picker {
  display: flex;
  align-items: center;
  padding: 20rpx 22rpx;
  margin-bottom: 14rpx;
}

.rev-store-label {
  font-weight: 700;
  color: #475569;
  margin-right: 16rpx;
}

.rev-store-val {
  flex: 1;
  color: #0f172a;
  font-size: 26rpx;
}

.rev-picker-arrow {
  color: #94a3b8;
  font-size: 28rpx;
}

.rev-filters {
  padding: 18rpx 16rpx 22rpx;
  margin-bottom: 16rpx;
}

.rev-chip-scroll {
  width: 100%;
  margin-bottom: 12rpx;
}

.rev-chip-scroll.sub {
  margin-bottom: 16rpx;
}

.rev-chip-row {
  display: inline-flex;
  gap: 10rpx;
}

.rev-chip {
  display: inline-block;
  padding: 10rpx 20rpx;
  border-radius: 999rpx;
  font-size: 23rpx;
  font-weight: 600;
  color: #475569;
  background: #f1f5f9;
}

.rev-chip.alt {
  background: #fff;
  border: 1rpx solid #e2e8f0;
}

.rev-chip-on {
  background: rgba(220, 252, 231, 0.95);
  color: #166534;
  border-color: #86efac;
}

.rev-ai-row {
  display: flex;
  gap: 16rpx;
  align-items: flex-start;
  padding-top: 8rpx;
}

.rev-ai-meta {
  flex: 1;
}

.rev-ai-label {
  font-size: 24rpx;
  font-weight: 700;
  color: #334155;
  display: block;
}

.rev-ai-sub {
  margin-top: 4rpx;
  font-size: 20rpx;
  color: #94a3b8;
  line-height: 1.38;
}

.rev-state {
  text-align: center;
  padding: 40rpx;
  font-size: 26rpx;
  color: #64748b;
}

.rev-state.err {
  background: rgba(254, 242, 242, 0.6);
  border-radius: 18rpx;
  color: #b91c1c;
}

.rev-empty {
  padding: 64rpx 32rpx;
  text-align: center;
}

.rev-empty-i {
  font-size: 56rpx;
  color: #cbd5f5;
}

.rev-empty-t {
  margin-top: 12rpx;
  font-size: 29rpx;
  font-weight: 800;
  color: #475569;
  display: block;
}

.rev-empty-h {
  margin-top: 10rpx;
  font-size: 23rpx;
  color: #94a3b8;
  line-height: 1.5;
  display: block;
}

.rev-item {
  padding: 24rpx 22rpx;
  margin-bottom: 14rpx;
}

.rev-line1 {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.rev-user {
  font-size: 28rpx;
  font-weight: 800;
  color: #0f172a;
}

.rev-stars {
  font-size: 22rpx;
  color: #b45309;
  font-weight: 700;
}

.rev-sub-meta {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #64748b;
  display: block;
}

.rev-body {
  margin-top: 12rpx;
  font-size: 26rpx;
  color: #334155;
  line-height: 1.5;
}

.rev-time {
  margin-top: 8rpx;
  font-size: 20rpx;
  color: #94a3b8;
  display: block;
}

.rev-actions {
  margin-top: 16rpx;
  display: flex;
  gap: 12rpx;
  justify-content: flex-end;
}

.svc-btn {
  margin: 0 !important;
  border-radius: 999rpx !important;
}

.svc-btn.primary {
  background: linear-gradient(95deg, #2563eb, #0ea5e9) !important;
  color: #fff !important;
}

.svc-btn.ghost {
  background: rgba(248, 250, 252, 0.95) !important;
  color: #475569 !important;
  border: 1rpx solid #e2e8f0 !important;
}

.reply-done {
  margin-top: 16rpx;
  padding: 14rpx 16rpx;
  border-radius: 16rpx;
  background: rgba(219, 234, 254, 0.45);
}

.reply-label {
  font-size: 20rpx;
  font-weight: 700;
  color: #1d4ed8;
}

.reply-body {
  margin-top: 6rpx;
  font-size: 24rpx;
  color: #334155;
}

.reply-editor {
  margin-top: 16rpx;
}

.reply-ta {
  width: 100%;
  min-height: 140rpx;
  padding: 14rpx 16rpx;
  box-sizing: border-box;
  font-size: 24rpx;
  background: #f8fafc;
  border: 1rpx solid rgba(148, 163, 184, 0.45);
  border-radius: 16rpx;
}

.reply-btns {
  margin-top: 12rpx;
  display: flex;
  justify-content: flex-end;
  gap: 12rpx;
}
