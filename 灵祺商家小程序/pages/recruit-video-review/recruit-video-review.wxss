.vid-scroll {
  height: 100vh;
  box-sizing: border-box;
  padding: 20rpx 26rpx calc(36rpx + env(safe-area-inset-bottom));
  background: #f8fafc;
}

.vid-back {
  font-size: 26rpx;
  color: #64748b;
  display: block;
  margin-bottom: 14rpx;
}

.vid-h1 {
  font-size: 40rpx;
  font-weight: 800;
  color: #0f172a;
  margin-bottom: 22rpx;
  display: block;
}

.vid-stats {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
  margin-bottom: 20rpx;
}

.vid-st {
  width: calc(50% - 8rpx);
  padding: 20rpx 18rpx;
  box-sizing: border-box;
}

.vid-st-l {
  font-size: 22rpx;
  color: #64748b;
  display: block;
}

.vid-st-v {
  margin-top: 6rpx;
  font-size: 38rpx;
  font-weight: 800;
  color: #0f172a;
  display: block;
}

.vid-panel {
  padding: 8rpx 0 36rpx;
}

.vid-empty {
  padding: 72rpx 28rpx;
  font-size: 26rpx;
  color: #94a3b8;
  line-height: 1.55;
  text-align: center;
}

.vid-card {
  margin: 0 18rpx 28rpx;
  border-radius: 18rpx;
  border: 1rpx solid #e5e7eb;
  overflow: hidden;
  background: #fff;
}

.vid-thumb-row {
  height: 220rpx;
  background: #f1f5f9;
  position: relative;
}

.vid-thumb-img {
  width: 100%;
  height: 100%;
}

.vid-thumb-ph {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  color: #94a3b8;
}

.vid-st-pill {
  position: absolute;
  left: 14rpx;
  top: 14rpx;
  font-size: 20rpx;
  padding: 6rpx 14rpx;
  border-radius: 999rpx;
  font-weight: 700;
}

.vid-st-pending {
  background: #f59e0b;
  color: #fff;
}

.vid-st-passed {
  background: #059669;
  color: #fff;
}

.vid-st-rejected {
  background: #dc2626;
  color: #fff;
}

.vid-author {
  margin: 14rpx 18rpx 0;
  font-size: 22rpx;
  color: #64748b;
  display: block;
}

.vid-title {
  margin: 4rpx 18rpx 6rpx;
  font-size: 28rpx;
  font-weight: 700;
  color: #0f172a;
  display: block;
}

.vid-sub {
  margin: 0 18rpx 14rpx;
  font-size: 22rpx;
  color: #94a3b8;
  line-height: 1.45;
}

.vid-actions {
  padding: 0 18rpx 18rpx;
  display: flex;
  gap: 12rpx;
}

.vid-reject {
  margin: 0;
  background: #fff;
  border: 1rpx solid #fecaca;
  color: #b91c1c;
}

.vid-space {
  height: 28rpx;
}
