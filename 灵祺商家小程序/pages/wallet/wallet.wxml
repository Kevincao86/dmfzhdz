<view class="page">
  <view class="hero meoo-card">
    <text class="hero-label">可用余额（元）</text>
    <text class="hero-amt">¥{{balanceYuan}}</text>
    <text wx:if="{{expireText}}" class="hero-sub">服务参考到期：{{expireText}}</text>
    <text wx:else class="hero-sub">充值到账由运营在管控台确认后更新</text>
    <button class="meoo-btn-primary recharge-btn" bindtap="onOpenRecharge">充值</button>
    <button class="refund-outline-btn" bindtap="onOpenRefund" disabled="{{balanceCents <= 0}}">退款</button>
    <button class="ghost-btn" bindtap="onReload" loading="{{loading}}">刷新</button>
  </view>

  <text wx:if="{{err}}" class="err">{{err}}</text>

  <view class="panel meoo-card">
    <text class="panel-title">使用账单</text>
    <block wx:if="{{ledger.length === 0}}">
      <text class="empty">暂无流水</text>
    </block>
    <scroll-view wx:else scroll-y class="ledger-scroll">
      <view wx:for="{{ledger}}" wx:key="id" class="ledger-row">
        <view class="ledger-left">
          <text class="ledger-reason">{{item.reason}}</text>
          <text class="ledger-time">{{item.created_at}}</text>
        </view>
        <view class="ledger-right">
          <text class="ledger-delta {{item.delta_cents >= 0 ? 'pos' : 'neg'}}">
            {{item.delta_cents >= 0 ? '+' : '-'}}¥{{item.deltaAbsYuan}}
          </text>
          <text class="ledger-bal">余 ¥{{item.balanceYuan}}</text>
        </view>
      </view>
    </scroll-view>
  </view>

  <!-- 充值弹层 -->
  <view wx:if="{{payOpen}}" class="pay-mask" catchtap="onClosePay">
    <view class="pay-sheet meoo-card" catchtap="noop">
      <text class="pay-title">账户充值</text>
      <text class="pay-hint">充值档位与商家后台钱包一致；支付请备注账号或商户名。</text>

      <view class="tier-row">
        <button
          wx:for="{{rechargeTiers}}"
          wx:key="label"
          wx:for-index="idx"
          class="tier-chip {{!useCustom && tierIndex === idx ? 'on' : ''}}"
          data-index="{{idx}}"
          bindtap="onPickTier"
        >
          {{item.label}}
        </button>
      </view>

      <label class="custom-row">
        <switch checked="{{useCustom}}" bindchange="onToggleCustom" color="#22d3ee" />
        <text class="custom-label">自定义金额（元）</text>
      </label>
      <input wx:if="{{useCustom}}" class="meoo-input" type="digit" placeholder="不少于 1 元" value="{{customYuan}}" bindinput="onCustomYuan" />

      <view wx:if="{{payStep === 'choose'}}" class="pay-actions">
        <button class="pay-wx" bindtap="onPickChannel" data-ch="wechat">微信支付</button>
        <button class="pay-alipay" bindtap="onPickChannel" data-ch="alipay">支付宝</button>
      </view>

      <block wx:else>
        <text class="pay-channel-tip">{{channel === 'wechat' ? '请使用微信扫码支付（收款码由商家向技术支持配置）' : '请使用支付宝扫码支付'}}</text>
        <view class="qr-placeholder">QR</view>
        <text wx:if="{{payErr}}" class="err pay-err">{{payErr}}</text>
        <view class="pay-actions">
          <button class="meoo-btn-primary" loading="{{payBusy}}" bindtap="onPaid">我已完成支付</button>
          <button class="ghost-btn" bindtap="onBackChoose">返回</button>
        </view>
      </block>

      <button class="close-pay" bindtap="onClosePay">关闭</button>
    </view>
  </view>

  <view wx:if="{{refundOpen}}" class="pay-mask refund-mask-center" catchtap="onCloseRefund">
    <view class="refund-sheet meoo-card" catchtap="noop">
      <text class="pay-title">申请退款</text>
      <text class="pay-hint">
        可用余额 ¥{{balanceYuan}}。金额不得超过可用余额；客服审核后进行退还。
      </text>
      <text class="custom-label" style="margin-top: 28rpx; display: block">退款金额（元）</text>
      <input class="meoo-input" style="margin-top: 12rpx" type="digit" placeholder="例如 100.00" value="{{refundYuan}}" bindinput="onRefundYuan" />
      <text wx:if="{{refundErr}}" class="err pay-err">{{refundErr}}</text>
      <view class="pay-actions">
        <button class="ghost-btn" bindtap="onRefundAll" disabled="{{refundBusy || balanceCents <= 0}}">
          全部退款（¥{{balanceYuan}}）
        </button>
        <button class="meoo-btn-primary" loading="{{refundBusy}}" bindtap="onRefundConfirm">确认</button>
        <button class="close-pay" bindtap="onCloseRefund">取消</button>
      </view>
    </view>
  </view>
</view>
