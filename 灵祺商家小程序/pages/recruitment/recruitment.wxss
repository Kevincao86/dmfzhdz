@import '../product-edit/product-edit.wxss';

.rec-page {
  padding: 28rpx;
  padding-bottom: 48rpx;
  box-sizing: border-box;
  min-height: 100vh;
}

.rec-banner {
  margin-bottom: 24rpx;
  padding: 28rpx 26rpx !important;
  border-radius: 22rpx;
  border: 1rpx solid rgba(99, 102, 241, 0.12);
  background: linear-gradient(135deg, #f5f3ff 0%, #fff 52%);
}

.rec-banner-title {
  font-size: 32rpx;
  font-weight: 800;
  color: #312e81;
}

.rec-banner-desc {
  margin-top: 14rpx;
  font-size: 24rpx;
  color: #64748b;
  line-height: 1.52;
}

.rec-banner-link {
  margin-top: 20rpx;
  display: block;
  font-size: 26rpx;
  font-weight: 700;
  color: #4f46e5;
}

.rec-banner-soft {
  margin-top: 12rpx;
  display: block;
  font-size: 24rpx;
  font-weight: 600;
  color: #0369a1;
}

.rec-banner-soft-hover {
  opacity: 0.86;
}

.rec-banner-link-hover {
  opacity: 0.85;
}

.rec-mt {
  margin-top: 20rpx;
}

.rec-center {
  text-align: center;
  padding: 48rpx 24rpx;
  color: #64748b;
  font-size: 26rpx;
}

.rec-err {
  color: #b91c1c;
}

.rec-filter-hint {
  display: block;
  font-size: 22rpx;
  color: #94a3b8;
  margin-bottom: 16rpx;
}

.rec-row {
  margin-bottom: 20rpx;
}

.rec-row-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #0f172a;
  display: block;
}

.rec-row-sub {
  font-size: 22rpx;
  color: #64748b;
  margin-top: 8rpx;
  display: block;
}

.rec-row-sum {
  font-size: 22rpx;
  color: #475569;
  margin-top: 12rpx;
  display: block;
  line-height: 1.45;
}
