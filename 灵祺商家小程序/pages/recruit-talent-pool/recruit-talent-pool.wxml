<view class="tp-root">
<scroll-view scroll-y class="tp-scroll" enhanced show-scrollbar="{{false}}">
  <text class="tp-back" bindtap="goBack">‹ 返回五步流程</text>
  <view class="tp-head-row">
    <view class="tp-head-main">
      <text class="tp-h1">达人池确认</text>
      <text class="tp-sub">匹配结果来自运维注册表；操作会尝试回写到电脑端同源数据。</text>
    </view>
    <button class="tp-refresh" size="mini" bindtap="onRefresh" loading="{{loading}}">刷新</button>
  </view>

  <view class="tp-stats">
    <view class="tp-stat meoo-card" wx:for="{{statItems}}" wx:key="k">
      <text class="tp-stat-l">{{item.label}}</text>
      <text class="tp-stat-v">{{item.v}}</text>
    </view>
  </view>

  <view class="tp-tip meoo-tip-blue">
    当前需求：达人招募 · {{tipLine}}
  </view>

  <view class="tp-panel meoo-card">
    <text class="tp-panel-title">匹配达人列表</text>
    <block wx:if="{{!rows.length}}">
      <view class="tp-empty">{{emptyHint}}</view>
    </block>
    <block wx:else>
      <view wx:for="{{rows}}" wx:key="id" class="tp-row {{item.schedulingConflict ? 'warn' : ''}}">
        <view class="tp-row-main">
          <view class="tp-name-line">
            <text class="tp-name">{{item.name}}</text>
            <text class="tp-chip">{{item.contentFormat}}</text>
            <text class="tp-chip">{{item.platform}}</text>
          </view>
          <text class="tp-meta">{{item.followers}} 粉丝 · {{item.niche}}</text>
          <text class="tp-money">基础 ¥{{item.baseFee}} · 绩效 ¥{{item.bonus}}</text>
        </view>
        <text class="tp-status st-{{item.status}}">{{statusText[item.status] || item.status}}</text>
        <view class="tp-actions">
          <button size="mini" class="tp-act" bindtap="onCommunicating" data-id="{{item.id}}">沟通</button>
          <button size="mini" type="primary" class="tp-act" bindtap="onConfirm" data-id="{{item.id}}">确认</button>
          <button size="mini" class="tp-act" bindtap="onReplace" data-id="{{item.id}}">替换</button>
          <button size="mini" class="tp-act-danger" bindtap="onReject" data-id="{{item.id}}">拒绝</button>
          <button size="mini" class="tp-act-danger" bindtap="onRemove" data-id="{{item.id}}">删除</button>
        </view>
      </view>
    </block>
  </view>

  <view class="tp-space" />
</scroll-view>

  <view wx:if="{{replaceOpen}}" class="tp-modal">
    <view class="tp-modal-bg" bindtap="closeReplace"></view>
    <view class="tp-modal-panel meoo-card">
      <text class="tp-modal-title">替换达人</text>
      <input class="tp-modal-input" value="{{replaceDraft}}" bindinput="bindReplaceDraft" placeholder="达人昵称或 ID" />
      <button class="tp-modal-ok" bindtap="confirmReplace">保存</button>
      <button class="tp-modal-cancel" bindtap="closeReplace">取消</button>
    </view>
  </view>
</view>
