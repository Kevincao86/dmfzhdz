.agent-page {
  height: 100vh;
  background: #f8fafc;
  overflow: hidden;
}

.agent-header {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  z-index: 100;
  background: #fff;
  border-bottom: 1rpx solid rgba(15, 23, 42, 0.06);
}

.header-row {
  display: flex;
  align-items: center;
  padding: 10rpx 20rpx 12rpx;
  gap: 12rpx;
}

.menu-btn {
  width: 60rpx;
  height: 60rpx;
  border-radius: 16rpx;
  background: #f1f5f9;
  display: flex;
  align-items: center;
  justify-content: center;
}

.menu-glyph {
  font-size: 30rpx;
  color: #334155;
  font-weight: 700;
}

.header-center {
  flex: 1;
}

.header-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #0f172a;
}

.chat-scroll {
  height: 100vh;
  box-sizing: border-box;
}

.chat-inner {
  padding: 12rpx 20rpx;
}

.msg-row {
  display: flex;
  margin-bottom: 14rpx;
}

.msg-row.user {
  justify-content: flex-end;
}

.msg-row.bot {
  justify-content: flex-start;
}

.bubble {
  max-width: 86%;
  padding: 14rpx 18rpx;
  border-radius: 18rpx;
  line-height: 1.5;
}

.bubble-user {
  background: linear-gradient(135deg, #0ea5e9, #06b6d4);
  color: #fff;
}

.bubble-bot {
  background: #fff;
  color: #1e293b;
  border: 1rpx solid rgba(15, 23, 42, 0.06);
}

.msg-images {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-bottom: 8rpx;
}

.msg-thumb {
  width: 112rpx;
  height: 112rpx;
  border-radius: 10rpx;
  background: #f1f5f9;
}

.bubble-text {
  font-size: 26rpx;
  white-space: pre-wrap;
  word-break: break-word;
}

.composer-dock {
  position: fixed;
  left: 0;
  right: 0;
  bottom: var(--agent-composer-offset);
  z-index: 10001;
  padding-bottom: 0;
  background: #fff;
  border-top: 1rpx solid #e2e8f0;
  box-shadow: 0 -4rpx 20rpx rgba(15, 23, 42, 0.06);
}

.attach-row {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-bottom: 8rpx;
  padding: 12rpx 20rpx 0;
}

.attach-item {
  position: relative;
  width: 80rpx;
  height: 80rpx;
}

.attach-thumb {
  width: 80rpx;
  height: 80rpx;
  border-radius: 10rpx;
  background: #f1f5f9;
}

.attach-remove {
  position: absolute;
  top: -6rpx;
  right: -6rpx;
  width: 32rpx;
  height: 32rpx;
  border-radius: 999rpx;
  background: #0f172a;
  color: #fff;
  font-size: 22rpx;
  line-height: 32rpx;
  text-align: center;
}

.composer-bar {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 12rpx 20rpx;
  background: #fff;
  border-radius: 0;
  border: none;
  box-shadow: none;
}

.bar-plus {
  width: 56rpx;
  height: 56rpx;
  border-radius: 0;
  background: transparent;
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.bar-plus.disabled {
  opacity: 0.4;
}

.bar-plus-txt {
  font-size: 36rpx;
  color: #475569;
  line-height: 1;
  margin-top: -4rpx;
}

.bar-center {
  flex: 1;
  min-width: 0;
}

.bar-input {
  width: 100%;
  min-height: 56rpx;
  max-height: 160rpx;
  font-size: 28rpx;
  line-height: 1.4;
  padding: 8rpx 4rpx;
  box-sizing: border-box;
}

.bar-hold {
  height: 56rpx;
  line-height: 56rpx;
  text-align: center;
  font-size: 28rpx;
  color: #334155;
  font-weight: 500;
  border-radius: 0;
  background: #f8fafc;
  border: 1rpx solid #e2e8f0;
}

.bar-hold.recording {
  background: #fef2f2;
  color: #dc2626;
}

.bar-mode {
  width: 56rpx;
  height: 56rpx;
  border-radius: 0;
  background: transparent;
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.bar-mode-img {
  width: 36rpx;
  height: 36rpx;
  display: block;
}

.bar-model {
  box-sizing: border-box;
  min-width: 56rpx;
  max-width: 200rpx;
  height: 56rpx;
  padding: 0 20rpx;
  border-radius: 999rpx;
  background: #f1f5f9;
  border: 1rpx solid #e2e8f0;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 4rpx;
  flex-shrink: 0;
}

.bar-model-txt {
  font-size: 22rpx;
  color: #334155;
  font-weight: 500;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  max-width: 140rpx;
}

.bar-model-arrow {
  font-size: 18rpx;
  color: #64748b;
}

.model-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 10002;
  background: rgba(15, 23, 42, 0.35);
}

.model-sheet {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  max-height: 62vh;
  background: #fff;
  border-radius: 24rpx 24rpx 0 0;
  padding-bottom: var(--tab-bar-pad);
  display: flex;
  flex-direction: column;
}

.sheet-head {
  padding: 20rpx 24rpx 12rpx;
  border-bottom: 1rpx solid #f1f5f9;
}

.sheet-title {
  font-size: 22rpx;
  color: #94a3b8;
  display: block;
  margin-bottom: 12rpx;
}

.sheet-tabs {
  display: flex;
  gap: 10rpx;
}

.sheet-tab {
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  color: #64748b;
  background: #f8fafc;
}

.sheet-tab.on {
  background: #e0f2fe;
  color: #0369a1;
  font-weight: 600;
}

.sheet-list {
  flex: 1;
  height: 0;
  max-height: 48vh;
}

.sheet-item {
  padding: 22rpx 28rpx;
  font-size: 26rpx;
  color: #334155;
  border-bottom: 1rpx solid #f8fafc;
}

.sheet-item.on {
  color: #0369a1;
  font-weight: 600;
  background: #f0f9ff;
}

.preview-card {
  width: 100%;
  box-sizing: border-box;
  padding: 24rpx;
  border-radius: 24rpx;
  background: linear-gradient(145deg, #f5f3ff 0%, #eef2ff 100%);
  border: 1rpx solid rgba(99, 102, 241, 0.2);
  box-shadow: 0 8rpx 24rpx rgba(99, 102, 241, 0.08);
}

.preview-head {
  margin-bottom: 12rpx;
}

.preview-badge {
  font-size: 24rpx;
  font-weight: 700;
  color: #5b21b6;
}

.preview-intro {
  display: block;
  font-size: 24rpx;
  line-height: 1.55;
  color: #334155;
  margin-bottom: 16rpx;
}

.product-plan-card,
.recruit-brief-card {
  margin-top: 12rpx;
  padding: 20rpx;
  border-radius: 18rpx;
  background: rgba(255, 255, 255, 0.85);
  border: 1rpx solid rgba(148, 163, 184, 0.25);
}

.plan-label {
  display: block;
  font-size: 26rpx;
  font-weight: 700;
  color: #0f172a;
}

.plan-price {
  display: block;
  margin-top: 8rpx;
  font-size: 32rpx;
  font-weight: 800;
  color: #ea580c;
}

.plan-desc,
.plan-meta {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  line-height: 1.5;
  color: #475569;
}

.plan-meta.err {
  color: #dc2626;
}

.plan-combo {
  margin-top: 8rpx;
}

.plan-combo-line {
  display: block;
  font-size: 22rpx;
  color: #64748b;
  line-height: 1.45;
}

.brief-version {
  margin-top: 10rpx;
  padding: 12rpx;
  border-radius: 12rpx;
  background: #f8fafc;
}

.brief-version-text {
  font-size: 22rpx;
  line-height: 1.5;
  color: #475569;
  white-space: pre-wrap;
}

.preview-actions {
  margin-top: 16rpx;
  display: flex;
  justify-content: flex-end;
}

.preview-confirm-btn {
  padding: 14rpx 28rpx;
  border-radius: 999rpx;
  background: linear-gradient(95deg, #6366f1, #8b5cf6);
  color: #fff;
  font-size: 24rpx;
  font-weight: 700;
}

.preview-done {
  display: block;
  margin-top: 12rpx;
  font-size: 22rpx;
  color: #059669;
  font-weight: 600;
}
