.scroll {
  height: 100vh;
  padding: 28rpx;
  padding-bottom: 48rpx;
  box-sizing: border-box;
  background: linear-gradient(180deg, #eef4ff 0%, #f3f6fb 40%);
}

.range-pill {
  align-self: flex-start;
  background: rgba(37, 99, 235, 0.12);
  color: #1d4ed8;
  font-size: 22rpx;
  padding: 8rpx 20rpx;
  border-radius: 999rpx;
  font-weight: 600;
  display: inline-block;
}

.subhead {
  margin-top: 16rpx;
  margin-bottom: 28rpx;
  font-size: 24rpx;
  color: #64748b;
  line-height: 1.5;
  display: block;
}

.loading-line {
  font-size: 22rpx;
  color: #0284c7;
  margin-bottom: 16rpx;
  display: block;
}

.stat-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20rpx;
  margin-bottom: 36rpx;
}

.stat-card {
  min-height: 140rpx;
}

.stat-label {
  font-size: 22rpx;
  color: #64748b;
  display: block;
}

.stat-value {
  margin-top: 12rpx;
  font-size: 38rpx;
  font-weight: 700;
  color: #0f172a;
  display: block;
}

.stat-hint {
  margin-top: 8rpx;
  font-size: 20rpx;
  color: #94a3b8;
  line-height: 1.4;
  display: block;
}

.section-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #0f172a;
  margin-bottom: 16rpx;
  display: block;
}

.plat-row {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-bottom: 36rpx;
}

.plat-chip {
  padding: 16rpx 24rpx;
  border-radius: 16rpx;
  position: relative;
}

.plat-chip.plat-off {
  opacity: 0.42;
  filter: saturate(0.65);
}

.plat-dot {
  position: absolute;
  top: 10rpx;
  right: 12rpx;
  width: 12rpx;
  height: 12rpx;
  border-radius: 999rpx;
  background: #22c55e;
  box-shadow: 0 0 0 2rpx rgba(255, 255, 255, 0.9);
}

.plat-name {
  font-size: 24rpx;
  color: #f8fafc;
  font-weight: 600;
}

.plat-pink {
  border-color: transparent;
  background: linear-gradient(145deg, #f472b6, #db2777);
  box-shadow: 0 8rpx 20rpx rgba(219, 39, 119, 0.22);
}

.plat-amber {
  border-color: transparent;
  background: linear-gradient(145deg, #fcd34d, #d97706);
  box-shadow: 0 8rpx 20rpx rgba(217, 119, 6, 0.2);
}

.plat-rose {
  border-color: transparent;
  background: linear-gradient(145deg, #fb7185, #e11d48);
  box-shadow: 0 8rpx 20rpx rgba(225, 29, 72, 0.2);
}

.plat-red {
  border-color: transparent;
  background: linear-gradient(145deg, #f87171, #dc2626);
  box-shadow: 0 8rpx 20rpx rgba(220, 38, 38, 0.2);
}

.plat-cyan {
  border-color: transparent;
  background: linear-gradient(145deg, #22d3ee, #0e7490);
  box-shadow: 0 8rpx 20rpx rgba(14, 116, 144, 0.2);
}

.plat-blue {
  border-color: transparent;
  background: linear-gradient(145deg, #60a5fa, #2563eb);
  box-shadow: 0 8rpx 20rpx rgba(37, 99, 235, 0.2);
}

.plat-slate {
  border-color: transparent;
  background: linear-gradient(145deg, #94a3b8, #475569);
  box-shadow: 0 8rpx 18rpx rgba(71, 85, 105, 0.18);
}

.todo-card {
  margin-bottom: 16rpx;
}

.todo-link {
  position: relative;
  padding-right: 48rpx !important;
}

.todo-hover {
  opacity: 0.92;
}

.todo-arrow {
  position: absolute;
  right: 28rpx;
  top: 50%;
  transform: translateY(-50%);
  font-size: 36rpx;
  color: #cbd5e1;
  font-weight: 300;
}

.todo-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #0f172a;
  display: block;
}

.todo-sub {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #64748b;
  display: block;
}
