.wrap {
  padding: 28rpx;
  padding-bottom: 64rpx;
  box-sizing: border-box;
  min-height: 100vh;
  background: linear-gradient(180deg, #e0f2fe 0%, #f3f6fb 42%);
}

.hero-bg {
  margin: -8rpx -8rpx 20rpx;
}

.hero {
  margin-bottom: 0;
  border: none;
  background: linear-gradient(135deg, #ffffff 0%, rgba(224, 242, 254, 0.65) 100%);
  box-shadow: 0 16rpx 48rpx rgba(14, 165, 233, 0.12);
}

.hero-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  margin-bottom: 12rpx;
}

.hero-kicker {
  font-size: 20rpx;
  font-weight: 700;
  letter-spacing: 0.08em;
  color: #64748b;
  text-transform: uppercase;
}

.hero-title {
  font-size: 36rpx;
  font-weight: 800;
  color: #0f172a;
  display: block;
  line-height: 1.25;
}

.hero-lead {
  margin-top: 14rpx;
  font-size: 24rpx;
  color: #64748b;
  line-height: 1.55;
  display: block;
}

.hero-tag {
  font-size: 20rpx;
  color: #0369a1;
  font-weight: 700;
  background: rgba(14, 165, 233, 0.14);
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
}

.body-card {
  margin-bottom: 24rpx;
}

.body-label {
  font-size: 22rpx;
  font-weight: 700;
  color: #94a3b8;
  margin-bottom: 12rpx;
  display: block;
}

.body-text {
  font-size: 28rpx;
  color: #475569;
  line-height: 1.65;
  display: block;
}

.tip-card {
  border-color: rgba(14, 165, 233, 0.22);
  background: linear-gradient(135deg, rgba(224, 242, 254, 0.9), #ffffff);
}

.tip-label {
  font-size: 22rpx;
  color: #0369a1;
  font-weight: 700;
  margin-bottom: 12rpx;
  display: block;
}

.tip-text {
  font-size: 24rpx;
  color: #64748b;
  line-height: 1.55;
  display: block;
}
