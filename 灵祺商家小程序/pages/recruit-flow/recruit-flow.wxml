<scroll-view scroll-y class="flow-scroll" enhanced show-scrollbar="{{false}}">
  <view class="flow-hero meoo-card">
    <text class="flow-hero-title">五步流程</text>
    <text class="flow-hero-desc">与电脑端同源数据 · 按步骤完成闭环</text>
  </view>

  <view class="flow-list">
    <navigator
      wx:for="{{steps}}"
      wx:key="key"
      url="{{item.url}}"
      class="flow-card meoo-card flow-tone-{{item.tone}}"
      hover-class="flow-card-hover"
    >
      <view class="flow-card-top">
        <view class="flow-step-idx">{{index + 1}}</view>
        <text class="flow-card-arrow">›</text>
      </view>
      <text class="flow-card-title">{{item.title}}</text>
      <text wx:if="{{item.desc}}" class="flow-card-desc">{{item.desc}}</text>
      <text class="flow-card-cta">进入本环节</text>
    </navigator>
  </view>

  <navigator url="/pages/recruit-hub/recruit-hub" class="flow-foot-link" hover-class="flow-foot-link-hover">
    返回达人招募中心 ›
  </navigator>

  <view class="flow-foot-space" />
</scroll-view>
