.page {
  min-height: 100vh;
  padding: 24rpx 28rpx 48rpx;
  box-sizing: border-box;
  background: linear-gradient(165deg, #e8f4fc 0%, #f3f6fb 42%);
}

.hero {
  margin-bottom: 20rpx;
}

.hero-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.hero-title {
  font-size: 34rpx;
  font-weight: 800;
  color: #0f172a;
}

.hero-badge {
  font-size: 20rpx;
  font-weight: 700;
  color: #0369a1;
  background: rgba(14, 165, 233, 0.14);
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
}

.hero-desc {
  margin-top: 14rpx;
  font-size: 24rpx;
  color: #64748b;
  line-height: 1.55;
  display: block;
}

.hero-actions {
  margin-top: 20rpx;
  display: flex;
  gap: 16rpx;
}

.hero.warn .hero-title {
  color: #9a3412;
}

.hero.warn .hero-desc {
  color: #78716c;
}

.mini-btn {
  border-radius: 999rpx !important;
  font-size: 22rpx !important;
  font-weight: 600;
  padding: 0 22rpx !important;
  line-height: 52rpx !important;
  margin: 0 !important;
}

.mini-btn.primary {
  background: linear-gradient(95deg, #0ea5e9, #06b6d4) !important;
  color: #fff !important;
  border: none !important;
}

.mini-btn.ghost {
  background: rgba(255, 255, 255, 0.92) !important;
  color: #475569 !important;
  border: 1rpx solid rgba(148, 163, 184, 0.45) !important;
}

.mini-btn.secondary {
  background: rgba(15, 118, 178, 0.1) !important;
  color: #0369a1 !important;
  border: 1rpx solid rgba(3, 105, 161, 0.25) !important;
}

.mini-btn.teal {
  background: rgba(13, 148, 136, 0.12) !important;
  color: #0f766e !important;
  border: 1rpx solid rgba(13, 148, 136, 0.28) !important;
}

.tabs-scroll {
  width: 100%;
  margin-bottom: 16rpx;
  white-space: nowrap;
}

.tabs-inner {
  display: inline-flex;
  gap: 12rpx;
  padding: 4rpx 0 8rpx;
}

.tab-pill {
  display: inline-flex;
  align-items: center;
  gap: 10rpx;
  padding: 14rpx 22rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.72);
  border: 1rpx solid rgba(148, 163, 184, 0.35);
}

.tab-on {
  background: linear-gradient(125deg, #1e293b, #334155);
  border-color: transparent;
}

.tab-on .tab-label {
  color: #f8fafc;
}

.tab-label {
  font-size: 23rpx;
  color: #475569;
  font-weight: 600;
  white-space: nowrap;
}

.search-wrap {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 20rpx;
  padding: 16rpx 22rpx !important;
}

.search-icon {
  font-size: 28rpx;
  color: #94a3b8;
}

.search-input {
  flex: 1;
  font-size: 26rpx;
  color: #0f172a;
}

.search-ph {
  color: #94a3b8;
}

.note-strip {
  font-size: 22rpx;
  color: #b45309;
  background: rgba(251, 191, 36, 0.15);
  border-radius: 16rpx;
  padding: 14rpx 18rpx;
  margin-bottom: 16rpx;
}

.state-card {
  text-align: center;
  padding: 40rpx 28rpx !important;
}

.state-card.err {
  border-color: rgba(239, 68, 68, 0.22);
}

.state-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #0f172a;
  display: block;
}

.state-text {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #64748b;
  line-height: 1.55;
  display: block;
}

.prod-card {
  margin-bottom: 18rpx;
  padding: 24rpx !important;
}

.prod-top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
}

.prod-name {
  font-size: 28rpx;
  font-weight: 700;
  color: #0f172a;
  line-height: 1.35;
}

.prod-meta {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #94a3b8;
  display: block;
}

.prod-id {
  margin-top: 6rpx;
  font-size: 20rpx;
  color: #cbd5e1;
  display: block;
  font-family: ui-monospace, monospace;
}

.prod-price {
  font-size: 30rpx;
  font-weight: 800;
  color: #0d9488;
  flex-shrink: 0;
}

.prod-foot {
  margin-top: 20rpx;
  padding-top: 18rpx;
  border-top: 1rpx solid rgba(226, 232, 240, 0.95);
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
}

.status-pill {
  font-size: 20rpx;
  font-weight: 700;
  color: #475569;
  background: #f1f5f9;
  padding: 6rpx 14rpx;
  border-radius: 999rpx;
}

.prod-actions {
  display: flex;
  gap: 12rpx;
}

.bottom-space {
  height: 32rpx;
}
