<view class="mp-page geo-page">
  <view class="geo-top">
    <view class="geo-top-row">
      <text class="geo-h1">GEO 运营优化</text>
      <button class="geo-sync-btn" size="mini" loading="{{scoreBusy}}" bindtap="onSyncAiScore">同步评分</button>
    </view>
    <text class="geo-sub">来客门店对齐 · AI 评分与咨询测试 · 多端与电脑端 GEO 同源</text>
    <view class="geo-store-chip">{{storeSummary}}</view>
  </view>

  <scroll-view scroll-x class="geo-tabs-scroller" enhanced="true" show-scrollbar="false">
    <view class="geo-tabs">
      <view
        wx:for="{{tabs}}"
        wx:key="id"
        data-id="{{item.id}}"
        class="geo-tab {{tab === item.id ? 'active' : ''}}"
        bindtap="onTab"
      >{{item.label}}</view>
    </view>
  </scroll-view>

  <!-- 概览 -->
  <block wx:if="{{tab === 'overview'}}">
    <view class="geo-hero">
      <text class="geo-hero-t">GEO 本地优化 · 更容易被 AI 搜索找到</text>
      <text class="geo-hero-p">结构化维护门店事实 → 补足 FAQ → 查漏补缺问法覆盖率 → 定期检查健康分。</text>
    </view>
    <view class="geo-kpis">
      <view class="geo-kpi main">
        <text class="geo-kpi-lab">GEO 健康分</text>
        <text class="geo-kpi-num">{{healthScore}}</text>
        <text class="geo-kpi-hint">{{scoreSource}}</text>
      </view>
      <view class="geo-kpi">
        <text class="geo-kpi-lab">信息完整度</text>
        <text class="geo-kpi-num">{{kpiInfo}}</text>
      </view>
      <view class="geo-kpi">
        <text class="geo-kpi-lab">问法覆盖率</text>
        <text class="geo-kpi-num">{{kpiQuery}}</text>
      </view>
      <view class="geo-kpi">
        <text class="geo-kpi-lab">内容新鲜度</text>
        <text class="geo-kpi-num">{{kpiFresh}}</text>
      </view>
    </view>
    <view class="geo-card">
      <text class="geo-card-title">评分说明</text>
      <text class="geo-card-body">{{rationale}}</text>
    </view>
    <view class="geo-card">
      <text class="geo-card-title">问法抽样</text>
      <view wx:if="{{querySamples.length}}" class="geo-q-list">
        <view wx:for="{{querySamples}}" wx:key="q" class="geo-q-row">
          <text class="geo-q">{{item.q}}</text>
          <text class="geo-q-flag {{item.covered ? 'ok' : 'miss'}}">{{item.covered ? '已覆盖' : '缺口'}}</text>
        </view>
      </view>
      <text wx:else class="geo-muted">暂无抽样 · 可先同步来客门店</text>
    </view>
    <view class="geo-card">
      <view class="geo-todo-head">
        <text class="geo-card-title">优化待办</text>
        <text class="geo-muted">共 {{todos.length}} 项</text>
      </view>
      <view wx:for="{{todos}}" wx:key="*this" class="geo-todo-row">· {{item}}</view>
      <button class="geo-open-consult" bindtap="onTab" data-id="consult">打开 AI 咨询测试</button>
    </view>
  </block>

  <!-- AI 咨询 -->
  <block wx:if="{{tab === 'consult'}}">
    <view class="geo-card">
      <text class="geo-card-title">知识包草稿</text>
      <textarea class="geo-area" maxlength="8000" value="{{geoPack}}" bindinput="onPack" placeholder="维护可被检索摘录的事实文本" />
      <view class="geo-actions">
        <button class="geo-btn-ghost" size="mini" bindtap="genQuestion">AI 随机问法</button>
      </view>
    </view>
    <view class="geo-card">
      <text class="geo-card-title">测试问题</text>
      <textarea class="geo-single" maxlength="500" auto-height="{{true}}" value="{{consultQ}}" bindinput="onConsultQ" />
      <button class="geo-primary" loading="{{busy}}" bindtap="runConsult">发起咨询</button>
      <view wx:if="{{consultReply}}" class="geo-reply">{{consultReply}}</view>
    </view>
  </block>

  <!-- 其它 Tab：与 Web 对齐说明 -->
  <block wx:if="{{tab !== 'overview' && tab !== 'consult'}}">
    <view class="geo-card">
      <text class="geo-card-title">与电脑端一致</text>
      <text class="geo-card-body">{{paneNote}}</text>
      <text class="geo-muted" style="display:block;margin-top:12rpx">批量编排、结构化字段与流水线任务请在浏览器打开商家后台「运营 → GEO 运营优化」完成。</text>
    </view>
  </block>

  <view class="geo-footer-spacer"></view>
</view>
