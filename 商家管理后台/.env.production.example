# 复制为 .env.production（ECS/本机构建用，勿提交 Git）
# 构建前: cp .env.production.example .env.production && nano .env.production

# 运营台浏览器直连轻量 API（生产默认已是 mofangdianai.com/erp-api，显式填写便于排查）
VITE_MEEO_OPS_API_BASE=https://mofangdianai.com/erp-api
VITE_MEEO_SUPPORT_OPS_API_BASE=https://mofangdianai.com/erp-api

# 在线客服 HTTP 轮询/回复（须与轻量 ~/stack/auth-api.env 中 MEOO_SUPPORT_OPS_HTTP_TOKEN 一致）
VITE_MEEO_SUPPORT_OPS_HTTP_TOKEN=
